@{
    ViewBag.Title = "Login History";
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}

<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">

<!-- Bootstrap Icons (for modern icon set) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/Validation.js"></script>
<script src="~/Scripts/datatable.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>

<style>
    :root {
        --lh-primary: #4f46e5;
        --lh-primary-dark: #4338ca;
        --lh-primary-light: #eef2ff;
        --lh-accent: #06b6d4;
        --lh-success: #16a34a;
        --lh-danger: #e11d48;
        --lh-text: #1e293b;
        --lh-muted: #64748b;
        --lh-border: #e2e8f0;
        --lh-radius: 12px;
        --lh-shadow: 0 4px 20px rgba(30, 41, 59, 0.06);
        --lh-shadow-hover: 0 10px 30px rgba(79, 70, 229, 0.12);
    }

    body {
        background: linear-gradient(180deg, #f4f6fb 0%, #eef1f8 100%);
    }

    .login-history-container {
        max-width: 1200px;
        margin: 32px auto;
        animation: lhFadeInUp 0.5s ease both;
    }

    @@keyframes lhFadeInUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---- Header Card ---- */
    .lh-card {
        border: none;
        border-radius: var(--lh-radius);
        overflow: hidden;
        box-shadow: var(--lh-shadow);
    }

    .lh-card-header {
        background: linear-gradient(120deg, var(--lh-primary) 0%, #6366f1 55%, var(--lh-accent) 100%);
        color: #fff;
        padding: 8px 10px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.3px;
        position: relative;
        overflow: hidden;
    }

        .lh-card-header::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 90% -20%, rgba(255,255,255,0.25), transparent 55%);
        }

        .lh-card-header .lh-header-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.18);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
            animation: lhPulse 2.4s ease-in-out infinite;
        }

    @@keyframes lhPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.08);
        }
    }

    .lh-card-header small {
        display: block;
        font-size: 11.5px;
        font-weight: 400;
        opacity: 0.85;
        margin-top: 1px;
    }

    .lh-card-body {
        padding: 10px;
        background: #fff;
    }

    /* ---- Filter Section ---- */
    .filter-section {
        background: linear-gradient(180deg, #fbfcff 0%, #f6f8fd 100%);
        border: 1px solid var(--lh-border);
        padding: 16px;
        border-radius: var(--lh-radius);
        margin-bottom: 20px;
        transition: box-shadow 0.3s ease;
    }

    .form-label {
        font-weight: 600;
        font-size: 11.5px;
        color: var(--lh-muted);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .form-label i {
            color: var(--lh-primary);
            font-size: 12px;
        }

    /* Compact animated input group */
    .lh-input-group {
        position: relative;
        display: flex;
        align-items: stretch;
        border-radius: 8px;
        overflow: hidden;
        border: 1.5px solid var(--lh-border);
        background: #fff;
        height: 36px;
        transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.15s ease;
    }

        .lh-input-group:hover {
            border-color: #c7d2fe;
        }

        .lh-input-group:focus-within {
            border-color: var(--lh-primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
            transform: translateY(-1px);
        }

        .lh-input-group .lh-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            color: var(--lh-primary);
            background: var(--lh-primary-light);
            font-size: 13px;
            transition: background 0.25s ease, color 0.25s ease;
            flex-shrink: 0;
        }

        .lh-input-group:focus-within .lh-icon {
            background: var(--lh-primary);
            color: #fff;
        }

        .lh-input-group select,
        .lh-input-group input {
            border: none !important;
            box-shadow: none !important;
            outline: none !important;
            background: transparent;
            flex: 1;
            padding: 4px 10px;
            font-size: 13px;
            color: var(--lh-text);
            height: 100%;
            min-width: 0;
        }

    /* Field-level validation state */
    .lh-field {
        position: relative;
    }

    .lh-input-group.lh-invalid {
        border-color: var(--lh-danger) !important;
        box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.12) !important;
    }

        .lh-input-group.lh-invalid .lh-icon {
            background: rgba(225, 29, 72, 0.1);
            color: var(--lh-danger);
        }

    .lh-shake {
        animation: lhShake 0.4s ease;
    }

    @@keyframes lhShake {
        10%, 90% {
            transform: translateX(-1px);
        }

        20%, 80% {
            transform: translateX(2px);
        }

        30%, 50%, 70% {
            transform: translateX(-4px);
        }

        40%, 60% {
            transform: translateX(4px);
        }
    }

    .lh-error-msg {
        display: none;
        align-items: center;
        gap: 4px;
        color: var(--lh-danger);
        font-size: 11px;
        font-weight: 600;
        margin-top: 4px;
        animation: lhFadeInUp 0.25s ease both;
    }

        .lh-error-msg.show {
            display: flex;
        }

    /* Buttons */
    .lh-btn {
        border: none;
        border-radius: 8px;
        padding: 0 16px;
        height: 36px;
        font-weight: 600;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        white-space: nowrap;
        transition: transform 0.15s ease, box-shadow 0.25s ease, background 0.25s ease;
    }

        .lh-btn:active {
            transform: scale(0.97);
        }

    .lh-btn-primary {
        background: linear-gradient(120deg, var(--lh-primary), #6366f1);
        color: #fff;
        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.28);
    }

        .lh-btn-primary:hover {
            box-shadow: 0 8px 22px rgba(79, 70, 229, 0.38);
            transform: translateY(-2px);
            color: #fff;
        }

    .lh-btn-secondary {
        background: #fff;
        color: var(--lh-muted);
        border: 1.5px solid var(--lh-border);
    }

        .lh-btn-secondary:hover {
            background: #f1f5f9;
            color: var(--lh-text);
            transform: translateY(-2px);
        }

    .lh-btn.is-loading i {
        animation: lhSpin 0.8s linear infinite;
    }

    @@keyframes lhSpin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ---- Table ---- */
    .table-responsive {
        border-radius: var(--lh-radius);
        overflow: hidden;
        border: 1px solid var(--lh-border);
    }

    #tblLoginHistory {
        margin-bottom: 0 !important;
        font-size: 13px;
    }

        #tblLoginHistory thead th {
            background: #f8fafc;
            color: var(--lh-muted);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--lh-border);
            vertical-align: middle;
            padding: 8px 10px;
        }

        #tblLoginHistory tbody td {
            padding: 7px 10px;
            vertical-align: middle;
        }

        #tblLoginHistory tbody tr {
            animation: lhRowIn 0.35s ease both;
            transition: background 0.2s ease;
        }

    @@keyframes lhRowIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #tblLoginHistory tbody tr:hover {
        background: var(--lh-primary-light) !important;
    }

    .lh-session-id {
        font-family: "Courier New", monospace;
        font-size: 11.5px;
        color: var(--lh-muted);
        background: #f1f5f9;
        padding: 2px 7px;
        border-radius: 6px;
    }

    .lh-time-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12.5px;
    }

        .lh-time-badge i {
            color: var(--lh-primary);
        }

        .lh-time-badge.lh-logout i {
            color: var(--lh-danger);
        }

    .lh-no-time {
        color: #cbd5e1;
        font-style: italic;
        font-size: 12px;
    }

    /* Locate button in table */
    .lh-locate-btn {
        border: none;
        background: linear-gradient(120deg, var(--lh-accent), #0ea5e9);
        color: #fff;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        box-shadow: 0 4px 10px rgba(6, 182, 212, 0.35);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        position: relative;
    }

        .lh-locate-btn::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 2px solid rgba(6, 182, 212, 0.4);
            animation: lhRipple 1.8s ease-out infinite;
        }

    @@keyframes lhRipple {
        0% {
            transform: scale(1);
            opacity: 0.8;
        }

        100% {
            transform: scale(1.8);
            opacity: 0;
        }
    }

    .lh-locate-btn:hover {
        transform: scale(1.12);
        box-shadow: 0 6px 16px rgba(6, 182, 212, 0.5);
        color: #fff;
    }

    .lh-no-location {
        color: #cbd5e1;
        font-size: 16px;
    }

    /* Empty state */
    .lh-empty-state {
        text-align: center;
        padding: 40px 20px;
        color: var(--lh-muted);
    }

        .lh-empty-state i {
            font-size: 36px;
            color: #c7d2fe;
            display: block;
            margin-bottom: 10px;
        }

    /* ---- Map Modal (Google Maps) ---- */
    #mapModal .modal-content {
        border: none;
        border-radius: var(--lh-radius);
        overflow: hidden;
    }

    #mapModal .modal-header {
        background: linear-gradient(120deg, var(--lh-primary), var(--lh-accent));
        color: #fff;
        border: none;
        padding: 16px 20px;
    }

        #mapModal .modal-header .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
        }

    #mapModal .modal-body {
        padding: 0;
    }

    .lh-map-tag {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        justify-content: space-between;
        background: #f8fafc;
        border-bottom: 1px solid var(--lh-border);
        padding: 10px 18px;
        font-size: 12.5px;
    }

        .lh-map-tag .lh-tag-row {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--lh-text);
        }

            .lh-map-tag .lh-tag-row b {
                color: var(--lh-muted);
                font-weight: 600;
            }

            .lh-map-tag .lh-tag-row i.bi-box-arrow-in-right {
                color: var(--lh-success);
            }

            .lh-map-tag .lh-tag-row i.bi-box-arrow-right {
                color: var(--lh-danger);
            }

    .lh-map-link {
        font-size: 12px;
        font-weight: 600;
        color: var(--lh-primary);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

        .lh-map-link:hover {
            text-decoration: underline;
            color: var(--lh-primary-dark);
        }

    #lhMapFrame {
        width: 100%;
        height: 380px;
        border: 0;
        display: block;
    }

    /* ---- Responsive ---- */
    @@media (max-width: 767.98px) {
        .login-history-container {
            margin: 14px auto;
            padding: 0 8px;
        }

        .lh-card-header {
            padding: 14px;
            font-size: 15px;
        }

        .lh-card-body {
            padding: 14px;
        }

        .filter-section {
            padding: 14px;
        }

            .filter-section .col-md-2,
            .filter-section .col-md-3,
            .filter-section .col-md-4 {
                width: 100%;
            }

        .lh-btn {
            width: 100%;
        }

        .lh-map-tag {
            flex-direction: column;
            align-items: flex-start;
        }

        #lhMapFrame {
            height: 280px;
        }
    }

    @@media (min-width: 768px) and (max-width: 991.98px) {
        .filter-section .col-md-4 {
            width: 50%;
        }

        .filter-section .col-md-3 {
            width: 50%;
        }

        .filter-section .col-md-2 {
            width: 100%;
            margin-top: 10px;
        }
    }
</style>

<div class="container login-history-container">
    <div class="toastBox"></div>
    <!-- Page Title -->
    <div class="card lh-card">
        <div class="lh-card-header">
            <div class="lh-header-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                Login History
                <small>Track user sign-in activity and session locations</small>
            </div>
        </div>

        <div class="lh-card-body">

            <!-- Filter Section -->
            <div class="filter-section">
                <div class="row g-3 align-items-start">

                    <!-- User Name -->
                    <div class="col-md-4 lh-field">
                        <label for="cmbUserName" class="form-label">
                            <i class="bi bi-person-fill"></i> User Name
                        </label>

                        <div class="lh-input-group" id="grpUser">
                            <span class="lh-icon"><i class="bi bi-people-fill"></i></span>
                            <select id="cmbUserName" class="form-select">
                                <option value="">-- Select User --</option>
                                <option value="1">Administrator</option>
                                <option value="2">Team Lead</option>
                                <option value="11">Managers</option>
                                <option value="18">Developers</option>
                                <option value="26">QA</option>
                            </select>
                        </div>
                        <div class="lh-error-msg" id="errUser"><i class="bi bi-exclamation-circle-fill"></i> Please select a user.</div>
                    </div>

                    <!-- From Date -->
                    <div class="col-md-3 lh-field">
                        <label for="dtpFFrom" class="form-label">
                            <i class="bi bi-calendar-event"></i> From Date
                        </label>

                        <div class="lh-input-group" id="grpFrom">
                            <span class="lh-icon"><i class="bi bi-calendar3"></i></span>
                            <input type="date" id="dtpFFrom" class="form-control">
                        </div>
                        <div class="lh-error-msg" id="errFrom"><i class="bi bi-exclamation-circle-fill"></i> From Date is required.</div>
                    </div>

                    <!-- To Date -->
                    <div class="col-md-3 lh-field">
                        <label for="dtpFTo" class="form-label">
                            <i class="bi bi-calendar-check"></i> To Date
                        </label>

                        <div class="lh-input-group" id="grpTo">
                            <span class="lh-icon"><i class="bi bi-calendar3"></i></span>
                            <input type="date" id="dtpFTo" class="form-control">
                        </div>
                        <div class="lh-error-msg" id="errTo"><i class="bi bi-exclamation-circle-fill"></i> To Date is required.</div>
                    </div>

                    <!-- Buttons -->
                    <div class="col-md-2 d-flex gap-2">
                        <button type="button" id="btnClear" class="lh-btn lh-btn-secondary mt-4">
                            <i class="bi bi-x-circle"></i> Clear
                        </button>

                        <button type="button" id="btnLoad" class="lh-btn lh-btn-primary mt-4">
                            <i class="bi bi-search"></i> Load
                        </button>
                    </div>

                </div>
            </div>

            <!-- Login History Table -->
            <div class="table-responsive">
                <table id="tblLoginHistory" class="table table-bordered table-striped table-hover w-100">

                    <thead>
                        <tr>
                            <th>LatLong</th>
                            <th><i class="bi bi-fingerprint"></i> Session ID</th>
                            <th><i class="bi bi-box-arrow-in-right"></i> Login Time</th>
                            <th><i class="bi bi-box-arrow-right"></i> Log Out Time</th>
                            <th><i class="bi bi-geo-alt"></i> Location</th>
                        </tr>
                    </thead>

                    <tbody>
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

<!-- Map Popup Modal (Google Maps) -->
<div class="modal fade" id="mapModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-geo-alt-fill"></i> Session Location
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="lh-map-tag">
                    <div>
                        <div class="lh-tag-row"><i class="bi bi-box-arrow-in-right"></i><b>Login:</b> <span id="tagLogin">-</span></div>
                        @*<div class="lh-tag-row" style="margin-top:4px;"><i class="bi bi-box-arrow-right"></i><b>Logout:</b> <span id="tagLogout">-</span></div>*@
                    </div>
                    <div class="lh-tag-row" style="margin-top:4px;"><i class="bi bi-box-arrow-right"></i><b>Logout:</b> <span id="tagLogout">-</span></div>

                    <a href="#" target="_blank" id="lhOpenInMaps" class="lh-map-link">
                        <i class="bi bi-box-arrow-up-right"></i> Open in Google Maps
                    </a>
                </div>                
                <iframe id="lhMapFrame" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
</div>

