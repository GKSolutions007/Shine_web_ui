            }
        ];

        // Initialize DataTable
        var loginHistoryTable = $('#tblLoginHistory').DataTable({
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            "ordering": false,
            "bFilter": false,
            responsive: true,
            language: {
                emptyTable: '<div class="lh-empty-state"><i class="bi bi-inbox"></i>No login history found. Select a user and click Load.</div>'
            },
            columnDefs: [
                { targets: [0], visible: false, searchable: false } // LatLong column hidden
            ]
        });

        setDate("dtpFFrom", 0);
        setDate("dtpFTo", 0);
        GetData();
        function GetData() {
            $.ajax({
                url: Aurl + "loginhistory/users",
                type: 'get',
                contentType: 'json',
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $('#cmbUserName').find("option").remove();
                    $('#cmbUserName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                        class: ""
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbUserName').append($('<option/>', {
                            value: items.ID,
                            text: items.UserName,
                        }));
                    });
                }
            });
        }
       
        // Parse "dd/MM/yyyy HH:mm" into a Date object
        function parseDMY(dtStr) {
            if (!dtStr) return null;
            var parts = dtStr.split(' ');
            var d = parts[0].split('/');
            var t = (parts[1] || '00:00').split(':');
            return new Date(d[2], d[1] - 1, d[0], t[0], t[1]);
        }

        // Format for display: e.g. 10 Aug 2026, 07:30 PM
        function formatDisplay(dtStr) {
            var dt = parseDMY(dtStr);
            if (!dt) return null;
            var options = { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true };
            return dt.toLocaleString('en-GB', options).replace(',', ',');
        }

        function timeBadge(dtStr, type) {
            if (!dtStr) {
                return '<span class="lh-no-time">— Active / N.A —</span>';
            }
            var icon = type === 'login' ? 'bi-box-arrow-in-right' : 'bi-box-arrow-right';
            var cls = type === 'login' ? 'lh-time-badge' : 'lh-time-badge lh-logout';
            return '<span class="' + cls + '"><i class="bi ' + icon + '"></i>' + (dtStr) + '</span>';
        }

        // Render a row into the DataTable from a LocationData item
        function renderRows(rows) {
            loginHistoryTable.clear();

            rows.forEach(function (item) {
                var hasLatLong = item.Latitude && item.Longtitude &&
                    item.Latitude.toString().trim() !== '' &&
                    item.Longtitude.toString().trim() !== '';

                var latLongValue = hasLatLong ? (item.Latitude + ',' + item.Longtitude) : '';

                var locationCell = hasLatLong
                    ? '<button type="button" class="lh-locate-btn lh-locate" ' +
                    'data-lat="' + item.Latitude + '" data-lng="' + item.Longtitude + '" ' +
                    'data-login="' + (item.LoginTime || '') + '" data-logout="' + (item.LogoutTime || '') + '" ' +
                    'title="View on map"><i class="bi bi-geo-alt-fill"></i></button>'
                    : '<i class="bi bi-geo-alt lh-no-location" title="No location available">No location available</i>';

                loginHistoryTable.row.add([
                    latLongValue,
                    '<span class="lh-session-id">' + item.SessionID + '</span>',
                    timeBadge(item.LoginTime, 'login'),
                    timeBadge(item.LogoutTime, 'logout'),
                    locationCell
                ]);
            });

            loginHistoryTable.draw();
        }

        // ---- Validation helpers ----
        function showError(groupId, errId) {
            $('#' + groupId).addClass('lh-invalid lh-shake');
            $('#' + errId).addClass('show');
            setTimeout(function () { $('#' + groupId).removeClass('lh-shake'); }, 400);
        }

        function clearError(groupId, errId) {
            $('#' + groupId).removeClass('lh-invalid');
            $('#' + errId).removeClass('show');
        }

        function clearAllErrors() {
            clearError('grpUser', 'errUser');
            clearError('grpFrom', 'errFrom');
            clearError('grpTo', 'errTo');

        }

        // Clear error as soon as the user fixes the field
        $('#cmbUserName').on('change', function () {
            if ($(this).val()) clearError('grpUser', 'errUser');
        });
        $('#dtpFFrom').on('change', function () {
            if ($(this).val()) clearError('grpFrom', 'errFrom');
        });
        $('#dtpFTo').on('change', function () {
            if ($(this).val()) clearError('grpTo', 'errTo');
        });
        function LoginHistoryData() {
            
        }
        // Load Button
        $('#btnLoad').on('click', function () {

            var $btn = $(this);
            var userId = $('#cmbUserName').val();
            var fromDate = $('#dtpFFrom').val();
            var toDate = $('#dtpFTo').val();

            clearAllErrors();

            var isValid = true;
            var firstInvalid = null;

            if (!userId) {
                showError('grpUser', 'errUser');
                isValid = false;
                firstInvalid = firstInvalid || '#cmbUserName';
            }

            if (!fromDate) {
                showError('grpFrom', 'errFrom');
                isValid = false;
                firstInvalid = firstInvalid || '#dtpFFrom';
            }

            if (!toDate) {
                showError('grpTo', 'errTo');
                isValid = false;
                firstInvalid = firstInvalid || '#dtpFTo';
            }

            if (!isValid) {
                if (firstInvalid) $(firstInvalid).trigger('focus');
                return;
            }

            // Date range validation
            if (fromDate > toDate) {
                showError('grpFrom', 'errFrom');
                showError('grpTo', 'errTo');
                $('#errFrom').html('<i class="bi bi-exclamation-circle-fill"></i> From Date cannot be after To Date.');
                $('#dtpFFrom').trigger('focus');
                return;
            }

            // Brief loading animation for a modern feel
            $btn.addClass('is-loading').prop('disabled', true);

            setTimeout(function () {
              

                // Filter LocationData by selected UserID and date range
                //var filtered = LocationData.filter(function (item) {
                //    var matchUser = item.UserID === userId;

                //    var matchDate = true;
                //    var loginDate = parseDMY(item.LoginTime);
                //    if (loginDate) {
                //        var loginDateOnly = new Date(loginDate.getFullYear(), loginDate.getMonth(), loginDate.getDate());
                //        var from = new Date(fromDate);
                //        var to = new Date(toDate);
                //        if (loginDateOnly < from || loginDateOnly > to) matchDate = false;
                //    } else {
                //        matchDate = false;
                //    }

                //    return matchUser && matchDate;
                //});
                $.ajax({
                    url: Aurl + "loginhistory/userdata",
                    type: 'get',
                    contentType: 'json',
                    data: {
                        UserID: userId, FromDate: fromDate, ToDate: toDate
                    },
                    xhrFields: {
                        withCredentials: true
                    },
                    success: function (data) {
                        console.log("User data ", data);
                        renderRows(data);
                        if (data.length == 0) {
                            showErrorSnackbar("No records found");
                        }
                    },
                    error: function (data) {
                        $btn.removeClass('is-loading').prop('disabled', false);
                    }
                });
                

                $btn.removeClass('is-loading').prop('disabled', false);

            }, 250);

        });

        // Clear Button
        $('#btnClear').on('click', function () {

            $('#cmbUserName').val(0);          
            clearAllErrors();
            setDate("dtpFFrom", 0);
            setDate("dtpFTo", 0);
            // Clear DataTable
            loginHistoryTable.clear().draw();

        });

        // Locate button click -> open Google Maps modal with pin + tag
        $('#tblLoginHistory tbody').on('click', '.lh-locate', function () {

            var lat = parseFloat($(this).data('lat'));
            var lng = parseFloat($(this).data('lng'));
            var loginTime = $(this).data('login');
            var logoutTime = $(this).data('logout');

            var loginLabel = loginTime ? formatDisplay(loginTime) : 'N/A';
            var logoutLabel = logoutTime ? formatDisplay(logoutTime) : 'Active / N.A';

            $('#tagLogin').text(loginLabel);
            $('#tagLogout').text(logoutLabel);

            // Google Maps embed (no API key needed) - drops a pin at the coordinates
            var embedSrc = 'https://maps.google.com/maps?q=' + lat + ',' + lng + '&z=16&t=k&output=embed';
            $('#lhMapFrame').attr('src', embedSrc);

            // "Open in Google Maps" deep link
            $('#lhOpenInMaps').attr('href', 'https://www.google.com/maps?q=' + lat + ',' + lng);

            var mapModalEl = document.getElementById('mapModal');
            var mapModal = bootstrap.Modal.getOrCreateInstance(mapModalEl);
            mapModal.show();

        });

        // Reset iframe when modal closes (avoid stale map on reopen)
        document.getElementById('mapModal').addEventListener('hidden.bs.modal', function () {
            $('#lhMapFrame').attr('src', '');
        });

    });

</script>
