            /*modalFilterModal.style.display = "block";*/
            modalFilterModal.show();
            $("#txtcommonfilterapplyfieldid").val("txtEwayDocID");
            $("#txtcommonfilterapplytransid").val("4");
            
            //$("#txtCommonDocFilterRange").val("24,3242,343");
