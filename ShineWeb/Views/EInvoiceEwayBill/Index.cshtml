<!DOCTYPE html>
<html>
<head>

    <style>
        .form-inline .form-group {
            margin-right: 15px;
        }



        .child-tabs {
            margin-top: 10px;
        }



        /* Custom styling for 50-50 tabs */
        .main-tab-container {
            display: flex;
            margin-bottom: 0;
        }

        .main-tab {
            flex: 1;
            text-align: center;
            background-color: #f5f5f5;
            border: 1px solid #ddd;
            padding: 10px 0;
            cursor: pointer;
        }

            .main-tab.active {
                background-color: #337ab7;
                /*color: white;*/
                font-weight: bold;
            }

        .form-label {
            position: relative;
            display: block;
            clear: both;
            max-width: 500px;
            margin: 0 auto;
        }

        .labelup {
            -webkit-transform: translateY(50%);
            -moz-transform: translateY(-50%);
            -ms-transform: translateY(-50%);
            -o-transform: translateY(-50%);
            transform: translateY(50%);
            -webkit-transition: all 0.2s ease-in-out;
            -moz-transition: all 0.2s ease-in-out;
            transition: all 0.2s ease-in-out;
            position: absolute;
            top: -59%;
            left: 1em;
            background: #fffefe;
            color: #2b2828;
            font-size: 0.9em;
            font-weight: 600;
            letter-spacing: 1px;
            cursor: text;
            pointer-events: none;
            font-family: sans-serif;
        }

        .labelupfortextarea {
            -webkit-transform: translateY(50%);
            -moz-transform: translateY(-50%);
            -ms-transform: translateY(-50%);
            -o-transform: translateY(-50%);
            transform: translateY(50%);
            -webkit-transition: all 0.2s ease-in-out;
            -moz-transition: all 0.2s ease-in-out;
            transition: all 0.2s ease-in-out;
            position: absolute;
            top: -25%;
            left: 1em;
            background: #fffefe;
            color: #2b2828;
            font-size: 0.9em;
            font-weight: 600;
            letter-spacing: 1px;
            cursor: text;
            pointer-events: none;
            font-family: sans-serif;
        }

        .gdInput {
            width: 100%;
            height: 25px;
            border-width: 0 0 0.1px 0;
            border-color: #e0d6d6;
            color: black !important;
        }

        #tblDocuments, #tblItemDetails thead {
            font-size: 9px;
        }

        #tblDocuments, #tblItemDetails td {
            font-size: 10px;
        }

            #tblDocuments th,
            #tblDocuments td {
                white-space: nowrap;
            }

        #tblItemDetails th,
        #tblItemDetails td {
            white-space: nowrap;
        }

        /* =========================================================
           MODERN THEME — variables
        ========================================================= */
        :root {
            --mt-primary: #4f46e5;
            --mt-primary-dark: #4338ca;
            --mt-primary-light: #eef2ff;
            --mt-accent: #06b6d4;
            --mt-success: #16a34a;
            --mt-danger: #e11d48;
            --mt-text: #1e293b;
            --mt-muted: #64748b;
            --mt-border: #e2e8f0;
            --mt-bg: #f8fafc;
            --mt-card-radius: 16px;
            --mt-field-radius: 10px;
            --mt-shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06);
            --mt-shadow-md: 0 8px 24px rgba(15, 23, 42, 0.08);
            --mt-shadow-lg: 0 16px 40px rgba(79, 70, 229, 0.14);
            --mt-transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--mt-bg);
        }

        #MainHeading {
            font-family: 'Inter', sans-serif;
            font-weight: 700 !important;
            letter-spacing: 0.2px;
        }

        /* =========================================================
           MAIN TABS — modernized pill style
        ========================================================= */
        .main-tab-container {
            gap: 8px;
            background: #fff;
            padding: 6px;
            border-radius: 14px;
            box-shadow: var(--mt-shadow-sm);
            border: 1px solid var(--mt-border);
            flex-wrap: wrap;
        }

        .main-tab {
            flex: 1 1 auto;
            min-width: 120px;
            background: transparent;
            border: none;
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--mt-muted);
            transition: var(--mt-transition);
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .main-tab:hover {
                background: var(--mt-primary-light);
                color: var(--mt-primary-dark);
            }

            .main-tab.active {
                background: linear-gradient(135deg, var(--mt-primary) 0%, var(--mt-accent) 100%);
                color: #fff !important;
                font-weight: 700;
                box-shadow: 0 6px 16px rgba(79, 70, 229, 0.35);
                transform: translateY(-1px);
            }

            .main-tab::before {
                font-family: "bootstrap-icons";
                font-size: 1rem;
            }

            .main-tab#tab-eway::before {
                content: "\f287";
            }

            .main-tab#tab-export::before {
                content: "\f130";
            }

            .main-tab#tab-import::before {
                content: "\f30a";
            }

        /* =========================================================
           CARD WRAPPER for tab content
        ========================================================= */
        .modern-card {
            background: #fff;
            border-radius: var(--mt-card-radius);
            box-shadow: var(--mt-shadow-md);
            border: 1px solid var(--mt-border);
            padding: 28px 24px;
            animation: mtFadeInUp 0.4s ease both;
        }

        .modern-card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px dashed var(--mt-border);
        }

            .modern-card-header i {
                font-size: 1.25rem;
                color: var(--mt-primary);
                background: var(--mt-primary-light);
                padding: 8px;
                border-radius: 10px;
            }

            .modern-card-header span {
                font-weight: 700;
                font-size: 1.05rem;
                color: var(--mt-text);
            }

        @@keyframes mtFadeInUp {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes mtFadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        /* Stagger field entrance animation */
        .modern-card .row.g-3 > div {
            animation: mtFadeInUp 0.45s ease both;
        }

            .modern-card .row.g-3 > div:nth-child(1) {
                animation-delay: 0.02s;
            }

            .modern-card .row.g-3 > div:nth-child(2) {
                animation-delay: 0.06s;
            }

            .modern-card .row.g-3 > div:nth-child(3) {
                animation-delay: 0.10s;
            }

            .modern-card .row.g-3 > div:nth-child(4) {
                animation-delay: 0.14s;
            }

            .modern-card .row.g-3 > div:nth-child(5) {
                animation-delay: 0.18s;
            }

            .modern-card .row.g-3 > div:nth-child(6) {
                animation-delay: 0.22s;
            }

        /* =========================================================
           FIELD ICONS + modernized inputs
        ========================================================= */
        .field-with-icon {
            position: relative;
        }

            .field-with-icon .field-icon {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--mt-primary);
                font-size: 0.95rem;
                z-index: 3;
                pointer-events: none;
                transition: var(--mt-transition);
            }

            .field-with-icon.icon-top .field-icon {
                top: 16px;
                transform: none;
            }

            .field-with-icon .form-control,
            .field-with-icon select {
                padding-left: 2.4rem !important;
            }

            .field-with-icon .labelup {
                left: 2.35em;
            }

            .field-with-icon .labelupfortextarea {
                left: 2.35em;
            }

            .field-with-icon.select2-wrapped .field-icon {
                z-index: 1;
            }

        .form-control,
        select.form-control,
        #cmbVehicleNo + .select2-container .select2-selection,
        textarea.form-control {
            border-radius: var(--mt-field-radius) !important;
            border: 1.5px solid var(--mt-border) !important;
            transition: var(--mt-transition);
            box-shadow: none !important;
        }

            .form-control:hover,
            select.form-control:hover {
                border-color: #cbd5e1 !important;
            }

            .form-control:focus,
            select.form-control:focus,
            textarea.form-control:focus {
                border-color: var(--mt-primary) !important;
                box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12) !important;
            }

                .form-control:focus ~ .field-icon,
                .field-with-icon:focus-within .field-icon {
                    color: var(--mt-accent);
                    transform: translateY(-50%) scale(1.15);
                }

        .select2-container--default .select2-selection--single {
            border-radius: var(--mt-field-radius) !important;
            border: 1.5px solid var(--mt-border) !important;
            height: 38px !important;
            padding-left: 2.2rem !important;
            transition: var(--mt-transition);
        }

        .select2-container--default.select2-container--focus .select2-selection--single,
        .select2-container--default.select2-container--open .select2-selection--single {
            border-color: var(--mt-primary) !important;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12) !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px !important;
            color: var(--mt-text) !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
        }

        /* Buttons — modernized with subtle motion */
        .btn {
            border-radius: var(--mt-field-radius);
            font-weight: 600;
            transition: var(--mt-transition);
            letter-spacing: 0.2px;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: var(--mt-shadow-md);
            }

            .btn:active {
                transform: translateY(0);
            }

        .btn-success {
            background: linear-gradient(135deg, #16a34a, #22c55e);
            border: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--mt-primary), var(--mt-accent));
            border: none;
        }

        /* =========================================================
           IMPORT TAB — drag & drop
        ========================================================= */
        .import-card {
            max-width: 640px;
            margin: 0 auto;
            text-align: center;
        }

        .dropzone {
            position: relative;
            border: 2px dashed #c7d2fe;
            border-radius: var(--mt-card-radius);
            background: linear-gradient(180deg, #fbfcff 0%, #f4f6ff 100%);
            padding: 40px 20px;
            cursor: pointer;
            transition: var(--mt-transition);
            margin-bottom: 20px;
        }

            .dropzone:hover {
                border-color: var(--mt-primary);
                background: var(--mt-primary-light);
            }

            .dropzone.dragover {
                border-color: var(--mt-accent);
                background: #e0f2fe;
                transform: scale(1.01);
                box-shadow: var(--mt-shadow-lg);
            }

        .dropzone-icon {
            font-size: 2.8rem;
            color: var(--mt-primary);
            display: inline-block;
            animation: mtBounce 2.4s ease-in-out infinite;
        }

        @@keyframes mtBounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }

        .dropzone-text {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--mt-text);
            margin: 12px 0 4px;
        }

        .dropzone-subtext {
            color: var(--mt-muted);
            font-size: 0.9rem;
            margin: 0;
        }

        .browse-link {
            color: var(--mt-primary);
            font-weight: 700;
            text-decoration: underline;
        }

        .file-preview {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: #fff;
            border: 1.5px solid var(--mt-border);
            border-radius: 12px;
            padding: 12px 16px;
            animation: mtFadeIn 0.3s ease both;
        }

            .file-preview i {
                color: var(--mt-success);
                font-size: 1.3rem;
            }

            .file-preview span {
                font-weight: 600;
                color: var(--mt-text);
                word-break: break-all;
            }

        .btn-remove {
            border: none;
            background: transparent;
            color: var(--mt-danger);
            font-size: 1.1rem;
            line-height: 1;
            padding: 0;
            transition: var(--mt-transition);
        }

            .btn-remove:hover {
                transform: scale(1.15);
            }

        .btn-import-modern {
            padding: 10px 32px;
            font-size: 1rem;
        }

            .btn-import-modern i {
                margin-right: 6px;
            }

        /* =========================================================
           RESPONSIVE — mobile & desktop
        ========================================================= */
        @@media (max-width: 767.98px) {
            .modern-card {
                padding: 18px 14px;
                border-radius: 12px;
            }

            .main-tab {
                min-width: 100px;
                font-size: 0.82rem;
                padding: 10px 8px;
            }

            .dropzone {
                padding: 28px 12px;
            }

            .dropzone-icon {
                font-size: 2.2rem;
            }

            .import-card {
                max-width: 100%;
            }

            #MainHeading {
                font-size: 15px !important;
            }
        }

        @@media (max-width: 575.98px) {
            .main-tab-container {
                flex-direction: column;
            }

            .main-tab {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="toastBox"></div>
    <div class="container">

        <div class="d-flex align-items-center gap-2">
            <!-- Larger heading -->
            <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
        </div>
        <hr />

        <!-- Custom Main Tabs -->
        <div class="main-tab-container fs-4">
            <div class="main-tab active" id="tab-eway">E-Way Details</div>
            <div class="main-tab" id="tab-export">Export</div>
            <div class="main-tab" id="tab-import">Import</div>

        </div>

        <div class="tab-content">
            <br />
            <div id="eway" class="tab-pane fade show active">

                <div class="modern-card">
                    <div class="modern-card-header">
                        <i class="bi bi-truck"></i>
                        <span>E-Way Bill Details</span>
                    </div>
                    <div class="row">
                        <div>
                            <div class="row g-3">
                                <!-- g-3 adds gap between columns -->
                                <!-- Eway Type -->
                                <div class="col-12 col-md-2">
                                    <span class="form-label field-with-icon">
                                        <i class="bi bi-file-earmark-text field-icon"></i>
                                        <select class="form-control FormclrcmbField" id="cmbEwayType" style="width:100%;">
                                            <option value="1">Invoice</option>
                                            <option value="2">Van Loading Slip</option>
                                        </select>
                                        <label class="labelup">Type *</label>
                                    </span>
                                    <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrEwayType" class="clrdivs"></div>

                                </div>
                                <!-- Vehicle No -->
                                <div class="col-12 col-md-2">
                                    <span class="form-label field-with-icon select2-wrapped">
                                        <i class="bi bi-truck-front field-icon"></i>
                                        <select id="cmbVehicleNo" style="width:100%;">
                                        </select>
                                        <label class="labelup">Vehicle No *</label>
                                    </span>
                                    <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrVehicleNo" class="clrdivs"></div>

                                </div>

                                <!-- Transport Mode -->
                                <div class="col-12 col-md-2">
                                    <span class="form-label field-with-icon">
                                        <i class="bi bi-signpost-split field-icon"></i>
                                        <select class="form-control FormclrcmbField" id="cmbTransportMode">
                                            <option value="0">Road</option>
                                            <option value="1">Rail</option>
                                            <option value="2">Air</option>
                                            <option value="3">Ship/Road cum ship</option>
                                        </select>
                                        <label class="labelup">Transport Mode</label>
                                    </span>
                                </div>

                                <!-- Transport Type -->
                                <div class="col-12 col-md-2">
                                    <span class="form-label field-with-icon">
                                        <i class="bi bi-box-seam field-icon"></i>
                                        <select class="form-control FormclrcmbField" id="cmbTransportType">
                                            <option value="0">Regular</option>
                                            <option value="1">ODC</option>
                                        </select>
                                        <label class="labelup">Tr.port Type</label>
                                    </span>
                                </div>

                                <!-- Transport ID -->
                                <div class="col-12 col-md-2">
                                    <span class="form-label field-with-icon">
                                        <i class="bi bi-hash field-icon"></i>
                                        <input type="text"
                                               txttag="0"
                                               class="form-control FormclrField"
                                               id="txtTransportID"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorTransportID')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorTransportID')" />
                                        <label class="labelup">Transport ID</label>
                                    </span>

                                    <div class="clrdiv" id="dvErrorTransportID" style="color:red"></div>
                                </div>

                                <!-- Transport Name -->
                                <div class="col-12 col-md-2">
                                    <span class="form-label field-with-icon">
                                        <i class="bi bi-person-badge field-icon"></i>
                                        <input type="text"
                                               txttag="0"
                                               class="form-control FormclrField"
                                               id="txtTransportName"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorTransportname')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorTransportname')" />
                                        <label class="labelup">Transport Name</label>
                                    </span>

                                    <div class="clrdiv" id="dvErrorTransportname" style="color:red ;font-size: 11px"></div>
                                </div>

                            </div>

                            <div class="row g-3 mt-2">
                                <!-- Doc ID -->
                                <div class="col-12 col-md-4">
                                    <span class="form-label field-with-icon icon-top">
                                        <i class="bi bi-journal-text field-icon"></i>
                                        <textarea rows="3"
                                                  class="form-control FormclrField"
                                                  id="txtEwayDocID"
                                                  onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorDocid')"
                                                  oninput="sanitizeAlphaNumeric(this, '#dvErrorDocid')"></textarea>

                                        <label class="labelupfortextarea">Doc ID</label>
                                    </span>

                                    <div class="clrdiv" id="dvErrorDocid" style="color:red ;font-size: 11px"></div>

                                    <a href="javascript:void(0)" class="fw-bolder" id="btnCommonDocFilter" style="float:right">
                                        <i class="bi bi-funnel-fill"></i> Document Filter
                                    </a>

                                    <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrEwayDocID" class="clrdivs"></div>
                                </div>

                                <!-- Update Button -->
                                <div class="col-12 col-md-1 d-flex align-items-end">
                                    <button id="btnEWayupdate" class="btn btn-success w-100 mb-5">
                                        <span class="bi bi-save" style="color:white"></span>&#x2009;Update
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- Export Tab -->
            <div id="export" class="tab-pane fade">
                <br>
                <div class="row">
                    <div class="container-fluid">
                        <div class="row g-1 align-items-end w-100">
                            <!-- g-3 adds spacing -->
                            <!-- Type -->
                            <div class="col-12 col-md-1">
                                <span class="form-label">
                                    <select class="form-control" id="cmbType">
                                        <option value="1">E-Way</option>
                                        <option value="2">E-Invoice</option>
                                    </select>
                                    <label class="labelup">Type</label>
                                </span>
                                <div id="divErrType" class="clrdivs text-danger mt-1" style="padding-left:5px;"></div>
                            </div>

                            <!-- Range -->
                            <div class="col-12 col-md-2">
                                <span class="form-label">
                                    <input type="text" class="form-control" id="txtRange" placeholder="Range">
                                    <label class="labelup">Range</label>
                                </span>
                                <div id="divErrRange" class="clrdivs text-danger mt-1" style="padding-left:5px;"></div>
                            </div>

                            <!-- Filter Date Type -->
                            <div class="col-12 col-md-1">
                                <span class="form-label">
                                    <select class="gdInput form-control" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                                </span>
                            </div>

                            <!-- From Date -->
                            <div class="col-12 col-md-2">
                                <span class="form-label">
                                    <input class="form-control FormfilterclrField" type="date" id="dtpFFrom"
                                           oninput="if(this.value > this.max){this.value=this.max;}">
                                    <label class="labelup">From</label>
                                </span>
                                <div id="divErrFFrom" class="clrdivs text-danger mt-1" style="padding-left:5px;"></div>
                            </div>

                            <!-- To Date -->
