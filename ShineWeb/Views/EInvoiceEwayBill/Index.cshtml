        document.querySelectorAll(".main-tab").forEach(tab => {
            tab.addEventListener("click", function () {

                // remove active from all tabs
                document.querySelectorAll(".main-tab").forEach(t => t.classList.remove("active"));

                // add active to clicked tab
                this.classList.add("active");

                // hide all tab panes
                document.querySelectorAll(".tab-pane").forEach(p => {
                    p.classList.remove("show", "active");
                });

                // determine which pane to show
                if (this.id === "tab-eway") {
                    document.getElementById("eway").classList.add("show", "active");
                }
                if (this.id === "tab-export") {
                    document.getElementById("export").classList.add("show", "active");
                }
                if (this.id === "tab-import") {
                    document.getElementById("import").classList.add("show", "active");
                }

            });
        });
        
    </script>
