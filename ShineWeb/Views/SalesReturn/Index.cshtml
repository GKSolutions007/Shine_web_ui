    function ProductPriceQtyChange(dQty, id = null, IdxType = 1, RIdx = 0) {
        var RowNo = IdxType == 1 ? nCurrentRowIndex : RIdx;
        var currrowdata = ProductTable.row(RowNo).data();
        var ProdID = currrowdata[0];
        //var id = e.target.id;
        var qty = dQty != "" ? parseFloat(dQty) : 0;//e.target.value != "" ? parseFloat(e.target.value) : 0;
        //var name = e.target.name;
        $("#tblProductData tbody tr").each(function () {
            var rowdata = ProductTable.row($(this)).data();
            var RowIndex = ProductTable.row($(this)).index();
            var GridProdID = rowdata[0];
            var trkInv = parseFloat(rowdata[8]);
            var TaxPern = parseFloat(rowdata[2]);
            var TempBatchQty = parseFloat(rowdata[27]);
            var TInvoicePrice = parseFloat(rowdata[28]);
            var TP = (TaxPern / 100) + 1;
            var ExclPrice = 0, InclPrice = 0, ProdDisc = 0, ProdDiscAmt = 0, TrDisc = 0, trDiscAmt = 0, AddnlDisc = 0, AddnlDiscAmt = 0,
                dPTGross = 0, dPTTax = 0, CFValue = 0, neta = 0;
            if (RowNo == RowIndex) {
                var ApponMRPCum = $(this).find("label[name='ApponMRPCum']").attr("lbltag") || 0;
                var TotMRPonTaxAmt = $(this).find("label[name='TotalMRPonTax']").attr("lbltag") || 1; 
                if (qty == 0) {
                    $(this).find('td').css("background-color", "lightgrey");
                }
                else {
                    $(this).find('td').css("background-color", "white");
                }
                if (true)//TempBatchQty >= qty || trkInv == 0
                {
                    $(this).find("input").each(function (index) {
                        const fieldName = $(this).attr("name");
                        const fieldID = $(this).attr("id");
                        if (fieldName == "Excl") {
                            ExclPrice = parseFloat($(this).attr("txttag"));
                        }
                        if (fieldName == "Incl") {
                            InclPrice = parseFloat($(this).attr("txttag"));
                        }
                        if (fieldName == "ProdDiscPern") {
                            ProdDisc = parseFloat($(this).attr("txttag"));
                        }
                        if (fieldName == "ProdDiscAmt") {
                            //ProdDisc = parseFloat($(this).attr("txttag"));
                            var price = (ExclPrice * qty);
                            ProdDiscAmt = parseFloat((price * ProdDisc) / 100);
                            updateInputColumn(fieldID, ProdDiscAmt);
                        }
                        if (fieldName == "TradeDiscPern") {
                            TrDisc = parseFloat($(this).attr("txttag"));
                        }
                        if (fieldName == "TradeDiscAmt") {
                            //ProdDisc = parseFloat($(this).attr("txttag"));
                            var price = ((ExclPrice * qty) - ProdDiscAmt);
                            TrDiscAmt = parseFloat((price * TrDisc) / 100);
                            updateInputColumn(fieldID, TrDiscAmt);
                        }
                        if (fieldName == "AddnlDiscPern") {
                            AddnlDisc = parseFloat($(this).attr("txttag"));
                        }
                        if (fieldName == "AddnlDiscAmt") {
                            var price = ((ExclPrice * qty) - ProdDiscAmt);
                            AddnlDiscAmt = parseFloat((price * AddnlDisc) / 100);
                            updateInputColumn(fieldID, AddnlDiscAmt);
                        }
                    });
                    $(this).find("select").each(function (index) {
                        const fieldName = $(this).attr("name");
                        const fieldID = $(this).attr("id");
                        if (fieldName == "UOM") {
                            var val = $('option:selected', this).attr('name');
                            CFValue = parseFloat(val);
                        }
                    });
                    $(this).find("label").each(function (index) {
                        const fieldName = $(this).attr("name");
                        const fieldID = $(this).attr("id");
                        var price = (ExclPrice * qty);
                        if (fieldName == "Goods") {
                            var gds = parseFloat(price);//;
                            //$(this).text(gds);
                            updateLabelColumn(fieldID, gds);
                            dPTGoods = gds;
                        }
                        if (fieldName == "Gross") {
                            var grs = (parseFloat(price) - (TrDiscAmt + AddnlDiscAmt + ProdDiscAmt));//;
                            //$(this).text(grs);
                            updateLabelColumn(fieldID, grs);
                            dPTGross = grs;
                        }
                        if (fieldName == "TaxAmt") {
                            var tamt = ApponMRPCum > 0 ? (qty * parseFloat(TotMRPonTaxAmt)) : ((TaxPern * dPTGross) / 100);//;
                            //$(this).text(tamt);
                            updateLabelColumn(fieldID, tamt);
                            dPTTax = tamt;
                        }
                        if (fieldName == "NetAmt") {
                            neta = (parseFloat(dPTGross) + parseFloat(dPTTax));//;
                            //$(this).text(neta);
                            updateLabelColumn(fieldID, neta);

                            //dPTNet = parseFloat($(this).text());
                        }
                        if (fieldName == "DiffValue") {
                            if (dQty > 0) {
                                var val = dPTGross / dQty;
                                var Diff = (TInvoicePrice * CFValue) - val;
                                var AbsDiff = Diff;// Math.abs(Diff);
                                updateLabelColumn(fieldID, AbsDiff);
                                var clrcolor = Diff >= 0 ? "green" : "red";
                                $(this).css("color", clrcolor);
                            }
                            else {
                                updateLabelColumn(fieldID, 0);
                                $(this).css("color", "black");
                                //DiffExcl += 0;
                                //DiffIncl += 0;
                            }
                        }
                    });

                }
                else {
                    if (id != null) {
                        updateInputColumn(id, 0);
                        showErrorSnackbar("Qty Mismatched. Qty should be less than Batch Qty only.")
                    }
                }
            }
        });
        calculateProdGrid();
    }
