<style>
    .summary-box {
        display: inline-block;
        min-width: 100px;
        padding: 15px 20px;
        border-radius: 8px;
        margin: 5px;
        text-align: center;
        vertical-align: middle;
    }

    .bg-paid {
        background-color: #ccf5e7;
    }

    .bg-unpaid {
        background-color: #d8eaff;
    }

    .bg-total {
        background-color: #ffd999;
    }

