<style>
    /* Align dropdown in DataTable cell */
    .action-dropdown {
        min-width: 100px;
        font-size: 12px;
        z-index: 100000;
        text-align: left;
    }

        /* Optional: Add hover effect */
        .action-dropdown > li > a {
            padding: 3px 12px;
            color: #333;
            text-decoration: none;
        }

            .action-dropdown > li > a:hover {
                background-color: #f5f5f5;
                color: #000;
            }

    /* Optional: Make dropdown button minimal */
    .dropdown-toggle {
        background-color: transparent !important;
        border: none !important;
        font-size: 15px;
        line-height: 1;
        padding: 2px 5px;
    }

        .dropdown-toggle::after {
            display: none;
        }
    /* ============ COMPACT FORM CONTROLS ============ */
    .form-control,
    select.form-control,
    input.form-control,
    textarea.form-control,
    .gdInput,
    select.gdInput,
    input.gdInput {
        padding: 4px 8px !important;
        font-size: 12px !important;
        height: 28px !important;
        line-height: 1.4 !important;
        margin-bottom:1.2px !important
    }

    textarea.form-control {
        height: auto !important;
        min-height: 60px !important;
    }

    .input-group-addon {
        padding: 4px 8px !important;
        font-size: 12px !important;
    }

    select.form-control {
        padding-right: 20px !important;
    }
    /* ============ INVOICE SECTION ANIMATIONS ============ */
    @@keyframes fadeInSection {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 5px rgba(76, 175, 80, 0.3);
        }

        50% {
            box-shadow: 0 0 20px rgba(76, 175, 80, 0.6);
        }
    }

    .animate-fade-in-section {
        animation: fadeInSection 0.6s ease-out;
    }

    .animate-slide-left {
        animation: slideInLeft 0.5s ease-out;
    }

    .stagger-delay-1 {
        animation-delay: 0.1s;
    }

    .stagger-delay-2 {
        animation-delay: 0.2s;
    }

    .stagger-delay-3 {
        animation-delay: 0.3s;
    }
    #tblBatch tbody {
        /*            display: block;
            width:100%;*/
        min-height: 100px;
    }

    .dt-scroll-body {
        min-height: 100px !important;
    }
    .clsnewitem {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 2px 5px;
        font-size: 12px;
        font-weight: 500;
        color: #0C447C;
        background: #E6F1FB;
        border: 0.5px solid #85B7EB;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, transform 0.1s;
        white-space: nowrap;
        user-select: none;
    }

        .clsnewitem:hover {
            background: #B5D4F4;
            transform: scale(1.05)
        }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
