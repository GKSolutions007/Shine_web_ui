        font-size: 11px;
        color: #333;
        margin-bottom: 5px;
    }

    .summary-value {
        font-size: 12px;
        font-weight: bold;
        color: #000;
    }

    .summary-symbol {
        font-size: 20px;
        font-weight: bold;
        margin: 0 8px;
        display: inline-block;
        vertical-align: middle;
    }
    .summary-box:hover::before {
        opacity: 1;
    }

    .summary-box:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
    }
    .table {
        margin-bottom: 0px !important;
    }

