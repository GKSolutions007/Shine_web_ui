<script type="text/javascript">

    var Aurl = '@Session["APIurl"]';
    var RID = '@Session["RoleID"]';
       var enableBranch = '@(Model.EnableBranch ?? "0")';
    //console.log("EnableBranch:", enableBranch);
   
    if ($("#txtEnableBranch").val() == 1) {
        $("#txtBranchName,#cmbFilterBranch").prop("disabled", true);
    }

    var grid, CreditNoteDebitNote;
    GetColumnSettingsData(2, 16, 1, true);
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    var PrintTransID = FID == 4 ? 12 : 13, PrintConfigID = 0;
    setDate("dtpDate", 0);
    setDate("dtpFFrom", 0);
    setDate("dtpFTo", 0);

    setTimeout(function () { GetFilterData(); }, 800);
    GetData(1,"");
    //GetData(2,"");
    //GetFilterData();
    GetPrintProfile(PrintTransID);
    
    $('#dtpDate,#txtBranchName').on('focus', function () {
        $(this).data("oldvalue", $(this).val());
    });
    $("#dtpDate").change(function (e) {
        var DocDate = e.target.value;
        var id = e.target.id;
        var Branch = $("#txtBranchName").val();
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });

    $("#txtBranchName").change(function (e) {
        if (typeof GetDocumentID !== "function") return;
        var DocDate = $("#dtpDate").val();
        var Branch = e.target.value;
        var id = e.target.id;
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });

    var arrPartyData = [], arrAccountData = [], arrBranchData = [], arrALPartyData = [], arrALAccountData = [], arrALBranchData = [], nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch;
    function GetData(nMode,nID) {
        $.ajax({
            url: Aurl + "creditdebitnote/get",
            type: 'get',
            contentType: 'json',
            data: { TransID: FID, Mode: nMode, ID: nID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    CreditNoteDebitNote = data;
                    $('#cmbUDN,#txtBranchName').find("option").remove();
                    $('#cmbUDN,#txtBranchName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));

                    arrPartyData = [], arrAccountData = [], arrBranchData = [], arrALPartyData = [], arrALAccountData = [], arrALBranchData = [];
                    nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch = 0;
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            var al = {
                                "label": items.Name,
                            }
                            arrALPartyData.push(al);
                            arrPartyData[nIndexarrParty] = items.Name;
                            nIndexarrParty++;
                        }
                        if (items.FType == 2) {
                            var al = {
                                "label": items.Name,
                            }
                            arrALAccountData.push(al);
                            arrAccountData[nIndexarrAccount] = items.Name;
                            nIndexarrAccount++;
                        }
                        if (items.FType == 3) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            $("#lblDocID").text(items.Name);
                        }                       
                    });
                    SetAutlistforFields();
                    //$("#txtBranchName").val(DefBranch);
                    LoadBranchByRoles('#txtBranchName,#cmbFilterBranch');
                }
                if (nMode == 3) {
                    //~Assign Data
                    $.each(data, function (i, items) {
                        if (nTransMode != 3)
                            $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);

                            $("#txtID").val(items.ID), $("#dtpDate").val(items.DocDate),
                                $("#txtRefNo").val(items.RefNo), $("#txtBranchName").val(items.BranchID),
                                $("#txtPartyName").val(items.PartyID), $("#txtAccountName").val(items.FAID),
                         $("#txtRemarks").val(items.Remark), $("#txtNarration").val(items.Narration),
                            $("#cmbUDN").val(items.UDFId), $("#txtStatus").val(items.Status);
                        updateInputColumn("txtValue", items.NoteValue);
                        modal.show();
                    });
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#txtBranchName").prop("disabled", true);
                    }
                } txtBranchName
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $('#btnTEdit').click(function (e) {
        var Did = $("#txtID").val();
        var Currsts = $("#txtStatus").val();
        $(".clrdivs").html("");
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        $.ajax({
            url: Aurl + "validatedocument",
            type: 'get',
            contentType: 'json',
            data: { ActionType: 1, TransID: FID, ID: Did, Status: Currsts },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        EditActionTrigger(rowinfo);
                    }
                    else {
                        showErrorSnackbar(items.Message)
                    }
                });
            }
        });
    });
    function EditActionTrigger(rowData) {
        nTransMode = 2;
        GetData(3, rowData.ID);
        nTransMode = 2;
        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnClear").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear").hide();
        $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
        $("#btnSave,#btnClose").prop("disabled", false);
        $("#btnSave,#btnClose").show();
        $("#btnEmail,#btnWhatsapp").hide();
        $(".modal-title#lblPopupheading").text("Modify " + $("#txtFormName").val());
    }
    $('#btnTCancel').click(function (e) {
        var Did = $("#txtID").val();
        var Currsts = $("#txtStatus").val();
        $(".clrdivs").html("");
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        $.ajax({
            url: Aurl + "validatedocument",
            type: 'get',
            contentType: 'json',
            data: { ActionType: 2, TransID: FID, ID: Did, Status: Currsts },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        CancelActionTrigger(rowinfo);
                    }
                    else {
                        showErrorSnackbar(items.Message)
                    }
                });
            }
        });
    });
    function CancelActionTrigger(rowData) {
        $(".modal-title#lblPopupheading").text("Cancel " + $("#txtFormName").val());
        nTransMode = 4;
        GetData(3, rowData.ID);
        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#txtNarration,#txtRemarks").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnClear,#btnDraft").prop("disabled", true);
        $("#btnSave,#btnClose").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
        $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
        $("#btnSave,#btnClose").show();
        $("#btnEmail,#btnWhatsapp").hide();
        $("#btnPreview,#btnPDF,#btnClear").prop("disabled", true);
    }
    $('#btnTVariant').click(function (e) {
        var Did = $("#txtID").val();
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        VariantActionTrigger(rowinfo);
    });
    function VariantActionTrigger(rowData) {
        GetData(1, "");
        GetData(3, rowData.ID);
        $(".modal-title#lblPopupheading").text("Variant " + $("#txtFormName").val());
        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
        $("#btnSave,#btnClear,#btnDraft").prop("disabled", false);
        $("#btnPreview,#btnPDF").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear").hide();
        $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
        $("#btnEmail,#btnWhatsapp").hide();
        $("#btnSave,#btnClose,#btnDraft").show();
        setTimeout(() => {
            var DocDate = $("#dtpDate").val();
            var Branch = $("#txtBranchName").val();
            GetDocumentID(DocDate, Branch, FID);
        }, 1000);
    }
        var DecVal = '@Session["DecimalValues"]';
function updateInputColumn(inputID, netValue) {
    //const label = document.getElementById(`dgvProdGross${rowId}`);
    const input = document.getElementById(inputID);
    var value = netValue != "" ? netValue : 0;
    input.setAttribute('txttag', parseFloat(value).toFixed(4));
    input.value = parseFloat(value).toFixed(DecVal);
    input.title = netValue;
}
    $(".txtsettag").focusin(function (e) {
        var id = e.target.id;
        const val = document.getElementById(id).getAttribute("txttag");
        $("#" + id).val(val);
        $("#" + id).select();
    });
    $(".txtsettag").blur(function (e) {
        var val = e.target.value;
        var id = e.target.id;
        updateInputColumn(id, val);
    });
    function SetTagZero() {
        var inputs = $(".txtsettag");
        for (var i = 0; i < inputs.length; i++) {
            var field = $(inputs[i]);
            var FID = field[0].id;
            updateInputColumn(FID, "0");
        }
    }

    $('#btnFilter').click(function (e) {
        GetFilterData(1);
    });
    var Showall = '@Session["Showallstatus"]';
    $("#chkShowAll").prop("checked", Showall == '1');
    //~Filter Data
    function GetFilterData(ClickType = 0) {//arrVendorName,divErrFTo,divErrFFrom,divErrFParty
        var IsValid = true;
        //txtFilterAccount,txtFilterParty
        $(".clrdivs").html("");
        if ($("#txtFilterParty").val() != "") {
            const exists = arrPartyData.indexOf($("#txtFilterParty").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#divErrFParty").html("Select Party Name from list");
            }
        }
        if ($("#txtFilterAccount").val() != "") {
            const exists = arrAccountData.indexOf($("#txtFilterAccount").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#divErrFAccount").html("Select Account Name from list");
            }
        }
        if ($("#dtpFFrom").val() == "") {
            IsValid = false;
            $("#divErrFFrom").html("From date should not be empty");
        }
        if ($("#dtpFTo").val() == "") {
            IsValid = false;
            $("#divErrFTo").html("To date should not be empty");
        }
        if ($("#dtpFFrom").val() > $("#dtpFTo").val()) {
            IsValid = false;
            $("#divErrFFrom").html("From date should be lessthan To Date");
        }
        if (IsValid) {
            var strBranch = $("#cmbFilterBranch").val(), strAcc = $("#txtFilterAccount").val().trim(), strParty = $("#txtFilterParty").val().trim(), dFrom = $("#dtpFFrom").val(),
                dTo = $("#dtpFTo").val(), chkshow = $("#chkShowAll").is(":checked") ? "1" : "0";
            $.ajax({
                url: Aurl + "creditdebitnote/getfilterdata",
                type: 'get',
                contentType: 'json',
                data: { Mode: 2, TransID: FID, Branch: strBranch, AccName: strAcc, Party: strParty, FromDate: dFrom, ToDate: dTo, Showall: chkshow },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    if (data.length == 0) {
                        showErrorSnackbar("No Records Found");
                    }
                    var billjsdata = eval(data);
                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                    grid = new GKBSDynamicGrid('#my-grid', columns, billjsdata, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,
                        enableAddRow: false,
                        enableRemoveRow: false,
                        enableSorting: true,
                        searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                        rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                        //onCellChange: handleCellUpdate,
                        customCellRenderer: (el, col, rowData) => {                            
                        },
                        customButtons: [
                            {
                                icon: '⚙️',
                                text: '',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {                                   
                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 16, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'New',
                                title: 'New ' + $("#txtFormName").val(),
                                visible: $("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {                                   
                                    nTransMode = 1;
                                    $(".FormclrField,.FormclrcmbField").prop("disabled", false);
                                    $("#btnSave,#btnClear,#btnClose").prop("disabled", false);
                                    $("#btnPreview,#btnPDF").prop("disabled", true);
                                    $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                    $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
                                    modal.show();
                                    ClearForm();
                                    setTimeout(() => {
                                        var DocDate = $("#dtpDate").val();
                                        var Branch = $("#txtBranchName").val();
                                        if (Branch > 0 && DocDate !== "") {
                                            GetDocumentID(DocDate, Branch, FID);
                                        }
                                    }, 1000);
                                }
                            },
                        ],
                        onCellClick: (rowData, fieldName, cellValue, column) => {
                            
                        },
                        onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                            
                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(16, 1, 0, colIndex, field, newWidth)
                        },
                    });

                    if (billjsdata.length == 0) {
                        if (ClickType == 1)
                            showErrorSnackbar("No records found");
                    }                    
                }, error: function (data) {
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
        }
    }
    function SetAutlistforFields() {
        //~AutoList PartyName
        PaginatedAutocomplete({
            inputId: "txtPartyName",
            data: arrALPartyData,
            onSelect: function (item) {
                $("#txtPartyName").val(item.label);
                return false;
            }
        });
        //~AutoList FilterParty
        PaginatedAutocomplete({
            inputId: "txtFilterParty",
            data: arrALPartyData,
            onSelect: function (item) {
                $("#txtFilterParty").val(item.label);
                return false;
            }
        });
        //~AutoList AccountName
        PaginatedAutocomplete({
            inputId: "txtAccountName",
            data: arrALAccountData,
            onSelect: function (item) {
                $("#txtAccountName").val(item.label);
                return false;
            }
        });
        //~AutoList FilterAccount
        PaginatedAutocomplete({
            inputId: "txtFilterAccount",
            data: arrALAccountData,
            onSelect: function (item) {
                $("#txtFilterAccount").val(item.label);
                return false;
            }
        });       
    }
    var modal = new bootstrap.Modal(document.getElementById('myModalfg'));//document.getElementById("myModalfg");

    //~Close
    $('#btnClose').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        if ($("#txtTransType").val() == 3 || $("#txtTransType").val() == 2) {
            this.close();
        } else {
            modal.hide();
        }
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        GetData(1, "");
        $(".FormclrField").val("");
        $(".FormclrcmbField").val(0);
        $(".clrdiv").html("");
        $("#btnEmail,#btnWhatsapp").hide();
        $("#txtPartyName").focus();
        setDate("dtpDate", 0);
        SetFilterDate();
        SetTagZero();
        //$("#txtBranchName").val(DefBranch);
        LoadBranchByRoles('#txtBranchName,#cmbFilterBranch');
        //setTimeout(function () { GetFilterData(); }, 800);
        if (nTransMode != 1)
            modal.hide();
        $("#btnPreview,#btnPDF").prop("disabled", true);
        $("#txtProdDiscAmt").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint").hide();
        $("#btnSave,#btnClose,#btnDraft,#btnClear").show();
        if ($("#txtEnableBranch").val() == 1) {
            $("#txtBranchName").prop("disabled", true);
        }
    }
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        var IsValid = true, ChkFormation = true;
        //~Validation
        if ($("#txtBranchName").val() == 0 || $("#txtBranchName").val() == "") {
            IsValid = false;
            $("#divErrBranch").html("Select Branch");
            showErrorSnackbar("Select Branch");
        }
        if ($("#txtPartyName").val() == "") {
            IsValid = false;
            $("#dvErrorPartyName").html("Party Name should not be empty");
            showErrorSnackbar("Party Name should not be empty");
        }
        else {
            const exists = arrPartyData.indexOf($("#txtPartyName").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#dvErrorPartyName").html("Select Party Name from list");
                showErrorSnackbar("Select Party Name from list");
            }
        }
        if ($("#txtAccountName").val() == "") {
            IsValid = false;
            $("#dvErrorAccountName").html("Select Account should not be empty");
            showErrorSnackbar("Select Account Name should not be empty");
        }
        else {
            const exists = arrAccountData.indexOf($("#txtAccountName").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#dvErrorAccountName").html("Select Account Name from list.");
                showErrorSnackbar("Select Account Name from list");
            }
        }
        if ($("#txtValue").val() == "") {
            IsValid = false;
            $("#dvErrorValue").html("Value should not be empty");
            showErrorSnackbar("Value should not be empty");
        }
        else {
            var val = $("#txtValue").val();
            if (parseFloat(val) <= 0) {
                IsValid = false;
                $("#dvErrorValue").html("Value should be greater than zero");
                showErrorSnackbar("Value should be greater than zero");
            }
        }
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#dvErrorDate").html("Date should not be empty");
            showErrorSnackbar("Date should not be empty");
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var nStatus = $("#txtStatus").val() !== "" ? $("#txtStatus").val() : 1;
        var lstMaster = {
            "TransID": FID,
            "TransMode": nTransMode,
            "ID": $("#txtID").val(),
            "DocDate": $("#dtpDate").val(),
            "RefNo": $("#txtRefNo").val(),
            "BranchID": $("#txtBranchName").val(),
            "PartyID": $("#txtPartyName").val(),
            "FAID": $("#txtAccountName").val(),
            "NoteValue": document.getElementById("txtValue").getAttribute("txttag"), //$("#txtValue").val(),
            "Remark": $("#txtRemarks").val(),
            "Narration": $("#txtNarration").val(),
            "UDFId": $("#cmbUDN").val(),
            "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : nStatus,
            "CurrentStatus": nStatus,
            "CBy": UID
        };
            $.ajax({
                url: Aurl + "creditdebitnote/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (nTransMode != 4) {
                                if (allowprint == 1) {
                                    PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                } else if (allowprint == 3 || allowprint == 4) {
                                    PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                }
                                if (SendAutoMail == 1) {
                                    EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                }
                            }
                            ClearForm();
                            GetFilterData();
                            modal.hide();

                        }
                        else if (items.Message == "Code") {
                            $("#dvErrorCode").html("Code Already Exists");
                        }
                        else if (items.Message == "Name") {
                            $("#dvErrorName").html("Name Already Exists");
                        }
                        else if (items.Message == "AccountName") {
                            $("#dvErrorName").html("Account Name Already Exists in another master");
                        }
                        else {
                            //$("#divErrorOnCode").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }
    //~View from another form(Home, Fin Rep Space click)
    if ($("#txtID").val() > 0 && $("#txtTransType").val() == 2) {
        nTransMode = 5;
        var ID = $("#txtID").val();
        setTimeout(() => {
            GetData(3, ID);
        }, 500);
        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnPrint").show();
        $("#btnEmail,#btnWhatsapp").show();
        $("#btnSave,#btnClear,#btnDraft").hide();
        $(".modal-title#lblPopupheading").text("View " + $("#txtFormName").val());
    }
</script>