    var arrPartyData = [], arrAccountData = [], arrBranchData = [], arrALPartyData = [], arrALAccountData = [], arrALBranchData = [], nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch;
    function GetData(nMode,nID) {
        $.ajax({
            url: Aurl + "creditdebitnote/get",
            type: 'get',
            contentType: 'json',
            data: { TransID: FID, Mode: nMode, ID: nID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    CreditNoteDebitNote = data;
                    $('#cmbUDN,#txtBranchName').find("option").remove();
                    $('#cmbUDN,#txtBranchName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));

                    arrPartyData = [], arrAccountData = [], arrBranchData = [], arrALPartyData = [], arrALAccountData = [], arrALBranchData = [];
                    nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch = 0;
                    console.log(data);
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            var al = {
                                "id":items.ID,
                                "label": items.Name,
                            }
                            arrALPartyData.push(al);
                            arrPartyData[nIndexarrParty] = items.Name;
                            nIndexarrParty++;
                        }
                        if (items.FType == 2) {
                            var al = {
                                "id": items.ID,
                                "label": items.Name,
                            }
                            arrALAccountData.push(al);
                            arrAccountData[nIndexarrAccount] = items.Name;
                            nIndexarrAccount++;
                        }
                        if (items.FType == 3) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            $("#lblDocID").text(items.Name);
                        }
                    });
                    SetAutlistforFields();
                    //$("#txtBranchName").val(DefBranch);
                    LoadBranchByRoles('#txtBranchName,#cmbFilterBranch');
                }
                if (nMode == 3) {
                    //~Assign Data
                    $.each(data, function (i, items) {
                        if (nTransMode != 3)
                            $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);

                            $("#txtID").val(items.ID), $("#dtpDate").val(items.DocDate),
                                $("#txtRefNo").val(items.RefNo), $("#txtBranchName").val(items.BranchID),
                                $("#txtPartyName").val(items.PartyID), $("#txtAccountName").val(items.FAID),
                         $("#txtRemarks").val(items.Remark), $("#txtNarration").val(items.Narration),
                            $("#cmbUDN").val(items.UDFId), $("#txtStatus").val(items.Status);
                        updateInputColumn("txtValue", items.NoteValue);
                        modal.show();
                    });
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#txtBranchName").prop("disabled", true);
                    }
                } txtBranchName
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
