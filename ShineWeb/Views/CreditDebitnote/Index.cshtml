    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        var IsValid = true, ChkFormation = true;
        if ($("#txtBranchName").val() == 0 || $("#txtBranchName").val() == "") {
            IsValid = false;
            $("#divErrBranch").html("Select Branch");
            showErrorSnackbar("Select Branch");
        }
        if ($("#txtPartyName").val() == "") {
            IsValid = false;
            $("#dvErrorPartyName").html("Party Name should not be empty");
            showErrorSnackbar("Party Name should not be empty");
        }
        else {
            const exists = arrPartyData.indexOf($("#txtPartyName").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#dvErrorPartyName").html("Select Party Name from list");
                showErrorSnackbar("Select Party Name from list");
            }
        }
        if ($("#txtAccountName").val() == "") {
            IsValid = false;
            $("#dvErrorAccountName").html("Select Account should not be empty");
            showErrorSnackbar("Select Account Name should not be empty");
        }
        else {
            const exists = arrAccountData.indexOf($("#txtAccountName").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#dvErrorAccountName").html("Select Account Name from list.");
                showErrorSnackbar("Select Account Name from list");
            }
        }
        if ($("#txtValue").val() == "") {
            IsValid = false;
            $("#dvErrorValue").html("Value should not be empty");
            showErrorSnackbar("Value should not be empty");
        }
        else {
            var val = $("#txtValue").val();
            if (parseFloat(val) <= 0) {
                IsValid = false;
                $("#dvErrorValue").html("Value should be greater than zero");
                showErrorSnackbar("Value should be greater than zero");
            }
        }
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#dvErrorDate").html("Date should not be empty");
            showErrorSnackbar("Date should not be empty");
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var nStatus = $("#txtStatus").val() !== "" ? $("#txtStatus").val() : 1;
        var lstMaster = {
            "TransID": FID,
            "TransMode": nTransMode,
            "ID": $("#txtID").val(),
            "DocDate": $("#dtpDate").val(),
            "RefNo": $("#txtRefNo").val(),
            "BranchID": $("#txtBranchName").val(),
            "PartyID": $("#txtPartyName").val(),
            "FAID": $("#txtAccountName").val(),
            "NoteValue": document.getElementById("txtValue").getAttribute("txttag"), //$("#txtValue").val(),
            "Remark": $("#txtRemarks").val(),
            "Narration": $("#txtNarration").val(),
            "UDFId": $("#cmbUDN").val(),
            "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : nStatus,
            "CurrentStatus": nStatus,
            "CBy": UID
        };
        console.log("SAVE PAYLOAD (object):", lstMaster);
        console.log("SAVE PAYLOAD (json):", JSON.stringify(lstMaster, null, 2));
            $.ajax({
                url: Aurl + "creditdebitnote/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (nTransMode != 4) {
                                if (allowprint == 1) {
                                    PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                } else if (allowprint == 3 || allowprint == 4) {
                                    PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                }
                                if (SendAutoMail == 1) {
                                    EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                }
                            }
                            ClearForm();
                            //GetData(2,"");
                            GetFilterData();
                            modal.hide();

                        }
                        else if (items.Message == "Code") {
                            $("#dvErrorCode").html("Code Already Exists");
                        }
                        else if (items.Message == "Name") {
                            $("#dvErrorName").html("Name Already Exists");
                        }
                        else if (items.Message == "AccountName") {
                            $("#dvErrorName").html("Account Name Already Exists in another master");
                        }
                        else {
                            //$("#divErrorOnCode").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }


