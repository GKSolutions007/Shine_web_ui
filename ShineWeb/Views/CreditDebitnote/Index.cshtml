    <div class="modal fade " id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">

                    <div class="container-fluid">

                        <div class="row pt-1">

                            <!-- Branch -->
                            <div class="col-md-3">
                                <span class="form-label">
                                    <select class="form-control FormclrcmbField"
                                            id="txtBranchName"
                                            @(Model.EnableBranch == "1" ? "disabled" : "")>
                                        <option value="0">Select Branch</option>
                                    </select>
                                    <label class="labelup">Branch *</label>
                                </span>
                                <div id="dvErrorBranchName" class="clrdiv text-danger"></div>
                            </div>
                            <!-- Ref No -->
                            <div class="col-md-3">
                                <span class="form-label">
                                    <input class="form-control FormclrField"
                                           type="text"
                                           id="txtRefNo"
                                           onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRefNo')"
                                           oninput="sanitizeAlphaNumeric(this, '#divErrRefNo')" />
                                    <label class="labelup">Ref No</label>
                                </span>
                                <div id="divErrRefNo" class="clrdiv text-danger"></div>
                            </div>
                            <!-- Blank -->
                            <div class="col-12 col-md-3 mb-3"></div>
                            <!-- Doc ID -->
                            <div class="col-12 col-md-3">
                                <table>
                                    <tr>
                                        <td align="right">
                                            <span class="fw-semibold">
                                                Doc ID :
                                            </span>
                                        </td>
                                        <td>
                                            <label id="lblDocID" docprefix="" style="font-size:14px" class="fw-bolder">CRDR/2425/1</label>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="right">
                                            <span class="fw-semibold">
                                                Date :
                                            </span>
                                        </td>
                                        <td>
                                            <input class="clsdtpfieldbottomborder FormclrField"
                                                   type="date"
                                                   id="dtpDate"
                                                   oninput="if (this.value > this.max) { this.value = this.max; }"
                                                   placeholder="Date" />
                                        </td>
                                    </tr>
                                </table>
                                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrDate"></div>
                            </div>
                        </div>

                        <hr>

                        <div class="row">

                            <!-- LEFT -->
                            <div class="col-md-6">

                                <table class="table w-100">

                                    <tr>
                                        <td style="border:none;padding-right:7px" colspan="2">

                                            <span class="form-label">
                                                <input type="text" id="txtPartyName"
                                                       class="form-control FormclrField" />
                                                <label class="labelup">Party Name *</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorPartyName"></div>

                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-right:7px" colspan="2">

                                            <span class="form-label">
                                                <input type="number"
                                                       id="txtValue"
                                                       txttag="0"
                                                       class="form-control FormclrField txtsettag"
                                                       onbeforeinput="return NumericOnlyBeforeInput(event, this,'#dvErrorValue')"
                                                       oninput="sanitizeNumericOnly(this, '#dvErrorValue')" />
                                                <label class="labelup">Value *</label>
                                            </span>

                                            <div class="clrdiv text-danger" id="dvErrorValue"></div>

                                        </td>
                                    </tr>

                                    <tr class="bgclrfortr">
