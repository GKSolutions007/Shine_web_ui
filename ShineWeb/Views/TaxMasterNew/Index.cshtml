@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>
    td {
        font-size: 12px;
    }

    hr {
        margin: 1rem 0;
        color: inherit;
        border: 0;
        border-top: 1px solid;
        opacity: .25;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 35%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 7%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 25%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -60%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        font-weight: 600;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }   
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormID, new { @autocomplete = "off", @class = "form-control", @id = "txtFormID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <div class="toastBox"></div>
    <hr />
    <div style="padding-bottom:10px;" hidden>
        <button id="btnAdd" class="btn btn-info"><span class="glyphicon glyphicon-plus" style="color: white"></span>&#x2009;Add</button>
    </div>
    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>

    <div class="modal fade " id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal Body -->
                <style>
                    /* Modern Modal Styling */
                    .modern-modal-body {
                        background-color: #f8f9fa;
                        padding: .5rem;
                    }
                    .modern-group-card {
                        background: #ffffff;
                        border-radius: 12px;
                        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
                        border: none;
                        margin-bottom: .5rem;
                        transition: transform 0.3s ease, box-shadow 0.3s ease;
                        animation: fadeIn 0.5s ease-in-out;
                    }
                    .modern-group-card:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
                    }
                    .modern-group-header {
                        padding: 1rem 1.25rem;
                        border-bottom: 1px solid #edf2f9;
                        background: linear-gradient(to right, #ffffff, #fcfcfc);
                        border-radius: 12px 12px 0 0;
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                        color: #2c3e50;
                        font-weight: 600;
                    }
                    .modern-group-header i {
                        color: #4361ee;
                        font-size: 1.1rem;
                    }
                    .modern-group-body {
                        padding: 1.25rem;
                    }
                    .form-control, .form-select {
                        border-radius: 8px;
                        border: 1px solid #dee2e6;
                        transition: all 0.2s;
                        box-shadow: none;
                    }
                    .form-control:focus, .form-select:focus {
                        border-color: #4361ee;
                        box-shadow: 0 0 0 0.2rem rgba(67, 97, 238, 0.15);
                    }
                    .form-check-modern {
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                        padding: 0.5rem;
                        background: #f8f9fa;
                        border-radius: 8px;
                        border: 1px solid #edf2f9;
                    }
                    /* Table enhancements */
                    #tblTaxDetails {
                        border-radius: 8px;
                        overflow: hidden;
                        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
                    }
                    #tblTaxDetails thead {
                        background-color: #f1f4f8;
                    }
                    #tblTaxDetails th {
                        font-weight: 600;
                        color: #495057;
                        border-bottom: 2px solid #e9ecef;
                    }
                    @@keyframes fadeIn {
                        from { opacity: 0; transform: translateY(10px); }
                        to { opacity: 1; transform: translateY(0); }
                    }
                    .animation-delay-1 { animation-delay: 0.1s; animation-fill-mode: both; }
                    .animation-delay-2 { animation-delay: 0.2s; animation-fill-mode: both; }
                    .animation-delay-3 { animation-delay: 0.3s; animation-fill-mode: both; }
                    .animation-delay-4 { animation-delay: 0.4s; animation-fill-mode: both; }
                </style>
                <div class="modal-body modern-modal-body">
                    
                    <!-- Group 1: Basic Information -->
                    <div class="card modern-group-card animation-delay-1">
                       
                        <div class="modern-group-body">
                            <div class="row g-4 align-items-center">
                                <div class="col-md-9">
                                    <span class="form-label">
                                        <input tabindex="1" type="text" id="txtName" class="form-control" placeholder=" " />
                                        <label class="labelup">Name *</label>
                                    </span>
                                    <div class="clrdiv text-danger clrdivs" id="dvErrorName" style="font-size: 0.85em; margin-top: 4px;"></div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check form-switch form-check-modern w-100 justify-content-center">
                                        <input class="form-check-input" type="checkbox" id="chkActive" tabindex="3" checked disabled style="cursor: pointer; width: 2.5em; height: 1.2em;" />
                                        <label class="form-check-label fw-bold" for="chkActive" style="cursor: pointer; padding-left: 5px;">Active</label>
                                    </div>
                                    <div class="clrdiv text-danger clrdivs" id="dvErrorActive" style="font-size: 0.85em; margin-top: 4px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 2: Tax Configuration -->
                    <div class="card modern-group-card animation-delay-2" id="dvTaxConfig">
                        <div class="modern-group-header">
                            <i class="bi bi-gear-fill"></i> Tax Configuration
                        </div>
                        <div class="modern-group-body">
                            <div class="row g-4 mb-3">
                                <div class="col-md-2">
                                    <span class="form-label">
                                        <select id="cmbTaxType" class="form-control">
                                            <option value="0">-- Select --</option>
                                        </select>
                                        <label class="labelup">Tax Type *</label>
                                    </span>
                                    <div class="clrdiv text-danger clrdivs" id="dvErrorTaxType" style="font-size: 0.85em; margin-top: 4px;"></div>
                                </div>
                                
                                <div class="col-md-2">
                                    <span class="form-label">
                                        <select id="cmbGSTType" class="form-control">
                                            <option value="0">-- Select --</option>
                                        </select>
                                        <label class="labelup">GST Type *</label>
                                    </span>
                                    <div class="clrdiv text-danger clrdivs" id="dvErrorGSTType" style="font-size: 0.85em; margin-top: 4px;"></div>
                                </div>
                                <div class="col-md-4">
                                    <span class="form-label">
                                        <select id="cmbTaxComp" class="form-control">
                                            <option value="0">-- Select --</option>
                                        </select>
                                        <label class="labelup">Tax Component *</label>
                                    </span>
                                    <div class="clrdiv text-danger clrdivs" id="dvErrorTaxComp" style="font-size: 0.85em; margin-top: 4px;"></div>
                                </div>
                                <div class="col-md-2">
                                    <span class="form-label">
                                        <select id="cmbAppon" class="form-control">
                                            <option value="0">-- Select --</option>
                                        </select>
                                        <label class="labelup">Applicable on *</label>
                                    </span>
                                    <div class="clrdiv text-danger clrdivs" id="dvErrorAppon" style="font-size: 0.85em; margin-top: 4px;"></div>
                                </div>
                                <div class="col-md-2">
                                    <span class="form-label">
                                        <input tabindex="1" type="number" id="txtPartoff" class="form-control" placeholder=" " />
                                        <label class="labelup">Part Off *</label>
                                    </span>
                                    <div class="clrdiv text-danger clrdivs" id="dvErrorPartoff" style="font-size: 0.85em; margin-top: 4px;"></div>
                                </div>
                            </div>
                            <div class="row g-4 align-items-center">                                
                                <div class="col-md-4">
                                    <span class="form-label">
                                        <input tabindex="1" type="number" id="txtCumulative" class="form-control" disabled placeholder=" " />
                                        <label class="labelup">Cumulative</label>
                                    </span>
                                    <div class="clrdiv text-danger clrdivs" id="dvErrorCumulative" style="font-size: 0.85em; margin-top: 4px;"></div>
                                </div>
                                <div class="col-md-4 text-start">
                                    <button id="btnAddTax" class="btn btn-primary px-4 py-2" style="border-radius: 8px; font-weight: 500; transition: all 0.2s;">
                                        <i class="bi bi-plus-circle me-1"></i> Add Tax
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Group 3: Tax Details List -->
                    <div class="card modern-group-card animation-delay-3 px-3 py-3">
                        <table class="table table-hover w-100 mb-0" id="tblTaxDetails">
                            <thead class="table-light">
                                <tr>
                                    <th class="trclrforcolheader" style="width:0%">Tax Value</th>
                                    <th class="trclrforcolheader" style="width:12%">Tax Type</th>
                                    <th class="trclrforcolheader" style="width:13%">GST Type</th>
                                    <th class="trclrforcolheader" style="width:25%">Tax Component</th>
                                    <th class="trclrforcolheader" style="width:15%">Applicable on</th>
                                    <th class="trclrforcolheader" style="width:10%">Part off</th>
                                    <th class="trclrforcolheader" style="width:15%">Cumulative Tax</th>
                                    <th class="trclrforcolheader" style="width:10%">Action</th>
                                </tr>
                            </thead>
                        </table>
                    </div>

                    <!-- Group 4: Tax Values Summary -->
                    <div class="card modern-group-card animation-delay-4 mb-0">
                        <div class="modern-group-header">
                            <i class="bi bi-calculator-fill"></i> Tax Values Summary
                        </div>
                        <div class="modern-group-body">
                            <div class="d-flex flex-wrap w-100">
                                <!-- GST Tax Values: 80% Space -->
                                <div style="flex: 0 0 60%; max-width: 60%; padding-right: 20px;">
                                    <h6 class="text-primary mb-3" style="font-weight:600;"><i class="bi bi-percent"></i> GST Tax Values</h6>
                                    <div class="row g-4 mb-4">
                                        <div class="col-md-4">

                                            <span class="form-label">
                                                <input tabindex="1" type="number" txttag="0" id="txtGstTaxPern" class="form-control txtsettag" disabled placeholder=" " />
                                                <label class="labelup">GST Tax %</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorGstTaxPern" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" id="txtCGstTaxValue" class="form-control" disabled placeholder=" " />
                                                <label class="labelup">CGST Tax Value</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorCGstTaxValue" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" id="txtSGstTaxValue" class="form-control" disabled placeholder=" " />
                                                <label class="labelup">SGST Tax Value</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorSGstTaxValue" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>                                        
                                    </div>

                                    <div class="row g-4 mb-4">
                                        <div class="col-md-4">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" txttag="0" id="txtGUOMTaxAmt" class="form-control txtsettag" disabled placeholder=" " />
                                                <label class="labelup">GUOM Tax &#8377;</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorGUOMTaxAmt" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" id="txtUTGSTTaxValue" class="form-control" disabled placeholder=" " />
                                                <label class="labelup">UTGST Tax Value</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorUTGSTTaxValue" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                        <div class="col-md-4">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" id="txtGCESSTaxValue" class="form-control" disabled placeholder=" " />
                                                <label class="labelup">GCESS Tax Value</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorGCESSTaxValue" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- IGST Tax Values: 20% Space -->
                                <div style="flex: 0 0 40%; max-width: 40%; border-left: 1px solid #edf2f9; padding-left: 20px;">
                                    <h6 class="text-primary mb-3" style="font-weight:600;"><i class="bi bi-percent"></i> IGST Tax Values</h6>
                                    <div class="row g-4 mb-4">
                                        <div class="col-12 col-md-6">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" txttag="0" id="txtIGstTaxPern" class="form-control txtsettag" disabled placeholder=" " />
                                                <label class="labelup">IGST Tax %</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorIGstTaxPern" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" id="txtIGstTaxValue" class="form-control" disabled placeholder=" " />
                                                <label class="labelup">IGST Tax Value</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorIGstTaxValue" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                        
                                    </div>
                                    <div class="row g-4 mb-4">
                                        <div class="col-12 col-md-6">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" txttag="0" id="txtIUOMTaxAmt" class="form-control txtsettag" disabled placeholder=" " />
                                                <label class="labelup">IUOM Tax &#8377;</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorIUOMTaxAmt" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <span class="form-label">
                                                <input tabindex="1" type="number" id="txtICESSTaxValue" class="form-control" disabled placeholder=" " />
                                                <label class="labelup">ICESS Tax Value</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorICESSTaxValue" style="font-size: 0.85em; margin-top: 4px;"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer" style="background-color:skyblue">
                    <button tabindex="5" type="button" class="btn btn-danger" id="btnClear">
                        <span class="glyphicon glyphicon-refresh"> Clear</span>
                    </button>

                    <button tabindex="4" type="button" class="btn btn-success" id="btnSave">
                        <span class="glyphicon glyphicon-saved"> Save</span>
                    </button>

                    <button tabindex="6" type="button" class="btn btn-warning" id="btnClose">
                        <i class="bi bi-x-circle"></i> Close
                    </button>
                </div>

            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    var nTransMode = 1;
    const allGridActions = [
        {
            icon: '\uD83D\uDC41\uFE0F',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                var ID = rowData.ID;//[0];               
                nTransMode = 3;
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                $("#txtID").val(ID);
                $("#chkActive,#txtName,#cmbTaxType,#cmbGSTType,#cmbTaxComp,#cmbAppon,#txtPartoff").prop("disabled", true);                
                $("#dvTaxConfig,#btnSave,#btnClear").hide();
                $("#btnClear,#btnSave").hide();
                $("#btnClose").show();
                $(".clrdivs").html("");
                modal.show();
                getTaxData(ID)

            }
        },
        {
            icon: '\u270F\uFE0F',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                var ID = rowData.ID;//[0];               
                nTransMode = 2;
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                $("#chkActive,#txtName,#cmbTaxType,#cmbGSTType,#cmbTaxComp,#cmbAppon,#txtPartoff").prop("disabled", false);
                $("#dvTaxConfig,#btnSave").show();
                $("#btnClear").hide();
                $("#btnClear").hide();
                $("#btnClose,#btnSave").show();
                $(".clrdivs").html("");
                modal.show();
                getTaxData(ID)
            }
        }
    ];
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>

<script type="text/javascript">
     var UID = '@Session["LoginUserID"]';
    var FID = $("#txtFormID").val();
    var TableTaxDetails = $('#tblTaxDetails').DataTable({
        "bFilter": false,
        "bSearchable": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        scrollY: "120px",
        "columnDefs": [{ "targets": [0], "visible": false, searchable: false, filter: false }],
    });
    var EditRowID = -1, EditMode = 0;
    var DecVal = '@Session["DecimalValues"]';
    var Aurl = '@Session["APIurl"]';

    var grid, SingleMasterData;
    GetColumnSettingsData(2, 36, 1);
    var arrData = [], TaxNames = [], TaxComp = [], TaxTypes = [], GstTypes =[];
    setTimeout(() => {
        InitiateData();
    }, 500);
    //~Grid Data and Preload Data
    function InitiateData() {
        $.ajax({
            url: Aurl + "taxmaster/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: 1, ID:0 },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                arrData = [], TaxNames = [], TaxComp = [], TaxTypes = [], GstTypes = [];
                if (data.length == 0) {
                    showErrorSnackbar("No Records Found");
                }
                else {
                    var taxdatas = JSON.parse(data);
                    TaxNames = taxdatas.Table;
                    TaxComp = taxdatas.Table1;
                    TaxTypes = taxdatas.Table2;
                    GstTypes = taxdatas.Table3;
                }
                    //Table.draw().clear();
                $.each(TaxNames, function (i, items) {
                        //arrData[i] = items.Name
                        var al = {
                            "label": items.Name,
                            "id": items.ID,
                        }
                        arrData.push(al);
                    });
                var currentSearchValue = '';
                if (grid) {
                    currentSearchValue = grid ? grid.state.searchTerm : '';
                }
                grid = new GKBSDynamicGrid('#my-grid', columns, TaxNames, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
