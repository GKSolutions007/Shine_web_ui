    var arrAppon = [];
    function getApponDropdown() {
        arrAppon = [];
        $("#tblTaxDetails tbody tr").each(function () {
            var rowdata = TableTaxDetails.row($(this)).data();
            var dTaxPern = rowdata[0];            
            let $container = $(this);

            let $taxType = $container.find('label[name="TaxType"]');
            let $taxComp = $container.find('label[name="TaxComp"]');

            let strTaxType = $taxType.text();
            let nTaxTypeID = $taxType.data("id") || 0;

            let strTaxComp = $taxComp.text();
            let nTaxCompID = $taxComp.data("id") || 0;
            var appondata = {
                "TaxPern": dTaxPern,
                "TaxTypeID": nTaxTypeID,
                "TaxCompID": nTaxCompID,
                "TaxType": strTaxType,
                "TaxComp": strTaxComp,
            }
            arrAppon.push(appondata);
        });
    }
    function CalculateTaxSummary() {
        var GSTTaxPer = 0,CGSTTaxValue = 0,SGSTTaxValue = 0,IGSTTaxPer = 0,IGSTTaxValue = 0,GUOMTax = 0,
            UTGSTTaxValue = 0, CGESSTaxValue = 0, IUOMTax = 0, IGESSTaxValue = 0;
        if (TableTaxDetails.rows().count() > 0) {
            $("#tblTaxDetails tbody tr").each(function () {
                var rowdata = TableTaxDetails.row($(this)).data();
                var dTaxPern = parseFloat(rowdata[0]);
                let $Rowcontainer = $(this);
                let taxType = parseInt($Rowcontainer.find('label[name="TaxType"]').data("id"));
                let gstType = parseInt($Rowcontainer.find('label[name="GSTType"]').data("id"));
                //GST Cumulatives
                if (taxType == 1) GSTTaxPer += dTaxPern;
                if (taxType == 1 && gstType == 1) CGSTTaxValue += dTaxPern;
                if (taxType == 1 && gstType == 2) SGSTTaxValue += dTaxPern;
                if (taxType == 1 && gstType == 3) UTGSTTaxValue += dTaxPern;
                if (taxType == 1 && gstType == 4) CGESSTaxValue += dTaxPern;
                if (taxType == 1 && gstType == 5) GUOMTax += dTaxPern;
                //IGST Cumulatives
                if (taxType == 2) IGSTTaxPer += dTaxPern;
                if (taxType == 2 && gstType == 1) IGSTTaxValue += dTaxPern;
                if (taxType == 2 && gstType == 2) IGESSTaxValue += dTaxPern;
                if (taxType == 2 && gstType == 3) IUOMTax += dTaxPern;
            });
        }
        updateInputColumn("txtGstTaxPern", GSTTaxPer); updateInputColumn("txtCGstTaxValue", CGSTTaxValue);
        updateInputColumn("txtSGstTaxValue", SGSTTaxValue); updateInputColumn("txtUTGSTTaxValue", UTGSTTaxValue);
        updateInputColumn("txtGCESSTaxValue", CGESSTaxValue); updateInputColumn("txtGUOMTaxAmt", GUOMTax);
        updateInputColumn("txtIGstTaxPern", IGSTTaxPer); updateInputColumn("txtIGstTaxValue", IGSTTaxValue);
        updateInputColumn("txtIUOMTaxAmt", IUOMTax); updateInputColumn("txtICESSTaxValue", IGESSTaxValue);
    }
    function fillApponDropdown(TaxType,TaxCompID) {
        //var taxtype = $("#cmbTaxType").val();
        $('#cmbAppon').find("option").remove();
        $('#cmbAppon').append($('<option/>', {
            value: 0,
            text: "Price",
            pern: 100
        })).append($('<option/>', {
            value: -1,
            text: "MRP",
            pern: 100
        }));
        var filter = [];// arrAppon.filter(a => a.TaxTypeID == TaxType);

        if (TaxCompID == 0)
            filter = arrAppon.filter(a => a.TaxTypeID == TaxType);
        else
            filter = arrAppon.filter(a => a.TaxTypeID == TaxType && a.TaxCompID != TaxCompID);

        for (var i = 0; i < filter.length; i++) {
            $('#cmbAppon').append($('<option/>', {
                value: filter[i].TaxCompID,
                text: filter[i].TaxComp,
                pern: filter[i].TaxPern,
            }))
        }
    }
    $("#txtPartoff").change(function (e) {
        var paroff = e.target.value;
        var TaxPern = $("#cmbTaxComp option:selected").attr('taxpern');
        if (paroff <= 100) {
            var dPartoff = 100 / parseFloat(e.target.value);           
            var cumvalue = parseFloat(TaxPern) / dPartoff;
            $("#txtCumulative").val(cumvalue);
        }
        else {
            $("#txtPartoff").val(100);
            $("#txtCumulative").val(TaxPern);
            showErrorSnackbar("Part Off should be less than 100 only");
        }
    });
