    function getTaxData(TaxID) {
        $.ajax({
            url: Aurl + "taxmaster/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: 2, ID: TaxID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                var TaxHeader = [], TaxDetail = [];
                TableTaxDetails.draw().clear(); TableTaxDetails.draw().clear();
                if (data.length == 0) {
                    showErrorSnackbar("No Records Found");
                }
                else {
                    var taxdatas = JSON.parse(data);
                    TaxHeader = taxdatas.Table;
                    TaxDetail = taxdatas.Table1;
                }
                
                $.each(TaxHeader, function (i, items) {
                    $("#txtID").val(items.TaxID);
                    $("#txtName").val(items.TaxName);
                    updateInputColumn("txtGstTaxPern", items.GST);
                    updateInputColumn("txtIGstTaxPern", items.IGST);
                    updateInputColumn("txtGUOMTaxAmt", items.GUOM);
                    updateInputColumn("txtIUOMTaxAmt", items.IUOM);
                    $("#chkActive").prop("checked", items.Active == "1");
                });
                $.each(TaxDetail, function (i, items) {
                    TableTaxDetails.row.add([
                        items.TaxRate,
                        '<label name="TaxType" data-id=' + items.TaxTypeID + '>' + items.TaxTypeName + '</label>',
                        '<label name="GSTType" data-id=' + items.GSTTaxType + '>' + items.GSTTypeName + '</label>',
                        '<label name="TaxComp" data-id=' + items.TaxCompID + '>' + items.TaxCompName + '</label>',
                        '<label name="Appon" data-id=' + items.ApponID + '>' + items.ApponName + '</label>',
                        '<label name="PartOff">' + items.PartOff + '</label>',
                        '<label name="Cumulative">' + parseFloat(items.CumulativeTax).toFixed(DecVal) + '</label>',
                        nTransMode == 3? '' : '<span style="font-size:16px;" class="glyphicon glyphicon-remove-circle clsremoveprod" title="Remove"></span>&ensp;<span style="font-size:16px;" class="glyphicon glyphicon-edit clseditprod"  title="Edit"></span>'
                    ]).draw(false);
                });    
                setTimeout(() => {
                    CalculateTaxSummary();
                    getApponDropdown();
                }, 1000);
            },
            error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
