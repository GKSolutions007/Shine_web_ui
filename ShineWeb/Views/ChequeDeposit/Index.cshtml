                url: Aurl + "chequedeposit/getfilterdata",
                type: 'get',
                contentType: 'json',
                data: { Mode: 3, TransID: nDocprefix, AccName: strFAcc, Party: strParty, FromDate: dFrom, ToDate: dTo, Showall: chkshow },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    Table.draw().clear(); Table.draw().clear();
                    var billjsdata = eval(data);
                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                    grid = new GKBSDynamicGrid('#my-grid', columns, billjsdata, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,
                        enableAddRow: false,
                        enableRemoveRow: false,
                        enableSorting: true,
                        searchTerm: currentSearchValue, singleIconAction: singleIconAction,
                        rowActionsMenu: menuActions, 
                        customCellRenderer: (el, col, rowData) => {
                            
                        },
                        customButtons: [
                            {
                                icon: '⚙️',
                                text: 'Settings',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {                                    
                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 31, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'Add New',
                                title: 'Add New',
                                visible: $("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {
                                    //dvDocuments,
                                    nTransMode = 1;
                                    $("#dvMain").show();
                                    $("#dvDocuments").hide();
                                    ClearForm();
                                    setTimeout(function () {
                                        GetData(2, 0);
                                    }, 500);
                                }
                            },
                        ],
                        onCellClick: (rowData, fieldName, cellValue, column) => {
                           
                        },
                        onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                            
                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(31, 1, 0, colIndex, field, newWidth)
                        },
                    });
                    if (billjsdata.length == 0) {
                        if (ClickType == 1)
                            showErrorSnackbar("No records found");
                    }
                    
                }, error: function (data) {
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        ////showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
        }
