    //~Preload Data
    function GetData(nMode, strID = null) {
        $.ajax({
            url: Aurl + "chequedeposit/get",
            type: 'get',
            contentType: 'json',
            data: {
                Mode: nMode, TransID: nDocprefix, ID: strID, ToDate: $("#dtpAsonDate").val(), ShowBounce: $("#chkShowBounceOnly").is(":checked") ? 1 : 0
            },
            xhrFields: {
                withCredentials: true
            },
            async :false,
            success: function (data) {
                if (nMode == 1) {
                    //cmbFilterAccountNo, txtFilterParty, cmbAccountNo, cmbDepositAccountNo, cmbDepSalesman
                    $('#cmbFilterAccountNo,#cmbAccountNo,#cmbDepositAccountNo,#cmbDepSalesman').find("option").remove();
                    $('#cmbFilterAccountNo,#cmbAccountNo,#cmbDepositAccountNo,#cmbDepSalesman').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrParty = [], arrBankAccountData = []; defbank = "", defIfsc = "", DefBankAcc = 0;
                    $.each(data, function (i, items) {
                        if (items.FType == 2) {
                            var ven = {
                                "label": items.Code + " | " + items.Name,
                                "name": items.Name,
                                "code": items.Code,
                                "id": items.ID,
                            }
                            arrParty.push(ven);
                            var ite = {
                                "label": items.Code,
                                "value":items.ID
                            }
                            //$('#cmbAccountNo').append($('<option/>', {
                            //    value: items.ID,
                            //    text: items.Name,
                            //}));
                        }
                        if (items.FType == 1) {
                            var BADetails = (items.Name).split('|');
                            var BAInfo = {
                                "ID": items.ID,
                                "AccNo": BADetails[0],
                                "Bank": BADetails[1],
                                "Branch": BADetails[2],
                                "IFSC": BADetails[3],
                                "MICR": BADetails[4],
                                "DefYN": BADetails[5],
                            }
                            if (BADetails[5] == "1") {
                                DefBankAcc = items.ID;
                                defbank = BADetails[1], defIfsc = BADetails[3];
                            }
                            arrBankAccountData.push(BAInfo);

                            $('#cmbFilterAccountNo,#cmbDepositAccountNo').append($('<option/>', {
                                value: items.ID,
                                text: BADetails[0],
                            }));
                        }
                        if (items.FType == 3) {
                            $('#cmbDepSalesman').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            //$('#cmbUDN').append($('<option/>', {
                            //    value: items.ID,
                            //    text: items.Name,
                            //}));
                        }
                        if (items.FType == 5) {
                            $("#lblDocID").text(items.Name);
                        }
                    });
                    SetAutlistforFields();
                    $("#cmbDepositAccountNo").val(DefBankAcc);
                    $('#txtDepBankName').val(defbank);
                    $('#txtDepIFSC').val(defIfsc);
                }
                else if (nMode == 2) {
                    $("#lblTotAmt").text("0.00");
                    DocumentData.draw().clear(); DocumentData.draw().clear();
                    if (data.length > 0) {
                        var Amount = 0;
                        var today = new Date();
                        $.each(data, function (i, items) {
                            //AccID,AccName,ChqorDDNo,ChqDate,BankName,BranchName,CollAmt,PayMode,Desc,Status,ColID,DepID,IFSCCode
                            Amount += parseFloat(items.CollAmt);
                            DocumentData.row.add([
                                items.AccID,
                                items.ColID,
                                items.DepID,
                                items.Status,
                                '<input type="checkbox" id="chkActive' + i + '"  name="Active" />',
                                (i + 1),
                                items.AccName,
                                items.ChqorDDNo,
                                items.ChqDate,
                                items.CollAmt,
                                items.BankName,
                                items.IFSCCode,
                                items.PayMode,
                                items.Desc,
                            ]).draw(false);
                        });
                        $("#lblTotAmt").text(parseFloat(Amount).toFixed(DecVal));
                        $("#lblChqCountValue").text("0.00 / 0");
                    }
                    else {
                        showErrorSnackbar("No records found");
                    }
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }

