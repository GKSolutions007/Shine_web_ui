<script type="text/javascript">
    //document.body.style.zoom = "85%";
    $("#txtDocID").prop("disabled", true);
    //dvDocuments,
    $("#dvMain").hide();
    var Table = $('#tblMasterData').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        "bFilter": true,
        "bSearchable": true,
        "bInfo": true,
        "bPaginate": true,
        "ordering": true,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0,1], "visible": false, searchable: false }, { "targets": [9], "class": "text-center" }],
    });    
    var today = new Date();
    today.setHours(0, 0, 0, 0); 
    var DocumentData = $('#tblDocumentData').DataTable({
        paging: false,
        searching: false,
        info: false,
        ordering: false,
        scrollY: "250px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0,1,2,3], "visible": false, searchable: false, filter: false, ordering: false },
            { "targets": [4], ordering: false },{ "targets": [4, 5], "class": "text-center" }, { "targets": [7], "class": "text-right" }, { "targets": [6], width: "20%" }],
        rowCallback: function (row, data, index) {
            var chqDate = new Date(data[8]);
            chqDate.setHours(0, 0, 0, 0);

            var diffDays = Math.floor((today - chqDate) / (1000 * 60 * 60 * 24));

            var color = '';

            if (diffDays === 0) {
                color = '#ffffff';
            } else if (diffDays >= 1 && diffDays <= 3) {
                color = '#ffcccc';
            } else if (diffDays > 3) {
                color = '#ff776d';
            }

            // ✅ Apply to both the row AND every td inside it
            if (color) {
                $(row).attr('style', 'background-color: ' + color + ' !important;');
                $('td', row).attr('style', 'background-color: ' + color + ' !important;');
            }
        }
    });
        var UID = '@Session["LoginUserID"]';
    var Aurl = '@Session["APIurl"]';
    var DefBranch = '@Session["DefaultBranch"]';
    var DecVal = '@Session["DecimalValues"]';
    var nTransMode = 1, nIsDraft = 0;
    setDate("dtpDate", 0);
    setDate("dtpFFrom", 0);
    setDate("dtpFTo", 0);
    setDate("dtpAsonDate", 0);

    setTimeout(function () { GetFilterData(); }, 800);
    if ($("#txtID").val() > 0 && $("#txtTransType").val() > 0) {
        $("#txtDraftID").val($("#txtID").val())
        var ID = $("#txtID").val();
        GetProductViewData(8, ID);
        nTransMode = 1;
        //$(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnClear").prop("disabled", true);
        $("#dvMain").show();
        $("#dvDocuments").hide();
        $("#MainHeading").text("Create Cheque Deposit");
    }


    var grid, ChequeDeposit;
    GetColumnSettingsData(2, 31, 1,true);
    //~Close
    $("#btnClose").click(function () {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        //dvDocuments,
        var rdo1 = $("#rdoMainTableData").is(":checked");
        $("#dvMain").hide();
        $("#dvDocuments").show();
        GetFilterData();
        $("#MainHeading").text("Cheque Deposit");
    }
    $('input[type=number]').focusin(function (e) {
        $(this).select();
    });
    $('input[type=number]').click(function (e) {
        $(this).select();
    });
    function Scrolltoid(id) {
        //window.scrollTo(id[0].offsetLeft, id[0].offsetTop);
        window.scrollTo({ left: 0, top: document.body.scrollHeight, behavior: "smooth" });
    }


    var nDocprefix = 20;
    var PrintTransID = 20, PrintConfigID = 0;
