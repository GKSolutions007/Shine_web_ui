    function CalulateSelectedCheques() {
        var Checkedrows = 0, Value = 0;
        $('#tblDocumentData tbody tr').each(function (i, items) {
            var rowdata = DocumentData.row($(this)).data();
            var CheqAmt = rowdata[9];
            var isChk = $(this).find("input[type=checkbox]").is(":checked");
            if (isChk) {
                Value += parseFloat(CheqAmt);
                Checkedrows++;
            }
        });
        //showSuccessSnackbar("Cheques : " + Checkedrows + " & Values : " + Value);
        $("#lblChqCountValue").text(parseFloat(Value).toFixed(DecVal) + " / " + Checkedrows);
    }    
