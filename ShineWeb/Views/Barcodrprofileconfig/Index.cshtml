@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/datatable/1.13.6/dataTables.bootstrap5.min.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/datatable/1.13.6/jquery.dataTables.min.js"></script>
<script src="~/datatable/1.13.6/dataTables.bootstrap5.min.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>

<style>
    :root {
        --bp-primary: #4f46e5;
        --bp-primary-dark: #4338ca;
        --bp-primary-light: #eef2ff;
        --bp-success: #16a34a;
        --bp-success-dark: #15803d;
        --bp-danger: #dc2626;
        --bp-danger-dark: #b91c1c;
        --bp-border: #e2e8f0;
        --bp-bg: #f8fafc;
        --bp-text: #1e293b;
        --bp-muted: #64748b;
        --bp-radius: 10px;
    }

    body {
        background-color: var(--bp-bg);
    }

    /* ---------- Page header ---------- */
    .bp-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 4px 10px 4px;
    }

    #MainHeading {
        font-size: 18px !important;
        font-weight: 700;
        color: var(--bp-text);
        letter-spacing: 0.2px;
    }

    .bp-header-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    hr {
        margin-top: 0;
        opacity: 0.6;
    }

    /* ---------- Buttons ---------- */
    .btn-modern {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 13.5px;
        font-weight: 600;
        letter-spacing: 0.2px;
        transition: transform 0.08s ease, box-shadow 0.15s ease, background-color 0.15s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,0.06);
        cursor: pointer;
    }

        .btn-modern:active {
            transform: translateY(1px);
        }

        .btn-modern:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.25);
        }

    .btn-add-style {
        background: linear-gradient(180deg, #6366f1, var(--bp-primary));
        color: #fff;
    }

        .btn-add-style:hover {
            background: var(--bp-primary-dark);
            color: #fff;
        }

    .btn-upload-style {
        background: #fff;
        color: var(--bp-primary);
        border: 1.5px solid var(--bp-primary);
    }

        .btn-upload-style:hover {
            background: var(--bp-primary-light);
            color: var(--bp-primary-dark);
        }

    .btn-clear-style {
        background: #fff;
        color: var(--bp-danger);
        border: 1.5px solid var(--bp-danger);
    }

        .btn-clear-style:hover {
            background: #fef2f2;
            color: var(--bp-danger-dark);
        }

    .btn-save-style {
        background: linear-gradient(180deg, #22c55e, var(--bp-success));
        color: #fff;
    }

        .btn-save-style:hover {
            background: var(--bp-success-dark);
            color: #fff;
        }

    .glyphicon {
        font-family: 'Glyphicons Halflings', sans-serif;
    }

    /* ---------- Card / table wrapper ---------- */
    .bp-card {
        background: #fff;
        border-radius: var(--bp-radius);
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);
        border: 1px solid var(--bp-border);
        padding: 14px;
        margin: 0 4px;
    }

    #tblBarcodeProfiles_wrapper {
        border-radius: 8px;
        overflow: hidden;
    }

        /* Keep the cloned header/body tables DataTables generates for
           scrollX/scrollY perfectly aligned - box-sizing and width must
           match exactly between the two, and nothing else should wrap
           this in a second scroll container. */
        #tblBarcodeProfiles_wrapper .dataTables_scrollHead,
        #tblBarcodeProfiles_wrapper .dataTables_scrollHeadInner,
        #tblBarcodeProfiles_wrapper .dataTables_scrollHeadInner table {
            width: 100% !important;
            box-sizing: border-box;
        }

            #tblBarcodeProfiles_wrapper .dataTables_scrollHead table,
            #tblBarcodeProfiles_wrapper .dataTables_scrollBody table {
                margin: 0 !important;
                table-layout: fixed;
            }

        #tblBarcodeProfiles_wrapper .dataTables_scrollBody {
            border-top: none !important;
        }

    .bp-table-footer {
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid var(--bp-border);
    }

    #tblBarcodeProfiles {
        border-collapse: separate !important;
        border-spacing: 0;
    }

        #tblBarcodeProfiles thead th {
            background: var(--bp-primary-light) !important;
            color: var(--bp-primary-dark) !important;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 11.5px !important;
            letter-spacing: 0.4px;
            border-bottom: 2px solid var(--bp-border) !important;
            /*padding: 10px 8px !important;*/
            white-space: nowrap;
        }

        #tblBarcodeProfiles tbody td {
            padding: 8px !important;
            vertical-align: middle;
            border-color: var(--bp-border) !important;
        }

        #tblBarcodeProfiles tbody tr:hover {
            background-color: #fafbff;
        }

        #tblBarcodeProfiles tfoot th {
            background: #fff !important;
            border-top: 1px solid var(--bp-border) !important;
        }

    .gdInput {
        width: 100%;
        height: 28px;
        border: 1px solid var(--bp-border);
        border-radius: 6px;
        padding: 0 8px;
        font-size: 13px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        background-color: #fff;
    }

        .gdInput:focus {
            outline: none;
            border-color: var(--bp-primary);
            box-shadow: 0 0 0 3px rgba(79,70,229,0.15);
        }

    select.gdInput {
        height: 28px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    .input-error {
        border: 1.5px solid var(--bp-danger) !important;
        background-color: #fff1f1 !important;
        box-shadow: 0 0 0 3px rgba(220,38,38,0.12) !important;
    }

    /* ---------- Remove row button ---------- */
    .btn-remove-row {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: 1.5px solid var(--bp-danger);
        background: #fff;
        color: var(--bp-danger);
        border-radius: 6px;
        font-size: 13px;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease, transform 0.08s ease;
    }

        .btn-remove-row:hover {
            background: var(--bp-danger);
            color: #fff;
        }

        .btn-remove-row:active {
            transform: translateY(1px);
        }

        .btn-remove-row:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(220,38,38,0.2);
        }

    /* ---------- Remove Confirm Modal ---------- */
    #removeConfirmModal .modal-content {
        border-radius: 14px;
        border: none;
        box-shadow: 0 20px 45px rgba(15,23,42,0.25);
        overflow: hidden;
    }

    #removeConfirmModal .modal-header {
        background: linear-gradient(135deg, var(--bp-danger), #ef4444);
        color: #fff;
        border-bottom: none;
        padding: 16px 20px;
    }

        #removeConfirmModal .modal-header .modal-title {
            font-weight: 700;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #removeConfirmModal .modal-header .btn-close {
            filter: invert(1) grayscale(1) brightness(2);
            opacity: 0.9;
        }

    #removeConfirmModal .modal-body {
        padding: 22px 20px;
        font-size: 14px;
        color: var(--bp-text);
    }

    #removeConfirmModal .modal-footer {
        border-top: 1px solid var(--bp-border);
        padding: 14px 20px;
    }

    @@media (max-width: 576px) {
        #removeConfirmModal .modal-footer .btn-modern {
            flex: 1 1 auto;
            justify-content: center;
        }
    }

    /* ---------- Upload Modal ---------- */
    #uploadPrnModal .modal-content {
        border-radius: 14px;
        border: none;
        box-shadow: 0 20px 45px rgba(15,23,42,0.25);
        overflow: hidden;
    }

    #uploadPrnModal .modal-header {
        background: linear-gradient(135deg, var(--bp-primary), #6366f1);
        color: #fff;
        border-bottom: none;
        padding: 16px 20px;
    }

        #uploadPrnModal .modal-header .modal-title {
            font-weight: 700;
            font-size: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #uploadPrnModal .modal-header .btn-close {
            filter: invert(1) grayscale(1) brightness(2);
            opacity: 0.9;
        }

    #uploadPrnModal .modal-body {
        padding: 20px;
    }

    .prn-dropzone {
        border: 2px dashed #c7d2fe;
        border-radius: 12px;
        background: #f8f9ff;
        padding: 28px 16px;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

        .prn-dropzone:hover,
        .prn-dropzone.dragover {
            background: var(--bp-primary-light);
            border-color: var(--bp-primary);
        }

        .prn-dropzone .prn-icon {
            font-size: 34px;
            color: var(--bp-primary);
            margin-bottom: 8px;
        }

        .prn-dropzone .prn-main-text {
            font-size: 14px;
            font-weight: 600;
            color: var(--bp-text);
        }

        .prn-dropzone .prn-sub-text {
            font-size: 12px;
            color: var(--bp-muted);
            margin-top: 2px;
        }

    #prnFileInput {
        display: none;
    }

    .prn-file-list {
        margin-top: 16px;
        max-height: 220px;
        overflow-y: auto;
    }

    .prn-file-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        background: #f8fafc;
        border: 1px solid var(--bp-border);
        border-radius: 8px;
        padding: 8px 12px;
        margin-bottom: 8px;
        font-size: 13px;
    }

        .prn-file-item .prn-file-info {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .prn-file-item .prn-file-name {
            font-weight: 600;
            color: var(--bp-text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 260px;
        }

        .prn-file-item .prn-file-size {
            color: var(--bp-muted);
            font-size: 11.5px;
            white-space: nowrap;
        }

        .prn-file-item .prn-remove-file {
            border: none;
            background: transparent;
            color: var(--bp-danger);
            font-weight: 700;
            font-size: 16px;
            line-height: 1;
            cursor: pointer;
            padding: 2px 6px;
            border-radius: 6px;
        }

            .prn-file-item .prn-remove-file:hover {
                background: #fee2e2;
            }

    .prn-upload-msg {
        font-size: 12.5px;
        margin-top: 10px;
        display: none;
    }

        .prn-upload-msg.text-danger {
            color: var(--bp-danger) !important;
        }

        .prn-upload-msg.text-success {
            color: var(--bp-success) !important;
        }

    .prn-progress-wrap {
        margin-top: 14px;
        display: none;
    }

    #uploadPrnModal .modal-footer {
        border-top: 1px solid var(--bp-border);
        padding: 14px 20px;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 576px) {
        .bp-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .bp-header-actions {
            width: 100%;
        }

        .btn-modern {
            flex: 1 1 auto;
            justify-content: center;
        }

        .bp-card {
            margin: 0;
            padding: 10px;
            border-radius: 0;
        }

        .bp-table-footer {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .bp-table-footer .btn-modern {
                width: 100%;
                margin: 0 !important;
            }

        .prn-file-item .prn-file-name {
            max-width: 140px;
        }
    }

    @@media (min-width: 577px) and (max-width: 991px) {
        .bp-card {
            margin: 0 2px;
        }
    }
</style>
<body>

    <div class="bp-header">
        <h4 class="mb-0" id="MainHeading">@ViewData["FormName"]</h4>
        <div class="bp-header-actions">
            <button id="btnAdd" class="btn btn-modern btn-add-style">
                <span class="glyphicon glyphicon-plus"></span>&#x2009;Add
            </button>
            <button id="btnUpload" type="button" class="btn btn-modern btn-filter-style" data-bs-toggle="modal" data-bs-target="#uploadPrnModal">
                <span class="glyphicon glyphicon-upload"></span>&#x2009;Upload PRN
            </button>
        </div>
    </div>
    <div class="toastBox"></div>
    <hr />

    <div class="bp-card">
        <table class="table table-bordered w-100" id="tblBarcodeProfiles">
            <thead>
                <tr>
                    <th class="text-center trclrforcolheader" style="font-size:12px;width:0%;">ID</th>
                    <th class="text-center trclrforcolheader" style="font-size:12px;width:40%;">Profile Name</th>
                    <th class="text-center trclrforcolheader" style="font-size:12px;width:20%;">PRN File</th>
                    <th class="text-center trclrforcolheader" style="font-size:12px;width:10%;">Height</th>
                    <th class="text-center trclrforcolheader" style="font-size:12px;width:10%;">Width</th>
                    <th class="text-center trclrforcolheader" style="font-size:12px;width:10%;">No.of Rows</th>
                    <th class="text-center trclrforcolheader" style="font-size:12px;width:10%;">Remove</th>
                </tr>
            </thead>

            <tbody>
            </tbody>
        </table>
        <div class="bp-table-footer text-end">
            <button type="button" class="btn btn-modern btn-clear-style me-2" id="btnClear">
                <span class="glyphicon glyphicon-refresh"></span>&#x2009;Clear
            </button>

            <button type="button" class="btn btn-modern btn-save-style" id="btnSave">
                <span class="glyphicon glyphicon-saved"></span>&#x2009;Save
            </button>
        </div>
    </div>

    <!-- ============ Upload PRN Modal ============ -->
    <div class="modal fade" id="uploadPrnModal" tabindex="-1" aria-labelledby="uploadPrnModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="uploadPrnModalLabel">
                        <span class="glyphicon glyphicon-upload"></span> Upload PRN Files
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="prn-dropzone" id="prnDropzone">
                        <div class="prn-icon"><span class="glyphicon glyphicon-cloud-upload"></span></div>
                        <div class="prn-main-text">Drag &amp; drop PRN files here</div>
                        <div class="prn-sub-text">or click to browse &mdash; only .prn files, single or multiple</div>
                        <input type="file" id="prnFileInput" accept=".prn" multiple />
                    </div>

                    <div class="prn-file-list" id="prnFileList"></div>

                    <div class="prn-progress-wrap" id="prnProgressWrap">
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar" id="prnProgressBar" role="progressbar" style="width:0%;"></div>
                        </div>
                    </div>

                    <div class="prn-upload-msg" id="prnUploadMsg"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-modern btn-clear-style" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-modern btn-save-style" id="btnPrnUpload">
                        <span class="glyphicon glyphicon-upload"></span>&#x2009;Upload
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- ============ Remove Profile Confirm Modal ============ -->
    <div class="modal fade" id="removeConfirmModal" tabindex="-1" aria-labelledby="removeConfirmModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="removeConfirmModalLabel">
                        <span class="glyphicon glyphicon-trash"></span> Confirm Remove
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <span id="removeConfirmMsg">Do you want remove this profile?</span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-modern btn-clear-style" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-modern btn-save-style" id="btnConfirmRemoveOk">
                        <span class="glyphicon glyphicon-ok"></span>&#x2009;OK
                    </button>
                </div>
            </div>
        </div>
    </div>

    @*<button  id="btnBarPrint" class="btn btn-info">Print</button>*@
</body>
<script>
    var Aurl = '@Session["APIurl"]';
      var UID = '@Session["LoginUserID"]';
    var Table = $('#tblBarcodeProfiles').DataTable({
        lengthMenu: [[-1,10, 20, 50, 100], ["All",10, 20, 50, 100]],
        "bFilter": false,
        "bSearchable": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        "autoWidth": false,
        "columnDefs": [{ "targets": [0], "visible": false, searchable: false },
            { "targets": [1], "width": "40%" }, { "targets": [2], "width": "20%" },{ "targets": [3, 4, 5], "width": "10%" },
            { "targets": [6], "width": "10%", "className": "text-center", "orderable": false, "searchable": false }],
        "drawCallback": function () {
            // Keeps the cloned scroll-head table's column widths in sync
            // with the scroll-body table after every redraw (row add/remove).
            this.api().columns.adjust();
        }
    });
    // Re-sync header/body column widths whenever the viewport size changes.
    var bpColAdjustTimer;
    $(window).on('resize', function () {
        clearTimeout(bpColAdjustTimer);
        bpColAdjustTimer = setTimeout(function () {
            Table.columns.adjust();
        }, 150);
    });
    var arrProfiles = [], arrFilenames = [], prns = "",rowid = 0;
    $("#btnAdd").click(function () {
        Table.row.add([
            0,
            '<input name = "ProfileName" class="gdInput clsProfileName" id="txtProfileName' + rowid +'" value="" title="Profile Name"/>',
            '<select name = "FileName" class="gdInput" id="txtFileName' + rowid +'">' + prns +'</select>',
            '<input min="0" type="number" step="any" name ="Width" id="txtWidth' + rowid +'" class="gdInput" value="0" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)"/><br>' ,
            '<input min="0" type="number" step="any" name ="Height" id="txtHeight' + rowid +'" class="gdInput" value="0" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)"/>',//
            '<input min="0" type="number" step="any" name ="NoofRows" id="txtNoofRows' + rowid +'" class="gdInput" value="0"/>',//,
            '<button type="button" class="btn-remove-row" title="Remove"><span class="glyphicon glyphicon-trash"></span></button>',
        ]).draw(false);
        rowid++;
        const newInputs = document.querySelectorAll('#tblBarcodeProfiles tbody tr:last-child input');
        if (newInputs[0]) newInputs[0].focus();
    });
    InitialDatas();
    function InitialDatas() {
        arrProfiles = [], arrFilenames = [], prns = "", rowid = 0;
        $.ajax({
            url: Aurl + "barcodeprofiles/initialDatas",
            type: 'GET',
            contentType: 'JSON',
            data: {},
            async: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                console.log(data)
                Table.draw().clear();
                arrProfiles = data[0].BarcodeProfiles;
                arrFilenames = data[0].FileNames;
                arrProfileNames = data[0].ConfigNames;
                arrFontNames = data[0].FontNames;
                $.each(arrFilenames, function (i, items) {
                    prns += '<option value="' + items.FileName + '">' + items.FileName + '</option>'
                });
                $.each(arrProfiles, function (i, items) {
                    Table.row.add([
                        items.ID,
                        '<input name = "ProfileName" class="gdInput clsProfileName" id="txtProfileName' + rowid + '" value="' + items.ProfileName +'" title="Profile Name"/>',
                        '<select name = "FileName" class="gdInput" id="txtFileName' + rowid + '">' + prns + '</select>',
                        '<input min="0" type="number" step="any" name ="Width" id="txtWidth' + rowid + '" class="gdInput" value="' + items.Width +'" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)"/><br>',
                        '<input min="0" type="number" step="any" name ="Height" id="txtHeight' + rowid + '" class="gdInput" value="' + items.Height +'" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)"/>',
                        '<input min="0" maxlength="2" type="number" step="any" name ="NoofRows" id="txtNoofRows' + rowid + '" class="gdInput" value="' + items.NoofRows +'"/>',
                        '<button type="button" class="btn-remove-row" title="Remove"><span class="glyphicon glyphicon-trash"></span></button>',
                    ]).draw(false);
                    $("#txtFileName" + rowid).val(items.FileName);
                    rowid++;
                });

            }
        });
    }
    $('#tblBarcodeProfiles').on('input', 'input[name="NoofRows"]', function () {
        // Remove anything after a decimal
        this.value = this.value.replace(/[^0-9]/g, '').slice(0, 2);
    });
    $('#tblBarcodeProfiles').on('input', '.clsProfileName', function () {
        const currentVal = $(this).val().trim().toLowerCase();
        let duplicate = false;

        // Loop through all other profile name inputs
        $('.clsProfileName').not(this).each(function () {
            if ($(this).val().trim().toLowerCase() === currentVal && currentVal !== '') {
                duplicate = true;
                return false; // stop loop
            }
        });

        // Show validation feedback
        if (duplicate) {
            $(this).addClass('input-error'); // optional: red border
            $(this).attr('title', 'Duplicate Profile Name not allowed');
            showErrorSnackbar("Profile Name already given");
        } else {
            $(this).removeClass('input-error');
            $(this).attr('title', 'Profile Name');
        }
    });
    // ---------- Remove row logic ----------
    var removeConfirmModalEl = document.getElementById('removeConfirmModal');
    var removeConfirmModal = new bootstrap.Modal(removeConfirmModalEl);
    var pendingRemoveRow = null;
    var pendingRemoveId = null;
    var $btnConfirmRemoveOk = $('#btnConfirmRemoveOk');

    $('#tblBarcodeProfiles').on('click', '.btn-remove-row', function () {
        var $row = $(this).closest('tr');
        var rowData = Table.row($row).data();
        var id = rowData ? rowData[0] : 0;

        if (!id || parseInt(id, 10) === 0) {
            // Unsaved row - just remove it from the grid, no API call needed
            Table.row($row).remove().draw(false);
        } else {
            pendingRemoveRow = $row;
            pendingRemoveId = id;
            $('#removeConfirmMsg').text('Do you want remove this profile?');
            removeConfirmModal.show();
        }
    });

    $btnConfirmRemoveOk.on('click', function () {
        if (!pendingRemoveRow || !pendingRemoveId) {
            removeConfirmModal.hide();
            return;
        }

        $btnConfirmRemoveOk.prop('disabled', true);

        $.ajax({
            url: Aurl + 'barcodeprofiles/remove',
            type: 'get',
            contentType: 'application/json',
            data: { ProfileID: pendingRemoveId },
            async: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (response) {
                $btnConfirmRemoveOk.prop('disabled', false);
                removeConfirmModal.hide();
                Table.row(pendingRemoveRow).remove().draw(false);
                if (typeof showSuccessSnackbar === 'function') {
                    showSuccessSnackbar('Profile removed successfully.');
                }
                pendingRemoveRow = null;
                pendingRemoveId = null;
            },
            error: function (xhr) {
                $btnConfirmRemoveOk.prop('disabled', false);
                removeConfirmModal.hide();
                var errMsg = 'Remove failed. Please try again.';
                if (xhr && xhr.responseJSON && xhr.responseJSON.Message) {
                    errMsg = xhr.responseJSON.Message;
                }
                if (typeof showErrorSnackbar === 'function') {
                    showErrorSnackbar(errMsg);
                } else {
                    alert(errMsg);
                }
            }
        });
    });

    // Reset pending state if the modal is dismissed via Cancel/close/backdrop-esc
    $(removeConfirmModalEl).on('hidden.bs.modal', function () {
        pendingRemoveRow = null;
        pendingRemoveId = null;
    });

    $('#btnClear').on('click', function () {
        if (ClearcfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        InitialDatas();
    }
    $('#btnSave').on('click', function () {
        $(".clrdiv").html("");
        if (cfFocus != 3) {
            ConfirmDialogMsg("Do you want to save data?");
        } else {
            SaveData();
        }
    });
    function SaveData(){
        let valid = true;
        let profileNames = [];
        let ProfileDetails = [];
        // Clear any previous validation styling
        $('.gdInput').removeClass('input-error');
        $("#btnSave").prop("disabled", true);
        // Loop through each row in the DataTable
        $('#tblBarcodeProfiles tbody tr').each(function () {
            rowdata = Table.row($(this)).data();
            const id = rowdata[0];// $(this).find('td:first').text().trim(); // Assuming first column is ID
            const profileName = $(this).find('input[name="ProfileName"]').val()?.trim();
            const fileName = $(this).find('select[name="FileName"]').val();
            const width = $(this).find('input[name="Width"]').val();
            const height = $(this).find('input[name="Height"]').val();
            const noOfRows = $(this).find('input[name="NoofRows"]').val();

            // Profile Name validation
            if (!profileName) {
                $(this).find('input[name="ProfileName"]').addClass('input-error').attr('title', 'Profile Name cannot be empty');
                valid = false;
            } else if (profileNames.includes(profileName.toLowerCase())) {
                $(this).find('input[name="ProfileName"]').addClass('input-error').attr('title', 'Duplicate Profile Name not allowed');
                valid = false;
            } else {
                profileNames.push(profileName.toLowerCase());
            }

            // File Name validation
            if (!fileName || fileName === '0') {
                $(this).find('select[name="FileName"]').addClass('input-error').attr('title', 'Select a File Name');
                valid = false;
            }

            // Width validation (must be positive)
            if (!width || isNaN(width) || parseFloat(width) <= 0) {
                $(this).find('input[name="Width"]').addClass('input-error').attr('title', 'Enter valid Width');
                valid = false;
            }

            // Height validation (must be positive)
            if (!height || isNaN(height) || parseFloat(height) <= 0) {
                $(this).find('input[name="Height"]').addClass('input-error').attr('title', 'Enter valid Height');
                valid = false;
            }

            // No of Rows validation (must be integer 1–99)
            if (!noOfRows || isNaN(noOfRows) || !/^\d+$/.test(noOfRows) || parseInt(noOfRows) <= 0 || parseInt(noOfRows) > 99) {
                $(this).find('input[name="NoofRows"]').addClass('input-error').attr('title', 'Enter valid No. of Rows (1–99)');
                valid = false;
            }
            if (valid) {
                ProfileDetails.push({
                    ID: id || 0,
                    ProfileName: profileName,
                    FileName: fileName,
                    Width: parseFloat(width),
                    Height: parseFloat(height),
                    NoofRows: parseInt(noOfRows),
                    UID: UID
                });
            }
        });

        if (!valid) {
            $("#btnSave").prop("disabled", false);
            showErrorSnackbar('Please correct highlighted fields before saving.');
            // Focus first invalid field for better UX
            $('.input-error').first().focus();
            return false;
        }
        if (valid) {
            $.ajax({
                url: Aurl + "barcodeprofiles/saveprofiles",
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(ProfileDetails),
                async: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (response) {
                    $("#btnSave").prop("disabled", false);
                    $.each(response, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            InitialDatas();
                        }
                        else {
                            showErrorSnackbar(items.Message);
                        }
                    });
                },
                error: function (xhr) {
                    $("#btnSave").prop("disabled", false);
                    //console.error('❌ Save failed:', xhr.responseText);
                }
            });
        }
    }
</script>

<!-- ============ Upload PRN Modal script ============ -->
<script>
    (function () {
        var selectedPrnFiles = []; // holds File objects currently staged for upload
        var $dropzone = $('#prnDropzone');
        var $fileInput = $('#prnFileInput');
        var $fileList = $('#prnFileList');
        var $uploadMsg = $('#prnUploadMsg');
        var $progressWrap = $('#prnProgressWrap');
        var $progressBar = $('#prnProgressBar');
        var $btnPrnUpload = $('#btnPrnUpload');
        var modal = new bootstrap.Modal(document.getElementById('uploadPrnModal'));
        function formatBytes(bytes) {
            if (bytes === 0) return '0 B';
            var k = 1024, sizes = ['B', 'KB', 'MB', 'GB'];
            var i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }

        function isPrnFile(file) {
            return /\.prn$/i.test(file.name);
        }

        function renderFileList() {
            $fileList.empty();
            if (!selectedPrnFiles.length) {
                return;
            }
            $.each(selectedPrnFiles, function (idx, file) {
                var $item = $(
                    '<div class="prn-file-item" data-idx="' + idx + '">' +
                    '<div class="prn-file-info">' +
                    '<span class="glyphicon glyphicon-file" style="color:var(--bp-primary);"></span>' +
                    '<span class="prn-file-name" title="' + file.name + '">' + file.name + '</span>' +
                    '<span class="prn-file-size">(' + formatBytes(file.size) + ')</span>' +
                    '</div>' +
                    '<button type="button" class="prn-remove-file" data-idx="' + idx + '" title="Remove">&times;</button>' +
                    '</div>'
                );
                $fileList.append($item);
            });
        }

        function hideMsg() {
            $uploadMsg.hide().removeClass('text-danger text-success').text('');
        }

        function showMsg(text, type) {
            $uploadMsg.text(text).removeClass('text-danger text-success').addClass(type).show();
        }

        function addFiles(fileArray) {
            var rejected = [];
            $.each(fileArray, function (i, file) {
                if (isPrnFile(file)) {
                    // Avoid exact duplicate name+size entries
                    var dup = selectedPrnFiles.some(function (f) { return f.name === file.name && f.size === file.size; });
                    if (!dup) {
                        selectedPrnFiles.push(file);
                    }
                } else {
                    rejected.push(file.name);
                }
            });
            renderFileList();
            if (rejected.length) {
                showMsg('Only .prn files are allowed. Ignored: ' + rejected.join(', '), 'text-danger');
            } else {
                hideMsg();
            }
        }

        // Click dropzone -> open file browser
        // Guard against the hidden input's own click bubbling back up to this
        // handler (it is a descendant of the dropzone), which would call
        // click() a second time and cause the browser to swallow the dialog.
        $dropzone.on('click', function (e) {
            if (e.target === $fileInput.get(0)) {
                return;
            }
            $fileInput.get(0).click();
        });

        // File picked via browse
        $fileInput.on('change', function (e) {
            addFiles(Array.from(e.target.files || []));
            $fileInput.val(''); // allow re-selecting the same file later
        });

        // Drag & drop handlers
        $dropzone.on('dragover', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropzone.addClass('dragover');
        });
        $dropzone.on('dragleave', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropzone.removeClass('dragover');
        });
        $dropzone.on('drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropzone.removeClass('dragover');
            var dt = e.originalEvent.dataTransfer;
            if (dt && dt.files && dt.files.length) {
                addFiles(Array.from(dt.files));
            }
        });

        // Remove a staged file
        $fileList.on('click', '.prn-remove-file', function () {
            var idx = parseInt($(this).data('idx'), 10);
            selectedPrnFiles.splice(idx, 1);
            renderFileList();
        });

        var prnUploadSucceeded = false;

        // Reset modal state whenever it is opened/closed
        $('#uploadPrnModal').on('hidden.bs.modal', function () {
            selectedPrnFiles = [];
            renderFileList();
            hideMsg();
            $progressWrap.hide();
            $progressBar.css('width', '0%');
            $btnPrnUpload.prop('disabled', false);

            // Refresh the grid's PRN filename list only after the modal has
            // fully closed. InitialDatas() runs a *synchronous* ajax call,
            // which would otherwise block the browser thread mid fade-out
            // and cause Bootstrap to miss the transition end, leaving a
            // stray .modal-backdrop behind.
            if (prnUploadSucceeded) {
                prnUploadSucceeded = false;
                if (typeof InitialDatas === 'function') {
                    InitialDatas();
                }
            }

            // Safety net: in case any backdrop is ever left orphaned
            // (e.g. modal closed/dismissed mid another transition), clean
            // it up once nothing else is open.
            if (!$('.modal.show').length) {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css('padding-right', '');
            }
        });

        // Upload button inside modal
        $btnPrnUpload.on('click', function () {
            hideMsg();

            if (!selectedPrnFiles.length) {
                showMsg('Please select at least one .prn file to upload.', 'text-danger');
                return;
            }

            var formData = new FormData();
            $.each(selectedPrnFiles, function (i, file) {
                formData.append('files', file, file.name);
            });
            if (typeof UID !== 'undefined') {
                formData.append('UID', UID);
            }

            $btnPrnUpload.prop('disabled', true);
            $progressWrap.show();
            $progressBar.css('width', '0%');

            $.ajax({
                url: Aurl + '/barcode/uploadfile',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                xhrFields: {
                    withCredentials: true
                },
                xhr: function () {
                    var xhr = $.ajaxSettings.xhr();
                    if (xhr.upload) {
                        xhr.upload.addEventListener('progress', function (evt) {
                            if (evt.lengthComputable) {
                                var pct = Math.round((evt.loaded / evt.total) * 100);
                                $progressBar.css('width', pct + '%');
                            }
                        }, false);
                    }
                    return xhr;
                },
                success: function (response) {
                    $btnPrnUpload.prop('disabled', false);
                    $progressWrap.hide();
                    showMsg('File(s) uploaded successfully.', 'text-success');
                    if (typeof showSuccessSnackbar === 'function') {
                        showSuccessSnackbar('PRN file(s) uploaded successfully.');
                    }
                    selectedPrnFiles = [];
                    renderFileList();
                    prnUploadSucceeded = true;
                    setTimeout(function () {
                        //$('#uploadPrnModal').modal('hide');
                        modal.hide();
                    }, 700);
                },
                error: function (xhr) {
                    $btnPrnUpload.prop('disabled', false);
                    $progressWrap.hide();
                    var errMsg = 'Upload failed. Please try again.';
                    if (xhr && xhr.responseJSON && xhr.responseJSON.Message) {
                        errMsg = xhr.responseJSON.Message;
                    }
                    showMsg(errMsg, 'text-danger');
                    if (typeof showErrorSnackbar === 'function') {
                        showErrorSnackbar(errMsg);
                    }
                }
            });
        });
    })();
</script>

