@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
@*<link href="~/Content/bootstrap.min.css" rel="stylesheet" />*@
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/Snackbar.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
@*<script src="~/Scripts/bootstrap.min.js"></script>*@
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<style>
    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }
    .subText {
        font-size: 10px;
        color: #555;
        min-height: 14px;
    }
    each {
        border-bottom: 1px solid #555;
        padding: 3px 0;
    }

    .sm-filter-row .form-check-input {
        width: 1.25rem;
        height: 1.25rem;
        cursor: pointer;
    }

    .sm-filter-row .form-check-label {
        font-size: 0.9rem;
        cursor: pointer;
    }

    .acItem .name {
        font-size: 14px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .acItem .desc {
        font-size: 10px;
        font-family: Arial, Helvetica, sans-serif;
        color: #555;
    }

    .ui-autocomplete {
        max-height: 245px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .btn-add-style {
        background: #16a34a;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 1px 6px;
        line-height: 1.2;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 10; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        /*overflow: auto;*/ /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 35%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            /* overflow: auto;*/
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            /*overflow: auto;*/
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .branch-container {
        text-align: left; /* align container to the left */
    }

        .branch-container .form-label {
            display: inline-block; /* keep it inline, not centered */
            width: 220px; /* reduce width of dropdown */
            margin: 0; /* remove auto margin */
        }


    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -40%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.8em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    table.dataTable > tbody > tr > th, table.dataTable > tbody > tr > td {
        padding: 3px 3px;
    }

    /* ===== Accounts module consistency (header card + buttons) ===== */
    .sm-header-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 4px 10px rgba(30,41,59,0.10);
        padding: 12px 18px;
        margin: 4px 0 14px 0;
        position: relative;
        overflow: hidden;
    }

        .sm-header-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: var(--header-bg, #2563eb);
        }

    .sm-header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 10px;
        background: #eff6ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .sm-header-text #MainHeading {
        font-size: 18px;
        font-weight: 800;
        color: #0f172a;
        margin: 0;
        padding: 0;
    }

    .sm-header-sub {
        font-size: 12px;
        color: #64748b;
        margin-top: 2px;
    }

    .btn-clear-style,
    .btn-save-style,
    .btn-close-style,
    .btn-filter-style {
        border-radius: 9px !important;
        font-weight: 600;
        padding: 7px 18px;
        border: none;
        transition: transform .12s ease, box-shadow .12s ease;
    }

    .btn-clear-style {
        background: #e2e8f0;
        color: #475569;
    }

        .btn-clear-style:hover {
            background: #cbd5e1;
            color: #334155;
        }

    .btn-save-style {
        background: #16a34a;
        color: #ffffff;
    }

        .btn-save-style:hover {
            background: #15803d;
            color: #fff;
            box-shadow: 0 4px 12px rgba(22,163,74,0.30);
        }

    .btn-close-style {
        background: #64748b;
        color: #ffffff;
    }

        .btn-close-style:hover {
            background: #475569;
            color: #fff;
        }
</style>
<body>
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })
    <div class="toastBox"></div>
    <div class="sm-inline-bar">
        <div class="sm-header-card sm-header-inline">
            <div class="sm-header-icon"><i class="fas fa-clipboard-list"></i></div>
            <div class="sm-header-text">
                <div class="sm-header-sub">Purchase</div>
                <h4 id="MainHeading">@ViewData["FormName"]</h4>
            </div>
        </div>
        <div class="row mb-3 g-2 justify-content-end align-items-center sm-filter-row">
            <!-- Show All -->
            <div class="col-auto">
                <div class="form-check m-0 d-flex align-items-center gap-2">
                    <input class="form-check-input m-0" type="checkbox" id="chkAllowDate">
                    <label class="form-check-label" for="chkAllowDate">Show All</label>
                </div>
                <div id="divErrBranch" class="clrdiv" style="color:red"></div>
            </div>

            <!-- Date -->
            <div class="col-auto">
                <span class="form-label sm-pill">
                    <input class="clsdtpfieldfull FormclrField" type="date" id="dtpDate"
                           oninput="if (this.value > this.max) { this.value = this.max; }" />
                    <label class="labelup" for="dtpDate">Date</label>
                </span>
                <div style="color:red; padding-top:5px; padding-left:5px;" id="divErrDate" class="clrdiv"></div>
            </div>
        </div>
    </div>

    <div id="dvMainTable">
        <div class="row">
            <div class="col-12">

                <input type="text" class="gdInput" name="CustomeFilter" id="txtCustomFilter" hidden />

                <table class="table table-bordered" id="tblMasterFAData" style="width:100%">
                    <thead>
                        <tr class="trclrforcolheader">
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:0%;">ID</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:2%;">
                                <button type="button" class="btn-add-style" id="btnNewRow" title="Add Row">
                                    <span class="glyphicon glyphicon-plus-sign"></span>
                                </button>
                            </th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:16%;">Product Name</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:4%;">Qty</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:4%;">UOM</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:4%;">Price</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:16%;">Customer Name</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:8%;">Mobile No</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:6%;">Status</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:14%;">Expected Date</th>
                        </tr>
                    </thead>

                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-start">
                                <button type="button" class="btn btn-clear-style" id="btnClear">
                                    <span class="glyphicon glyphicon-refresh"></span> Clear
                                </button>
                                <button type="button" class="btn btn-save-style" id="btnSave">
                                    <span class="glyphicon glyphicon-saved"></span> Save
                                </button>
                            </td>
                            <td colspan="2"></td>
                            <td class="text-end"><span id="lblTotal">0.00</span></td>
                            <td colspan="4"></td>
                        </tr>
                    </tfoot>

                </table>
            </div>
        </div>
    </div>
</body>
<script>
    var Aurl = '@Session["APIurl"]';
    var UID = '@Session["LoginUserID"]';
    var itemorderby = '@Session["ItemOrderby"]';
    var autolistfilterwith = '@Session["ALSearchstartwith"]' == "1";
    var startwithfield = itemorderby == "1" ? "code" : itemorderby == "2" ? "name" : "search";

    var Table;
    var arrProduct = [], arrCustomer = [], strUOM = '<option value="0">-- UOM --</option>';
    var acInst = [];
    var arrUOM = {};
    $(document).ready(function () {
        setDate("dtpDate", 0);
        GetData(1);
    });

    function GetData(nMode) {
        $.ajax({
            url: Aurl + "customerstockrequest/get",
            type: 'get',
            data: { Mode: nMode },
            xhrFields: { withCredentials: true },
            success: function (data) {
                var ds = (typeof data === "string") ? JSON.parse(data) : data;
                console.log("Customer keys:", Object.keys((ds.Table || [])[0] || {}));

                arrCustomer = (ds.Table || []).map(function (c) {
                    return {
                        label: (c.Code || '') + ' | ' + c.Name, name: c.Name, code: c.Code || '',
                        search: (c.Code || '') + ' ' + c.Name, id: c.ID,
                        mobile: c.Mob1 || c.Mobile || c.MobileNo || ''
                    };
                });

                arrUOM = {};
                strUOM = '<option value="0">-- UOM --</option>';
                $.each(ds.Table2 || [], function (i, u) {
                    arrUOM[u.ID] = u.Name;
                    strUOM += '<option value="' + u.ID + '">' + u.Name + '</option>';
                });

                arrProduct = (ds.Table1 || []).map(function (p) {
                    var ids = [p.BaseUomID, p.PurchaseUomID, p.SalesUomID];
                    var uniq = ids.filter(function (x, idx) {
                        return x && arrUOM[x] && ids.indexOf(x) === idx;
                    });
                    return {
                        label: p.ProductCode + ' | ' + p.ProductName, name: p.ProductName, code: p.ProductCode,
                        search: p.ProductCode + ' ' + p.ProductName, id: p.ProductID,
                        price: p.Price || 0,
                        uoms: uniq
                    };
                });

                initGrid();
            },
            error: function (xhr) { console.log("API error:", xhr.status, xhr.responseText); }
        });
    }

    function initGrid() {
        var top = $('#dvMainTable').offset().top + 120;
        Table = $('#tblMasterFAData').DataTable({
            destroy: true,
            data: [],
            paging: false, info: false, ordering: false, searching: false,
            scrollY: (window.innerHeight - top) + "px",
            scrollX: true, scrollCollapse: true,
            columns: [
                { data: null, visible: false, defaultContent: "" },
                { data: null, className: "dt-body-center",
                  render: function (d, t, r, meta) { return meta.row + 1; } },
                {
                    data: null, render: function (d, t, r, meta) {
                        return '<input type="text" class="gdInput clsPName" autocomplete="off" id="txtPName' + meta.row + '" />' +
                            '<div class="subText" id="lblPCode' + meta.row + '"></div>';
                    }
                },
                {
                    data: null, className: "dt-body-right", render: function (d, t, r, meta)
                    {
                        return '<input type="number" class="gdInput" id="txtQty' + meta.row + '" />';
                    }
                },
                {
                    data: null, render: function (d, t, r, meta)
                    {
                        return '<select class="gdInput" id="cmbUOM' + meta.row + '">' + strUOM + '</select>';
                    }
                },
                {
                    data: null, className: "dt-body-right", render: function (d, t, r, meta)
                    {
                    return '<input type="number" class="gdInput" id="txtPrice' + meta.row + '" />';
                }
                },
                {
                    data: null, render: function (d, t, r, meta) {
                        return '<input type="text" class="gdInput clsCName" autocomplete="off" id="txtCName' + meta.row + '" />' +
                            '<div class="subText" id="lblCCode' + meta.row + '"></div>';
                    }
                },
                {
                    data: null, render: function (d, t, r, meta) {
                        return '<input type="text" class="gdInput" id="txtMobile' + meta.row + '" readonly />';
                    }
                },
                {
                    data: null, render: function (d, t, r, meta) {
                        return '<select class="gdInput" id="cmbStatus' + meta.row + '">' +
                            '<option value="Open" selected>Open</option>' +
                            '<option value="Completed">Completed</option>' +
                            '</select>';
                    }
                },
                { data: null, render: function (d, t, r, meta) {
                    return '<input type="date" class="gdInput" id="dtpExp' + meta.row + '" />'; } }
            ]
        });
        addBlankRow();
    }
    function addBlankRow() {
        var r = Table.row.add({});
        r.draw(false);
        bindRowAutolists(r.index());
    }

    function bindRowAutolists(i) {
        acInst.push(PaginatedAutocomplete({
            inputId: "txtPName" + i,
            data: arrProduct,
            startwitfieldname: startwithfield,
            enablefilterstartwith: autolistfilterwith,
            onSelect: function (item) {
                $("#txtPName" + i).val(item.name);
                $("#lblPCode" + i).text(item.code);
                $("#txtPrice" + i).val(item.price);

                var opts = '';
                item.uoms.forEach(function (id) {
                    opts += '<option value="' + id + '">' + arrUOM[id] + '</option>';
                });
                $("#cmbUOM" + i).html(opts || strUOM);

                $("#txtPName" + i).closest('tr').attr('data-pid', item.id);
                ensureBlankRow();
                $("#txtQty" + i).focus();
                return false;
            }
        }));
        acInst.push(PaginatedAutocomplete({
            inputId: "txtCName" + i,
            data: arrCustomer,
            startwitfieldname: startwithfield,
            enablefilterstartwith: autolistfilterwith,
            onSelect: function (item) {
                $("#txtCName" + i).val(item.name);
                $("#txtMobile" + i).val(item.mobile);
                $("#txtCName" + i).closest('tr').attr('data-cid', item.id);
                $("#lblCCode" + i).text(item.code);
                return false;
            }
        }));
    }
    $('#tblMasterFAData').on('input', '.clsPName', function () {
        $(this).closest('tr').removeAttr('data-pid');
        $(this).siblings('.subText').text('');
    });
    $('#tblMasterFAData').on('input', '.clsCName', function () {
        $(this).closest('tr').removeAttr('data-cid');
        $(this).siblings('.subText').text('');
    });

    function ensureBlankRow() {
        var $last = $(Table.rows().nodes()).last();
        if ($last.attr('data-pid')) { addBlankRow(); }
    }

    function resetGrid() {
        acInst.forEach(function (a) { if (a && a.destroy) a.destroy(); });
        acInst = [];
        Table.clear().draw();
        addBlankRow();
        $(".clrdiv").html("");
        $("#lblTotal").text("0.00");
        setDate("dtpDate", 0);
    }
    $('#btnClear').click(function () { resetGrid(); });
    $(document).on('click', '#btnNewRow', function () {
        addBlankRow();
    });

    var Url = '@Session["url"].ToString()';
    function openProductMaster(nProd) {
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        const hasPermission = nProd == 0
            ? checkAddEditPermission("111")
            : checkAddEditPermission("112");
        if (hasPermission) {
            var ProdUrl = Url + "ProductMaster?name=dFLU9MS0CpfVS5wW5G17EQ%3D%3D&strFormID=RjZMX%2BX6NiPSRFI2WDoZJA%3D%3D&TypeID=BOII5FUynjpl5RZJJ8nW1g==&TranID=jJOtHsRVwYECOhoiBc69dA%3D%3D&ID=" + nProd;
            window.open(ProdUrl, "_blank", "width=" + vw + ",height=" + vh + ",scrollbars=yes,resizable=yes");
        }
        else {
            showErrorSnackbar("You don't have pemission for &ensp;<h4><code>" + (nProd == 0 ? "Add" : "Edit") + " Product</code></h4>");
        }
    }

    function openCustomerMaster(nPartyID) {
        var vw = window.innerWidth;
        var vh = window.innerHeight;
        const hasPermission = nPartyID == 0
            ? checkAddEditPermission("103")
            : checkAddEditPermission("104");
        if (hasPermission) {
            var CustUrl = Url + "CustomerMaster?name=rr5Wddu2buz5UA%2BG9dT9Ucj%2FeOlQpQPpxXStNyfzZdQ%3D&strFormID=9PmmH5xzgb%2BC08uj8hAzfA%3D%3D&TypeID=BOII5FUynjpl5RZJJ8nW1g==&TranID=jJOtHsRVwYECOhoiBc69dA%3D%3D&ID=" + nPartyID;
            window.open(CustUrl, "_blank", "width=" + vw + ",height=" + vh + ",scrollbars=yes,resizable=yes");
        }
        else {
            showErrorSnackbar("You don't have pemission for &ensp;<h4><code> " + (nPartyID == 0 ? "Add" : "Edit") + " Customer </code></h4>");
        }
    }

    document.addEventListener("keydown", function (event) {

        if (event.key == "F8") {
            event.preventDefault();
            if ($(event.target).hasClass('clsPName')) {
                var nProd = $(event.target).closest('tr').attr('data-pid') || 0;
                openProductMaster(nProd);
            }
            else if ($(event.target).hasClass('clsCName')) {
                var nCust = $(event.target).closest('tr').attr('data-cid') || 0;
                openCustomerMaster(nCust);
            }
        }
        if (event.code == "Space") {

            var fid = event.target.id;
            var fname = event.target.name;
            var fvalue = event.target.value;
            if (fname == "PaymentAmount") {
                var balvalue = parseFloat($("#txtPMPBalance").attr("txttag"));
                if (balvalue > 0) {
                    updateInputColumn(fid, (balvalue + parseFloat(fvalue)));
                    var GridAdjAmt = 0;
                    var TotAmt = parseFloat(document.getElementById("txtPMPTotal").getAttribute("txttag"));
                    $("#tblPayment tbody tr input[name=PaymentAmount]").each(function () {
                        GridAdjAmt += parseFloat($(this).attr("txttag"));
                    });
                    GridAdjAmt = GridAdjAmt;
                    updateInputColumn("txtPMPRecdAmt", GridAdjAmt);
                    updateInputColumn("txtPMPBalance", 0);
                    updateInputColumn("txtPMPAdjAmt", GridAdjAmt);
                } else {
                    showErrorSnackbar("Balance amount should be greater than 0");
                }

            }
        }
        //if (event.altKey && event.key === '1') {
        //    var nPartyID = $("#txtVendorID").val() != "" ? $("#txtVendorID").val() : 0;
        //    OpenOneView(nPartyID, 2, true);
        //}
        if (event.altKey && (event.key == 's')) {//Switch contains & startwith
            event.preventDefault();
            var fieldid = event.target.id;
            var infomessage = "Search mode changed to&ensp;" + (autolistfilterwith ? "<h4><code>Contains </code></h4>" : "<h4><code>Start with</code></h4>");
            autolistfilterwith = !autolistfilterwith;
            if (fieldid == "txtHProds") {
                showInfoSnackbar(infomessage);
                //~AutoList Products
                PaginatedAutocomplete({
                    inputId: "txtHProds",
                    data: TempAL,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtHProds").val(item.code);
                        $("#txtTempABS").val(item.ABS + item.Location);
                        $("#lblABSLoc").html(item.ABS + item.Location);
                        $("#clrdivs").html("");
                        GetData(4, item.code);
                        $("#btnBatch").focus();
                        BatchMode = 0;
                        return false;
                    }
                });
            }
            if (fieldid == "txtSearch") {
                showInfoSnackbar(infomessage);
                //~AutoList Vendor
                PaginatedAutocomplete({
                    inputId: "txtSearch",
                    data: arrVendor,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtSearch").val(item.code);
                        GetData(3, item.code);
                        return false;
                    }
                });
            }
            if (fieldid == "txtFilterParty") {
                showInfoSnackbar(infomessage);
                //~AutoList Filter Vendor
                PaginatedAutocomplete({
                    inputId: "txtFilterParty",
                    data: arrVendor,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtFilterParty").val(item.name);
                        return false;
                    }
                });
            }
            if (fieldid == "txtReason") {
                showInfoSnackbar(infomessage);
                //~AutoList Reason
                PaginatedAutocomplete({
                    inputId: "txtReason",
                    data: arrReasons,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtReason").val(item.label);
                        $("#txtReasonID").val(item.id);
                        return false;
                    }
                });
            }
        }
        else if (event.altKey && (event.key == 'a')) {//change search field
            event.preventDefault();
            var fieldid = event.target.id;
            startwithfield = (startwithfield == "code" ? "name" : startwithfield == "search" ? "code" : "search");
            if (fieldid == "txtHProds") {
                showInfoSnackbar("Search field changed to&ensp; <h4><code>'" + startwithfield + "'</code></h4>");

                //~AutoList Products
                PaginatedAutocomplete({
                    inputId: "txtHProds",
                    data: TempAL,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtHProds").val(item.code);
                        $("#txtTempABS").val(item.ABS + item.Location);
                        $("#lblABSLoc").html(item.ABS + item.Location);
                        $("#clrdivs").html("");
                        GetData(4, item.code);
                        $("#btnBatch").focus();
                        BatchMode = 0;
                        return false;
                    }
                });
            }
            if (fieldid == "txtSearch") {
                showInfoSnackbar("Search field changed to&ensp; <h4><code>'" + startwithfield + "'</code></h4>");
                //~AutoList Vendor
                PaginatedAutocomplete({
                    inputId: "txtSearch",
                    data: arrVendor,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtSearch").val(item.code);
                        GetData(3, item.code);
                        return false;
                    }
                });
            }
            if (fieldid == "txtFilterParty") {
                showInfoSnackbar("Search field changed to&ensp; <h4><code>'" + startwithfield + "'</code></h4>");
                //~AutoList Filter Vendor
                //~AutoList Filter Vendor
                PaginatedAutocomplete({
                    inputId: "txtFilterParty",
                    data: arrVendor,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtFilterParty").val(item.name);
                        return false;
                    }
                });
            }
            if (fieldid == "txtReason") {
                showInfoSnackbar("Search field changed to&ensp; <h4><code>'" + startwithfield + "'</code></h4>");
                //~AutoList Reason
                PaginatedAutocomplete({
                    inputId: "txtReason",
                    data: arrReasons,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtReason").val(item.label);
                        $("#txtReasonID").val(item.id);
                        return false;
                    }
                });
            }
        }
        // autolistfilterwith = 1;
        else if (event.altKey && (event.key == 'q')) {//Info about Autolist property
            var containinfo = autolistfilterwith ? "Start With" : "Contains";
            var searchcolumninfo = startwithfield;

            var alinfo = `
<div class="p-3" style="min-width:360px;">
    <!-- Search Mode -->
    <div class="border rounded-3 p-3 mb-2 bg-light">
        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary me-2"
                     style="width:34px;height:34px;">
                    <i class="bi bi-search"></i>
                </div>

                <div>
                    <div class="text-muted medium fw-semibold">Search Mode</div>
                    <div class="fw-bold text-dark" style="font-size:16px">&emsp;<code>${containinfo}</code></div>
                </div>
            </div>

            <i class="bi bi-chevron-right text-muted"></i>
        </div>
    </div>

    <!-- Search Field -->
    <div class="border rounded-3 p-3 bg-light">
        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success me-2"
                     style="width:34px;height:34px;">
                    <i class="bi bi-tag"></i>
                </div>

                <div>
                    <div class="text-muted medium fw-semibold">Search Field</div>
                    <div class="fw-bold text-dark" style="font-size:16px">&emsp;<code>${searchcolumninfo}</code></div>
                </div>
            </div>

            <i class="bi bi-chevron-right text-muted"></i>
        </div>
    </div>

</div>
`;
            InfoDialogMsg(alinfo, "Autolist property");
        }
    });
</script>