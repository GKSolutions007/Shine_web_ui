<style>

    /* Status Badge with Circle */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        animation: pulse 3s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.85;
        }
    }

    .status-badge.active {
        background: rgba(72, 187, 120, 0.85);
        color: var(--success-dark);
    }

    .status-badge.inactive {
        background: rgba(245, 101, 101, 0.85);
        color: var(--danger-dark);
    }

    .status-circle {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        animation: blink 1.5s ease-in-out infinite;
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }

    .status-circle.active {
        background: var(--success-color);
        box-shadow: 0 0 8px rgba(72, 187, 120, 0.6);
    }

    .status-circle.inactive {
        background: var(--danger-color);
        box-shadow: 0 0 8px rgba(245, 101, 101, 0.6);
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        /*overflow: auto;*/ /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 35%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            /* overflow: auto;*/
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            /*overflow: auto;*/
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -70%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 1em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormID, new { @autocomplete = "off", @class = "form-control", @id = "txtFormID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <label id="lblIsDepend" hidden>@ViewData["isDepend"]</label>
    <label id="lblParentMenuID" hidden>@ViewData["ParentMenuID"]</label>
    <label id="lblParentFormFieldID" hidden>@ViewData["ParentFormFieldID"]</label>
    <hr />
    <div class="toastBox"></div>
    <div style="padding-bottom:10px" hidden>
        <button id="btnAdd" class="btn btn-info"><span class="glyphicon glyphicon-plus" style="color: white"></span>&#x2009;Add</button>
    </div>
    <input type="text" id="productInput" placeholder="Search product..." hidden>
    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>
    <div class="modal fade" id="myModalfg" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <span class="btn-close" id="modelcloseX"></span>
                </div>
                <!-- Modal Body -->
                <div class="modal-body">
                    <div style="padding-top:2px">
                        <table class="table w-100">
                            <tr>
                                <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                    <span class="form-label">
                                        <input type="text" id="txtName" class="form-control" />
                                        <label class="labelup">Name *</label>
                                    </span>
                                    <div class="clrdiv text-danger" id="dvErrorName"></div>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                    <label for="chkActive">Active :</label>
                                    &emsp;
                                    <input type="checkbox" id="chkActive" checked disabled />
                                    <div class="clrdiv text-danger" id="dvErrorActive"></div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <!-- Modal Footer -->
                <div class="modal-footer" style="background-color:skyblue">
                    <button type="button" class="btn btn-danger" id="btnClear">
                        <span class="glyphicon glyphicon-refresh"> Clear</span>
                    </button>
                    <button type="button" class="btn btn-success" id="btnSave">
                        <span class="glyphicon glyphicon-saved"> Save</span>
                    </button>
                    <button type="button" class="btn btn-warning" id="btnClose">
                        <i class="bi bi-x-circle"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</body>
<script>
    //$("#btnClear, #btnClose, #btnSave").hide();
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                var ID = rowData.ID;//[0];
                var Name = rowData.Name;//[1];
                var Active = rowData.Active;//[2];
                nMode = 3;
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                $("#txtID").val(ID);
                $("#txtName").val(Name);
                $("#chkActive").prop("checked", Active == "True");
                $("#chkActive,#btnSave,#txtName,#btnClear").prop("disabled", true);
                $(".clrdiv").html("");
                $("#btnClear,#btnSave").hide();
                $("#btnClose").show();
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                var ID = rowData.ID;//[0];
                var Name = rowData.Name;//[1];
                var Active = rowData.Active;//[2];
                nMode = 2;
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                $("#txtID").val(ID);
                $("#txtName").val(Name);
                $("#chkActive").prop("checked", Active == "True");
                $("#chkActive,#btnSave,#txtName").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $(".clrdiv").html("");
                $("#btnClear").hide();
                $("#btnClose,#btnSave").show();
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>
<script type="text/javascript">

    var Aurl = '@Session["APIurl"]';
    var itemorderby = '@Session["ItemOrderby"]';
var EnableALStartWith = '@Session["ALSearchstartwith"]' == "1";
var autolistfilterwith = EnableALStartWith;
var startwithfield = itemorderby == "1" ? "code" : itemorderby == "2" ? "name" : "search";
    var UID = '@Session["LoginUserID"]';
    var RID = '@Session["RoleID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    GetColumnSettingsData(2, 1, 1);
    var arrData = [], SingleMasterData;
    setTimeout(() => {
        GetData();
    }, 500);
    var grid;

    //~Grid Data
    function GetData() {
        $.ajax({
            url: Aurl + "singlemaster/get",
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: 3, Name: "" },
            xhrFields: {
                withCredentials: true
            },
            //async : false,
            success: function (data) {
                if (data.length == 0) {
                    showErrorSnackbar("No Records Found");
                }
                SingleMasterData = data;
                arrData = [];
                $.each(data, function (i, items) {
                    var al = {
                        "label": items.Name,
                        "active": items.Active,
                        "id": items.ID,
                    }
                    arrData.push(al);
                });
                var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                grid = new GKBSDynamicGrid('#my-grid', columns, SingleMasterData, {
                    enablePagination: true,
                    pageSize: ItemsperPage,
                    enableSearch: true,
                    stickyToWindow: true,
                    enableExport: false,
                    enablePrint: false,
                    enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                    enableAddRow: false,
                    enableRemoveRow: false,
                    enableSorting: true,
                    searchTerm: currentSearchValue, singleIconAction: singleIconAction,
                    rowActionsMenu: menuActions,
                    customCellRenderer: (el, col, rowData) => {
                        if (col.field === 'Active') {
                            const val = rowData[col.field];
                            console.log("Active : ", val);
                            if (val === 'True') {
                                el.innerHTML = `<div class="dg-status-badge dg-status-active">
                                        <span class="dg-status-circle"></span> Active
                                    </div>`;
                            } else if (val === 'False') {
                                el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                                        <span class="dg-status-circle"></span> In-Active
                                    </div>`;
                            }
                        }
                    },
                    customButtons: [
                        {
                            icon: '⚙️',
                            text: '',
                            title: 'Settings',
                            visible: true,
                            onClick: (gridInstance, event) => {
                                //modalGenColumnSettings.style.display = "block";
                                modalGenColumnSettings.show();
                                GendralColumnSettings(1, 1, 1, 0);
                            }
                        },
                        {
                            icon: '➕',
                            text: 'New',
                            title: 'New ' + $("#MainHeading").text(),
                            visible: $("#txtAddID").val() == 1,
                            onClick: (gridInstance, event) => {
                                nMode = 1;
                                $("#chkActive,#btnSave,#txtName,#btnClear").prop("disabled", false);
                                $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                $("#btnClear,#btnClose,#btnSave").show();
                                 modal.show();
                                ClearForm();
                            }
                        },
                    ],
                    onCellClick: (rowData, fieldName, cellValue, column) => {

                    },
                    onCellDoubleClick: (rowData, fieldName, cellValue, column) => {

                    },
                    onColumnResize: (colIndex, field, header, newWidth) => {
                        UpdateColumnWidth(1, 1, 0, colIndex, field, newWidth)
                    },
                });
                //~AutoList
                PaginatedAutocomplete({
                    inputId: "txtName",
                    data: arrData,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtName").val(item.label);
                        return false;
                    }
                });
                //$("#txtName").autocomplete({
                //    minLength: 0,
                //    source: arrData,
                //    select: function (event, ui) {
                //        $("#txtName").val(ui.item.label);
                //        //$("#txtRemarks").val(ui.item.id);
                //        return false;
                //    },
                //}).autocomplete("instance")._renderItem = function (ul, item) {
                //    return $("<li class='each'>")
                //        .append("<div class='acItem'><span class='name'>" +
                //            item.label + "</span></div>")
                //        .appendTo(ul);
                //};
            }
            , error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }

    var modal = new bootstrap.Modal(document.getElementById('myModalfg'));// document.getElementById("myModalfg");
    //document.getElementById('myModalfg').addEventListener('shown.bs.modal', function () {
    //    $("#txtName").focus();
    //});
    $('#myModalfg').on('shown.bs.modal', function () {
        $("#txtName").focus();
    });
    //~Close
    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.hide();
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (ClearcfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $("#txtName").val("");
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", true);
        $(".clrdiv").html("");
        $("#txtName").focus();
        if (nMode != 1)
            //modal.hide();
            modal.hide();
    }
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        //~Validation
        var IsValid = true;
        if ($("#txtName").val() == "") {
            IsValid = false;
            $("#dvErrorName").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        else {
            if (FID == 10) {
                ChkFormation = EmailValidation($("#txtName"), $("#dvErrorName"), false);
                if (!ChkFormation) {
                    IsValid = false;
                }
            }
        }
        if (IsValid) {
            if (cfFocus != 3) {
                ConfirmDialogMsg("Do you want to save data?");
            } else {
                SaveData();
            }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var name = $("#txtName").val();
        var lstMaster = {
            "FormID": FID,
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "Name": $("#txtName").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID
        };
        $.ajax({
            url: Aurl + "singlemaster/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        //alert(items.Message);
                        showSuccessSnackbar(items.Message);
                        if (window.opener && !window.opener.closed) {
                            //window.opener.GetData(1);
                            //window.opener.$('#txtReason').val(name)
                            //window.opener.$('#txtReasonID').val(items.ID)
                            window.opener.postMessage({
                                source: $("#txtFormName").val(),// "CustomerMaster",
                                id: items.ID,   // adjust to your actual field names
                                name: name
                            }, "*");
                            window.close();
                        }
                        else{
                            ClearForm();
                            GetData();
                            modal.hide();
                        }
                    }
                    else {
                        $("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                        //alert(items.Message);
                    }
                });
            },
            error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    //~Depend Master Load
    if ($("#txtTransType").val() == "2") {
        console.log("ID", $("#txtID").val());
        if ($("#txtID").val() > 0) {
            GetData();
            nMode = 2;
            $(".clrdiv").html("");
            var ID = $("#txtID").val();
            setTimeout(() => {
                var arr = arrData.filter(sm => sm.id == ID);
                if (arr.length > 0) {
                    modal.show();
                    $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                    $("#txtName").val(arr[0].label);
                    $("#chkActive").prop("checked", arr[0].active == "True");
                    $("#chkActive,#btnSave,#txtName").prop("disabled", false);
                    $("#btnClear").prop("disabled", true);
                    $(".clrdiv").html("");
                }
                else {
                    $(".modal-title#lblPopupheading").text($("#MainHeading").text());
                    modal.hide();
                }
            }, 1000);
        }
    }
    var productAC = PaginatedAutocompleteMultiCol({
        inputId: "productInput",

        // your product records — any extra fields are ignored unless listed in columns
        data: [
            {id:43, code: "P001", name: "Paracetamol 500mg", hsn: "30049099", mrp: "25.00",abs:"1650.00" },
            { id: 75, code: "P002", name: "Amoxicillin 250mg", hsn: "30042010", mrp: "45.00", abs: "151.00" }
            // ...
        ],

        // columns shown in the dropdown, in order
        columns: [
            { key: "code", label: "Code", width: "15%" },
            { key: "name", label: "Name", width: "35%" },
            { key: "hsn", label: "HSN", width: "20%" },
            { key: "mrp", label: "MRP", width: "10%" },
            { key: "abs", label: "Stock", width: "10%" }
        ],

        // which fields typing filters against
        searchFields: ["code", "name", "hsn"],

        // which field goes into the input box when a row is picked
        // change to "name" if you want the product Name to fill instead of Code
        selectField: "name",

        onSelect: function (item) {
            console.log("Selected product:", item);
            // e.g. populate other fields on the form:
            // $("#hsnInput").val(item.hsn);
            // $("#mrpInput").val(item.mrp);
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.altKey && (event.key == 's')) {//Switch contains & startwith
            event.preventDefault();
            var fieldid = event.target.id;
            var infomessage = "Search mode changed to&ensp;" + (autolistfilterwith ? "<h4><code>Contains </code></h4>" : "<h4><code>Start with</code></h4>");
            autolistfilterwith = !autolistfilterwith;
            if (fieldid == "txtName") {
                showInfoSnackbar(infomessage);
                //~AutoList
                PaginatedAutocomplete({
                    inputId: "txtName",
                    data: arrData,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtName").val(item.label);
                        return false;
                    }
                });
            }
        }
        // autolistfilterwith = 1;
        else if (event.altKey && (event.key == 'q')) {//Info about Autolist property
            var containinfo = autolistfilterwith ? "Start With" : "Contains";
            var searchcolumninfo = startwithfield;

            var alinfo = `
<div class="p-3" style="min-width:360px;">  
    <!-- Search Mode -->
    <div class="border rounded-3 p-3 mb-2 bg-light">
        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary me-2"
                     style="width:34px;height:34px;">
                    <i class="bi bi-search"></i>
                </div>

                <div>
                    <div class="text-muted medium fw-semibold">Search Mode</div>
                    <div class="fw-bold text-dark" style="font-size:16px">&emsp;<code>${containinfo}</code></div>
                </div>
            </div>

            <i class="bi bi-chevron-right text-muted"></i>
        </div>
    </div>

    <!-- Search Field -->
    <div class="border rounded-3 p-3 bg-light">
        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success me-2"
                     style="width:34px;height:34px;">
                    <i class="bi bi-tag"></i>
                </div>

                <div>
