<script type="text/javascript">
    var Table = $('#tblMasterData').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        "bFilter": true,
        "bSearchable": true,
        "bInfo": true,
        "bPaginate": true,
        "ordering": true,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0], "visible": false, searchable: false }, { "targets": [2,3,4], "class": "text-center" }],
    });

    var Aurl = '@Session["APIurl"]';
    if ($("#txtAddID").val() == 0) {
        $("#trAdd").hide();
        $("#btnAdd").hide();
    }
    if ($("#txtModifyID").val() == 0) {
        //Table.column(3).visible(false);
    }
    if ($("#txtViewID").val() == 0) {
        //Table.column(4).visible(false);
    }
    if ($("#txtModifyID").val() == 0 && $("#txtViewID").val() == 0 && $("#txtAddID").val() == 1) {
        $("#dvMainTable").hide();
    }
    var UID = '@Session["LoginUserID"]';
    var RID = '@Session["RoleID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    GetColumnSettingsData(2, 1, 1);
    setTimeout(() => {
        GetData();
    }, 500);
    var grid;
    var arrData = [],SingleMasterData;
    function GetData() {
        $.ajax({
            url: Aurl + "singlemaster/get",
            /*url: "http://localhost:44396/api/singlemaster/get",*/
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: 3, Name: "" },
            xhrFields: {
                withCredentials: true
            },
            async : false,
            success: function (data) {
                if (data.length == 0) {
                    showErrorSnackbar("No Records Found");
                }
                SingleMasterData = data;
                //Table.draw().clear(); Table.draw().clear();
                arrData = [];
                $.each(data, function (i, items) {
                    var al = {
                        "label": items.Name,
                        "active": items.Active,
                        "id": items.ID,
                    }
                    arrData.push(al);
                });

                var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                grid = new GKBSDynamicGrid('#my-grid', columns, SingleMasterData, {
                    enablePagination: true,
                    pageSize: ItemsperPage,
                    enableSearch: true,
                    stickyToWindow: true,
                    enableExport: false,
                    enablePrint: false,
                    enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                    enableAddRow: false,
                    enableRemoveRow: false,
                    enableSorting: true,

                    searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                    rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                    //onCellChange: handleCellUpdate,
                    customCellRenderer: (el, col, rowData) => {
                        if (col.field === 'Active') {
                            const val = rowData[col.field];
                            console.log("Active : ", val);
                            if (val === 'True') {
                                el.innerHTML = `<div class="dg-status-badge dg-status-active">
                                        <span class="dg-status-circle"></span> Active
                                    </div>`;
                            } else if (val === 'False') {
                                el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                                        <span class="dg-status-circle"></span> In-Active
                                    </div>`;
                            }
                        }
                    },
                    customButtons: [
                        {
                            icon: '⚙️',
                            text: 'Settings',
                            title: 'Settings',
                            visible: true,
                            onClick: (gridInstance, event) => {                                
                                //modalGenColumnSettings.style.display = "block";
                                modalGenColumnSettings.show();
                                GendralColumnSettings(1, 1, 1, 0);
                            }
                        },
                        {
                            icon: '➕',
                            text: 'Add New',
                            title: 'Add New',
                            visible: $("#txtAddID").val() == 1,
                            onClick: (gridInstance, event) => {                                
                                nMode = 1;
                                $("#chkActive,#btnSave,#txtName,#btnClear").prop("disabled", false);
                                $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                 modal.show();
                                ClearForm();
                            }
                        },
                    ],
                    onCellClick: (rowData, fieldName, cellValue, column) => {
                        //let message = `Clicked Cell:\n`;
                        //message += `• Field: ${fieldName}\n`;
                        //message += `• Value: ${cellValue}\n\n`;
                        //message += `Row Data:\n`;
                        //for (const key in rowData) {
                        //    if (key !== '_gridId') {
                        //        message += `• ${key}: ${rowData[key]}\n`;
                        //    }
                        //}
                        //alert(message);
                    },
                    onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                        //// Double-click handler - shows JSON format
                        //let message = `Double-Clicked Cell:\n`;
                        //message += `• Field: ${fieldName}\n`;
                        //message += `• Value: ${cellValue}\n\n`;
                        //message += `Full Row Data:\n${JSON.stringify(rowData, null, 2)}`;
                        //alert(message);
                    },
                    onColumnResize: (colIndex, field, header, newWidth) => {
                        UpdateColumnWidth(1, 1, 0, colIndex, field, newWidth)
                    },
                });

                var searchValue = '';
                if ($.fn.DataTable.isDataTable('#tblMasterData')) {
                    searchValue = $('#tblMasterData').DataTable().search(); // get current search term
                }
                $('#tblMasterData').DataTable({
                    pageLength: ItemsperPage, lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                    scrollY: "450px",
                    scrollX: true,
                    scrollCollapse: true,
                    paging: true,
                    destroy: true,
                    data: data,
                    fixedColumns: false,
                    searching: true,
                    ordering: true,
                    sorting: false,
                    columns: [
                        { "data": "ID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                        { "data": "Name", "autoWidth": true, className: "dt-body-left" },
                        // {
                        //     className: "dt-body-center",
                        //     "mRender": function (data, type, value) {
                        //         var _action = value.Active == "True" ? "Yes" : "No";// '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-pencil clsEdit" style="font-size:16px" title="Edit"></span></a>';
                        //         return _action;
                        //     }
                        // },
                        {
                            className: "dt-body-center",
                            "mRender": function (data, type, value) {
                                var isActive = value.Active == "True";
                                var statusClass = isActive ? "active" : "inactive";
                                var statusText = isActive ? "Active" : "Inactive";
                                var _action = '<div class="status-badge ' + statusClass + '">' +
                                    '<span class="status-circle ' + statusClass + '"></span>' +
                                    statusText +
                                    '</div>';
                                return _action;
                            }
                        },
                        {
                            className: "dt-body-center",
                            "mRender": function (data, type, value) {
                                var _action = '<label title="' + value.CDate + '">' + value.CBy + '</label>';
                                return _action;
                            }
                        },
                        {
                            className: "dt-body-center",
                            "mRender": function (data, type, value) {
                                var _action = '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-pencil clsEdit" style="font-size:16px" title="Edit"></span></a>';
                                return _action;
                            }, "visible": $("#txtModifyID").val() == 0 ? false : true
                        },
                        {
                            className: "dt-body-center",
                            "mRender": function (data, type, value) {
                                var _action = '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-eye-open clsView" style="font-size:16px" title="View"></span></a>';
                                return _action;
                            }, "visible": $("#txtViewID").val() == 0 ? false : true
                        },
                    ],
                    initComplete: function () {
                        // Re-apply search value after table is fully initialized
                        this.api().search(searchValue).draw();
                    }
                });
                Table = $('#tblMasterData').DataTable();
                $("#txtName").autocomplete({
                    minLength: 0,
                    source: arrData,
                    select: function (event, ui) {
                        $("#txtName").val(ui.item.label);
                        //$("#txtRemarks").val(ui.item.id);
                        return false;
                    },
                }).autocomplete("instance")._renderItem = function (ul, item) {
                    return $("<li class='each'>")
                        .append("<div class='acItem'><span class='name'>" +
                            item.label + "</span></div>")
                        .appendTo(ul);
                };

                //var txtName = $('#txtName');
                //autocomplete = txtName.typeahead({ scrollBar: true, onSelect: displayResult });
                //autocomplete.data('typeahead').source = null;
                //autocomplete.data('typeahead').source = arrData;
            }
            , error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    
    function GetColumnSettingsData(nMode,nFormID,nTableID) {
        $.ajax({
            url: Aurl + "columnsettings/getcolumnsettings",
            /*url: "http://localhost:44396/api/singlemaster/get",*/
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, FormID: nFormID, TableID: nTableID, FormorReport: 0 },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                if (data.length > 0) {
                    columns = (data);
                    console.log("columns : ", columns);                    
                    columns.push(actions);
                } else {
                    showErrorSnackbar("No column data found");
                }
            }
        });
    }
    function displayResult(item) {
        $('.alert').show().html('You selected <strong>' + item.value + '</strong>: <strong>' + item.text + '</strong>');
    }
    var modal = new bootstrap.Modal(document.getElementById('myModalfg'));// document.getElementById("myModalfg");
    //var span = document.getElementsByClassName("closefg")[0];
    //span.onclick = function () {
    //    modal.hide();
    //}
    $('#btnClose').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.hide();
    }
    $("#btnAdd").click(function () {
        nMode = 1;
        $("#chkActive,#btnSave,#txtName,#btnClear").prop("disabled", false);
        $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
         modal.show();
        ClearForm();
    });
    $('#btnClear').click(function (e) {
        if (ClearcfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $("#txtName").val("");
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", true);
        $(".clrdiv").html("");
        $("#txtName").focus();
        if (nMode != 1)
            //modal.hide();
            modal.hide();
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        var IsValid = true;
        if ($("#txtName").val() == "") {
            IsValid = false;
            $("#dvErrorName").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        else {
            if (FID == 10) {
                ChkFormation = EmailValidation($("#txtName"), $("#dvErrorName"), false);
                if (!ChkFormation) {
                    IsValid = false;
                }
            }
        }
        if (IsValid) {
            if (cfFocus != 3) {
                ConfirmDialogMsg("Do you want to save data?");
            } else {
                SaveData();
            }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var name = $("#txtName").val();
        var lstMaster = {
            "FormID": FID,
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "Name": $("#txtName").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID
        };
        $.ajax({
            url: Aurl + "singlemaster/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        ClearForm();
                        GetData();
                        //alert(items.Message);
                        showSuccessSnackbar(items.Message);
                        modal.hide();
                        if (window.opener && !window.opener.closed) {
                            window.opener.GetData(1);
                            window.opener.$('#txtReason').val(name)
                            window.opener.$('#txtReasonID').val(items.ID)
                            window.close();
                        }                        
                    }
                    else {
                        $("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                        //alert(items.Message);
                    }
                });
            },
            error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    if ($("#txtTransType").val() == "2") {
        console.log("ID", $("#txtID").val());
        if ($("#txtID").val() > 0) {
            GetData();
            nMode = 2;
            $(".clrdiv").html("");
            var ID = $("#txtID").val();
            var arr = arrData.filter(sm => sm.id == ID);
            if (arr.length > 0) {
                 modal.show();
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                $("#txtName").val(arr[0].label);
                $("#chkActive").prop("checked", arr[0].active == "True");
                $("#chkActive,#btnSave,#txtName").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $(".clrdiv").html("");
            }
            else {
                $(".modal-title#lblPopupheading").text($("#MainHeading").text());
                modal.hide();
            }
        }
    }
