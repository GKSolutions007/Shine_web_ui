    $("#btnAddAccount").click(function () {
        $(".clrdivs").html("");
        var IsValid = true;
        if ($("#txtAccountName").val() == "") {
            IsValid = false;
            $("#dvErrorAccountName").html("Select Account Name should not be empty");
            showErrorSnackbar("Select Account Name should not be empty");
        }
        else
        {
            const exists = arrPartyData.indexOf($("#txtAccountName").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#dvErrorAccountName").html("Select Account Name from list");
                showErrorSnackbar("Select Account Name from list");
            }
            else
            {
                var chk = CheckNamealreadyadded($("#txtAccountName").val());
                if (chk) {
                    IsValid = false;
                    $("#dvErrorAccountName").html("Account Name already added");
                    showErrorSnackbar("Account Name already added");
                }
            }
        }
        if ($("#txtValue").val() == "") {
            IsValid = false;
            $("#dvErrorValue").html("Value should not be empty");
            showErrorSnackbar("Value should not be empty");
        }
        else {
            if (parseFloat($("#txtValue").val()) <= 0) {
                IsValid = false;
                $("#dvErrorValue").html("Value should be greater than zero");
                showErrorSnackbar("Value should be greater than zero");
            }
