    var arrPartyData = [], arrAccount = [], arrBranchData = [], nIndexarrParty = 0, arrALBranchData = [], nIndexarrAccount = 0, nIndexarrTax = 0, nIndexarrBranch = 0;
    //~Preload Data
    function GetData(nMode,nID) {
        $.ajax({
            url: Aurl + "journalentry/get",
            type: 'get',
            contentType: 'json',
            data: { TransID: FID, Mode: nMode, ID: nID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbUDN,#cmbFAType,#txtBranchName').find("option").remove();
                    $('#cmbUDN,#txtBranchName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrPartyData = [], arrBranchData = [], arrAccount = [], arrALBranchData =[];
                    nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch = 0;
                    console.log("data ", data);
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            arrPartyData[nIndexarrParty] = items.Name;
                            nIndexarrParty++;
                            var adata = {
                                "id": items.ID,
                                "AccID": items.ID,
                                "AccName": items.Name,
                                "label": items.Name
                            }
                            arrAccount.push(adata);
                        }
                        if (items.FType == 2) {
                            //cmbFAType
                            $('#cmbFAType').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 3) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            $("#lblDocID").text(items.Name);
                        }
                    });
                    SetAutlistforFields();
                    //$("#txtBranchName").val(DefBranch);
                    LoadBranchByRoles('#txtBranchName,#cmbFilterBranch');
                }
                if (nMode == 3) {
                    //~Assign Data
                    TableJVData.draw().clear(); TableJVData.draw().clear();
                    $.each(data, function (i, items) {
                        if (nTransMode != 3)
                            $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);
                        $("#txtID").val(items.ID), $("#dtpDate").val(items.DocDate),
                            $("#txtRefNo").val(items.RefNo), $("#txtNarration").val(items.Narration), $("#cmbUDN").val(items.UDFId),
                            $("#txtStatus").val(items.Status);
                        $("#txtBranchName").val(items.BranchID);
                        TableJVData.row.add([
                            items.ID, items.FAID,
                            (nTransMode == 5 || nTransMode == 4) ? '' : '<span style="font-size:16px;" class="glyphicon glyphicon-remove-circle clsremoveprod" title="Remove Product"></span>&ensp;<span style="font-size:16px;" class="glyphicon glyphicon-edit clseditprod"  title="Edit Product"></span>',
                            '<p style="font-size:14px;">' + (i + 1) + '</p>',
                            /*'<label name="Branch">' + (items.BranchID) + '</label>',*/
                            '<label name="FAType">' + items.FAType + '</label>',
                            '<label name="AccountName">' + items.PartyID + '</label>',
                            '<label name="Adjustment">' + items.AdjYN + '</label>',
                            '<label lbltag="' + items.GrossAmt + '" title="' + items.GrossAmt +'" class="lblsettag" name="Credit">' + parseFloat(items.GrossAmt).toFixed(DecVal) + '</label>',
                            '<label lbltag="' + items.NetAmt + '" title="' + items.NetAmt +'" class="lblsettag" name="Debit">' + parseFloat(items.NetAmt).toFixed(DecVal) + '</label>',
                            '<label name="Remarks">' + items.Remark + '</label>',
                            '<label lbltag="0" class="lblsettag" name="Balance">' + "0.00" + '</label>',
                            '<span class="glyphicon glyphicon-trash clsbatchtrash"></span>'
                        ]).draw(false);
                        modal.show();
                    });
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#txtBranchName").prop("disabled", true);
                    }
                    calculateGrid();
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $('#btnTEdit').click(function (e) {
