@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
@*<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />*@
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>
    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }    
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 75%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 1%;
            /*overflow: auto;*/
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 5px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            /*overflow: auto;*/
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -53%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -20%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
</style>
<style>
    /* Align dropdown in DataTable cell */
    .action-dropdown {
        min-width: 100px;
        font-size: 12px;
        z-index: 1000;
        text-align: left;
    }

        /* Optional: Add hover effect */
        .action-dropdown > li > a {
            padding: 3px 12px;
            color: #333;
            text-decoration: none;
        }

            .action-dropdown > li > a:hover {
                background-color: #f5f5f5;
                color: #000;
            }

    /* Optional: Make dropdown button minimal */
    .dropdown-toggle {
        background-color: transparent !important;
        border: none !important;
        font-size: 15px;
        line-height: 1;
        padding: 2px 5px;
    }

        .dropdown-toggle::after {
            display: none;
        }
</style>
<body>
    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.Variant, new { @autocomplete = "off", @class = "form-control", @id = "txtVariantID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.Cancel, new { @autocomplete = "off", @class = "form-control", @id = "txtCancelID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.FormID, new { @autocomplete = "off", @class = "form-control", @id = "txtFormID" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })
    <input hidden id="txtStatus" />

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>
    
    <div id="dvMainTable">
        <div class="row text-end mb-3">
            <!-- Blank -->
            <div class="col-12 col-md-3"></div>
            <!-- Branch (NEW) -->
            <div class="col-12 col-md-2">
                <span class="form-label">
                    <select class="form-control FormfilterclrField" id="cmbFilterBranch">
                        <option value="0">Select Branch</option>
                    </select>
                    <label class="labelup">Branch</label>
                </span>
            </div>

            <!--Account Name -->
            <div class="col-12 col-md-2">
                <span class="form-label">
                    <input tabindex="1" class="form-control FormfilterclrField" type="text" id="txtFilterAccount" placeholder="">
                    <label class="labelup" for="txtCode"> Account Name</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFAccount"></div>
            </div>
            <!-- Period -->
            <div class="col-12 col-md-1">
                <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
            </div>
            <!-- From Date -->
            <div class="col-12 col-md-1">
                <span class="form-label">
                    <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFFrom" placeholder="" oninput="javascript: if (this.value > this.max) { this.value = this.max; }">
                    <label class="labelup" for="txtCode"> From</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFFrom"></div>
            </div>
            <!-- To Date -->
            <div class="col-12 col-md-1">
                <span class="form-label">
                    <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFTo" placeholder="" oninput="javascript: if (this.value > this.max) { this.value = this.max; }">
                    <label class="labelup" for="txtCode"> To</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFTo"></div>
            </div>
            <!-- All Status-->
            <div class="col-12 col-md-1">
                <input tabindex="1" style="font-size:14px;" class="FormfilterclrField" type="checkbox" id="chkShowAll">
                <label for="chkShowAll" style="font-size:14px;">All Status</label>
            </div>
            <!--Filter-->
            <div class="col-12 col-md-1">

                <button id="btnFilter" class="btn btn-primary ps-2"><span class="glyphicon glyphicon-filter" style="color: white"></span>&#x2009;Filter</button>

            </div>
        </div>
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>

    <div class="modal fade " id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">
                    <div style="padding-top:2px">
                        <div class="row mb-3" style="width:100%">
                            <!-- Branch -->
                            <div class="col-sm-3 col-md-3 col-lg-3">
                                <table>
                                    <tr>
                                        <td colspan="2">
                                            <span class="form-label">
                                                <select class="form-control FormclrcmbField" id="txtBranchName" @(Model.EnableBranch == "1" ? "disabled" : "")>
                                                    <option value="0">Select Branch</option>
                                                </select>
                                                <label class="labelup" for="txtBranchName">Branch *</label>
                                            </span>
                                            <div id="dvErrorBranchName" class="clrdiv" style="color:red"></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <!-- Ref No -->
                            <div class="col-sm-3 col-md-3 col-lg-3" align="center">
                                <table>
                                    <tr>
                                        <td style="border:none;" colspan="2">
                                            <span class="form-label">
                                                <input class="form-control" type="text" id="txtRefNo"
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorCode')"
                                                       oninput="sanitizeAlphaNumeric(this, '#dvErrorCode')" />
                                                <label class="labelup">Ref No</label>
                                            </span>
                                            <div class="clrdiv" id="dvErrorCode" style="color:red"></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <!-- Blank -->
                            <div class="col-12 col-md-3 mb-3"></div>
                            <!-- Doc ID -->
                            <div class="col-12 col-md-3">
                                <table>
                                    <tr>
                                        <td align="right">
                                            <span class="fw-semibold">
                                                Doc ID :
                                            </span>
                                        </td>
                                        <td>
                                            <label id="lblDocID" docprefix="" style="font-size:14px" class="fw-bolder">JV/2425/1</label>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="right">
                                            <span class="fw-semibold">
                                                Date :
                                            </span>
                                        </td>
                                        <td>
                                            <input class="clsdtpfieldbottomborder"
                                                   type="date"
                                                   id="dtpDate"
                                                   oninput="if (this.value > this.max) { this.value = this.max; }"
                                                   placeholder="Date" />
                                        </td>
                                    </tr>
                                </table>
                                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrDate"></div>
                            </div>
                        </div>
                        <hr class="style14" />
                        <div class="row" id="dvAddAccounts">


                            <div class="col-12 col-md-1 mb-3">
                                <span class="form-label">
                                    <select tabindex="1" class="form-control" id="cmbFAType">
                                        <option value="1">Credit</option>
                                        <option value="2">Debit</option>
                                    </select>
                                    <label class="labelup">FA Type </label>
                                </span>
                            </div>
                            <div class="col-12 col-md-4 mb-3">
                                <div class="input-group">
                                    <span id="openaccountname" class="input-group-text" title="New Account Name" style="cursor:pointer;">
                                        <i class="fas fa-arrow-up-right-from-square"></i>
                                    </span>
                                    <span class="form-label flex-grow-1">
                                        <input tabindex="2" class="form-control FormclrField" id="txtAccountName" />
                                        <input id="txtAccID" class="FormclrField" hidden />
                                        <label class="labelup" for="txtCode">Account Name </label>
                                    </span>
                                </div>
                                    <div style="color: red; padding-top: 5px; padding-left: 5px;" id="dvErrorAccountName" class="clrdivs"></div>
                                </div>
                                <div class="col-12 col-md-1 mb-3">
                                    <span class="form-label">
                                        <select tabindex="3" class="form-control" id="cmbAdjustment" disabled>
                                            <option value="0">No</option>
                                            <option value="1">Yes</option>
                                        </select>
                                        <label class="labelup">Adjustment </label>
                                    </span>
                                </div>
                                <div class="col-12 col-md-2 mb-3">
                                    <span class="form-label">
                                        <input tabindex="4" txttag="0" class="form-control FormclrField txtsettag" type="number" step="any" id="txtValue"
                                               onbeforeinput="return NumericOnlyBeforeInput(event, this,'#dvErrorValue')"
                                               oninput="sanitizeNumericOnly(this, '#dvErrorValue')" />
                                        <label class="labelup">Value </label>
                                    </span>
                                    <div style="color: red; padding-top: 5px; padding-left: 5px;" id="dvErrorValue" class="clrdivs"></div>
                                </div>
                                <div class="col-12 col-md-3 mb-3">
                                    <span class="form-label">
                                        <input tabindex="5" class="form-control FormclrField" type="text" step="any" id="txtRemarks"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorremark')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorremark')" />
                                        <label class="labelup">Remarks </label>
                                    </span>
                                    <div class="clrdiv" id="dvErrorremark" style="color:red"></div>
                                </div>
                                <div class="col-12 col-md-1 mb-3">
                                    <span class="form-label">
                                        <button tabindex="6" class="btn btn-primary" id="btnAddAccount">
                                            Add
                                        </button>
                                    </span>
                                </div>
                            </div>

                        <div class="row">
                            <table class="table table-bordered" id="tblJVData" width="100%">
                                <thead>
                                    <tr>
                                        <th style="text-align:center;font-size: 12px;width:0%;" class="trclrforcolheader">ID</th>
                                        <th style="text-align:center;font-size: 12px;width:0%;" class="trclrforcolheader">FAAccID</th>
                                        <th style="text-align:center;font-size: 12px;width:8%;" class="trclrforcolheader">Action</th>
                                        <th style="text-align:center;font-size: 12px;width:2%;" class="trclrforcolheader">#</th>
                                        <th style="text-align:center;font-size: 12px;width:10%;" class="trclrforcolheader">FA Type</th>
                                        <th style="text-align:center;font-size: 12px;width:28%;padding-right:100px;" class="trclrforcolheader">Account Name</th>
                                        <th style="text-align:center;font-size: 12px;width:8%;" title="Adjustment" class="trclrforcolheader">Adj.</th>
                                        <th style="text-align:center;font-size: 12px;width:10%;" class="trclrforcolheader">Credit</th>
                                        <th style="text-align:center;font-size: 12px;width:10%;" class="trclrforcolheader">Debit</th>
                                        <th style="text-align:center;font-size: 12px;width:15%;" class="trclrforcolheader">Remarks</th>
                                        <th style="text-align:center;font-size: 12px;width:9%;" class="trclrforcolheader">Balance</th>
                                    </tr>
                                </thead>

                                <tfoot>
                                    <tr>
                                        <td colspan="7">
                                            <label> Total :</label>
                                        </td>
                                        <td>
                                            <label id="lblTotCredit" lbltag="0" class="lblPT lblsettag">0.00</label>
                                        </td>
                                        <td>
                                            <label id="lblTotDebit" lbltag="0" class="lblPT lblsettag">0.00</label>
                                        </td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div style="padding-top:2px; width:100%" class="row">
                            <div class="col-sm-12 col-md-4 col-lg-4"></div>
                            <div class="col-sm-12 col-md-4 col-lg-4">
                                <table width="100%">
                                    <tr>

                                        <td width="75%" align="left" style="padding-left:2px">
                                            <span class="form-label">
                                                <select class="form-control" id="cmbPrintProfile">
                                                    <option value="0">Select</option>
                                                </select>
                                                <label class="labelup"> Print Profile</label>
                                            </span>
                                        </td>
                                        <td width="25%" align="left" style="padding-left:5px">
                                            <span class="form-label flex-grow-1">
                                                <input id="txtNoofCopies" class="form-control" value="1" type="number"
                                                       onbeforeinput="return NumericOnlyBeforeInput(event, this,'divErrPrintProfile')" oninput="sanitizeNumericOnly(this, 'divErrPrintProfile')" />
                                                <label class="labelup">Copies</label>
                                            </span>
                                            <div class="text-danger pt-1 ps-1" id="divErrPrintCopy"></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-sm-12 col-md-4 col-lg-4" align="right">
                                <div style="padding-left:20px">
                                    <span class="form-label">
                                        <textarea class="form-control FormclrField" rows="3" id="txtNarration"
                                                  onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorNarration')"
                                                  oninput="sanitizeAlphaNumeric(this, '#dvErrorNarration')"></textarea>
                                        <label class="labelupfortextarea" for="txtCode">Narration</label>
                                    </span>
                                    <div class="clrdiv" id="dvErrorNarration" style="color:red"></div>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer">
                    <table width="100%">
                        <tr>
                            <td align="right">
                                <div style="padding-right:20px">

                                    <button type="button" title="Whatsapp" class="btn" id="btnWhatsapp" style="background-color:green;color:white">
                                        <i class='fa-brands fa-whatsapp'></i>
                                    </button>

                                    <button type="button" title="Mail" class="btn clrforpdf" id="btnEmail">
                                        <span class="bi bi-envelope"></span>
                                    </button>

                                    <button type="button" title="PDF" class="btn clrforpdf" id="btnPDF">
                                        <i class='fa-regular fa-file-pdf'></i>
                                    </button>

                                    <button type="button" class="btn clrforpreview" id="btnPreview">
                                        <span class="bi bi-printer"></span> Preview
                                    </button>

                                    <button type="button" class="btn clrforpreview" id="btnPrint">
                                        <span class="bi bi-printer"></span> Print
                                    </button>
                                    <button type="button" class="btn btn-edit-style" id="btnTEdit"><span class="glyphicon glyphicon-pencil"> Edit</span></button>
                                    <button type="button" class="btn btn-cancel-style" id="btnTCancel"><span class="glyphicon glyphicon-remove"> Cancel</span></button>
                                    <button type="button" class="btn btn-variant-style" id="btnTVariant"><span class="bi bi-copy"> Variant</span></button>
                                    <button type="button" class="btn btn-danger" id="btnClear">
                                        <span class="glyphicon glyphicon-refresh"> Clear</span>
                                    </button>

                                    <button type="button" class="btn btn-success" id="btnSave">
                                        <span class="glyphicon glyphicon-saved"> Save</span>
                                    </button>

                                    <button type="button" class="btn btn-warning" id="btnClose">
                                        <i class="bi bi-x-circle"></i> Close
                                    </button>

                                </div>
                            </td>

                        </tr>
                    </table>
                </div>

            </div>
        </div>
    </div>

</body>

<script>
    //~Filter Action Buttons
    var nTransMode = 1;
    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canEdit: $("#txtModifyID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canCancel: $("#txtCancelID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                $(".clrdivs").html("");
                $("#txtAccountName,#txtRemarks,#txtValue").val("")
                $("#cmbFAType").val(1);
                var ID = rowData.ID;//[0];
                var sts = rowData.Status;//[8];
                nTransMode = 5;
                ViewActionButtonPermission();
                $("#txtID").val(ID);
                GetData(3, ID);
                $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                $("#btnSave,#btnClear,#btnDraft,#dtpDate").prop("disabled", true);
                $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
                $("#btnPreview,#btnPDF,#btnPrint").show();
                $("#btnSave,#btnClear,#btnDraft,#dvAddAccounts").hide();
                $("#btnEmail,#btnWhatsapp").show();

                var hdfkl = $("#txtFormName").val();
                $(".modal-title#lblPopupheading").text("View " + $("#txtFormName").val() + "_" + sts);
            }
        },
        {
            icon: '✏️',
            title: 'Edit',
            className: 'dg-action-edit',
            //visible: $("#txtModifyID").val() == 1,
            visible: (row) => {
                var isVisible = false;
                const isValidStatus = checkValidStatus(row.Status);
                if (mapusersRole.canEdit && isValidStatus)
                    isVisible = true;

                return isVisible;
            },
            displayType: 'menu_item',
            handler: (rowData, gridInstance) => {
                $(".clrdivs").html("");
                $("#txtAccountName,#txtRemarks,#txtValue").val("")
                $("#cmbFAType").val(1);
                var ID = rowData.ID;//[0];
                var sts = rowData.Status;//[8];
                if (sts != "Cancelled") {
                    $("#txtID").val(ID);
                    EditActionTrigger(rowData);
                }
                else {
                    showErrorSnackbar("Cannot Modify.This document already cancelled");
                }
            }
        },
        {
            icon: '📄',
            title: 'Variant',
            className: 'dg-action-variant',
            visible: $("#txtVariantID").val() == 1,
            displayType: 'menu_item',
            handler: (rowData, gridInstance) => {
                $(".clrdivs").html("");
                $("#txtAccountName,#txtRemarks,#txtValue").val("")
                $("#cmbFAType").val(1);
                
                var ID = rowData.ID;//[0];
                var sts = rowData.Status;//[8];
                $("#txtID").val(ID);
                VariantActionTrigger(rowData);
            }
        },
        {
            icon: '❌',
