                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 20, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'New',
                                title: 'New ' + $("#MainHeading").text(),
                                visible: $("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {
                                    nTransMode = 1;
                                    modal.show();

                                    $(".FormclrField,.FormclrcmbField").prop("disabled", false);
                                    $("#btnSave,#btnClear,#btnClose,#dtpDate").prop("disabled", false);
                                    $("#btnPreview,#btnPDF").prop("disabled", true);
                                    $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
                                    $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                    TableJVData.draw().clear();
                                    ClearForm();
                                    $("#txtAccountName").focus();
                                    setTimeout(() => {
                                        var DocDate = $("#dtpDate").val();
                                        var Branch = $("#txtBranchName").val();
                                        if (Branch > 0 && DocDate !== "") {
                                            GetDocumentID(DocDate, Branch, FID);
                                        }
