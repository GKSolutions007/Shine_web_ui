            var strBranch = $("#cmbFilterBranch").val(), strAcc = $("#txtFilterAccount").val(), dFrom = $("#dtpFFrom").val(), dTo = $("#dtpFTo").val(), chkshow = $("#chkShowAll").is(":checked") ? "1" : "0";
