    $('#btnTEdit').click(function (e) {
        var Did = $("#txtID").val();
        var Currsts = $("#txtStatus").val();
        $(".clrdivs").html("");
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        $.ajax({
            url: Aurl + "validatedocument",
            type: 'get',
            contentType: 'json',
            data: { ActionType: 1, TransID: nDocPrefix, ID: Did, Status: Currsts },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        EditActionTrigger(rowinfo);
                    }
                    else {
                        showErrorSnackbar(items.Message)
                    }
                });
            }
        });
    });
    function EditActionTrigger(rowData) {
        nTransMode = 2;
        GetDocViewData(3, rowData.ID);
        nTransMode = 2;
        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnClear,#btnPrint").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
        $("#btnTEdit,#btnTCancel").hide();
        $("#btnSave").show();
        $("#btnSave,#btnClose").prop("disabled", false);
        $("#dvMain").show();
        $("#dvDocuments").hide();
        $("#btnEmail,#btnWhatsapp").hide();
        $("#MainHeading").text("Modify " + $("#txtFormName").val());
    }
    $('#btnTCancel').click(function (e) {
        var Did = $("#txtID").val();
        var Currsts = $("#txtStatus").val();
        $(".clrdivs").html("");
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        $.ajax({
            url: Aurl + "validatedocument",
            type: 'get',
            contentType: 'json',
            data: { ActionType: 2, TransID: nDocPrefix, ID: Did, Status: Currsts },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        CancelActionTrigger(rowinfo);
                    }
                    else {
                        showErrorSnackbar(items.Message)
                    }
                });
            }
        });
    });
    function CancelActionTrigger(rowData) {
        $("#MainHeading").text("Cancel " + $("#txtFormName").val());
        nTransMode = 4;
        GetDocViewData(3, rowData.ID);
        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#txtNarration,#txtRemarks").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnClear,#btnDraft,#btnPrint").prop("disabled", true);
        $("#btnSave").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
        $("#btnTEdit,#btnTCancel").hide();
        $("#btnSave").show();
        $("#dvMain").show();
        $("#dvDocuments").hide();
        $("#btnEmail,#btnWhatsapp").hide();
    }
