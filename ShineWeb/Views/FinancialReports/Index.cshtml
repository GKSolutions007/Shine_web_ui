    // Store grid instance globally for export
    let currentGridInstance = null;
    // Show export options modal
    function showExportOptionsModal(gridInstance) {
        currentGridInstance = gridInstance;
        document.getElementById('exportOptionsModal').style.display = 'block';
    }

    // Close export modal
    function closeExportModal() {
        document.getElementById('exportOptionsModal').style.display = 'none';
        // Reset to default selection
        document.querySelector('input[name="exportType"][value="header"]').checked = true;
    }

    // Handle export based on selected option
    function handleExport() {
        var selectedOption = document.querySelector('input[name="exportType"]:checked').value;
        console.log('Export type selected:', selectedOption);
        var Excelfilter = [];
        var Col2Data = "";
        $('#tblFilterData tr td').each(function (i, items) {
            var insert = false;
            if (i % 2 == 0) {
                var lbl = items.firstChild.id;
                Col1Data = $("#" + lbl).text();
                //console.log("Col 1", Col2Data);
                insert = false;
            }
            else if (i % 2 == 1) {
                var input = items.firstChild.id;
                var inputtype = items.firstChild.type;
                var ifselval = inputtype == "select-one" && $("#" + input).val() > 0 ? $("#" + input + " option:selected").text() : "";
                Col2Data = inputtype == "checkbox" ? $("#" + input).is(":checked") ? 'True' : 'False' : inputtype == "select-one" ? ifselval : $("#" + input).val();
                insert = true;
            }
            if (insert) {
                var lst = {
                    FilterName: Col1Data,
                    Value: Col2Data
                };
                Excelfilter.push(lst);
            }
        });
        if (!currentGridInstance) {
            alert('Grid instance not found!');
            return;
        }

        switch (selectedOption) {
            case 'header':
                exportHeaderOnly(currentGridInstance);
                break;
            case 'footer':
                exportFooterOnly(Excelfilter);
                break;
            case 'separate':
                exportHeaderFooterSeparate(currentGridInstance, Excelfilter);
                break;
            case 'combined':
                exportHeaderFooterCombined(currentGridInstance, Excelfilter);
                break;
        }

        closeExportModal();
    }

    // Export Header Grid Only
    function exportHeaderOnly(gridInstance) {
        console.log('Exporting Header Only');
        gridInstance.exportToExcel();
    }

    // Export Footer/Detail Grid Only (All Records)
    function exportFooterOnly(fitersdata) {
        var ReportName = $("#MainHeading").text();
        console.log('Exporting Footer Only');
        detailrows = Detailsgrid.getAllRowData();

        if (!detailrows || detailrows.length === 0) {
            alert('No footer data available');
            return;
        }
        console.log("detailsGrid ", detailrows);
        //detailrows = detailsGrid.state.processedData;
        if (typeof XLSX === 'undefined') {
            console.error('SheetJS library not loaded');
            alert('Export library not available');
            return;
        }

        try {
            var footerColumns = detailcolumnsettings.filter(col => col.field);

            // Colors
            var METADATA_BG = "E0F2F1"; // Light Teal
            var HEADER_BG = "1A237E";   // Navy
            var HEADER_FG = "FFFFFF";   // White

            // Helper for styled cells
            var createStyledCell = (val, bgColor = "FFFFFF", fgColor = "000000", isBold = false) => {
                return {
                    v: val,
                    t: (typeof val === 'number') ? 'n' : 's',
                    s: {
                        fill: { fgColor: { rgb: bgColor } },
                        font: { color: { rgb: fgColor }, bold: isBold },
                        alignment: { vertical: "center" }
                    }
                };
            };

