    // Export Header and Footer in Separate Sheets
    function exportHeaderFooterSeparate(gridInstance, fitersdata) {
        var ReportName = $("#MainHeading").text();
        console.log('Exporting Header & Footer (Separate Sheets)');

        try {
            // Get filtered header data
            var headerData = gridInstance.state.processedData || gridInstance.originalData;
            var headerColumns = gridInstance.columns.filter(col =>
                !col.specialColumn && col.visible && col.field
            );
            var compdata = [];
            headerData.forEach(function (row) {
                console.log("Header row data : ", row);

                getFooterAlldata(row);
            })

            compdata.push(...arrAllFooterData);
            console.log("Compdata : ", compdata);
            // Get all footer data (all customer records)
            var allFooterData = compdata;// detailrows || [];

            var footerColumns = detailcolumnsettings.filter(col => col.field);

            if (headerData.length > 0) {
                var hidecolumns = columnsettings.filter(cl => cl.visible == false);
                //console.log("Hd Columns : ", arrParamHiddenColumns);
                //console.log("columnsettings : ", columnsettings);
                //console.log("Hidden column : ", hidecolumns);
                for (var i = 0; i < hidecolumns.length; i++) {
                    headerData.forEach(row => {
                        delete row[hidecolumns[i].headerText];
                    });
                }

            }
            const flatArray = Array.from(arrAllFooterData).flat();

            console.log("flatArray Data ", flatArray);

            // Clone to avoid mutating original data
            //flatArray = flatArray.map(obj => ({ ...obj }));

            // Remove the first column (by property order)
            if (flatArray.length > 0) {
                var hidecolumns = detailcolumnsettings.filter(cl => cl.visible == false);
                for (var i = 0; i < hidecolumns.length; i++) {
                    flatArray.forEach(row => {
                        delete row[hidecolumns[i].headerText];
                    });
                }

            }
            // Create workbook
            var wb = XLSX.utils.book_new();

            // Colors from gridui.js
            var METADATA_BG = "E0F2F1"; // Light Teal
            var HEADER_BG = "1A237E";   // Navy
            var HEADER_FG = "FFFFFF";   // White

            // Helper for styled cells
            var createStyledCell = (val, bgColor = "FFFFFF", fgColor = "000000", isBold = false) => {
                return {
                    v: val,
                    t: (typeof val === 'number') ? 'n' : 's',
                    s: {
                        fill: { fgColor: { rgb: bgColor } },
                        font: { color: { rgb: fgColor }, bold: isBold },
                        alignment: { vertical: "center" }
                    }
                };
            };

            // ========== HEADER SHEET ==========
            var filterRowCount = fitersdata.length;
            var headerStartRow = 3 + filterRowCount; // Company + Report + Empty + Filters + Empty

            // Create Header Sheet AOAs
            var headerSheetData = [];
            //headerSheetData.push([]);
            // Row 1: Company Name
            headerSheetData.push([
                createStyledCell("Company Name", METADATA_BG, "000000", true),
                createStyledCell(CompanyName, METADATA_BG)
            ]);

            // Row 2: Report Name
            headerSheetData.push([
                createStyledCell("Report Name", METADATA_BG, "000000", true),
                createStyledCell(ReportName, METADATA_BG)
            ]);

            // Row 3: Empty
            //headerSheetData.push([]);

            // Filter Data Rows
            fitersdata.forEach(filter => {
                headerSheetData.push([
                    createStyledCell(filter.FilterName, METADATA_BG, "000000", true),
                    createStyledCell(filter.Value, METADATA_BG)
                ]);
            });

            // Empty Row
            headerSheetData.push([]);
            // Grid Header Row
            headerSheetData.push(headerColumns.map(col => createStyledCell(col.header, HEADER_BG, HEADER_FG, true)));

            // Data Rows
            headerData.forEach(row => {
                var rowValues = headerColumns.map(col => {
                    let value = row[col.field];
                    // Strip HTML if present
                    if (typeof value === 'string' && value.includes('<')) {
                        var tempDiv = document.createElement('div');
                        tempDiv.innerHTML = value;
                        value = tempDiv.textContent || tempDiv.innerText || '';
                    }
                    return value ?? '';
                });
                headerSheetData.push(rowValues);
            });

            var wsHeader = XLSX.utils.aoa_to_sheet(headerSheetData);

            // Apply styling to header sheet (already handled by styled cells in AOA)
            var headerRange = XLSX.utils.decode_range(wsHeader['!ref']);

            // Add autofilter to header data (starting from header row)
            wsHeader['!autofilter'] = {
                ref: XLSX.utils.encode_range({
                    s: { r: headerStartRow, c: 0 },
                    e: { r: headerRange.e.r, c: headerRange.e.c }
                })
            };

            XLSX.utils.book_append_sheet(wb, wsHeader, 'Header Data');

            // ========== FOOTER SHEET ==========
            // Create Footer Sheet starting from first row
            var footerSheetData = [];

            // Row 1: Header Row
            footerSheetData.push(footerColumns.map(col => createStyledCell(col.header, HEADER_BG, HEADER_FG, true)));

            // Data Rows - ALL footer data
            flatArray.forEach(row => {
                var rowValues = footerColumns.map(col => row[col.field] ?? '');
                footerSheetData.push(rowValues);
            });

            var wsFooter = XLSX.utils.aoa_to_sheet(footerSheetData);

            // Add autofilter to footer sheet
            var footerRange = XLSX.utils.decode_range(wsFooter['!ref']);
            wsFooter['!autofilter'] = {
                ref: XLSX.utils.encode_range({
                    s: { r: 0, c: 0 }, // Start from header row (row 0)
                    e: { r: footerRange.e.r, c: footerRange.e.c }
                })
            };

            XLSX.utils.book_append_sheet(wb, wsFooter, 'Footer Data');
            var now = new Date();
            var timestamp =
                now.getFullYear().toString() +
                String(now.getMonth() + 1).padStart(2, '0') +
                String(now.getDate()).padStart(2, '0') +
                String(now.getHours()).padStart(2, '0') +
                String(now.getMinutes()).padStart(2, '0') +
                String(now.getSeconds()).padStart(2, '0') +
                String(now.getMilliseconds()).padStart(3, '0');

            // Export
            XLSX.writeFile(wb, `${ReportName}_Separate_${timestamp}.xlsx`);
            console.log('Export Separate Sheets completed');
        } catch (error) {
            console.error('Export error:', error);
            alert('Export failed: ' + error.message);
        }
    }

    // Export Header and Footer Combined in Single Sheet
    function exportHeaderFooterCombined(gridInstance, fitersdata) {
        var ReportName = $("#MainHeading").text();
        console.log('Exporting Header & Footer (Combined)');

        try {

            // Get filtered header data
            var headerData = gridInstance.state.processedData || gridInstance.originalData;
            var headerColumns = gridInstance.columns.filter(col =>
                !col.specialColumn && col.visible && col.field
            );

            // Get footer columns
            var footerColumns = detailcolumnsettings.filter(col => col.field);


            // Colors from gridui.js
            var METADATA_BG = "E0F2F1"; // Light Teal
            var HEADER_BG = "1A237E";   // Navy
            var HEADER_FG = "FFFFFF";   // White

            // Helper for styled cells
            var createStyledCell = (val, bgColor = "FFFFFF", fgColor = "000000", isBold = false) => {
                return {
                    v: val,
                    t: (typeof val === 'number') ? 'n' : 's',
                    s: {
                        fill: { fgColor: { rgb: bgColor } },
                        font: { color: { rgb: fgColor }, bold: isBold },
                        alignment: { vertical: "center" }
                    }
                };
            };

            // Create combined columns (Header fields + Footer fields)
            var combinedHeaders = [
                ...headerColumns.map(col => createStyledCell(col.header + " (H)", HEADER_BG, HEADER_FG, true)),
                ...footerColumns.map(col => createStyledCell(col.header + " (F)", HEADER_BG, HEADER_FG, true))
            ];

            // Create combined data rows
            var combinedDataRows = [];

            headerData.forEach(headerRow => {
                // Get all footer rows for this header row (all customer records)
                var relatedFooterRows = getHeadersFooterdataonly(headerRow);
                relatedFooterRows = Array.from(relatedFooterRows).flat();
                // Remove the first column (by property order)
                console.log("Footer data ", relatedFooterRows);
                if (relatedFooterRows.length > 0) {
                    var hidecolumns = detailcolumnsettings.filter(cl => cl.visible == false);
                    for (var i = 0; i < hidecolumns.length; i++) {
                        relatedFooterRows.forEach(row => {
                            delete row[hidecolumns[i].headerText];
                        });
                    }

                }
                if (relatedFooterRows.length === 0) {
                    // If no footer data, add header row with empty footer columns
                    var rowData = [
                        ...headerColumns.map(col => {
                            let value = headerRow[col.field];
                            if (typeof value === 'string' && value.includes('<')) {
                                var tempDiv = document.createElement('div');
                                tempDiv.innerHTML = value;
                                value = tempDiv.textContent || tempDiv.innerText || '';
                            }
                            return value ?? '';
                        }),
                        ...footerColumns.map(() => '')
                    ];
                    combinedDataRows.push(rowData);
                } else {
                    // For each footer row, duplicate the header data
                    relatedFooterRows.forEach(footerRow => {
                        var rowData = [
                            ...headerColumns.map(col => {
                                let value = headerRow[col.field];
                                if (typeof value === 'string' && value.includes('<')) {
                                    var tempDiv = document.createElement('div');
                                    tempDiv.innerHTML = value;
                                    value = tempDiv.textContent || tempDiv.innerText || '';
                                }
                                return value ?? '';
                            }),
                            ...footerColumns.map(col => footerRow[col.field] ?? '')
                        ];
                        combinedDataRows.push(rowData);
                    });
                }
            });

            // Create workbook
            var wb = XLSX.utils.book_new();

            // Create sheet data
            var sheetData = [];

            // Row 1: Company Name
            sheetData.push([
                createStyledCell("Company Name", METADATA_BG, "000000", true),
                createStyledCell(CompanyName, METADATA_BG)
            ]);

            // Row 2: Report Name
            sheetData.push([
                createStyledCell("Report Name", METADATA_BG, "000000", true),
                createStyledCell(ReportName + ' - Combined', METADATA_BG)
            ]);


            // Filter Data Rows (Two-column layout)
            fitersdata.forEach(filter => {
                sheetData.push([
                    createStyledCell(filter.FilterName, METADATA_BG, "000000", true),
                    createStyledCell(filter.Value, METADATA_BG)
                ]);
            });

            // Empty Row
            sheetData.push([]);

            var gridHeaderRowIndex = sheetData.length;

            // Combined Header Row
            sheetData.push(combinedHeaders);

            // Combined Data Rows
            sheetData.push(...combinedDataRows);

            var ws = XLSX.utils.aoa_to_sheet(sheetData);

            // Add autofilter to the combined grid data
            var range = XLSX.utils.decode_range(ws['!ref']);
            ws['!autofilter'] = {
                ref: XLSX.utils.encode_range({
                    s: { r: gridHeaderRowIndex, c: 0 },
                    e: { r: range.e.r, c: range.e.c }
                })
            };

            XLSX.utils.book_append_sheet(wb, ws, 'Combined Data');
            var now = new Date();
            var timestamp =
                now.getFullYear().toString() +
                String(now.getMonth() + 1).padStart(2, '0') +
                String(now.getDate()).padStart(2, '0') +
                String(now.getHours()).padStart(2, '0') +
                String(now.getMinutes()).padStart(2, '0') +
                String(now.getSeconds()).padStart(2, '0') +
                String(now.getMilliseconds()).padStart(3, '0');
            // Export
            XLSX.writeFile(wb, `${ReportName}_Combined_${timestamp}.xlsx`);
            console.log('Export Combined completed');
        } catch (error) {
            console.error('Export error:', error);
            alert('Export failed: ' + error.message);
        }
    }
