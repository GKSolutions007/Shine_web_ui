    // ========== PRINT FUNCTIONS ==========

    // Store grid instance globally for print
    let currentPrintGridInstance = null;

    // Show print options modal
    function showPrintOptionsModal(gridInstance) {
        currentPrintGridInstance = gridInstance;
        //document.getElementById('printOptionsModal').style.display = 'block';
        handlePrint();
    }

    // Close print modal
    function closePrintModal() {
        document.getElementById('printOptionsModal').style.display = 'none';
        // Reset to default selection
        document.querySelector('input[name="printType"][value="header"]').checked = true;
    }

    // Handle print based on selected option
    function handlePrint() {
        var selectedOption = document.querySelector('input[name="printType"]:checked').value;
        console.log('Print type selected:', selectedOption);
        selectedOption = 'header'
        if (!currentPrintGridInstance) {
            alert('Grid instance not found!');
            return;
        }
        var Excelfilter = [];
        var Col2Data = "";
        $('#tblFilterData tr td').each(function (i, items) {
            var insert = false;
            if (i % 2 == 0) {
                var lbl = items.firstChild.id;
                Col1Data = $("#" + lbl).text();
                //console.log("Col 1", Col2Data);
                insert = false;
            }
            else if (i % 2 == 1) {
                var input = items.firstChild.id;
                var inputtype = items.firstChild.type;
                var ifselval = inputtype == "select-one" && $("#" + input).val() > 0 ? $("#" + input + " option:selected").text() : "";
                Col2Data = inputtype == "checkbox" ? $("#" + input).is(":checked") ? 'True' : 'False' : inputtype == "select-one" ? ifselval : $("#" + input).val();
                insert = true;
            }
            if (insert) {
                var lst = {
                    FilterName: Col1Data,
                    Value: Col2Data
                };
                Excelfilter.push(lst);
            }
        });
        switch (selectedOption) {
            case 'header':
                printHeaderOnly(currentPrintGridInstance, Excelfilter);
                break;
            case 'footer':
                printFooterOnly(Excelfilter);
                break;
            case 'combined':
                printHeaderFooterCombined(currentPrintGridInstance, Excelfilter);
                break;
        }

        closePrintModal();
    }

    // ========== PRINT IMPLEMENTATION ==========

    function printHeaderOnly(gridInstance, fitersdata) {
        var ReportName = $("#MainHeading").text();
            console.log('Printing Header Only');
            var data = gridInstance.getCurrentData();
            var cols = gridInstance.columns.filter(c => !c.specialColumn && c.visible && c.field);
            var title = (ReportName || 'Grid Print');

        var content = generatePrintContent(title, data, cols, fitersdata);
            openPrintWindow(content);
        }

    function printFooterOnly(fitersdata) {
        var ReportName = $("#MainHeading").text();
            console.log('Printing Footer Only');
            if (!detailsGrid) {
                alert('Detail grid not available');
                return;
            }
            var data = detailsGrid.getCurrentData();
            var cols = detailcolumns.filter(c => c.field);
            var title = (ReportName || 'Grid Print') + " - Footer Details";

        var content = generatePrintContent(title, data, cols, fitersdata);
            openPrintWindow(content);
        }

    function printHeaderFooterCombined(gridInstance, fitersdata) {
        console.log('Printing Combined');
        var ReportName = $("#MainHeading").text();
            var headerData = gridInstance.getCurrentData();
            var headerCols = gridInstance.columns.filter(c => !c.specialColumn && c.visible && c.field);
            var footerCols = detailcolumns.filter(c => c.field);
            var title = (ReportName || 'Grid Print') + " - Combined View";

            // Build combined structure
            var rows = [];
            headerData.forEach(hRow => {
                var related = detailrows.filter(f => f['Customer Code'] === hRow['Customer Code']);
                if (related.length === 0) {
                    var combinedRow = { ...hRow };
                    footerCols.forEach(c => combinedRow['F_' + c.field] = '');
                    rows.push(combinedRow);
                } else {
                    related.forEach(fRow => {
                        var combinedRow = { ...hRow };
                        footerCols.forEach(c => combinedRow['F_' + c.field] = fRow[c.field]);
                        rows.push(combinedRow);
                    });
                }
            });

            // Combine columns for display
            var displayCols = [
                ...headerCols.map(c => ({ ...c, header: c.header + " (H)" })),
                ...footerCols.map(c => ({ ...c, field: 'F_' + c.field, header: c.header + " (F)" }))
            ];

        var content = generatePrintContent(title, rows, displayCols, fitersdata);
            openPrintWindow(content);
        }

    function generatePrintContent(title, data, columns, fitersdata) {
        console.log("Row Data ", data);
        console.log("columns Data ", columns)
            // Calculate Totals for columns with EnableSum: true
            var totals = {};
            var hasTotals = false;

            columns.forEach(c => {
                if (c.PrintYN && c.EnableSum === true) {
                    totals[c.field] = 0;
                    hasTotals = true;
                }
            });

            if (hasTotals) {
                data.forEach(row => {
                    columns.forEach(c => {
                        if (c.PrintYN && c.EnableSum === true) {
                            var val = parseFloat(row[c.field]);
                            if (!isNaN(val)) {
                                totals[c.field] += val;
                            }
                        }
                    });
                });
            }

            var html = `
                <html>
                <head>
                    <title>${title}</title>
                    <style>
                        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333; margin: 15mm; }
                        .report-header { margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid #1A237E; }
                        .company-name { font-size: 24px; font-weight: bold; color: #1A237E; margin: 0; }
                        .report-title { font-size: 18px; margin: 5px 0; color: #555; }
                        .filters-section { background: #f5f5f5; padding: 10px; margin-bottom: 20px; border-radius: 4px; border: 1px solid #ddd; }
                        .filters-title { font-weight: bold; margin-bottom: 5px; font-size: 14px; }
                        .filter-item { font-size: 12px; margin-bottom: 2px; display: inline-block; width: 45%; }

                        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; }
                        th { background-color: #1A237E !important; color: white !important; text-align: left; padding: 8px; border: 1px solid #ddd; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                        td { padding: 5px; border: 1px solid #ddd; color: #000; }
                        td { padding: 5px; border: 1px solid #ddd; color: #000; }
                        tr:nth-child(even) { background-color: #f9f9f9; }
                        .total-row td { font-weight: bold; background-color: #e0e0e0 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

                        @@page {
                            /* Hide browser default header (Time, Title, URL) by removing top margin */
                            margin-top: 5mm;
                            margin-bottom: 10mm;
                            margin-left: 5mm;
                            margin-right: 5mm;

                            @@bottom-right {
                                content: "Page " counter(page) " of " counter(pages);
                                font-size: 10px;
                            }
                        }

                        @@media print {
                            body { margin: 2mm; zoom: 80%; }
                            button { display: none; }

                            /* Page Numbering Fallback */
                            .page-number-header {
                                position: fixed;
                                bottom: 0;
                                right: 0;
                                font-size: 10px;
                                color: #555;
                                background-color: white;
                                padding: 5px;
                            }
                        }
                        .wrap-text {
    white-space: normal !important;
    word-break: break-word;
}
                    </style>
                </head>
                <body>
                    <!-- Fixed Header for Page Numbering -->
                    <div class="page-number-header">
                       
                    </div>

                    <div class="report-header">
                        <p class="company-name">${CompanyName}</p>
                        <p class="report-title">${title}</p>
                    </div>

                    <div class="filters-section">
                        <div class="filters-title">Report Filters:</div>
                        ${fitersdata.map(f => `
                            <div class="filter-item">
                                <strong>${f.FilterName}:</strong> ${f.Value}
                            </div>
                        `).join('')}
                    </div>

                    <table>
                        <thead>
                            <tr>
                                ${columns.map(c => {
                var width = c.PrintWidth ? (typeof c.PrintWidth === `number` ? (c.PrintWidth * 3.78) + `px` : c.PrintWidth) : `auto`;
                                    return c.PrintYN ? `<th class="wrap-text" style="max-width: ${width} !important;">${c.PrintColumnName}</th>` : '';
            }).join('')}
                            </tr>
                        </thead>
                        <tbody>
                            ${data.map(row => `
                                <tr>
                                    ${columns.map(c => {
                var val = row[c.field];
                // Strip HTML
                if (typeof val === `string` && val.includes('<')) {
                    var tmp = document.createElement('div');
                    tmp.innerHTML = val;
                    val = tmp.textContent || tmp.innerText;
                                        }
                                        var valucolor = val == `Total` ? `blue` : val == `Opening Balance` ? `brown` : val == `Closing Balance` ? `darkorange` : `black`;
                                        return c.PrintYN ? `<td class="wrap-text" style="color:` + valucolor +`" align=` + c.align+`>${val ?? ''}</td>` : '';
            }).join('')}
                                </tr>
                            `).join('')}

                            ${hasTotals ? `
                                <tr class="total-row">
                                    ${columns.map((c, index) => {
                                        if (!c.PrintYN) return '';

                if (c.EnableSum === true) {
                    var sum = totals[c.field] || 0;
                    return `<td>${sum.toFixed(2)}</td>`;
                } else if (index === 0 || (columns.filter(col => col.PrintYN)[0] === c)) {
                    // First printable column gets "Total" label
                    return `<td>Total</td>`;
                } else {
                    return `<td></td>`;
                }
            }).join('')}
                                </tr>
                            ` : ''}
                        </tbody>
                    </table>

                    <div class="no-print" style="margin-top: 20px; text-align: right;">
                        <!-- Manual button removed for direct printing -->
                    </div>
                </body>
                </html>
            `;
            return html;
        }

        function openPrintWindow(content) {
            // Create a hidden iframe for direct printing
            var iframe = document.createElement('iframe');
            iframe.style.visibility = 'hidden';
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            document.body.appendChild(iframe);

            var doc = iframe.contentWindow.document;
            doc.open();
            doc.write(content);
            doc.close();

            // Trigger print once content is loaded
            iframe.contentWindow.focus();
            setTimeout(() => {
                iframe.contentWindow.print();
                // Cleanup: remove the iframe after the print dialog opens
                setTimeout(() => {
                    document.body.removeChild(iframe);
                }, 1000);
            }, 500);
        }

        // Close modal when clicking outside
        window.onclick = function (event) {
            var expModal = document.getElementById('exportOptionsModal');
            var prntModal = document.getElementById('printOptionsModal');
            if (event.target === expModal) {
                closeExportModal();
            }
            if (event.target === prntModal) {
                closePrintModal();
            }
    }
