    function ProductPriceQtyChange(dQty, id = null, IdxType = 1, RIdx = 0) {
        var RowNo = IdxType == 1 ? nCurrentRowIndex : RIdx;
        var currrowdata = ProductTable.row(RowNo).data();
        var ProdID = currrowdata[0];
        //var id = e.target.id;
        var qty = dQty != "" ? parseFloat(dQty) : 0;//e.target.value != "" ? parseFloat(e.target.value) : 0;
        var dDiffGross = 0, dDiffNet = 0;
        $("#tblProductData tbody tr").each(function () {
            var rowdata = ProductTable.row($(this)).data();
            var RowIndex = ProductTable.row($(this)).index();
            var GridProdID = rowdata[0];
            var TaxPern = parseFloat(rowdata[2]);
            var TempBatchQty = parseFloat(rowdata[22]);
            var trkInv = parseFloat(rowdata[8]);
            var TP = (TaxPern / 100) + 1;
            var ExclPrice = 0, InclPrice = 0, dPTGross = 0, dPTTax = 0, dPTNet = 0, CFValue = 0;
            if (RowNo == RowIndex) {//ProdID == GridProdID
                //console.log("item wise");
                var ApponMRPCum = $(this).find("label[name='ApponMRPCum']").attr("lbltag") || 0;
                var TotMRPonTaxAmt = $(this).find("label[name='TotalMRPonTax']").attr("lbltag") || 1;
                if (qty == 0) {
                    $(this).find('td').css("background-color", "lightgrey");
                }
                else {
                    $(this).find('td').css("background-color", "white");
                }
                if (TempBatchQty >= qty || trkInv == 0) {//
                    $(this).find("select").each(function (index) {
                        const fieldName = $(this).attr("name");
                        const fieldID = $(this).attr("id");
                        if (fieldName == "UOM") {
                            var val = $('option:selected', this).attr('name');
                            CFValue = parseFloat(val);
                        }
                    });
                    $(this).find("input").each(function (index) {
                        const fieldName = $(this).attr("name");
                        const fieldID = $(this).attr("id");
                        if (fieldName == "Excl") {
                            ExclPrice = parseFloat($(this).attr("txttag"));
                        }
                        if (fieldName == "Incl") {
                            InclPrice = parseFloat($(this).attr("txttag"));
                        }                       
                    });
                    $(this).find("label").each(function (index) {
                        const fieldName = $(this).attr("name");
                        const fieldID = $(this).attr("id");
                        var price = (ExclPrice * qty);
                        
                        if (fieldName == "Gross") {
                            var grs = parseFloat(price);//;
                            //$(this).text(grs);
                            updateLabelColumn(fieldID, grs);
                            dPTGross = grs;
                        }
                        if (fieldName == "TaxAmt") {
                            var tamt = ApponMRPCum > 0 ? (qty * parseFloat(TotMRPonTaxAmt)) : ((TaxPern * dPTGross) / 100);//;
                            //$(this).text(tamt);
                            updateLabelColumn(fieldID, tamt);
                            dPTTax = tamt;
                        }
                        if (fieldName == "NetAmt") {
                            var neta = (parseFloat(dPTGross) + parseFloat(dPTTax));//;
                            //$(this).text(neta);
                            updateLabelColumn(fieldID, neta);
                            dPTNet = parseFloat($(this).text());
                        }
                    });
                    //updateInputColumn("txtDiffExcl", dDiffGross); updateInputColumn("txtDiffIncl", dDiffNet);
                }
                else {
                    if (id != null) {
                        updateInputColumn(id, 0);
                        showErrorSnackbar("Qty Mismatched. Qty should be less than Batch Qty only.")
                    }
                }
            }
        });
        calculateProdGrid();
    }
    function getSalesMRPontax(MRP) {
        var dTaxAmt = 0;
        var dApponMRPCum = arrSalesTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
        for (var i = 0; i < arrSalesTaxDetails.length; i++) {
            var nAppon = arrSalesTaxDetails[i].AppOn;
            var dCumTax = arrSalesTaxDetails[i].CumulativeTax;
            if (nAppon == -1) {
                var dPrice = (MRP / (1 + (dApponMRPCum / 100)));
                dTaxAmt += (dPrice * dCumTax) / 100;
            }
        }
        return dTaxAmt;
    }
