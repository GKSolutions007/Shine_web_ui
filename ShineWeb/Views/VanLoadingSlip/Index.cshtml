    //~Calculation
    function calculateProdGrid() {
        // Reset footer labels to zero
        $(".lblPT").text("0.00");
        const rowCount = ProductTable.rows().count();
        if (rowCount === 0) {            
            $("#cmbPriceType").prop("disabled", false);
            return;
        }

        // Accumulators
        let dPTQty = 0, dPTGoods = 0, dPTGross = 0, dPTTax = 0, dPTNet = 0;
        let TotProdDisc = 0, TotTradeDisc = 0, TotAddnlDisc = 0;
        let DiffExcl = 0, DiffIncl = 0;

        // Helper: read txttag/lbltag as float from any element
        const tag = (el, attr) => parseFloat(el?.getAttribute(attr) || 0) || 0;

        $("#tblProductData tbody tr").each(function () {
            const $row = $(this);
            const rowdata = ProductTable.row(this).data();
            const TaxPern = parseFloat(rowdata[2]) || 0;
            const tp = 1 + TaxPern / 100;

            // Read all inputs by name using txttag attribute
            const getInput = (name) => {
                const el = this.querySelector(`input[name="${name}"]`);
                return el ? tag(el, "txttag") : 0;
            };
            const getLabel = (name) => {
                const el = this.querySelector(`label[name="${name}"]`);
                return el ? tag(el, "lbltag") : 0;
            };

            const qty = getInput("Qty");            
            const gross = getLabel("Gross");
            const net = getLabel("NetAmt");

            dPTQty += qty;           
            dPTGoods += getLabel("Goods");
            dPTGross += gross;
            dPTTax += getLabel("TaxAmt");
            dPTNet += net;

            // UOM conversion factor
            const uomEl = this.querySelector("select[name='UOM'] option:checked");
            const cf = parseFloat(uomEl?.getAttribute("name") || 1) || 1;
            
            // Row highlight: grey if no net value
            $row.find("td").css("background-color", net === 0 ? "lightgrey" : "white");
        });

        // Footer totals
        updateLabelColumn("lblPTQty", dPTQty);        
        updateLabelColumn("lblPTGross", dPTGross);
        updateLabelColumn("lblPTTax", dPTTax);
        updateLabelColumn("lblPTNet", dPTNet);
        updateLabelColumn("lblTaxAmount", dPTTax);
        updateLabelColumn("lblCGST", dPTTax / 2);
        updateLabelColumn("lblSGST", dPTTax / 2);

      
        const roundedNet = ApplyRoundoff(dPTNet);
        updateInputColumn("txtRoundOff", roundedNet - dPTNet);
        updateLabelColumn("lblRoundNet", roundedNet);
        //updateLabelColumn("lblRoundNetFooter", roundedNet);
      
        // Item count
        $("#lblPTCount").text(rowCount);

        //Gross & Tot Disc Amt
        updateLabelColumn("lblGross", dPTGross);

        ProductTable.columns.adjust().draw();
        var itemrow = ProductTable.rows().count();
        $("#cmbPriceType").prop("disabled", itemrow > 0);
    }
    function ApplyRoundoff(dAmt) {
        var Value = 0;
        if (ConfigRoundtype == 1) {//nearest
            Value = Math.round(dAmt)
        }
        else if (ConfigRoundtype == 2) {//lowest
            Value = Math.floor(dAmt)
        }
        else if (ConfigRoundtype == 3) {//highest
            Value = Math.ceil(dAmt)
        }
        return Value;
    }
