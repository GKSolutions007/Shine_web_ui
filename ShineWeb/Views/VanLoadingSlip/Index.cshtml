    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>

    <div class="toastBox"></div>
    <div id="dvDocuments">
        <hr />
        <div class="w-100">
            <div class="row">
                <div class="col-12">
                    <div class="row align-items-end g-3">
                        <div class="col-12 col-md-4"></div>
                        <!-- Filters -->
                        <div class="col-12 col-md-8">
                            <table>
                                <tr>
                                    <td class="ps-2 p-0" width="20%">
                                        <span class="form-label">
                                            <select class="form-control FormclrcmbField" id="cmbFilterBranch">
                                                <option value="0">Select Branch</option>
                                            </select>
                                            <label class="labelup">Branch</label>
                                        </span>
                                    </td>

                                    <td class="ps-2 p-0" width="30%">
                                        <span class="form-label">
                                            <select class="form-control FormclrcmbField" id="cmbFilterSalesman">
                                            </select>
                                            <label class="labelup">Salesman</label>
                                        </span>
                                        <div id="divErrFSalesman" class="clrdivs text-danger pt-1 ps-1"></div>
                                    </td>

                                    <td class="ps-2 p-0" width="6%">
                                        <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                                    </td>

                                    <td class="p-0" width="10%">
                                        <span class="form-label">
                                            <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFFrom">
                                            <label class="labelup">From</label>
                                        </span>

                                        <div id="divErrFFrom" class="clrdivs text-danger pt-1 ps-1"></div>
                                    </td>

                                    <td class="ps-2 p-0" width="10%">
                                        <span class="form-label">
                                            <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFTo">
                                            <label class="labelup">To</label>
                                        </span>

                                        <div id="divErrFTo" class="clrdivs text-danger pt-1 ps-1"></div>
                                    </td>

                                    <td class="ps-2 p-0" width="7%">
                                        <input tabindex="1" class="FormfilterclrField" type="checkbox" id="chkShowAll">
                                        <label for="chkShowAll" class="fs-6">All Status</label>
                                    </td>

                                    <td class="ps-2 p-0" width="7%">
                                        <button id="btnFilter" class="btn btn-primary">
                                            Filter
                                        </button>
                                    </td>

                                </tr>
                            </table>

                        </div>

                    </div>

                </div>
            </div>

            <div id="my-grid" style="height:600px;width:100%;"></div>

        </div>
        <hr />
    </div>

    <div id="dvMain">
        <hr />

        <div class="container-fluid">
            <div class="row mt-2 align-items-start">
