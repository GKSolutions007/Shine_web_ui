                                        <option value="1">Rail</option>
                                        <option value="2">Air</option>
                                        <option value="3">Ship/Road cum ship</option>
                                    </select>
                                    <label class="labelup">Transport Mode</label>
                                </span>
                            </div>
                            <div>
                                <span class="form-label">
                                    <select class="form-control FormclrcmbField" id="cmbTransportType">
                                        <option value="0">Regular</option>
                                        <option value="1">ODC</option>
                                    </select>
                                    <label class="labelup">Transport Type</label>
                                </span>
                            </div>                           
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div style="display:grid;grid-template-columns:1.5fr 1.5fr 2fr;gap:13px 2px;padding-top:5px">

                            <div>
                                <span class="form-label">
                                    <input type="text" txttag="0" class="form-control FormclrField" id="txtTransportID" />
                                    <label class="labelup">Transport ID</label>
                                </span>
                            </div>
                            <div>
                                <span class="form-label">
                                    <input type="text" txttag="0" class="form-control FormclrField" id="txtTransportName" />
                                    <label class="labelup">Transport Name</label>
                                </span>
                            </div>
                            <div>
                                <span class="form-label">
                                    <label style="font-size: 14px; font-weight: 500; padding-left: 35px; padding-top: 3px" id="lblEWBNo">548132165655</label>
                                    <label class="labelup">E-Way Bill No :</label>
                                </span>                                
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Document Info -->
                <div class="col-12 col-md-2">
                    <div class="d-flex flex-column align-items-md-end">
                        <div class="d-flex align-items-center mb-2">
                            <span class="fw-semibold me-2">Doc ID :</span>

                            <span id="lblDocID"
                                  docprefix=""
                                  style="font-size:14px"
                                  class="fw-bolder">
                                --
                            </span>
                        </div>

                        <div class="d-flex align-items-center">
                            <span class="fw-semibold me-2">Date :</span>

                            <input class="clsdtpfieldbottomborder FormclrField"
                                   type="date"
                                   id="dtpDate"
                                   oninput="if (this.value > this.max) { this.value = this.max; }"
                                   placeholder="Date" />
                        </div>

                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrDate"></div>
                    </div>
                </div>

            </div>
        </div>

        <div>
            <hr />
            <input hidden id="txtHProdID" class="dtgFields" />
            <input hidden id="txtTaxPern" class="dtgFields" />
            <input hidden id="txtTaxName" class="dtgFields" />
            <input hidden id="txtTaxID" class="dtgFields" />
            <input hidden id="txtUOMName" class="dtgFields" />
            <input hidden id="txtUOMID" class="dtgFields" />
            <input hidden id="txtUOMCR" class="dtgFields" />
