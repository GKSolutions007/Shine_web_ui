                                if (!isSaveDisabled) {
                                    $("#btnSave").focus();
                                    $("#btnSave").select();
                                } else {
                                    $("#btnClose").focus();
                                    $("#btnClose").select();
                                }
                            }
                        }
                    }
                }
                else {
                    if (nextinp.length) {
                        var strType = nextinp[0].localName;
                        console.log("nextinp", nextinp)
                        if (strType != "button") {
                            nextinp.focus();
                            nextinp.select();
                        }
