                                <label class="labelup">Ref No</label>
                            </span>

                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrRefNo"></div>
                        </div>
                    </div>
                </div>

                <!-- Spacer -->
                <div class="col-12 col-md-5">
                    <div class="row">
                        <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:13px 2px;padding-top:5px">
                            <div>
                                <div class="input-group">
                                    <span id="openvehicle" class="input-group-text d-none" title="Add/Edit Vehicle">
