                        </span>

                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrBranch"></div>
                    </div>

                    <!-- Price Type -->
                    <div class="mb-3">
                        <span class="form-label w-100">
                            <select class="form-select FormclrcmbField" id="cmbPriceType">
                            </select>
                            <label class="labelup">Price Type *</label>
                        </span>
                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrPriceType"></div>
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="input-group">
                                <span id="opensalesman" class="input-group-text" title="Add/Edit Salesman">
