    var ProductArray = [];
    function addProdinArray() {
        ProductArray = [];
        let serial = 1;

        const getNum = (el, attr) => parseFloat($(el).attr(attr)) || 0;

        $("#tblProductData tbody tr").each(function () {

            const rowData = ProductTable.row(this).data();
            if (!rowData || !rowData[0]) return;

            const qty = getNum($(this).find("input[name='Qty']"), "txttag");
            if (qty <= 0) return;

            const uom = $(this).find("select[name='UOM']");
            const uomID = parseInt(uom.val()) || 0;

            ProductArray.push({
                ProdID: rowData[0],
                TaxID: rowData[1],
                TaxPern: rowData[2],
                OrgPrice: rowData[3],
                OrgUomID: rowData[4],
                BatchNo: rowData[5],
                PKD: rowData[6],
                Expiry: rowData[7],
                InvYN: rowData[8],
                BatchYN: rowData[9],
                PKDYN: rowData[10],
                SerialYN: rowData[11],
                QtyType: rowData[23],

                UomID: uomID,
                ConvFact: uom.find(":selected").attr("name"),

                UomQty: qty,
                MRP: getNum($(this).find("input[name='MRP']"), "txttag"),
                SalePrice: getNum($(this).find("input[name='Excl']"), "txttag"),

                GrossAmt: getNum($(this).find("label[name='Gross']"), "lbltag"),
                TaxAmt: getNum($(this).find("label[name='TaxAmt']"), "lbltag"),
                NetAmt: getNum($(this).find("label[name='NetAmt']"), "lbltag"),

                Serial: serial++
            });
        });
    }
