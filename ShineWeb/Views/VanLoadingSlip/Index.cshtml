                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="container-fluid pb-5 pt-2" style="padding-bottom:200px;">
            <div class="row">

                <div class="col-12 col-md-3"></div>

                <!-- Print Profile -->
                <div class="col-12 col-md-3">
                    <table class="table w-100">
                        <tr class="bgclrfortr">
                            <td style="border:none;" width="80%">
                                <span class="form-label">
                                    <select class="form-control" id="cmbPrintProfile">
                                        <option value="0">Select</option>
