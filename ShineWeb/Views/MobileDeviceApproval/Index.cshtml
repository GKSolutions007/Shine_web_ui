@{
    ViewBag.Title = "Mobile Device Approval";
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/Validation.js"></script>
<script src="~/Scripts/datatable.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>

<style>
    :root {
        --mda-primary: #4361ee;
        --mda-primary-dark: #3145c4;
        --mda-success: #2ec4b6;
        --mda-warning: #ff9f1c;
        --mda-danger: #e5383b;
        --mda-bg: #f4f6fb;
        --mda-card-radius: 14px;
    }

    #dvMainTable {
        animation: mdaFadeIn .45s ease both;
    }

    @@keyframes mdaFadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes mdaPop {
        0% {
            transform: scale(.85);
            opacity: 0;
        }

        60% {
            transform: scale(1.05);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes mdaPulseIcon {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.12);
        }
    }

    @@keyframes mdaShake {
        10%, 90% {
            transform: translateX(-1px);
        }

        20%, 80% {
            transform: translateX(2px);
        }

        30%, 50%, 70% {
            transform: translateX(-4px);
        }

        40%, 60% {
            transform: translateX(4px);
        }
    }

    @@keyframes mdaRowIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---------- Header ---------- */
    .mda-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 6px;
    }

        .mda-header .mda-header-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--mda-primary), var(--mda-primary-dark));
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 4px 10px rgba(67, 97, 238, .3);
        }

        .mda-header h4 {
            font-size: 16px !important;
            font-weight: 600;
            margin: 0;
            color: #2b2d42;
            letter-spacing: .2px;
        }

    /* ---------- Stat cards ---------- */
    .mda-stats-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(150px, 1fr));
        gap: 14px;
        margin: 16px 0 20px;
    }

    @@media (max-width: 900px) {
        .mda-stats-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .mda-stats-row {
            grid-template-columns: 1fr;
        }
    }

    .mda-stat-card {
        position: relative;
        background: #fff;
        border-radius: var(--mda-card-radius);
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 2px 10px rgba(20, 25, 60, .06);
        border: 1px solid #eef0f7;
        overflow: hidden;
        animation: mdaPop .4s ease both;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .mda-stat-card:nth-child(1) {
            animation-delay: .02s;
        }

        .mda-stat-card:nth-child(2) {
            animation-delay: .08s;
        }

        .mda-stat-card:nth-child(3) {
            animation-delay: .14s;
        }

        .mda-stat-card:nth-child(4) {
            animation-delay: .2s;
        }

        .mda-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(20, 25, 60, .12);
        }

        .mda-stat-card::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: .05;
            background: var(--mda-card-accent, var(--mda-primary));
        }

    .mda-stat-icon {
        flex: 0 0 auto;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #fff;
        background: var(--mda-card-accent, var(--mda-primary));
        transition: transform .25s ease;
    }

    .mda-stat-card:hover .mda-stat-icon {
        animation: mdaPulseIcon .6s ease;
    }

    .mda-stat-body {
        display: flex;
        flex-direction: column;
        z-index: 1;
    }

    .mda-stat-label {
        font-size: 11.5px;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #8a8fa3;
        font-weight: 600;
    }

    .mda-stat-value {
        font-size: 21px;
        font-weight: 700;
        color: #23263a;
        line-height: 1.15;
    }

    .mda-card-limit {
        --mda-card-accent: #4361ee;
    }

    .mda-card-total {
        --mda-card-accent: #7209b7;
    }

    .mda-card-active {
        --mda-card-accent: #2ec4b6;
    }

    .mda-card-deactive {
        --mda-card-accent: #e5383b;
    }

    /* ---------- Table ---------- */
    
    #tblMobileDevices_wrapper {
        animation: mdaFadeIn .5s ease .1s both;
    }

    table.dataTable.table-bordered {
        border-radius: 10px;
        overflow: hidden;
        border-collapse: separate !important;
        border-spacing: 0;
    }

    /* Header layout: sticky, bolder, spaced-out caps */
    .trclrforcolheader th {
        background: linear-gradient(135deg, var(--mda-primary), var(--mda-primary-dark));
        color: #fff;
        border-bottom: none !important;
        font-size: 12px !important;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: 5px 10px !important;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Table body font size */
    #tblMobileDevices {
        font-size: 14px;
    }

        #tblMobileDevices tbody td {
           /* padding: 10px 10px !important;*/
            vertical-align: middle;
            font-size: 13px;
        }

        #tblMobileDevices tbody tr {
            animation: mdaRowIn .3s ease both;
            transition: background-color .15s ease;
        }

            #tblMobileDevices tbody tr:hover {
                background-color: #dfe4ff;
            }

    /* ---------- Responsive ---------- */
    @@media (max-width: 768px) {
        .mda-header h4 {
            font-size: 15px !important;
        }

        #tblMobileDevices, .trclrforcolheader th {
            font-size: 12.5px !important;
        }

            #tblMobileDevices tbody td {
                font-size: 12.5px;
                padding: 8px 6px !important;
            }

        .mda-btn-icon {
            font-size: 11px;
            padding: 4px 8px;
        }
    }

    @@media (max-width: 480px) {
        .mda-header h4 {
            font-size: 14px !important;
        }

        .mda-header-icon {
            width: 28px;
            height: 28px;
            font-size: 14px;
        }

        #tblMobileDevices, .trclrforcolheader th {
            font-size: 11.5px !important;
        }

            #tblMobileDevices tbody td {
                font-size: 11.5px;
                padding: 6px 5px !important;
            }

        .mda-btn-icon {
            font-size: 10px;
            padding: 3px 6px;
            gap: 3px;
        }
    }

    .mda-btn-icon {
        border: none;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #fff;
        transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease;
    }

        .mda-btn-icon:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0,0,0,.15);
        }

        .mda-btn-icon:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .mda-btn-activate {
        background: linear-gradient(135deg, #2ec4b6, #21a99d);
    }

    .mda-btn-deactivate {
        background: linear-gradient(135deg, #e5383b, #c9262a);
    }

    /* ---------- Error popup modal ---------- */
    .mda-error-modal .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        animation: mdaShake .45s ease .1s both;
    }

    .mda-error-modal .modal-body {
        text-align: center;
        padding: 32px 26px 26px;
    }

    .mda-error-icon-wrap {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: rgba(229, 56, 59, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: mdaPop .4s ease both;
    }

        .mda-error-icon-wrap i {
            font-size: 32px;
            color: var(--mda-danger);
        }

    .mda-error-title {
        font-size: 17px;
        font-weight: 700;
        color: #23263a;
        margin-bottom: 6px;
    }

    .mda-error-message {
        font-size: 13.5px;
        color: #6c7086;
        margin-bottom: 0;
    }

    .mda-error-modal .modal-footer {
        border-top: none;
        justify-content: center;
        padding-bottom: 26px;
    }

    .mda-error-modal .btn-close-error {
        background: linear-gradient(135deg, var(--mda-danger), #c9262a);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 26px;
        font-weight: 600;
        font-size: 13px;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .mda-error-modal .btn-close-error:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(229, 56, 59, .35);
        }
</style>

<body>
    <div class="mda-header">
        <span class="mda-header-icon"><i class="fa fa-mobile"></i></span>
        <h4 class="mb-0" id="MainHeading">Mobile Device Approval</h4>
    </div>
    <hr />
    <div class="toastBox"></div>

    <div id="dvMainTable">

        <div class="mda-stats-row">
            <div class="mda-stat-card mda-card-limit">
                <span class="mda-stat-icon"><i class="fa fa-sliders"></i></span>
                <div class="mda-stat-body">
                    <span class="mda-stat-label">Device Limit</span>
                    <span class="mda-stat-value" id="dvDeviceLimit">0</span>
                </div>
            </div>

            <div class="mda-stat-card mda-card-total">
                <span class="mda-stat-icon"><i class="fa fa-mobile"></i></span>
                <div class="mda-stat-body">
                    <span class="mda-stat-label">Total Devices</span>
                    <span class="mda-stat-value" id="dvTotalDevice">0</span>
                </div>
            </div>

            <div class="mda-stat-card mda-card-active">
                <span class="mda-stat-icon"><i class="fa fa-check-circle"></i></span>
                <div class="mda-stat-body">
                    <span class="mda-stat-label">Active Devices</span>
                    <span class="mda-stat-value" id="dvActiveDevice">0</span>
                </div>
            </div>

            <div class="mda-stat-card mda-card-deactive">
                <span class="mda-stat-icon"><i class="fa fa-download"></i></span>
                <div class="mda-stat-body">
                    <span class="mda-stat-label">New Request</span>
                    <span class="mda-stat-value" id="dvDeactiveDevice">0</span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="table-responsive">
                <table class="table table-bordered" id="tblMobileDevices" width="100%">
                    <thead>
                        <tr class="trclrforcolheader">
                            <th style="text-align:center;width:5%;">#</th>
                            <th style="text-align:left;width:35%;">User Name</th>
                            <th style="text-align:center;width:15%;">Mobile No</th>
                            <th style="text-align:center;width:20%;">Device Name</th>
                            <th style="text-align:center;width:10%;">Activate</th>
                            <th style="text-align:center;width:15%;">De-Activate</th>
                            <th style="text-align:center;width:0%;">AndroidID</th>
                            <th style="text-align:center;width:0%;">UserID</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    <!-- Error popup modal -->
    <div class="modal fade mda-error-modal" id="mdaErrorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="mda-error-icon-wrap">
                        <i class="fa fa-exclamation-triangle"></i>
                    </div>
                    <div class="mda-error-title">Unable to Activate Device</div>
                    <p class="mda-error-message" id="mdaErrorMessage">Reached Max limit.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-close-error" data-bs-dismiss="modal">OK, Got it</button>
                </div>
            </div>
        </div>
    </div>
</body>
<script type="text/javascript">
    var Table = $('#tblMobileDevices').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        "bFilter": true,
        "bSearchable": true,
        "bInfo": true,
        "bPaginate": false,
        "ordering": false,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [6,7], "visible": false }],
    });

    var Aurl = '@Session["APIurl"]';
    var arrData = [];
    var UID = '@Session["LoginUserID"]';
    var RID = '@Session["RoleID"]';
    var nMode = 1;
    var FID = 1;// $("#txtFormID").val();
    InitiateData();

    // Animated count-up for the stat cards
    function animateCount(elementId, endValue) {
        var $el = $("#" + elementId);
        var start = 0;
        var end = parseInt(endValue, 10) || 0;
        if (end === 0) { $el.text(0); return; }
        var duration = 500;
        var stepTime = Math.max(Math.floor(duration / Math.max(end, 1)), 20);
        var current = start;
        var timer = setInterval(function () {
            current++;
            $el.text(current);
            if (current >= end) {
                clearInterval(timer);
                $el.text(end);
            }
        }, stepTime);
    }

    // Shows the error popup with an icon instead of a toast
    function showErrorPopup(message) {
        $("#mdaErrorMessage").text(message || "Reached Max limit.");
        var modalEl = document.getElementById('mdaErrorModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
    }

    function InitiateData() {
        Table.clear().draw(); Table.clear().draw();
        $.ajax({
            url: Aurl + "MobileDeviceApproval/get",
            type: 'GET',
            datatype: 'json',
            data: { Mode: 1 },//, nMode: 4, nDeviceID: "", nUserID: "", nDBs: ""   Connection: StrCon
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                //dvDeviceLimit,dvTotalDevice,dvActiveDevice,dvDeactiveDevice
                console.log("data ", data);
                $("#dvDeviceLimit").html(data[0].DeviceCount);     
                animateCount("dvActiveDevice", 0);
                animateCount("dvDeactiveDevice", 0);
                animateCount("dvTotalDevice", data[0].Devicelist.length);
                if (data[0].Devicelist.length > 0) {                   
                    var actcount = data[0].Devicelist.filter(it => it.Activate == "True").length;
                    var deactcount = data[0].Devicelist.filter(it => it.Activate == "False").length;
                    animateCount("dvActiveDevice", actcount);
                    animateCount("dvDeactiveDevice", deactcount);
                    $.each(data[0].Devicelist, function (i, items) {
                        var IsAct = items.Activate == "False" ? "" : "disabled";
                        var btncls = items.Activate == "False" ? "mda-btn-activate" : "mda-btn-activate";
                        var activeclass = items.Activate == "True" ? "fa fa-check-circle" : "fa fa-check"
                        Table.row.add([
                            (i + 1),
                            items.UserName,
                            items.MobileNo,
                            items.DeviceName,//fa fa-check-circle
                            '<button class="mda-btn-icon ' + btncls + ' btnActivates" ' + IsAct + '><i class="' + activeclass + '"></i> Activate' + (items.Activate == "True" ?"d":"")+'</button>',
                            '<button class="mda-btn-icon mda-btn-deactivate btnDeActivates"><i class="fa fa-ban"></i> De-Activate</button>',
                            items.DeviceID,
                            items.UserID
                        ]).draw(false);
                    });
                }
                else {
                    showErrorSnackbar("No devices found");
                }
            }
        });
    }
    $('#tblMobileDevices tbody').on('click', 'button.btnActivates', function () {
        rowdata = Table.row($(this).parents('tr')).data();
        ActiveandDeActivateUser(5, rowdata[6], rowdata[7]);
    });
    $('#tblMobileDevices tbody').on('click', 'button.btnDeActivates', function () {
        rowdata = Table.row($(this).parents('tr')).data();
        ActiveandDeActivateUser(6, rowdata[6], rowdata[7]);

    });
    function ActiveandDeActivateUser(Mode, DeviceID, UserID)
    {
        $.ajax({
            url: Aurl + "MobileDeviceApproval/save",
            type: 'GET',
            datatype: 'json',
            data: { nMode: Mode, nDeviceID: DeviceID, nUserID: UserID },//
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (Mode == 5) {
                    $.each(data, function (i, items) {
                        if (items.MsgID == "0") {//Success
                            showSuccessSnackbar("Activated Successfully.!!!");
                            setTimeout(() => {
                                InitiateData();
                            }, 300);
                        } else {//Error(Reached Max limit) - shown in popup with icon
                            showErrorPopup(items.Message);
                        }
                    });

                }
                else {
                    showSuccessSnackbar("De-Activated Successfully.!!!");
                    setTimeout(() => {
                        InitiateData();
                    }, 300);
                }
            }
        });
    }
</script>
