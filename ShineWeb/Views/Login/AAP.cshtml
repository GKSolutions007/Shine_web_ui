@{    
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Action Activated Successfully</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        /* ===== Design tokens ===== */
        :root {
            --ink: #1c1830;
            --muted: #6b6480;
            --card-bg: rgba(255,255,255,0.62);
            --card-border: rgba(255,255,255,0.85);
            --flame: #ea4b26;
            --flame-2: #ff7a4d;
            --bolt: #4d6df7;
            --bolt-2: #7b93ff;
            --bg-1: #fdf6f1;
            --bg-2: #eef1ff;
            --ring-track: rgba(28,24,48,0.09);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: var(--ink);
            overflow: hidden;
            position: relative;
            background: radial-gradient(circle at 15% 20%, var(--bg-1), transparent 55%), radial-gradient(circle at 85% 80%, var(--bg-2), transparent 55%), linear-gradient(135deg, #fbf8f4 0%, #f2f0fb 100%);
            background-size: 200% 200%;
            animation: bgShift 16s ease-in-out infinite;
        }

        @@keyframes bgShift {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        /* ===== Floating blobs ===== */
        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.45;
            z-index: 0;
            pointer-events: none;
        }

            .blob.b1 {
                width: 380px;
                height: 380px;
                background: linear-gradient(135deg, var(--flame), var(--flame-2));
                top: -120px;
                left: -100px;
                animation: floatA 13s ease-in-out infinite;
            }

            .blob.b2 {
                width: 420px;
                height: 420px;
                background: linear-gradient(135deg, var(--bolt), var(--bolt-2));
                bottom: -140px;
                right: -120px;
                animation: floatB 15s ease-in-out infinite;
            }

            .blob.b3 {
                width: 220px;
                height: 220px;
                background: linear-gradient(135deg, var(--bolt-2), var(--flame-2));
                top: 40%;
                right: 8%;
                opacity: 0.3;
                animation: floatC 11s ease-in-out infinite;
            }

        @@keyframes floatA {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(40px,60px) scale(1.08);
            }
        }

        @@keyframes floatB {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(-50px,-40px) scale(1.1);
            }
        }

        @@keyframes floatC {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(-30px,30px) scale(0.9);
            }
        }

        /* ===== Card ===== */
        .card {
            position: relative;
            z-index: 2;
            width: min(450px, 90vw);
            padding: 48px 36px 36px;
            text-align: center;
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 28px;
            backdrop-filter: blur(22px) saturate(160%);
            -webkit-backdrop-filter: blur(22px) saturate(160%);
            box-shadow: 0 30px 60px -20px rgba(28,24,48,0.25), 0 8px 20px -8px rgba(28,24,48,0.12), inset 0 1px 0 rgba(255,255,255,0.6);
            opacity: 0;
            transform: translateY(30px) scale(0.94);
            animation: cardIn 0.8s cubic-bezier(.22,1,.36,1) 0.15s forwards;
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }

            .card:hover {
                transform: translateY(0) scale(1.015);
                box-shadow: 0 40px 70px -20px rgba(28,24,48,0.3), 0 10px 24px -8px rgba(28,24,48,0.16), inset 0 1px 0 rgba(255,255,255,0.7);
            }

        @@keyframes cardIn {
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ===== Success icon ===== */
        .icon-wrap {
            position: relative;
            width: 96px;
            height: 96px;
            margin: 0 auto 22px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .icon-glow {
            position: absolute;
            inset: -14px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(234,75,38,0.35), rgba(77,109,247,0.25) 60%, transparent 75%);
            filter: blur(10px);
            animation: pulseGlow 2.4s ease-in-out infinite;
        }

        @@keyframes pulseGlow {
            0%, 100% {
                transform: scale(1);
                opacity: 0.8;
            }

            50% {
                transform: scale(1.18);
                opacity: 1;
            }
        }

        .icon-wrap i {
            font-size: 64px;
            background: linear-gradient(135deg, var(--flame), var(--bolt));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            position: relative;
            z-index: 1;
            opacity: 0;
            transform: scale(0.3);
            animation: iconBounce 0.9s cubic-bezier(.34,1.56,.64,1) 0.5s forwards;
        }

        @@keyframes iconBounce {
            0% {
                opacity: 0;
                transform: scale(0.3) rotate(-15deg);
            }

            60% {
                opacity: 1;
                transform: scale(1.15) rotate(4deg);
            }

            100% {
                opacity: 1;
                transform: scale(1) rotate(0deg);
            }
        }

        h1 {
            margin: 0 0 10px;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.01em;
            background: linear-gradient(120deg, var(--flame) 0%, #b64b8f 45%, var(--bolt) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        p.desc {
            margin: 0 0 26px;
            font-size: 0.98rem;
            line-height: 1.55;
            color: var(--muted);
        }

        /* ===== Timer ring ===== */
        .timer-label {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--muted);
            margin-bottom: 12px;
            font-weight: 600;
        }

        .ring-wrap {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 8px;
            animation: ringPulse 2s ease-in-out infinite;
        }

        @@keyframes ringPulse {
            0%, 100% {
                filter: drop-shadow(0 0 0 rgba(77,109,247,0));
            }

            50% {
                filter: drop-shadow(0 0 10px rgba(77,109,247,0.35));
            }
        }

        .ring-wrap svg {
            transform: rotate(-90deg);
        }

        .ring-track {
            stroke: var(--ring-track);
        }

        .ring-progress {
            stroke: url(#ringGradient);
            stroke-linecap: round;
            transition: stroke-dashoffset 1s linear;
        }

        .ring-count {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 700;
            color: var(--ink);
        }

            .ring-count span {
                display: inline-block;
                animation: countPop 0.5s ease;
            }

        @@keyframes countPop {
            0% {
                transform: scale(0.6);
                opacity: 0;
            }

            60% {
                transform: scale(1.15);
                opacity: 1;
            }

            100% {
                transform: scale(1);
            }
        }

        .prep-text {
            margin: 14px 0 28px;
            font-size: 0.85rem;
            color: var(--muted);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .dots span {
            animation: dotBlink 1.4s infinite;
            opacity: 0;
        }

            .dots span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .dots span:nth-child(3) {
                animation-delay: 0.4s;
            }

        @@keyframes dotBlink {
            0%, 100% {
                opacity: 0;
            }

            50% {
                opacity: 1;
            }
        }

        /* ===== Button ===== */
        .btn-login {
            appearance: none;
            border: none;
            cursor: pointer;
            width: 100%;
            padding: 14px 20px;
            font-size: 0.95rem;
            font-weight: 600;
            color: #fff;
            border-radius: 14px;
            background: linear-gradient(120deg, var(--flame) 0%, var(--bolt) 100%);
            box-shadow: 0 12px 24px -8px rgba(77,109,247,0.5);
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 16px 30px -8px rgba(77,109,247,0.6);
                filter: brightness(1.05);
            }

            .btn-login:active {
                transform: translateY(0);
            }

            .btn-login:focus-visible {
                outline: 3px solid var(--bolt-2);
                outline-offset: 3px;
            }

        footer {
            margin-top: 26px;
            font-size: 0.72rem;
            color: var(--muted);
            opacity: 0.8;
        }

        @@media (max-width:480px) {
            .card {
                padding: 38px 24px 28px;
                border-radius: 22px;
            }

            h1 {
                font-size: 1.3rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>

    <!-- Ambient floating gradient blobs -->
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="blob b3" aria-hidden="true"></div>

    <main class="card" role="main" aria-labelledby="successHeading">

        <!-- Success icon -->
        <div class="icon-wrap" aria-hidden="true">
            <div class="icon-glow"></div>
            <img style="height: 100px;width:130px;" src="data:image/png;base64," alt="" width="559" height="447" />

        </div>

        <h1 id="successHeading"><i class="fa-solid fa-circle-check"></i> Account Activated Successfully</h1>
        <p class="desc">
            Your action has been activated successfully. You will be redirected to the Login page shortly.
        </p>

        <div class="timer-label">Redirecting in</div>

        <!-- Circular countdown timer -->
        <div class="ring-wrap" role="timer" aria-live="polite" aria-label="Redirecting in 5 seconds">
            <svg width="120" height="120" viewBox="0 0 120 120">
                <defs>
                    <linearGradient id="ringGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#ea4b26" />
                        <stop offset="100%" stop-color="#4d6df7" />
                    </linearGradient>
                </defs>
                <circle class="ring-track" cx="60" cy="60" r="52" fill="none" stroke-width="8" />
                <circle id="ringProgress" class="ring-progress" cx="60" cy="60" r="52" fill="none" stroke-width="8"
                        stroke-dasharray="326.7" stroke-dashoffset="0" />
            </svg>
            <div class="ring-count"><span id="countText">5</span></div>
        </div>

        <p class="prep-text">
            Preparing your login<span class="dots"><span>.</span><span>.</span><span>.</span></span>
        </p>

        <button class="btn-login" id="loginNowBtn" aria-label="Go to Login page now">
            Go to Login Now
        </button>

        <footer>&copy; 2026 Your Company. All rights reserved.</footer>
    </main>

    <script>
        // ===== Config =====
        var url = '@Session["url"]';
        const TOTAL_SECONDS = 5;
        const REDIRECT_URL = url.toLowerCase().replace("login/aap", "");

        // ===== Elements =====
        const countText = document.getElementById('countText');
        const ringProgress = document.getElementById('ringProgress');
        const loginNowBtn = document.getElementById('loginNowBtn');

        // Circle circumference: 2 * PI * r (r=52)
        const CIRCUMFERENCE = 2 * Math.PI * 52;
        ringProgress.style.strokeDasharray = CIRCUMFERENCE;
        ringProgress.style.strokeDashoffset = 0;

        let secondsLeft = TOTAL_SECONDS;

        // Update the ring offset so it visually depletes as time passes
        function updateRing(secondsRemaining) {
            const fraction = secondsRemaining / TOTAL_SECONDS;
            const offset = CIRCUMFERENCE * (1 - fraction);
            ringProgress.style.strokeDashoffset = offset;
        }

        // Animate the number swap with a small pop
        function updateCountText(value) {
            countText.textContent = value;
            countText.style.animation = 'none';
            // Force reflow so the animation restarts
            void countText.offsetWidth;
            countText.style.animation = 'countPop 0.5s ease';
        }

        // Redirect helper
        function goToLogin() {
            window.location.href = REDIRECT_URL;
        }

        // Initialize ring to full immediately (starts at 5, full circle)
        updateRing(secondsLeft);

        // Countdown interval — ticks once per second
        const countdownInterval = setInterval(() => {
            secondsLeft -= 1;

            if (secondsLeft <= 0) {
                clearInterval(countdownInterval);
                updateCountText(0);
                updateRing(0);
                goToLogin();
                return;
            }

            updateCountText(secondsLeft);
            updateRing(secondsLeft);
        }, 1000);

        // Manual immediate redirect
        loginNowBtn.addEventListener('click', () => {
            clearInterval(countdownInterval);
            goToLogin();
        });

        // Keyboard accessibility: Enter/Space triggers button (native button already supports this,
        // included here for explicitness/robustness)
        loginNowBtn.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                loginNowBtn.click();
            }
        });
    </script>

</body>
</html>
