    function ValidateTypeSelection(Value) {
        var SelID = Value;
        $('#cmbMode').find("option").remove();
        $("#cmbSalesman,#cmbMode,#cmbChequeNo,#cmbToAccount,#txtNEFT").prop("disabled", true);
        if (SelID == 1) {// cash depp
            $('#cmbMode').append($('<option/>', {
                value: 0,
                text: "-- Select --",
            }));
            $("#txtNEFT,#cmbChequeNo,#cmbToAccount,#cmbMode").prop("disabled", true);
            $("#cmbSalesman").prop("disabled", false);
        }
        else if (SelID == 2) {// cash withdraw
            $("#txtNEFT,#cmbToAccount").prop("disabled", true);
            $("#cmbSalesman,#cmbMode,#cmbChequeNo").prop("disabled", false);
            var md = arrModeData.filter(t => t.Mode == SelID);
            for (var i = 0; i < md.length; i++) {
                $('#cmbMode').append($('<option/>', {
                    value: md[i].ID,
                    text: md[i].Name,
                }));
            }
            var selval = $('#cmbMode').val();
            if (selval == 2) {
                var id = $("#txtID").val() != "" ? $("#txtID").val() : "0"
                GetData(4, $('#cmbFromAccount').val(), id);
                $("#cmbChequeNo").prop("disabled", false);
                $("#txtNEFT").prop("disabled", true);
            }
        }
        else if (SelID == 3) {// bank trans
            $("#cmbSalesman,#cmbMode,#cmbToAccount,#txtNEFT").prop("disabled", false);
            var md = arrModeData.filter(t => t.Mode == SelID);
            for (var i = 0; i < md.length; i++) {
                $('#cmbMode').append($('<option/>', {
                    value: md[i].ID,
                    text: md[i].Name,
                }));
            }

            var selval = $('#cmbMode').val();
            if (selval == 2) {
                var id = $("#txtID").val() != "" ? $("#txtID").val() : "0"
                GetData(4, $('#cmbFromAccount').val(), id);
                $("#cmbChequeNo").prop("disabled", false);
                $("#txtNEFT").prop("disabled", true);
            }

        }
        else if (SelID == 4) {// branch trans
            $('#cmbMode').append($('<option/>', {
                value: 0,
                text: "-- Select --",
            }));
            $("#cmbSalesman,#cmbMode,#cmbChequeNo,#cmbToAccount,#txtNEFT").prop("disabled", true);
        }
        else {
            $('#cmbMode').append($('<option/>', {
                value: 0,
                text: "-- Select --",
            }));
            $("#cmbSalesman,#cmbMode,#cmbChequeNo,#cmbToAccount,#txtNEFT").prop("disabled", false);
        }
        if (nTransMode == 5 || nTransMode == 4) {
            $("#cmbSalesman,#cmbMode,#cmbChequeNo,#cmbToAccount,#txtNEFT").prop("disabled", true);
        }
    }
