    function ReloadF8Autolistdata(strForm, strSub, strValue, strAssignValue) {
        console.log("ReloadF8Autolistdata CALLED");
        console.log("Parameters:", strForm, strSub, strValue, strAssignValue);
        $.ajax({
            url: Aurl + "masterlist",
            type: 'get',
            contentType: 'json',
            data: {
                FormName: strForm, SubField: strSub, Value: strValue
            },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                //console.log("MASTERLIST RESPONSE:", data);
                //console.log("MASTERLIST RESPONSE JSON:", JSON.stringify(data));

                if (strSub == "fromaccountno" || strSub == "toaccountno") {
                    var from = $("#cmbFromAccount").val();
                    var to = $("#cmbToAccount").val();

                    $('#cmbFromAccount,#cmbToAccount').find("option").remove();
                    $('#cmbFromAccount,#cmbToAccount').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrAccountData = [];
                    $.each(data, function (i, items) {
                        //console.log("Adding item:", items);
                        //var optionText = items.AccountNo ? items.AccountNo : items.Name;
                        //$('#cmbFromAccount,#cmbToAccount').append($('<option/>', {
                        //    value: items.ID,
                        //    text: optionText
                        //}));
                        var BADetails = (items.Name).split('|');
                        $('#cmbFromAccount,#cmbToAccount').append($('<option/>', {
                            value: BADetails[6],
                            text: BADetails[0],
                        }));
                        var BAInfo = {
                            "ID": items.ID,
                            "AccNo": BADetails[0],
                            "Bank": BADetails[1],
                            "Branch": BADetails[2],
                            "IFSC": BADetails[3],
                            "MICR": BADetails[4],
                            "DefYN": BADetails[5],
                            "BaID": BADetails[6]
                        }
                        if (BADetails[5] == "1") {
                            DefBankAcc = items.ID;
                        }
                        arrAccountData.push(BAInfo);
                        //$('#cmbFromAccount').val(strAssignValue);
                        //$("#cmbToAccount").val(strAssignValue);

                    });
                    if (strSub == "fromaccountno") {
                        $('#cmbFromAccount').val(strAssignValue).trigger('change');
                        $("#cmbToAccount").val(to).trigger('change');
                    }
                    else {
                        $("#cmbToAccount").val(strAssignValue).trigger('change');
                        $("#cmbFromAccount").val(from).trigger('change');
                    }
                }
                else if (strForm == "salesman") {
                    $("#cmbSalesman").find("option").remove();
                    $('#cmbSalesman').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        console.log("Adding item:", items);
                        var optionText = items.Name;
                        $('#cmbSalesman').append($('<option/>', {
                            value: items.ID,
                            text: optionText
                        }));
                        $('#cmbSalesman').val(strAssignValue);
                    });
                }

            }
        });
    }

    //~Save
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var nStatus = $("#txtStatus").val() !== "" ? $("#txtStatus").val() : 1;

        var lstMaster = {
            "TransID": FID,
            "TransMode": nTransMode,
            "ID": $("#txtID").val(),
            "DocDate": $("#dtpDate").val(),
            "RefNo": $("#txtRefNo").val(),
            "BranchID": $("#txtBranchName").val(),
            "PartyID": $("#cmbFromAccount").val(),
            "FAID": $("#cmbToAccount").val(),
            "NoteValue": document.getElementById("txtValue").getAttribute("txttag"),//ReturnTagValue("txtValue",""),// $("#txtValue").val(),
            "Remark": $("#txtRemarks").val(),
            "Narration": $("#txtNarration").val(),
            "UDFId": $("#cmbUDN").val(),

            "ContType": $("#cmbType").val(),
            "ContMode": $("#cmbMode").val(),
            "ChequeNo": $("#cmbChequeNo").val() > 0 ? $("#cmbChequeNo option:selected").text() : "",
            "NEFTNo": $("#txtNEFT").val(),
            "Salesman": $("#cmbSalesman").val(),

            "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : nStatus,
            "CurrentStatus": nStatus,
            "CBy": UID
        };
            $.ajax({
                url: Aurl + "contra/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (nTransMode != 4) {
                                if (allowprint == 1) {
                                    PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                } else if (allowprint == 3 || allowprint == 4) {
                                    PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                }
                                if (SendAutoMail == 1) {
                                    EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                }
                            }
                            ClearForm();
                            GetFilterData();
                            modal.hide();
                        }
                        else if (items.Message == "AccountName") {
                            $("#dvErrorName").html("Account Name Already Exists in another master");
                            showErrorSnackbar("Account Name Already Exists in another master");
                        }
                        else if (items.Message == "Cheque") {
                            $("#divErrChequeNo").html("Cheque status already changed");
                            showErrorSnackbar("Cheque status already changed");
                        }
                        else {
                            //$("#divErrorOnCode").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }

    function BankInfoDialogMsg(message) {
        var IsAccepted = false;
        $(".ui-dialog-titlebar-close").hide();
        $('<div></div>').appendTo('body')
            .html('<div><h6>' + message + '</h6></div>')
            .dialog({
                modal: true,
                closeOnEscape: true,
                title: 'Bank Info',
                zIndex: 100,
                autoOpen: true,
                width: '400px',
                resizable: true,
                close: false,
                open: function () {
                    $(this).closest(".ui-dialog")
                        .find(".ui-dialog-titlebar-close")
                        .removeClass("ui-dialog-titlebar-close")
                        .html("x");
                },
                buttons: [
                    {
                        text: "Close",
                        class: "btn btn-warning clsclrNo",
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                ],
            });
        $(".clsclrNo").focus();
    };
