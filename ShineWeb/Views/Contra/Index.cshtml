@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";

}
@*<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />*@
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>
    td {
        font-size: 11px;
    }

    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 70%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            /*overflow: auto;*/
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 5px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            /*overflow: auto;*/
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -65%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
        z-index: 27;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -30%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 1em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .tooltip {
        position: relative;
        display: inline-block;
        border-bottom: 1px dotted black;
    }

        .tooltip .tooltiptext {
            visibility: hidden;
            width: 120px;
            background-color: black;
            color: #fff;
            text-align: center;
            border-radius: 6px;
            padding: 5px 0;
            /* Position the tooltip */
            position: absolute;
            z-index: 1;
        }

        .tooltip:hover .tooltiptext {
            visibility: visible;
        }
</style>
<style>
    /* Align dropdown in DataTable cell */
    .action-dropdown {
        min-width: 100px;
        font-size: 12px;
        z-index: 1000;
        text-align: left;
    }

        /* Optional: Add hover effect */
        .action-dropdown > li > a {
            padding: 3px 12px;
            color: #333;
            text-decoration: none;
        }

            .action-dropdown > li > a:hover {
                background-color: #f5f5f5;
                color: #000;
            }

    /* Optional: Make dropdown button minimal */
    .dropdown-toggle {
        background-color: transparent !important;
        border: none !important;
        font-size: 15px;
        line-height: 1;
        padding: 2px 5px;
    }

        .dropdown-toggle::after {
            display: none;
        }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.Variant, new { @autocomplete = "off", @class = "form-control", @id = "txtVariantID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.Cancel, new { @autocomplete = "off", @class = "form-control", @id = "txtCancelID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.FormID, new { @autocomplete = "off", @class = "form-control", @id = "txtFormID" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })
    <input hidden id="txtStatus" />
    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <div class="toastBox"></div>
    <div id="dvMainTable">
        <hr />
        <div class="row text-end mb-3">
            <!-- Blank -->
            <div class="col-12 col-md-2"></div>
            <!-- Branch (NEW) -->
            <div class="col-12 col-md-2">
                <span class="form-label">
                    <select class="form-control FormfilterclrField" id="cmbFilterBranch">
                        <option value="0">Select Branch</option>
                    </select>
                    <label class="labelup">Branch</label>
                </span>
            </div>
            <!--Account No -->
            <div class="col-12 col-md-2">
                <span class="form-label">
                    <select tabindex="5" class="form-control FormclrcmbField" id="cmbFilterAccount"><option value="0">Select</option></select>
                    <label class="labelup" for="txtCode">Account No</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFilterAccount"></div>
            </div>
            <!-- Period -->
            <div class="col-12 col-md-1">
                <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
            </div>
            <!-- From Date -->
            <div class="col-12 col-md-1">
                <span class="form-label">
                    <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFFrom" placeholder="" oninput="javascript: if (this.value > this.max) { this.value = this.max; }">
                    <label class="labelup" for="txtCode"> From</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFFrom"></div>
            </div>
            <!-- To Date -->
            <div class="col-12 col-md-1">
                <span class="form-label">
                    <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFTo" placeholder="" oninput="javascript: if (this.value > this.max) { this.value = this.max; }">
                    <label class="labelup" for="txtCode"> To</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFTo"></div>
            </div>
            <!-- All Status-->
            <div class="col-12 col-md-1">
                <input tabindex="1" style="font-size:14px;" class="FormfilterclrField" type="checkbox" id="chkShowAll">
                <label for="chkShowAll" style="font-size:14px;">All Status</label>
            </div>
            <!--Filter-->
            <div class="col-12 col-md-1">
                <button id="btnFilter" class="btn btn-primary ps-2"><span class="glyphicon glyphicon-filter" style="color: white"></span>&#x2009;Filter</button>
            </div>
        </div>
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>

    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div class="row" style="padding-top:2px; width:100%">
                        <!-- Branch -->
                        <div class="col-12 col-md-3">
                            <table>
                                <tr>
                                    <td colspan="2">
                                        <span class="form-label">
                                            <select class="form-control FormclrcmbField" id="txtBranchName">
                                                <option value="0">Select Branch</option>
                                            </select>
                                            <label class="labelup" for="txtBranchName">Branch *</label>
                                        </span>
                                        <div id="dvErrorBranchName" class="clrdiv" style="color:red"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <!-- Ref No -->
                        <div class="col-12 col-md-3" align="center">
                            <table>
                                <tr>
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <span class="form-label">
                                                <input tabindex="3" class="form-control FormclrField" type="text" id="txtRefNo" placeholder=""
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRefNo')"
                                                       oninput="sanitizeAlphaNumeric(this, '#divErrRefNo')" />
                                                <label class="labelup" for="txtCode"> Ref No</label>
                                            </span>
                                            <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrRefNo" class="clrdivs"></div>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <!-- Blank -->
                        <div class="col-12 col-md-3 mb-3"></div>
                        <!-- Doc ID -->
                        <div class="col-12 col-md-3">
                            <table>
                                <tr>
                                    <td align="right">
                                        <span class="fw-semibold">
                                            Doc ID :
                                        </span>
                                    </td>
                                    <td>
                                        <label id="lblDocID" docprefix="" style="font-size:14px" class="fw-bolder">PVRV/2425/1</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="right">
                                        <span class="fw-semibold">
                                            Date :
                                        </span>
                                    </td>
                                    <td>
                                        <input class="clsdtpfieldbottomborder FormclrField"
                                               type="date"
                                               id="dtpDate"
                                               oninput="if (this.value > this.max) { this.value = this.max; }"
                                               placeholder="Date" />
                                    </td>
                                </tr>
                            </table>
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrDate"></div>
                        </div>
                    </div>

                    <div style="padding-top:2px; width:100%" class="row">
                        <!-- Column 1 -->
                        <div class="col-12 col-md-4">
                            <hr />
                            <table class="table" style="width:100%">
                                <tr>
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <span class="form-label">
                                                <select tabindex="5" class="form-control FormclrcmbField" id="cmbType"><option value="0">Select</option></select>
                                                <label class="labelup" for="txtCode">Type *</label>
                                            </span>
                                            <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrType" class="clrdivs"></div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;padding-right:7px" colspan="2">
                                        <div class="form-label" style="margin-top: 12px;">
                                            <div class="input-group">
                                                <span id="openfromaccount" class="input-group-text" title="New Account No" style="cursor:pointer;">
                                                    <i class="fas fa-arrow-up-right-from-square"></i>
                                                </span>
                                                <select tabindex="5" class="form-control FormclrcmbField" id="cmbFromAccount">
                                                    <option value="0">Select</option>
                                                </select>
                                                <span id="lnkViewFromBank" class="input-group-text" title="Bank Info">
                                                    <i class="fa-solid fa-circle-info"></i>
                                                </span>
                                            </div>
                                            <label class="labelup">Account No *</label>
                                        </div>
                                        <div style="color:red;padding-top:5px;padding-left:5px;" id="divErrFromAccount" class="clrdivs"></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <span class="form-label">
                                                <select tabindex="5" class="form-control FormclrcmbField" id="cmbMode"><option value="0">Select</option></select>
                                                <label class="labelup" for="txtCode">Mode</label>
                                            </span>
                                            <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrMode" class="clrdivs"></div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <div class="input-group">
                                                <span id="opencheque" class="input-group-text" title="New Account No" style="cursor:pointer;">
                                                    <i class="fas fa-arrow-up-right-from-square"></i>
                                                </span>
                                                <span class="form-label flex-grow-1">
                                                    <select tabindex="5" class="form-control FormclrcmbField" id="cmbChequeNo"><option value="0">Select</option></select>
                                                    <label class="labelup" for="txtCode">Cheque No</label>
                                                </span>
                                            </div>
                                                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrChequeNo" class="clrdivs"></div>
                                            </div>
                                        </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Column 2 -->
                        <div class="col-12 col-md-4">
                            <hr />
                            <table class="table" style="width:100%">
                                <tr>
                                    <td style="border:none" colspan="2">
                                        <span class="form-label">
                                            <input tabindex="6" type="number" step="any" id="txtValue" class="form-control FormclrField txtsettag" placeholder=""
                                                   onbeforeinput="return NumericOnlyBeforeInput(event, this,'#dvErrorValue')"
                                                   oninput="sanitizeNumericOnly(this, '#dvErrorValue')" />
                                            <label class="labelup">Value *</label>
                                        </span>
                                        <div class="clrdivs" id="dvErrorValue" style="color:red"></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;padding-right:7px" colspan="2">
                                        <div id="amountWords" class="mb-2" style="color: black; font-weight: 600; font-size: 11px;"></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;padding-right:7px" colspan="2">
                                        <div class="form-label" style="margin-top: 12px;">
                                            <div class="input-group">
                                                <span id="opentoaccount" class="input-group-text" title="New Account No" style="cursor:pointer;">
                                                    <i class="fas fa-arrow-up-right-from-square"></i>
                                                </span>
                                                <select tabindex="5" class="form-select FormclrcmbField" id="cmbToAccount">
                                                    <option value="0">Select</option>
                                                </select>
                                                <span id="lnkViewToBank" class="input-group-text" title="Bank Info">
                                                    <i class="fa-solid fa-circle-info"></i>
                                                </span>
                                            </div>
                                            <label class="labelup">Transfer Account No *</label>
                                        </div>
                                        <div style="color:red;padding-top:5px;padding-left:5px;" id="divErrToAccount" class="clrdivs"></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <span class="form-label">
                                                <input tabindex="4" class="form-control FormclrField" type="number" step="any" id="txtNEFT" placeholder="">
                                                <label class="labelup" for="txtCode">NEFT/WD Slip No</label>
                                            </span>
                                            <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrNEFT" class="clrdivs"></div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <div class="input-group">
                                                <span id="opensalesman" class="input-group-text" title="New Salesman" style="height:28px !important">
                                                    <span class="fas fa-arrow-up-right-from-square"></span>
                                                </span>
                                                <span class="form-label flex-grow-1">
                                                    <select tabindex="5" class="form-control FormclrcmbField" id="cmbSalesman"><option value="0">Select</option></select>
                                                    <label class="labelup" for="txtCode">Salesman</label>
                                                </span>
                                            </div>
                                            <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrSalesman" class="clrdivs"></div>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Column 3 -->
                        <div style="padding-bottom:2px" class="col-12 col-md-4">
                            <hr />
                            <table class="table" width="100%">
                                <tr class="bgclrfortr">
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <span class="form-label">
                                                <input tabindex="12" class="form-control FormclrField" type="text" id="txtRemarks" placeholder=""
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRemarks')"
                                                       oninput="sanitizeAlphaNumeric(this, '#divErrRemarks')" />
                                                <label class="labelup" for="txtCode">Remarks</label>
                                            </span>
                                            <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrRemarks" class="clrdiv"></div>
                                        </div>
                                    </td>
                                </tr>
                                <tr class="bgclrfortr">
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <span class="form-label">
                                                <textarea tabindex="13" class="form-control FormclrField" rows="3" id="txtNarration"
                                                          onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrNarration')"
                                                          oninput="sanitizeAlphaNumeric(this, '#divErrNarration')"></textarea>
                                                <label class="labelupfortextarea" for="txtCode">Narration</label>
                                            </span>
                                            <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrNarration" class="clrdiv"></div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;" colspan="2">
                                        <div>
                                            <label>Balance : </label><label id="lblBalance" style="font-size:14px;font-weight:600;padding-left:10px;">0.00</label>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:none;" width="75%">
                                        <span class="form-label">
                                            <select class="form-control" id="cmbPrintProfile">
                                                <option value="0">Select</option>
                                            </select>
                                            <label class="labelup">Print Profile</label>
                                        </span>
                                        <div class="text-danger pt-1 ps-1" id="divErrPrintProfile"></div>
                                    </td>
                                    <td style="border:none;">
                                        <span class="form-label flex-grow-1">
                                            <input id="txtNoofCopies" class="form-control" value="1" type="number"
                                                   onbeforeinput="return NumericOnlyBeforeInput(event, this,'divErrPrintProfile')" oninput="sanitizeNumericOnly(this, 'divErrPrintProfile')" />
                                            <label class="labelup">Copies</label>
                                        </span>
                                        <div class="text-danger pt-1 ps-1" id="divErrPrintCopy"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer">
                    <div class="container-fluid">
                        <div class="row align-items-center">
                            <div class="text-end">
                                <button class="btn text-white" title="Whatsapp" id="btnWhatsapp" style="background-color:green">
                                    <i class="fa-brands fa-whatsapp"></i>
                                </button>
                                <button class="btn clrforpdf" title="Mail" id="btnEmail">
                                    <i class="fa-solid fa-envelope"></i>
                                </button>
                                <button class="btn clrforpdf" title="PDF" id="btnPDF">
                                    <i class="fa-regular fa-file-pdf"></i>
                                </button>
                                <button class="btn clrforpreview" id="btnPreview">
                                    <i class="fa-solid fa-print"></i> Preview
                                </button>
                                <button class="btn clrforpreview" id="btnPrint">
                                    <i class="fa-solid fa-print"></i> Print
                                </button>
                                <button type="button" class="btn btn-edit-style" id="btnTEdit"><span class="glyphicon glyphicon-pencil"> Edit</span></button>
                                <button type="button" class="btn btn-cancel-style" id="btnTCancel"><span class="glyphicon glyphicon-remove"> Cancel</span></button>
                                <button type="button" class="btn type-variant-style" id="btnTVariant"><span class="bi bi-copy"> Variant</span></button>
                                <button class="btn btn-danger" id="btnClear">
                                    <span class="glyphicon glyphicon-refresh"> Clear</span>
                                </button>
                                <button class="btn btn-success" id="btnSave">
                                    <span class="glyphicon glyphicon-saved"> Save</span>
                                </button>
                                <button class="btn btn-warning" id="btnClose">
                                    <i class="bi bi-x-circle"></i> Close
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    var nTransMode = 1;
    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canEdit: $("#txtModifyID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canCancel: $("#txtCancelID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    const allGridActions = [
        {
