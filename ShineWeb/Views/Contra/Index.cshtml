            showErrorSnackbar("Select Account No");
        }
        if ($("#cmbType").val() == 0) {
            IsValid = false;
            $("#divErrType").html("Select Contra Type *");
            showErrorSnackbar("Select Contra Type");
        }
        if ($("#cmbMode").val() == 2 && ($("#cmbChequeNo").val() == 0 || $("#cmbChequeNo").val() == null)) {
            IsValid = false;
            $("#divErrChequeNo").html("Select Cheque *");
            showErrorSnackbar("Select Cheque");
        }
        if ($("#cmbType").val() == 3 && $("#cmbToAccount").val() == 0) {
            IsValid = false;
            $("#divErrToAccount").html("Select Account *");
            showErrorSnackbar("Select  Account");
        }
        if ($("#cmbType").val() == 3 & ($("#cmbMode").val() == 3 || $("#cmbMode").val() == 4 || $("#cmbMode").val() == 5)) {
            if ($("#txtNEFT").val() == "") {
                IsValid = false;
                $("#divErrNEFT").html("Mandatory field should not be empty *");
                showErrorSnackbar("Mandatory field should not be empty");
            }
        }
        if ($("#cmbType").val() == 2 & ($("#cmbMode").val() == 1)) {
            if ($("#txtNEFT").val() == "") {
                IsValid = false;
                $("#divErrNEFT").html("Mandatory field should not be empty *");
                showErrorSnackbar("Mandatory field should not be empty");
            }
        }
        if ($("#txtValue").val() == "") {
            IsValid = false;
            $("#dvErrorValue").html("Value should not be empty");
            showErrorSnackbar("Value should not be empty");
        }
        else {
            var val = $("#txtValue").val();
            if (parseFloat(val) <= 0) {
                IsValid = false;
                $("#dvErrorValue").html("Value should be greater than zero");
                showErrorSnackbar("Value should be greater than zero");
            }
        }
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#dvErrorDate").html("Date should not be empty");
            showErrorSnackbar("Date should not be empty");
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var nStatus = $("#txtStatus").val() !== "" ? $("#txtStatus").val() : 1;

        var lstMaster = {
            "TransID": FID,
            "TransMode": nTransMode,
            "ID": $("#txtID").val(),
            "DocDate": $("#dtpDate").val(),
            "RefNo": $("#txtRefNo").val(),
            "BranchID": $("#txtBranchName").val(),
            "PartyID": $("#cmbFromAccount").val(),
            "FAID": $("#cmbToAccount").val(),
            "NoteValue": document.getElementById("txtValue").getAttribute("txttag"),//ReturnTagValue("txtValue",""),// $("#txtValue").val(),
            "Remark": $("#txtRemarks").val(),
            "Narration": $("#txtNarration").val(),
            "UDFId": $("#cmbUDN").val(),

            "ContType": $("#cmbType").val(),
            "ContMode": $("#cmbMode").val(),
            "ChequeNo": $("#cmbChequeNo").val() > 0 ? $("#cmbChequeNo option:selected").text() : "",
            "NEFTNo": $("#txtNEFT").val(),
            "Salesman": $("#cmbSalesman").val(),

            "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : nStatus,
            "CurrentStatus": nStatus,
            "CBy": UID
        };
        console.log("SAVE PAYLOAD (object):", lstMaster);
        console.log("SAVE PAYLOAD (json):", JSON.stringify(lstMaster, null, 2));
            $.ajax({
                url: Aurl + "contra/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (nTransMode != 4) {
                                if (allowprint == 1) {
                                    PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                } else if (allowprint == 3 || allowprint == 4) {
                                    PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                }
                                if (SendAutoMail == 1) {
                                    EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                }
                            }
                            ClearForm();
                            GetFilterData();
                            modal.hide();
                        }
                        else if (items.Message == "AccountName") {
                            $("#dvErrorName").html("Account Name Already Exists in another master");
                            showErrorSnackbar("Account Name Already Exists in another master");
                        }
                        else if (items.Message == "Cheque") {
                            $("#divErrChequeNo").html("Cheque status already changed");
                            showErrorSnackbar("Cheque status already changed");
                        }
                        else {
                            //$("#divErrorOnCode").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }
    
