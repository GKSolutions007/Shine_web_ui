<script type="text/javascript">
    //document.body.style.zoom = "85%";

    var Aurl = '@Session["APIurl"]';
    if ($("#txtAddID").val() == 0) {
        $("#trAdd").hide();
        $("#btnAdd").hide();
    }
    @*var DefBranch = '@Session["DefaultBranch"]';*@
    LoadBranchByRoles();
    var RID = '@Session["RoleID"]';

    if ($("#txtEnableBranch").val() == 1) {
        $("#txtBranchName,#cmbFilterBranch").prop("disabled", true);
    }
    
    if ($("#txtModifyID").val() == 0 && $("#txtViewID").val() == 0 && $("#txtAddID").val() == 1) {
        //$("#dvMainTable").hide();
    }
    var grid, Contra;
  var enableBranch = '@(Model.EnableBranch ?? "0")';
    console.log("EnableBranch:", enableBranch);
    GetColumnSettingsData(2, 18, 1);
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    var PrintTransID = 18, PrintConfigID = 0;
    //setDate();
    GetPrintProfile(PrintTransID);
    function GetPrintProfile(nTransID) {
        $.ajax({
            url: Aurl + "printprofileconfig/getprofile",
            type: 'get',
            contentType: 'json',
            data: { TransID: nTransID },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                $('#cmbPrintProfile').find("option").remove();
                $('#cmbPrintProfile').append($('<option/>', {
                    value: 0,
                    text: "-- Select --",
                }));
                var lstdata = eval(data)
                var getdef = lstdata.filter(pr => pr.DefaultConfig == 1);
                var defid = getdef.length > 0 ? getdef[0].ConfigID : 0;
                $.each(lstdata, function (i, items) {
                    $('#cmbPrintProfile').append($('<option/>', {
                        value: items.ConfigID,
                        text: items.ConfigName, 'data-automail': items.AutoMail
                    }));
                    $('#cmbPrintProfile').val(defid);
                    PrintConfigID = defid;
                });
            }
        });
    }
    GetData(1,"");
    //GetFilterData();

    $('#dtpDate,#txtBranchName').on('focus', function () {
        $(this).data("oldvalue", $(this).val());
    });
    $("#dtpDate").change(function (e) {
        var DocDate = e.target.value;
        var id = e.target.id;
        var Branch = $("#txtBranchName").val();
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });

    $("#txtBranchName").change(function (e) {
        if (typeof GetDocumentID !== "function") return;
        var DocDate = $("#dtpDate").val();
        var Branch = e.target.value;
        var id = e.target.id;
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });


    var arrModeData = [], arrAccountData = [], arrBranchData = [], arrALBranchData = [], arrTypeData = [], nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch = 0, nIndexarrTax = 0,DefBankAcc = 0;
    function GetData(nMode,nID,strVal = "") {
        $.ajax({
            url: Aurl + "contra/get",
            type: 'get',
            contentType: 'json',
            data: { TransID: FID, Mode: nMode, ID: nID, Value: strVal },
            xhrFields: {
                withCredentials: true
            },
            //async : false,
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbUDN,#cmbType,#cmbMode,#cmbFromAccount,#cmbToAccount,#cmbSalesman,#cmbChequeNo,#cmbFilterAccount,#txtBranchName').find("option").remove();
                    $('#cmbUDN,#cmbMode,#cmbFromAccount,#cmbToAccount,#cmbSalesman,#cmbChequeNo,#cmbFilterAccount,#txtBranchName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrModeData = [], arrAccountData = [], arrBranchData = [], arrTypeData = [], arrALBranchData = [];
                    nIndexarrParty = 0, nIndexarrAccount = 0, DefBankAcc = 0, nIndexarrBranch = 0;
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            if (items.Code == "1")
                            {
                                var BADetails = (items.Name).split('|');
                                $('#cmbFromAccount,#cmbToAccount,#cmbFilterAccount').append($('<option/>', {
                                    value: items.ID,
                                    text: BADetails[0],
                                }));
                                var BAInfo = {
                                    "ID": items.ID,
                                    "AccNo": BADetails[0],
                                    "Bank": BADetails[1],
                                    "Branch": BADetails[2],
                                    "IFSC": BADetails[3],
                                    "MICR": BADetails[4],
                                    "DefYN": BADetails[5],
                                }
                                if (BADetails[5] == "1") {
                                    DefBankAcc = items.ID;
                                }
                                arrAccountData.push(BAInfo);
                            }
                            var ttd = {
                                "ID": items.ID,
                                "Name": items.Name,
                                "TypeID": items.Code
                            }
                            arrTypeData.push(ttd);
