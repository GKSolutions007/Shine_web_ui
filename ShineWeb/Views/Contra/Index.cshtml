<script type="text/javascript">
    var Aurl = '@Session["APIurl"]';
    var Url = '@Session["url"].ToString()';
    LoadBranchByRoles('#txtBranchName,#cmbFilterBranch');
    var RID = '@Session["RoleID"]';
    var itemorderby = '@Session["ItemOrderby"]';
var EnableALStartWith = '@Session["ALSearchstartwith"]' == "1";
var autolistfilterwith = EnableALStartWith;
var startwithfield = itemorderby == "1" ? "code" : itemorderby == "2" ? "name" : "search";
    if ($("#txtEnableBranch").val() == 1) {
        $("#txtBranchName,#cmbFilterBranch").prop("disabled", true);
    }

    var grid, Contra;
  var enableBranch = '@(Model.EnableBranch ?? "0")';
    //console.log("EnableBranch:", enableBranch);
    GetColumnSettingsData(2, 18, 1, true);
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    var PrintTransID = 18, PrintConfigID = 0;
    //setDate();
    GetPrintProfile(PrintTransID);

    GetData(1, "");
    setDate("dtpDate", 0);
    setDate("dtpFFrom", 0);
    setDate("dtpFTo", 0);

    setTimeout(function () { GetFilterData(); }, 800);
    //GetFilterData();

    $('#dtpDate,#txtBranchName').on('focus', function () {
        $(this).data("oldvalue", $(this).val());
    });
    $("#dtpDate").change(function (e) {
        var DocDate = e.target.value;
        var id = e.target.id;
        var Branch = $("#txtBranchName").val();
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });

    $("#txtBranchName").change(function (e) {
        if (typeof GetDocumentID !== "function") return;
        var DocDate = $("#dtpDate").val();
        var Branch = e.target.value;
        var id = e.target.id;
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });


    var arrModeData = [], arrAccountData = [], arrBranchData = [], arrALBranchData = [], arrTypeData = [], nIndexarrParty = 0, nIndexarrAccount = 0,
        nIndexarrBranch = 0, nIndexarrTax = 0, DefBankAcc = 0;
    //~Preload Data
    function GetData(nMode,nID,strVal = "") {
        $.ajax({
            url: Aurl + "contra/get",
            type: 'get',
            contentType: 'json',
            data: { TransID: FID, Mode: nMode, ID: nID, Value: strVal },
            xhrFields: {
                withCredentials: true
            },
            //async : false,
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbUDN,#cmbType,#cmbMode,#cmbFromAccount,#cmbToAccount,#cmbSalesman,#cmbChequeNo,#cmbFilterAccount,#txtBranchName').find("option").remove();
                    $('#cmbUDN,#cmbMode,#cmbFromAccount,#cmbToAccount,#cmbSalesman,#cmbChequeNo,#cmbFilterAccount,#txtBranchName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrModeData = [], arrAccountData = [], arrBranchData = [], arrTypeData = [], arrALBranchData = [];
                    nIndexarrParty = 0, nIndexarrAccount = 0, DefBankAcc = 0, nIndexarrBranch = 0;
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            if (items.Code == "1")
                            {
                                var BADetails = (items.Name).split('|');
                                $('#cmbFromAccount,#cmbToAccount,#cmbFilterAccount').append($('<option/>', {
                                    value: items.ID,
                                    text: BADetails[0],
                                }));
                                var BAInfo = {
                                    "ID": items.ID,
                                    "AccNo": BADetails[0],
                                    "Bank": BADetails[1],
                                    "Branch": BADetails[2],
                                    "IFSC": BADetails[3],
                                    "MICR": BADetails[4],
                                    "DefYN": BADetails[5],
                                    "BaID": BADetails[6]
                                }
                                if (BADetails[5] == "1") {
                                    DefBankAcc = items.ID;
                                }
                                arrAccountData.push(BAInfo);
                            }
                            var ttd = {
                                "ID": items.ID,
                                "Name": items.Name,
                                "TypeID": items.Code
                            }
                            arrTypeData.push(ttd);
                        }
                        if (items.FType == 2) {
                            $('#cmbType').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 3) {
                            $('#cmbMode').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                            var md = {
                                "ID": items.ID,
                                "Name": items.Name,
                                "Mode": items.Code
                            }
                            arrModeData.push(md);
                        }
                        if (items.FType == 4) {
                            $('#cmbSalesman').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 5) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 6) {
                            $("#lblDocID").text(items.Name);
                        }
                    });
                    $('#cmbType').val(1);

                    ValidateTypeSelection(1);
                    //$("#txtBranchName").val(DefBranch);
                    LoadBranchByRoles('#txtBranchName,#cmbFilterBranch');
                }
                if (nMode == 3) {
                    //~Assign Data
                    $("#lblBalance").text("0.00");
                    $.each(data, function (i, items) {
                        modal.show();

                        if (nTransMode != 3)
                            $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);

                        LoadDetailsIndropdown(items.ContType);
                        //ValidateTypeSelection(items.ContMode);
                        $("#txtID").val(items.ID), $("#dtpDate").val(items.DocDate),
                            $("#txtRefNo").val(items.RefNo), $("#txtBranchName").val(items.BranchID), $("#cmbFromAccount").val(items.PartyID), $("#cmbToAccount").val(items.FAID),
                            $("#txtRemarks").val(items.Remark), $("#txtNarration").val(items.Narration), $("#cmbUDN").val(items.UDFId),
                            $("#txtStatus").val(items.Status);
                        updateInputColumn("txtValue",items.NoteValue)
                        $("#cmbType").val(items.ContType), $("#cmbMode").val(items.ContMode), $("#txtNEFT").val(items.NEFTNo),
                            $("#cmbSalesman").val(items.Salesman);
                        document.getElementById("amountWords").innerHTML = numberToIndianCurrencyWords(items.NoteValue);
                        if (items.ContMode == 2) {
                            setTimeout(() => {

                                GetData(4, items.PartyID, nTransMode == 3 ? 0 : items.ChequeNo);
                                //$("#cmbChequeNo").val(items.ChequeNo);
                            }, 600);
                        }
                        setTimeout(() => {
                        if (items.ContType == 1) {
                            GetData(6, 13, items.DocDate);
                        } else {
                            GetData(7, items.PartyID, items.DocDate);
                            }
                        }, 600)
                        //if ($("#cmbFromAccount").val() > 0) {
                        //    $('#lnkViewFromBank').show();
                        //}
                        //if ($("#cmbToAccount").val() > 0) {
                        //    $('#lnkViewToBank').show();
                        //}
                    });
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#txtBranchName").prop("disabled", true);
                    }
                }
                if (nMode == 4) {
                    $('#cmbChequeNo').find("option").remove();
                    $('#cmbChequeNo').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbChequeNo').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                            "data-CHID": items.CBID
                        }));
                    });
                    $("#cmbChequeNo").val(strVal);
                }
                if (nMode == 6 || nMode == 7) {// type change
                    $("#lblBalance").text("0.00");
                    $.each(data, function (i, items) {
                        var bal = parseFloat(items.Balance).toFixed(DecVal) + " " + items.ContType;
                        $("#lblBalance").text(bal);
                    });
                }

            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $('#btnTEdit').click(function (e) {
        var Did = $("#txtID").val();
        var Currsts = $("#txtStatus").val();
        $(".clrdivs").html("");
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        $.ajax({
            url: Aurl + "validatedocument",
            type: 'get',
            contentType: 'json',
            data: { ActionType: 1, TransID: FID, ID: Did, Status: Currsts },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        EditActionTrigger(rowinfo);
                    }
                    else {
                        showErrorSnackbar(items.Message)
                    }
                });
            }
        });
    });
    function EditActionTrigger(rowData) {
        nTransMode = 2;
        GetData(3, rowData.ID);
        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnClear").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear").hide();
        $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
        $("#btnSave,#btnClose").prop("disabled", false);
        $("#btnSave,#btnClose").show();
        $("#btnEmail,#btnWhatsapp").hide();
        $(".modal-title#lblPopupheading").text("Modify " + $("#txtFormName").val());
    }
    $('#btnTCancel').click(function (e) {
        var Did = $("#txtID").val();
        var Currsts = $("#txtStatus").val();
        $(".clrdivs").html("");
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        $.ajax({
            url: Aurl + "validatedocument",
            type: 'get',
            contentType: 'json',
            data: { ActionType: 2, TransID: FID, ID: Did, Status: Currsts },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        CancelActionTrigger(rowinfo);
                    }
                    else {
                        showErrorSnackbar(items.Message)
                    }
                });
            }
        });
    });
    function CancelActionTrigger(rowData) {
        $(".modal-title#lblPopupheading").text("Cancel " + $("#txtFormName").val());
        $("#txtID").val(rowData.ID);
        nTransMode = 4;
        GetData(3, rowData.ID);
        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#txtNarration,#txtRemarks").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnClear,#btnDraft").prop("disabled", true);
        $("#btnSave,#btnClose").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
        $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
        $("#btnSave,#btnClose").show();
        $("#btnEmail,#btnWhatsapp").hide();
    }
    $('#btnTVariant').click(function (e) {
        var Did = $("#txtID").val();
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        VariantActionTrigger(rowinfo);
    });
    function VariantActionTrigger(rowData) {
        nTransMode = 3;
        GetData(3, rowData.ID);
        $(".modal-title#lblPopupheading").text("Variant " + $("#txtFormName").val());
        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
        $("#btnSave,#btnClear,#btnDraft").prop("disabled", false);
        $("#btnPreview,#btnPDF").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear").hide();
        $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
        $("#btnSave,#btnClose,#btnDraft").show();
        $("#btnEmail,#btnWhatsapp").hide();
        setTimeout(() => {
            var DocDate = $("#dtpDate").val();
            var Branch = $("#txtBranchName").val();
            GetDocumentID(DocDate, Branch, FID);
        }, 1000);
    }
    $('#btnFilter').click(function (e) {
        GetFilterData(1);
    });
    var Showall = '@Session["Showallstatus"]';
    $("#chkShowAll").prop("checked", Showall == '1');
    //~Grid Data
    function GetFilterData(ClickType = 0) {//cmbFilterAccount,divErrFilterAccount
        var IsValid = true;
        $(".clrdivs").html("");
        if ($("#dtpFFrom").val() == "") {
            IsValid = false;
            $("#divErrFFrom").html("From date should not be empty");
        }
        if ($("#dtpFTo").val() == "") {
            IsValid = false;
            $("#divErrFTo").html("To date should not be empty");
        }
        if ($("#dtpFFrom").val() > $("#dtpFTo").val()) {
            IsValid = false;
            $("#divErrFFrom").html("From date should be lessthan To Date");
        }
        if (IsValid) {
            var strBranch = $("#cmbFilterBranch").val(), strAcc = $("#cmbFilterAccount").val(), strParty = $("#cmbFilterAccount").val(), dFrom = $("#dtpFFrom").val(),
                dTo = $("#dtpFTo").val(), chkshow = $("#chkShowAll").is(":checked") ? "1" : "0";
            $.ajax({
                url: Aurl + "contra/getfilterdata",
                type: 'get',
                contentType: 'json',
                data: { Mode: 2, TransID: FID, Branch: strBranch, AccName: strAcc, FromDate: dFrom, ToDate: dTo, Showall: chkshow },
                xhrFields: {
                    withCredentials: true
                },

                success: function (data) {
                    Contra = data;
                    var billjsdata = eval(data);
                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, billjsdata, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,
                        enableAddRow: false,
                        enableRemoveRow: false,
                        enableSorting: true,
                        searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                        rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                        //onCellChange: handleCellUpdate,
                        customCellRenderer: (el, col, rowData) => {
                        },
                        customButtons: [
                            {
                                icon: '⚙️',
                                text: '',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {
                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 18, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'New',
                                title: 'New Contra',
                                visible: $("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {
                                    nMode = 1;
                                    nTransMode = 1;
                                    ClearForm();
                                    $(".FormclrField,.FormclrcmbField").prop("disabled", false);
                                    $("#btnSave,#btnClear,#btnClose").prop("disabled", false);
                                    $("#btnPreview,#btnPDF").prop("disabled", true);
                                    $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                    $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
                                    document.getElementById("txtBranchName").focus();
                                    modal.show();
                                    GetData(6, 13, $("#dtpDate").val());
                                    setTimeout(() => {
                                        var DocDate = $("#dtpDate").val();
                                        var Branch = $("#txtBranchName").val();
                                        if (Branch > 0 && DocDate !== "") {
                                            GetDocumentID(DocDate, Branch, FID);
                                        }
                                    }, 1000);

                                }
                            },
                        ],
                        onCellClick: (rowData, fieldName, cellValue, column) => {
                        },
                        onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(18, 1, 0, colIndex, field, newWidth)
                        },
                    });

                    if (billjsdata.length == 0) {
                        if (ClickType == 1)
                            showErrorSnackbar("No records found");
