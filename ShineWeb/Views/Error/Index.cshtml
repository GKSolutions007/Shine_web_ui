
@{
    ViewBag.Title = "Error";
    Layout = "~/Views/Shared/Error.cshtml";
}



<div class="card">
    <!-- SVG Warning Icon -->
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <circle cx="12" cy="16" r="1" />
    </svg>

    <h1>Oops! Something went wrong</h1>
    <h2>An unexpected error occurred while processing your request.</h2>
    <code>Error : </code><h2>@ViewData["ErrorMsg"]</h2>
    <button onclick="location.reload()">Try Again</button>
</div>