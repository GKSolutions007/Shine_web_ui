<script>
    //~Filter Action Buttons
    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    var allGridActions = [], singleIconAction = [], menuActions = [], columns = [];
    var actions = {}, OtherActions = {};

    function LoadPermissions() {
        allGridActions = [
            {
                icon: '👁️',
                title: 'View Data',
                className: 'dg-action-view',
                displayType: 'single_icon',
                visible: mapusersRole.canView,
                handler: (rowdata) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;
                    var stsid = rowdata.StatusID;
                    nTransMode = 5;
                    $("#txtID").val(ID);
                    ViewActionButtonPermission();
                    GetProductViewData(ID, stsid);
                    $("#txtStatus").val(stsid);
                    $(".FormclrField,.FormclrcmbField,#txtRemarks,#txtNarration").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft,#btnClear,#btnNewProd").hide();
                    $("#btnPreview,#btnPDF,#btnBarcodePrint,#btnEmail,#btnWhatsapp").show();
                    $("#dvMain").show();
                    $("#dvDocuments,.dvclsforhdview").hide();
                    $("#MainHeading").text("View " + $("#txtFormName").val() + "_" + sts);
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#cmbBranch").prop("disabled", true);
                    }
                    //LoadBranchByRoles('#cmbBranch,#cmbFilterBranch');
                }
            },
            {
                icon: '📄',
                title: 'Variant',
                className: 'dg-action-edit',
                visible: mapusersRole.canVariant,
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    $("#txtID").val(ID);
                    VariantActionTrigger(rowdata);
                }
            },
            {
                icon: '🖨️',
                title: 'Print',
                className: 'dg-action-edit',
                visible: mapusersRole.canPrint,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    //$("#btnBarcodePrint").click();
                    BarcodePrintTrigger(25, ID);
                }
            },
        ];
        singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
        menuActions = allGridActions.filter(a => a.displayType === 'menu_item');
        actions = {
            "header": 'View',
            "type": "action",
            "width": 60,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": singleIconAction
        };
        OtherActions = {
            "header": "Action",
            "type": "action3dots",
            "width": 60,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": menuActions
        }
    }
    LoadPermissions();
    function ViewActionButtonPermission() {
        $("#btnTVariant").hide();
        if (mapusersRole.canVariant)
            $("#btnTVariant").show();
