    function GetProductViewData(nID,nStatus) {
        let sb = document.getElementById("RepLoadersnackbar");
        sb.classList.add("show");
        $.ajax({
            url: Aurl + "barcodeprint/bpdocumentdata",
            type: 'get',
            contentType: 'json',
            data: { ID: nID, Status: nStatus },
            xhrFields: {
                withCredentials: true
            },
            //async: false,
            success: function (data) {
                var HeaderData = data.HeaderData;
                var ProductData = data.ProductData;
                G.clearAllRows();
                G.setLocked(nTransMode == 4 || nTransMode == 5);
                $.each(HeaderData, function (i, items) {
                    $("#txtID").val(items.ID);
                    $("#cmbBranch").val(items.BranchID);
                    var dt = items.DocDate.substring(0, 10);//"2026-07-18T00:00:00"
                    if (nTransMode == 3) {
                        setDate("dtpDate", 0);
                    } else {
                        $("#dtpDate").val(dt);
                    }
                    $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);
                    $("#txtRefNo").val(items.RefNo);
                    $("#txtRemarks").val(items.Remarks), $("#txtNarration").val(items.Narration);
                });
                //GetProductList();
                ProductRID = 0;
                var disbfields = nTransMode == 4 || nTransMode == 5 ? "disabled" : "";
                var visbfields = nTransMode == 4 || nTransMode == 5 || nTransMode == 2 ? "hidden" : "";
                var isvisb = nTransMode == 4 || nTransMode == 5 || nTransMode == 2 ? false : true;
                var disbprod = nTransMode == 2 ? "disabled" : "";
                //console.log("ProductData ", ProductData);
                var dataSet = ProductData.map(function (itemsProd, nRowIndex) {
                    const t = taxById(itemsProd.PurchaseTaxID) || taxOf(itemsProd.TaxPern);                // item tax (TaxID, else by GST %)
                    var uomforselprod = [{
                        ID: itemsProd.BarcodeUomId,
                        Name: itemsProd.UomName,
                        ConvRate: itemsProd.BarConRate
                    }];
                    G.addRow();
                    G.patch(nRowIndex, {
                        productID: +itemsProd.ProdID || 0, ApponMRPCum: itemsProd.CumTaxPern, MRPonTaxAmt: itemsProd.MRPonTax, itemName: itemsProd.Name, code: itemsProd.Code,
                        stock: itemsProd.ActualQty, freestock: itemsProd.ActualFreeQty, InventoryID: itemsProd.BPInventory, PriceID: itemsProd.BarcodePriceId,
                        TrkInvYN: itemsProd.TrackInventory, TrkBatchYN: itemsProd.TrackBatch, TrkPKDYN: itemsProd.TrackPKD, batchno: itemsProd.BatchNo, pkd: itemsProd.PKD, expiry: itemsProd.Expiry,
                        mrp: +itemsProd.BPMRP || 0,
                        qty: itemsProd.BPQty,
                        priceExcl: +itemsProd.BPPrice || 0, priceIncl: +itemsProd.BPInclPrice || 0,
                        _uoms: uomforselprod, uomID: +itemsProd.BarcodeUomId || 0,          // item's own UOM list + its default UOM -> dropdown is rebound in the row
                        taxID: t ? +t.ID : 0, taxPct: t ? +t.TaxPern : (+itemsProd.TaxPern || 0), reasonID: itemsProd.BPReasonID
                    }, 'items');
                });
                if (nTransMode == 1 || nTransMode == 2 || nTransMode == 3) {
                    G.addRow();
                }
                G.setLocked(nTransMode == 4 || nTransMode == 5);
                G.cfg.onRender(G);
                sb.classList.remove("show");


            }, error: function (data) {
                sb.classList.remove("show");
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
