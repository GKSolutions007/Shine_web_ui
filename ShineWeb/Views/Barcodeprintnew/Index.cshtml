<style>
    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 2px 0;
        border-color: #e0d6d6;
        font-weight: bold;
    }

        .gdInput:disabled {
            width: 100%;
            height: 25px;
            border-width: 0 0 0 0;
            background-color: #fff;
            font-weight: bold;
        }

    .tr text-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        /*padding: 6px 12px;*/
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -65%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -26%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }

    /*input:focus + .labelup,
    input:not(:placeholder-shown) + .labelup, textarea:focus + .labelup, textarea:not(:placeholder-shown) + .labelup {
        top: -35%;
        font-size: .9em;
        padding: 0 .3em;
        background: #F9F9F9;
        color: #000000;
    }*/
    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }
</style>

<style>
    /* ===================================================
    MODALS — unified responsive sizing
    =================================================== */
    .modalBatch {
        display: none;
        position: fixed;
        z-index: 1000;
        top: 65%;
        right: 0;
        bottom: 0;
        overflow: auto;
    }

    @@media (min-width: 1000px) {
        .modalBatch {
            width: 30%;
        }
    }

    @@media (min-width: 801px) and (max-width: 999px) {
        .modalBatch {
            width: 45%;
        }
    }

    @@media (max-width: 800px) {
        .modalBatch {
            width: 60%;
        }
    }

    .modalBatch-content, .modalProdInfo-content,
    .modalPaymode-content, .modalCreditLimPassword-content,
    .modalSchema-content, .modalEway-content, .modaliframePreview-content {
        background: #fff;
        padding: 8px;
        border: 1px solid #888;
        overflow: auto;
    }

    @@media (min-width: 600px) {
        .modalBatch-content {
            margin: auto;
            width: 95%;
        }

        .modalProdInfo-content {
            margin: 3% auto;
            width: 75%;
            height: 70%;
        }

        .modalPaymode-content {
            margin: 3% auto;
            width: 75%;
            height: 70%;
        }

        .modalCreditLimPassword-content {
            margin: 3% auto;
            width: 60%;
            height: 70%;
        }

        .modalSchema-content {
            margin: 3% auto;
            width: 45%;
            height: 70%;
        }

        .modalEway-content {
            margin: 3% auto;
            width: 25%;
            height: 70%;
        }

        .modaliframePreview-content {
            margin: auto;
            width: 70%;
            height: 100%;
        }
    }

    @@media (max-width: 599px) {
        .modalBatch-content, .modalProdInfo-content,
        .modalPaymode-content, .modalCreditLimPassword-content,
        .modalSchema-content, .modalEway-content,
        .modaliframePreview-content {
            margin: 10% auto;
            width: 95%;
        }
    }

    .modalBatch {
        position: fixed !important;
    }

    .modal-close-btn {
        position: absolute;
        top: -5px;
        right: 0;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-size: 16px;
        cursor: pointer;
        z-index: 11000;
    }

    #tblBatch tbody {
        min-height: 100px;
    }

    .modalBatch {
        position: fixed !important;
    }

    .modal-close-btn {
        position: absolute;
        top: -5px;
        right: 0;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-size: 16px;
        cursor: pointer;
        z-index: 11000;
    }

    .dt-scroll-body {
        min-height: 80px !important;
    }
</style>
