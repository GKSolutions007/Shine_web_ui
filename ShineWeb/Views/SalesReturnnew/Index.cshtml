<style>
    /* Align dropdown in DataTable cell */
    .action-dropdown {
        min-width: 100px;
        font-size: 12px;
        z-index: 100000;
        text-align: left;
    }

        /* Optional: Add hover effect */
        .action-dropdown > li > a {
            padding: 3px 12px;
            color: #333;
            text-decoration: none;
        }

            .action-dropdown > li > a:hover {
                background-color: #f5f5f5;
                color: #000;
            }

    /* Optional: Make dropdown button minimal */
    .dropdown-toggle {
        background-color: transparent !important;
        border: none !important;
        font-size: 15px;
        line-height: 1;
        padding: 2px 5px;
    }

        .dropdown-toggle::after {
            display: none;
        }
    /* ============ COMPACT FORM CONTROLS ============ */
    .form-control,
    select.form-control,
    input.form-control,
    textarea.form-control,
    .gdInput,
    select.gdInput,
    input.gdInput {
        padding: 4px 8px !important;
        font-size: 12px !important;
        height: 28px !important;
        line-height: 1.4 !important;
        margin-bottom: 1.2px !important
    }

    textarea.form-control {
        height: auto !important;
        min-height: 60px !important;
    }

    .input-group-addon {
        padding: 4px 8px !important;
        font-size: 12px !important;
    }

    select.form-control {
        padding-right: 20px !important;
    }
    /* ============ INVOICE SECTION ANIMATIONS ============ */
    @@keyframes fadeInSection {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-30px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 5px rgba(76, 175, 80, 0.3);
        }

        50% {
            box-shadow: 0 0 20px rgba(76, 175, 80, 0.6);
        }
    }

    .animate-fade-in-section {
        animation: fadeInSection 0.6s ease-out;
    }

    .animate-slide-left {
        animation: slideInLeft 0.5s ease-out;
    }

    .stagger-delay-1 {
        animation-delay: 0.1s;
    }

    .stagger-delay-2 {
        animation-delay: 0.2s;
    }

    .stagger-delay-3 {
        animation-delay: 0.3s;
    }

    #tblBatch tbody {
        /*            display: block;
            width:100%;*/
        min-height: 100px;
    }

    .dt-scroll-body {
        min-height: 100px !important;
    }

    .clsnewitem {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 2px 5px;
        font-size: 12px;
        font-weight: 500;
        color: #0C447C;
        background: #E6F1FB;
        border: 0.5px solid #85B7EB;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, transform 0.1s;
        white-space: nowrap;
        user-select: none;
    }

        .clsnewitem:hover {
            background: #B5D4F4;
            transform: scale(1.05)
        }

    table.dataTable > tbody > tr > th, table.dataTable > tbody > tr > td {
        padding: 2px 10px !important;
    }

    .pi-header {
        background: linear-gradient(135deg, #0d5c3f 0%, #14804f 100%);
        padding: 8px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }

    .pi-header-icon {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: white;
        flex-shrink: 0;
    }

    .pi-header h4 {
        font-size: 17px;
    }

    .pi-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background-color: rgba(255,255,255,0.15) !important;
        border-radius: 6px;
        padding: 5px;
    }

    .pi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .pi-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 2px;
        padding: 9px 14px;
        border-bottom: 1px solid #f0f0f0;
        min-width: 0;
    }

        .pi-row.full {
            grid-column: 1 / -1;
        }

        .pi-row.highlight {
            background-color: #eafaf1;
        }

    .pi-icon-chip {
        width: 26px;
        height: 26px;
        background-color: #eafaf1;
        color: #14804f;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        margin-top: 1px;
    }

    .pi-label {
        width: auto;
        white-space: nowrap;
        color: #6b7280;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-colon {
        color: #9ca3af;
        width: 6px;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-value {
        font-weight: 600;
        color: #111827;
        font-size: 13px;
        min-width: 0;
        flex: 1;
        white-space: normal;
        overflow: visible;
        word-break: break-word;
        line-height: 1.35;
    }

        .pi-value.muted {
            color: #9ca3af;
            font-weight: 400;
        }

    .pi-badge-good {
        background-color: #eafaf1;
        color: #14804f;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 11px;
    }
</style>
