        var nCurRowProdID = currentrowdata.productID;
        var uomcf = currentrowdata.uomCF;
        var currenthiddenrowid = updatebatchrowindex;
        //var Prodrowdata = ProductTable.row(editingRow).data();
        var QtyType = rowdata[0];
        var Qty = rowdata[1];
        var Price = rowdata[2];// nPricttype != 4 ? rowdata[2] : (parseFloat(rowdata[3]) / TaxPern);
        var MRP = rowdata[3];
        var BatchNo = rowdata[5];
        var PKD = rowdata[6];
        var Expiry = rowdata[7];
        var SelBatchType = rowdata[11];
        
        var ShowPrice = parseFloat(Price) * parseFloat(uomcf);//  rowdata[9];

       
        //alert("Price : " + Price + " ,  MRP : " + MRP);
        getExistsSRBatchDetails(nCurRowProdID, currenthiddenrowid, rowdata, TaxPern);

        var NewMRPonAmt = getSalesMRPontax(MRP);
        var InclPrice = currentrowdata.ApponMRPCum > 0 ? parseFloat(ShowPrice) + NewMRPonAmt : parseFloat(ShowPrice) * TaxPern;
        G.patch(updatebatchrowindex, {
            qtytype: QtyType, OrgPrice: Price, MRPonTaxAmt: NewMRPonAmt,
            priceExcl: +ShowPrice || 0, priceIncl: +InclPrice, mrp: MRP, batchno: BatchNo, pkd: PKD, expiry: Expiry,
            batchtype: SelBatchType
        }, 'itemsProd');
