    function GetItemBatchData(ProdID, InvoiceID, row, rowindex) {
        var appprice = $("#cmbPriceType").val();// ApplyReturnPrice == "1" ? 6 : $("#cmbPriceType").val() == 0 ? 2 : $("#cmbPriceType").val();
        var ZeroBatchCheck = $("#chkShowZeroBatch").is(":checked") ? 1 : 0;
        var getrowdatadata = G.getData();
        var currentrowdata = getrowdatadata[rowindex];
        if (currentrowdata == null) {
            showErrorSnackbar("Select valid product");
            modal.hide();
            return;
        } else {
            if (currentrowdata.productID == 0) {
                showErrorSnackbar("Select valid product");
                modal.hide();
                return;
            }
        }
        $.ajax({
            url: Aurl + "salesreturn/get",
            type: 'get',
            contentType: 'json',

            data: {
                Mode: 20, DocPrefix: nDocPrefix, CodeName: ProdID, ID: InvoiceID, BranchID: $("#cmbBranch").val(),
                Date: $("#dtpDate").val(), PriceID: appprice, ShowZerobatch: ZeroBatchCheck
            },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                TableBatch.draw().clear(); TableBatch.draw().clear();
                var trkbat = "False", trkpkd = "False";
                //showErrorSnackbar("Track Inv : "+trkInv);
                var dConvFact = row.uomCF;

                TableBatch.draw().clear(); TableBatch.draw().clear();
                var trkbat = "False", trkpkd = "False";
                $.each(data, function (i, items) {
                    trkbat = items.TrackBatch;
                    trkpkd = items.TrackPKD;

                    TableBatch.row.add([
                        items.QtyTag,
                        items.ActQty,// / dConvFact
                        items.SalesPrice,// * dConvFact
                        items.MRP,
                        items.QtyType,
                        items.BatchNo,
                        items.PKDDate,
                        items.ExpiryDate,
                        parseFloat(items.ActQty / dConvFact).toFixed(DecVal),
                        parseFloat(items.SalesPrice * dConvFact).toFixed(DecVal),
                        parseFloat(items.MRP).toFixed(DecVal), 0
                    ]).draw(false);
                });
                var bPriceType = $("#cmbPriceType").val();

                var doctype = nDocPrefix == 16 ? "SALE" : "DAMAGE";
                var currentnewbatch = NewTempBatch.filter(prod => prod.ProdId == ProdID && prod.BatchType == 1);
                if (currentnewbatch) {
                    $.each(currentnewbatch, function (i, itemsNB) {
                        trkbat = itemsNB.Batch != "" ? "True" : "False";
                        trkpkd = itemsNB.PKD != "" ? "True" : "False";
                        var ApplyPrice = bPriceType == "1" ? itemsNB.PPrice : bPriceType == "2" ? itemsNB.SPrice : bPriceType == "3" ? itemsNB.ECP : bPriceType == "4" ? itemsNB.ExclMRP
                            : bPriceType == "5" ? itemsNB.SPLPrice : itemsNB.Return;
                        TableBatch.row.add([
                            nDocPrefix == 16 ? 1 : 3,
                            0,// / dConvFact
                            ApplyPrice,// * dConvFact
                            itemsNB.MRP,
                            doctype,
                            itemsNB.Batch,
                            itemsNB.PKD,
                            itemsNB.Expiry,
                            parseFloat(0).toFixed(DecVal),
                            parseFloat(ApplyPrice).toFixed(DecVal),
                            parseFloat(itemsNB.MRP).toFixed(DecVal), 1
                        ]).draw(false);
                    });
                }
                TableBatch.column(5).visible(trkbat == "True");
                TableBatch.column(6).visible(trkpkd == "True");
                TableBatch.column(7).visible(trkpkd == "True");
                $(".modalBatch").css("width", "30%");
                if (trkpkd == "True")
                    $(".modalBatch").css("width", "35%");
                $('#txtNBBathNo').prop("disabled", trkbat == "False");
                $('#dtpNBPKD,#dtpNBExp').prop("disabled", trkpkd == "False");

                $('#dtpNBPKD').prop("max", mind);
                $('#dtpNBExp').prop("min", mind);
                if (TableBatch.rows().count() > 0) {
                    modal.show();

                    var PID = row.productID;
                    var Price = row.OrgPrice;
                    var prbat = row.batchno;
                    var prpkd = row.pkd;
                    var prexp = row.expiry;
                    var mrpvall = row.mrp;
                   
                    TableBatch.rows('.selected').nodes().each((row) => row.classList.remove('selected'));
                    $("#tblBatch tbody tr").each(function (e) {
                        var Batchrowdata = TableBatch.row($(this)).data();
                        var OrgPrice = parseFloat(Batchrowdata[2]);// / dConvFact
                        var Orgmrp = parseFloat(Batchrowdata[3]);
                        var BTbat = Batchrowdata[5];
                        var BTpkd = Batchrowdata[6];
                        var BTexp = Batchrowdata[7];
                        var BTQty = Batchrowdata[8];

                        if (OrgPrice == Price && Orgmrp == mrpvall && prbat == BTbat && prpkd == BTpkd && prexp == BTexp) {
                            $(this).closest('tr').addClass("selected");                           
                            var $scrollBody = $(TableBatch.table().node()).parent();
                            var rowOffsetTop = $(this)[0].offsetTop;
                            $scrollBody.scrollTop(rowOffsetTop);
                        }
                        else {
                            $(this).closest('tr').remove("selected");
                        }
                    });
