    //~Validation
    var InclusiveMRPCheck = false;
    function SaveValidation() {
        var IsValid = true;
        $(".clrdivs").html("");
        if ($("#txtSearch").val() == "") {
            IsValid = false;
            $("#divErrSearch").html("Party should not be empty");
            showErrorSnackbar("Party should not be empty");
        }
        else {
            const exists = arrVendorName.indexOf($("#txtSearch").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#divErrSearch").html("Select Party Name from list");
                showErrorSnackbar("Select Party Name from list");
            }
        }
        if ($("#cmbPriceType").val() == 0) {
            IsValid = false;
            $("#divErrPriceType").html("Select Price Type");
            showErrorSnackbar("Select Price Type");
        }
        if (nIsDraft == 0) {
            if ($("#cmbBranch ").val() == 0) {
                IsValid = false;
                $("#divErrBranch").html("Select Branch");
                showErrorSnackbar("Select Branch");
            }
        }
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#divErrDate").html("Date should not be empty");
            showErrorSnackbar("Date should not be empty");
        }
        var griditems = G.getData();
        var items = griditems.filter(item => Number(item.productID) > 0).map(a => a.productID);
        if (items.length == 0) {
            IsValid = false;
            $("#divErrProduct").html("Add atleat one product in Grid");
            showErrorSnackbar("Add atleast one product in Grid");
        }
        else {
            var sumqty = griditems.filter(item => Number(item.productID) > 0).reduce((sum, a) => sum + Number(a.qty || 0), 0);
            if (sumqty == 0) {
                IsValid = false;
                $("#divErrProduct").html("Please enter a quantity of at least 1 for at least one item.");
                showErrorSnackbar("Please enter a quantity of at least 1 for at least one item.");
            }
        }
        $("#lblRoundNet").css("color", "black");
        var valu = document.getElementById("lblRoundNet").getAttribute("lbltag");
        if (parseFloat(valu) <= 0) {
            IsValid = false;
            $("#lblRoundNet").css("color", "red");
            //alert("Net Value should be greater than Zero");
            showErrorSnackbar("Net Amount should be greater than Zero");
        }
        if (IsValid) {
            var errorthrowwed = false;
            var inclerroritems = 0, inclerroritemnames = '', InclGreaterMRPError =false;            
            var row = G.getData();
            ////console.log(row);
            var GRIDrows = $(".g tbody tr");
            console.log("ROW DTA", GRIDrows);
            $.each(row, function (i, items) {
                let ProductID = items.productID;
                let NetAmt = items.net;
                let InclPrice = items.priceIncl;
                let MRP = items.mrp;
                let ItemShinecode = items.shinecode;
                let ProdNames = items.itemName;
                GRIDrows.eq(i).find('td').css("background-color", "").attr("title", "");
                if (NetAmt < 0) {
                    GRIDrows.eq(i).find('td').css("background-color", "#FFB6C1").attr("title", "Some items are have nagative values");
                    $("#" + currentNetAmtid).css("color", "red");
                    IsValid = false;
                    if (!errorthrowwed) {
                        showErrorSnackbar("Some items are have nagative values");
                    }
                }
               
                if ((InclPrice > MRP) && ProductID > 0) {
                    //$("#" + ProdFieldID).css("color", "red");
                    inclerroritems++;
                    inclerroritemnames += ProdNames + "\n";
                    GRIDrows.eq(i).find('td').css("background-color", "#fe7d65").attr("title", "Item Inclusive Price(" + InclPrice + ") cannot exceed MRP(" + MRP + ")");
                    InclGreaterMRPError = true;

                }
            });    
            if (InclGreaterMRPError && IsValid && !InclusiveMRPCheck) {
                var inclmrpProceed = confirm("Price Mismatch : " + inclerroritems + " item(s) have an Inclusive Price exceeding their MRP." + "\nItems : \n" + inclerroritemnames + "\nDo you want to proceed to save?");
                if (inclmrpProceed) {
                    IsValid = true;
                    InclusiveMRPCheck = true;
                }
                else {
                    IsValid = false;
                }
            }
        }
        if (IsValid) {
            var chkadj = $("#chkDocAdj").is(":checked");
            if (!chkadj && nIsDraft == 0 && SelectinvoiceinSR == "1") {
                IsValid = false;
                GetData(21, $("#txtCustomerID").val(), 0)
                showErrorSnackbar("Select Invoice Document");
                //$("#chkDocAdj").select();
            }
        }
        return IsValid;
    }
