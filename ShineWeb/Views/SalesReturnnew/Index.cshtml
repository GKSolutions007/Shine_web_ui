    function ReassignPricetypechangevalues(nProductID, itemRow, ItemRowIndex) {
        var invid = $("#txtID").val() != "" ? $("#txtID").val() : "0";
        var appprice = $("#cmbPriceType").val();// ApplyReturnPrice == "1" ? 6 : $("#cmbPriceType").val() == 0 ? 2 : $("#cmbPriceType").val();
        var ZeroBatchCheck = $("#chkShowZeroBatch").is(":checked") ? 1 : 0;
        $.ajax({
            url: Aurl + "salesreturn/get",
            type: 'get',
            contentType: 'json',
            data: {
                Mode: 23, DocPrefix: nDocPrefix, CodeName: nProductID, ID: invid, BranchID: $("#cmbBranch").val(),
                Date: $("#dtpDate").val(), PriceID: appprice, ShowZerobatch: ZeroBatchCheck
            },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                modal.hide();
                var trkbat = "False", trkpkd = "False";
                //showErrorSnackbar("Track Inv : "+trkInv);
                console.log("all Product Batch : ", data);
                if (data.length == 0) {
                    return;
                }
                var ItemMRP = itemRow.mrp;
                var dConvFact = itemRow.uomCF;
                var arrMRPbatch = [];
                var batchdata = data.filter(bt => bt.MRP == ItemMRP);
                if (batchdata.length > 0) {
                    var tb = batchdata[0];
                    arrMRPbatch.push(tb);
                } else {
                    var tb = data[0];
                    arrMRPbatch.push(tb);
                }
                console.log("Filter Product Batch : ", arrMRPbatch);
                $.each(arrMRPbatch, function (i, items) {//data
                    var Actq = items.ActQty;
                    var orgpr = items.SalesPrice;
                    var mrps = items.MRP;
                    var Btno = items.BatchNo;
                    var Btpkd = items.PKDDate;
                    var Btexp = items.ExpiryDate;
                    var actq = parseFloat(items.ActQty / dConvFact);//.toFixed(DecVal);
                    var shpri = parseFloat(items.SalesPrice * dConvFact);//.toFixed(DecVal);
                    var QtyType = items.QtyTag;
                    //parseFloat(items.MRP).toFixed(DecVal)
                    ////console.log("Price Type change :" ,Prodrowdata);'
                    var NewMRPonAmt = getSalesMRPontax(mrps);
                    //5,6,7
                    var TaxPern = itemRow.taxPct;
                    var tx = 1 + (TaxPern / 100);
                    var incl = itemRow.ApponMRPCum > 0 ? parseFloat(shpri) + itemRow.MRPonTaxAmt : parseFloat(shpri) * tx;

                    G.patch(ItemRowIndex, {
                        qtytype: QtyType, OrgPrice: orgpr, MRPonTaxAmt: NewMRPonAmt,
                        priceExcl: +shpri || 0, priceIncl: +incl, mrp: mrps, batchno: Btno, pkd: Btpkd, expiry: Btexp                        
                    }, 'items');
                });
            }
        });
    }
