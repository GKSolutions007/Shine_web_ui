                    updateInputColumn("txtFright", items.FrightAmt); updateInputColumn("txtOtherChargPern", items.OtherChargePern); updateInputColumn("txtOtherChargAmt", items.OtherChargeAmt);
                    updateInputColumn("txtProdDiscAmt", items.TotalProdDiscAmt); updateInputColumn("txtTradeDiscPern", items.TradeDiscPern); updateInputColumn("txtAddnlDiscPern", items.AddnlDiscPern);
                    updateInputColumn("txtTradeDiscAmt", items.TradeDiscAmt); updateInputColumn("txtAddnlDiscAmt", items.AddnlDiscAmt); updateInputColumn("txtRoundOff", items.RoundOffAmt);
                    updateLabelColumn("lblPTGross", parseFloat(items.GrossAmt)); updateLabelColumn("lblPTTax", parseFloat(items.TaxAmt));
                    updateLabelColumn("lblRoundNet", parseFloat(items.NetAmt));
                    updateLabelColumn("lblRoundNetFooter", parseFloat(items.NetAmt));
                    updateInputColumn("txtTCS", items.TCSTaxAmt); updateInputColumn("txtTDS", items.TDSAmount); updateInputColumn("txtWriteoff", items.WriteOffAmt);
