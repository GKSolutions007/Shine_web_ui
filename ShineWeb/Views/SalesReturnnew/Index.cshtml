    function loadselectedproductdetail(alSelectitem, gridrow, rowindex) {
        var CustID = $("#txtCustomerID").val() != "" ? $("#txtCustomerID").val() : 0;
        var itemcode = alSelectitem.code;
        var appprice = $("#cmbPriceType").val();// ApplyReturnPrice == "1" ? 6 : $("#cmbPriceType").val() == 0 ? 2 : $("#cmbPriceType").val();
        var ZeroBatchCheck = $("#chkShowZeroBatch").is(":checked") ? 1 : 0;
        $.ajax({
            url: Aurl + "salesreturn/get",
            type: 'get',
            contentType: 'json',            
            data: {
                Mode: 4, DocPrefix: nDocPrefix, CodeName: itemcode, ID: CustID, BranchID: $("#cmbBranch").val(),
                Date: $("#dtpDate").val(), PriceID: appprice, ShowZerobatch: ZeroBatchCheck
            },

            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                console.log("gridrow", gridrow, "data ", data);
                //~Assign Product Data
                modal.show();
                arrSalesTaxDetails = [];               
                TableBatch.draw().clear(); TableBatch.draw().clear();
                $.each(data, function (i, items) {
                    var uomforselprod = items.UOMList;
                    const t = taxById(items.SalesTaxID) || taxOf(items.GSTPern);
                    arrSalesTaxDetails = ReturnTaxDetails(items.SalesTaxID, 1);
                    var dApponMRPCum = arrSalesTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);                   

                    TempProd = items;
                    var trkinv = items.TrackInventory;
                    var trkbat = items.TrackBatch;
                    var trkpkd = items.TrackPKD;
                    var btQty = 0, btPrice = 0, btmrp = 0, btTag = 1, BTbat = "", BTpkd = "", BTexp = "", orgPrice = 0;
                    if (trkinv == "False") {
                        btQty = 0;
                        btPrice = items.SalesPrice * items.SalesCR;
                        btmrp = items.MRP;
                        btTag = 1;
                    }
                    else {
                        for (var k = 0; k < items.lstInvPopup.length; k++) {
                            if (k == 0) {
                                orgPrice = items.lstInvPopup[k].SalesPrice;
                                btQty = items.lstInvPopup[k].ActQty / items.SalesCR;
                                btPrice = items.lstInvPopup[k].SalesPrice * items.SalesCR;
                                btmrp = items.lstInvPopup[k].MRP;
                                btTag = items.lstInvPopup[k].QtyTag;

                                BTbat = items.lstInvPopup[k].BatchNo;
                                BTpkd = items.lstInvPopup[k].PKDDate;
                                BTexp = items.lstInvPopup[k].ExpiryDate;
                            }
                            TableBatch.row.add([
                                items.lstInvPopup[k].QtyTag,
                                items.lstInvPopup[k].ActQty,
                                items.lstInvPopup[k].SalesPrice,
                                items.lstInvPopup[k].MRP,
                                items.lstInvPopup[k].QtyType,
                                items.lstInvPopup[k].BatchNo,
                                items.lstInvPopup[k].PKDDate,
                                items.lstInvPopup[k].ExpiryDate,
                                parseFloat(items.lstInvPopup[k].ActQty / items.SalesCR).toFixed(DecVal),
                                parseFloat(items.lstInvPopup[k].SalesPrice * items.SalesCR).toFixed(DecVal),
                                parseFloat(items.lstInvPopup[k].MRP).toFixed(DecVal), 0
                            ]).draw(false);
                        }
                    }
                    var dMRPonTax = getSalesMRPontax(btmrp);
                    updateInputColumn("txtNBPPrice", items.PurchasePrice); updateInputColumn("txtNBSPrice", items.SalesPrice);
                    updateInputColumn("txtNBSPL", items.SPLPrice); updateInputColumn("txtNBECP", items.ECP);
                    updateInputColumn("txtNBMRP", items.MRP); updateInputColumn("txtNBRtnPrice", items.ReturnPrice);
                    $('#txtBatchTrackBatch').val(items.TrackBatch); $('#txtBatchTrackPKD').val(items.TrackPKD);
                    var BatEnb = items.TrackBatch == "True" ? true : false;
                    var PKDEnb = items.TrackPKD == "True" ? true : false;

                    $('#txtNBBathNo').prop("disabled", !BatEnb);
                    $('#dtpNBPKD,#dtpNBExp').prop("disabled", !PKDEnb);

                    $('#dtpNBPKD').prop("max", mind);
                    $('#dtpNBExp').prop("min", mind);

                    //TableBatch.column(5).visible(trkbat == "True");
                    //TableBatch.column(6).visible(trkpkd == "True");
                    //TableBatch.column(7).visible(trkpkd == "True");
                    //$(".modalBatch").css("width", "30%");
                    //if (trkpkd == "True")
                    //    $(".modalBatch").css("width", "35%");
                    //if (items.lstInvPopup.length <= 1) {
                    //    $("#tblBatch>tbody>tr:first").trigger('click');
                    //    //modal.hide();
                    //} else {
                    //    modal.show();
                    //    $("#tblBatch>tbody>tr:first").trigger('click');
                    //}
                    var trkivYN = items.TrackInventory == "True" ? 1 : 0;
                    var batchYN = BatEnb ? 1 : 0;
                    var pkdYN = PKDEnb ? 1 : 0;
                    var SerYN = 0;
                    var BatchCount = parseInt(TableBatch.rows().count());
                    var DefQty = BatchCount > 0 ? 1 : trkivYN == 1 ? 0 : 1;
                    var PPrice = parseFloat(btPrice);
                    var InclPPrice = dApponMRPCum > 0 ? PPrice + dMRPonTax : PPrice + ((PPrice * parseFloat(items.GSTPern)) / 100);
                    var MRP = parseFloat(btmrp).toFixed(4);//items.MRP
                    $("#lblBatchItemName").text(items.Name);
                    $("#txtItemRowIndex").val(rowindex);
                    gridrow.patch(rowindex, {
                        productID: +items.ProdID || 0,  ApponMRPCum: dApponMRPCum, MRPonTaxAmt: dMRPonTax, OrgPrice: orgPrice,
                        TrkInvYN: trkivYN, TrkBatchYN: batchYN, TrkPKDYN: pkdYN, TrkSerial: SerYN, batchno: BTbat, pkd: BTpkd, expiry: BTexp,
                        qtytype: btTag, TransPrice: items.ItemTransactionPrice, stock: parseFloat(items.ActQty).toFixed(DecVal), freestock: parseFloat(items.ActFreeQty).toFixed(DecVal),
                        itemName: items.Name, code: items.Code,
                        mrp: +MRP || 0,qty: +DefQty,
                        priceExcl: +PPrice || 0, priceIncl: +InclPPrice || 0,
                        _uoms: uomforselprod, uomID: +TempProd.SalesUomID || 0, prodPct: parseFloat(items.ProductDiscPerc), tradePct: parseFloat(items.TradeDiscPerc),
                        taxID: t ? +t.ID : 0, taxPct: t ? +t.TaxPern : (+items.TaxPern || 0), reasonID: 0, batchtype : 0
                    }, 'items');

                    startAutoDraftSave();
                    setTimeout(() => {
                        modal.show();
                        if (items.lstInvPopup.length > 0) {
                            //$("#tblBatch>tbody>tr:first").trigger('click');
                            var firstRow = $("#tblBatch > tbody > tr:first");

                            if (!firstRow.hasClass('selected')) {
                                firstRow.trigger('click');
                            }
                        }
                        TableBatch.column(5).visible(trkbat == "True");
                        TableBatch.column(6).visible(trkpkd == "True");
                        TableBatch.column(7).visible(trkpkd == "True");
                        $(".modalBatch").css("width", "30%");
                        if (trkpkd == "True")
                            $(".modalBatch").css("width", "35%");
                        if (TableBatch) TableBatch.columns.adjust().draw();
                        
                    }, 300);
                    if (BatchCount == 0 && trkivYN == 1) {
                        showErrorSnackbar("No Qty in Inventory");
                    }
                    var prodrowcount = G.getData();
                    if (prodrowcount.length == (rowindex + 1)) {
                        G.addRow();
                    }

                    //modal.show();

                });
            }
        });
    }
