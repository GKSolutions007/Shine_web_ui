                            //ProdDisc = parseFloat($(this).attr("txttag"));
                            var price = SaleTrdDiscb4Prod ? (ExclPrice * qty) : ((ExclPrice * qty) - ProdDiscAmt);
                            TrDiscAmt = parseFloat((price * TrDisc) / 100);
                            updateInputColumn(fieldID, TrDiscAmt);
                        }
                        if (fieldName == "AddnlDiscPern") {
                            AddnlDisc = parseFloat($(this).attr("txttag"));
                        }
                        if (fieldName == "AddnlDiscAmt") {
                            var price = SaleAddnlDiscb4Prod ? (ExclPrice * qty) : ((ExclPrice * qty) - ProdDiscAmt);
                            AddnlDiscAmt = parseFloat((price * AddnlDisc) / 100);
                            updateInputColumn(fieldID, AddnlDiscAmt);
                        }
                    });
                    $(this).find("select").each(function (index) {
                        const fieldName = $(this).attr("name");
                        const fieldID = $(this).attr("id");
                        if (fieldName == "UOM") {
                            var val = $('option:selected', this).attr('name');
                            CFValue = parseFloat(val);
                        }
                    });
                    $(this).find("label").each(function (index) {
                        const fieldName = $(this).attr("name");
                        const fieldID = $(this).attr("id");
                        var price = (ExclPrice * qty);
                        if (fieldName == "Goods") {
                            var gds = parseFloat(price);//;
                            //$(this).text(gds);
                            updateLabelColumn(fieldID, gds);
                            dPTGoods = gds;
                        }
                        if (fieldName == "Gross") {
                            var grs = (parseFloat(price) - (TrDiscAmt + AddnlDiscAmt + ProdDiscAmt));//;
                            //$(this).text(grs);
                            updateLabelColumn(fieldID, grs);
                            dPTGross = grs;
                        }
                        if (fieldName == "TaxAmt") {
                            var tamt = ApponMRPCum > 0 ? (qty * parseFloat(TotMRPonTaxAmt)) : ((TaxPern * dPTGross) / 100);//;
                            //$(this).text(tamt);
                            updateLabelColumn(fieldID, tamt);
                            dPTTax = tamt;
                        }
                        if (fieldName == "NetAmt") {
                            neta = (parseFloat(dPTGross) + parseFloat(dPTTax));//;
                            //$(this).text(neta);
                            updateLabelColumn(fieldID, neta);

                            //dPTNet = parseFloat($(this).text());
                        }
                        if (fieldName == "DiffValue") {
                            if (dQty > 0) {
                                var val = dPTGross / dQty;
                                var Diff = (TInvoicePrice * CFValue) - val;
                                var AbsDiff = Diff;// Math.abs(Diff);
                                updateLabelColumn(fieldID, AbsDiff);
                                var clrcolor = Diff >= 0 ? "green" : "red";
                                $(this).css("color", clrcolor);
                            }
                            else {
                                updateLabelColumn(fieldID, 0);
                                $(this).css("color", "black");
                                //DiffExcl += 0;
                                //DiffIncl += 0;
                            }
                        }
                    });

                }
                else {
                    if (id != null) {
                        updateInputColumn(id, 0);
                        showErrorSnackbar("Qty Mismatched. Qty should be less than Batch Qty only.")
                    }
                }
            }
        });
        calculateProdGrid();
    }
