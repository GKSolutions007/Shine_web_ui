                if (isAddNBVisib) {
                    $("#btnAddNB").trigger("click");
                }
            }
            if (k === 'F8') {
                if (el.dataset.key === 'itemName') {
                    var productID = el.closest('tr').querySelector('[data-key="productID"]').value;
                    F8ItemID = e.target.id;
