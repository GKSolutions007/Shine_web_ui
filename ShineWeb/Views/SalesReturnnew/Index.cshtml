    function applyBatchdatatoItemrow(rowdata) {
        var updatebatchrowindex = $("#txtItemRowIndex").val();
        var nPricttype = $("#cmbPriceType").val();
        var getrowdatadata = G.getData();
        var currentrowdata = getrowdatadata[updatebatchrowindex];
