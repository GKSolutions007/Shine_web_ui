    $("#btnClose").click(function () {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        if ($("#txtTransType").val() == 3 || $("#txtTransType").val() == 2) {
            this.close();
        } else {
            $("#dvMain").hide();
            $("#dvDocuments").show();
            GetFilterData();
            $("#MainHeading").text("Delivery");
        }
    }
    //~Clear
    $("#btnClear").click(function () {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".FormclrField,.FormfilterclrField").val("");
        $(".FormclrcmbField").val(0);
        $(".clrdivs").html("");
        
        $(".FormclrField,.FormclrcmbField,#btnSave,#btnClear,#btnClose,.FormfilterclrField,#chkSelectAllInvoice,#btnApplyFilter").prop("disabled", false);
        GetData(1);
        $("#btnEmail,#btnWhatsapp").hide();
        setDate("dtpDate", 0);
        setDate("dtpInvFFrom", 0);
        setDate("dtpInvFTo", 0);
        SetFilterDate();
        nIsDraft = 0;
        if (nTransMode != 1) {  
            $("#dvMain").hide();
            $("#dvDocuments").show();
        }
        $("#txtNoofCopies").val("1");
        ProductTable.draw().clear(); ProductTable.draw().clear();
        InvoiceTable.draw().clear(); InvoiceTable.draw().clear();
        
        $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint").hide();
        $("#btnSave,#btnClear,#btnDraft,#btnLoadProduct").show();
        $("#MainHeading").text("Delivery");
        $("#btnSave").prop("disabled", false);
        setTimeout(() => {
            if ($("#txtEnableBranch").val() == 1) {
                $("#txtBranchName").prop("disabled", true);
            }
            //$("#txtBranchName").val(DefBranch);
            LoadBranchByRoles('#txtBranchName');
        }, 300);
        setTimeout(() => {
            var DocDate = $("#dtpDate").val();
            var Branch = $("#txtBranchName").val();
            GetDocumentID(DocDate, Branch, 23);
        }, 500);
    }
    //~Validation
    var CheckedInvoiceIDs = "";
    function SaveValidation() {
        var IsValid = true;
        $(".clrdivs").html("");
        CheckedInvoiceIDs = "";
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#divErrDate").html("Date should not be empty");
            showErrorSnackbar("Date should not be empty");
        }

        if (ProductTable.rows().count() == 0) {
            IsValid = false;
            $("#dvErrorDocid").html("Add atleat one product in Grid");
            showErrorSnackbar("Add atleat one product in Grid");
        }
        if ($("#cmbSalesman").val() == 0) {
            IsValid = false;
            $("#divErrSalesman").html("Select Salesman");
            showErrorSnackbar("Select Salesman");
        }
        if ($("#cmbVehicle").val() == 0) {
            IsValid = false;
            $("#divErrVehicle").html("Select Vehicle");
            showErrorSnackbar("Select Vehicle");
        }
        if ($("#txtBranchName").val() == 0) {
            IsValid = false;
            $("#divErrBranch").html("Select Branch");
            showErrorSnackbar("Select Branch");
        }
        if (InvoiceTable.rows().count() > 0) {
            $('#tblInvoices tbody tr').each(function () {
                rowdata = InvoiceTable.row($(this)).data();
                InvID = rowdata.ID;
                var currrowchecked = $(this).find("input[type=checkbox]").is(":checked");
                if (currrowchecked) {
                    CheckedInvoiceIDs += InvID + ",";
                }
            });
            if (CheckedInvoiceIDs == "") {
                IsValid = false;
                $("#dvErrorDocid").html("Select atleast one Document");
                showErrorSnackbar("Select atleast one Document");
            }

        }
        else {
            IsValid = false;
            $("#dvErrorDocid").html("Select atleast one Document");
            showErrorSnackbar("Select atleast one Document");
        }
        return IsValid;
    }
    function SaveData() {
        if (SaveValidation()) {
            $("#btnSave").prop("disabled", true);
            var listTrans = {
                "TransMode": nTransMode,
                "ID": $("#txtID").val(),
                "DocDate": $("#dtpDate").val(),
                "DocPrefix": 23,
                "RefNo": $("#txtRefNo").val(),
                "BranchID": $("#txtBranchName").val(),
                "SalesmanID": $("#cmbSalesman").val(),
                "VehicleID": $("#cmbVehicle").val(),
                "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : $("#txtStatus").val(),
                "CurrentStatus": $("#txtStatus").val(),
                "Remarks": $("#txtRemarks").val(),
                "Narration": $("#txtNarration").val(),
                "DocumentIDs": CheckedInvoiceIDs,// $("#txtDocIDs").val(),
                "FilterBranch": $("#cmbCommonDocFilterBranch").val(),
                "UID": UID,
            }
            $.ajax({
                url: Aurl + "delivery/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(listTrans),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                            GetFilterData();
                        }
                        else {
                            showErrorSnackbar(items.Message);
                        }
                    });
                }
            });
        }
    }
    $("#btnSave").click(function () {
        if (cfFocus != 3) {
            ConfirmDialogMsg("Do you want to save data?");
        } else {
            SaveData();
        }
    });
</script>