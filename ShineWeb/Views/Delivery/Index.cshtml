<script>
    //~Filter Action Buttons
    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canEdit: $("#txtModifyID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canCancel: $("#txtCancelID").val() == 1,
        canReturn: $("#txtReturnID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    var allGridActions = [], singleIconAction = [], menuActions = [], columns = [];
    var actions = {}, OtherActions = {};

    function LoadPermissions() {
        allGridActions = [
            {
                icon: '\u{1F441}\u{FE0F}',
                title: 'View Data',
                className: 'dg-action-view',
                displayType: 'single_icon',
                visible: mapusersRole.canView,
                handler: (rowdata) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    nTransMode = 5;
                    $("#txtID").val(ID);
                    GetDeliveryData(3, ID);
                    $(".FormclrField,.FormclrcmbField,.FormfilterclrField").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDocFilter,#chkSelectAllInvoice").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft,#btnApplyFilter").prop("disabled", true);
                    $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
                    $("#btnPreview,#btnPDF,#btnPrint").show();
                    $("#btnSave,#btnClear,#btnDraft,#btnLoadProduct").hide();
                    $("#dvMain").show();
                    $("#dvDocuments").hide();
                    $("#btnEmail,#btnWhatsapp").show();
                    $("#MainHeading").text("View Delivery");
                }
            },
            {
                icon: '\u{270F}\u{FE0F}',
                title: 'Edit',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed') {
                        if (mapusersRole.canEdit)
                            isVisible = true;
                    }
                    if (row.dtlClose > 0)
                        isVisible = false;
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[9];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        nTransMode = 2;
                        GetDeliveryData(3, ID);
                        $(".FormclrField,.FormclrcmbField,#btnApplyFilter,.FormfilterclrField").prop("disabled", false);
                        $("#btnSave,#btnClose,#btnDocFilter,#btnViewInvoices, #btnAddInvoices,#chkSelectAllInvoice").prop("disabled", false);
                        $("#btnPreview,#btnPDF,#btnClear,#btnPrint").prop("disabled", true);
                        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
                        $("#btnSave,#btnLoadProduct").show();
                        $("#btnSave,#btnClose").prop("disabled", false);
                        $("#dvMain").show();
                        $("#dvDocuments").hide();
                        $("#btnEmail,#btnWhatsapp").hide();
                        $("#MainHeading").text("Modify Delivery");
                        if ($("#txtEnableBranch").val() == 1) {
                            $("#txtBranchName").prop("disabled", true);
                        }
                    }
                    else {
                        showErrorSnackbar("Cannot Modify.This document already cancelled");
                    }
                }
            },
            {
                icon: '\u{21A9}\u{FE0F}',
                title: 'Return',
                className: 'dg-action-return',
                visible: (row) => {
                    var isVisible = false;
                    var RTNYN = row.Status == 'Amended' || row.Status == 'Cancelled' || row.Status == 'Close' || row.Status == 'Processed' ? false : true;
                    if (mapusersRole.canReturn && RTNYN) {
                        isVisible = true;
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status[9];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        $("#MainHeading").text("Return Delivery")
                        nTransMode = 6;
                        GetDeliveryData(3, ID);
                        $(".FormclrField,.FormclrcmbField,#btnApplyFilter,.FormfilterclrField").prop("disabled", true);
                        $("#btnSave,#btnClose").prop("disabled", false);
                        $("#btnPreview,#btnPDF,#btnClear,#btnDraft,#btnPrint").prop("disabled", true);
                        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
                        $("#txtDocIDs,#txtRemarks,#txtNarration,#chkSelectAllInvoice").prop("disabled", false);
                        $("#btnEmail,#btnWhatsapp").hide();
                        $("#btnSave,#btnLoadProduct").show();
                        $("#dvMain").show();
                        $("#dvDocuments").hide();
                    }
                    else {
                        showErrorSnackbar("This document already cancelled");
                    }
                }
            },
            {
                icon: '\u{1F5A8}\u{FE0F}',
                title: 'Print',
                className: 'dg-action-edit',
                visible: mapusersRole.canPrint,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPrint").click();
                }
            },
            {
                icon: '\u{1F5A8}\u{FE0F}',
                title: 'Preview',
                className: 'dg-action-edit',
                visible: mapusersRole.canPreview,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPreview").click();
                }
            },
            {
                icon: "<i class='fa-regular fa-file-pdf' style='color:brown'></i>",
                title: '&ensp;PDF',
                className: 'dg-action-edit',
                visible: mapusersRole.canPDF,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPDF").click();
                }
            },
            {
                icon: "<i class='fa-solid fa-envelope' style='color:brown'></i>",
                title: '&ensp;Mail',
                className: 'dg-action-edit',
                visible: true,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnEmail").click();
                }
            },
            {
                icon: "<i class='fa-brands fa-whatsapp' style='color:green'></i>",
                title: '&ensp;WhatsApp',
                className: 'dg-action-edit',
                visible: true,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btniframeWhatsapp").click();
                }
            },
        ];
        singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
        menuActions = allGridActions.filter(a => a.displayType === 'menu_item');
        actions = {
            "header": 'View',
            "type": "action",
            "width": 60,
            "align": "center",
            "visible": mapusersRole.canView,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": singleIconAction
        };
        OtherActions = {
            "header": "Action",
            "type": "action3dots",
            "width": 60,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": menuActions
        }
    }

    LoadPermissions();

</script>
<script type="text/javascript">
    $("#txtDocID").prop("disabled", true);
    $("#dvMain").hide();
    var ProductTable = $('#tblProductDetails').DataTable({
        paging: false,
        searching: true,
        info: false,
        ordering: false,
        scrollY: "250px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0], "visible": false, searchable: false, filter: false, ordering: false }],
    });
    var InvoiceTable = $('#tblInvoices').DataTable({
        paging: false,
        searching: true,
        info: false,
        ordering: false,
        scrollY: "250px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0], "visible": false, searchable: false, filter: false, ordering: false }],
    });
    
    var UID = '@Session["LoginUserID"]';
var Aurl = '@Session["APIurl"]';
LoadBranchByRoles('#txtBranchName');
var DecVal = '@Session["DecimalValues"]';
var RID = '@Session["RoleID"]';
var nTransMode = 1, nIsDraft = 0;
var PrintTransID = 10, PrintConfigID = 0;
var grid, AssignInvoices;
GetColumnSettingsData(2, 37, 1,true);
GetPrintProfile(PrintTransID);
setDate("dtpDate", 0);
setDate("dtpFFrom", 0);
    setDate("dtpFTo", 0);
    setDate("dtpInvFFrom", 0);
    setDate("dtpInvFTo", 0);
setTimeout(function () { GetFilterData(); }, 800);
    GetData(1);
    $('#btnFilter').click(function (e) {
    GetFilterData(1);
    });
    function GetData(nMode,strID = "") {
        $.ajax({
            url: Aurl + "delivery/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, ID: strID },
            xhrFields: {
                withCredentials: true
            },
            //async : false,
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbSalesman,#cmbVehicle').find("option").remove();
                    $('#cmbSalesman,#cmbVehicle').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    var VehicleData = data.Table;
                    var Salesman = data.Table1;
                    var Beats = data.Table2;
                    var Customers = data.Table3;
                    var arrMultiSelSMData = [];
                    $.each(VehicleData, function (i, items) {
                        $('#cmbVehicle').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    $.each(Salesman, function (i, items) {
                        arrMultiSelSMData.push({ "label": items.Name, "value": items.ID });
                        $('#cmbSalesman').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    //~Multiselect-Beat
                    GKBSPaginatedMultiSelect({
                        inputId: 'txtBeatName',
                        data: Beats,
                        onSelect: function (items) { /* optional live hook */ }
                    });
                    //~Multiselect-Beat
                    GKBSPaginatedMultiSelect({
                        inputId: 'txtSalesmanName',
                        data: arrMultiSelSMData,
                        onSelect: function (items) { /* optional live hook */ }
                    });
                    //~Multiselect-Beat
                    GKBSPaginatedMultiSelect({
                        inputId: 'txtCustomerName',
                        data: Customers,
                        onSelect: function (items) { /* optional live hook */ }
                    });
                } 
            }
        });
    }
var Showall = '@Session["Showallstatus"]';
$("#chkShowAll").prop("checked", Showall == '1');
    function GetFilterData(ClickType = 0) {//arrVendorName,divErrFTo,divErrFFrom,divErrFParty
        var IsValid = true;
        $(".clrdivs").html("");
        if ($("#dtpFFrom").val() == "") {
            IsValid = false;
            $("#divErrFFrom").html("From date should not be empty");
        }
        if ($("#dtpFTo").val() == "") {
            IsValid = false;
            $("#divErrFTo").html("To date should not be empty");
        }
        if ($("#dtpFFrom").val() > $("#dtpFTo").val()) {
            IsValid = false;
            $("#divErrFFrom").html("From date should be lessthan To Date");
        }
        if (IsValid) {
            DeliveryInvoices = [];
            var dFrom = $("#dtpFFrom").val(), dTo = $("#dtpFTo").val(), chkshow = $("#chkShowAll").is(":checked") ? "1" : "0";
            $.ajax({
                url: Aurl + "delivery/filterdata",
                type: 'get',
                contentType: 'json',
                data: { Mode: 2, FromDate: dFrom, ToDate: dTo, Showall: chkshow },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    DeliveryInvoices = data;
                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                    grid = new GKBSDynamicGrid('#my-grid', columns, DeliveryInvoices, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        height: "600px",
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,
                        enableAddRow: false,
                        enableRemoveRow: false,
                        enableSorting: true,
                        enableDarkMode: false,
                        searchTerm: currentSearchValue,
                        CompanyName: "",
                        ReportName: "",
                        fitersdata: [],
                        singleIconAction: singleIconAction,
                        rowActionsMenu: menuActions,
                        customCellRenderer: (el, col, rowData) => {

                        },
                        customButtons: [
                            {
                                icon: '\u{2699}\u{FE0F}',
                                text: 'Settings',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {
                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 37, 1, 0);
                                }
                            },
                            {
                                icon: '\u{2795}',
                                text: 'Add New',
