                                        value.Status == 4 ? '<label class="stsCancel">Cancel</label>' :
                                            value.Status == 5 ? '<label class="stsClose">Delivered</label>' :
                                                value.Status == 6 ? '<label class="stsReturn">Return</label>' : ''
