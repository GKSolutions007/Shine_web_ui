@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}

<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_GRID_2.0/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_GRID_2.0/js/gridui.js"></script>
<script src="~/Scripts/multiselect/GKBSmultiselectiondropdown.js"></script>

<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>
<style>
    th, td {
        white-space: nowrap;
    }

    hr {
        margin: 1rem 0;
        color: inherit;
        border: 0;
        border-top: 1px solid;
        opacity: .25;
    }

    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        /*padding: 6px 12px;*/
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -60%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -28%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }
    /*input:focus + .labelup,
    input:not(:placeholder-shown) + .labelup, textarea:focus + .labelup, textarea:not(:placeholder-shown) + .labelup {
        top: -35%;
        font-size: .9em;
        padding: 0 .3em;
        background: #F9F9F9;
        color: #000000;
    }*/
    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }

    /* ===== Compact Input Styling ===== */
    .form-control,
    select.form-control,
    input.form-control,
    textarea.form-control,
    .gdInput,
    select.gdInput,
    input.gdInput {
        padding: 4px 8px !important;
        font-size: 12px !important;
        height: 28px !important;
        line-height: 1.4 !important;
    }

    textarea.form-control {
        height: auto !important;
        min-height: 60px !important;
    }

    select.form-control,
    select.FormclrcmbField {
        padding: 3px 8px !important;
    }

    /* Reduce spacing in form-label containers */
    .form-label {
        margin-bottom: 6px !important;
    }

    /* Reduce label font size */
    /*    .labelup {
        font-size: 12px !important;
    }*/

    /* Reduce table cell padding */
    table td {
        padding: 4px !important;
    }

    /* Reduce spacing for error divs */
    div[id^="divErr"] {
        padding-top: 2px !important;
        padding-left: 5px !important;
        font-size: 11px !important;
    }

    /* Compact row spacing */
    .row {
        margin-bottom: 8px !important;
    }

    /* Reduce button sizes slightly */
    .btn {
        padding: 5px 12px !important;
        font-size: 13px !important;
    }

    /* ===== Modern Delivery Form Styles ===== */
    #dvMain {
        animation: fadeSlideIn 0.35s ease;
    }
    @@keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* Modern card panel */
    .del-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        padding: 5px 10px 10px;
        transition: box-shadow .2s;
    }
    .del-card:hover { box-shadow: 0 4px 18px rgba(0,0,0,.1); }

    .del-card-header {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #4f6eb4;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 1px solid #eef2f9;
    }
    .del-card-header i { font-size: 13px; color: #6c8dd6; }

    /* Floating-label field */
    .fld-wrap {
        position: relative;
        margin-bottom: 4px;
    }
    .fld-wrap .fld-icon {
        position: absolute;
        left: 9px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 12px;
        pointer-events: none;
        z-index: 2;
    }
    .fld-wrap input.form-control,
    .fld-wrap select.form-control,
    .fld-wrap textarea.form-control {
        padding-left: 28px !important;
        border-radius: 8px !important;
        border: 1.5px solid #dde3ef !important;
        background: #f8faff !important;
        transition: border-color .2s, box-shadow .2s;
    }
    .fld-wrap input.form-control:focus,
    .fld-wrap select.form-control:focus,
    .fld-wrap textarea.form-control:focus {
        border-color: #6c8dd6 !important;
        box-shadow: 0 0 0 3px rgba(108,141,214,.15) !important;
        background: #fff !important;
    }
    .fld-wrap .labelup, .fld-wrap .labelupfortextarea {
        left: 28px;
    }

    /* DocID badge display */
    .docid-badge {
        background: linear-gradient(135deg,#eef4ff,#dce8ff);
        border: 1px solid #c5d8ff;
        border-radius: 10px;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 700;
        color: #2d5be3;
        letter-spacing: .3px;
    }
    .docdate-wrap input { border-radius: 8px !important; }

    /* Filter panel */
    .filter-panel {
        background: #f8faff;
        border: 1px solid #dde3ef;
        border-radius: 12px;
        padding: 12px 14px;
    }
    .filter-panel .section-title {
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #6c8dd6;
        margin-bottom: 8px;
    }

    /* Invoice DataTable toolbar */
    .inv-table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 6px;
    }
    .inv-table-toolbar .toolbar-left { display: flex; gap: 5px; align-items: center; }
    .inv-table-toolbar .toolbar-right { display: flex; gap: 5px; align-items: center; }

    /* Toolbar buttons */
    .btn-export-inv {
        background: linear-gradient(135deg,#6c8dd6,#4f6eb4);
        color: #fff !important;
        border: none;
        border-radius: 7px;
        font-size: 11px;
        padding: 4px 10px !important;
        display: inline-flex; align-items: center; gap: 4px;
        transition: transform .15s, box-shadow .15s;
    }
    .btn-export-inv:hover { transform: translateY(-1px); box-shadow: 0 3px 8px rgba(79,110,180,.3); }

    .btn-load-inv {
        background: linear-gradient(135deg,#22c55e,#16a34a);
        color: #fff !important;
        border: none;
        border-radius: 7px;
        font-size: 11px;
        padding: 4px 10px !important;
        display: inline-flex; align-items: center; gap: 4px;
        transition: transform .15s, box-shadow .15s;
    }
    .btn-load-inv:hover { transform: translateY(-1px); box-shadow: 0 3px 8px rgba(22,163,74,.3); }

    /* Modern footer action bar */
    .footerAction {
       /* background: linear-gradient(135deg,#f0f4ff,#eef2fb) !important;*/
        border-top: 1px solid #dde6f7 !important;
        border-radius: 0 !important;
        box-shadow: 0 -2px 12px rgba(79,110,180,.08) !important;
    }
    .footerAction .btn {
        border-radius: 8px !important;
        font-size: 12px !important;
        padding: 5px 13px !important;
       /* display: inline-flex !important;*/
        align-items: center !important;
        gap: 5px !important;
        transition: transform .15s, box-shadow .15s !important;
    }
    .footerAction .btn:hover { transform: translateY(-1px) !important; }

    /* Checkbox row */
    .modern-check {
        display: flex; align-items: center; gap: 6px;
        padding: 4px 0;
    }
    .modern-check input[type=checkbox] { width: 15px; height: 15px; accent-color: #4f6eb4; }
    .modern-check label { font-size: 12px; color: #475569; margin: 0; }

    /* Apply filter button */
    .btn-apply-filter {
        background: linear-gradient(135deg,#4f6eb4,#3b5aa0);
        color: #fff !important;
        border: none;
        border-radius: 8px;
        width: 100%;
        font-size: 12px;
        padding: 6px !important;
        display: inline-flex; align-items: center; justify-content: center; gap: 5px;
        transition: transform .15s, box-shadow .15s;
    }
    .btn-apply-filter:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(79,110,180,.3); }

    /* Input-group opener icon */
    .input-group-text.opener-btn {
        background: #eef4ff;
        border: 1.5px solid #dde3ef;
        border-radius: 8px 0 0 8px !important;
        color: #4f6eb4;
        cursor: pointer;
        transition: background .2s;
        height: 28px !important;
    }
    .input-group-text.opener-btn:hover { background: #dce8ff; }

    @@media (max-width: 767px) {
        .del-card { padding: 10px 12px 8px; }
        .docid-badge { font-size: 12px; }
        .inv-table-toolbar { flex-direction: column; align-items: flex-start; }
    }
    .invffield {
        font-size: 9px;
        font-weight: 700;
        color: #6c8dd6;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 2px;
    }
    .stsOpen {
        background-color: slateblue;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }

    .stsCancel {
        background-color: orangered;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }
    .stsReturn {
        background-color: lightpink;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }
    .stsClose {
        background-color: darkgreen;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }
</style>

<body>
    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.Return, new { @autocomplete = "off", @class = "form-control", @id = "txtReturnID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <div class="toastBox"></div>
    <div id="dvDocuments">
        <hr />
        <input hidden id="txtStatus" />
        <div class="w-100 mt-3">
            <div class="d-flex justify-content-end align-items-start mb-2 flex-wrap gap-2">

                <!-- Filter Controls -->
                <div class="d-flex align-items-start gap-2 flex-wrap">

                    <!-- Date Type -->
                    <div>
                        <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                    </div>

                    <!-- From Date -->
                    <div>
                        <span class="form-label">
                            <input tabindex="1" class="form-control" type="date" id="dtpFFrom"
                                   oninput="if (this.value > this.max) { this.value = this.max; }">
                            <label class="labelup" for="dtpFFrom">From</label>
                        </span>
                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFFrom"></div>
                    </div>

                    <!-- To Date -->
                    <div>
                        <span class="form-label">
                            <input tabindex="1" class="form-control" type="date" id="dtpFTo"
                                   oninput="if (this.value > this.max) { this.value = this.max; }">
                            <label class="labelup" for="dtpFTo">To</label>
                        </span>
                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFTo"></div>
                    </div>

                    <!-- All Status Checkbox -->
                    <div class="d-flex align-items-center gap-1">
                        <input tabindex="1" class="form-check-input" type="checkbox" id="chkShowAll" style="font-size:14px;">
                        <label class="form-check-label" for="chkShowAll" style="font-size:14px;">All Status</label>
                    </div>

                    <!-- Filter Button -->
                    <div>
                        <button id="btnFilter" class="btn btn-primary">
                            <i class="bi bi-funnel" style="color:white;"></i>&#x2009;Filter
                        </button>
                    </div>

                </div>

            </div>

            <!-- Grid -->
            <div id="my-grid" style="height:500px; width:100%;"></div>

        </div>
    </div>
    
    <div id="dvMain">
        <hr />
        <!-- ===== Header Card ===== -->
        <div class="del-card">
            
            <div class="row g-2 mt-2 align-items-start">
                <!-- Assign To -->
                <div class="col-12 col-sm-6 col-md-2">
                    <div class="input-group">
                        <span hidden id="opensalesman" class="input-group-text opener-btn" title="New Salesman">
                            <span class="fas fa-arrow-up-right-from-square" style="font-size:11px;"></span>
                        </span>
                        <span class="form-label flex-fill fld-wrap">
                            <i class="bi bi-person-badge fld-icon"></i>
                            <select class="form-control FormclrcmbField" id="cmbSalesman">
                                <option value="0">Select Salesman</option>
                            </select>
                            <label class="labelup" for="cmbSalesman">Assign To <code>*</code></label>
                        </span>
                    </div>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrSalesman"></div>
                </div>

                <!-- Vehicle -->
                <div class="col-12 col-sm-6 col-md-2">
                    <div class="input-group">
                        <span hidden id="openvehicle" class="input-group-text opener-btn" title="New Vehicle">
                            <span class="fas fa-arrow-up-right-from-square" style="font-size:11px;"></span>
                        </span>
                        <span class="form-label flex-fill fld-wrap">
                            <i class="bi bi-truck fld-icon"></i>
                            <select class="form-control FormclrcmbField" id="cmbVehicle">
                                <option value="0">Select Vehicle</option>
                            </select>
                            <label class="labelup" for="cmbVehicle">Vehicle <code>*</code></label>
                        </span>
                    </div>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrVehicle"></div>
                </div>

                <!-- Branch -->
                <div class="col-12 col-sm-6 col-md-2">
                    <div class="fld-wrap">
                        <i class="bi bi-building fld-icon"></i>
                        <span class="form-label">
                            <select class="form-control FormclrcmbField" id="txtBranchName" @(Model.EnableBranch == "1" ? "disabled" : "")>
                                <option value="0">Select Branch</option>
                            </select>
                            <label class="labelup" for="txtBranchName">Branch <code>*</code></label>
                        </span>
                    </div>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrBranch"></div>
                </div>

                <!-- Ref No -->
                <div class="col-12 col-sm-6 col-md-2">
                    <div class="fld-wrap">
                        <i class="bi bi-hash fld-icon"></i>
                        <span class="form-label">
                            <input tabindex="1" class="form-control FormclrField" type="text" id="txtRefNo" placeholder=""
                                   onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRefNo')"
                                   oninput="sanitizeAlphaNumeric(this, '#divErrRefNo')" />
                            <label class="labelup" for="txtRefNo">Ref No</label>
                        </span>
                    </div>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrRefNo"></div>
                </div>

                <!-- Spacer -->
                <div class="col-12 col-md-1 d-none d-md-block"></div>

                <!-- Doc ID + Date -->
                <div class="col-12 col-sm-12 col-md-3 ms-auto">
                    <div class="d-flex align-items-center justify-content-end gap-3 flex-wrap">
                        @*  <div class="text-center">
            <div style="font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px;">
                <i class="bi bi-file-earmark-check me-1"></i>Doc ID
            </div>
            <div class="docid-badge"><label id="lblDocID" docprefix="" class="fw-bolder" style="font-size:14px;">AI/2425/001</label></div>
        </div>
        <div class="text-center">
            <div style="font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px;">
                <i class="bi bi-calendar3 me-1"></i>Date
            </div>
            <input class="clsdtpfieldbottomborder FormclrField" type="date" id="dtpDate"
                   style="font-size:13px;border-radius:8px;border:1.5px solid #dde3ef;background:#f8faff;padding:3px 8px;"
                   oninput="if (this.value > this.max) { this.value = this.max; }" />
        </div>*@

                        <table>
                            <tr>
                                <td style="border:none;">
                                    <span class="fw-semibold">Doc ID :</span>
                                </td>
                                <td style="border:none;">
                                    <label id="lblDocID" docprefix="" class="fw-bolder" style="font-size:14px;">AI/2425/001</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:none;">
                                    <label style="font-size:14px">Date :</label>
                                </td>
                                <td style="border:none;">
                                    <input class="clsdtpfieldbottomborder FormclrField" type="date" id="dtpDate"
                                           style="font-size:14px"
                                           oninput="if (this.value > this.max) { this.value = this.max; }" />
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

            </div>
        </div>
        <!-- ===== Doc Filter + Invoice Table + Product Table ===== -->
        <div class="row g-2 mb-2">
            <!-- Filter Panel -->
            <div class="col-12 col-md-3">
                <div class="del-card h-100">
                    <div class="del-card-header"><i class="bi bi-funnel"></i> Invoice Filter</div>

                    <div class="fld-wrap mb-1">

                        <div class="invffield">
                            <i class="bi bi-map me-1"></i>Beat
                        </div>
                        <span class="form-label">
                            <input class="FormfilterclrField form-control" type="text" id="txtBeatName">

                        </span>
                        <div class="text-danger small px-2 clrdivs" id="dvErrorBeatName"></div>
                    </div>

                    <div class="fld-wrap mb-1">
                        <div class="invffield">
                            <i class="bi bi-person me-1"></i>Salesman
                        </div>
                        <span class="form-label">
                            <input class="FormfilterclrField form-control" type="text" id="txtSalesmanName">

                        </span>
                        <div class="text-danger small px-2 clrdivs" id="dvErrorSalesmanName"></div>
                    </div>

                    <div class="fld-wrap mb-1">
                        <div class="invffield">
                            <i class="bi bi-shop me-1"></i>Customer
                        </div>
                        <span class="form-label">
                            <input class="FormfilterclrField form-control" type="text" id="txtCustomerName">

                        </span>
                        <div class="text-danger small px-2 clrdivs" id="dvErrorCustomerName"></div>
                    </div>

