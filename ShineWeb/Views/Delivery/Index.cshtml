                    fixedColumns: false,
                    searching: true,
                    ordering: false,
                    sorting: false,
                    columns: [
                        { "data": "ID", "autoWidth": true, "visible": false, className: "dt-body-left", width: "0%" },
                        {
                            className: "dt-body-center", width: "2%",
