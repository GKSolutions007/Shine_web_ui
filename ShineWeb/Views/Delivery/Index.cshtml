                                    isdisb = value.Status == 5 || value.Status == 6 || value.Status == 4 ? 'disabled' : '';
                                    checkboxfield = '<input type="checkbox" ' + isdisb + ' checked id="' + checkboxId + '" name="InvoiceCheck" style="" />';
                                    celldata = value.Status == 1 ? checkboxfield :
                                        value.Status == 4 ? checkboxfield+'<br/><label class="stsCancel">Cancel</label>' :
                                            value.Status == 5 ? checkboxfield + '<br/><label class="stsClose">Delivered</label>' :
                                                value.Status == 6 ? checkboxfield + '<br/><label class="stsReturn">Return</label>' : ''
                                }
                                
                                return celldata;
                            },
                        },
                        {
                            className: "dt-body-left", width: "2%",
                            "mRender": function (data, type, value, meta) {
                                var rowIndex = meta.row;
                                var _action = '<label style="font-weight:600">' + value.DocId + '</label><br/><label>' + value.InvDate + '</label>';
                                return _action;
                            },
                        },
                        //{ "data": "DocId", "autoWidth": true, className: "dt-body-left", width: "10%" },
                        { "data": "Name", "autoWidth": true, className: "dt-body-left", width: "20%" },
                        { "data": "NetAmt", "autoWidth": true, "visible": false, className: "dt-body-right", width: "10%" },
                    ],
                });
                $("#chkSelectAllInvoice").prop("checked", true);
                InvoiceTable = $('#tblInvoices').DataTable();
                if (Invoicejsondata.length == 0) {
                    showErrorSnackbar("No data found");
                }

                $('#tblProductDetails').DataTable({
                    scrollY: "325px",
                    scrollX: true,
                    scrollCollapse: true,
                    paging: false,
                    destroy: true,
                    data: productjsondata,
                    fixedColumns: false,
                    searching: true,
                    ordering: false,
                    sorting: false,
                    columns: [
                        { "data": "ProdID", "autoWidth": true, "visible": false, className: "dt-body-left", width: "0%" },
                        {
                            className: "dt-body-center", width: "3%",
                            "mRender": function (data, type, value, meta) {
                                var rowIndex = (meta.row + 1);
                                var _action = rowIndex;
                                return _action;
                            },
                        },
                        { "data": "Code", "autoWidth": true, className: "dt-body-left", width: "10%" },
                        { "data": "Name", "autoWidth": true, className: "dt-body-left", width: "20%" },
                        { "data": "MfrName", "autoWidth": true, className: "dt-body-left", width: "10%" },
                        { "data": "BrandName", "autoWidth": true, className: "dt-body-left", width: "10%" },
                        { "data": "CategoryName", "autoWidth": true, className: "dt-body-left", width: "10%" },
                        { "data": "MRP", "autoWidth": true, className: "dt-body-right", width: "7%" },
                        { "data": "BaseUOM", "autoWidth": true, className: "dt-body-right", width: "7%" },
                        { "data": "SalesUOM", "autoWidth": true, className: "dt-body-right", width: "7%" },
                        { "data": "ReportingUom", "autoWidth": true, className: "dt-body-right", width: "7%" },
                        { "data": "Value", "autoWidth": true, className: "dt-body-right", width: "9%" }
                    ],
                });
                ProductTable = $('#tblProductDetails').DataTable();
            }
        });
