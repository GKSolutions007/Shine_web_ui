                    onClick: (gridInstance, event) => {
                        gridInstance.exportToExcel();
                    }
                },
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {
                
            },
            customCellRenderer: (el, col, rowData) => {

            },
            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                var dTransID = 21;
                var DocID = rowData.DocID;
                OpenTransactionDocument(dTransID, DocID);
            },
            onColumnResize: (colIndex, field, header, newWidth) => {
                UpdateColumnWidth(1004, 3, 0, colIndex, field, newWidth);
            },
        });
    }
    function bindInvoiceCollectionDataTable(data) {
        if (data.length === 0) {
            return; // No data to display
        }
        var Reporthd = "Invoice Collection";
        var nHeight = "150px";
        Grid2 = new GKBSDynamicGrid('#InvCollectionGrid', Grid2Columns, data, {
            enablePagination: true,
            pageSize: ItemsperPage,
            height: nHeight,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: true,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
