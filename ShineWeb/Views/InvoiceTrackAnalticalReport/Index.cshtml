<style>
    td {
        font-size: 12px;
    }


    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    
    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -40%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    tr {
        cursor: pointer
    }
</style>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding:10px 1px 1px 1px;
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
    }

    .container {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .left-section {
        flex: 1;
        min-width: 200px;
    }

    .right-section {
        flex: 2;
        min-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 0px;
    }

    .party-box {
        background-color: #e6f1fb;
        padding: 2px;
        min-height: 560px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    .party-info-box {
        background-color: #fffde8;
        padding: 10px;
        min-height: 100px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    .documents-box {
        background-color: #ffffff;
        padding: 2px;
        min-height: 400px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    @@media (max-width: 768px) {
        .container {
            flex-direction: column;
        }

        .left-section,
        .right-section {
            flex: 1 0 100%;
        }
    }

    @@media (min-width: 1200px) {
        .container {
            max-width: 100% !important;
            gap: 1px !important;
        }
    }

    .main {
        padding-left: 0px !important;
        padding-top: 40px !important;
        padding-bottom: 30px !important;
        width: 100% !important;
        margin-left: 0px !important;
    }
</style>

<body>

    <div class="toastBox"></div>
    <div class="container">
        <div class="left-section">
            <div class="party-box">
                <strong></strong>
                <div id="Grid"></div>
                <div id="MainGrid" style="width: 100%;"></div>
            </div>

        </div>
        <div class="right-section">
            <div class="party-info-box">
                <table width="100%" border="0" cellspacing="0" cellpadding="5">
                    <tr>
                        <td colspan="2" width="70%">
                            <h5>🤵&ensp;<label id="lblPartyName"></label></h5>
                        </td>
                        <td rowspan="2" width="30%" align="left">
                            <table>
                                <tr>
                                    <td align="right">
                                        <label style="opacity:0.6;">&ensp;Assign Inv Count :</label>
                                    </td>
                                    <td>
                                        &ensp;<label id="lblAssignCount"></label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="right"><label style="opacity:0.6;">&ensp;Collection Count :</label></td>
                                    <td>&ensp;<label id="lblCollectionCount"></label></td>
                                </tr>
                                <tr>
                                    <td align="right"><label style="opacity:0.6;">&ensp;Ageing :</label></td>
                                    <td>&ensp;<label id="lblAgeing"></label></td>
                                </tr>
                                <tr>
                                    <td align="right"><label style="opacity:0.6;">&ensp;Status :</label></td>
                                    <td>&ensp;<label id="lblStatus"></label></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td align="left" width="35%">
                            <table>
                                <tr>
                                    <td align="right">
                                        <label style="opacity:0.6;">&ensp;Invoice No :</label>
                                    </td>
                                    <td>
                                        <input hidden id="txtInvID" />
                                        &ensp;<a href="javascript:void(0);" style="font-size:medium;font-weight:600" title="Go to invoice" id="lblInvoiceNo"></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="right"><label style="opacity:0.6;">&ensp;Invoice Date :</label></td>
                                    <td>&ensp;<label id="lblInvoiceDate"> </label>
                                </tr>
                            </table>
                            @*<label style="opacity:0.5;">&ensp;Invoice No : </label><label id="lblInvoiceNo"></label><br />
                                <label style="opacity:0.5;">&ensp;Invoice Date : </label><label id="lblInvoiceDate"> </label>*@
                        </td>
                        <td align="left" width="35%">
                            <table>
                                <tr>
                                    <td align="right">
                                        <label style="opacity:0.6;">&ensp;Value :</label>
                                    </td>
                                    <td>
                                        &ensp;<label id="lblValue" style="font-size:medium"></label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="right"><label style="opacity:0.6;">&ensp;Balance :</label></td>
                                    <td>&ensp;<label id="lblBalance" style="font-size:medium"></label>
                                </tr>
                            </table>
                            @*<label style="opacity:0.6;">&ensp;Value :</label>&ensp;<label id="lblValue" style="font-size:medium"></label><br />
                                <label style="opacity:0.6;">&ensp;Balance :</label>&ensp;<label id="lblBalance" style="font-size:medium"></label>*@
                        </td>
                    </tr>
                </table>


            </div>
            <div class="documents-box">
                <div id="InvCollectionGrid"></div>
                <div id="DocumentGrid"></div>
            </div>
        </div>
    </div>
</body>
<script type="text/javascript">
    var DecVal = '@Session["DecimalValues"]';
    var Aurl = '@Session["APIurl"]';
    var companyName = '@Session["companyname"]';
    var SelectTableID = 1;

    var Grid1, Grid2, Grid3;
    var Grid1Columns = ReturnColumnSettingsData(2, 1004, 1)
    var Grid2Columns = ReturnColumnSettingsData(2, 1004, 2);
    var Grid3Columns = ReturnColumnSettingsData(2, 1004, 3);
    var grid;
    var Documetsgrid;
    var InvCollgrid;
    var columnsettings = [], documentcolumnsettings = [];
    GetInvoices();
    function GetInvoices() {
        $.ajax({
            url: Aurl + "invoiceanalticalreport/getinvoices",
            type: 'get',
            contentType: 'json',
            data: {  },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                bindDataTable(eval(data))
            }
        });
    }
    var InvoiceInfo = [];
    function GetInvoiceDocuments(nDocValue) {
        $("#lblPartyName,#lblAssignCount,#lblCollectionCount,#lblAgeing,#lblInvoiceNo,#lblInvoiceDate,#lblValue,#lblBalance,#lblStatus").text("");
        $("#txtInvID").val("");
        $.ajax({
            url: Aurl + "invoiceanalticalreport/getdocuments",
            type: 'get',
            contentType: 'json',
            data: { DocValue: nDocValue },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                if (data)//.length > 0
                {
                    var AssignInvData = eval(data.AssignInvData);
                    var InvCollData = eval(data.InvoiceCollection);
                    InvoiceInfo = eval(data.InvoiceInfo);
                    $("#txtInvID").val(InvoiceInfo[0].InvID);
                    $("#lblPartyName").text(InvoiceInfo[0].PartyName);
                    $("#lblInvoiceNo").text(InvoiceInfo[0].DocID);
                    $("#lblInvoiceDate").text(InvoiceInfo[0].DocDate);
                    $("#lblValue").text(formatIndianCurrency(InvoiceInfo[0].Value));

                    $("#lblBalance").text(formatIndianCurrency(InvoiceInfo[0].Balance));
                    $("#lblAssignCount").text(InvoiceInfo[0].AssignInvCount);
                    $("#lblCollectionCount").text(InvoiceInfo[0].CollectionCount);
                    $("#lblAgeing").text(InvoiceInfo[0].Ageing);
                    $("#lblStatus").text(InvoiceInfo[0].Status);
                    bindDocumentDataTable(AssignInvData);
                    bindInvoiceCollectionDataTable(InvCollData);
                    if (AssignInvData.length == 0 && InvCollData.length == 0) {
                        showErrorSnackbar("No records for Invoice Collection & Assign Invoice");
                    }
                } else {
                    showErrorSnackbar("No records found");
                }
            }
        });
    }
    function bindDataTable(data) {
        if (data.length === 0) {
            return; // No data to display
        }
        var Reporthd = "Invoice Tracking Report";
        var nHeight = "520px";
        console.log("bindDataTable columnsettings ", Grid1Columns);
        var currentSearchValue = '';
        //if (grid) {
        //    currentSearchValue = grid ? grid.state.searchTerm : '';
        //}
        Grid1 = new GKBSDynamicGrid('#MainGrid', Grid1Columns, data, {
            enablePagination: true,
            pageSize: ItemsperPage,
            height: nHeight,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: currentSearchValue,
            CompanyName: companyName,
            ReportName: "",
            fitersdata: [],
            singleIconAction: [],
            rowActionsMenu: [],
            //onCellChange: handleCellUpdate,
            customButtons: [
                {
                    icon: '🛠️',
                    text: '',
                    title: 'Settings',
                    onClick: (gridInstance, event) => {
                        $("#txtGenSetSubmitApplygridname").val("Grid1");
                        modalGenColumnSettings.show();
                        GendralColumnSettings(1, 1004, 1, 0);
                    }
                },
                {
                    icon: '📥',
                    text: 'Export',
                    title: 'Export to Excel',
                    onClick: (gridInstance, event) => {
                        gridInstance.exportToExcel();
                    }
                },
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {
                if (Grid2) {
                    DocGridSearchValue = Grid2.state.searchTerm || '';
                    //showInfoSnackbar("lastSearchText : " + lastSearchText);
                }
                $("#DocumentGrid").html("");
                $("#InvCollectionGrid").html("");

                GetInvoiceDocuments(rowData["DocValue"]);

            },
            customCellRenderer: (el, col, rowData) => {

            },
            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {

            },
            onColumnResize: (colIndex, field, header, newWidth) => {
                UpdateColumnWidth(1004, 1, 0, colIndex, field, newWidth);
            },
        });
    }

    var DocGridSearchValue = "";
    function bindDocumentDataTable(data) {
        if (data.length === 0) {
            return; // No data to display
        }
        var Reporthd = "Assign Invoice";
        var nHeight = "150px";
        console.log("bindDataTable columnsettings ", Grid2Columns);
        
        Grid3 = new GKBSDynamicGrid('#DocumentGrid', Grid3Columns, data, {
            enablePagination: true,
            pageSize: ItemsperPage,
            height: nHeight,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: DocGridSearchValue,
            CompanyName: companyName,
            ReportName: Reporthd,
            fitersdata: [],
            singleIconAction: [],
            rowActionsMenu: [],
            //onCellChange: handleCellUpdate,
            customButtons: [
                {
                    icon: '🛠️',
                    text: '',
                    title: 'Settings',
                    onClick: (gridInstance, event) => {
                        $("#txtGenSetSubmitApplygridname").val("Grid3");
                        modalGenColumnSettings.show();
                        GendralColumnSettings(1, 1004, 3, 0);
                    }
                },
                {
                    icon: '📥',
                    text: 'Export',
                    title: 'Export to Excel',
                    onClick: (gridInstance, event) => {
                        gridInstance.exportToExcel();
                    }
                },
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {
                
            },
            customCellRenderer: (el, col, rowData) => {

            },
            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {

            },
            onColumnResize: (colIndex, field, header, newWidth) => {
                UpdateColumnWidth(1004, 3, 0, colIndex, field, newWidth);
            },
        });
    }
    function bindInvoiceCollectionDataTable(data) {
        if (data.length === 0) {
            return; // No data to display
        }
        var Reporthd = "Invoice Collection";
        var nHeight = "150px";
        Grid2 = new GKBSDynamicGrid('#InvCollectionGrid', Grid2Columns, data, {
            enablePagination: true,
            pageSize: ItemsperPage,
            height: nHeight,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: DocGridSearchValue,
            CompanyName: companyName,
            ReportName: Reporthd,
            fitersdata: [],
            singleIconAction: [],
            rowActionsMenu: [],
            //onCellChange: handleCellUpdate,
            customButtons: [
                {
                    icon: '🛠️',
                    text: '',
                    title: 'Settings',
                    onClick: (gridInstance, event) => {
                        $("#txtGenSetSubmitApplygridname").val("Grid2");
                        modalGenColumnSettings.show();
                        GendralColumnSettings(1, 1004, 2, 0);
                    }
                },
                {
                    icon: '📥',
                    text: 'Export',
                    title: 'Export to Excel',
                    onClick: (gridInstance, event) => {
                        gridInstance.exportToExcel();
                    }
                },
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {

            },
            customCellRenderer: (el, col, rowData) => {

            },
            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                var dTransID = 19;
                var DocID = rowData.DocID;
                OpenTransactionDocument(dTransID, DocID);
            },
            onColumnResize: (colIndex, field, header, newWidth) => {
                UpdateColumnWidth(1004, 2, 0, colIndex, field, newWidth);
            },
        });
    }
    var ProductInfo = [];
    $("#lblInvoiceNo").click(function (e) {
        var ID = $("#txtInvID").val();
        var DocID = $("#lblInvoiceNo").text();
        QuickAccessDocument(15, DocID);
    });
    function QuickAccessDocument(dTransID, DocID) {
        $.ajax({
            url: Aurl + "quicaccessdocument/validate",
            type: 'get',
            contentType: 'json',
            data: { TransID: dTransID, strDocID: DocID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == "0") {
                        if (dTransID == 15) {
                            window.open(
                                'Invoice?name=KUGYxS%2BKhoQB3%2FYrx1I0cQ%3D%3D&strFormID=jJOtHsRVwYECOhoiBc69dA%3D%3D&TypeID=BOII5FUynjpl5RZJJ8nW1g%3d%3d&TranID=' + items.ID,
                                '_blank'
                            );
                        }
                    }
                });
            }
        });
    }

</script>
