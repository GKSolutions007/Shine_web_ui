<style>
    /* ============ LEFT PANEL: header + controls ============ */
    .panel-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 46px 3px 12px;
        flex-shrink: 0;
    }

    .panel-header-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #1a6fb5 0%, #2596f0 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
        box-shadow: 0 3px 8px rgba(26, 111, 181, 0.3);
    }

    .panel-title {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: #0f2f4d;
    }

    .panel-controls {
        padding: 0 16px 2px;
        flex-shrink: 0;
    }

    .showall-switch {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
        font-size: 13px;
        color: #37485c;
        font-weight: 500;
    }

        .showall-switch .form-check-input {
            width: 2.3em;
            height: 1.25em;
            cursor: pointer;
            margin-top: 0;
        }

            .showall-switch .form-check-input:checked {
                background-color: #1a6fb5;
                border-color: #1a6fb5;
            }

        .showall-switch label {
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

    .type-toggle {
        display: flex;
        background: #eef3f8;
        border-radius: 10px;
        padding: 4px;
        gap: 4px;
    }

        .type-toggle input {
            display: none;
        }

    .type-toggle-btn {
        flex: 1;
        text-align: center;
        padding: 6px 5px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        color: #5b6b7d;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin: 0;
        user-select: none;
    }

    .type-toggle input:checked + .type-toggle-btn {
        background: #ffffff;
        color: #1a6fb5;
        box-shadow: 0 2px 6px rgba(15, 47, 77, 0.15);
        transform: translateY(-1px);
    }

    .type-toggle-btn:hover {
        color: #1a6fb5;
    }

    .grid-wrap {
        flex: 1 1 auto;
        min-height: 0;
        padding: 3px 5px 0px;
        overflow: auto;
    }

    /* ============ RIGHT TOP PANEL: profile card ============ */
    .profile-card-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 7px 10px 6px;
        border-bottom: 1px solid #eef2f6;
    }

    .profile-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a6fb5 0%, #2596f0 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(26, 111, 181, 0.35);
        animation: popIn 0.35s ease;
    }

    .profile-main {
        flex: 1;
        min-width: 0;
    }

    .profile-name {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 2px 0 6px;
        font-size: 15px;
        font-weight: 700;
        color: #0f2f4d;
        flex-wrap: wrap;
    }

        .profile-name label {
            margin: 0;
            cursor: default;
        }

            .profile-name label:empty:before {
                content: "Select a party to view details";
                color: #9aa7b4;
                font-weight: 400;
                font-size: 14px;
            }

    .party-info-icon {
        cursor: pointer;
        color: #1a6fb5;
        font-size: 16px;
        transition: transform 0.2s ease, color 0.2s ease;
        display: inline-flex;
    }

        .party-info-icon:hover {
            transform: scale(1.2);
            color: #14804f;
        }

    .profile-rating {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .profile-rating .star-rating {
            font-size: 1.35rem !important;
            gap: 1px;
        }

            .profile-rating .star-rating label {
                padding: 0 2px;
            }

    .rating-name-label {
        font-size: 12px;
        font-weight: 700;
        padding: 3px 11px;
        border-radius: 20px;
        background: #f3f5f7;
        margin: 0;
        letter-spacing: 0.2px;
    }

    .profile-stats {
        display: grid;
        /*grid-template-columns: repeat(4, 1fr);*/
        grid-template-columns: repeat(5, 1fr);
    }

    .stat-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 3px 6px;
        border-right: 1px solid #eef2f6;
        border-top: 1px solid #eef2f6;
        transition: background 0.2s ease;
        min-width: 0;
    }

        .stat-chip:hover {
            background: #f7fbff;
        }

        .stat-chip:nth-child(4n) {
            border-right: none;
        }

    .stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #eaf3fb;
        color: #1a6fb5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .stat-text {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .stat-label {
        font-size: 9.5px;
        color: #8996a5;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .stat-value {
        font-size: 11px;
        font-weight: 600;
        color: #1f2d3d;
        white-space: normal;
