    <!-- ===================== BOTTOM ACTION + SUMMARY BAR ===================== -->
    <div class="footerAction" id="dvFooterAction" style="display:none;">
        <div class="bc-mini-summary">
            <div class="stat"><span class="lbl">Records</span><span class="val" id="statRecords">0</span></div>
            <div class="stat"><span class="lbl">Balance</span><span class="val" id="statBalance">0.00</span></div>
            <div class="stat acc-collected"><span class="lbl">Collected</span><span class="val" id="statCollected">0.00</span></div>
            <div class="stat"><span class="lbl">Disc+Other</span><span class="val" id="statDiscOther">0.00</span></div>
            <div class="stat acc-remaining"><span class="lbl">Remaining</span><span class="val" id="statRemaining">0.00</span></div>
