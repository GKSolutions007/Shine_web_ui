</body>

<script type="text/javascript">
    var UID = '@Session["LoginUserID"]';
    var Aurl = '@Session["APIurl"]';
    var DefBranch = '@Session["DefaultBranch"]';
    var DecVal = parseInt('@Session["DecimalValues"]');
    if (isNaN(DecVal)) DecVal = 2;

    var paymentsTargetRow = null;
    setDate("dtpDate", 0);
    setDate("txtAsonDate", 0);
    LoadBranchByRoles('#cmbBranch');
    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    Loadfilterfieldaata()
    function Loadfilterfieldaata() {
        $.ajax({
            url: Aurl + "bulkcollection/filterdata",
            type: 'get',
            contentType: 'json',
            data: {
                Mode: 1
            },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                var arrBeatfilterdata = data.Table;
                var arrSMfilterdata = data.Table1;
                var arrCustfilterdata = data.Table2;
                
                GKBSPaginatedMultiSelect({
                    inputId: 'txtBeat',
                    data: arrBeatfilterdata,
                    onSelect: function (items) { /* optional live hook */ }
                });
                GKBSPaginatedMultiSelect({
                    inputId: 'txtSalesman',
                    data: arrSMfilterdata,
                    onSelect: function (items) { /* optional live hook */ }
                });
                GKBSPaginatedMultiSelect({
                    inputId: 'txtCustomer',
                    data: arrCustfilterdata,
                    onSelect: function (items) { /* optional live hook */ }
                });
            }
        });
    }     
    function formatNum(v) {
        v = parseFloat(v);
        if (isNaN(v)) v = 0;
        return v.toFixed(DecVal);
    }

    function escHtml(s) {
        if (s === null || s === undefined) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function formatDate(d) {
        if (!d) return '';
        var dt = new Date(d);
        if (isNaN(dt.getTime())) return d;
        var dd = String(dt.getDate()).padStart(2, '0');
        var mm = String(dt.getMonth() + 1).padStart(2, '0');
        return dd + '-' + mm + '-' + dt.getFullYear();
    }

    function toast(msg, type) {
        type = type || 'success';
        var icon = type === 'success' ? 'bi-check-circle' : (type === 'warning' ? 'bi-exclamation-triangle' : 'bi-x-circle');
        var $t = $('<div class="bc-toast ' + type + '"><i class="bi ' + icon + '"></i><span>' + escHtml(msg) + '</span></div>');
        $('.toastBox').append($t);
        setTimeout(function () {
            $t.fadeOut(250, function () { $t.remove(); });
        }, 3200);
    }

    function getPayments($tr) {
        try { return JSON.parse($tr.attr('data-payments') || '[]'); } catch (e) { return []; }
    }

    function setPayments($tr, arr) {
        $tr.attr('data-payments', JSON.stringify(arr));
    }

    function sumPayments(arr) {
        var t = 0;
        for (var i = 0; i < arr.length; i++) t += parseFloat(arr[i].amount) || 0;
        return t;
    }

    // ---------------------------------------------------------------
    // Demo / fallback data (used only when the live API is unreachable
    // or returns no rows, so the screen is always previewable).
    // ---------------------------------------------------------------
    function getDemoRows() {
        return [
            { TransID: 1, ID: 101, FAID: 9001, PartyName: 'Sri Ganesh Traders', DocID: 'INV-2607',TransName:"Invoice", TransDate: '2026-Jun-02', RefNo: 'PO-3321', NetAmt: 18500, BalanceAmt: 18500 },
            { TransID: 2, ID: 102, FAID: 9002, PartyName: 'Annapurna Stores', DocID: 'INV-2611', TransName: "Invoice", TransDate: '2026-Jun-05', RefNo: 'PO-3325', NetAmt: 9200, BalanceAmt: 6200 },
            { TransID: 3, ID: 103, FAID: 9003, PartyName: 'Velan Super Market', DocID: 'INV-2620', TransName: "Invoice", TransDate: '2026-Jun-08', RefNo: 'PO-3340', NetAmt: 45200, BalanceAmt: 45200 },
            { TransID: 4, ID: 104, FAID: 9004, PartyName: 'Murugan Agencies', DocID: 'INV-2622', TransName: "Sales Return", TransDate: '2026-Jun-09', RefNo: 'PO-3342', NetAmt: 12750, BalanceAmt: 4500 },
            { TransID: 5, ID: 105, FAID: 9005, PartyName: 'Lakshmi Provisions', DocID: 'INV-2630', TransName: "Invoice", TransDate: '2026-Jun-11', RefNo: 'PO-3360', NetAmt: 27800, BalanceAmt: 27800 },
            { TransID: 6, ID: 106, FAID: 9006, PartyName: 'Sakthi Distributors', DocID: 'INV-2635', TransName: "Debit Note", TransDate: '2026-Jun-13', RefNo: 'PO-3372', NetAmt: 6400, BalanceAmt: 1900 },
            { TransID: 4, ID: 104, FAID: 9004, PartyName: 'Murugan Agencies', DocID: 'INV-2622', TransName: "Invoice", TransDate: '2026-Jun-09', RefNo: 'PO-3342', NetAmt: 12750, BalanceAmt: 4500 },
            { TransID: 5, ID: 105, FAID: 9005, PartyName: 'Lakshmi Provisions', DocID: 'INV-2630', TransName: "Receivable Voucher", TransDate: '2026-Jun-11', RefNo: 'PO-3360', NetAmt: 27800, BalanceAmt: 27800 },
            { TransID: 6, ID: 106, FAID: 9006, PartyName: 'Sakthi Distributors', DocID: 'INV-2635',TransName:"Invoice", TransDate: '2026-Jun-13', RefNo: 'PO-3372', NetAmt: 6400, BalanceAmt: 1900 }
        ];
    }

    // ---------------------------------------------------------------
    // Fetch pending documents.
    // TODO: replace the URL below and the field mapping inside
    // renderRows() with your actual API contract.
    // ---------------------------------------------------------------
    function fetchCollectionData(filters) {
        $('#dvLoading').show();
        $('#emptyState').hide();
        $('#dvTableWrap').hide();

        $.ajax({
            url: Aurl + 'api/BulkCollection/GetPendingDocuments', // TODO: set your real endpoint
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(filters),
            success: function (resp) {
                var rows = (resp && resp.Data) ? resp.Data : resp;
                $('#dvLoading').hide();
                if (!rows || !rows.length) {
                    toast('No live records found for this filter — showing sample preview rows. Connect your API in fetchCollectionData().', 'warning');
                    rows = getDemoRows();
                }
                renderRows(rows);
            },
            error: function () {
                $('#dvLoading').hide();
                toast('Could not reach the API — showing sample preview rows. Check the endpoint URL in fetchCollectionData().', 'warning');
                renderRows(getDemoRows());
            }
        });
    }

    function renderRows(data) {
        var html = '';
        data.forEach(function (item, idx) {
            var transId = item.TransID ?? '';
            var id = item.ID ?? '';
            var faId = item.FAID ?? '';
            var party = item.PartyName ?? '';
            var docId = item.DocID ?? '';
            var date = item.TransDate ?? '';
            var refNo = item.RefNo ?? '';
            var net = parseFloat(item.NetAmt ?? 0) || 0;
            var balance = parseFloat(item.BalanceAmt ?? 0) || 0;

            html += '<tr data-transid="' + escHtml(transId) + '" data-id="' + escHtml(id) + '" data-faid="' + escHtml(faId) +
                '" data-balance="' + balance + '" data-net="' + net + '" data-payments="[]">' +
                '<td data-label="#">' + (idx + 1) + '</td>' +
                '<td data-label="Party Name"><span class="cell-strong">' + escHtml(party) + '</span></td>' +
                '<td data-label="Doc ID">' + escHtml(docId) + '<br/><span class="badge-status badge-pending">' + item.TransName +'</span>' + '</td>' +
                '<td data-label="Date">' + escHtml(formatDate(date)) + '</td>' +
                '<td data-label="Ref No">' + escHtml(refNo) + '</td>' +
                '<td data-label="Net ₹" class="text-end">' + formatNum(net) + '</td>' +
                '<td data-label="Balance" class="text-end cell-strong">' + formatNum(balance) + '</td>' +
                '<td data-label="Cash ₹" class="cell-input">' +
                '<div class="pay-cell">' +
                '<input type="number" inputmode="decimal" class="inp-cashamt" value="0.00" min="0" step="0.01">' +
                '</div>' +
                '</td>' +
                '<td data-label="Chq/BT ₹" class="cell-input">' +
                '<input type="number" inputmode="decimal" class="inp-chqbtamt" value="0.00" min="0" step="0.01">' +
                '</td>' +
                '<td data-label="Pay Info" class="text-start">' + 
                '<div class="pay-cell">' +                
                '<button type="button" class="btn-collect"><i class="bi bi-plus-circle"></i> <span class="pay-count-lbl">Add</span></button>' +
                '</div>' +
                '</td>' +
                '<td data-label="Disc %" class="cell-input"><input type="number" inputmode="decimal" class="inp-discpct" value="0.00" min="0" max="100" step="0.01"></td>' +
                '<td data-label="Disc ₹" class="cell-input"><input type="number" inputmode="decimal" class="inp-discamt" value="0.00" min="0" step="0.01"></td>' +
                '<td data-label="Other %" class="cell-input"><input type="number" inputmode="decimal" class="inp-otherpct" value="0.00" min="0" max="100" step="0.01"></td>' +
                '<td data-label="Other ₹" class="cell-input"><input type="number" inputmode="decimal" class="inp-otheramt" value="0.00" min="0" step="0.01"></td>' +
                '<td data-label="Adjusted ₹" class="text-end">' +
                '<div class="cell-strong lbl-adjusted">0.00</div>' +
                '<div class="remaining-hint lbl-remaininghint">Bal left: ' + formatNum(balance) + '</div>' +
                '<span class="badge-status badge-pending">Pending</span>' +
                '</td>' +
                '</tr>';
        });

        $('#tblBody').html(html);
        $('#dvTableWrap').show();
        $('#dvToolbar').show();
        $('#dvFooterAction').show();
        $('#emptyState').hide();
        recalcFooterTotals();
    }

    // ---------------------------------------------------------------
    // Per-row calculation engine
    // ---------------------------------------------------------------

    // Disc % -> Disc ₹ (base = row Balance). Change the variable used
    // for "base" below if you want discount computed on Net ₹ instead.
    function discPctChanged($tr) {
        var base = parseFloat($tr.attr('data-balance')) || 0;
        var pct = parseFloat($tr.find('.inp-discpct').val());
        if (isNaN(pct) || pct < 0) pct = 0;
        if (pct > 100) pct = 100;
        var amt = base * pct / 100;
        $tr.find('.inp-discamt').val(amt.toFixed(DecVal));
        $tr.find('.inp-discpct').val(pct.toFixed(2));
        recalcRow($tr);
    }

    function discAmtChanged($tr) {
        var base = parseFloat($tr.attr('data-balance')) || 0;
        var amt = parseFloat($tr.find('.inp-discamt').val());
        if (isNaN(amt) || amt < 0) amt = 0;
        if (amt > base) amt = base;
        var pct = base > 0 ? (amt / base * 100) : 0;
        $tr.find('.inp-discamt').val(amt.toFixed(DecVal));
        $tr.find('.inp-discpct').val(pct.toFixed(2));
        recalcRow($tr);
    }

    function otherPctChanged($tr) {
        var base = parseFloat($tr.attr('data-balance')) || 0;
        var pct = parseFloat($tr.find('.inp-otherpct').val());
        if (isNaN(pct) || pct < 0) pct = 0;
        if (pct > 100) pct = 100;
        var amt = base * pct / 100;
        $tr.find('.inp-otheramt').val(amt.toFixed(DecVal));
        $tr.find('.inp-otherpct').val(pct.toFixed(2));
        recalcRow($tr);
    }

    function otherAmtChanged($tr) {
        var base = parseFloat($tr.attr('data-balance')) || 0;
        var amt = parseFloat($tr.find('.inp-otheramt').val());
        if (isNaN(amt) || amt < 0) amt = 0;
        if (amt > base) amt = base;
        var pct = base > 0 ? (amt / base * 100) : 0;
        $tr.find('.inp-otheramt').val(amt.toFixed(DecVal));
        $tr.find('.inp-otherpct').val(pct.toFixed(2));
        recalcRow($tr);
    }

    function recalcRow($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        var payments = getPayments($tr);
        var collected = sumPayments(payments);
        var discamt = parseFloat($tr.find('.inp-discamt').val()) || 0;
        var otheramt = parseFloat($tr.find('.inp-otheramt').val()) || 0;

        var adjusted = collected + discamt + otheramt;
        var remaining = Math.max(0, balance - adjusted);

        $tr.find('.lbl-chqbtcollected').text(formatNum(collected));
        $tr.find('.lbl-adjusted').text(formatNum(adjusted));
        $tr.find('.lbl-remaininghint').text('Bal left: ' + formatNum(remaining));

        var $btn = $tr.find('.btn-collect');
        if (payments.length > 0) {
            $btn.addClass('has-pay').html('<i class="bi bi-credit-card"></i> <span class="pay-count-lbl">' + payments.length + ' method' + (payments.length > 1 ? 's' : '') + '</span>');
        } else {
            $btn.removeClass('has-pay').html('<i class="bi bi-plus-circle"></i> <span class="pay-count-lbl">Add</span>');
        }

        var $badge = $tr.find('.badge-status');
        $tr.removeClass('row-settled row-partial');
        if (adjusted <= 0) {
            $badge.attr('class', 'badge-status badge-pending').text('Pending');
        } else if (remaining <= 0.004) {
            $badge.attr('class', 'badge-status badge-settled').text('Settled');
            $tr.addClass('row-settled');
        } else {
            $badge.attr('class', 'badge-status badge-partial').text('Partial');
            $tr.addClass('row-partial');
        }

        recalcFooterTotals();
    }

    function recalcFooterTotals() {
        var tNet = 0, tBalance = 0, tCollected = 0, tDisc = 0, tOther = 0, tAdjusted = 0, n = 0;

        $('#tblBody tr').each(function () {
            var $tr = $(this);
            n++;
            tNet += parseFloat($tr.attr('data-net')) || 0;
            tBalance += parseFloat($tr.attr('data-balance')) || 0;
            tCollected += sumPayments(getPayments($tr));
            tDisc += parseFloat($tr.find('.inp-discamt').val()) || 0;
            tOther += parseFloat($tr.find('.inp-otheramt').val()) || 0;
        });

        tAdjusted = tCollected + tDisc + tOther;
        var remaining = Math.max(0, tBalance - tAdjusted);

        $('#ftNet').text(formatNum(tNet));
        $('#ftBalance').text(formatNum(tBalance));
        $('#ftChqBTCollected').text(formatNum(tCollected));
        $('#ftDisc').text(formatNum(tDisc));
        $('#ftOther').text(formatNum(tOther));
        $('#ftAdjusted').text(formatNum(tAdjusted));

        $('#statRecords').text(n);
        $('#statBalance').text(formatNum(tBalance));
        $('#statCollected').text(formatNum(tCollected));
        $('#statDiscOther').text(formatNum(tDisc + tOther));
        $('#statRemaining').text(formatNum(remaining));
    }

    // ---------------------------------------------------------------
    // Event wiring (delegated, since rows are added dynamically)
    // ---------------------------------------------------------------
    $('#tblBody').on('input change', '.inp-discpct', function () { discPctChanged($(this).closest('tr')); });
    $('#tblBody').on('input change', '.inp-discamt', function () { discAmtChanged($(this).closest('tr')); });
    $('#tblBody').on('input change', '.inp-otherpct', function () { otherPctChanged($(this).closest('tr')); });
    $('#tblBody').on('input change', '.inp-otheramt', function () { otherAmtChanged($(this).closest('tr')); });

    $('input[type=number]').on('focusin', function () { $(this).select(); });

    // ---------------------------------------------------------------
    // Multiple payment methods modal (per document)
    // ---------------------------------------------------------------
    $('#tblBody').on('click', '.btn-collect', function () {
        openPaymentsModal($(this).closest('tr'));
    });

    function togglePayFieldsForMode(mode) {
        var showExtra = mode !== 'Cash';
        $('#payInstrWrap, #payDateWrap, #payBankWrap, #payBranchWrap').toggle(showExtra);
    }

    $('#paymodeMode').on('change', function () { togglePayFieldsForMode($(this).val()); });

    function openPaymentsModal($tr) {
        paymentsTargetRow = $tr;
        var docId = $tr.find('td[data-label="Doc ID"]').text();
        var party = $tr.find('td[data-label="Party Name"]').text();
        $('#payModalSub').text(party + ' \u2014 ' + docId);

        $('#paymodeMode').val('Cash');
        togglePayFieldsForMode('Cash');
        $('#paymodeAmount').val('');
        $('#paymodeInstrNo').val('');
        $('#paymodeBank').val('');
        $('#paymodeBranch').val('');
        $('#paymodeDate').val('');
        $('#paymodeRemarks').val('');

        renderPaymentsModalList();
        $('#modalPayments').css('display', 'flex');
        setTimeout(function () { $('#paymodeAmount').focus(); }, 50);
    }

    function closePaymentsModal() {
        $('#modalPayments').css('display', 'none');
        paymentsTargetRow = null;
    }

    function renderPaymentsModalList() {
        if (!paymentsTargetRow) return;
        var balance = parseFloat(paymentsTargetRow.attr('data-balance')) || 0;
        var payments = getPayments(paymentsTargetRow);
        var added = sumPayments(payments);
        var remaining = Math.max(0, balance - added);

        $('#paySummaryBalance').text(formatNum(balance));
        $('#paySummaryAdded').text(formatNum(added));
        $('#paySummaryRemaining').text(formatNum(remaining));

        if (!payments.length) {
            $('#payList').html('<div class="pay-empty">No payment methods added yet.</div>');
            return;
        }

        var html = '';
        payments.forEach(function (p, i) {
            html += '<div class="pay-list-item">' +
                '<span><span class="mode-chip">' + escHtml(p.mode) + '</span>₹' + formatNum(p.amount) +
                (p.instrNo ? '<span class="meta"> &middot; ' + escHtml(p.instrNo) + '</span>' : '') +
                '</span>' +
                '<button type="button" class="pay-del" data-idx="' + i + '" title="Remove"><i class="bi bi-trash3"></i></button>' +
                '</div>';
        });
        $('#payList').html(html);
    }

    $('#payList').on('click', '.pay-del', function () {
        if (!paymentsTargetRow) return;
        var idx = parseInt($(this).attr('data-idx'));
        var payments = getPayments(paymentsTargetRow);
        payments.splice(idx, 1);
        setPayments(paymentsTargetRow, payments);
        renderPaymentsModalList();
        recalcRow(paymentsTargetRow);
    });

    $('#btnAddPayment').on('click', function () {
        if (!paymentsTargetRow) return;
        var balance = parseFloat(paymentsTargetRow.attr('data-balance')) || 0;
        var payments = getPayments(paymentsTargetRow);
        var already = sumPayments(payments);

        var mode = $('#paymodeMode').val();
        var amount = parseFloat($('#paymodeAmount').val());
        var instrNo = $('#paymodeInstrNo').val().trim();

        if (isNaN(amount) || amount <= 0) {
            toast('Enter a valid payment amount.', 'warning');
            $('#paymodeAmount').addClass('input-flash').focus();
            setTimeout(function () { $('#paymodeAmount').removeClass('input-flash'); }, 500);
            return;
        }
        if (mode !== 'Cash' && !instrNo) {
            toast('Cheque / Transaction No is required for ' + mode + '.', 'warning');
            $('#paymodeInstrNo').focus();
            return;
        }

        var remaining = balance - already;
        if (amount > remaining) {
            amount = Math.max(0, remaining);
            toast('Amount adjusted to the remaining balance (₹' + formatNum(amount) + ').', 'warning');
        }
        if (amount <= 0) {
            toast('This document already has the full balance allocated.', 'warning');
            return;
        }

        payments.push({
            mode: mode,
            amount: amount,
            instrNo: instrNo,
            bank: $('#paymodeBank').val().trim(),
            branch: $('#paymodeBranch').val().trim(),
            date: $('#paymodeDate').val(),
            remarks: $('#paymodeRemarks').val().trim()
        });
        setPayments(paymentsTargetRow, payments);
        recalcRow(paymentsTargetRow);

        // Reset the quick-add form for the next payment method
        $('#paymodeAmount').val('');
        $('#paymodeInstrNo').val('');
        $('#paymodeBank').val('');
        $('#paymodeBranch').val('');
        $('#paymodeDate').val('');
        $('#paymodeRemarks').val('');
        renderPaymentsModalList();
        $('#paymodeAmount').focus();
        toast(mode + ' payment of ₹' + formatNum(amount) + ' added.', 'success');
    });

    $('#btnClosePayments, #btnDonePayments').on('click', closePaymentsModal);

    // ---------------------------------------------------------------
    // Search filter (visual only — totals still reflect every row)
    // ---------------------------------------------------------------
    $('#txtSearchRow').on('input', function () {
        var q = $(this).val().trim().toLowerCase();
        $('#tblBody tr').each(function () {
            var $tr = $(this);
            var hay = $tr.find('td').slice(1, 5).text().toLowerCase();
            $tr.toggle(hay.indexOf(q) !== -1);
        });
    });

    // ---------------------------------------------------------------
    // Bulk actions
    // ---------------------------------------------------------------
    $('#btnResetAll').on('click', function () {
        $('#tblBody tr').each(function () {
            var $tr = $(this);
            $tr.find('.inp-discpct, .inp-discamt, .inp-otherpct, .inp-otheramt').val('0.00');
            setPayments($tr, []);
            recalcRow($tr);
        });
        toast('All entries reset.', 'success');
    });

    // ---------------------------------------------------------------
    // Filter / Clear / Save
    // ---------------------------------------------------------------
    $('#btnFilter').on('click', function () {
        $('.clrdivs').text('');
        var beat = $('#txtBeat').val().trim();
        var salesman = $('#txtSalesman').val().trim();
        var customer = $('#txtCustomer').val().trim();
        var asOnDate = $('#txtAsonDate').val();
        var valid = true;

        if (!asOnDate) {
            $('#divErrAsonDate').text('As on Date is required');
            valid = false;
        }
        //if (!beat && !salesman && !customer) {
        //    $('#divErrCustomer').text('Enter at least one of Beat, Salesman or Customer');
        //    valid = false;
        //}
        if (!valid) return;

        fetchCollectionData({
            Beat: beat,
            Salesman: salesman,
            Customer: customer,
            AsOnDate: asOnDate,
            BranchID: DefBranch,
            UserID: UID
        });
    });

    $('#btnClear').on('click', function () {
        $('.FormclrField').not('#txtAsonDate, #dtpDate').val('');
        $('#tblBody').empty();
        $('#dvTableWrap, #dvToolbar, #dvFooterAction').hide();
        $('#emptyState').show();
        recalcFooterTotals();
    });

    $('#btnSave').on('click', function () {
        var rows = $('#tblBody tr');
        if (!rows.length) {
            toast('No documents to save.', 'warning');
            return;
        }

        var payload = [];
        rows.each(function () {
            var $tr = $(this);
            payload.push({
                TransID: $tr.attr('data-transid'),
                ID: $tr.attr('data-id'),
                FAID: $tr.attr('data-faid'),
                DiscPct: parseFloat($tr.find('.inp-discpct').val()) || 0,
                DiscAmt: parseFloat($tr.find('.inp-discamt').val()) || 0,
                OtherPct: parseFloat($tr.find('.inp-otherpct').val()) || 0,
                OtherAmt: parseFloat($tr.find('.inp-otheramt').val()) || 0,
                Payments: getPayments($tr)
            });
        });

        // TODO: point this at your real save endpoint.
        $.ajax({
            url: Aurl + 'api/BulkCollection/SaveCollection',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ UserID: UID, BranchID: DefBranch, Rows: payload }),
            success: function () {
                toast('Collection saved successfully.', 'success');
            },
            error: function () {
                console.log('Save payload (connect your API in the btnSave handler):', payload);
                toast('Could not reach the Save API — payload logged to console for now.', 'warning');
            }
        });
    });

    // ---------------------------------------------------------------
    // Enter-key field navigation (Excel-style)
    // ---------------------------------------------------------------
    function getNavigableFields() {
        return $('#txtBeat,#txtSalesman,#txtCustomer,#txtAsonDate,#dtpDate,#tblBody input')
            .filter(':visible').toArray();
    }

    $(document).on('keydown', function (e) {
        if (e.key !== 'Enter') return;

        // Inside the payments modal: Enter adds the payment (except in the Remarks textarea).
        if ($(e.target).closest('#modalPayments').length) {
            if (e.target.tagName.toLowerCase() === 'textarea') return;
            e.preventDefault();
            $('#btnAddPayment').trigger('click');
            return;
        }

        var $t = $(e.target);
        if (!$t.is('input,select')) return;

        e.preventDefault();
        var fields = getNavigableFields();
        var idx = fields.indexOf(e.target);
        if (idx === -1) return;

        var nextIdx = e.shiftKey ? idx - 1 : idx + 1;
        var next = fields[nextIdx];
        if (next) {
            next.focus();
            if (next.select) next.select();
        }
    });

    $('#trFooter').show();
</script>
