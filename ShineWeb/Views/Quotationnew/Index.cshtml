                            <td align="right">
                                <span class="fw-semibold">
                                    Doc ID :
                                </span>
                            </td>
                            <td>
                                <span id="lblDocID" docprefix="" style="font-size:14px" class="fw-bolder">QTN/001</span>
                            </td>
                        </tr>
                        <tr>
                            <td align="right">
                                <span class="fw-semibold">
                                    Date :
                                </span>
                            </td>
                            <td>
                                <input class="clsdtpfieldbottomborder FormclrField"
                                       type="date"
                                       id="dtpDate"
                                       oninput="if (this.value > this.max) { this.value = this.max; }"
                                       placeholder="Date" />
                            </td>
                        </tr>
                    </table>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrDate"></div>
                </div>
            </div>
        </div>
        <div>

            <div class="row">
                <hr style="width:98%" />
                <div class="bar">
                    <button id="bAdd">+ Add Row</button>

                    <button id="bCols" title="Column settings" class="save">⚙</button>
                    <button id="btntestClearrow" hidden>clear</button>

                    <button id="bVal" hidden>Validate</button>
