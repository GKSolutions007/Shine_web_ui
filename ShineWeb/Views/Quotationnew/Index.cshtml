                "OtherChargeAmt": document.getElementById("txtOtherChargAmt").getAttribute("txttag"),//$("#txtOtherChargAmt").val(),
                "ProdDiscPern": document.getElementById("txtProdDiscPern").getAttribute("txttag"),//$("#txtProdDiscPern").val(),
                "TradeDiscPern": document.getElementById("txtTradeDiscPern").getAttribute("txttag"),// $("#txtTradeDiscPern").val(),
                "AddnlDiscPern": document.getElementById("txtAddnlDiscPern").getAttribute("txttag"),//$("#txtAddnlDiscPern").val(),
                "TotalProdDiscAmt": document.getElementById("txtProdDiscAmt").getAttribute("txttag"),// $("#txtProdDiscAmt").val(),
                "TradeDiscAmt": document.getElementById("txtTradeDiscAmt").getAttribute("txttag"),// $("#txtTradeDiscAmt").val(),
                "AddnlDiscAmt": document.getElementById("txtAddnlDiscAmt").getAttribute("txttag"),//$("#txtAddnlDiscAmt").val(),
                "WriteOffAmt": document.getElementById("txtWriteoff").getAttribute("txttag"),//$("#txtWriteoff").val(),
