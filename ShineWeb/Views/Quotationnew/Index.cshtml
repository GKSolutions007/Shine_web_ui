                    <td>
                        <input type="hidden" id="txtHProdID" class="FormclrField" />
                        <input type="hidden" id="txtHProdCode" />
                        <input type="hidden" id="txtHTrackInventory" />
                        <input type="hidden" id="txtHTrackBatch" />
                        <input type="hidden" id="txtHPKD" />
                        <input type="hidden" id="txtHPPrice" />
                        <input type="hidden" id="txtHSPrice" />
                        <input type="hidden" id="txtHECP" />
                        <input type="hidden" id="txtHSPL" />
                        <input type="hidden" id="txtHMRP" />
                        <input type="hidden" id="txtHRTNPrice" />
                    </td>
                </tr>
                <tr>
