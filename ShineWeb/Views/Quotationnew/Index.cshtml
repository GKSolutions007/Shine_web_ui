<script>
    ApplyCommonEnterEvent = false;
    //~Filter Action Buttons
    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canEdit: $("#txtModifyID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canCancel: $("#txtCancelID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    var allGridActions = [], singleIconAction = [], menuActions = [], columns = [];
    var actions = {}, OtherActions = {};
    var PrintTransID = 6, PrintConfigID = 0;
    function LoadPermissions() {
        var Permrdo1 = $("#rdoMainTableData").is(":checked") ? "1" : $("#rdoDraftTableData").is(":checked") ? "2" : "3";
        var cancelperm = !mapusersRole.canCancel ? false : Permrdo1 == "1" ? true : Permrdo1 == "2" ? true : false;
        var ViewPerm = mapusersRole.canView && Permrdo1 == "1" ? true : false;
        allGridActions = [
            {
                icon: '👁️',
                title: 'View Data',
                className: 'dg-action-view',
                displayType: 'single_icon',
                visible: ViewPerm,
                handler: (rowdata) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var Sts = rowdata.Status;//[9];
                    nTransMode = 5;
                    $("#txtID").val(ID);
                    ViewActionButtonPermission();
                    GetProductViewData(7, ID);
                    $("#txtStatus").val(rowdata.CurrentStatus);
                    $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft,#btnClear").hide();
                    $("#btnPDF,#btnPreview").prop("disabled", false);
                    $("#btnPreview,#btnPDF,#btnPrint").show();
                    $("#btnEmail,#btnWhatsapp").show();
                    $("#dvMain").show();
                    $("#dvDocuments").hide();
                    $("#MainHeading").text("View Quotation" + "_" + Sts);
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#cmbBranch").prop("disabled", true);
                    }
                    //if (ProductTable) ProductTable.columns.adjust().draw();
                }
            },
            {
                icon: '✏️',
                title: 'Edit',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    const isValidStatus = checkValidStatus(row.Status);
                    if (isValidStatus) {//row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed'
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftModifyID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canEdit)
                                isVisible = true;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[9];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        EditActionTrigger(rowdata);
                    }
                    else {
                        showErrorSnackbar("Cannot Modify.This document already cancelled");
                    }
                }
            },
            {
                icon: '📄',
                title: 'Variant',
                className: 'dg-action-edit',
                visible: mapusersRole.canVariant && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[9];
                    $("#txtID").val(ID);
                    VariantActionTrigger(rowdata);
                }
            },
            {
                icon: '❌',
                title: 'Cancel',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    const isValidStatus = checkValidStatus(row.Status);
                    if (isValidStatus) {//row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed'
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftCancelID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canCancel && Permrdo1 == "1")
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    var rdo1 = $("#rdoMainTableData").is(":checked");
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[9];
                    var stsID = rowdata.CurrentStatus;
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        if (rdo1) {
                            CancelActionTrigger(rowdata);
                        }
                        else {
                            var conf = confirm("Do you want to remove draft data?");
                            if (conf) {
                                //GetData(15, ID);
                                ValidateCancelDraftData(2, 14, ID, stsID)
                            }
                        }
                    }
                    else {
                        showErrorSnackbar("This document already cancelled");
                    }
                }
            },
            {
                icon: '🖨️',
                title: 'Print',
                className: 'dg-action-edit',
                visible: mapusersRole.canPrint && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    //$("#btnPrint").click();
                    var getdef = TransactionPrintProfiles.filter(pr => pr.DefaultConfig == 1);
                    var defid = getdef.length > 0 ? getdef[0].ConfigID : 0;
                    var copies = getdef.length > 0 ? getdef[0].NoCopies : 1;
                    $("#txtNoofCopies").val(copies);
                    $('#cmbPrintProfile').val(defid);
                    PrintConfigID = defid;
                    setTimeout(() => {
                        $("#btnPrint").click();
                    }, 300);
                }
            },
            {
                icon: '🖨️',
                title: 'Preview',
                className: 'dg-action-edit',
                visible: mapusersRole.canPreview && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    var getdef = TransactionPrintProfiles.filter(pr => pr.DefaultConfig == 1);
