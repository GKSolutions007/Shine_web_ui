            addProdinArray();
            var listTrans = {
                "IsDraft": nIsDraft,
                "ID": $("#txtID").val(),
                "DocDate": $("#dtpDate").val(),
                "TransMode": nTransMode,
                "TransID": 14,
                "BranchID": $("#cmbBranch").val(),
                "DocID": $("#lblDocID").val(),
                //"DocValue": $("#txtID").val(),
                "CustomerID": $("#txtCustomerID").val(),
                "BeatID": $("#cmbBeat").val(),
                "SalesmanID": $("#cmbSalesman").val(),
