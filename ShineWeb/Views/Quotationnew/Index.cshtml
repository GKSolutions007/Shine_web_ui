                                    <button class="btn-add-style" style="color:white" id="btnNewProd" title="Add Row"><span class="glyphicon glyphicon-plus-sign"></span></button>
                                </th>
                                <th style="text-align:center;font-size: 12px;width:2%;" class="trclrforcolheader">#</th>
                                <th style="text-align:center;font-size: 12px;width:30%;padding-right:100px;" class="trclrforcolheader">Item Names</th>
                                <th style="text-align: center; font-size: 12px; width: 8%; padding-right: 25px;" class="trclrforcolheader">MRP</th>
                                <th style="text-align: center; font-size: 12px; width: 8%; padding-right: 25px;" class="trclrforcolheader">Excl ₹</th>
