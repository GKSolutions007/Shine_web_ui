                "RoundOffAmt": document.getElementById("txtRoundOff").getAttribute("txttag"),//$("#txtRoundOff").val(),
                "GrossAmt": document.getElementById("lblGross").getAttribute("lbltag"),//$("#lblPTGross").text(),
                "TaxAmt": document.getElementById("lblTaxAmount").getAttribute("lbltag"),//$("#lblPTTax").text(),
                "NetAmt": document.getElementById("lblRoundNet").getAttribute("lbltag"),//$("#lblRoundNet").text(),
                "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : $("#txtStatus").val(),
