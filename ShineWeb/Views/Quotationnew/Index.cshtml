        //newRow: () => ({
        //    productID: 0, ApponMRPCum: 0, MRPonTaxAmt: 0, OrgPrice: 0, itemName: '', code: '', stock: 0,
        //    mrp: 0, priceExcl: 0, priceIncl: 0, qty: 0, uomID: 1, uom: 'PCS', uomCF: 1, reason: '', taxID: 2, mrpOnTax: 0,
        //      prodPct: 0, prodAmt: 0,
        //    tradePct: 0, tradeAmt: 0, addPct: 0, addAmt: 0, goods: 0, gross: 0, taxPct: 5, taxAmt: 0, net: 0//, diff: 0
        //}),
        $.each(ItemGridData, function (i, itemrow) {
