<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>
<style>

    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    hr {
        margin: 1rem 0;
        color: inherit;
        border: 0;
        border-top: 1px solid;
        opacity: .25;
    }


    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        /*padding: 6px 12px;*/
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -58%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -22%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
        z-index: 100;
        /*padding: 6px 12px;*/
    }

    table.dataTable > tbody > tr > th, table.dataTable > tbody > tr > td {
        padding: 2px 10px !important;
    }
</style>

<style>
    div.dataTables_scrollBody {
        overflow: visible !important;
        position: relative !important;
        z-index: 1;
    }
    /* ============ COMPACT FORM CONTROLS ============ */
    .form-control,
    select.form-control,
    input.form-control,
    textarea.form-control,
    .gdInput,
    select.gdInput,
    input.gdInput {
        padding: 4px 8px !important;
        font-size: 12px !important;
        height: 28px !important;
        line-height: 1.4 !important;
        margin-bottom: 1.2px !important;
    }

    textarea.form-control {
        height: auto !important;
        min-height: 60px !important;
    }

    .input-group-addon {
        padding: 4px 8px !important;
        font-size: 12px !important;
    }

    select.form-control {
        padding-right: 20px !important;
    }

    .clsnewitem {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 2px 5px;
        font-size: 12px;
        font-weight: 500;
        color: #0C447C;
        background: #E6F1FB;
        border: 0.5px solid #85B7EB;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, transform 0.1s;
        white-space: nowrap;
        user-select: none;
    }

        .clsnewitem:hover {
            background: #B5D4F4;
            transform: scale(1.05)
        }

    .pi-header {
        background: linear-gradient(135deg, #0d5c3f 0%, #14804f 100%);
        padding: 8px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }

    .pi-header-icon {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: white;
        flex-shrink: 0;
    }

    .pi-header h4 {
        font-size: 17px;
    }

    .pi-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background-color: rgba(255,255,255,0.15) !important;
        border-radius: 6px;
        padding: 5px;
    }

    .pi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .pi-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 2px;
        padding: 9px 14px;
        border-bottom: 1px solid #f0f0f0;
        min-width: 0;
    }

        .pi-row.full {
            grid-column: 1 / -1;
        }

        .pi-row.highlight {
            background-color: #eafaf1;
        }

    .pi-icon-chip {
        width: 26px;
        height: 26px;
        background-color: #eafaf1;
        color: #14804f;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        margin-top: 1px;
    }

    .pi-label {
        width: auto;
        white-space: nowrap;
        color: #6b7280;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-colon {
        color: #9ca3af;
        width: 6px;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-value {
        font-weight: 600;
        color: #111827;
        font-size: 13px;
        min-width: 0;
        flex: 1;
        white-space: normal;
        overflow: visible;
        word-break: break-word;
        line-height: 1.35;
    }

        .pi-value.muted {
            color: #9ca3af;
            font-weight: 400;
        }

    .pi-badge-good {
        background-color: #eafaf1;
        color: #14804f;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 11px;
    }
</style>
<link href="~/Content/TransGrid/quotation.css" rel="stylesheet" />
<div class="modal fade" id="vendorInfoModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 600px;">
        <div class="modal-content" style="border-radius:16px; overflow:hidden;">
            <div class="pi-header">
                <div class="pi-header-icon"><i class="fas fa-user"></i></div>
                <div>
                    <h4 class="mb-0 text-white fw-bold" id="vendTitle">Customer Information</h4>
                </div>
                <button type="button" class="btn-close btn-close-white pi-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="vendBody"></div>
            </div>
        </div>
    </div>
</div>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.Variant, new { @autocomplete = "off", @class = "form-control", @id = "txtVariantID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.Cancel, new { @autocomplete = "off", @class = "form-control", @id = "txtCancelID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.EnableReturnPrice, new { @autocomplete = "off", @class = "form-control", @id = "txtReurnPricePerm" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtTransType" })
    @Html.HiddenFor(model => model.TransVariantID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtTransVariantID" })
    @Html.HiddenFor(model => model.PartyID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtTransVariantPartyID" })
    @Html.HiddenFor(model => model.DraftModify, new { @autocomplete = "off", @class = "form-control", @id = "txtDraftModifyID" })
    @Html.HiddenFor(model => model.DraftCancel, new { @autocomplete = "off", @class = "form-control", @id = "txtDraftCancelID" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })


    <input hidden id="txtCustomerID" />
    <input hidden id="txtBAdd1" /><input hidden id="txtBAdd2" /><input hidden id="txtBAdd3" />
    <input hidden id="txtSAdd1" /><input hidden id="txtSAdd2" /><input hidden id="txtSAdd3" />
    <input hidden id="txtPincode" />

    <input hidden id="txtSAdd1" /><input hidden id="txtSAdd2" /><input hidden id="txtSAdd3" />
    <input hidden id="txtPincode" /><input hidden id="txtStatus" /><input hidden class="FormclrField" id="txtDraftID" />
    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <div class="toastBox"></div>
    <hr />
    <div id="dvDocuments">
        <div class="container-fluid">
            <div class="row align-items-start mb-2">

                <!-- Toggle -->
                <div class="col-12 col-md-3 col-lg-2 mb-3 mb-md-0">
                    <div class="toggle">
                        <input type="radio" name="sizeBy" id="rdoMainTableData" checked>
                        <label for="rdoMainTableData">Quotation Data</label>

                        <input type="radio" name="sizeBy" id="rdoDraftTableData">
                        <label for="rdoDraftTableData">Draft Data</label>
                    </div>
                </div>

                <!-- Filters -->
                <div class="col-12 col-md-9 col-lg-10">
                    <div hidden id="reportrange" style="background: #fff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc; width: 100%">
                        <i class="fa fa-calendar"></i>&nbsp;
                        <span></span> <i class="fa fa-caret-down"></i>
                    </div>
                    <div class="d-flex flex-wrap justify-content-end">

                        <!-- Branch -->
                        <div class="col-12 col-md-3 col-lg-2">
                            <span class="form-label">
                                <select class="form-control FormfilterclrField" id="cmbFilterBranch">
                                    <option value="0">Select Branch</option>
                                </select>
                                <label class="labelup">Branch</label>
                            </span>
                        </div>

                        <!-- Party -->
                        <div class="col-12 col-md-4 col-lg-3">
                            <span class="form-label">
                                <input class="form-control FormfilterclrField" type="text" id="txtFilterParty">
                                <label class="labelup">Party</label>
                            </span>
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFParty"></div>
                        </div>

                        <!-- Date Type -->
                        <div class="col-12 col-md-1 col-lg-1">
                            <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                        </div>

                        <!-- From -->
                        <div class="col-12 col-md-2 col-lg-2">
                            <span class="form-label">
                                <input class="form-control FormfilterclrField" type="date"
                                       id="dtpFFrom"
                                       oninput="if (this.value > this.max) { this.value = this.max; }">
                                <label class="labelup">From</label>
                            </span>
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFFrom"></div>
                        </div>

                        <!-- To -->
                        <div class="col-12 col-md-2 col-lg-2">
                            <span class="form-label">
                                <input class="form-control FormfilterclrField" type="date"
                                       id="dtpFTo"
                                       oninput="if (this.value > this.max) { this.value = this.max; }">
                                <label class="labelup">To</label>
                            </span>
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFTo"></div>
                        </div>
                        <div class="col-12 col-md-2 col-lg-2 d-flex align-items-center">
                            <div class="form-check ps-5">
                                <input class="form-check-input FormfilterclrField"
                                       type="checkbox" id="chkShowAll">
                                <label class="form-check-label" for="chkShowAll">
                                    All Status
                                </label>
                            </div>

                            <button id="btnFilter" class="btn btn-filter-style ms-auto">
                                <i class="bi bi-funnel-fill"></i><span class="textforabv800"> Filter</span>
                            </button>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Grid -->
            <div id="my-grid" style="height:600px;width:100%;"></div>

        </div>
    </div>

    <div id="dvMain">
        <!--Hidden Fields -->
        <input id="txtCustomerID" hidden />
        <label id="lblCode" hidden></label>
        <label id="lblMob1" hidden></label>
        <label id="lblGSTIN" hidden></label>
        <label id="lblTempABS" hidden></label>
        <div hidden>
