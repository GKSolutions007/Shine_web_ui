    function loadselectedproductdetail(gridrow,rowindex, strName = null, strID = null, dtpDt = null, nPriceID = "2") {
        $.ajax({
            url: Aurl + "quotation/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: 4, CodeName: strName, ID: strID, PriceID: nPriceID, Date: $("#dtpDate").val() },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                console.log("gridrow", gridrow, "data ", data);
                $.each(data, function (i, items) {
                    var uomforselprod = items.UOMList;
                    const t = taxById(items.SalesTaxID) || taxOf(items.GSTPern);                // item tax (TaxID, else by GST %)
                    //gridrow.patch(rowindex, {
                    //    itemName: items.Name, code: items.Code, productID: +items.ID || 0, mrp: +items.MRP || 0,
                    //    TrackInentoryYN: +items.TrackInentoryYN || 0, TrackBatchYN: +items.TrackBatchYN || 0, TrackPKDYN: +items.TrackPKDYN || 0,   // hidden columns
                    //    priceExcl: +items.SalesPrice || 0, taxPct: +items.SalesTaxID || 0
                    //}, 'items');
                    var TaxPern = (parseFloat(items.GSTPern) / 100) + 1;
                    arrSalesTaxDetails = ReturnTaxDetails(items.SalesTaxID, 1);
                    var dApponMRPCum = arrSalesTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
                    var dMRPonTax = getSalesMRPontax(items.MRP);
                    var baseprice = 0;
                    var ApplyPrice = nPriceID == 1 ? items.PurchasePrice : nPriceID == 2 ? items.SalesPrice : nPriceID == 3 ? items.ECP : nPriceID == 4 ? items.MRP : nPriceID == 5 ? items.SPLPrice :
                        nPriceID == 6 ? items.ReturnPrice : 0;
                    if (nPriceID == 4) {
                        var exclmrp = ApplyPrice / TaxPern;
                        ApplyPrice = exclmrp;
                    }
                    baseprice = parseFloat(ApplyPrice);
                    var PPrice = parseFloat(ApplyPrice * items.SalesCR);
                    var InclPPrice = dApponMRPCum > 0 ? PPrice + dMRPonTax : PPrice * TaxPern;
                    gridrow.patch(rowindex, {
                        itemName: items.Name, code: items.Code, productID: +items.ID || 0, mrp: +items.MRP || 0, stock: $("#lblTempABS").text() || "0.00",
                        ApponMRPCum: dApponMRPCum, MRPonTaxAmt: dMRPonTax, OrgPrice: +baseprice || 0,
                        priceExcl: +PPrice || 0,qty : 1,
                        _uoms: uomforselprod, uomID: +items.SalesUomID || 0,          // item's own UOM list + its default UOM -> dropdown is rebound in the row
                        taxID: t ? +t.ID : 0, taxPct: t ? +t.TaxPern : (+items.GSTPern || 0)
                    }, 'items'); // fills row, recalculates, refreshes totals
                });

            }
        });
    }
    function getSalesMRPontax(MRP) {
        var dTaxAmt = 0;
        var dApponMRPCum = arrSalesTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
        for (var i = 0; i < arrSalesTaxDetails.length; i++) {
            var nAppon = arrSalesTaxDetails[i].AppOn;
            var dCumTax = arrSalesTaxDetails[i].CumulativeTax;
            if (nAppon == -1) {
                var dPrice = (MRP / (1 + (dApponMRPCum / 100)));
                dTaxAmt += (dPrice * dCumTax) / 100;
            }
        }
        return dTaxAmt;
    }
