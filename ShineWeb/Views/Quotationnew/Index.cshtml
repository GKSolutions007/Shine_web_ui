                        <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrProductBatch" class="clrdivs"></div>
                    </td>
                    <td width="30%">
                    </td>
                </tr>
            </table>
        </div>
        <!--Hidden Fields End-->
        <div class="container-fluid">

            <div class="row align-items-start">

                <!-- LEFT SIDE: Filters -->
                <div class="col-12 col-md-10 mb-3">
                    <div class="row g-2">

                        <!-- Branch -->
                        <div class="col-12 col-md-3 col-lg-2">
                            <span class="form-label w-100">
                                <select class="form-control FormclrcmbField" id="cmbBranch">
                                    <option value="0">Select Branch</option>
                                </select>
                                <label class="labelup">Branch *</label>
                            </span>
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrBranch"></div>
                        </div>

                        <!-- Customer -->
                        <div class="col-12 col-md-5 col-lg-4">
                            <div class="input-group">
                                <span id="opencustomer" class="input-group-text" title="New Customer"><span class="fas fa-arrow-up-right-from-square"></span></span>
                                <span class="form-label flex-fill">
                                    <input class="form-control FormclrField" type="text" id="txtSearch" placeholder="Select Customer">

                                    <label class="labelup" for="txtCode"> Select *</label>
                                </span>
                                <span id="VendInfo" class="input-group-text"><span class="glyphicon glyphicon-info-sign" style="background-color:white;"></span></span>
                            </div>
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrSearch"></div>
                        </div>

                        <!-- Price Type -->
                        <div class="col-12 col-md-2 col-lg-2">
                            <span class="form-label w-100">
                                <select class="form-control FormclrcmbField" id="cmbPriceType">
                                    <option value="0">Select Price Type</option>
                                </select>
                                <label class="labelup">Price Type *</label>
                            </span>
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrPriceType"></div>
                        </div>

                        <!-- Ref No -->
