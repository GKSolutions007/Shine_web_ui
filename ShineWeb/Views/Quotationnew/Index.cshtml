    function GetProductViewData(nMode, strName = null) {
        //$("#btnTEdit,#btnTCancel,#btnTVariant").hide();

        $.ajax({
            url: Aurl + "quotation/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, CodeName: strName },
            xhrFields: {
                withCredentials: true
            },
            //async :false,
            success: function (data) {
                G.clearAllRows();
                G.setLocked(nTransMode == 4 || nTransMode == 5);   // view / print modes: all grid fields disabled, otherwise enabled
