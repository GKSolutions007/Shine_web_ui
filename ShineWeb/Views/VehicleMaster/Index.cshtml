@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>
    
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 0px;
            border: 1px solid #888;
            width: 35%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 0px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -50%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>
   
    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>

    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close"  id="modelcloseX"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body text-center">
                        <table class="table w-100">
                            <tr>
                                <td class="border-0 px-2" colspan="2">
                                    <span class="form-label">
                                        <input tabindex="1" type="text" id="txtVehicleNo"
                                               class="form-control FormclrField"
                                               placeholder="ex: TN01AB1234"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorVehicleNo')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorVehicleNo')" />

                                        <label class="labelup">Vehicle No *</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorVehicleNo"></div>
                                </td>
                            </tr>

                            <tr>
                                <td class="border-0 px-2" colspan="2">
                                    <span class="form-label">
                                        <input tabindex="2" type="text" id="txtVehicleName"
                                               class="form-control FormclrField"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorVehicleName')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorVehicleName')" />

                                        <label class="labelup">Vehicle Name *</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorVehicleName"></div>
                                </td>
                            </tr>

                            <tr>
                                <td class="border-0 px-2">
                                    <span class="form-label">
                                        <input tabindex="3" type="date"
                                               id="txtPurchaseDate"
                                               class="form-control clsdtpfieldfull FormclrField" />

                                        <label class="labelup">Purchase Date</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorPurchaseDate"></div>
                                </td>

                                <td class="border-0 px-2">
                                    <span class="form-label">
                                        <input tabindex="4" type="date"
                                               id="txtInsuranceDate"
                                               class="form-control clsdtpfieldfull FormclrField" />

                                        <label class="labelup">Insurance Date</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorInsuranceDate"></div>
                                </td>
                            </tr>

                            <tr>
                                <td class="border-0 px-2">
                                    <span class="form-label">
                                        <input tabindex="5" type="date"
                                               id="txtInsuranceExpiryDate"
                                               class="form-control clsdtpfieldfull FormclrField" />

                                        <label class="labelup">Insurance Expiry Date</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorInsuranceExpiryDate"></div>
                                </td>

                                <td class="border-0 px-2">
                                    <span class="form-label">
                                        <input tabindex="6" type="date"
                                               id="txtFCDate"
                                               class="form-control clsdtpfieldfull FormclrField" />

                                        <label class="labelup">FC Date</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorFCDate"></div>
                                </td>
                            </tr>

                            <tr>
                                <td class="border-0 text-start ps-2" colspan="2">
                                    <label for="chkActive">Active :</label>
                                    <input tabindex="7" type="checkbox" id="chkActive" checked disabled />
                                    <div class="clrdiv text-danger" id="dvErrorActive"></div>
                                </td>
                            </tr>
                        </table>
                    
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer" style="background-color:skyblue">
                    <div class="text-end w-100">

                        <button tabindex="9" type="button" class="btn btn-danger" id="btnClear">
                            <span class="glyphicon glyphicon-refresh"> Clear</span>
                        </button>

                        <button tabindex="8" type="button" class="btn btn-success" id="btnSave">
                            <span class="glyphicon glyphicon-saved"> Save</span>
                        </button>

                        <button tabindex="10" type="button" class="btn btn-warning" id="btnClose">
                            <i class="bi bi-x-circle"></i> Close
                        </button>

                    </div>
                </div>

            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                var VID = rowData.ID;//[0];
                GetData(4, VID);
                $(".FormclrField").prop("disabled", true);
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                $("#chkActive,#btnSave,#btnClear").prop("disabled", true);
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;
                //rowdata = Table.row($(this).parents('tr')).data();
                var VID = rowData.ID;//[0];
                GetData(4, VID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>

<script type="text/javascript">
  
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd;
    }

    if (mm < 10) {
        mm = '0' + mm;
    }

    today = yyyy + '-' + mm + '-' + dd;
    document.getElementById("txtPurchaseDate").setAttribute("max", today);
    var Aurl = '@Session["APIurl"]';

    var grid, Vehicle;
    GetColumnSettingsData(2, 4, 1);
    var arrData = [];
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    GetData(3);
    //~Grid Data
    function GetData(dMode,nID = 0) {
        $.ajax({
            url: Aurl + "vehicle/get",
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: dMode, Name: nID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                    Vehicle = data;
                    if (dMode == 3) {
                        if (data.length == 0) {
                            showErrorSnackbar("No Records Found");
                        }
                        arrData = [];
                        //Table.draw().clear();
                        $.each(data, function (i, items) {
                            //arrData[i] = items.VehicleNo;
                            var al = {
                                "label": items.VehicleNo,
                                "active": items.Active,
                                "id": items.ID,
                            }
                            arrData.push(al);                            
                        });

                        var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, Vehicle, {
                            enablePagination: true,
                            pageSize: ItemsperPage,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                            enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                            enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                            enableSorting: true,
                            searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                            rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                            //onCellChange: handleCellUpdate,
                            customCellRenderer: (el, col, rowData) => {
                                if (col.field === 'Active') {
                                    const val = rowData[col.field];
                                    console.log("Active : ", val);
                                    if (val === 'True') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                                    } else if (val === 'False') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                                    }
                                }
                            },
                            customButtons: [
                                {
                                    icon: '⚙️',
                                    text: 'Settings',
                                    title: 'Settings',
                                    visible: true,
                                    onClick: (gridInstance, event) => {                                       
                                        modalGenColumnSettings.show();
                                        GendralColumnSettings(1, 4, 1, 0);
                                    }
                                },
                                {
                                    icon: '➕',
                                    text: 'Add New',
                                    title: 'Add New',
                                    visible: $("#txtAddID").val() == 1,
                                    onClick: (gridInstance, event) => {
                                        nMode = 1;
                                        $("#chkActive,#btnSave,#cmbTax,#btnClear,.FormclrField").prop("disabled", false);
                                        $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                        modal.show();
                                        ClearForm();
                                    }
                                },
                            ],
                            onCellClick: (rowData, fieldName, cellValue, column) => {                                
                            },
                            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {                                
                            },
                            onColumnResize: (colIndex, field, header, newWidth) => {
                                UpdateColumnWidth(4, 1, 0, colIndex, field, newWidth)
                            },
                        });
                        //~AutoList
                        PaginatedAutocomplete({
                            inputId: "txtVehicleNo",
                            data: arrData,
                            onSelect: function (item) {
                                $("#txtVehicleNo").val(item.label);
                                return false;
                            }
                        });
                        //$("#txtVehicleNo").autocomplete({
                        //    minLength: 0,
                        //    source: arrData,                            
                        //    select: function (event, ui) {
                        //        $("#txtVehicleNo").val(ui.item.label);
                        //        return false;
                        //    },
                        //}).autocomplete("instance")._renderItem = function (ul, item) {
                        //    return $("<li class='each'>")
                        //        .append("<div class='acItem'><span class='name'>" +
                        //            item.label + "</span></div>")
                        //        .appendTo(ul);
                        //};
                    }
                        //~Assign Data
                    else if (dMode == 4) {                       
                        $.each(data, function (i, items) {
                            $("#txtID").val(items.ID);
                            $("#txtVehicleNo").val(items.VehicleNo);
                            $("#txtVehicleName").val(items.VehicleName);
                            $("#txtPurchaseDate").val(items.DOPurchase);
                            $("#txtInsuranceDate").val(items.InsuranceDate);
                            $("#txtInsuranceExpiryDate").val(items.InsuranceExpire);
                            $("#txtFCDate").val(items.FCDate);
                            $("#chkActive").prop("checked", items.Active == "True");
                        });
                    }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }   
    var modal = new bootstrap.Modal(document.getElementById('myModalfg')); //document.getElementById("myModalfg");
    //~Close
    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.hide();
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".FormclrField").val("");
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#txtVehicleNo").focus();
        if (nMode != 1)
            modal.hide();
    }
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        //~Validation
        var IsValid = true, ChkFormation = true;
        if ($("#txtVehicleNo").val() == "") {
            IsValid = false;
            $("#dvErrorVehicleNo").html("Vehicle No should not be empty");
            showErrorSnackbar("Vehicle No should not be empty");
        }
        else {
            
            var ChkFormation = AlphaAndNumericonly($("#txtVehicleNo").val(), $("#dvErrorVehicleNo"));
            if (!ChkFormation) {
                IsValid = false;
            }
        }
        if ($("#txtVehicleName").val() == "") {
            IsValid = false;
            $("#dvErrorVehicleName").html("Vehicle Name should not be empty");
            showErrorSnackbar("Vehicle Name should not be empty");
        }
        if ($("#txtInsuranceDate").val() != "") {
            if ($("#txtPurchaseDate").val() > $("#txtInsuranceDate").val()) {
                IsValid = false;
                $("#dvErrorInsuranceDate").html("Insurance Date should be greater than Purchase date");
                showErrorSnackbar("Insurance Date should be greater than Purchase date");
            }
        }
        if ($("#txtInsuranceExpiryDate").val() != "") {
            if ($("#txtPurchaseDate").val() > $("#txtInsuranceExpiryDate").val()) {
                IsValid = false;
                $("#dvErrorInsuranceExpiryDate").html("Insurance Expiry Date should be greater than Purchase date");
                showErrorSnackbar("Insurance Expiry Date should be greater than Purchase date");
            }
            if ($("#txtInsuranceDate").val() > $("#txtInsuranceExpiryDate").val()) {
                IsValid = false;
                $("#dvErrorInsuranceExpiryDate").html("Insurance Expiry Date should be greater than Insurance date");
                showErrorSnackbar("Insurance Expiry Date should be greater than Insurance date");
            }
        }
        if ($("#txtFCDate").val() != "") {
            if ($("#txtPurchaseDate").val() > $("#txtFCDate").val()) {
                IsValid = false;
                $("#dvErrorFCDate").html("FC Date should be greater than Purchase date");
                showErrorSnackbar("FC Date should be greater than Purchase date");
            }
        }
        //ChkFormation = SACValidation($("#txtSAC"), $("#dvErrorSAC"));
        if (!ChkFormation) {
            IsValid = false;
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });

    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var lstMaster = {
            "FormID": FID,
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "VehicleNo": $("#txtVehicleNo").val(),
            "VehicleName": $("#txtVehicleName").val(),
            "DOPurchase": $("#txtPurchaseDate").val(),
            "InsuranceDate": $("#txtInsuranceDate").val(),
            "InsuranceExpire": $("#txtInsuranceExpiryDate").val(),
            "FCDate": $("#txtFCDate").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID
        };
        $.ajax({
            url: Aurl + "vehicle/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        ClearForm();
                        GetData(3);
                        modal.hide();
                    }
                    else {
                        $("#dvErrorVehicleNo").html(items.Message);
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }    
</script>