                        </div>
                        <div class="summary-tile bg-bank">
                            <div class="summary-label" style="position: relative; display: inline-block;">
                                Bank Balance
                                <span class="glyphicon glyphicon-info-sign bankbal-info-icon" style="cursor: pointer; margin-left: 5px; color: #0052cc; "></span>
                                <div id="bankBalTooltip" class="stock-tooltip"></div>
                            </div>
                            <div class="summary-value" id="dvBank">₹ 0.00</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 dvBalances" style="margin-bottom: 10px;">
                    <div style="display: flex; gap: 10px;">
                        <div class="summary-tile bg-stockvalue">
                            <div class="summary-label" style="position: relative; display: inline-block;">
