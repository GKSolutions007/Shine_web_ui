    $("#btnSubmitmodalReportColumnSettings").click(function () {

            var ColumnSettingData = [];
            $("#tblReportSettings tbody tr").each(function () {
                var allValues = {};
                rowdata = tblReportSettings.row($(this)).data();
                //console.log("Row Data : ", rowdata);
                //Printwidth,PrintColumnName,PrintYN
                var aDisplayName = "", aWidth = "", aDisplayIndex = "", aAlign = "", aVisible = "",
                    aPrintwidth = "0", aPrintColumnName = "", aPrintYN = false,
                    aEnableColumnMenu = rowdata.EnableColumnMenu, aTotal = rowdata.Total,
                    aEnableSum = rowdata.EnableSum, aEnableAvg = rowdata.EnableAvg, aEnableCount = rowdata.EnableCount,
                    aEnableUnique = rowdata.EnableUnique, aShowinColumnOption = rowdata.ShowinColumnOption;
                $(this).find("input").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "DisplayColumnName") {
                        aDisplayName = $(this).val();
                    }
                    if (fieldName == "Width") {
                        aWidth = $(this).val();
                    }
                    if (fieldName == "DisplayIndex") {
                        aDisplayIndex = $(this).val();
                    }
                    if (fieldName == "Printwidth") {
                        aPrintwidth = $(this).val();
                    }
                    if (fieldName == "PrintColumnName") {
                        aPrintColumnName = $(this).val();
                    }

                    if (fieldName == "Visible") {
                        aVisible = this.checked ? "1" : "0";
                    }
                    if (fieldName == "Total") {
                        aTotal = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableColumnMenu") {
                        aEnableColumnMenu = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableSum") {
                        aEnableSum = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableAvg") {
                        aEnableAvg = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableCount") {
                        aEnableCount = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableUnique") {
                        aEnableUnique = this.checked ? "1" : "0";
                    }

                    if (fieldName == "ShowinColumnOption") {
                        aShowinColumnOption = this.checked ? "1" : "0";
                    }
                    if (fieldName == "PrintYN") {
                        aPrintYN = this.checked;
                    }

                });
                $(this).find("select").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "Alignment") {
                        aAlign = $(this).val();
                    }
                });

                var coldata = {
                    "FormID": rowdata.FormID,
                    "TableID": rowdata.TableID,
                    "ColumnID": rowdata.ColumnID,
                    "FormorReport": 0,
                    "ColumnName": rowdata.ColumnName,
                    "DisplayColumnName": aDisplayName,
                    "Width": aWidth,
                    "Visible": aVisible,
                    "Alignment": aAlign,
                    "TotalYN": aTotal,
                    "DisplayIndex": aDisplayIndex,
                    "EnableColumnMenu": aEnableColumnMenu,
                    "EnableAvg": aEnableAvg,
                    "EnableSum": aEnableSum,
                    "EnableColumnMenu": aEnableColumnMenu,
                    "ShowinColumnOption": aShowinColumnOption,
                    "PrintYN": aPrintYN,
                    "PrintColumnName": aPrintColumnName,
                    "Printwidth": 0,
                    "EnableCount": aEnableCount,
                    "EnableUnique": aEnableUnique
                };
                ColumnSettingData.push(coldata);
            });
            //console.log("ColumnSettingData : ", ColumnSettingData);
            $.ajax({
                url: Aurl + "columnsettings/Savecolumnsettings",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(ColumnSettingData),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            //ClearForm();
                            modalReportColumnsetting.style.display = "none";
                            GetColumnSettingsData(2, 1005, 1);
                            setTimeout(() => {
                                brandsummarygrid.columns = bransummarycolumnsettings;
                                brandsummarygrid.refreshColumns();
                            }, 500);
                        }
                        else {
                            showErrorSnackbar(items.Message);
                            //alert(items.Message);
                        }
                    });
                },
                error: function (data) {
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        ////showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
            ////console.log("Column Setting Data ", ColumnSettingData);

    });
</script>
