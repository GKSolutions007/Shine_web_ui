                </div>
                <div id="brandsummarygrid" style="height:600px;width:100%;"></div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(model => model.CollectionDetailEnable, new { @autocomplete = "off", @class = "form-control", @id = "txtCollectionDetailEnable" })
