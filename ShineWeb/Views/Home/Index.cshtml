    // Toggle overlay open / close with animation, move the button between the
    // right corner (closed) and left corner (open), and swap to a modern SVG icon.
    var ICON_OPEN = '<svg viewBox="0 0 24 24"><polyline points="15 6 9 12 15 18"></polyline></svg>';   // chevron-left = click to open
    var ICON_CLOSE = '<svg viewBox="0 0 24 24"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>'; // X = click to close
    setDate("dtpFFrom", 2);
    setDate("dtpFTo", 0);
    $('#btnToggleBrandOverlay').click(function (e) {
        e.preventDefault();
        var $overlay = $('#brandSummaryOverlay');
        var $icon = $('#iconToggleOverlay');
        var $btn = $(this);
        if (brandsummaryfirstclick) {
            brandsummaryfirstclick = false;
            $("#btnOverlayGenerate").trigger('click');
        }
        if ($overlay.hasClass('active')) {
            // Collapse overlay - button returns to the right corner
            $overlay.removeClass('active');
            $btn.removeClass('overlay-open');
            $icon.html(ICON_OPEN);
            $btn.attr('title', 'Open Brand Summary');
        } else {
            // Expand overlay to cover the body - button docks on the left corner
            $overlay.addClass('active');
            $btn.addClass('overlay-open');
            $icon.html(ICON_CLOSE);
            $btn.attr('title', 'Close Brand Summary');
        }
    });


    // Generate button - validate filters and load the Brand Summary table
    $('#btnOverlayGenerate').click(function (e) {
        e.preventDefault();
        $('#divErrOverlayFilter').html('');

        var BranchID = $('#cmbOverlayBranch').val();
        var FromDate = $('#dtpFFrom').val();
        var ToDate = $('#dtpFTo').val();
        var Inclusive = $('#chkOverlayInclusive').is(':checked') ? 1 : 0;

        var isValid = true;
        if (!FromDate) {
            isValid = false;
            $('#divErrOverlayFilter').html('Select From Date');
        } else if (!ToDate) {
            isValid = false;
            $('#divErrOverlayFilter').html('Select To Date');
        } else if (new Date(FromDate) > new Date(ToDate)) {
            isValid = false;
            $('#divErrOverlayFilter').html('From Date cannot be greater than To Date');
        }

        if (!isValid) {
            showErrorSnackbar($('#divErrOverlayFilter').html());
            return;
        }

        GetBrandSummaryData(BranchID, FromDate, ToDate, Inclusive);
    });
    $('#chkOverlayInclusive').click(function (e) {

