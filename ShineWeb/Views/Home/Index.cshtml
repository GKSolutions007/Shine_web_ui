            window.open(
                'Quotation?name=' + trn + '&strFormID=' + TransMode + '&TypeID=' + TransMode + '&TranID=' + ID,
                '_blank'
            );
        }
        else if (TransID == 16 || TransID == 17) {
            window.open(
                'SalesReturn?name=' + trn + '&strFormID=' + docprefix + '&TypeID=' + TransMode + '&TranID=' + ID,
