<script type="text/javascript">
    var RID = '@Session["RoleID"]';
    var Aurl = '@Session["APIurl"]';
    var HomePeriod = '@Session["HomePeriod"]';
    var AutoRefresh = parseInt('@Session["AutoRefresh"]') * 60;

    var TblDraftCount = $('#tblDraftCount').DataTable({
        "bFilter": false,
        "bSearchable": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0, 1], "visible": false, searchable: false }, { "targets": [3], "class": "dt-body-center" }],
    });
    var TblDraftData = $('#tblDraftData').DataTable({
        "bFilter": true,
        "bSearchable": true,
        "bInfo": true,
