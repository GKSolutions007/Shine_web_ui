                                <th style="text-align:right;">Sales</th>
                                <th style="text-align:right;">SR</th>
                                <th style="text-align:right;">DR</th>
                                <th style="text-align:right;">NET Sales</th>
                                <th style="text-align:right;">Closing</th>
                                <th style="text-align:right;">Dmg Closing</th>
                                <th style="text-align:center;" title="Outstandings/Invoice Count/Customer Count">OS/INV/CX</th>
                                <th style="text-align:right;">&gt;30 days</th>
                                <th style="text-align:right;" title="Total Customer Count">Cx Count</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="brand-os-summary">
                    <div class="brand-os-item">
                        <div class="brand-os-icon">
                            <i class="fa fa-wallet"></i>
                        </div>
