    function GetData(nMode, ID,ManufID = "1") {
        $.ajax({
            url: Aurl + "homescreendraft/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, Trans: ID, ID: ManufID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    if (data.length > 0) {
                        TblDraftCount.draw().clear(); TblDraftCount.draw().clear();
                        $.each(data, function (i, items) {
                            TblDraftCount.row.add([
                                items.ID,
                                items.Mode,
                                items.Name,
                                items.Value
                            ]).draw(false);
                        });
                    }
                }
                else if (nMode == 2) {
                    TblDraftData.draw().clear(); TblDraftData.draw().clear();
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            TblDraftData.row.add([
                                items.TransID,
                                items.ID,
                                items.TransMode,
                                items.EncDocPrefix,
                                items.DocID,
                                items.Date,
                                items.RefNo,
                                items.BranchID,
                                items.IsDraft,
                                items.DraftID,
                                items.VendorName,
                                items.GrossAmt,
                                items.TaxAmt,
                                items.NetAmt,
                            ]).draw(false);
                        });
                        //TblDraftData.column(5).visible(false);
                        //TblDraftData.column(6).visible(false);
                    }
                }
                if (nMode == 5) {
                    $("#dvCash,#dvBank").html("₹ 0.00");//,#dvStockvalue,#dvNetOS
                    var pmdata = eval(data);
                    if (pmdata.length > 0) {
                        $("#dvCash").html(formatIndianCurrency(pmdata[0].Balance));
                        $("#dvBank").html(formatIndianCurrency(pmdata[1].Balance));
                        //$("#dvStockvalue").html("₹ " + pmdata[2].Balance);
                        //$("#dvNetOS").html("₹ " + pmdata[3].Balance);
                    }
                }
                if (nMode == 6) {
                    arrTrans = [];
                    $('#cmbQAtransaction,#cmbManuf').find("option").remove();
                    $('#cmbQAtransaction').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $('#cmbManuf').append($('<option/>', {
                        value: 0,
                        text: "-- All --",
                    }));
                    var transdata = data.Table;
                    if (transdata.length > 0) {
                        $.each(transdata, function (i, items) {
                            $('#cmbQAtransaction').append($('<option/>', {
                                value: items.TransID,
                                text: items.TransName,
                                name: items.DocPrefix
                            }));
                            arrTrans.push(items);
                        });
                    } else {
                        //showErrorSnackbar("You dont have any Transaction permissions");
                    }
                    var Mfrs = data.Table1;
                    $.each(Mfrs, function (i, items) {
                        $('#cmbManuf').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    var BranchID = $('#cmbBranch').val();
                    var firstmfrid = Mfrs[0].ID;
                    GetData(12, BranchID, 0);
                }
                if (nMode == 8) {
                    $("#dvStockvalue").html("₹ 0.00");
                    arrStockValues = [];
                    var pmdata = JSON.parse(data);
                    arrStockValues = pmdata;
                    var sumofstock = arrStockValues.reduce((sum, a) => {
                        return sum + Number(a.orgStockValue || 0);
                    }, 0);
                    $("#dvStockvalue").html(formatIndianCurrency(sumofstock));
                    console.log(arrStockValues);
                }
                if (nMode == 9) {
                    $("#dvNetOS").html("₹ 0.00");
                    var pmdata = JSON.parse(data);
                    arrPartyOS = pmdata;
                    var Receivableos = arrPartyOS[0].OrgOS;
                    var Payableos = arrPartyOS[1].OrgOS;
                    var NetOS = Receivableos - Payableos;
                    $("#dvNetOS").html(formatIndianCurrency(NetOS));
                    console.log(arrPartyOS);
                }
                if (nMode == 10) {
                    arrCashBalances = [], arrBankBalances = [];
                    var brdata = JSON.parse(data);
                    arrCashBalances = brdata.Table;
                    arrBankBalances = brdata.Table1;
                }
                if (nMode == 11) {
                    $("#dvMobOT,#dvMobCashColl,#dvMobCheque,#dvMonBankTransfer").html("₹ 0.00 / 0");
                    var webdata = JSON.parse(data);
                    $("#dvMobOT").html(webdata[0].OTAmount || "&#8377; 0.00 / 0");
                    $("#dvMobCashColl").html(webdata[0].CashValue || "&#8377; 0.00 / 0");
                    $("#dvMobCheque").html(webdata[0].CheqValue || "&#8377; 0.00 / 0");
                    $("#dvMonBankTransfer").html(webdata[0].BTValue || "&#8377; 0.00 / 0");
                }
                if (nMode == 12) {
                    tblStockInHand.draw().clear(); tblStockInHand.draw().clear();
                    console.log("data", data);

                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            tblStockInHand.row.add([
                                items.Type,
                                items.ActualQty,
                                formatIndianCurrency(items.Price),
                                formatIndianCurrency(items.InclPrice)
                            ]).draw(false);
                        });

                    }
                }
                if (nMode == 13) {
                    tblOutstandings.draw().clear(); tblOutstandings.draw().clear();
                    if (data.length > 0) {
                        $.each(data, function (i, items) {                            
                            tblOutstandings.row.add([
                                items.Descriptions != 'Total' ? items.Descriptions : '<label style="font-size:12px;color:red">' + items.Descriptions+"</label>",
                                items.Descriptions != 'Total' ? formatIndianCurrency(items.Balance) : '<label style="font-size:12px;color:red">' + formatIndianCurrency(items.Balance) + "</label>",
                                items.Descriptions != 'Total' ? items.InvCount : '<label style="font-size:12px;color:red">' + items.InvCount + "</label>"
                            ]).draw(false);
                        });

                    }
                }
            }
        });
    }
