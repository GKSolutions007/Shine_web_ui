@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = "nopermission";
    Layout = "~/Views/Shared/_LayoutWithoutheader.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/Snackbar.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
@Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })

<style>
    :root {
        --np-primary: #ff4757;
        --np-primary-dark: #d63447;
        --np-bg-1: #1e2a4a;
        --np-bg-2: #3a1c47;
        --np-card-bg: rgba(255, 255, 255, 0.97);
        --np-text-dark: #1f2937;
        --np-text-muted: #6b7280;
        --np-accent: #4f7cff;
    }

    * {
        box-sizing: border-box;
    }

    html, body.np-body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    body.np-body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: linear-gradient(135deg, var(--np-bg-1) 0%, var(--np-bg-2) 100%);
        background-size: 200% 200%;
        animation: npGradientShift 12s ease infinite;
        padding: 20px;
        overflow-x: hidden;
    }

    @@keyframes npGradientShift {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    /* Floating background blobs */
    .np-blob {
        position: fixed;
        border-radius: 50%;
        filter: blur(60px);
        opacity: 0.35;
        z-index: 0;
        pointer-events: none;
    }

    .np-blob-1 {
        width: 320px;
        height: 320px;
        background: var(--np-primary);
        top: -80px;
        left: -80px;
        animation: npFloat1 9s ease-in-out infinite;
    }

    .np-blob-2 {
        width: 260px;
        height: 260px;
        background: var(--np-accent);
        bottom: -60px;
        right: -60px;
        animation: npFloat2 11s ease-in-out infinite;
    }

    @@keyframes npFloat1 {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(30px, 40px) scale(1.1);
        }
    }

    @@keyframes npFloat2 {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(-25px, -30px) scale(1.08);
        }
    }

    .np-card {
        position: relative;
        z-index: 1;
        left:-50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        max-width: 460px;
        width: 100%;
        margin: 0 auto;
        background: var(--np-card-bg);
        border-radius: 24px;
        padding: 44px 36px 36px;
        text-align: center;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        animation: npCardIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @@keyframes npCardIn {
        0% {
            opacity: 0;
            transform: translateY(40px) scale(0.92);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .np-icon-wrap {
        width: 96px;
        height: 96px;
        margin: 0 auto 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--np-primary) 0%, var(--np-primary-dark) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 30px rgba(255, 71, 87, 0.45);
        animation: npPulse 2.2s ease-in-out infinite;
        position: relative;
    }

        .np-icon-wrap::after {
            content: '';
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 2px solid rgba(255, 71, 87, 0.4);
            animation: npRing 2.2s ease-out infinite;
        }

    @@keyframes npPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.06);
        }
    }

    @@keyframes npRing {
        0% {
            transform: scale(1);
            opacity: 0.8;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .np-icon-wrap svg {
        width: 46px;
        height: 46px;
        stroke: #ffffff;
        animation: npShake 0.6s ease-in-out 0.6s;
    }

    @@keyframes npShake {
        0%, 100% {
            transform: rotate(0deg);
        }

        20% {
            transform: rotate(-8deg);
        }

        40% {
            transform: rotate(8deg);
        }

        60% {
            transform: rotate(-5deg);
        }

        80% {
            transform: rotate(5deg);
        }
    }

    .np-title {
        font-size: 22px;
        font-weight: 700;
        color: var(--np-text-dark);
        margin: 0 0 6px;
        letter-spacing: -0.3px;
    }

    .np-formname {
        font-size: 20px;
        font-weight: 800;
        margin: 0 0 18px;
        background: linear-gradient(135deg, var(--np-primary) 0%, var(--np-accent) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        word-break: break-word;
    }

    .np-subtext {
        font-size: 14.5px;
        color: var(--np-text-muted);
        margin: 0 0 26px;
        line-height: 1.6;
    }

        .np-subtext #runseconds {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 22px;
            height: 22px;
            padding: 0 4px;
            border-radius: 6px;
            background: rgba(255, 71, 87, 0.12);
            color: var(--np-primary-dark);
            font-weight: 700;
            font-style: normal;
            font-family: 'Segoe UI', sans-serif;
        }

    /* Circular countdown ring */
    .np-timer {
        position: relative;
        width: 92px;
        height: 92px;
        margin: 0 auto 26px;
    }

        .np-timer svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

    .np-timer-track {
        fill: none;
        stroke: rgba(31, 41, 55, 0.08);
        stroke-width: 6;
    }

    .np-timer-progress {
        fill: none;
        stroke: url(#npTimerGradient);
        stroke-width: 6;
        stroke-linecap: round;
        stroke-dasharray: 264;
        stroke-dashoffset: 0;
        transition: stroke-dashoffset 1s linear;
    }

    .np-timer-count {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }

        .np-timer-count .np-timer-number {
            font-size: 26px;
            font-weight: 800;
            color: var(--np-text-dark);
        }

        .np-timer-count .np-timer-label {
            margin-top: 2px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            color: var(--np-text-muted);
        }

    .np-btn {
        appearance: none;
        border: none;
        outline: none;
        cursor: pointer;
        width: 100%;
        padding: 14px 22px;
        font-size: 15.5px;
        font-weight: 600;
        color: #ffffff;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--np-accent) 0%, #6a5cff 100%);
        box-shadow: 0 12px 24px rgba(79, 124, 255, 0.35);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
    }

        .np-btn svg {
            width: 19px;
            height: 19px;
            stroke: #ffffff;
            transition: transform 0.2s ease;
        }

        .np-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 30px rgba(79, 124, 255, 0.45);
            filter: brightness(1.05);
        }

            .np-btn:hover svg {
                transform: translateX(4px);
            }

        .np-btn:active {
            transform: translateY(0);
            box-shadow: 0 8px 16px rgba(79, 124, 255, 0.35);
        }

    .np-footer-hint {
        margin-top: 16px;
        font-size: 12.5px;
        color: #9aa1af;
    }

    /* Responsive */
    @@media (max-width: 480px) {
        .np-card {
            padding: 34px 22px 28px;
            border-radius: 18px;
        }

        .np-icon-wrap {
            width: 80px;
            height: 80px;
        }

            .np-icon-wrap svg {
                width: 38px;
                height: 38px;
            }

        .np-title {
            font-size: 19px;
        }

        .np-formname {
            font-size: 18px;
        }

        .np-subtext {
            font-size: 13.5px;
        }

        .np-timer {
            width: 80px;
            height: 80px;
        }

        .np-timer-count .np-timer-number {
            font-size: 22px;
        }

        .np-timer-count .np-timer-label {
            font-size: 9px;
        }

        .np-btn {
            padding: 13px 18px;
            font-size: 14.5px;
        }
    }

    @@media (min-width: 992px) {
        .np-card {
            max-width: 500px;
            padding: 52px 44px 42px;
        }
    }
</style>

<body class="np-body">
    <div class="np-blob np-blob-1"></div>
    <div class="np-blob np-blob-2"></div>

    <div class="np-card">
        <div class="np-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="10" width="16" height="10" rx="2"></rect>
                <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
                <line x1="12" y1="14" x2="12" y2="16.5"></line>
            </svg>
        </div>

        <h3 class="np-title">You don't have permission to access</h3>
        <h2 class="np-formname" id="formName"></h2>
        <p class="np-subtext">
            This page will automatically redirect you to the Home page in
        </p>

        <div class="np-timer">
            <svg viewBox="0 0 92 92">
                <defs>
                    <linearGradient id="npTimerGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#ff4757" />
                        <stop offset="100%" stop-color="#4f7cff" />
                    </linearGradient>
                </defs>
                <circle class="np-timer-track" cx="46" cy="46" r="42"></circle>
                <circle class="np-timer-progress" id="timerRing" cx="46" cy="46" r="42"></circle>
            </svg>
            <div class="np-timer-count">
                <span class="np-timer-number" id="timerCount">10</span>
                <span class="np-timer-label">sec</span>
            </div>
        </div>

        <button id="btngotologin" class="np-btn" type="button">
            <span>Go to Home Now</span>
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </button>

        <p class="np-footer-hint">If this seems like a mistake, please contact your administrator.</p>
    </div>
</body>

<script type="text/javascript">
    $(function () {
        $("#formName").text($("#txtFormName").val());

        var runseconds = 10;
        var remaining = runseconds;
        var circumference = 264; // 2 * PI * r(42), matches stroke-dasharray above
        var Url = '@Session["url"].ToString()';
        var redirected = false;

        function redirectHome() {
            if (redirected) return;
            redirected = true;
            location.href = Url + 'home';
        }

        function tick() {
            $("#runseconds").text(remaining);
            $("#timerCount").text(remaining);
            var offset = circumference * (1 - (remaining / runseconds));
            $("#timerRing").css("stroke-dashoffset", offset);

            if (remaining <= 0) {
                clearInterval(intervalId);
                redirectHome();
                return;
            }
            remaining--;
        }

        tick();
        var intervalId = setInterval(tick, 1000);

        $("#btngotologin").on("click", function (e) {
            clearInterval(intervalId);
            redirectHome();
        });
    });
</script>
