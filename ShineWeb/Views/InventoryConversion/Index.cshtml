    function ReloadF8Autolistdata(strForm, strSub, strValue, strAssignValue) {
        console.log("ReloadF8Autolistdata CALLED");
        console.log("Parameters:", strForm, strSub, strValue, strAssignValue);
        $.ajax({
            url: Aurl + "masterlist",
            type: 'get',
            contentType: 'json',
            data: {
                FormName: strForm, SubField: strSub, Value: strValue
            },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                console.log("MASTERLIST RESPONSE:", data);
                console.log("MASTERLIST RESPONSE JSON:", JSON.stringify(data));
                if (strForm == "reason") {
                    console.log("strForm matched reason");
                    $('#cmbReason').find("option").remove();
                    $('#cmbReason').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        console.log("Adding item:", items);
                        $('#cmbReason').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                        $('#cmbReason').val(strAssignValue);
                    });

                }
            }
        });
    }




