        $("#btnSave,#btnClear,#btnDraft").hide();
        $("#dvMain").show();
        $("#dvDocuments").hide();
        $("#btnEmail,#btnWhatsapp").show();
        $("#MainHeading").text("View " + $("#txtFormName").val());
    }

</script>