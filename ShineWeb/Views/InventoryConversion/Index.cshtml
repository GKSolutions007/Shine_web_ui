    var ProductArray = [];
    function addProdinArray() {
        ProductArray = [];
        var dPTQty = 0, dPTFreeQty = 0, dPTDmgQty = 0, dPTGross = 0, dPTActQty = 0, dPTActFreeQty = 0, dPTActDmgQty = 0,
            nProdID = 0, nUOMID = 0, PDAmt = 0, nSerial = 1, val = 0;
        $("#tblProductData tbody tr").each(function () {
            var allValues = {};
            rowdata = ProductTable.row($(this)).data();
            nProdID = rowdata[0];
            nUOMID = rowdata[2];

            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Qty") {
                    val = $(this).attr("txttag");
                    dPTQty = parseFloat(val);//$(this).val()
                }
            });
            $(this).find("label").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");

                if (fieldName == "Gross") {
                    val = $(this).attr("lbltag")
                    dPTGross = parseFloat(val);//$(this).text()
                }

            });
            var listProds = {
                "ProdID": nProdID,
                "UomID": nUOMID,
                "UomQty": dPTQty,
                "UomFreeQty": dPTFreeQty,
                "UomDamageQty": dPTDmgQty,
                "AdjQty": dPTActQty,
                "AdjFreeQty": dPTActFreeQty,
                "AdjDmgQty": dPTActDmgQty,
                "GrossAmt": dPTGross,
                "Serial": nSerial
            }
            ProductArray.push(listProds);
            nSerial++;
        });
    }
