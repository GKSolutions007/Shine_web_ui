    function GetData(nMode, strName = null, strID = null) {
        $.ajax({
            url: Aurl + "inventoryconvertion/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, CodeName: strName, ID: strID, BranchID: $("#cmbBranch").val(), Date: $("#dtpDate").val(), ConvType: $('#cmbConvertionType').val() },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbBranch,#cmbFilterBranch,#cmbConvertionType,#cmbReason').find("option").remove();
                    $('#cmbBranch,#cmbFilterBranch,#cmbConvertionType,#cmbReason').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrVendor = [], arrVendorCode = [], arrVendorName = [], arrProd = [];
                    nIndexarrVendor = 0, nIndexarrProd = 0;
                    $.each(data, function (i, items) {

                        if (items.FType == 1) {
                            $('#cmbBranch,#cmbFilterBranch').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 2) {
                            $('#cmbConvertionType').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 3) {
                            $("#lblDocID").text(items.Name);
                        }
                        if (items.FType == 4) {
                            $('#cmbReason').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                    });
                    //$("#cmbBranch").val(DefBranch);
                    LoadBranchByRoles('#cmbBranch,#cmbFilterBranch');
                }
                else if (nMode == 2) {
                    arrProdCode = [], arrProdName = [], arrProdCodeName = [],TempAL = [];
                    TableSelectProd.clear().draw();
                    if (data.length > 0) {
                        var tpn = "";
                        $.each(data, function (i, items) {
                            arrProdCode[i] = items.Code;
                            arrProdName[i] = items.Name;
                            arrProdCodeName[i] = items.Code + "|" + items.Name + "<br>" + "|HSN : " + items.HSNCode + "|Price : " + items.PurchasePrice + " | Qty : " + items.ABSQty;
                            tpn = items.Name;
                            var clr = parseFloat(items.ABSQty) > 0 ? "green" : "red";
                            var al = {
                                "label": items.Code + " | " + items.Name,
                                "name": items.Name,
                                "code": items.Code,
                                "id": items.ID,
                                "ABS": "Qty:<label style='color:" + clr + "'> " + items.ABSQty + " </label>",
                                "line2": "Price : " + items.PurchasePrice + " | Qty :  <label style='color:" + clr + "'> " + items.ABSQty + " </label>"
                            }
                            TempAL.push(al);
                        });
                        //~AutoList
                        PaginatedAutocomplete({
                            inputId: "txtHProds",
                            data: TempAL,
                            startwitfieldname: startwithfield,
                            enablefilterstartwith: autolistfilterwith,
                            onSelect: function (item) {
                                $("#txtHProds").val(item.code);
                                if ($("#cmbBranch").val() > 0) {
                                    var qtyonly = 0;//
                                    GetData(3, item.code, qtyonly);
                                    $("#btnBatch").focus();
                                }
                                else {
                                    showErrorSnackbar("Select Branch");
                                    $('#txtHProds').val("");
                                    $("#cmbBranch").focus();
                                }
                                return false;
                            }
                        });
                    }
                    else {
                    }
                }
                else if (nMode == 3) {
                    $('#cmbUOM').find("option").remove();
                    //$('#cmbUOM').append($('<option/>', {
                    //    value: 0,
                    //    text: "-- Select --",
                    //}));
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            $('#txtHProdID').val(items.ID);
                            $('#txtHProdCode').val(items.Code);
                            $('#lblProdCodeAS').text("Code : " + items.Code);
                            $('#txtHProds').val(items.Name);
                            $('#txtHSN').val(items.HSNCode);

                            var BatEnb = items.BatchNo == "True" ? true : false;
                            var PKDEnb = items.PKD == "True" ? true : false;
                            //txtBatchTrackBatch, txtBatchTrackPKD
                            TableBatch.column(6).visible(BatEnb);
                            TableBatch.column(7).visible(PKDEnb);
                            TableBatch.column(8).visible(PKDEnb);
                            for (var j = 0; j < items.UOMList.length; j++) {
                                $('#cmbUOM').append($('<option/>', {
                                    value: items.UOMList[j].ID,
                                    text: items.UOMList[j].Name,
                                    name: items.UOMList[j].ConvRate,
                                }));
                            }
                            TempBatch = items.PRBatchInfo;
                        });
                        TempProd = data;
                        $('#cmbUOM').val(TempProd[0].BaseUomID);
                        var uomname = $('#cmbUOM option:selected').text();
                    }
                }
                else if (nMode == 6 || nMode == 10) {
                    Table.clear().draw(); Table.clear().draw();
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            Table.row.add([
                                items.ID,
                                items.DocID,
                                items.Date,
                                items.RefNo,
                                items.BranchID,
                                items.VendorID,
                                items.GrossAmt,
                                items.TaxAmt,
                                items.NetAmt,
                                items.Status,
                                items.Status == 'Amended' || items.Status == 'Cancelled' ? '' : '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-pencil clsEdit" style="font-size:16px" title="Edit"></span></a>',
                                items.Status == 'Amended' || items.Status == 'Cancelled' ? '' : '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-remove-circle clsCancel" style="font-size:16px" title="Cancel"></span></a>',
                                '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-eye-open clsView" style="font-size:16px" title="View"></span></a>',
                                '<a href="javascript:void(0)" class="clsVariant" style = "font-size:12px;cursor: pointer;"><span class="glyphicon glyphicon-file clsVariant" style="font-size:12px" title="Variant"></span></a>',
                            ]).draw(false);
                        });
                    }
                    else {
                        showErrorSnackbar("No records found");
                    }
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
