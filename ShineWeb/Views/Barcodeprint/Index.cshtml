    //~Calculation
    function calculateProdGrid() {
        
        // Reset footer labels to zero
        $(".lblPT").text("0.00");
        const rowCount = ProductTable.rows().count();
        

        // Accumulators
        let dPTQty = 0, dPTGoods = 0, dPTGross = 0, dPTTax = 0, dPTNet = 0;
        let TotProdDisc = 0, TotTradeDisc = 0, TotAddnlDisc = 0;
        let DiffExcl = 0, DiffIncl = 0;

        // Helper: read txttag/lbltag as float from any element
        const tag = (el, attr) => parseFloat(el?.getAttribute(attr) || 0) || 0;

        $("#tblProductData tbody tr").each(function () {
            const $row = $(this);
            const rowdata = ProductTable.row(this).data();
          
            // Read all inputs by name using txttag attribute
            const getInput = (name) => {
                const el = this.querySelector(`input[name="${name}"]`);
                return el ? tag(el, "txttag") : 0;
            };
            const getLabel = (name) => {
                const el = this.querySelector(`label[name="${name}"]`);
                return el ? tag(el, "lbltag") : 0;
            };

            const qty = getInput("Qty");
          
            dPTQty += qty;
           
            // UOM conversion factor
            const uomEl = this.querySelector("select[name='UOM'] option:checked");
            const cf = parseFloat(uomEl?.getAttribute("name") || 1) || 1;
        });

        // Footer totals
        updateLabelColumn("lblPTQty", dPTQty);      
        // Item count
        $("#lblPTCount").text(rowCount);

        //Gross & Tot Disc Amt
      
        ProductTable.columns.adjust().draw();      
    }
    

