    $(document).on('keydown', function (e) {//$(document)
        //if (!modal || !modal._isShown) return;
        var isModalshow = document.getElementById('myModalfg').style.display == "block";
        //showSuccessSnackbar(isModalshow);
        if (!isModalshow) return;
        let $selected = $('#tblBatch tbody tr.selected');
        //console.log("Batch Keydown Triggered", new Date().toISOString());

        // If no row selected → select first row
        if ($selected.length === 0) {
            //console.log("No Batch Selected", new Date().toISOString());
            let first = $('#tblBatch tbody tr:first');
            first.addClass('selected');
            return;
        }

        // 🔼 UP arrow
        if (e.key === "ArrowUp") {
            ItemALEnterClicked = false;
            let prev = $selected.prev('tr');
            if (prev.length) {
                $selected.removeClass('selected');
                prev.addClass('selected');
                scrollToRow(prev);
            } else {
                scrollToRow($selected);
            }
            e.preventDefault();
        }

        // 🔽 DOWN arrow
        else if (e.key === "ArrowDown") {
            ItemALEnterClicked = false;
            let next = $selected.next('tr');
            if (next.length) {
                $selected.removeClass('selected');
                next.addClass('selected');
                scrollToRow(next);
            } else {
                scrollToRow($selected);
            }
            e.preventDefault();
        }

        // ⏎ ENTER key → get row data
        else if (e.key === "Enter") {
            //showSuccessSnackbar("Batch row select enter");
            let rowData = TableBatch.row($('.selected')).data();
            //console.log("Selected Batch Row Data:", new Date().toISOString());
            if (!ItemALEnterClicked) {
                applyBatchdatatoItemrow(rowData);
            } else { ItemALEnterClicked = false; }
            e.preventDefault();
        }
    });
