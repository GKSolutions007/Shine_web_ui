    var ProductArray = [];
    function addProdinArray() {
        ProductArray = [];
        let serial = 1;

        const getNum = (el, attr) => parseFloat($(el).attr(attr)) || 0;

        $("#tblProductData tbody tr").each(function () {
            $(this).css("color", "black");
            $(this).find("p,label,input, select").animate({ color: 'black' }, 100);
            const rowData = ProductTable.row(this).data();
            if (!rowData || !rowData[0]) return;

            const qty = getNum($(this).find("input[name='Qty']"), "txttag");
            if (qty <= 0) return;

            const uom = $(this).find("select[name='UOM']");
            const uomID = parseInt(uom.val()) || 0;
            const ReasonID = $(this).find("select[name='Reason']").val();
           
            ProductArray.push({
                ProdID: rowData[0],
                InventoryId: rowData[1],
                TaxID: rowData[2],
                TaxPern: rowData[3],
                OrgPrice: rowData[4],
                OrgUomID: rowData[5],
                BatchNo: rowData[19],
                PKD: rowData[20],
                Expiry: rowData[21],
                InvYN: rowData[8],
                BatchYN: rowData[9],
                PKDYN: rowData[10],
                UomID: uomID,
                ConvFact: uom.find(":selected").attr("name"),
                UomQty: qty,
                MRP: getNum($(this).find("input[name='MRP']"), "txttag"),
                SalePrice: getNum($(this).find("input[name='Excl']"), "txttag"),
                ReasonId: ReasonID,
                Serial: serial++
            });
        });
    }
