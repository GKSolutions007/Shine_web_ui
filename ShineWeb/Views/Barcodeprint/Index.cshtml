                        <th style="text-align:center;font-size:12px;width:8%;" class="trclrforcolheader">PKD</th>
                        <th style="text-align:center;font-size:12px;width:8%;" class="trclrforcolheader">Expiry</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <td colspan="14"><label>Total :</label></td>
