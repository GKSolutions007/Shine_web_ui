                <button type="button" class="btn btn-save-style" id="btnSave"><span class="glyphicon glyphicon-saved"> Save</span></button>
                <button type="button" class="btn btn-close-style" id="btnClose"><i class="bi bi-x-circle"></i> Close</button>
