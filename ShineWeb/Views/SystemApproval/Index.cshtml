<style>
    :root {
        --primary: #4f46e5;
        --primary-light: #818cf8;
        --primary-dark: #3730a3;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --bg-glass: rgba(255,255,255,0.75);
        --bg-card: #ffffff;
        --border-color: #e0e7ff;
        --text-main: #1e1b4b;
        --text-muted: #6b7280;
        --radius: 14px;
        --shadow: 0 4px 24px rgba(79,70,229,0.10);
        --shadow-hover: 0 8px 32px rgba(79,70,229,0.18);
        --row-hover: #eef2ff;
        --subtable-bg: #f5f3ff;
        --header-bg: linear-gradient(120deg, #4f46e5 0%, #7c3aed 100%);
    }

    body {
        background: #f0f2ff;
    }

    /* ── Page Header ── */
    .page-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px 24px 14px;
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        margin-bottom: 20px;
        border-left: 5px solid var(--primary);
    }

        .page-header .icon-wrap {
            width: 42px;
            height: 42px;
            background: var(--header-bg);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 20px;
            flex-shrink: 0;
        }

        .page-header h4 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: 0.3px;
        }

        .page-header small {
            font-size: 12px;
            color: var(--text-muted);
        }

    /* ── Card wrapper ── */
    .da-card {
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .da-card-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border-color);
        background: linear-gradient(90deg,#f5f3ff 0%,#ede9fe 100%);
    }

        .da-card-toolbar .toolbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .toolbar-left span {
        font-weight: 600;
        font-size: 13px;
        color: var(--primary-dark);
    }

    .search-wrap {
        position: relative;
    }

        .search-wrap input {
            padding: 6px 12px 6px 34px;
            border: 1.5px solid var(--border-color);
            border-radius: 8px;
            font-size: 12px;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
            width: 200px;
            color: var(--text-main);
            background: #fff;
        }

            .search-wrap input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(79,70,229,0.12);
            }

        .search-wrap .bi-search {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 13px;
            pointer-events: none;
        }

    /* ── Master Table ── */
    .da-table-wrap {
        overflow-x: auto;
    }

    #tblMasterData {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
    }

        #tblMasterData thead tr {
            background: var(--header-bg);
        }

        #tblMasterData thead th {
            color: #fff;
            font-weight: 600;
            font-size: 12px;
            padding: 11px 14px;
            text-align: center;
            letter-spacing: 0.4px;
            white-space: nowrap;
            border: none;
        }

        #tblMasterData tbody tr.master-row {
            cursor: pointer;
            transition: background .18s, transform .12s;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-main);
        }

            #tblMasterData tbody tr.master-row:hover {
                background: var(--row-hover);
            }

            #tblMasterData tbody tr.master-row.expanded {
                background: #ede9fe;
            }

        #tblMasterData tbody td {
            padding: 3px 14px;
            vertical-align: middle;
            border: none;
        }

    .expand-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 6px;
        background: var(--primary);
        color: #fff;
        font-size: 13px;
        transition: transform .25s cubic-bezier(0.4,0,0.2,1), background .2s;
        flex-shrink: 0;
    }

    .expanded .expand-icon {
        transform: rotate(90deg);
        background: var(--primary-dark);
    }

    .td-user {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--header-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        font-size: 13px;
        flex-shrink: 0;
    }

    .badge-count {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #ede9fe;
        color: var(--primary-dark);
        padding: 3px 9px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
    }

    /* ── Sub Table Row ── */
    tr.sub-row td {
        padding: 10px !important;
        border: none !important;
    }

    .sub-row-inner {
        display: none;
        overflow: hidden;
    }

        .sub-row-inner.show {
            display: block;
            animation: slideDown .28s cubic-bezier(0.4,0,0.2,1);
        }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .subtable-wrap {
        margin: 8px 24px 12px 40px;
        background: var(--subtable-bg);
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #c7d2fe;
        box-shadow: 0 2px 12px rgba(79,70,229,0.07);
    }

    .subtable-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        background: linear-gradient(90deg,#4f46e5 0%,#7c3aed 100%);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
    }

    table.sub-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
    }

        table.sub-table thead th {
            background: #296bf5;
            color: var(--primary-dark);
            font-weight: 700;
            padding: 8px 12px;
            text-align: center;
            border-bottom: 1.5px solid #c7d2fe;
            white-space: nowrap;
        }

        table.sub-table tbody tr {
            border-bottom: 1px solid #e0e7ff;
            transition: background .15s;
        }

            table.sub-table tbody tr:last-child {
                border-bottom: none;
            }

            table.sub-table tbody tr:hover {
                background: #ede9fe;
            }

        table.sub-table td {
            padding: 8px 12px;
            color: var(--text-main);
            text-align: center;
            vertical-align: middle;
        }

    .no-devices {
        padding: 14px;
        text-align: center;
        color: var(--text-muted);
        font-size: 12px;
    }

    /* ── Buttons ── */
    .btn-activate {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 11px;
        background: var(--success);
        color: #fff;
        border: none;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: background .18s, transform .12s, box-shadow .18s;
        box-shadow: 0 2px 8px rgba(16,185,129,0.18);
    }

        .btn-activate:hover {
            background: #059669;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(16,185,129,0.28);
        }

    .btn-deactivate {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 11px;
        background: var(--danger);
        color: #fff;
        border: none;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: background .18s, transform .12s, box-shadow .18s;
        box-shadow: 0 2px 8px rgba(239,68,68,0.18);
    }

        .btn-deactivate:hover {
            background: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(239,68,68,0.28);
        }

    /* Locate button */
    .btn-locate {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 11px;
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: background .18s, transform .12s, box-shadow .18s;
        box-shadow: 0 2px 8px rgba(79,70,229,0.18);
    }

        .btn-locate:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(79,70,229,0.28);
        }


    /* status badge */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 10.5px;
        font-weight: 600;
    }

        .status-badge.active {
            background: #d1fae5;
            color: #065f46;
        }

        .status-badge.inactive {
            background: #fee2e2;
            color: #991b1b;
        }

    /* ── Remove All Device button ── */
    .btn-remove-all {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 13px;
        background: var(--danger);
        color: #fff;
        border: none;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background .18s, transform .12s, box-shadow .18s;
        box-shadow: 0 2px 8px rgba(239,68,68,0.20);
    }

        .btn-remove-all:hover {
            background: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(239,68,68,0.30);
        }

    /* ── Pagination / footer ── */
    .da-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 18px;
        border-top: 1px solid var(--border-color);
        font-size: 12px;
        color: var(--text-muted);
        flex-wrap: wrap;
        gap: 8px;
    }

    .da-pager {
        display: flex;
        gap: 4px;
    }

        .da-pager button {
            border: 1.5px solid var(--border-color);
            background: #fff;
            border-radius: 7px;
            padding: 4px 10px;
            font-size: 12px;
            cursor: pointer;
            color: var(--primary);
            transition: background .15s, border-color .15s;
        }

            .da-pager button:hover, .da-pager button.active {
                background: var(--primary);
                color: #fff;
                border-color: var(--primary);
            }

            .da-pager button:disabled {
                opacity: .45;
                cursor: default;
            }

    /* Toast */
    .toastBox {
        position: fixed;
        top: 70px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .da-toast {
        min-width: 230px;
        padding: 12px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #fff;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        animation: toastIn .3s ease;
    }

        .da-toast.success {
            background: var(--success);
        }

        .da-toast.error {
            background: var(--danger);
        }

    @@keyframes toastIn {
        from {
            opacity: 0;
            transform: translateX(40px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-muted);
    }

        .empty-state i {
            font-size: 40px;
            color: #c7d2fe;
            margin-bottom: 10px;
            display: block;
        }

    /* Loading overlay */
    #da-loading {
        position: absolute;
        inset: 0;
        background: rgba(255,255,255,0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        border-radius: var(--radius);
    }

    .spinner {
        width: 36px;
        height: 36px;
        border: 3px solid #e0e7ff;
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin .7s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .da-card-body {
        position: relative;
        min-height: 100px;
    }

    th.hidden-col,
    td.hidden-col {
        display: none;
    }
</style>

<body>
    <!-- Page Header -->
    <div class="page-header">
        <div class="icon-wrap"><i class="bi bi-shield-lock-fill"></i></div>
        <div>
            <h4>Device Approval</h4>
            <small>Manage and approve user device registrations</small>
        </div>
    </div>

    <div class="da-card">
        <!-- Toolbar -->
        <div class="da-card-toolbar">
            <div class="toolbar-left">
                <i class="bi bi-people-fill" style="color:var(--primary);font-size:16px;"></i>
                <span>User List</span>
                <span id="lblUserCount" class="badge-count"><i class="bi bi-person"></i> 0</span>
            </div>
            <div class="search-wrap">
                <i class="bi bi-search"></i>
                <input type="text" id="txtSearch" placeholder="Search users..." />
            </div>
        </div>

        <!-- Table body -->
        <div class="da-card-body">
            <div id="da-loading"><div class="spinner"></div></div>
            <div class="da-table-wrap">
                <table id="tblMasterData">
                    <thead>
                        <tr>
                            <th class="hidden-col">UserID</th>
                            <th class="trclrforcolheader" style="width:50px">#</th>
                            <th class="trclrforcolheader" style="text-align:left">User Name</th>
                            <th class="trclrforcolheader">Mobile No</th>
                            <th class="trclrforcolheader">Device Count</th>
                            <th class="trclrforcolheader" style="width:60px"></th>
                        </tr>
                    </thead>
                    <tbody id="tblBody">
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="bi bi-hourglass-split"></i>
                                    Loading data...
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer / Pagination -->
        <div class="da-footer">
            <span id="lblPageInfo"></span>
            <div class="da-pager" id="pager"></div>
        </div>
    </div>

    <!-- Toast container -->
    <div class="toastBox"></div>
</body>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-confirm/3.3.0/jquery-confirm.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-confirm/3.3.0/jquery-confirm.min.js"></script>

<script type="text/javascript">
    var Aurl = '@Session["APIurl"]';
    var UID  = '@Session["LoginUserID"]';
    var RID  = '@Session["RoleID"]';
    var UserInfo = [], UserDeviceInfo = [];

    // ── Pagination state ──────────────────────────────────────────────
    var pageSize    = 10;
    var currentPage = 1;
    var filteredData = [];
    var expandedRow = null;   // currently expanded UserID

    // ── Init ──────────────────────────────────────────────────────────
    InitiateData();

    function InitiateData() {
        $('#da-loading').show();
        UserInfo = []; UserDeviceInfo = [];

        $.ajax({
            url: Aurl + "DeviceApproval/get",
            type: 'GET',
            datatype: 'json',
            data: { Mode: 1 },
            success: function (data) {
                var DevData   = JSON.parse(data);
                UserInfo      = DevData.Table  || [];
                UserDeviceInfo= DevData.Table1 || [];
                filteredData  = UserInfo.slice();
                expandedRow   = null;
                $('#lblUserCount').html('<i class="bi bi-person"></i> ' + UserInfo.length);
                currentPage = 1;
                renderTable();
                $('#da-loading').hide();
            },
            error: function () {
                $('#da-loading').hide();
                showToast('Failed to load data.', 'error');
            }
        });
    }

    // ── Search ────────────────────────────────────────────────────────
    $('#txtSearch').on('input', function () {
        var q = $(this).val().trim().toLowerCase();
        filteredData = UserInfo.filter(function (u) {
            return u.UserName.toLowerCase().includes(q) ||
                   String(u.Mobilenumber).includes(q);
        });
        expandedRow  = null;
        currentPage  = 1;
        renderTable();
    });

    // ── Render master table rows ──────────────────────────────────────
    function renderTable() {
        var tbody = $('#tblBody');
        tbody.empty();

        if (filteredData.length === 0) {
            tbody.html('<tr><td colspan="6"><div class="empty-state"><i class="bi bi-inbox"></i>No users found.</div></td></tr>');
            renderPager();
            return;
        }

        var totalPages = Math.ceil(filteredData.length / pageSize);
        if (currentPage > totalPages) currentPage = totalPages;
        var start = (currentPage - 1) * pageSize;
        var pageData = filteredData.slice(start, start + pageSize);

        $.each(pageData, function (i, u) {
            var globalIdx = start + i + 1;
            var initial   = (u.UserName || '?').charAt(0).toUpperCase();
            // master row
            var masterRow = $('<tr class="master-row" data-userid="' + u.UserID + '"></tr>');
            masterRow.html(
                '<td class="hidden-col">' + u.UserID + '</td>' +
                '<td style="text-align:center;">' + globalIdx + '</td>' +
                '<td><div class="td-user">' +
                    '<span class="avatar">' + initial + '</span>' +
                    '<span>' + u.UserName + '</span>' +
                '</div></td>' +
                '<td style="text-align:center;"><i class="bi bi-phone" style="color:var(--primary-light);margin-right:4px;"></i>' + (u.Mobilenumber || '-') + '</td>' +
                '<td style="text-align:center;"><span class="badge-count"><i class="bi bi-devices"></i> ' + (u.DeviceCount || 0) + '</span></td>' +
                '<td style="text-align:center;"><button class="btn-remove-all" data-userid="' + u.UserID + '"><i class="bi bi-trash3-fill"></i> Remove All Device</button></td>'
            );

            // sub row (hidden)
            var subRow = $('<tr class="sub-row" data-for="' + u.UserID + '"></tr>');
            var subTd  = $('<td colspan="6"></td>');
            var subInner = $('<div class="sub-row-inner"></div>');
            subTd.append(subInner);
            subRow.append(subTd);

            tbody.append(masterRow);
            tbody.append(subRow);
        });

        renderPager();
        setupRowClick();

        // Re-expand if still on same page
        if (expandedRow !== null) {
            var targetRow = $('tr.master-row[data-userid="' + expandedRow + '"]');
            if (targetRow.length) {
                expandRowFor(expandedRow, targetRow, false);
            } else {
                expandedRow = null;
            }
        }
    }

    // ── Row click → expand / collapse ────────────────────────────────
    function setupRowClick() {
        $('#tblBody').off('click', '.master-row').on('click', '.master-row', function (e) {
            // Don't expand/collapse when clicking the Remove All Device button
            if ($(e.target).closest('.btn-remove-all').length) return;

            var uid      = $(this).data('userid');
            var subInner = $('tr.sub-row[data-for="' + uid + '"] .sub-row-inner');

            if ($(this).hasClass('expanded')) {
                // collapse this row
                collapseRow($(this), subInner);
                expandedRow = null;
            } else {
                // collapse any open row first
                if (expandedRow !== null) {
                    var openMaster = $('tr.master-row[data-userid="' + expandedRow + '"]');
                    var openInner  = $('tr.sub-row[data-for="' + expandedRow + '"] .sub-row-inner');
                    collapseRow(openMaster, openInner);
                }
                expandRowFor(uid, $(this), true);
                expandedRow = uid;
            }
        });

        // Remove All Device button
        $('#tblBody').off('click', '.btn-remove-all').on('click', '.btn-remove-all', function (e) {
            e.stopPropagation();
            var userId = $(this).data('userid');
            RemoveAllDevices(userId);
        });
    }

    function collapseRow(masterRow, subInner) {
        masterRow.removeClass('expanded');
        subInner.removeClass('show');
    }

    function expandRowFor(uid, masterRow, animate) {
        var devices = UserDeviceInfo.filter(function (d) {
            return String(d.UserID) === String(uid);
        });

        var subInner = $('tr.sub-row[data-for="' + uid + '"] .sub-row-inner');
        subInner.empty();

        var wrapper = $('<div class="subtable-wrap"></div>');
        //var header  = $('<div class="subtable-header"><i class="bi bi-phone-fill"></i> Registered Devices</div>');
        wrapper.append(header);

        if (devices.length === 0) {
            wrapper.append('<div class="no-devices"><i class="bi bi-info-circle me-1"></i>No devices registered for this user.</div>');
        } else {
            var tbl = $('<table class="sub-table"></table>');
            tbl.append(
                '<thead><tr>' +
                '<th class="hidden-col">ID</th>' +
                '<th>#</th>' +
                '<th>Login Time</th>' +
                '<th>Pincode</th>' +
                '<th>Active</th>' +
                '<th class="hidden-col">Latitude</th>' +
                '<th class="hidden-col">Latitude</th>' +
                '<th>Action</th>' +
                '</tr></thead>'
            );
            var tbody = $('<tbody></tbody>');
            $.each(devices, function (i, d) {
                var isActive = (parseInt(d.Active) === 1);

                // Yes / No badge for Active column
                var activeBadge = isActive
                    ? '<span class="status-badge active"><i class="bi bi-check-circle-fill"></i> Yes</span>'
                    : '<span class="status-badge inactive"><i class="bi bi-x-circle-fill"></i> No</span>';

                // Locate icon button (always shown)
                var locateBtn = '<button class="btn-locate btnLocate" data-lat="' + (d.Latitude || '') + '" data-lng="' + (d.Longtitude || '') + '" title="Locate Device"><i class="bi bi-geo-alt-fill"></i> Locate</button>';

                // Approve (Active=0) or Remove (Active=1)
                var actionBtn = isActive
                    ? '<button class="btn-deactivate btnDeActivates" data-deviceid="' + d.DeviceID + '" data-userid="' + d.UserID + '"><i class="bi bi-trash3-fill"></i> Remove</button>'
                    : '<button class="btn-activate btnActivates" data-deviceid="' + d.DeviceID + '" data-userid="' + d.UserID + '"><i class="bi bi-check-circle-fill"></i> Approve</button>';

                tbody.append(
                    '<tr>' +
                    '<td class="hidden-col">' + (d.ID) + '</td>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + (d.LoginTime || '-') + '</td>' +
                    '<td>' + (d.Pincode || '-') + '</td>' +
                    '<td>' + activeBadge + '</td>' +
                    '<td class="hidden-col">' + (d.Latitude) + '</td>' +
                    '<td class="hidden-col">' + (d.Longtitude) + '</td>' +
                    '<td><div style="display:flex;gap:5px;justify-content:center;align-items:center;">' + actionBtn + locateBtn + '</div></td>' +
                    '</tr>'
                );
            });
            tbl.append(tbody);
            wrapper.append(tbl);
        }
        subInner.append(wrapper);
        masterRow.addClass('expanded');
        if (animate) {
            subInner.addClass('show');
        } else {
            subInner.addClass('show');
        }
    }

    // ── Sub-table button events ───────────────────────────────────────
    $('#tblBody').on('click', '.btnActivates', function (e) {
        e.stopPropagation();
        var deviceId = $(this).data('deviceid');
        var userId   = $(this).data('userid');
        ActiveandDeActivateUser(5, deviceId, userId);
    });
    $('#tblBody').on('click', '.btnDeActivates', function (e) {
        e.stopPropagation();
        var deviceId = $(this).data('deviceid');
        var userId   = $(this).data('userid');
        ActiveandDeActivateUser(6, deviceId, userId);
    });
    $('#tblBody').on('click', '.btnLocate', function (e) {
        e.stopPropagation();
        var lat = $(this).data('lat');
        var lng = $(this).data('lng');
        if (lat && lng) {
            window.open('https://www.google.com/maps?q=' + lat + ',' + lng, '_blank');
        } else {
            showToast('Location data not available for this device.', 'error');
        }
    });

    // ── Activate / Deactivate ─────────────────────────────────────────
    function ActiveandDeActivateUser(Mode, DeviceID, UserID) {
        $.ajax({
            url: Aurl + "SystemApproval/save",
            type: 'GET',
            datatype: 'json',
            data: { nMode: Mode, nDeviceID: DeviceID, nUserID: UserID },
            success: function (data) {
                if (Mode == 5) {
                    showToast('Device Activated Successfully!', 'success');
                    // update local data
                    var d = UserDeviceInfo.find(function(x){ return String(x.DeviceID) === String(DeviceID); });
                    if (d) d.IsActive = 1;
                } else {
                    showToast('Device Deactivated Successfully!', 'error');
                    var d = UserDeviceInfo.find(function(x){ return String(x.DeviceID) === String(DeviceID); });
                    if (d) d.IsActive = 0;
                }
                // Re-render the sub-row in place
                if (expandedRow !== null) {
                    var masterRow = $('tr.master-row[data-userid="' + expandedRow + '"]');
                    expandRowFor(expandedRow, masterRow, false);
                }
            },
            error: function () {
                showToast('Operation failed. Please try again.', 'error');
            }
        });
    }

    // ── Pagination ────────────────────────────────────────────────────
    function renderPager() {
        var total      = filteredData.length;
        var totalPages = Math.ceil(total / pageSize) || 1;
        var start      = Math.min((currentPage - 1) * pageSize + 1, total);
        var end        = Math.min(currentPage * pageSize, total);

        $('#lblPageInfo').text('Showing ' + (total ? start : 0) + '–' + end + ' of ' + total + ' users');

        var pager = $('#pager');
        pager.empty();

        // Prev
        var prevBtn = $('<button><i class="bi bi-chevron-left"></i></button>');
        if (currentPage === 1) prevBtn.prop('disabled', true);
        prevBtn.on('click', function () { currentPage--; expandedRow = null; renderTable(); });
        pager.append(prevBtn);

        // Page buttons (max 5 shown)
        var startPage = Math.max(1, currentPage - 2);
        var endPage   = Math.min(totalPages, startPage + 4);
        for (var p = startPage; p <= endPage; p++) {
            (function(pg) {
                var btn = $('<button>' + pg + '</button>');
                if (pg === currentPage) btn.addClass('active');
                btn.on('click', function () { currentPage = pg; expandedRow = null; renderTable(); });
                pager.append(btn);
            })(p);
        }

        // Next
        var nextBtn = $('<button><i class="bi bi-chevron-right"></i></button>');
        if (currentPage === totalPages) nextBtn.prop('disabled', true);
        nextBtn.on('click', function () { currentPage++; expandedRow = null; renderTable(); });
        pager.append(nextBtn);
    }

    // ── Toast helper ─────────────────────────────────────────────────
    function showToast(msg, type) {
        var icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
        var toast = $('<div class="da-toast ' + type + '"><i class="bi ' + icon + '"></i>' + msg + '</div>');
        $('.toastBox').append(toast);
        setTimeout(function () {
            toast.fadeOut(400, function () { $(this).remove(); });
        }, 3000);
    }
    // ── Remove All Devices ────────────────────────────────────────────
    function RemoveAllDevices(UserID) {
        $.confirm({
            title: '<i class="bi bi-exclamation-triangle-fill text-danger"></i> Remove All Devices',
            content: 'Are you sure you want to remove <strong>all registered devices</strong> for this user? This action cannot be undone.',
            type: 'red',
            buttons: {
                confirm: {
                    text: 'Yes, Remove All',
                    btnClass: 'btn-danger',
                    action: function () {
                        $.ajax({
                            url: Aurl + "SystemApproval/save",
                            type: 'GET',
                            datatype: 'json',
                            data: { nMode: 7, nDeviceID: 0, nUserID: UserID },
                            success: function (data) {
                                showToast('All devices removed successfully!', 'error');
                                // Remove devices from local array
                                UserDeviceInfo = UserDeviceInfo.filter(function (d) {
                                    return String(d.UserID) !== String(UserID);
                                });
                                // Update DeviceCount in UserInfo
                                var u = UserInfo.find(function (x) { return String(x.UserID) === String(UserID); });
                                if (u) u.DeviceCount = 0;
                                var fu = filteredData.find(function (x) { return String(x.UserID) === String(UserID); });
                                if (fu) fu.DeviceCount = 0;
                                // Collapse row if open
                                if (String(expandedRow) === String(UserID)) {
                                    var openMaster = $('tr.master-row[data-userid="' + UserID + '"]');
                                    var openInner  = $('tr.sub-row[data-for="' + UserID + '"] .sub-row-inner');
                                    collapseRow(openMaster, openInner);
                                    expandedRow = null;
                                }
                                renderTable();
                            },
                            error: function () {
                                showToast('Failed to remove devices. Please try again.', 'error');
                            }
                        });
                    }
                },
                cancel: {
                    text: 'Cancel'
                }
            }
        });
    }
</script>