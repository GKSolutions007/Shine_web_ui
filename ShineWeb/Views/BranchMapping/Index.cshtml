    }

    .input-group-addon {
        padding: 4px 8px !important;
        font-size: 12px !important;
    }

    select.form-control {
        padding-right: 20px !important;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -60%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -23%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .branch-container {
        text-align: left; /* align container to the left */
    }

        .branch-container .form-label {
            display: inline-block; /* keep it inline, not centered */
            width: 220px; /* reduce width of dropdown */
            margin: 0; /* remove auto margin */
        }
</style>

