    function LoadData() {
        var roleID = $("#roleDropdown").val();

        if (roleID == "0") {
            Table.clear().draw();
            return;
        }
        Table.clear().draw();
        $.ajax({
            url: Aurl + "BranchMapping/get",
            type: 'GET',
            dataType: 'json',
            data: { RoleID: roleID },
            xhrFields: {
                withCredentials: true
            },
                success: function (data) {

                    $.each(data, function (i, items) {

                        var IsActive = items.Active == 1 ? "checked" : "";
                        var IsDefault = items.SetAsDefault == 1 ? "checked" : "";

                        Table.row.add([
                            items.RoleID,
                            items.BranchID,
                            (i + 1),
                            '<label style="font-weight: normal; cursor:pointer;">' + items.BranchName + '</label>',
                            '<label class="switch"><input type="checkbox" class="chkActive" ' + IsActive + '/><span class="slider round"></span></label>',
                            '<label class="switch"><input type="radio" name="SetDefault" class="chkDefault" ' + IsDefault + '/><span class="slider round"></span></label>',
                        ]).draw(false);

                    });
                }
        });
    }
    function GetRoles() {
        console.log("Calling GetRoles");
        $.ajax({
            url: Aurl + "maprole/getroles",
            type: 'GET',
            contentType: 'json',
            data: { RoleID: RID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                console.log("Roles received:", data);
                $("#roleDropdown").empty();
                $("#roleDropdown").append('<option value="0">--Select--</option>');

                // Add each role as an option
                $.each(data, function (i, role) {
                    $("#roleDropdown").append(
                        $('<option>', {
                            value: role.RoleID,
                            text: role.RoleName
                        })
                    );
                });

            },
            error: function (err) {
                console.log("Error:", err);
            }
        });
    }
    $("#roleDropdown").change(function () {

        var roleID = $(this).val();

        if (roleID == "0") {
            Table.clear().draw();
            return;
        }

        LoadData(roleID);
    });

    $('#tblMasterData tbody').on('click', '.chkdefault', function (r) {
