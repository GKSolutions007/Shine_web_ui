        height: 28px !important;
        line-height: 1.4 !important;
        margin-bottom: 1.2px !important;
    }

    textarea.form-control {
        height: auto !important;
        min-height: 60px !important;
    }

    .input-group-addon {
        padding: 4px 8px !important;
        font-size: 12px !important;
    }

    select.form-control {
        padding-right: 20px !important;
    }

    .page-header {
        display: flex;
        align-items: center;
       
        border-bottom: 2px solid var(--secondary-color);
       
    }

        .page-header h4 {
            font-weight: 600;
            color: #333;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .page-header i {
            margin-right: 10px;
            color: var(--primary-color);
            font-size: 1.5em;
        }

    /* Table Styles */
    .table-responsive {
        border-radius: 8px;
        overflow: hidden;
    }

    .table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

        .table thead th {
            /* background-color: var(--primary-color);*/
            /*        color: white;*/
            border: none;
            padding: 15px;
            font-weight: 500;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        .table tbody tr {
            transition: background-color 0.2s, transform 0.1s;
        }

            .table tbody tr:hover {
                background-color: #eef2f7;
                transform: scale(1.005);
                box-shadow: 0 2px 5px rgba(0,0,0,0.05);
                z-index: 10;
                position: relative;
            }

        .table td {
            vertical-align: middle !important;
            border-top: 1px solid #eee;
            padding: 5px;
            font-size: 12px !important; /* Slightly larger for readability */
            color: #555;
        }

    /* Custom Checkboxes / Switch */
    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 24px;
        margin-bottom: 0;
        vertical-align: middle;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
        }

    input:checked + .slider {
        background-color: var(--success-color);
    }

    input:focus + .slider {
        box-shadow: 0 0 1px var(--success-color);
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(26px);
        -ms-transform: translateX(26px);
        transform: translateX(26px);
    }

    /* Rounded sliders */
    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }

    /* Action Buttons */
    .action-bar {
        margin-top: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 15px;
    }

    .btn-custom {
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: 500;
        transition: all 0.3s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 14px rgba(0,0,0,0.15);
        }

    .btn-refresh {
        background-color: white;
        color: #555;
        border: 1px solid #ddd;
    }

        .btn-refresh:hover {
            background-color: #f8f9fa;
            color: #333;
        }

    .btn-save-custom {
        background: linear-gradient(135deg, var(--success-color), #20bf6b);
        color: white;
    }

        .btn-save-custom:hover {
            background: linear-gradient(135deg, #20bf6b, var(--success-color));
            color: white;
        }

    .btn-clear-custom {
        background: linear-gradient(135deg, var(--danger-color), #eb4d4b);
        color: white;
    }

        .btn-clear-custom:hover {
            background: linear-gradient(135deg, #eb4d4b, var(--danger-color));
            color: white;
        }

    /* Keyframes */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Input Tweaks */
    input[type=number] {
        text-align: right;
        border-radius: 4px;
        border: 1px solid #ddd;
        padding: 5px;
    }

    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    .page-header {
        padding-bottom: 2px !important;
        margin: 0px 0 20px !important;
        border-bottom: 1px solid #eee;
    }

    /* ============ COMPACT FORM CONTROLS ============ */
    .form-control,
