@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = "Column Configuration";
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
@* This page uses Bootstrap Icons (bi bi-*). If your layout does not already load them, add the line below. *@
@* <link href="~/Content/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" /> *@

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>

<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>

<style>
    /* =====================================================
       Column Configuration – page styles
       ===================================================== */
    .cc-page {
        --cc-ink: #1c2b36;
        --cc-muted: #667785;
        --cc-line: #e1e8ec;
        --cc-soft: #f1f6f6;
        --cc-accent: #0f766e;
        --cc-accent-dark: #0b5c56;
        --cc-accent-tint: #d9efec;
        padding: 12px 12px 6.5rem; /* bottom space so the sticky footer never covers content */
        color: var(--cc-ink);
    }

    /* ---------- Page heading ---------- */
    .cc-hero {
        display: flex;
        align-items: center;
        gap: .9rem;
        /*padding: .25rem 0 1rem;*/
    }

    .cc-hero-icon {
        flex: 0 0 auto;
        width: 25px;
        height: 25px;
        border-radius: 14px;
        background: var(--cc-accent);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 1.35rem;
        box-shadow: 0 8px 18px rgba(15, 118, 110, .28);
    }

    .cc-hero h4 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 700;
    }

    .cc-hero p {
        margin: .1rem 0 0;
        font-size: .8rem;
        color: var(--cc-muted);
    }

    /* ---------- Cards ---------- */
    .cc-card {
        background: #fff;
        border: 1px solid var(--cc-line);
        border-radius: 1rem;
        box-shadow: 0 6px 22px rgba(28, 43, 54, .06);
        padding: 1.25rem;
        transition: box-shadow .3s ease;
    }

        .cc-card:hover {
            box-shadow: 0 10px 30px rgba(28, 43, 54, .10);
        }

    /* Page-load entrance (single orchestrated moment) */
    .animate-up {
        animation: ccFadeUp .5s cubic-bezier(.2, .8, .2, 1) both;
    }

    @@keyframes ccFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    /* ---------- Filter fields ---------- */
    .cc-field .input-group-text {
        background: var(--cc-soft);
        color: var(--cc-accent);
        border-color: #ced8dd;
        border-right: 0;
        font-size: 1.3rem;
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .cc-field .form-select {
        border-color: #ced8dd;
        font-size: 1.1rem !important;
        font-weight: 500;
        height: calc(3.9rem + 2px);
        min-height: 0;
        padding-top: 1.8rem;
        padding-bottom: .5rem;
        transition: border-color .2s, box-shadow .2s;
    }

        .cc-field .form-select option {
            font-size: 1rem;
        }

        .cc-field .form-select:focus {
            border-color: var(--cc-accent);
            box-shadow: 0 0 0 .2rem rgba(15, 118, 110, .15);
        }

    .cc-field .form-floating > label {
        font-size: 1.1rem !important;
        font-weight: 600;
        color: var(--cc-muted);
        padding-top: 1.1rem;
    }

    .cc-field:focus-within .input-group-text {
        border-color: var(--cc-accent);
    }

    /* ---------- Buttons ---------- */
    .cc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        border: 1px solid transparent;
        border-radius: .75rem;
        padding: .75rem 1.3rem;
        font-size: .85rem;
        font-weight: 600;
        line-height: 1.2;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

        .cc-btn i {
            font-size: 1rem;
            transition: transform .35s ease;
        }

        .cc-btn:hover:not(:disabled) {
            transform: translateY(-2px);
        }

        .cc-btn:active:not(:disabled) {
            transform: translateY(0);
        }

        .cc-btn:disabled {
            opacity: .75;
            cursor: progress;
        }

        .cc-btn:focus-visible {
            outline: 3px solid rgba(15, 118, 110, .35);
            outline-offset: 2px;
        }

    .cc-btn-primary {
        background: var(--cc-accent);
        color: #fff;
        box-shadow: 0 6px 16px rgba(15, 118, 110, .28);
    }

        .cc-btn-primary:hover:not(:disabled) {
            background: var(--cc-accent-dark);
            color: #fff;
            box-shadow: 0 10px 22px rgba(15, 118, 110, .34);
        }

    .cc-btn-ghost {
        background: #fff;
        color: var(--cc-ink);
        border-color: #ced8dd;
    }

        .cc-btn-ghost:hover:not(:disabled) {
            background: var(--cc-soft);
        }

            .cc-btn-ghost:hover:not(:disabled) i {
                transform: rotate(-180deg);
            }

    .cc-btn-primary:hover:not(:disabled) .bi-cloud-arrow-down {
        transform: translateY(2px);
    }

    /* ---------- Table section ---------- */
    .cc-table-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: .5rem .75rem;
        margin-bottom: .75rem;
    }

        .cc-table-head h5 {
            margin: 0;
            font-size: .95rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

            .cc-table-head h5 i {
                color: var(--cc-accent);
            }

    .cc-count {
        background: var(--cc-accent-tint);
        color: var(--cc-accent-dark);
        font-size: .72rem;
        font-weight: 600;
        border-radius: 999px;
        padding: .2rem .65rem;
    }

    .cc-hint {
        display: flex;
        align-items: flex-start;
        gap: .5rem;
        font-size: .76rem;
        color: var(--cc-muted);
        background: var(--cc-soft);
        border-radius: .6rem;
        padding: .5rem .75rem;
        margin-bottom: .85rem;
    }

        .cc-hint i {
            color: var(--cc-accent);
            margin-top: 1px;
        }

    .cc-table-wrap {
        max-height: calc(100vh - 275px);
        min-height: 240px;
        overflow: auto;
        border: 1px solid var(--cc-line);
        border-radius: .75rem;
        -webkit-overflow-scrolling: touch;
    }

    #ccTable {
        width: 100%;
        min-width: 1500px;
        margin: 0 !important;
        border-collapse: separate !important;
        border-spacing: 0;
        font-size: 12px;
    }

        #ccTable > thead > tr > th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #eaf3f2;
            color: #0b4f4a;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
            padding: .8rem .65rem;
            border-bottom: 2px solid #b9dcd8;
            text-align: center;
        }

            #ccTable > thead > tr > th .dt-column-header {
                justify-content: center;
                gap: .35rem;
            }

            #ccTable > thead > tr > th .dt-column-order {
                display: none;
            }

        #ccTable > tbody > tr > td {
            padding: .55rem .65rem;
            border-bottom: 1px solid #edf1f3;
            vertical-align: middle;
            background: #fff;
            font-size: 12px;
            transition: background-color .2s ease;
        }

        #ccTable > tbody > tr:hover > td {
            background: #f5faf9;
        }

        #ccTable > tbody > tr:last-child > td {
            border-bottom: 0;
        }


        /* Permission column (last) stays pinned to the right while scrolling sideways */
        #ccTable > thead > tr > th:last-child,
        #ccTable > tbody > tr > td:last-child:not(.dt-empty) {
            position: sticky;
            right: 0;
            box-shadow: -8px 0 10px -8px rgba(28, 43, 54, .25);
        }

        #ccTable > thead > tr > th:last-child {
            z-index: 4;
        }

        #ccTable > tbody > tr > td:last-child:not(.dt-empty) {
            z-index: 1;
        }

    /* Row entrance (staggered from JS) */
    .cc-row-in {
        animation: ccRowIn .4s ease backwards;
    }

    @@keyframes ccRowIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    /* Inputs inside the table */
    .cc-input.form-control,
    .cc-input.form-select {
        font-size: 12px !important;
        min-width: 90px;
        border-color: #ced8dd;
        border-radius: .55rem;
        transition: border-color .2s, box-shadow .2s;
    }

        .cc-input.form-control:focus,
        .cc-input.form-select:focus {
            border-color: var(--cc-accent);
            box-shadow: 0 0 0 .18rem rgba(15, 118, 110, .15);
        }

    .cc-name-input.form-control {
        min-width: 180px;
    }

    .cc-orig-name {
        display: flex;
        align-items: center;
        gap: .35rem;
        font-size: 11px;
        font-weight: 600;
        color: var(--cc-muted);
        margin: 0 0 .3rem .15rem;
    }

    input[type=number].cc-input {
        text-align: right;
        -moz-appearance: textfield;
    }

        input[type=number].cc-input::placeholder {
            text-align: left;
        }

        input[type=number].cc-input::-webkit-outer-spin-button,
        input[type=number].cc-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    /* ---------- Switch (replaces checkbox) ---------- */
    .form-switch.cc-switch {
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0;
        padding: 0;
        min-height: 0;
    }

        .form-switch.cc-switch .form-check-input {
            width: 2.6em;
            height: 1.35em;
            margin: 0;
            float: none;
            cursor: pointer;
            border-color: #b8c5cc;
            background-color: #dbe3e8;
            transition: background-color .25s ease, border-color .25s ease, background-position .25s ease, box-shadow .2s ease;
        }

            .form-switch.cc-switch .form-check-input:checked {
                background-color: var(--cc-accent);
                border-color: var(--cc-accent);
            }

            .form-switch.cc-switch .form-check-input:focus {
                border-color: var(--cc-accent);
                box-shadow: 0 0 0 .2rem rgba(15, 118, 110, .2);
            }

            .form-switch.cc-switch .form-check-input:disabled {
                cursor: not-allowed;
                opacity: .4;
            }

    /* ---------- Sticky footer ---------- */
    .cc-footer {
        position: fixed;
        
        right: 0;
        bottom: 0;
        z-index: 1030;
        width:75%;
        background: rgba(255, 255, 255, .96);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--cc-line);
        box-shadow: 0 -8px 24px rgba(28, 43, 54, .10);
        padding: .75rem 1rem calc(.75rem + env(safe-area-inset-bottom));
        transform: translateY(110%);
        opacity: 0;
        visibility: hidden;
        transition: transform .4s cubic-bezier(.2, .8, .2, 1), opacity .3s ease, visibility 0s linear .4s;
    }

        .cc-footer.show {
            transform: none;
            opacity: 1;
            visibility: visible;
            transition-delay: 0s;
        }

    .cc-footer-inner {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .cc-footer-info {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .8rem;
        color: var(--cc-muted);
    }

        .cc-footer-info i {
            color: var(--cc-accent);
            font-size: 1rem;
        }

    /* ---------- Mobile: each column becomes a card ---------- */
    @@media (max-width: 767.98px) {
        .cc-page {
            padding: 8px 8px 6rem;
        }

        .cc-card {
            padding: 1rem;
        }

        .cc-table-wrap {
            max-height: none;
            min-height: 0;
            overflow: visible;
            border: 0;
        }

        #ccTable {
            min-width: 0 !important;
            width: 100% !important;
        }

            #ccTable thead {
                display: none;
            }

            #ccTable,
            #ccTable tbody,
            #ccTable tbody tr,
            #ccTable tbody td {
                display: block;
                width: 100% !important;
            }

                #ccTable tbody tr {
                    background: #fff;
                    border: 1px solid var(--cc-line);
                    border-radius: .9rem;
                    margin-bottom: .85rem;
                    padding: .5rem .85rem .65rem;
                    box-shadow: 0 4px 14px rgba(28, 43, 54, .06);
                }

                #ccTable tbody td {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: .75rem;
                    border: 0 !important;
                    padding: .4rem 0 !important;
                    text-align: left !important;
                    background: transparent !important;
                }

                    #ccTable tbody td::before {
                        content: attr(data-label);
                        flex: 0 0 40%;
                        font-size: 12px;
                        font-weight: 600;
                        color: var(--cc-muted);
                    }

                    #ccTable tbody td.cc-cell-name {
                        display: block;
                        border-bottom: 1px dashed var(--cc-line) !important;
                        padding-bottom: .65rem !important;
                        margin-bottom: .25rem;
                    }

                        #ccTable tbody td.cc-cell-name::before,
                        #ccTable tbody td.dt-empty::before {
                            content: none;
                        }

                    #ccTable tbody td > .cc-input {
                        flex: 1 1 0;
                        min-width: 0;
                    }

                    #ccTable tbody td > .cc-switch {
                        flex: 0 0 auto;
                        margin-left: auto;
                    }

                #ccTable > tbody > tr > td:last-child:not(.dt-empty) {
                    position: static;
                    box-shadow: none;
                }

        .cc-hero-icon {
            width: 40px;
            height: 40px;
            font-size: 1.15rem;
        }

        .cc-footer-inner {
            justify-content: center;
        }

        .cc-footer-info {
            display: none;
        }

        #ccBtnAccept {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .animate-up, .cc-row-in {
            animation: none !important;
        }

        .cc-btn, .cc-footer, .form-switch.cc-switch .form-check-input {
            transition: none !important;
        }
    }
</style>

<div class="cc-page">

    

    <div class="toastBox"></div>

    <!-- ================= Filters ================= -->
    <div id="dvMainTable" class="animate-up">
        <div class="cc-card">
            <div class="cc-hero">
                <div class="cc-hero-icon"><i class="bi bi-sliders2"></i></div>
                <div>
                    <h4 id="MainHeading">Column Configuration</h4>
                </div>
            </div>
            <hr />
            <div class="row g-3 align-items-start">

                <div class="col-12 col-md-4 col-lg-3">
                    <div class="input-group cc-field">
                        <span class="input-group-text"><i class="bi bi-ui-checks-grid"></i></span>
                        <div class="form-floating">
                            <select class="form-select FormclrcmbField" id="cmbType">
                                <option value="0"></option>
                            </select>
                            <label for="cmbType">Type</label>
                        </div>
                    </div>
                    <div class="text-danger small px-2 clrdiv" id="divErrTransaction"></div>
                </div>

                <div class="col-12 col-md-4 col-lg-3">
                    <div class="input-group cc-field">
                        <span class="input-group-text"><i class="bi bi-file-earmark-text"></i></span>
                        <div class="form-floating">
                            <select class="form-select FormclrcmbField" id="cmbForm">
                                <option value="0"></option>
                            </select>
                            <label for="cmbForm">Form</label>
                        </div>
                    </div>
                    <div class="text-danger small px-2 clrdiv" id="divErrForm"></div>
                </div>

                <div class="col-12 col-md-4 col-lg-3">
                    <div class="input-group cc-field">
                        <span class="input-group-text"><i class="bi bi-table"></i></span>
                        <div class="form-floating">
                            <select class="form-select FormclrcmbField" id="cmbTable">
                                <option value="0"></option>
                            </select>
                            <label for="cmbTable">Table</label>
                        </div>
                    </div>
                    <div class="text-danger small px-2 clrdiv" id="divErrTable"></div>
                </div>

                <div class="col-12 col-lg-3 d-flex gap-2">
