                            <th>Permission</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="d-flex mt-2 justify-content-end">
                <button type="button" class="btn btn-save-style" id="ccBtnAccept">
                    <i class="bi bi-check2-circle"></i>
                    <span class="spinner-border spinner-border-sm cc-spin d-none" aria-hidden="true"></span>
                    <span>Accept</span>
                </button>
            </div>
            
        </div>
    </div>

</div>

<!-- ================= Sticky footer (Accept) ================= -->
<div id="ccFooter" class="cc-footer d-none" aria-hidden="true">
    <div class="cc-footer-inner">
        <div class="cc-footer-info">
           
        </div>
