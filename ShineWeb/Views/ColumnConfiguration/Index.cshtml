<script>
    var TableGenColumnSettings = null;

    /* ---------------------------------------------------
       Small helpers
       --------------------------------------------------- */
    // Escape a value so it is safe inside value="..." and text
    function esc(v) {
        return $('<div/>').text(v == null ? '' : v).html().replace(/"/g, '&quot;');
    }

    // Bootstrap switch markup (still a checkbox, so name/id based code keeps working)
    function ccSwitch(name, id, checked, disabled, extraClass) {
        return '<div class="form-check form-switch cc-switch">' +
            '<input class="form-check-input ' + (extraClass || '') + '" type="checkbox" role="switch"' +
            ' name="' + name + '" id="' + id + '"' +
            (checked ? ' checked' : '') + (disabled ? ' disabled' : '') + '/></div>';
    }

    // Spinner + disabled state for buttons while a request is running
    function setBusy($btn, busy) {
        $btn.prop('disabled', busy);
        $btn.find('.cc-spin').toggleClass('d-none', !busy);
        $btn.find('i').first().toggleClass('d-none', busy);
    }

    function showAcceptFooter(count) {
        $('#ccFooterText').text(count + ' column' + (count === 1 ? '' : 's') + ' loaded. Review the settings, then accept to save them.');
        $('#ccFooter').addClass('show').attr('aria-hidden', 'false');
    }

    function hideAcceptFooter() {
        $('#ccFooter').removeClass('show').attr('aria-hidden', 'true');
    }

    /* --------------------------------------------------- */

    function OpenColumnSettings() {
        var nType = parseInt($('#cmbType').val()) || 0;
        var nFormID = parseInt($('#cmbForm').val()) || 0;
        var nTableID = parseInt($("#cmbTable").val()) || 0;
        GetColumnConfigurationData(4, nType, nFormID, nTableID);
    }

    function GetColumnConfigurationData(nMode, strFormOrReport = null, strFormID = null, strTableID = null) {
        $.ajax({
            url: Aurl + "columnconfig/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, FormOrReport: strFormOrReport, FormID: strFormID, TableID: strTableID },
            xhrFields: {
                withCredentials: true
            },
            beforeSend: function () {
                if (nMode == 4) setBusy($('#btnLoad'), true);
            },
            complete: function () {
                if (nMode == 4) setBusy($('#btnLoad'), false);
            },
            success: function (data) {
                var jsData = JSON.parse(data);
                if (nMode == 1) {
                    // Type dropdown
                    $('#cmbType').find("option").remove();
                    $.each(jsData, function (i, items) {
                        $('#cmbType').append($('<option/>', {
                            value: items.FormOrReport,
                            text: items.FormOrReportName
                        }));
                    });
                    $('#cmbType').trigger('change');
                }
                else if (nMode == 2) {
                    // Form dropdown
                    $('#cmbForm').find("option").remove();
                    $.each(jsData, function (i, items) {
                        $('#cmbForm').append($('<option/>', {
                            value: items.FormID,
                            text: items.FormName,
                        }));
                    });
                    $('#cmbForm').trigger('change');
                }
                else if (nMode == 3) {
                    // Table dropdown
                    $('#cmbTable').find("option").remove();
                    $.each(jsData, function (i, items) {
                        $('#cmbTable').append($('<option/>', {
                            value: items.TableID,
                            text: "Table " + items.TableID,
                        }));
                    });
                }
                else if (nMode == 4) {
                    $('#ccTable').DataTable({
                        paging: false,
                        destroy: true,
                        data: jsData,
                        searching: false,
                        ordering: false,
                        info: false,
                        // Row entrance animation + labels used by the mobile card layout
                        drawCallback: function () {
                            var labels = $('#ccTable thead th').map(function () {
                                return $.trim($(this).text());
                            }).get();
                            $('#ccTable tbody tr').each(function (i) {
                                $(this).css('animation-delay', Math.min(i * 20, 500) + 'ms').addClass('cc-row-in');
                                $(this).children('td').each(function (j) {
                                    if (!$(this).hasClass('dt-empty')) {
                                        $(this).attr('data-label', labels[j] || '');
                                    }
                                });
                            });
                        },
                        columns: [

                            //ReportID	TableID	ColumnID	ColumnName	DisplayColumnName	Width	Visible	Alignment	DisplayIndex	IsHiddenColumn
                            { "data": "FormID", "visible": false, className: "dt-body-left" },//0
                            { "data": "TableID", "visible": false, className: "dt-body-left" },//1
                            { "data": "ColumnID", "visible": false, className: "dt-body-left" },//2
                            { "data": "FormorReport", "visible": false, className: "dt-body-left" },//3
                            { "data": "ColumnName", "visible": false, className: "dt-body-left" },//4
                            { "data": "OriginalColumnName", "visible": false, className: "dt-body-left" },//5

                            // Display name (with original name above it)
                            {
                                className: "dt-body-left cc-cell-name",
                                "render": function (data, type, row, meta) {
                                    var rowIndex = meta.row;
                                    return '<div>' +
                                        '<small class="cc-orig-name">' + esc(row.OriginalColumnName) + '</small>' +
                                        '<input type="text" value="' + esc(row.DisplayColumnName) + '" name="DisplayColumnName" class="form-control form-control-sm cc-input cc-name-input" id="txtDisplayColumnName' + rowIndex + '"/>' +
                                        '</div>';
                                }
                            },
                            // Width
                            {
                                className: "dt-body-left",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = meta.row;
                                    return '<input type="number" value="' + value.Width + '" name="Width" class="form-control form-control-sm cc-input" id="txtWidth' + rowIndex + '" min="1" oninput="javascript: if (this.value < this.min) { this.value = 0 }"/>';
                                }
                            },
                            // Visible
                            {
                                className: "dt-body-center",
                                "mRender": function (data, type, value, meta) {
                                    return ccSwitch('Visible', 'cmbVisible' + meta.row, value.Visible == '1');
                                }
                            },
                            // Alignment
                            {
                                className: "dt-body-left",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = meta.row;
                                    var isLeftSelect = value.Alignment == '1' ? 'selected' : '';
                                    var isRightSelect = value.Alignment == '2' ? 'selected' : '';
                                    var isCenterSelect = value.Alignment == '3' ? 'selected' : '';
                                    return "<select name='Alignment' class='form-select form-select-sm cc-input' id='cmbAlignment" + rowIndex + "'><option value='1' " + isLeftSelect + ">Left</option><option value='3' " + isCenterSelect + ">Center</option><option value='2' " + isRightSelect + ">Right</option></select>";
                                }
                            },
                            // Display index
                            {
                                className: "dt-body-left",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = meta.row;
                                    return '<input type="number" value="' + value.DisplayIndex + '" name="DisplayIndex" class="form-control form-control-sm cc-input" id="txtDisplayIndex' + rowIndex + '" min="0" oninput="javascript: if (this.value < this.min) { this.value = 0 }"/>';
                                }
                            },
                            // Total
                            // NOTE: the original code treats Total == '0' as "checked" (the Save step sends checked = "1").
                            // That mapping is kept exactly as it was.
                            {
                                className: "dt-body-center",
                                "mRender": function (data, type, value, meta) {
                                    return ccSwitch('Total', 'cmbTotal' + meta.row, value.Total == '0');
                                }
                            },
                            // Sum  – disabled and unchecked while Total is off
                            {
                                className: "dt-body-center",
                                "mRender": function (data, type, value, meta) {
                                    var totalOn = value.Total == '0';
                                    return ccSwitch('EnableSum', 'EnableSum' + meta.row, totalOn && value.EnableSum == '1', !totalOn);
                                }
                            },
                            // Average – disabled and unchecked while Total is off
                            {
                                className: "dt-body-center",
                                "mRender": function (data, type, value, meta) {
                                    var totalOn = value.Total == '0';
                                    return ccSwitch('EnableAvg', 'EnableAvg' + meta.row, totalOn && value.EnableAvg == '1', !totalOn);
                                }
                            },
                            // Count
                            {
                                className: "dt-body-center",
                                "mRender": function (data, type, value, meta) {
                                    return ccSwitch('EnableCount', 'EnableCount' + meta.row, value.EnableCount == '1');
                                }
                            },
                            // Unique
                            {
                                className: "dt-body-center",
                                "mRender": function (data, type, value, meta) {
                                    return ccSwitch('EnableUnique', 'EnableUnique' + meta.row, value.EnableUnique == '1');
                                }
                            },
                            // Column menu (hidden, still saved)
                            {
                                className: "dt-body-center", "visible": false,
                                "mRender": function (data, type, value, meta) {
                                    return ccSwitch('EnableColumnMenu', 'EnableColumnMenu' + meta.row, value.EnableColumnMenu == '1');
                                }
                            },
                            // Show in column option
                            {
                                className: "dt-body-center", "visible": (RID == 1),
                                "mRender": function (data, type, value, meta) {
                                    return ccSwitch('ShowinColumnOption', 'ShowinColumnOption' + meta.row, value.ShowinColumnOption == '1');
                                }
                            },
                            // Print
                            {
                                className: "dt-body-center",
                                "mRender": function (data, type, value, meta) {
                                    return ccSwitch('PrintYN', 'cmbPrintYN' + meta.row, value.PrintYN == '1', false, 'dgvPrintYN');
                                }
                            },
                            // Print name
                            {
                                className: "dt-body-left",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = meta.row;
                                    return '<input type="text" value="' + esc(value.PrintColumnName) + '" name="PrintColumnName" class="form-control form-control-sm cc-input" id="txtPrintColumnName' + rowIndex + '"/>';
                                }
                            },
                            // Print width
                            {
                                className: "dt-body-left",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = meta.row;
                                    return '<input type="number" value="' + value.PrintWidth + '" name="Printwidth" class="form-control form-control-sm cc-input dgvPrintWidth" id="txtPrintwidth' + rowIndex + '" min="1" oninput="javascript: if (this.value < this.min) { this.value = 0 }"/>';
                                }
                            },
                            // Column type
                            {
                                className: "dt-body-left",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = meta.row;
                                    var isStringSelect = value.ColumnType == '1' ? 'selected' : '';
                                    var isNumberSelect = value.ColumnType == '2' ? 'selected' : '';
                                    var isDeciamlSelect = value.ColumnType == '3' ? 'selected' : '';
                                    var isDateSelect = value.ColumnType == '4' ? 'selected' : '';
                                    return "<select name='ColumnType' class='form-select form-select-sm cc-input' id='cmbColumnType" + rowIndex + "'><option value='1' " + isStringSelect + ">String</option><option value='2' " + isNumberSelect + ">Number</option><option value='3' " + isDeciamlSelect + ">Decimal</option><option value='4' " + isDateSelect + ">Date</option></select>";
                                }
                            },
                            // Permission
                            {
                                className: "dt-body-center",
                                "mRender": function (data, type, value, meta) {
                                    return ccSwitch('Permission', 'cmbPermission' + meta.row, value.Permission == '1');
                                }
                            },
                        ],
                    });
                    TableGenColumnSettings = $('#ccTable').DataTable();

                    // Show the table card with a fresh entrance animation
                    var $container = $('#dvColumnTable');
                    $container.hide().removeClass('animate-up');
                    void $container[0].offsetWidth;
                    $container.addClass('animate-up').show();

                    $('#ccRowCount').text(jsData.length + (jsData.length === 1 ? ' column' : ' columns'));

                    // Sticky footer with the Accept button appears once Load has returned columns
                    if (jsData.length > 0) {
                        showAcceptFooter(jsData.length);
                    } else {
                        hideAcceptFooter();
                    }
                }
            },
            error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                }
            }
        });
    }

    $(document).ready(function () {
        GetColumnConfigurationData(1);

        $("#cmbType").on("change", function () {
            var v = $(this).val();
            GetColumnConfigurationData(2, v);
        });

        $("#cmbForm").on("change", function () {
            var type = $("#cmbType").val();
            var formId = $(this).val();
            GetColumnConfigurationData(3, type, formId);
        });

        // Reset: clear selections, hide the table and hide the sticky Accept footer
        $("#btnClear").on("click", function () {
            $("#cmbType").prop("selectedIndex", 0).trigger("change");
            $('#dvColumnTable').hide();
            hideAcceptFooter();
        });
    });

    ///////////////////////////////////////////////////
    // Total switch validations

    // Total ON  -> Sum & Average enabled
    // Total OFF -> Sum & Average unchecked and disabled
    function syncTotalDependents(rowIndex) {
        var totalOn = $("#cmbTotal" + rowIndex).prop("checked");
        var $dependents = $("#EnableSum" + rowIndex + ", #EnableAvg" + rowIndex);
        if (totalOn) {
            $dependents.prop("disabled", false);
        } else {
            $dependents.prop("checked", false).prop("disabled", true);
        }
    }

    function validateSelections(rowIndex, event) {
        const sumBox = $("#EnableSum" + rowIndex);
        const avgBox = $("#EnableAvg" + rowIndex);
        const countBox = $("#EnableCount" + rowIndex);
        const uniqueBox = $("#EnableUnique" + rowIndex);

        const clickedName = $(event.target).attr("name");

        // Total toggled -> enable / disable (and uncheck) Sum & Average
        if (clickedName === "Total") {
            syncTotalDependents(rowIndex);
        }

        // Only 2 selections allowed among Sum/Avg/Count/Unique
        let selected = [sumBox, avgBox, countBox, uniqueBox].filter(function (b) { return b.prop("checked"); }).length;
        if (selected > 2) {
            $(event.target).prop("checked", false); // undo last action
            showErrorSnackbar("Only 2 selections allowed among Sum, Avg, Count, Unique.");
        }
    }

    function ReportColumnValidation() {
        var isValid = true;

        var totwidth = $("#lblPrintWidth").text();
        if (totwidth > 210) {
            isValid = false;
            showErrorSnackbar('Total Print Width (Print - Yes) cannot exceed 210');
        }
        if (isValid) {
            $("#ccTable tbody tr").each(function () {
                var rowdata = TableGenColumnSettings.row($(this)).data();
                var aPrintYN = false;
                $(this).find("input").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "PrintYN") {
                        aPrintYN = this.checked;
                    }
                    if (fieldName == "Printwidth" && aPrintYN) {
                        var PrintWidth = parseInt($(this).val());
                        if (PrintWidth < 5) {
                            isValid = false;
                        }
                    }
                });
            });
            if (!isValid) {
                showErrorSnackbar('Set Print Width greater 5');
            }
        }
        return isValid;
    }

    var ColumnSettingData = [];
    $("#ccBtnAccept").click(function () {
        var $acceptBtn = $(this);
        var totwidth = $("#lblPrintWidth").text();
        if (ReportColumnValidation()) {
            ColumnSettingData = [];
            $("#ccTable tbody tr").each(function () {
                var allValues = {};
                var rowdata = TableGenColumnSettings.row($(this)).data();
                //Printwidth,PrintColumnName,PrintYN
                var aDisplayName = "", aWidth = "", aDisplayIndex = "", aAlign = "", aVisible = "",
                    aPrintwidth = "0", aPrintColumnName = "", aPrintYN = false,
                    aEnableColumnMenu = rowdata.EnableColumnMenu, aTotal = rowdata.Total,
                    aEnableSum = rowdata.EnableSum, aEnableAvg = rowdata.EnableAvg, aEnableCount = rowdata.EnableCount,
                    aEnableUnique = rowdata.EnableUnique, aShowinColumnOption = rowdata.ShowinColumnOption, aColumnType = rowdata.ColumnType, aPermission = rowdata.Permission;
                $(this).find("input").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "DisplayColumnName") {
                        aDisplayName = $(this).val();
                    }
                    if (fieldName == "Width") {
                        aWidth = $(this).val();
                    }
                    if (fieldName == "DisplayIndex") {
                        aDisplayIndex = $(this).val();
                    }
                    if (fieldName == "Printwidth") {
                        aPrintwidth = $(this).val();
                    }
                    if (fieldName == "PrintColumnName") {
                        aPrintColumnName = $(this).val();
                    }

                    if (fieldName == "Visible") {
                        aVisible = this.checked ? "1" : "0";
                    }
                    if (fieldName == "Total") {
                        aTotal = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableColumnMenu") {
                        aEnableColumnMenu = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableSum") {
                        aEnableSum = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableAvg") {
                        aEnableAvg = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableCount") {
                        aEnableCount = this.checked ? "1" : "0";
                    }
                    if (fieldName == "EnableUnique") {
                        aEnableUnique = this.checked ? "1" : "0";
                    }

                    if (fieldName == "ShowinColumnOption") {
                        aShowinColumnOption = this.checked ? "1" : "0";
                    }
                    if (fieldName == "PrintYN") {
                        aPrintYN = this.checked;
                    }
                    if (fieldName == "Permission") {
                        aPermission = this.checked ? "1" : "0";
                    }

                });
                $(this).find("select").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "Alignment") {
                        aAlign = $(this).val();
                    }
                    if (fieldName == "ColumnType") {
                        aColumnType = $(this).val();
                    }
                });

                var coldata = {
                    "FormID": rowdata.FormID,
                    "TableID": rowdata.TableID,
                    "ColumnID": rowdata.ColumnID,
                    "FormorReport": rowdata.FormorReport,
                    "ColumnName": rowdata.ColumnName,
                    "DisplayColumnName": aDisplayName,
                    "Width": aWidth,
                    "Visible": aVisible,
                    "Alignment": aAlign,
                    "TotalYN": aTotal,
                    "DisplayIndex": aDisplayIndex,
                    "EnableColumnMenu": aEnableColumnMenu,
                    "EnableAvg": aEnableAvg,
                    "EnableSum": aEnableSum,
                    "ShowinColumnOption": aShowinColumnOption,
                    "PrintYN": aPrintYN,
                    "PrintColumnName": aPrintColumnName,
                    "Printwidth": aPrintwidth,
                    "EnableCount": aEnableCount,
                    "EnableUnique": aEnableUnique,
                    "ColumnType": aColumnType,
                    "Permission": aPermission
                };
                ColumnSettingData.push(coldata);
            });

            setBusy($acceptBtn, true);
            $.ajax({
                url: Aurl + "columnconfig/saveColumnConfiguration",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(ColumnSettingData),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    if (!data || !data.length) {
                        showErrorSnackbar('Save failed');
                        return;
                    }
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            OpenColumnSettings();
                        } else {
                            showErrorSnackbar(items.Message);
                        }
                    });
                },
                error: function (data) {
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        ////showErrorSnackbar(msg + " Logout and Login again.");
                    }
                },
                complete: function () {
                    setBusy($acceptBtn, false);
                }
            });
        }
    });

    // Attach listeners
    $(document).on(
        "change",
        "input[name='Total'], input[name='EnableSum'], input[name='EnableAvg'], input[name='EnableCount'], input[name='EnableUnique']",
        function (event) {
            var rowIndex = $(this).attr("id").match(/\d+/)[0];
            validateSelections(rowIndex, event);
        }
    );
</script>
