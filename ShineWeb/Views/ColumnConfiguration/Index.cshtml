            </div>
        </div>
    </div>

    <!-- ================= Columns table ================= -->
    <div id="dvColumnTable" class="animate-up mt-3" style="display:none;">
        <div class="cc-card">
            <div class="cc-table-head">
                <h5><i class="bi bi-layout-three-columns"></i> Columns <span class="cc-count" id="ccRowCount">0 columns</span></h5>
            </div>
            <div class="cc-table-wrap">
                <table class="table align-middle" id="ccTable">
                    <thead>
                        <tr>
                            <th>ReportID</th>
                            <th>TableID</th>
                            <th>ColumnID</th>
                            <th>FormorReport</th>
                            <th>Column Name</th>
                            <th>Original Name</th>
                            <th>Display name</th>
                            <th>Width</th>
                            <th>Visible</th>
                            <th>Alignment</th>
                            <th>Display index</th>
                            <th>Total</th>
                            <th>Sum</th>
                            <th>Average</th>
                            <th>Count</th>
                            <th>Unique</th>
                            <th>Column menu</th>
                            <th>Show column option</th>
                            <th>Print</th>
                            <th>Print name</th>
                            <th>Print width</th>
