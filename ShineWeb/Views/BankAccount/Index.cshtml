@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    if (ViewData["TransType"].ToString() == "2")
    {
        Layout = "~/Views/Shared/_LayoutWithoutheader.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutBT5.cshtml";
    }
}

<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
@* Phase 1/2: removed duplicate legacy jQuery 1.10.2 (layout already provides 3.6.4). *@
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>

<style>
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 35%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -52%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    /* ===== Master redesign (grid + modal chrome; header already modern) ===== */
    :root {
        --sm-accent: var(--header-bg, #2563eb);
        --sm-radius: 14px;
        --sm-card-shadow: 0 4px 10px rgba(30,41,59,0.10);
    }

    #dvMainTable {
        background: #ffffff;
        border-radius: var(--sm-radius);
        box-shadow: var(--sm-card-shadow);
        padding: 8px;
    }

    #myModalfg .modal-content {
        border: none;
        border-radius: var(--sm-radius);
        overflow: hidden;
        box-shadow: 0 18px 44px rgba(15,23,42,0.28);
    }

    #myModalfg .modal-header {
        background: var(--sm-accent);
        color: #ffffff;
        border-bottom: none;
    }

        #myModalfg .modal-header .modal-title {
            color: #ffffff;
            font-weight: 700;
        }

        #myModalfg .modal-header .btn-close {
            filter: invert(1);
            opacity: 0.85;
        }

    #myModalfg .modal-footer {
        background: #f8fafc;
        border-top: 1px solid #eef2f7;
        padding: 12px 18px;
    }

    #myModalfg .modal-footer .btn {
        border-radius: 9px;
        font-weight: 600;
        padding: 7px 18px;
        border: none;
        transition: transform .12s ease, box-shadow .12s ease;
    }

        #myModalfg .modal-footer .btn:active {
            transform: scale(0.97);
        }

    .btn-clear-style {
        background: #e2e8f0;
        color: #475569;
    }

        .btn-clear-style:hover {
            background: #cbd5e1;
            color: #334155;
        }

    .btn-save-style {
        background: #16a34a;
        color: #ffffff;
    }

        .btn-save-style:hover {
            background: #15803d;
            color: #fff;
            box-shadow: 0 4px 12px rgba(22,163,74,0.30);
        }

    .btn-close-style {
        background: #64748b;
        color: #ffffff;
    }

        .btn-close-style:hover {
            background: #475569;
            color: #fff;
        }

    .form-switch .form-check-input {
        width: 3em;
        height: 1.5em;
        margin-top: 0.1em;
        cursor: pointer;
    }

    .form-switch .form-check-label {
        font-size: 1rem;
        margin-left: 1.5rem;
        cursor: pointer;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })

    @* Phase 2/3: modernised page header using the app-theme toolbar pattern.
        #MainHeading id preserved — JS reads its text for modal titles. *@
    @*<div class="app-toolbar app-fade-in">
            <div>
                <h2 id="MainHeading">@ViewData["FormName"]</h2>
                <div class="app-toolbar-crumb">Masters &rsaquo; @ViewData["FormName"]</div>
            </div>
        </div>*@
    <div class="sm-inline-bar">
        <div class="sm-header-card sm-header-inline">
            <div class="sm-header-icon"><i class="fas fa-bank"></i></div>
            <div class="sm-header-text">
                <div class="sm-header-sub">Master</div>
                <h4 id="FormHead">@ViewData["FormName"]</h4>
            </div>
        </div>
    </div>
    <label id="lblIsDepend" hidden>@ViewData["isDepend"]</label>
    <label id="lblParentMenuID" hidden>@ViewData["ParentMenuID"]</label>
    <label id="lblParentFormFieldID" hidden>@ViewData["ParentFormFieldID"]</label>
    <div class="toastBox"></div>
    <div id="dvMainTable">
        <div id="my-grid" style="width: 100%;"></div>       
    </div>
    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" style="filter: invert(1);" id="modelcloseX"></button>
                </div>

                <!-- Modal body : modernised card + responsive field grid.
                     All field ids / FormclrField / clrdiv / tabindex / handlers preserved. -->
                <div class="modal-body">
                    <div class="pt-1">
                        <table class="table w-100">
                            <tr>
                                <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                    <span class="form-label">
                                        <input tabindex="1" type="text" id="txtAccNo"
                                               class="form-control FormclrField alphanumeric-only"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorAccNo')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorAccNo')" />
                                        <label class="labelup">Bank Account No *</label>
                                    </span>
                                    <div class="clrdiv text-danger" id="dvErrorAccNo"></div>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                    <span class="form-label">
                                        <input tabindex="2" type="text" id="txtAccName"
                                               class="form-control FormclrField"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorAccName')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorAccName')" />
                                        <label class="labelup">Account Name *</label>
                                    </span>
                                    <div class="clrdiv text-danger" id="dvErrorAccName"></div>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                    <div class="input-group">
                                        <span id="openbankname" class="input-group-text" title="New Bank Name"><span class="fas fa-arrow-up-right-from-square"></span></span>
                                        <span class="form-label flex-fill">
                                            <select tabindex="3" id="cmbBank" class="form-control"></select>
                                            <label class="labelup">Bank Name *</label>
                                        </span>
                                        <div class="clrdiv text-danger" id="dvErrorBank"></div>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                    <span class="form-label">
                                        <input tabindex="4" type="text" id="txtBranch"
                                               class="form-control FormclrField alphanumeric-only" />
                                        <label class="labelup">Branch Name</label>
                                    </span>
                                    <div class="clrdiv text-danger" id="dvErrorBranch"></div>
                                </td>
                            </tr>

                            <tr>
                                <td style="border:none;padding-left:12px;padding-right:7px" width="50%">
                                    <span class="form-label">
                                        <input tabindex="5" type="text" id="txtIFSC"
                                               class="form-control FormclrField alphanumeric-only"
                                               maxlength="11" style="text-transform:uppercase" />
                                        <label class="labelup">IFSC Code</label>
                                    </span>
                                    <div class="clrdiv text-danger" id="dvErrorIFSC"></div>
                                </td>

                                <td style="border:none;padding-left:12px;padding-right:7px" width="50%">
                                    <span class="form-label">
                                        <input tabindex="6" type="number" id="txtMICR"
                                               class="form-control FormclrField"
                                               maxlength="9"
                                               oninput="if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); }" />
                                        <label class="labelup">MICR No</label>
                                    </span>
                                    <div class="clrdiv text-danger" id="dvErrorMICR"></div>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="2">
                                    <!-- Toggles (placed in the grid, after MICR) -->
                                    <div class="app-field ms-2">
                                        <div class="d-flex align-items-center gap-5">
                                            <div class="form-check form-switch">
                                                <input tabindex="7" type="checkbox" role="switch" id="chkDefault" class="form-check-input" />
                                                <label for="chkDefault" class="form-check-label">Set as default</label>
                                                <div class="clrdiv text-danger" id="dvErrorDefault"></div>
                                            </div>
                                            <div class="form-check form-switch">
                                                <input tabindex="8" type="checkbox" role="switch" id="chkActive" class="form-check-input" checked disabled />
                                                <label for="chkActive" class="form-check-label">Active</label>
                                                <div class="clrdiv text-danger" id="dvErrorActive"></div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                        </table>
                    </div>
                </div>

                <!-- Modal footer : icons modernised to Font Awesome 6, button ids/handlers preserved -->
                <div class="modal-footer">
                    <div class="d-flex justify-content-end gap-2 w-100">
                        <button tabindex="10" type="button" class="btn btn-clear-style" id="btnClear">
                            <i class="fa-solid fa-arrows-rotate"></i> Clear
                        </button>
                        <button tabindex="9" type="button" class="btn btn-save-style" id="btnSave">
                            <i class="fa-solid fa-floppy-disk"></i> Save
                        </button>
                        <button tabindex="11" type="button" class="btn btn-close-style" id="btnClose">
                            <i class="fa-solid fa-circle-xmark"></i> Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                nMode = 3;
                $(".clrdiv").html("");
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                var BankID = rowData.BankID;//[1];
                var AccNo = rowData.AccountNo;//[2];
                var AccName = rowData.AccountName;//[3];
                var Branch = rowData.BranchName;//[5];
                var IFSC = rowData.IFSCCode;//[6];
                var MICR = rowData.MICR;//[7];
                var SetDefault = rowData.SetDefault;//[8];
                var Active = rowData.Active;//[9];
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                $("#txtID").val(ID);
                $("#txtAccNo").val(AccNo);
                $("#txtAccName").val(AccName);
                $("#cmbBank").val(BankID);
                $("#txtBranch").val(Branch);
                $("#txtIFSC").val(IFSC);
                $("#txtMICR").val(MICR);
                $("#chkActive").prop("checked", Active == "True");
                $("#chkDefault").prop("checked", SetDefault == "True");
                $(".FormclrField").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbBank,#chkDefault").prop("disabled", true);
                $("#btnClear,#btnSave").hide();
                $("#btnClose").show();
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;
                var VID = rowData.ID;//[0];
                //GetData(5, VID);
                $(".clrdiv").html("");
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                var BankID = rowData.BankID;//[1];
                var AccNo = rowData.AccountNo;//[2];
                var AccName = rowData.AccountName;//[3];
                var Branch = rowData.BranchName;//[5];
                var IFSC = rowData.IFSCCode;//[6];
                var MICR = rowData.MICR;//[7];
                var SetDefault = rowData.SetDefault;//[8];
                var Active = rowData.Active;//[9];
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                $("#txtID").val(ID);
                $("#txtAccNo").val(AccNo);
                $("#txtAccName").val(AccName);
                $("#cmbBank").val(BankID);
                $("#txtBranch").val(Branch);
                $("#txtIFSC").val(IFSC);
                $("#txtMICR").val(MICR);
                $("#chkActive").prop("checked", Active == "True");
                $("#chkDefault").prop("checked", SetDefault == "True");
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbBank,#chkDefault").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $("#btnClear").hide();
                $("#btnClose,#btnSave").show();
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        allowAlphanumericOnly('.alphanumeric-only');
    });
    var Aurl = '@Session["APIurl"]';
    var itemorderby = '@Session["ItemOrderby"]';
var EnableALStartWith = '@Session["ALSearchstartwith"]' == "1";
var autolistfilterwith = EnableALStartWith;
var startwithfield = itemorderby == "1" ? "code" : itemorderby == "2" ? "name" : "search";
    var grid, BankAccount;
    Shortcutkeysformname = 'bankaccount';
    GetColumnSettingsData(2, 9, 1);
    var UID = '@Session["LoginUserID"]';
var nMode = 1;
var FID = $("#txtFormID").val();
    GetColumnSettingsData(2, 9, 1);
    GetData(3);
    GetData(5);
    var arrData = [];
    //~Grid Data
    function GetData(dMode, selectID="",id = 0) {
        $.ajax({
            url: Aurl + "bankaccount/get",
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: dMode, Name: id },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (dMode == 3) {
                    if (data.length == 0) {
                        showErrorSnackbar("No Records Found");
                    }
                    BankAccount = data;
                    arrData = [];
                    $.each(data, function (i, items) {
                        //arrData[i] = items.AccountNo
                        var al = {
                            "label": items.AccountNo,
                            "id": items.ID,
                        }
                        arrData.push(al);
                    });

                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, BankAccount, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,
                        enableAddRow: false,
                        enableRemoveRow: false,
                        enableSorting: true,
                        searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                        rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                        //onCellChange: handleCellUpdate,
                        customCellRenderer: (el, col, rowData) => {
                            console.log(col.field)
                            if (col.field === 'Active') {
                                const val = rowData[col.field];
                                if (val === 'True') {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                                } else if (val === 'False') {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                                }
                            }
                            if (col.field === 'SetDefault') {
                                const val = rowData[col.field];
                                if (val === 'True') {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-active">
    <span class="dg-status-circle"></span> Yes
</div>`;
                                } else if (val === 'False') {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
    <span class="dg-status-circle"></span> No
</div>`;
                                }
                            }
                        },
                        customButtons: [
                            {
                                icon: '⚙️',
                                text: '',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {
                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 9, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'New',
                                title: 'New Bank Account',
                                visible: $("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {
                                    nMode = 1;
                                    $("#chkActive,#btnSave,#btnClear,.FormclrField,#cmbBank,#chkDefault").prop("disabled", false);
                                    $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                    $("#btnClear,#btnClose,#btnSave").show();
                                    modal.show();
                                    ClearForm();
                                }
                            },
                        ],
                        onCellClick: (rowData, fieldName, cellValue, column) => {

                        },
                        onCellDoubleClick: (rowData, fieldName, cellValue, column) => {

                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(9, 1, 0, colIndex, field, newWidth)
                        },
                    });
                    //~AutoList
                    PaginatedAutocomplete({
                        inputId: "txtAccNo",
                        data: arrData,
                        startwitfieldname: startwithfield,
                        enablefilterstartwith: autolistfilterwith,
                        onSelect: function (item) {
                            $("#txtAccNo").val(item.label);
                            return false;
                        }
                    });
                    //$("#txtAccNo").autocomplete({
                    //    minLength: 0,
                    //    source: arrData,
                    //    select: function (event, ui) {
                    //        $("#txtAccNo").val(ui.item.label);
                    //        return false;
                    //    },
                    //}).autocomplete("instance")._renderItem = function (ul, item) {
                    //    return $("<li class='each'>")
                    //        .append("<div class='acItem'><span class='name'>" +
                    //            item.label + "</span></div>")
                    //        .appendTo(ul);
                    //};
                }
                else if (dMode == 5) {
                    $('#cmbBank').find("option").remove();
                    $('#cmbBank').append($('<option/>', {
                        value: 0,
                        text: "-- Select Bank --",
                        class: ""
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbBank').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    if (selectID) {
                        $('#cmbBank').val(selectID);
                    }
                }
                else if (dMode == 6 || dMode == 7) {
                    $.each(data, function (i, items) {
                        $("#txtID").val(items.ID);
                        $("#txtAccNo").val(items.AccountNo);
                        $("#txtAccName").val(items.AccountName);
                        $("#cmbBank").val(items.BankID);
                        $("#txtBranch").val(items.BranchName);
                        $("#txtIFSC").val(items.IFSCCode);
                        $("#txtMICR").val(items.MICR);
                        $("#chkActive").prop("checked", items.Active == "True");
                        $("#chkDefault").prop("checked", items.SetDefault == "True");
                    });
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    var modal = new bootstrap.Modal(document.getElementById('myModalfg'));//document.getElementById("myModalfg");
