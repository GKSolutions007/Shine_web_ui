        }
        /* Fixed sidenav, full height - MODERNIZED */
        .sidenav {
            height: 100%;
            width: 15%;
            position: fixed;
            z-index: 1000;
            top: 0;
            left: 0;
            /*background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);*/
            overflow-x: hidden;
            padding-top: 50px;
            color: white;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.3);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

            /* Style the sidenav links and the dropdown button */
            .sidenav li, .dropdown-btn {
                padding: 6px 12px;
                text-decoration: none;
                font-size: 13px;
                /*                color: #e2e8f0;*/
                display: block;
                border: none;
                background: none;
                width: 100%;
                text-align: left;
                cursor: pointer;
                outline: none;
                font-weight: 500;
                font-family: 'Roboto', 'Segoe UI', sans-serif;
                z-index: 9999;
                transition: all 0.3s ease;
                position: relative;
            }

                /* Modern hover effect */
                .sidenav a:hover, .dropdown-btn:hover {
                    background: linear-gradient(90deg, rgba(99, 102, 241, 0.15) 0%, transparent 100%);
                    color: #ffffff;
                    transform: translateX(3px);
                }

                /* Active menu item */
                .sidenav a.active, .dropdown-btn.active {
                    background: linear-gradient(90deg, rgba(99, 102, 241, 0.25) 0%, transparent 100%);
                    color: #ffffff;
                    font-weight: 600;
                }

        /* Main content */
        /*.main {
            top: 0px;
            margin-left: 15%;*/ /* Same as the width of the sidenav */
        /*padding: 0px 1px;
        }*/
        .main {
            padding-left: 10px !important;
            padding-top: 40px !important;
            padding-bottom: 30px !important;
            width: 100% !important;
            /*            margin-left: 10px !important;*/
            z-index: 9999 !important;
        }
        /* Add an active class to the active dropdown button */
        .active {
            /*background-color: brown;*/
            color: white;
        }

        /* Dropdown container (hidden by default). Optional: add a lighter background color and some left padding to change the design of the dropdown content */
        .dropdown-container {
            display: none;
            /* background: linear-gradient(180deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.8) 100%); */
            padding-left: 0;
            color: white;
            border-left: 3px solid var(--submenuborderleft);
            /* margin-left: 10px; */
            border-radius: 0 8px 8px 0;
            overflow: hidden;
        }

            /* Modern ul styling within sidenav */
            .dropdown-container ul {
                list-style: none;
                padding: 5px 0;
                margin: 0;
            }

                .dropdown-container ul li {
                    padding: 0;
                    margin: 2px 0;
                    transition: all 0.3s ease;
                }

                    .dropdown-container ul li a {
                        display: block;
                        padding: 5px 1px 1px 15px;
                        /*                        color: #cbd5e1;*/
                        text-decoration: none;
                        font-size: 12px;
                        font-weight: 400;
                        transition: all 0.3s ease;
                        position: relative;
                    }

                        /* Hover effect for submenu items */
                        .dropdown-container ul li a:hover {
                            background: linear-gradient(90deg, rgba(139, 92, 246, 0.2) 0%, transparent 100%);
                            color: #ffffff;
                            transform: translateX(3px);
                        }

                        /* Active submenu item */
                        .dropdown-container ul li a.active {
                            background: linear-gradient(90deg, rgba(139, 92, 246, 0.3) 0%, transparent 100%);
                            color: #ffffff;
                            font-weight: 500;
                        }

                        /* Icon styling in submenu */
                        .dropdown-container ul li a i {
                            margin-right: 8px;
                            font-size: 12px;
                            opacity: 0.8;
                            transition: all 0.3s ease;
                        }

                        .dropdown-container ul li a:hover i {
                            opacity: 1;
                            transform: scale(1.1);
                        }

        /* Optional: Style the caret down icon */
        .mendwn {
            float: right;
            padding-right: 8px;
            position: fixed;
        }

        /* Some media queries for responsiveness */
        @@media screen and (max-height: 450px) {
            .sidenav {
                padding-top: 10px;
            }

                .sidenav li {
                    font-size: 12px;
                }
        }

