                font-size: 10px;
                height: 28px;
                padding: 2px 6px;
            }

            .tabcontent .labelup {
                font-size: 9px;
            }

            .tabcontent label {
                font-size: 10px;
            }
            /* Tighten column padding so side-by-side layout still fits */
            .tabcontent .col-md-4,
            .tabcontent .col-md-2,
            .tabcontent .col-md-5,
            .tabcontent .col-md-6,
            .tabcontent [class*="col-md-"] {
                padding-left: 4px !important;
                padding-right: 4px !important;
            }
            /* Price tab has most columns - shrink more aggressively */
            #PriceDetails td {
                padding: 2px 3px !important;
            }

            #PriceDetails .form-control {
                font-size: 9px;
                padding: 2px 4px;
            }

            #PriceDetails label {
                font-size: 9px;
            }
            /* THIS IS THE KEY FIX - Bootstrap col-sm-12 forces full width at this breakpoint
        override it to keep the landscape side-by-side layout */
            #PriceDetails .col-sm-12 {
                flex: 0 0 auto !important;
                width: auto !important;
                max-width: none !important;
            }

            #PriceDetails .col-md-2 {
                flex: 0 0 16% !important;
                width: 16% !important;
            }

            #PriceDetails .col-md-4 {
                flex: 0 0 30% !important;
                width: 30% !important;
            }

            #PriceDetails .col-md-6 {
                flex: 0 0 54% !important;
                width: 54% !important;
            }
            /* Stack Price Excl and Price Incl vertically in tablet */
            #PriceDetails #txtPrice,
            #PriceDetails #txtPriceIncl {
                min-width: 0 !important;
                width: 100% !important;
            }
            /* Make the two tds in that row stack vertically */
            #PriceDetails td:has(#txtPrice),
            #PriceDetails td:has(#txtPriceIncl) {
                display: block !important;
                width: 100% !important;
                padding: 3px 4px !important;
            }
