    function printEmbedDocument_TEST(testlink) {
    var ismoborwin = '@Session["DeviceOS"]';

    //console.log("testlink", testlink);

    if (['Windows', 'macOS'].includes(ismoborwin)) {
        fetch(testlink)
            .then(response => response.blob())
            .then(pdfBlob => {

                const urlCreator = window.webkitURL;
                if (!urlCreator) {
                    console.error("Blob URL not supported");
                    window.open(testlink, '_blank');
                    return;
                }

                const pdfURL = urlCreator.createObjectURL(pdfBlob);

                let ifr = document.createElement("iframe");
                ifr.style.position = 'absolute';
                ifr.style.width = "0px";
                ifr.style.height = "0px";
                ifr.style.border = "none";
                ifr.src = pdfURL;

                ifr.onload = function () {
                    ifr.contentWindow.focus();
                    ifr.contentWindow.print();

                    // Clean up
                    setTimeout(() => {
                        urlCreator.revokeObjectURL(pdfURL);
                        document.body.removeChild(ifr);
                    }, 1000);
                };

                document.body.appendChild(ifr);
            })
            .catch(err => {
                console.error("Failed to load PDF:", err);
            });
    } else {
        window.open(testlink, '_blank');
    }
}
