                margin-top: 200px; /* change this number to move it lower */
                margin-left: 5px;
                margin-right: 5px;
                max-width: calc(100% - 10px);
            }
            /* Shrink all text and inputs to fit landscape layout in narrower width */
            .tabcontent td {
                font-size: 10px;
                padding: 2px 4px !important;
            }

