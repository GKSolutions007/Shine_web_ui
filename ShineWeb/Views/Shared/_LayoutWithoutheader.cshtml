<script>
    //cfFocus, ClearcfFocus, ClosecfFocus
    const ConfirmModal = (() => {
        const Savefocustype = cfFocus;
        const Clearfocustype = ClearcfFocus;
        const Closefocustype = ClosecfFocus;
        const TYPES = {
            save: {
                h: 142, s: '62%', l: '38%',
                icon: '\u{1F4BE}', tag: 'Save Action',
                title: '',
                message: 'Do you want to save data?',
                details: [
                ],
                yesLabel: 'Yes, Save',
                focustype: Savefocustype
            },
            clear: {
                h: 35, s: '90%', l: '45%',
                icon: '\u21BB', tag: 'Clear Action',
                title: '',
                message: 'Do you want to clear all data?',
                details: [

                ],
                yesLabel: 'Yes, clear all',
                focustype: Clearfocustype
            },
            close: {
                h: 0, s: '74%', l: '47%',
                icon: '\u2715', tag: 'Close Action',
                title: '',
                message: 'Do you want to close?',
                details: [
                ],
                yesLabel: 'Yes, close',
                focustype: Closefocustype
            },
        };

        const dialog = document.getElementById('cmDialog');
        const overlay = document.getElementById('cmOverlay');
        const canvas = document.getElementById('cmCanvas');
        const ctx = canvas.getContext('2d');
        const handle = document.getElementById('cmHandle');
        const btnYes = document.getElementById('cmYes');
        const btnNo = document.getElementById('cmNo');
        const posHint = document.getElementById('cmPosHint');

        let onYes = null, onNo = null;
        let particles = [], raf = null;

        /* ── Position state ── */
        let posX = 0, posY = 0;       // current translate (px from center)
        let dragging = false;
        let dragStartX = 0, dragStartY = 0;
        let dragOriginX = 0, dragOriginY = 0;
        let hasDragged = false;

        /* ── CSS vars ── */
        function setVars(cfg) {
            dialog.style.setProperty('--h', cfg.h);
            dialog.style.setProperty('--s', cfg.s);
            dialog.style.setProperty('--l', cfg.l);
        }

        /* ── Place dialog in center ── */
        function centerDialog() {
            const vw = window.innerWidth, vh = window.innerHeight;
            const dw = dialog.offsetWidth, dh = dialog.offsetHeight;
            dialog.style.left = Math.round((vw - dw) / 2) + 'px';
            dialog.style.top = Math.round((vh - dh) / 2) + 'px';
        }

        function applyPos() {
            dialog.style.transform = `translate(${posX}px, ${posY}px)`;
        }

        /* ── Populate ── */
        function populate(cfg, opts) {
            const c = { ...cfg, ...opts };
            document.getElementById('cmIcon').textContent = c.icon;
            document.getElementById('cmTag').textContent = c.tag;
            document.getElementById('cmTitle').textContent = c.title;
            document.getElementById('cmMessage').textContent = c.message;
            btnYes.textContent = c.yesLabel;
            setTimeout(() => {
                if (c.focustype == 1)
                    btnYes.focus(); // Focus the confirm button for better UX
                else if (c.focustype == 2)
                    btnNo.focus(); // Focus the cancel button for better UX
                //btnYes.focus(); // Focus the confirm button for better UX
            }, 1000);
            const det = document.getElementById('cmDetail');
            det.innerHTML = '';
            (c.details || []).forEach(txt => {
                const item = document.createElement('div');
                item.className = 'cm-detail-item';
                item.innerHTML = `
        <div class="cm-bullet">
          <svg viewBox="0 0 10 10" fill="none"
               stroke="hsl(${c.h},${c.s},${c.l})"
               stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1.5,5 4,7.5 8.5,2.5"/>
          </svg>
        </div>
        <span>${txt}</span>`;
                det.appendChild(item);
            });
        }

        /* ── Re-trigger CSS animations ── */
        function restartAnims() {
            dialog.style.animation = 'none';
            void dialog.offsetWidth;
            dialog.style.animation = '';

            ['.cm-tag', '.cm-title', '.cm-body', '.cm-footer',
                '.cm-drag-hint', '.cm-icon-inner'].forEach(sel => {
                    const el = dialog.querySelector(sel);
                    if (!el) return;
                    el.style.animation = 'none';
                    void el.offsetWidth;
                    el.style.animation = '';
                });
            dialog.querySelectorAll('.cm-detail-item').forEach(el => {
                el.style.animation = 'none';
                void el.offsetWidth;
                el.style.animation = '';
            });
        }

        /* ── Particles ── */
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        function burst(cfg) {
            particles = [];
            const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
            for (let i = 0; i < 40; i++) {
                const a = Math.random() * Math.PI * 2;
                const spd = 1.5 + Math.random() * 3;
                particles.push({
                    x: cx, y: cy,
                    vx: Math.cos(a) * spd,
                    vy: Math.sin(a) * spd - 1.4,
                    life: 1,
                    decay: .013 + Math.random() * .015,
                    r: 3 + Math.random() * 5,
                    h: cfg.h + (Math.random() - .5) * 28,
                    s: cfg.s, l: cfg.l,
                });
            }
            cancelAnimationFrame(raf);
            canvas.style.opacity = 1;
            loop();
        }

        function loop() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles = particles.filter(p => p.life > 0);
            particles.forEach(p => {
                p.x += p.vx; p.y += p.vy;
                p.vy += .065;
                p.life -= p.decay;
                if (p.life <= 0) return;
                ctx.save();
                ctx.globalAlpha = p.life * .72;
                ctx.fillStyle = `hsl(${p.h},${p.s},${p.l})`;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r * p.life, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });
            if (particles.length) raf = requestAnimationFrame(loop);
            else canvas.style.opacity = 0;
        }

        /* ── Drag ── */
        function onPointerDown(e) {
            if (e.target === btnYes || e.target === btnNo) return;
            dragging = true;
            dragStartX = e.clientX;
            dragStartY = e.clientY;
            dragOriginX = posX;
            dragOriginY = posY;
            dialog.classList.add('is-dragging');
            e.preventDefault();
        }

        function onPointerMove(e) {
            if (!dragging) return;
            const dx = e.clientX - dragStartX;
            const dy = e.clientY - dragStartY;
            if (Math.abs(dx) > 3 || Math.abs(dy) > 3) hasDragged = true;
            posX = dragOriginX + dx;
            posY = dragOriginY + dy;
            applyPos();
            posHint.textContent = `x ${Math.round(posX)}  y ${Math.round(posY)}`;
        }

        function onPointerUp() {
            if (!dragging) return;
            dragging = false;
            dialog.classList.remove('is-dragging');
            if (!hasDragged) posHint.textContent = '';
        }

        handle.addEventListener('pointerdown', onPointerDown);
        window.addEventListener('pointermove', onPointerMove);
        window.addEventListener('pointerup', onPointerUp);

        /* ── Shake ── */
        function shake(cb) {
            dialog.classList.remove('shake');
            void dialog.offsetWidth;
            dialog.classList.add('shake');
            dialog.addEventListener('animationend', () => {
                dialog.classList.remove('shake');
                if (cb) cb();
            }, { once: true });
        }

        /* ── Show ── */
        function show(type, yesCb, noCb, opts = {}) {
            const cfg = TYPES[type];
            if (!cfg) return;
            onYes = yesCb || null;
            onNo = noCb || null;
            hasDragged = false;
            posHint.textContent = '';

            resizeCanvas();
            setVars(cfg);
            dialog.focus();
            // Reset position to center
            posX = 0; posY = 0;
            dialog.style.transform = 'scale(.82) translateY(20px)';
            dialog.style.transition = 'opacity .35s ease, transform .45s cubic-bezier(.34,1.56,.64,1)';
            dialog.style.opacity = '0';
            dialog.classList.remove('visible');

            overlay.classList.add('visible');
            populate(cfg, opts);

            // Let browser paint the reset state, then animate in
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    centerDialog();
                    restartAnims();
                    dialog.style.transform = `translate(${posX}px,${posY}px)`;
                    dialog.style.opacity = '1';
                    dialog.classList.add('visible');

                    // After entry animation, switch to drag-only transform (no transition)
                    setTimeout(() => {
                        dialog.style.transition = 'box-shadow .2s';
                    }, 480);
                });
            });

            burst(cfg);
        }

        /* ── Hide ── */
        function hide() {
            dialog.classList.remove('visible');
            dialog.style.opacity = '0';
            dialog.style.transition = 'opacity .25s ease';
            overlay.classList.remove('visible');
            posX = 0; posY = 0;
        }

        /* ── Button events ── */
        btnYes.addEventListener('click', () => { hide(); if (onYes) onYes(); });
        btnNo.addEventListener('click', () => { hide(); if (onNo) onNo(); });

        /* ── Overlay click → shake ── */
        overlay.addEventListener('click', () => shake(() => { }));//hide(); if (onNo) onNo();

        /* ── ESC → shake ── */
        document.addEventListener('keydown', e => {
            if (e.key !== 'Escape' || !overlay.classList.contains('visible')) return;
            shake(() => { hide(); if (onNo) onNo(); });
        });

        window.addEventListener('resize', () => {
            resizeCanvas();
            if (overlay.classList.contains('visible')) centerDialog();
        });

        return { show, hide };
    })();

</script>