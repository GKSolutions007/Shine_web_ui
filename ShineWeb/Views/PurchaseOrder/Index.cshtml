                                "line2": "₹ : " + items.PurchasePrice + " | Qty : <label style='color:" + clr + "'> " + items.ABSQty + " </label>",
                                "price": items.PurchasePrice
                            }
                            TempAL.push(al);
                        });
                        if (ItemALTheme == 1) {
                            PaginatedAutocomplete({
                                inputId: "txtHProds",// "txtProdName",
                                data: TempAL,
                                onSelect: function (item) {
                                    $("#txtHProds").val(item.code);
                                    $("#lblABS").html(item.ABS);
