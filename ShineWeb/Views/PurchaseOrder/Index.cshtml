    var ProductArray = [];
    function addProdinArray() {
        ProductArray = [];
        var dPTQty = 0, dPTPrice = 0, dPTPriceIncl = 0, dPTGross = 0, dPTTax = 0, dPTNet = 0, nSerial = 1,dUOMCR = 1;
        $("#tblProductData tbody tr").each(function () {
            var allValues = {};
            rowdata = ProductTable.row($(this)).data();
            nProdID = rowdata[0];
            nUOMID = rowdata[2];
            nTaxID = rowdata[3];
            nTaxPern = rowdata[4];
            dUOMCR = rowdata[5];
            var val = 0;
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Qty") {
                    val = $(this).attr("txttag");
                    dPTQty = parseFloat(val);// ReturnTagValue(fieldID, fieldName);// parseFloat($(this).val());
                }
                if (fieldName == "Excl") {
                    val = $(this).attr("txttag");
                    dPTPrice = parseFloat(val);// ReturnTagValue(fieldID, fieldName);//parseFloat($(this).val());
                }
                if (fieldName == "Incl") {
                    val = $(this).attr("txttag");
                    dPTPriceIncl = parseFloat(val);// ReturnTagValue(fieldID, fieldName);//parseFloat($(this).val());
                }
            });

            $(this).find("label").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Gross") {
                    val = $(this).attr("lbltag");
                    dPTGross = parseFloat(val);//ReturnTagValue(fieldID, fieldName);//parseFloat($(this).text());
                }
                if (fieldName == "TaxAmt") {
                    val = $(this).attr("lbltag");
                    dPTTax = parseFloat(val);//ReturnTagValue(fieldID, fieldName);//parseFloat($(this).text());
                }
                if (fieldName == "NetAmt") {
                    val = $(this).attr("lbltag");
                    dPTNet = parseFloat(val);//ReturnTagValue(fieldID, fieldName);//parseFloat($(this).text());
                }
            });
            if (dPTQty > 0) {
                var listProds = {
                    "ProdID": nProdID,
                    "UomID": nUOMID,
                    "TaxID": nTaxID,
                    "TaxPern": nTaxPern,
                    "ExclPrice": dPTPrice,
                    "InclPrice": dPTPriceIncl,
                    "Qty": dPTQty,
                    "GrossAmt": dPTGross,
                    "TaxAmt": dPTTax,
                    "NetAmt": dPTNet,
                    "UOM": dUOMCR
                }

                ProductArray.push(listProds);
                nSerial++;
            }
        });
    }
