<script>
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                nMode = 3;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                GetData(4, ID);                
                $(".FormclrField").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbStateName").prop("disabled", true);
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                GetData(4, ID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbStateName").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>

<script type="text/javascript">
  
    var Aurl = '@Session["APIurl"]';
   
    if ($("#txtModifyID").val() == 0 && $("#txtViewID").val() == 0 && $("#txtAddID").val() == 1) {
        $("#dvMainTable").hide();
    }
    var grid, BranchOffice;
    GetColumnSettingsData(2, 12, 1);
    var DefStateID = '@Session["StateID"]';
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    GetData(3);
    GetData(5);
    var arrCodeData = [], arrNameData = [];
    function GetData(dMode,ID = 0) {
        $.ajax({
            url: Aurl + "branchoffice/get",
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: dMode, Name: ID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                    if (dMode == 3) {
                        if (data.length == 0) {
                            showErrorSnackbar("No Records Found");
                        }
                        BranchOffice = data;
                        arrCodeData = [], arrNameData = [];
                        $.each(data, function (i, items) {
                            var al = {
                                "label": items.Code,
                                "id": items.ID,
                            }
                            arrCodeData.push(al);
                            al = {
                                "label": items.Name,
                                "id": items.ID,
                            }
                            arrNameData.push(al);                            
                        });
                        var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, BranchOffice, {
                            enablePagination: true,
                            pageSize: ItemsperPage,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
