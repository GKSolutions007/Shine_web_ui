        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".FormclrField").val("");
        $("#cmbTax").val(0)
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#txtCode").focus();
        $('#cmbStateName').val(DefStateID);
        if (nMode != 1)
            modal.hide();
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        var IsValid = true, ChkFormation = true;
        if ($("#txtName").val() == "") {
            IsValid = false;
            $("#dvErrorName").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        if ($("#txtCode").val() == "") {
            IsValid = false;
            $("#dvErrorCode").html("Code should not be empty");
            showErrorSnackbar("Code should not be empty");
        }
        ChkFormation = MobilenoValidation($("#txtMobileNo"), $("#dvErrorMobileNo"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = PhonenoValidation($("#txtPhoneNo"), $("#dvErrorPhoneNo"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = GSTINValidation($("#txtGSTIN"), $("#dvErrorGSTIN"));
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = EmailValidation($("#txtEMail"), $("#dvErrorEMail"));
        if (!ChkFormation) {
            IsValid = false;
        }

        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var lstMaster = {
            "FormID": FID,
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "Code": $("#txtCode").val(),
            "Name": $("#txtName").val(),
            "Billadd1": $("#txtAddress1").val(),
            "Billadd2": $("#txtAddress2").val(),
            "Billadd3": $("#txtAddress3").val(),
            "ContactPerson": $("#txtContactPerson").val(),
            "Ph1": $("#txtPhoneNo").val(),
            "Mob1": $("#txtMobileNo").val(),
            "Email": $("#txtEMail").val(),
            "StateID": $("#cmbStateName").val(),
            "GSTIN": $("#txtGSTIN").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID
        };
            $.ajax({
                url: Aurl + "branchoffice/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            //showErrorSnackbar(items.Message);
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                            GetData(3);
                            modal.hide();
                        }
                        else if (items.Message == "Code") {
                            $("#dvErrorCode").html("Code Already Exists");
                            showErrorSnackbar("Code Already Exists");
                        }
                        else if (items.Message == "Name") {
                            $("#dvErrorName").html("Name Already Exists");
                            showErrorSnackbar("Name Already Exists");
                        }
                        else if (items.Message == "AccountName") {
                            $("#dvErrorName").html("Account Name Already Exists in another master");
                            showErrorSnackbar("Account Name Already Exists in another master");
                        }
                        else {
                            //$("#divErrorOnCode").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        ////showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }


    $('input, select ,button, textarea').on('keydown', function (e) {
        if (e.key === "Enter") {
            e.preventDefault(); // Prevent default behavior
            let $next = $(this).nextAll('input, select').first(); // Find the next input or select
            if ($next.length) {
                console.log("Enter pressed");
                $next.focus(); // Focus the next element
            }
        }
    });
