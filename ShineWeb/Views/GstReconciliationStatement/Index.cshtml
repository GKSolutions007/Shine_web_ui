        columns: [
            { data: "TransID", visible: false },
            { data: "ID", visible: false },
            { data: null, className: "dt-body-center", render: function (d, t, r, m) { return m.row + 1; } },
            { data: "BranchName" },
            {
                data: "PortalDate", render: function (d) {
                    var v = d ? d.substring(0, 10) : "";
                    return '<input type="date" name="PortalDate" class="gdInput dgvPortalDate" value="' + v + '"/>';
                }
            },
            {
                data: "TransDate",
                render: function (d, type) {
                    if (!d) return "";
                    var iso = d.substring(0, 10);
                    if (type !== "display") return iso;
                    var p = iso.split("-");
                    return p[2] + "/" + p[1] + "/" + p[0];
                }
            },
            { data: "DocID" },
            { data: "RefNo" },
            { data: "PartyName" },
            { data: "GrossAmount", className: "dt-body-right" },
