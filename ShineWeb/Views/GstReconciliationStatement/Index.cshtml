    function SetAutlistforFields(defvalue) {
        //~AutoList
        PaginatedAutocomplete({
            inputId: "txtFilterParty",
            data: arrParty,
            startwitfieldname: startwithfield,
            enablefilterstartwith: autolistfilterwith,
            onSelect: function (item) {
                $("#txtFilterParty").val(item.name);
                return false;
            }
        });
    }
    setDate("dtpFFrom", 0);
    setDate("dtpFTo", 0);
    $('#btnFilter').click(function (e) {
        GetFilterData(1);
    });
    function GetFilterData(ClickType = 0) {
        var IsValid = true;
        $(".clrdivs").html("");
        if ($("#dtpFFrom").val() == "") {
            IsValid = false;
            $("#divErrFFrom").html("From date should not be empty");
        }
        if ($("#dtpFTo").val() == "") {
            IsValid = false;
            $("#divErrFTo").html("To date should not be empty");
        }
        if ($("#dtpFFrom").val() > $("#dtpFTo").val()) {
            IsValid = false;
            $("#divErrFFrom").html("From date should be lessthan To Date");
        }
        if (IsValid) {
            GetData();
        }
    }
    //$('input[type=date]').focusin(function (e) {
    //    $(this).select();
    //});
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        SetFilterDate();
        $(".clrdiv").html("");
        Table.draw().clear(); Table.draw().clear();
        GetData(1);
    }
    var listTrans = [];
    function addAccountsinArray() {
        listTrans = [];
        $("#tblBRSData tbody tr").each(function () {
            var rowdata = Table.row($(this)).data();
            if (!rowdata) return;

            var transID = rowdata.TransID;
            var portalDate = "";
            $(this).find("input").each(function () {
                const fieldName = $(this).attr("name");
                if (fieldName == "PortalDate") {
                    portalDate = $(this).val();
                }
            });
            if (portalDate == rowdata.PortalDate) return;

            var item = {
                "ID": rowdata.ID,
                "TransID": rowdata.TransID,
                "PortalDate": portalDate,
                "TransDate": rowdata.TransDate.substring(0, 10)
            };
            listTrans.push(item);
        });
    }

    $("#btnSave").click(function () {
        $(".clrdiv").html("");

        if (Table.rows().count() == 0) {
            showErrorSnackbar("No Records Found");
            return;
        }

        addAccountsinArray();
        if (listTrans.length == 0) { showErrorSnackbar("No changes to save"); return; }
        if (cfFocus != 3) {
            ConfirmDialogMsg("Do you want to save data?");
        } else {
            SaveData();
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $.ajax({
            url: Aurl + "gstreconsiliation/savegstrecon",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(listTrans),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        GetData();
                        showSuccessSnackbar(items.Message);
                    }
                    else {
                        showErrorSnackbar(items.Message);
                    }
                });
            },
            error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                }
            }
        });
    }
    document.addEventListener("keydown", function (event) {

        if (event.altKey && (event.key == 's')) {//Switch contains & startwith
            event.preventDefault();
            var fieldid = event.target.id;
            var infomessage = "Search mode changed to&ensp;" + (autolistfilterwith ? "<h4><code>Contains </code></h4>" : "<h4><code>Start with</code></h4>");
            autolistfilterwith = !autolistfilterwith;
            if (fieldid == "txtFilterParty") {
                showInfoSnackbar(infomessage);
                //~AutoList
                PaginatedAutocomplete({
                    inputId: "txtFilterParty",
                    data: arrParty,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtFilterParty").val(item.name);
                        return false;
                    }
                });
            }
        }
        else if (event.altKey && (event.key == 'a')) {//change search field
            event.preventDefault();
            var fieldid = event.target.id;
            startwithfield = (startwithfield == "code" ? "name" : startwithfield == "search" ? "code" : "search");
            if (fieldid == "txtFilterParty") {
                showInfoSnackbar("Search field changed to&ensp; <h4><code>'" + startwithfield + "'</code></h4>");

                //~AutoList
                PaginatedAutocomplete({
                    inputId: "txtFilterParty",
                    data: arrParty,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtFilterParty").val(item.name);
                        return false;
                    }
                });
            }
        }
        // autolistfilterwith = 1;
        else if (event.altKey && (event.key == 'q')) {//Info about Autolist property
            var containinfo = autolistfilterwith ? "Start With" : "Contains";
            var searchcolumninfo = startwithfield;

            var alinfo = `
<div class="p-3" style="min-width:360px;">
    <!-- Search Mode -->
    <div class="border rounded-3 p-3 mb-2 bg-light">
        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary me-2"
                     style="width:34px;height:34px;">
                    <i class="bi bi-search"></i>
                </div>

                <div>
                    <div class="text-muted medium fw-semibold">Search Mode</div>
                    <div class="fw-bold text-dark" style="font-size:16px">&emsp;<code>${containinfo}</code></div>
                </div>
            </div>

            <i class="bi bi-chevron-right text-muted"></i>
        </div>
    </div>

    <!-- Search Field -->
    <div class="border rounded-3 p-3 bg-light">
        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success me-2"
                     style="width:34px;height:34px;">
                    <i class="bi bi-tag"></i>
                </div>

                <div>
                    <div class="text-muted medium fw-semibold">Search Field</div>
                    <div class="fw-bold text-dark" style="font-size:16px">&emsp;<code>${searchcolumninfo}</code></div>
                </div>
            </div>

            <i class="bi bi-chevron-right text-muted"></i>
        </div>
    </div>

</div>
`;
            InfoDialogMsg(alinfo, "Autolist property");
        }
    });

</script>