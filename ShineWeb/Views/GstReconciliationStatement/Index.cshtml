    function GetData() {
        $.ajax({
            url: Aurl + "gstreconsiliation/getgstrecon",
            type: 'GET',
            dataType: 'json',
            data: {
                Transaction: $("#cmbTransaction").val(),
                FromDate: $("#dtpFFrom").val(),
                ToDate: $("#dtpFTo").val(),
                ShowBlankDate: $("#chkShowBlank").is(":checked") ? 1 : 0
            },
            xhrFields: { withCredentials: true },
            success: function (data) {
                Table.clear().rows.add(data).draw();
                if (data.length == 0) showErrorSnackbar("No Records Found");
            },
            error: function (data) { }
        });
    }

    $('#tblBRSData tbody').on('keydown', '.dgvPortalDate', function (e) {
        var kyc = e.keyCode;
        var $tr = $(this).closest('tr');
        var TranDate = Table.row($tr).data().TransDate.substring(0, 10);

        if (kyc == 32) {//Space : Assign Trans Date
            e.preventDefault();
            $(this).val(TranDate);
        }
        if (kyc == 68) {//D : Assign Above Date
            e.preventDefault();
            var AboveDate = $tr.prev().find(".dgvPortalDate").val();
            if (AboveDate) { $(this).val(AboveDate); } else { showErrorSnackbar("No date found"); }
        }
        if (kyc == 186) {//";" : Trans Date + 1
            e.preventDefault();
            var gt = new Date(TranDate);
            gt.setUTCDate(gt.getUTCDate() + 1);
            $(this).val(gt.toISOString().substring(0, 10));
        }
    });

