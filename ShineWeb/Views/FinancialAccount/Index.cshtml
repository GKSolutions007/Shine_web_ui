    var Url = '@Session["url"].ToString()';
    $("#openaccountgroup").click(function (e) {
        var selectedName = $("#txtAccGrp").val().trim();
        var matchedGroup = arrAccGrp.find(function (grp) {
            return grp.label.trim().toLowerCase() === selectedName.toLowerCase();
        });
        var nCustomerTypeID = matchedGroup ? matchedGroup.id : 0;
        console.log("ID:", nCustomerTypeID);
        vw = window.innerWidth;
        vh = window.innerHeight;
        const hasPermission = nCustomerTypeID == 0
            ? checkAddEditPermission("99")
            : checkAddEditPermission("100");
        if (hasPermission) {
            var ProdUrl = Url + "FinancialAccountGroup?name=NJw417j5%2B33dQvzLkF6kQTy0mGy7olZaNHZkQqKFwAmkfrZBHRU0K9UjYin4MgTY&strFormID=IQhEoLP%2FdN3wEndxbtM3zw%3D%3D&TypeID=BOII5FUynjpl5RZJJ8nW1g%3D%3D&TranID=jJOtHsRVwYECOhoiBc69dA%3D%3D&ID=" + nCustomerTypeID;
            window.open(ProdUrl, "_blank", "width=" + vw + ",height=" + vh + ",scrollbars=yes,resizable=yes");
        }
        else {
            showErrorSnackbar("You don't have permission for &ensp;<h4><code>" + (nCustomerTypeID == 0 ? "Add" : "Edit") + " Financial Account Group</code></h4>");
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "F8") {
            event.preventDefault();
            var FieldID = event.target.id;
            var FieldName = event.target.name;
            if (FieldID == "txtAccGrp") {
                $("#openaccountgroup").trigger("click");
            }
        }
    });
