@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>    
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 1px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 801px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 40%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }


    @@media only screen and (min-width: 600px) and (max-width: 800px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 60%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -55%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.ChildURL1, new { @autocomplete = "off", @class = "form-control", @id = "txtChildRoleURL" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>
    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>
    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        <b>Add @ViewData["FormName"]</b>
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body text-center">
                    <table class="table w-100">
                        <tbody>

                            <tr>
                                <td class="border-0 px-2" colspan="2">

                                    <span class="form-label">
                                        <input tabindex="1" type="text" id="txtAccName"
                                               class="form-control FormclrField"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this, '#dvErrorAccName')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorAccName')" />

                                        <label class="labelup">Account Name *</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorAccName"></div>

                                </td>
                            </tr>

                            <tr>
                                <td class="border-0 px-2" colspan="2">
                                    <div class="input-group">
                                        <span id="openaccountgroup" class="input-group-text" title="New Bank Name"><span class="fas fa-arrow-up-right-from-square"></span></span>
                                        <span class="form-label flex-fill">
                                            <input tabindex="2" type="text"
                                                   id="txtAccGrp"
                                                   class="form-control FormclrField" />

                                            <label class="labelup">Account Group *</label>
                                        </span>
                                        <input type="hidden" id="hdnAccGrpID" value="0" />
                                        <a href="javascript:void(0)" id="hrefNewRole" hidden>New Role</a>

                                        <div class="clrdiv text-danger" id="dvErrorAccGrp"></div>
                                    </div>

                                </td>
                            </tr>

                            <tr>

                                <td class="border-0 px-2" width="50%">

                                    <span class="form-label">
                                        <input tabindex="3"
                                               type="number"
                                               id="txtSAC"
                                               class="form-control FormclrField"
                                               maxlength="6"
                                               oninput="if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); }" />

                                        <label class="labelup">SAC Code</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorSAC"></div>

                                </td>

                                <td class="border-0 px-2" width="50%">

                                    <span class="form-label">
                                        <input tabindex="4"
                                               type="text"
                                               id="txtPAN"
                                               class="form-control FormclrField"
                                               maxlength="10"
                                               style="text-transform:uppercase" />

                                        <label class="labelup">PAN No</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorPAN"></div>

                                </td>

                            </tr>

                            <tr>

                                <td class="border-0 px-2" width="50%">

                                    <span class="form-label">
                                        <select class="form-control FormclrcmbField" id="cmbBranch">
                                            <option value="0">Select Branch</option>
                                        </select>

                                        <label class="labelup" for="cmbBranch">Branch *</label>
                                    </span>

                                    <div id="divErrBranch" class="error-msg clrdiv"></div>

                                </td>

                                <td class="border-0 px-2" width="50%">

                                    <span class="form-label">
                                        <input tabindex="5"
                                               type="number"
                                               id="txtOpenBal"
                                               class="form-control FormclrField txtsettag"
                                               txttag="0"
                                               onbeforeinput="return NumericOnlyBeforeInput(event, this,'#dvErrorOpenBal')"
                                               oninput="sanitizeNumericOnly(this, '#dvErrorOpenBal')" />

                                        <label class="labelup">Opening Balance</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorOpenBal"></div>

                                </td>

                            </tr>

                            <tr>

                                <td class="border-0 px-2" width="50%">

                                    <span class="form-label">
                                        <select tabindex="6" id="cmbFAType" class="form-control">
                                            <option value="1">Credit</option>
                                            <option value="2">Debit</option>
                                        </select>

                                        <label class="labelup">FA Type *</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorFAType"></div>

                                </td>

                                <td class="border-0">
                                    <label id="lblCloseOS"></label>
                                </td>

                            </tr>

                            <tr>

                                <td class="border-0" colspan="2">

                                    <label for="chkActive">Active :</label>

                                    <input tabindex="7"
                                           type="checkbox"
                                           id="chkActive"
                                           checked
                                           disabled />

                                    <div class="clrdiv text-danger" id="dvErrorActive"></div>

                                </td>

                            </tr>

                        </tbody>
                    </table>

                </div>

                <!-- Modal footer -->
                <div class="modal-footer">

                    <div class="text-end w-100">

                        <button tabindex="9" type="button" class="btn btn-danger" id="btnClear">
                            <span class="glyphicon glyphicon-refresh"> Clear</span>
                        </button>

                        <button tabindex="8" type="button" class="btn btn-success" id="btnSave">
                            <span class="glyphicon glyphicon-saved"> Save</span>
                        </button>

                        <button tabindex="10" type="button" class="btn btn-warning" id="btnClose">
                            <i class="bi bi-x-circle"></i> Close
                        </button>

                    </div>

                </div>

            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                TransMode = 3;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;
                GetData(6, ID);
                $(".FormclrField").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbFAType").prop("disabled", true);
                $("#txtAccGrp").prop("disabled", true);
                $("#btnClear,#btnSave").hide();
                $("#btnClose").show();
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                TransMode = 2;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                //var ID = rowData[0];
                var ID = rowData.ID;
                GetData(6, ID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbFAType").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $("#btnClear").hide();
                $("#btnClose,#btnSave").show();
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>

<script type="text/javascript">
        var UID = '@Session["LoginUserID"]';
var TransMode = 1;
var FID = $("#txtFormID").val();
var DecVal = '@Session["DecimalValues"]';
    var Aurl = '@Session["APIurl"]';
   var DefBranch = '@Session["DefaultBranch"]';

    var grid, FinancialAccount;
    GetColumnSettingsData(2, 6, 1);
    var Table = $('#tblMasterData').DataTable();

    //~Grid Data
    AllFAData();
    function AllFAData() {
        $.ajax({
            url: Aurl + "financialaccount/getalldata",
                type: "GET",
                    datatype: "JSON",
                        xhrFields: {
                withCredentials: true
            },
            data: { Mode: 3, Name: "" },
            success: function (data) {
                if (data.length == 0) {
                    showErrorSnackbar("No Records Found");
                }
                FinancialAccount = data;
                var fajsdata = eval(data);

                var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, FinancialAccount, {
                    enablePagination: true,
                    pageSize: ItemsperPage,
                    enableSearch: true,
                    stickyToWindow: true,
                    enableExport: false,
                    enablePrint: false,
                    enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                    enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                    enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                    enableSorting: true,
                    searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                    rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                    //onCellChange: handleCellUpdate,
                    customCellRenderer: (el, col, rowData) => {
                        if (col.field === 'Active') {
                            const val = rowData[col.field];
                            console.log("Active : ", val);
                            if (val === 'Yes') {
                                el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                            } else if (val === 'No') {
                                el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                            }
                        }
                    },
                    customButtons: [
                        {
                            icon: '⚙️',
                            text: '',
                            title: 'Settings',
                            visible: true,
                            onClick: (gridInstance, event) => {
                                modalGenColumnSettings.show();
                                GendralColumnSettings(1, 6, 1, 0);
                            }
                        },
                        {
                            icon: '➕',
                            text: 'New',
                            title: 'New ' + $("#MainHeading").text(),
                            visible: $("#txtAddID").val() == 1,
                            onClick: (gridInstance, event) => {
                                TransMode = 1;
                                $("#chkActive,#btnSave,#btnClear,.FormclrField,#cmbFAType").prop("disabled", false);
                                $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                $("#btnClear,#btnClose,#btnSave").show();
                                modal.show();
                                ClearForm();
                            }
                        },
                    ],
                    onCellClick: (rowData, fieldName, cellValue, column) => {
                    },
                    onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                    },
                    onColumnResize: (colIndex, field, header, newWidth) => {
                        UpdateColumnWidth(6, 1, 0, colIndex, field, newWidth)
                    },
                });
            }
        });
    }
    GetData(3);
    GetData(5);
    GetData(7);
    var arrData = [], arrAccGrp = [];
    function GetData(nMode,strName="",strBranchID = 0) {
        $.ajax({
            url: Aurl + "financialaccount/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, Name: strName, BranchID: strBranchID },
            xhrFields: {
                withCredentials: true
            },
            //async: false,
            success: function (data) {
                if (data.length > 0) {
                    if (nMode == 3) {
                        arrData = [];
                        //Table.draw().clear();
                        $.each(data, function (i, items) {
                            //arrData[i] = items.AccountName
                            var al = {
                                "label": items.AccountName,
                                "id": items.ID,
                            }
                            arrData.push(al);
                        });
                        //~AutoList Account Name
                        PaginatedAutocomplete({
                            inputId: "txtAccName",
                            data: arrData,
                            onSelect: function (item) {
                                console.log("Selected item:", item);
                                $("#txtAccName").val(item.label);
                                $("#hdnAccGrpID").val(item.id);
                                return false;
                            }
                        });
                        //$("#txtAccName").autocomplete({
                        //    minLength: 0,
                        //    source: arrData,
                        //    select: function (event, ui) {
                        //        $("#txtAccName").val(ui.item.label);
                        //        //$("#txtRemarks").val(ui.item.id);
                        //        return false;
                        //    },
                        //}).autocomplete("instance")._renderItem = function (ul, item) {
                        //    return $("<li class='each'>")
                        //        .append("<div class='acItem'><span class='name'>" +
                        //            item.label + "</span></div>")
                        //        .appendTo(ul);
                        //};
                    }
                    else if (nMode == 5) {
                        arrAccGrp = [];
                        $.each(data, function (i, items) {
                            var al = {
                                "label": items.Name,
                                "id": items.ID,
                            }
                            arrAccGrp.push(al);
                        });
                        //~AutoList Account Group
                        PaginatedAutocomplete({
                            inputId: "txtAccGrp",
                            data: arrAccGrp,
                            onSelect: function (item) {
                                $("#txtAccGrp").val(item.label);
                                return false;
                            }
                        });
                        $("#txtAccGrp").val(strName);
                        //$("#txtAccGrp").autocomplete({
                        //    minLength: 0,
                        //    source: arrAccGrp,
                        //    select: function (event, ui) {
                        //        $("#txtAccGrp").val(ui.item.label);
                        //        return false;
                        //    },
                        //}).autocomplete("instance")._renderItem = function (ul, item) {
                        //    return $("<li class='each'>")
                        //        .append("<div class='acItem'><span class='name'>" +
                        //            item.label + "</span></div>")
                        //        .appendTo(ul);
                        //};
                    }
                        //~Assign Data
                    else if (nMode == 6) {
                        $.each(eval(data), function (i, items) {
                            var tt = items.FAType == "Credit" ? "1" : "2";
                            $("#txtID").val(items.ID);
                            $("#txtAccGrp").val(items.FaGroup);
                            var matchedGroup = arrAccGrp.find(function (grp) {
                                return grp.label == items.FaGroup;
                            });
                            $("#hdnAccGrpID").val(matchedGroup ? matchedGroup.id : 0);
                            $("#txtAccName").val(items.AccountName);
                            $("#cmbFAType").val(tt);
                            $("#txtSAC").val(items.SACCode);
                            $("#txtPAN").val(items.PAN);
                            $("#chkActive").prop("checked", items.Active == "True");
                            updateInputColumn("txtOpenBal", 0);//items.OpenBalance
                            $("#lblCloseOS").text("Closing Balance : 0.00 Cr");// + items.CloseBal
                            $("#cmbBranch").val(DefBranch);
                            if (TransMode == 2)
                                $("#txtAccGrp").prop("disabled", items.UserAccount == "0");
                            else
                                $("#txtAccGrp").prop("disabled", true);

                            $("#cmbFAType,#txtOpenBal").prop("disabled", true);
                            $("#cmbBranch").prop("disabled", TransMode == 1);
                            setTimeout(() => {
                                GetData(8, items.ID, DefBranch);
                            }, 500);
                        });
                    }
                    else if (nMode == 7) {
                        $('#cmbBranch').find("option").remove();
                        $('#cmbBranch').append($('<option/>', {
                            value: 0,
                            text: "-- Select --",
                        }));
                        $.each(data, function (i, items) {
                            $('#cmbBranch').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        });
                    }
                        //~Opening by Branch
                    else if (nMode == 8) {
                        $.each(data, function (i, items) {
                            $("#cmbFAType").val(items.FAType);
                            updateInputColumn("txtOpenBal", items.OpenBalance);
                            $("#lblCloseOS").text("Closing Balance : " + items.CloseBal);
                        });
                    }
                }
                else {
                    showErrorSnackbar("No Records Found");
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $("#cmbBranch").change(function (e) {
        $(".clrdiv").html("");
        var ID = $("#txtID").val()
        var BID = e.target.value;
        if (ID != "") {
            if (BID > 0) {
                GetData(8, ID, BID);
            } else {
                showErrorSnackbar("Select Valid Branch");
                $("#cmbFAType").val(1);
                updateInputColumn("txtOpenBal", 0);
                $("#lblCloseOS").text("Closing Balance : 0.00 Cr");
            }
        }
    });
    function SetTagZero() {
        var inputs = $(".txtsettag");
        for (var i = 0; i < inputs.length; i++) {
            var field = $(inputs[i]);
            var FID = field[0].id;
            if (FID != "")
                updateInputColumn(FID, 0);
        }
    }
    //~SETTag for Textbox
    function updateInputColumn(inputID, netValue) {
        //const label = document.getElementById(`dgvProdGross${rowId}`);
        const input = document.getElementById(inputID);
        var value = netValue != "" ? netValue : 0;
        input.setAttribute('txttag', parseFloat(value).toFixed(4));
        input.value = parseFloat(value).toFixed(DecVal);
        input.title = netValue;
    }
    $(".txtsettag").focusin(function (e) {
        var id = e.target.id;
        const val = document.getElementById(id).getAttribute("txttag");
        $("#" + id).val(val);
        $("#" + id).select();
    });
    $(".txtsettag").blur(function (e) {
        var val = e.target.value;
        var id = e.target.id;
        updateInputColumn(id, val);
    });
    var modal = new bootstrap.Modal(document.getElementById('myModalfg')); //document.getElementById("myModalfg");
    $("#myModalfg").on("shown.bs.modal", function () {
        $("#txtAccName").focus();
    });
    //~Close
    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.hide();
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".FormclrField").val("");
        $("#cmbBank").val(0)
        $("#hdnAccGrpID").val(0);
        $("#chkDefault").prop("checked", false);
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", TransMode != 2);
        $(".clrdiv").html("");
        $("#txtAccName").focus();
        $("#lblCloseOS").text("");
        $("#cmbBranch").val(0);
        $("#cmbFAType,#txtOpenBal").prop("disabled", true);
        $("#cmbBranch").prop("disabled", TransMode == 1);
        SetTagZero();
        if (TransMode != 1)
            modal.hide();
    }
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        //~Validation
        var IsValid = true, ChkFormation = true;
        if ($("#txtAccGrp").val() == "") {
            IsValid = false;
            $("#dvErrorAccGrp").html("Account Group should not be empty");
            showErrorSnackbar("Account Group should not be empty");
        }
        else {
            const exists = arrAccGrp.filter(acc => acc.label == $("#txtAccGrp").val().trim());
            if (exists.length == 0) {
                IsValid = false;
                $("#dvErrorAccGrp").html("Account Group select from list");
                showErrorSnackbar("Account Group select from list");
            }
        }
        if ($("#txtAccName").val() == "") {
            IsValid = false;
            $("#dvErrorAccName").html("Account Name should not be empty");
            showErrorSnackbar("Account Name should not be empty");
        }
        ChkFormation = SACValidation($("#txtSAC"), $("#dvErrorSAC"));
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = PANValidation($("#txtPAN"), $("#dvErrorPAN"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var lstMaster = {
            "Mode": TransMode,
            "ID": $("#txtID").val(),
            "FaGroup": $("#txtAccGrp").val(),
            "AccountName": $("#txtAccName").val(),
            "OpenBalance": $("#txtOpenBal").val() != "" ? document.getElementById("txtOpenBal").getAttribute("txttag") : 0,
            "SACCode": $("#txtSAC").val(),
            "PAN": $("#txtPAN").val(),
            "FAType": $("#cmbFAType").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID,
            "UserAccount": 1
        };
        $.ajax({
            url: Aurl + "financialaccount/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        ClearForm();
                        AllFAData();
                        GetData(3);
                        modal.hide();
                    }
                    else if (items.Message == "OSPending") {
                        //$("#divErrorOnName").html("Outstanding Amount Pending. Cannot Deactivate");
                        showErrorSnackbar("Outstanding Amount Pending. Cannot Deactivate");
                    }
                    else {
                        $("#dvErrorAccName").html(items.Message);
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }

