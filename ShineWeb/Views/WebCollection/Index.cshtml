    #tblCollectionData tbody tr {
        transition: all 0.2s ease;
    }

        #tblCollectionData tbody tr:hover {
            background: #f8fbff;
            transform: scale(1.01);
        }
    .row-error {
        color: red !important;
        font-weight: 500;
    }

    .row-success {
        color: green !important;
        font-weight: 500;
    }
    .stsOpen{
        background-color:slateblue;
        border-radius:10px;
        font-weight:600;
        font-size:11px;
        padding:1px 5px;
        color:white;
    }
    .stsCancel {
        background-color: orangered;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }
    .stsClose {
        background-color: darkgreen;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }
</style>
