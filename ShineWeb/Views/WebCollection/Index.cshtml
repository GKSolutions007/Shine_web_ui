@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/datatable/1.13.6/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/datatable/1.13.6/jquery.dataTables.min.js"></script>
<script src="~/datatable/1.13.6/dataTables.bootstrap5.min.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>

<style>
    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    th, td {
        white-space: nowrap;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .modalBatch {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
    }

    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto;
            padding: 2px;
            border: 1px solid #888;
            width: 75%;
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto;
            padding: 2px;
            border: 1px solid #888;
            width: 95%;
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }

    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }


    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            .tab button:hover {
                background-color: #ddd;
            }

            .tab button.active {
                background-color: #ccc;
            }

    .tabcontent {
        display: none;
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -50%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -18%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }

    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }   
    #tblCollectionData tbody tr {
        transition: all 0.2s ease;
    }
        #tblCollectionData tbody tr:hover td {
            background-color: #c9defa !important;
        }
        /*#tblCollectionData tbody tr:hover {            
            transform: scale(1.01);
        }*/
    .row-error {
        color: red !important;
        font-weight: 500;
    }

    .row-success {
        color: green !important;
        font-weight: 500;
    }
    .stsOpen{
        background-color:slateblue;
        border-radius:10px;
        font-weight:600;
        font-size:11px;
        padding:1px 5px;
        color:white;
    }
    .stsCancel {
        background-color: orangered;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }
    .stsClose {
        background-color: darkgreen;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }
    .highlight-error-row td {
        background-color: #fb5767 !important;
        color: #fff;
    }
    .highlight-success-row td {
        background-color: #81ad4f !important;
        color: #fff;
    }
</style>
<body>
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAdd" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>
    <div class="row">        
        <div class="container-fluid">
            <div class="row g-2 align-items-end">
                <!-- Beat -->
                <div class="col-12 col-md-2 col-lg-2">
                    <span class="form-label w-100">
                        <select class="form-control FormclrcmbField" id="cmbBeatName">
                            <option value="0">Select</option>
                        </select>
                        <label class="labelup">Beat</label>
                    </span>
                    <div class="text-danger pt-1 ps-1" id="divErrBeat"></div>
                </div>
                <!-- Salesman -->
                <div class="col-12 col-md-2 col-lg-2">
                    <span class="form-label w-100">
                        <select class="form-control FormclrcmbField" id="cmbSalesManName">
                            <option value="0">Select</option>
                        </select>
                        <label class="labelup">Salesman</label>
                    </span>
                    <div class="text-danger pt-1 ps-1" id="divErrSalesman"></div>
                </div>
                <!-- Customer -->
                <div class="col-12 col-md-3 col-lg-3">
                    <span class="form-label w-100">
                        <input hidden id="txtCustomerID" class="FormclrField" />
                        <input class="form-control FormclrField" id="txtCustomer" />
                        <label class="labelup">Customer</label>
                    </span>
                    <div class="text-danger pt-1 ps-1" id="divErrCustomer"></div>
                </div>
                <!-- Payment Mode -->
                <div class="col-12 col-md-1 col-lg-1">
                    <span class="form-label w-100">
                        <select class="form-control FormclrcmbField" id="cmbPaymode">
                            <option value="0">Select</option>
                        </select>
                        <label class="labelup">Payment <span class="textforabv800">Mode</span></label>
                    </span>
                    <div class="text-danger pt-1 ps-1" id="divErrPaymode"></div>
                </div>

                <!-- Cheque Date -->
                <div class="col-12 col-md-1 col-lg-1">
                    <span class="form-label w-100">
                        <input class="clsdtpfieldfull FormclrField"
                               type="date"
                               id="dtpChequeDate"
                               style="font-size:14px" />
                        <label class="labelup"><span class="textforabv800">Cheque Date</span><span class="textforblw800">Cq Date</span></label>
                    </span>
                    <div class="text-danger pt-1 ps-1" id="divErrChequeDate"></div>
                </div>
                <div class="col-12 col-md-3 d-flex flex-wrap align-items-center gap-2">

                    <!-- Checkbox 1 -->
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="chkAllowDate">
                        <label class="form-check-label" for="chkAllowDate">
                            Allow Date
                        </label>
                    </div>

                    <!-- Checkbox 2 -->
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="chkShowAll">
                        <label class="form-check-label" for="chkShowAll">
                            Show All
                        </label>
                    </div>

                    <!-- Filter Button -->
                    <div class="flex-grow-1 flex-md-grow-0">
                        <button id="btnFilter" class="btn btn-primary w-100">
                            <i class="bi bi-funnel-fill"></i> <span class="textforabv800">Filter</span>
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>   
    <div class="row mt-4">

        <div class="col-12 pb-4">

            <div class="table-responsive">

                <table class="table table-bordered table-striped align-middle"
                       id="tblCollectionData"
                       style="width:100%; border:1px solid #dee2e6;">

                    <thead class="table-light">

                        <!-- Summary Row -->
                        <tr>

                            <th colspan="9" class="text-center" style="letter-spacing:0.75px;text-align:center !important">
                                Cash ₹ :
                                <label id="lblCash" style="font-size:16px"
                                       class="lblPMValuecount fw-bold text-danger">
                                    0.00 / 0
                                </label>
                            </th>

                            <th colspan="7" class="text-center" style="letter-spacing: 0.75px; text-align: center !important">
                                Cheque ₹ :
                                <label id="lblCheque" style="font-size:16px"
                                       class="lblPMValuecount fw-bold text-danger">
                                    0.00 / 0
                                </label>
                            </th>

                            <th colspan="6" class="text-center" style="letter-spacing: 0.75px; text-align: center !important">
                                Bank Transfer ₹ :
                                <label id="lblBankTransfer" style="font-size:16px"
                                       class="lblPMValuecount fw-bold text-danger">
                                    0.00 / 0
                                </label>
                            </th>

                        </tr>

                        <!-- Column Headers -->
                        <tr class="text-center small">

                            <th style="width:0%" class="trclrforcolheader">ID</th>
                            <th style="width:0%" class="trclrforcolheader">EncID</th>
                            <th style="width:0%" class="trclrforcolheader">StatusID</th>
                            <th style="width:3%" class="trclrforcolheader">
                                <input id="chkSelectAll" type="checkbox" />
                            </th>

                            <th style="width:3%" class="trclrforcolheader">Action</th>
                            <th style="width:2%" class="trclrforcolheader">#</th>
                            <th style="width:10%" class="trclrforcolheader">Date</th>
                            <th style="width:12%" class="trclrforcolheader">Beat</th>
                            <th style="width:12%" class="trclrforcolheader">Salesman</th>
                            <th style="width:16%" class="trclrforcolheader">Customer</th>
                            <th style="width:12%" class="trclrforcolheader">Payment Mode</th>
                            <th style="width:10%" class="trclrforcolheader">Invoice ₹</th>
                            <th style="width:10%" class="trclrforcolheader">Amount</th>
                            <th style="width:10%" class="trclrforcolheader">Adj ₹</th>
                            <th style="width:10%" class="trclrforcolheader">Disc ₹</th>
                            <th style="width:10%" class="trclrforcolheader">Other ₹</th>
                            <th style="width:10%" class="trclrforcolheader">Balance</th>
                            <th style="width:10%" class="trclrforcolheader">Status</th>
                            <th style="width:10%" class="trclrforcolheader">Cheque Date</th>
                            <th style="width:10%" class="trclrforcolheader">Ref/Cheque No</th>
                            <th style="width:10%" class="trclrforcolheader">Remarks</th>
                            <th style="width:10%" class="trclrforcolheader">Narration</th>

                        </tr>

                    </thead>

                </table>

            </div>

        </div>

    </div>   
    <div class="footerAction modal-footer">

        <div class="d-flex justify-content-between align-items-center w-100 p-2">

            <!-- Left Corner -->
            <button type="button" class="btn btn-warning" id="btnCancel">
                <i class="bi bi-x-circle"></i> Cancel
            </button>

            <!-- Right Corner -->
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-danger" id="btnClear">
                    <span class="glyphicon glyphicon-refresh"> Clear</span>
                </button>

                <button type="button" class="btn btn-success" id="btnSave">
                    <span class="glyphicon glyphicon-saved"> Save</span>
                </button>
            </div>

        </div>

    </div>    
    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">

        <div class="modal-dialog modal-xl">

            <div class="modal-content modalBatch-content">

                <!-- Modal Header -->
                <div class="modal-header text-white" style="background-color:#0d6efd;">

                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Invoices
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

                </div>


                <!-- Modal Body -->
                <div class="modal-body">

                    <div class="table-responsive">

                        <table class="table table-bordered table-striped align-middle"
                               id="tblInvoiceData"
                               style="width:100%;">

                            <thead class="text-center small">

                                <tr>
                                    <th style="width:2%" class="trclrforcolheader">#</th>
                                    <th style="width:10%" class="trclrforcolheader">Doc ID</th>
                                    <th style="width:10%" class="trclrforcolheader">Date</th>
                                    <th style="width:15%" class="trclrforcolheader">Ref No</th>
                                    <th style="width:10%" class="trclrforcolheader">Invoice Value</th>
                                    <th style="width:10%" class="trclrforcolheader">Balance</th>
                                    <th style="width:10%" class="trclrforcolheader">Adjust ₹</th>
                                    <th style="width:10%" class="trclrforcolheader">Other Charge</th>
                                    <th style="width:10%" class="trclrforcolheader">Discount %</th>
                                    <th style="width:10%" class="trclrforcolheader">Discount ₹</th>
                                </tr>

                            </thead>

                        </table>

                    </div>

                </div>


                <!-- Modal Footer -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-warning"
                            id="btnPopupClose"
                            data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Close
                    </button>

                </div>

            </div>

        </div>

    </div>
</body>

<script type="text/javascript">
    var CollectionTable = $('#tblCollectionData').DataTable({
        paging: false,
        searching: false,
        info: false,
        ordering: true,
        scrollY: "450px",
        scrollX: true,
        scrollCollapse: true,
        order: [[1, 'asc']],
        "columnDefs": [{ "targets": [0,2], "visible": false, searchable: false, ordering: false }, { "targets": [1], "class": "text-center" }]
    });
    var InvoiceTable = $('#tblInvoiceData').DataTable({
        paging: false,
        searching: false,
        info: false,
        ordering: true,
        scrollY: "350px",
        scrollX: true,
        scrollCollapse: true,
        //"columnDefs": [{ "targets": [0], "visible": false, searchable: false, ordering: false }, { "targets": [1], "class": "text-center" }]
    });

    var UID = '@Session["LoginUserID"]';
    var Aurl = '@Session["APIurl"]';
    var DecVal = '@Session["DecimalValues"]';
    var DefBranch = '@Session["DefaultBranch"]';
    var AllowPCD = '@Session["AllowPostChequeDaysColl"]';
    var itemorderby = '@Session["ItemOrderby"]';
var EnableALStartWith = '@Session["ALSearchstartwith"]' == "1";
var autolistfilterwith = EnableALStartWith;
var startwithfield = itemorderby == "1" ? "code" : itemorderby == "2" ? "name" : "search";
    var BatchMode = 0;
    var nTransMode = 1, nIsDraft = 0;
    //GetData(1);
    var RtnDisp = 1;
    var modal = new bootstrap.Modal(document.getElementById('myModalfg'));//document.getElementById("myModalfg");

    $('#btnPopupClose').click(function (e) {
        //modal.style.display = "none";
        modal.hide();
    });
    document.getElementById('myModalfg')
        .addEventListener('shown.bs.modal', function () {
            if (InvoiceTable) InvoiceTable.columns.adjust().draw();
        });
    if ($("#txtReurnPricePerm").val() == 0) {
        RtnDisp = 0;
    }
    $('input[type=number]').focusin(function (e) {
        $(this).select();
    });
    if ($("#txtAdd").val() == "0"){
        $("#btnSave,#btnCancel").hide()
    }
    setTodayDate();
    function setTodayDate() {
        var dt = new Date()
        const formatted = dt.toISOString().split('T')[0];
        $("#dtpChequeDate").val(formatted);
    }
    var EditRowID = -1;
    GetData(1, "");
    GetFilterData(2);
    GetFilterData(3);
    var arrParty = [];
    //~Preload Data
    function GetData(nMode, strID = null,stsid = null) {
        $.ajax({
            url: Aurl + "webcollection/getdata",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, ID: strID, UserID: UID,Status:stsid },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    arrParty = [];
                    $('#cmbBeatName,#cmbSalesManName,#cmbPaymode').find("option").remove();
                    $('#cmbBeatName,#cmbSalesManName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $('#cmbPaymode').append($('<option/>', {
                        value: 0,
                        text: "All",
                    }));
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            $('#cmbSalesManName').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 2) {
                            $('#cmbBeatName').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 3) {
                            var al = {
                                "label": items.Code + " | " + items.Name,
                                "name": items.Name,
                                "code": items.Code,
                                "id": items.ID,
                            }
                            arrParty.push(al);
                        }
                        if (items.FType == 4) {
                            $('#cmbPaymode').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }

                    });
                    //~AutoList
                    PaginatedAutocomplete({
                        inputId: "txtCustomer",
                        data: arrParty,
                        startwitfieldname: startwithfield,
                        enablefilterstartwith: autolistfilterwith,
                        onSelect: function (item) {
                            $("#txtCustomer").val(item.name);
                            $("#txtCustomerID").val(item.id);
                            return false;
                        }
                    });
                }
                else if (nMode == 4) {
                    showSuccessSnackbar("Cancelled successfully");
                    GetFilterData(2);
                    GetFilterData(3);
                }
                else if (nMode == 5) {
                    $("#btnSave").prop("disabled", false);
                    $("#tblCollectionData tbody tr").css("color", "black").attr("title", "");
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                        }
                        else {
                            var ErrorIDs = items.RowID.split(',');
                            var ErrorMSGs = items.Message.split(',');
                            for (var i = 0; i < ErrorIDs.length; i++) {
                                var WCID = ErrorIDs[i];
                                var WCErrorMsg = ErrorMSGs[i];
                                if (WCID != "") {
                                    $("#tblCollectionData tbody tr").each(function () {
                                        var rowdata = CollectionTable.row($(this)).data();
                                        var isChk = $(this).find('input[type=checkbox]').is(':checked');
                                        var CustomerName = rowdata.CustomerName;
                                        if (WCID == rowdata.ID) {
                                            //$(this).css('color','red').attr("title", WCErrorMsg);
                                            $(this).find("td").css("color", "red").attr("title", WCErrorMsg);
                                        }
                                        else if (isChk) {
                                            //$(this).css('color', 'green').attr("title", "Saved Successfully");
                                            $(this).find("td").css("color", "green").attr("title", "Saved Successfully");
                                        }
                                    });
                                }
                                if (ErrorIDs.length == (i + 1)) {
                                    var errorCount = ErrorIDs.filter(id => id !== "").length;
                                    if (errorCount > 0) {
                                        showErrorSnackbar(errorCount + " records have errors. Hover on red rows for details.");
                                    }
                                }
                            }

                        }
                    });

                }
                else if (nMode == 8) {
                    InvoiceTable.draw().clear();
                    $.each(data, function (i, items) {
                        InvoiceTable.row.add([
                            (i+1),
                            items.Docid,
                            items.Docdate,
                            items.Refno,
                            items.NetAmt,
                            items.Balance,
                            items.Amtadj,
                            items.Ohtercharges,
                            items.DiscPern,
                            items.DiscAmt
                        ]).draw(false);
                    });
                }
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $("#txtCustomer").change(function (e) {
        $("#txtCustomerID").val("");
    });

    function GetFilterData(nMode) {//arrVendorName,divErrFTo,divErrFFrom,divErrFParty
        var IsValid = true;
        $(".clrdivs").html("");
        //rdoCustomer,rdoProduct
        if (nMode == 3) // for filter
        {
            if ($("#txtCustomer").val() != "") {
                var pd = arrParty.filter(t => t.name == $("#txtCustomer").val().trim());
                const exists = pd.length > 0;
                if (!exists) {
                    IsValid = false;
                    $("#divErrCustomer").html("Select Customer Name from list");
                }
            }
        }
        else if (nMode == 2)// for label value
        {
