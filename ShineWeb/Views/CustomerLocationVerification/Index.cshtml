    // ---------- Image preview modal ----------
    // Cache of already-fetched images, keyed by CustomerID, so re-opening the
    // same row's image doesn't call the server again.
    var customerimage = [];

    $(document).on('click', '.btnViewImage', function () {
        var customerId = $(this).data('id');

        $('#mdaImageModalBody').html('<div class="mda-image-status"><i class="fa fa-spinner fa-spin"></i>Loading image...</div>');
