    function SaveCustomerLocationAction(Mode, LocationID, Remarks) {
        $.ajax({
            url: Aurl + "customermaster/CustomerLocationVerificationSave?mode=" + Mode + "&id=" + LocationID + "&userId=" + UID + "&remarks=" + encodeURIComponent(Remarks || ''),
            type: 'POST',
            dataType: 'json',
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == "0" || items.Status == "Success") {
                        if (Mode == 2) {
                            showSuccessSnackbar("Approved Successfully.!!!");
                        } else {
                            showSuccessSnackbar("Rejected Successfully.!!!");
                        }
                        setTimeout(() => {
                            InitiateData();
                        }, 300);
                    } else {
                        showErrorPopup(items.Message || "Operation failed.");
                    }
                });
            },
            error: function (xhr, status, error) {
                console.error("Error saving status:", error);
                showErrorSnackbar("An error occurred while saving.");
            }
        });
    }
