        var mdaImageModal = bootstrap.Modal.getOrCreateInstance(mdaImageModalEl);
        mdaImageModal.show();

        $.ajax({
            url: Aurl + "customermaster/CustomerLocationImage",
            type: 'GET',
            dataType: 'json',
            data: { CustomerID: customerId },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                RenderCustomerImage(data);
            },
            error: function (xhr, status, error) {
                console.error("Error loading customer image:", error);
                $('#mdaImageModalBody').html('<div class="mda-image-status"><i class="fa fa-exclamation-triangle"></i>Failed to load image.</div>');
            }
