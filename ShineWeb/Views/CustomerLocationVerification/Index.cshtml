    // Renders the CommonImagedata array (FileName, FileSize, CompressImageData)
    // as a gallery of thumbnails inside the popup. Hovering an image zooms it in.
    function RenderCustomerImage(images) {
        if (!images || !images.length) {
            $('#mdaImageModalBody').html('<div class="mda-image-status"><i class="fa fa-exclamation-triangle"></i>No image found for this customer.</div>');
            return;
        }

        var html = '<div class="mda-zoom-container">'
            + '<div class="mda-zoom-thumb-wrap" id="mdaZoomThumbWrap">'
            + '<img id="mdaZoomImg" src="" alt="" />'
            + '<div class="mda-zoom-lens" id="mdaZoomLens"></div>'
            + '</div>'
            + '<div class="mda-zoom-result" id="mdaZoomResult"></div>'
            + '</div>'
            + '<div class="mda-zoom-meta" id="mdaZoomMeta"></div>';

        if (images.length > 1) {
            html += '<div class="mda-zoom-thumbs-row" id="mdaZoomThumbsRow"></div>';
        }

        $('#mdaImageModalBody').html(html);

        // Normalize each image's src/fileName/fileSize once
        var normalized = $.map(images, function (img, i) {
            var raw = img.CompressImageData || img.ImgData || '';
            var src = (raw.indexOf('data:image') === 0) ? raw : ('data:image/jpeg;base64,' + raw);
            return {
                src: src,
                fileName: img.FileName || ('Image ' + (i + 1)),
                fileSize: img.FileSize || ''
            };
        });

        SetActiveZoomImage(normalized[0]);
        InitZoom();

        if (normalized.length > 1) {
            var rowHtml = '';
            $.each(normalized, function (i, item) {
                rowHtml += '<div class="mda-zoom-thumb-small' + (i === 0 ? ' active' : '') + '" data-index="' + i + '">'
                    + '<img src="' + item.src + '" alt="' + item.fileName + '" />'
                    + '</div>';
            });
            $('#mdaZoomThumbsRow').html(rowHtml);

            $('#mdaZoomThumbsRow').on('click', '.mda-zoom-thumb-small', function () {
                var idx = $(this).data('index');
                $('#mdaZoomThumbsRow .mda-zoom-thumb-small').removeClass('active');
                $(this).addClass('active');
                SetActiveZoomImage(normalized[idx]);
            });
        }
    }

    function SetActiveZoomImage(item) {
        $('#mdaZoomImg').attr('src', item.src).attr('alt', item.fileName);
        $('#mdaZoomResult').css('background-image', 'url(' + item.src + ')');
        $('#mdaZoomMeta').html('<strong>' + item.fileName + '</strong>' + (item.fileSize ? ' &middot; ' + item.fileSize : ''));
    }

    // Sets up the lens-follow-cursor zoom interaction. Bound once per modal open
    // since the elements are freshly injected each time.
    function InitZoom() {
        var $wrap = $('#mdaZoomThumbWrap');
        var $img = $('#mdaZoomImg');
        var $lens = $('#mdaZoomLens');
        var $result = $('#mdaZoomResult');

        $wrap.off('mouseenter mousemove mouseleave');

        $wrap.on('mouseenter', function () {
            if (window.innerWidth <= 768) return; // skip on small screens
            $lens.show();
            $result.show();
        });

        $wrap.on('mouseleave', function () {
            $lens.hide();
            $result.hide();
        });

        $wrap.on('mousemove', function (e) {
            if (window.innerWidth <= 768) return;

            var wrapOffset = $wrap.offset();
            var wrapW = $wrap.width();
            var wrapH = $wrap.height();
            var lensW = $lens.width();
            var lensH = $lens.height();

            var x = e.pageX - wrapOffset.left - lensW / 2;
            var y = e.pageY - wrapOffset.top - lensH / 2;

            // Clamp lens inside the thumbnail bounds
            x = Math.max(0, Math.min(x, wrapW - lensW));
            y = Math.max(0, Math.min(y, wrapH - lensH));

            $lens.css({ left: x + 'px', top: y + 'px' });

            // Map lens position to the zoomed background position
            var resultW = $result.width();
            var resultH = $result.height();
            var ratioX = resultW / lensW;
            var ratioY = resultH / lensH;

            $result.css({
                backgroundSize: (wrapW * ratioX) + 'px ' + (wrapH * ratioY) + 'px',
                backgroundPosition: '-' + (x * ratioX) + 'px -' + (y * ratioY) + 'px'
            });
        });
    }

