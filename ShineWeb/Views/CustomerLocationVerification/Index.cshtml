    // ---------- Stat cards ----------
    function UpdateStatCards(rows) {
        rows = rows || [];
        var openCount = 0, approvedCount = 0, rejectedCount = 0;
        $.each(rows, function (i, item) {
            var sid = parseInt(item.StatusID, 10);
            if (sid === 1) openCount++;
