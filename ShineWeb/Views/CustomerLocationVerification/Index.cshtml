
@{
    ViewBag.Title = "Customer Location Verification";
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}

<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
@*<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">*@
<link href="~/Content/font-awesome.4.7.0.min.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/Validation.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/datatable.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>


<style>
    :root {
        --mda-primary: #4361ee;
        --mda-primary-dark: #3145c4;
        --mda-success: #2ec4b6;
        --mda-warning: #ff9f1c;
        --mda-danger: #e5383b;
        --mda-bg: #f4f6fb;
        --mda-card-radius: 14px;
    }

    #dvMainTable {
        animation: mdaFadeIn .45s ease both;
    }

    @@keyframes mdaFadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes mdaPop {
        0% {
            transform: scale(.85);
            opacity: 0;
        }

        60% {
            transform: scale(1.05);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes mdaPulseIcon {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.12);
        }
    }

    @@keyframes mdaShake {
        10%, 90% {
            transform: translateX(-1px);
        }

        20%, 80% {
            transform: translateX(2px);
        }

        30%, 50%, 70% {
            transform: translateX(-4px);
        }

        40%, 60% {
            transform: translateX(4px);
        }
    }

    @@keyframes mdaRowIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---------- Header ---------- */
    .mda-top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .mda-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 6px;
    }

        .mda-header .mda-header-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--mda-primary), var(--mda-primary-dark));
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 4px 10px rgba(67, 97, 238, .3);
        }

        .mda-header h4 {
            font-size: 16px !important;
            font-weight: 600;
            margin: 0;
            color: #2b2d42;
            letter-spacing: .2px;
        }

    /* ---------- Stat cards ---------- */
    .mda-stats-row {
        display: flex;
        align-items: stretch;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 10px;
    }

    @@media (max-width: 900px) {
        .mda-stats-row {
            justify-content: flex-start;
            width: 100%;
        }
    }

    @@media (max-width: 480px) {
        .mda-stats-row {
            flex-direction: column;
            width: 100%;
        }
    }

    .mda-stat-card {
        position: relative;
        background: #fff;
        border-radius: 10px;
        padding: 7px 12px;
        width: 125px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 8px rgba(20, 25, 60, .06);
        border: 1px solid #eef0f7;
        overflow: hidden;
        animation: mdaPop .4s ease both;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .mda-stat-card:nth-child(1) {
            animation-delay: .02s;
        }

        .mda-stat-card:nth-child(2) {
            animation-delay: .08s;
        }

        .mda-stat-card:nth-child(3) {
            animation-delay: .14s;
        }

        .mda-stat-card:nth-child(4) {
            animation-delay: .2s;
        }

        .mda-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(20, 25, 60, .12);
        }

        .mda-stat-card::before {
            content: "";
            position: absolute;
            inset: 0;
            opacity: .05;
            background: var(--mda-card-accent, var(--mda-primary));
        }

    .mda-stat-icon {
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        color: #fff;
        background: var(--mda-card-accent, var(--mda-primary));
        transition: transform .25s ease;
    }

    .mda-stat-card:hover .mda-stat-icon {
        animation: mdaPulseIcon .6s ease;
    }

    .mda-stat-body {
        display: flex;
        flex-direction: column;
        z-index: 1;
    }

    .mda-stat-label {
        font-size: 9.5px;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #8a8fa3;
        font-weight: 600;
        line-height: 1.2;
    }

    .mda-stat-value {
        font-size: 15px;
        font-weight: 700;
        color: #23263a;
        line-height: 1.15;
    }

    .mda-card-limit {
        --mda-card-accent: #4361ee;
    }

    .mda-card-total {
        --mda-card-accent: #7209b7;
    }

    .mda-card-active {
        --mda-card-accent: #2ec4b6;
    }

    .mda-card-deactive {
        --mda-card-accent: #e5383b;
    }

    .mda-card-open {
        --mda-card-accent: #ff9f1c;
    }

    /* ---------- Table ---------- */

    #tblCustomerLocation_wrapper {
        animation: mdaFadeIn .5s ease .1s both;
    }

    table.dataTable.table-bordered {
        border-radius: 10px;
        overflow: hidden;
        border-collapse: separate !important;
        border-spacing: 0;
    }

    /* Header layout: sticky, bolder, spaced-out caps */
    .trclrforcolheader th {
        background: linear-gradient(135deg, var(--mda-primary), var(--mda-primary-dark));
        color: #fff;
        border-bottom: none !important;
        font-size: 12px !important;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: 5px 10px !important;
        white-space: nowrap;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Table body font size */
    #tblCustomerLocation {
        font-size: 14px;
        border-collapse: collapse !important;
    }

        #tblCustomerLocation tbody td {
            /* padding: 10px 10px !important;*/
            vertical-align: middle;
            font-size: 13px;
            border: 1px solid #e3e6f0 !important;
        }

        #tblCustomerLocation thead th {
            border: 1px solid #3145c4 !important;
        }

        #tblCustomerLocation tbody tr {
            animation: mdaRowIn .3s ease both;
            transition: background-color .15s ease;
        }

            /* Zebra striping for odd / even rows.
               DataTables adds .odd / .even classes to every row it renders (this
               survives paging/scrolling/redraws), so we target those directly in
               addition to :nth-child as a fallback. !important guards against
               Bootstrap's per-cell "table > :not(caption) > * > *" background rule
               and the bundled DataTables stylesheet both outranking a plain rule. */
            #tblCustomerLocation tbody tr.odd,
            #tblCustomerLocation tbody tr:nth-child(odd) {
                background-color: #fcecec !important;
            }

                #tblCustomerLocation tbody tr.odd > td,
                #tblCustomerLocation tbody tr:nth-child(odd) > td {
                    background-color: #fcecec !important;
                }

            #tblCustomerLocation tbody tr.even,
            #tblCustomerLocation tbody tr:nth-child(even) {
                background-color: #f4f6fb !important;
            }

                #tblCustomerLocation tbody tr.even > td,
                #tblCustomerLocation tbody tr:nth-child(even) > td {
                    background-color: #f4f6fb !important;
                }

            #tblCustomerLocation tbody tr:hover,
            #tblCustomerLocation tbody tr:hover > td {
                background-color: #dfe4ff !important;
            }

    /* ---------- Status info icon / tooltip ---------- */
    .mda-status-tooltip-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
        line-height: 1;
        cursor: help;
    }

    .mda-status-info {
        font-size: 13px;
        color: inherit;
        opacity: .8;
        transition: opacity .2s ease, transform .2s ease;
    }

    .mda-status-tooltip-wrap:hover .mda-status-info {
        opacity: 1;
        transform: scale(1.2) rotate(8deg);
    }

    .mda-tooltip {
        position: absolute;
        bottom: calc(100% + 11px);
        left: 50%;
        min-width: 190px;
        background: linear-gradient(135deg, #2b2d42, #23263a);
        color: #fff;
        padding: 10px 13px;
        border-radius: 10px;
        font-size: 11.5px;
        font-weight: 500;
        text-transform: none;
        letter-spacing: normal;
        text-align: left;
        box-shadow: 0 12px 28px rgba(20, 25, 60, .28);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translate(-50%, 6px) scale(.9);
        transform-origin: bottom center;
        transition: opacity .2s ease, transform .2s cubic-bezier(.34, 1.56, .64, 1), visibility .2s;
        z-index: 30;
    }

        .mda-tooltip::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 6px solid transparent;
            border-top-color: #23263a;
        }

    .mda-status-tooltip-wrap:hover .mda-tooltip {
        opacity: 1;
        visibility: visible;
        transform: translate(-50%, 0) scale(1);
    }

    .mda-tooltip-row {
        display: flex;
        align-items: center;
        gap: 7px;
        line-height: 1.6;
        white-space: nowrap;
    }

        .mda-tooltip-row + .mda-tooltip-row {
            margin-top: 3px;
        }

        .mda-tooltip-row i {
            font-size: 11px;
            color: #6fe3d4;
            width: 12px;
            text-align: center;
        }

    /* ---------- Image gallery popup ---------- */
    .mda-image-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
        text-align: left;
    }

    .mda-image-card {
        border: 1px solid #eef0f7;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 2px 8px rgba(20, 25, 60, .06);
        transition: box-shadow .2s ease;
        animation: mdaPop .3s ease both;
    }

        .mda-image-card:hover {
            box-shadow: 0 8px 18px rgba(20, 25, 60, .16);
        }

    .mda-image-zoom-wrap {
        overflow: hidden;
        height: 260px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4f6fb;
        position: relative;
    }

    /* The pre-existing ".mda-image-modal .modal-body img" rule applies the
           mdaPop entrance animation with fill-mode "both", which keeps forcing
           transform back to its own end-keyframe value and silently blocks any
           hover transform set elsewhere. Explicitly cancel it here so the zoom
           transition below actually takes effect. */
    .mda-image-modal .modal-body .mda-image-zoom-wrap img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        animation: none !important;
        box-shadow: none;
        border-radius: 0;
        transform: scale(1);
        transform-origin: center center;
        transition: transform .35s ease;
        cursor: zoom-in;
        will-change: transform;
    }

    .mda-image-zoom-wrap:hover img {
        transform: scale(1.9);
    }

    .mda-image-meta {
        padding: 10px 12px;
    }

    .mda-image-name {
        font-size: 13px;
        font-weight: 600;
        color: #23263a;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mda-image-size {
        font-size: 11.5px;
        color: #8a8fa3;
        margin-top: 2px;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 768px) {
        .mda-header h4 {
            font-size: 15px !important;
        }

        #tblCustomerLocation, .trclrforcolheader th {
            font-size: 12.5px !important;
        }

            #tblCustomerLocation tbody td {
                font-size: 12.5px;
                padding: 8px 6px !important;
            }

        .mda-btn-icon {
            font-size: 11px;
            padding: 4px 8px;
        }
    }

    @@media (max-width: 480px) {
        .mda-header h4 {
            font-size: 14px !important;
        }

        .mda-header-icon {
            width: 28px;
            height: 28px;
            font-size: 14px;
        }

        #tblCustomerLocation, .trclrforcolheader th {
            font-size: 11.5px !important;
        }

            #tblCustomerLocation tbody td {
                font-size: 11.5px;
                padding: 6px 5px !important;
            }

        .mda-btn-icon {
            font-size: 10px;
            padding: 3px 6px;
            gap: 3px;
        }
    }

    .mda-btn-icon {
        border: none;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #fff;
        transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease;
    }

        .mda-btn-icon:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0,0,0,.15);
        }

        .mda-btn-icon:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .mda-btn-activate {
        background: linear-gradient(135deg, #2ec4b6, #21a99d);
    }

    .mda-btn-deactivate {
        background: linear-gradient(135deg, #e5383b, #c9262a);
    }

    /* ---------- Error popup modal ---------- */
    .mda-error-modal .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        animation: mdaShake .45s ease .1s both;
    }

    .mda-error-modal .modal-body {
        text-align: center;
        padding: 32px 26px 26px;
    }

    .mda-error-icon-wrap {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: rgba(229, 56, 59, .12);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: mdaPop .4s ease both;
    }

        .mda-error-icon-wrap i {
            font-size: 32px;
            color: var(--mda-danger);
        }

    .mda-error-title {
        font-size: 17px;
        font-weight: 700;
        color: #23263a;
        margin-bottom: 6px;
    }

    .mda-error-message {
        font-size: 13.5px;
        color: #6c7086;
        margin-bottom: 0;
    }

    .mda-error-modal .modal-footer {
        border-top: none;
        justify-content: center;
        padding-bottom: 26px;
    }

    .mda-error-modal .btn-close-error {
        background: linear-gradient(135deg, var(--mda-danger), #c9262a);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 26px;
        font-weight: 600;
        font-size: 13px;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .mda-error-modal .btn-close-error:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(229, 56, 59, .35);
        }

    /* ---------- Location / Image link buttons ---------- */
    .mda-link-btn {
        border: none;
        background: transparent;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        font-size: 12.5px;
        padding: 5px 10px;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        transition: transform .15s ease, background-color .15s ease, box-shadow .15s ease;
    }

        .mda-link-btn:hover {
            transform: translateY(-1px);
            text-decoration: none;
        }

    .mda-link-location {
        color: #1c8f84;
        background: rgba(46, 196, 182, .12);
    }

        .mda-link-location:hover {
            background: rgba(46, 196, 182, .22);
            box-shadow: 0 4px 10px rgba(46, 196, 182, .25);
        }

    .mda-link-image {
        color: #3145c4;
        background: rgba(67, 97, 238, .1);
    }

        .mda-link-image:hover {
            background: rgba(67, 97, 238, .2);
            box-shadow: 0 4px 10px rgba(67, 97, 238, .25);
        }

    .mda-empty-cell {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #adb0c0;
        font-size: 12.5px;
        font-style: italic;
    }

    /* ---------- Status badges ---------- */
    .mda-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 13px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        animation: mdaPop .35s ease both;
    }

    .mda-status-open {
        color: #c9740a;
        background: rgba(255, 159, 28, .15);
        animation: mdaPop .35s ease both, mdaStatusPulse 1.8s ease-in-out infinite;
    }

    .mda-status-approved {
        color: #1c8f84;
        background: rgba(46, 196, 182, .15);
    }

    .mda-status-rejected {
        color: #c9262a;
        background: rgba(229, 56, 59, .15);
    }

    @@keyframes mdaStatusPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(255, 159, 28, .45);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(255, 159, 28, 0);
        }
    }

    /* ---------- Remarks input ---------- */
    .mda-remarks-input {
        border-radius: 8px;
        border: 1px solid #dfe2ee;
        font-size: 12.5px;
        padding: 6px 10px;
        min-width: 160px;
        transition: box-shadow .15s ease, border-color .15s ease, background-color .15s ease;
    }

        .mda-remarks-input:focus {
            border-color: var(--mda-primary);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, .15);
            outline: none;
        }

        .mda-remarks-input[readonly] {
            background: #f4f6fb;
            color: #8a8fa3;
            cursor: not-allowed;
        }

    /* ---------- Approve / Reject action buttons ---------- */
    .mda-action-cell {
        display: flex;
        gap: 8px;
        flex-wrap: nowrap;
    }

    .mda-btn-approve {
        background: linear-gradient(135deg, #2ec4b6, #21a99d);
    }

    .mda-btn-reject {
        background: linear-gradient(135deg, #e5383b, #c9262a);
    }

    /* ---------- Image preview modal ---------- */
    .mda-image-modal .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        animation: mdaPop .35s ease both;
    }

    .mda-image-modal .modal-header {
        background: linear-gradient(135deg, var(--mda-primary), var(--mda-primary-dark));
        color: #fff;
        border: none;
    }

        .mda-image-modal .modal-header .btn-close {
            filter: invert(1);
        }

    .mda-image-modal .modal-header {
        position: relative;
        z-index: 1056;
    }

    .mda-image-modal .modal-body {
        text-align: center;
        padding: 22px;
        min-height: 160px;
    }

        .mda-image-modal .modal-body img {
            max-width: 100%;
            max-height: 65vh;
            border-radius: 10px;
            box-shadow: 0 6px 20px rgba(20, 25, 60, .18);
            animation: mdaPop .4s ease both;
        }

    .mda-image-status {
        padding: 34px 0;
        color: #8a8fa3;
        font-size: 13.5px;
    }

        .mda-image-status i {
            font-size: 28px;
            margin-bottom: 10px;
            display: block;
        }

            .mda-image-status i.fa-spinner {
                animation: mdaPulseIcon 1s ease infinite;
                color: var(--mda-primary);
            }

            .mda-image-status i.fa-exclamation-triangle {
                color: var(--mda-warning);
            }

    .toastBox {
        pointer-events: none;
    }
</style>
<style>
    /* ---------- Amazon-style hover zoom ---------- */
    .mda-zoom-container {
        display: flex;
        gap: 20px;
        align-items: flex-start;
        min-height: 480px;
    }

    .mda-zoom-thumb-wrap {
        position: relative;
        width: 420px;
        height: 480px;
        border: 1px solid #eef0f7;
        border-radius: 12px;
        overflow: hidden;
        cursor: crosshair;
        flex: 0 0 auto;
        background: #f4f6fb;
    }

        .mda-zoom-thumb-wrap img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

    .mda-zoom-lens {
        position: absolute;
        border: 2px solid var(--mda-primary);
        background: rgba(67, 97, 238, 0.15);
        width: 150px;
        height: 150px;
        pointer-events: none;
        display: none;
    }

    .mda-zoom-result {
        flex: 1 1 auto;
        min-width: 0;
        height: 480px;
        border: 1px solid #eef0f7;
        border-radius: 12px;
        background-repeat: no-repeat;
        background-color: #f4f6fb;
        display: none;
        box-shadow: 0 6px 20px rgba(20, 25, 60, .12);
    }

    .mda-zoom-thumbs-row {
        display: flex;
        gap: 10px;
        margin-top: 14px;
        flex-wrap: wrap;
    }

    .mda-zoom-thumb-small {
        width: 60px;
        height: 60px;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid transparent;
        cursor: pointer;
        flex: 0 0 auto;
        transition: border-color .15s ease;
    }

        .mda-zoom-thumb-small img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .mda-zoom-thumb-small.active {
            border-color: var(--mda-primary);
        }

