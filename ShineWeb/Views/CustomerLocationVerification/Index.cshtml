                                };
                                var statusId = parseInt(value.StatusID, 10);
                                var cfg = statusConfig[statusId] || { cls: '', icon: 'fa-question-circle', label: value.Status };

                                var infoMarkup = '';
                                // Info icon + custom animated tooltip, only for Approved (2) / Rejected (3).
                                // Label wording changes dynamically based on StatusID as required.
                                if (statusId === 2 || statusId === 3) {
                                    var byLabel = (statusId === 2) ? 'Approved By' : 'Rejected By';
                                    var timeLabel = (statusId === 2) ? 'Approved Time' : 'Reject Time';
                                    var byValue = (value.ApprovedOrRejectedBy && value.ApprovedOrRejectedBy !== 'NULL') ? value.ApprovedOrRejectedBy : '-';
                                    var timeValue = (value.ApproveorRejectTime && value.ApproveorRejectTime !== 'NULL') ? value.ApproveorRejectTime : '-';

                                    infoMarkup = '<span class="mda-status-tooltip-wrap">'
                                        + '<i class="fa fa-info-circle mda-status-info"></i>'
                                        + '<span class="mda-tooltip">'
                                        + '<span class="mda-tooltip-row"><i class="fa fa-user"></i><span>' + byLabel + ': ' + byValue + '</span></span>'
                                        + '<span class="mda-tooltip-row"><i class="fa fa-clock-o"></i><span>' + timeLabel + ': ' + timeValue + '</span></span>'
                                        + '</span>'
                                        + '</span>';
                                }

                                // Info icon is a flex-item INSIDE the badge itself, so it sits
                                // aligned with the badge text/icon rather than floating separately.
                                return '<span class="mda-status-badge ' + cfg.cls + '"><i class="fa ' + cfg.icon + '"></i> ' + cfg.label + infoMarkup + '</span>';
