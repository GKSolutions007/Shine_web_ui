    function ValidateOrder() {
        return true;
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        if (ValidateOrder()) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        } else {
            //alert("Order value should not be empty");
            showErrorSnackbar("Value should not be empty");
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");

        var fromDate = $("#txtFromDate").val();
        var toDate = $("#txtToDate").val();

        if (fromDate === "") {
            $("#dvErrorFromDate").html("From Date is mandatory");
            $("#txtFromDate").focus();
            $("#btnSave").prop("disabled", false);
            return;
        }
        if (toDate === "") {
            $("#dvErrorToDate").html("To Date is mandatory");
            $("#txtToDate").focus();
            $("#btnSave").prop("disabled", false);
            return;
        }
if(fromDate > toDate){
    showErrorSnackbar("From Date should be less than To Date");
    $("#btnSave").prop("disabled", false);
    return;
}
        var listdoc = [];
        var isValid = true;
        $("#tblMasterData tbody tr").each(function () {
            var strPrefix = "", strDocval = "";
            rowdata = Table.row($(this)).data();
            var nTrans = rowdata.ID;//[0];

            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                if (fieldName == "Prefix") {
                    strPrefix = $(this).val();
                }
                if (fieldName == "DocValue") {
                    strDocval = $(this).val();
                }
            });

            if (strPrefix === "" || strDocval === "") {
                isValid = false;
                $(this).css("background-color", "#ffdddd"); // Highlight invalid row
            } else {
                $(this).css("background-color", ""); // Reset background
            }

            var lst = {
                "ID": nTrans,
                "Prefix": strPrefix,
                "DocValue": strDocval
            }
            listdoc.push(lst);
        });

        if (!isValid) {
            showErrorSnackbar("Prefix and Doc Value are mandatory for all rows.");
            $("#btnSave").prop("disabled", false);
            return;
        }
        var lstMaster = {
            "Mode": nMode,
            "FromDate": fromDate,
            "ToDate": toDate,
            "orgFromDate": $("#txtOrgFromDate").val(),
            "orgToDate": $("#txtOrgToDate").val(),
            "UserID": UID,
            "lstDocSeries": listdoc
        };
        $.ajax({
            url: Aurl + "documentseries/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        modal.style.display = "none";
                        GetData(2);
                        //alert(items.Message);
                    }
                    else {
                        //$("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $('input, select ,button, textarea').on('keydown', function (e) {
        if (e.key === "Enter") {
            if (e.target.localName != "button") {
                e.preventDefault(); // Prevent default behavior
                var nextinp = $('input,select,button, textarea').eq($('input,select,button, textarea').index(this) + 1);
                if (nextinp.length) {
                    if (nextinp[0].disabled) {
                        nextinp = $('input,select,button, textarea').eq($('input,select,button, textarea').index(this) + 2);
                    }
                    nextinp.focus();
                    nextinp.select();
                }
            }
        }
        if (e.shiftKey && e.which == 13) {
            e.preventDefault();
            var $canfocus = $(':focusable');
            var index = $canfocus.index(this) - 1;
            if (index >= $canfocus.length) index = 0;
            $canfocus.eq(index).focus();
        }
    });
    function GetColumnSettingsData(nMode, nFormID, nTableID) {
        $.ajax({
            url: Aurl + "columnsettings/getcolumnsettings",
            /*url: "http://localhost:44396/api/singlemaster/get",*/
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, FormID: nFormID, TableID: nTableID, FormorReport: 0 },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                if (data.length > 0) {
                    columns = (data);
                    columns.push(actions);
                } else {
                    showErrorSnackbar("No column data found");
                }
            }
        });
    }
</script>