@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
}
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/Snackbar.css" rel="stylesheet" />
@*<link rel="stylesheet" href="~/Content/jquery-ui.css">*@
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />

<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<style>
    table.dataTable tfoot th, table.dataTable tfoot td {
        text-align: right !important;
    }

    table.dataTable thead th, table.dataTable thead td {
        text-align: left !important;
    }
    each {
        border-bottom: 1px solid #555;
        padding: 3px 0;
    }

    .acItem .name {
        font-size: 14px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .acItem .desc {
        font-size: 10px;
        font-family: Arial, Helvetica, sans-serif;
        color: #555;
    }

    .ui-autocomplete {
        max-height: 245px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none;
        position: fixed;
        z-index: 200;
        left: 0;
        top: 30px;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        animation: fadeIn 0.3s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes zoomIn {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modalBatch-content {
        background-color: #ffffff;
        margin: 2% auto;
        border: none;
        width: 45%;
        max-width: 1000px;
        height: auto;
        max-height: 90vh;
        border-radius: 12px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        display: flex;
        flex-direction: column;
        animation: zoomIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            width: 95%;
            margin: 5% auto;
            max-height: 95vh;
        }
    }

    .modal-header {
        padding: 12px 20px;
        border-bottom: 1px solid #f3f4f6;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border-radius: 12px 12px 0 0;
    }

    .modal-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: #111827;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .closefg {
        background: #f3f4f6;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        color: #6b7280;
        padding: 0;
        line-height:1;
    }

    .closefg:hover {
        background: #fee2e2;
        color: #ef4444;
        transform: rotate(90deg);
    }

    .modal-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
    }

    .modal-footer {
        padding: 12px 20px;
        border-top: 1px solid #f3f4f6;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background-color: #f9fafb;
        border-radius: 0 0 12px 12px;
    }

    /* Grid Layout for Header Fields */
    .modal-fields-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px;
        /* margin-bottom: 20px;*/
    }

    @@media (max-width: 768px) {
        .modal-fields-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Compact Input Styles */
    .form-group-compact {
        position: relative;
    }

    .form-group-compact label {
        display: block;
        font-size: 12px;
        font-weight: 500;
        color: #4b5563;
        margin-bottom: 4px;
    }

    .form-control-compact {
        width: 100%;
        padding: 6px 10px;
        font-size: 13px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        transition: border-color 0.2s, box-shadow 0.2s;
        background-color: #fff;
    }

    .form-control-compact:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-control-compact:disabled {
        background-color: #f3f4f6;
        cursor: not-allowed;
    }

    .error-msg {
        font-size: 11px;
        color: #ef4444;
        margin-top: 2px;
        min-height: 15px;
    }

    /* Table Styling Overrides */
    #tblMasterData_wrapper {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
    }

    #tblMasterData {
        margin: 0 !important;
        border: none !important;
    }

    #tblMasterData thead th {
        background-color: #f9fafb;
        color: #374151;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.025em;
        font-size: 11px;
        padding: 10px;
        border-bottom: 1px solid #e5e7eb !important;
    }

    #tblMasterData tbody td {
        padding: 4px 8px !important;
        vertical-align: middle;
        font-size: 12px;
        color: #4b5563;
        border-bottom: 1px solid #f3f4f6 !important;
    }

    #tblMasterData .form-control {
        padding: 4px 8px;
        font-size: 12px;
        height: 28px;
        border-radius: 4px;
    }

    /* Action Buttons */
    .btn-action {
        display: inline-flex;
        align-items: center;        
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.2s;
        cursor: pointer;
        border: 1px solid transparent;
    }

    /* .btn-save { background: #10b981; color: white; }
    .btn-save:hover { background: #059669; }
    .btn-clear { background: #fff; border-color: #d1d5db; color: #374151; }
    .btn-clear:hover { background: #f9fafb; }
    .btn-close { background: #f3f4f6; color: #374151; }
    .btn-close:hover { background: #e5e7eb; } */

    .btn-action i {
        width: 10px;
        height: 10px;
    }
    .dupError {
        border: 2px solid red;
        background: #ffe6e6;
    }

</style>
<body>
    @Html.HiddenFor(model => model.FormID, new { @autocomplete = "off", @class = "form-control", @id = "txtFormID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    <h4 id="MainHeading">@ViewData["FormName"]</h4>
    <hr />
    <div class="toastBox"></div>
    <div>        
        <div id="dvMainTable">
            <div id="my-grid" style="height: 600px; width: 100%;"></div>
        </div>
    </div>
    <div class="modalBatch" id="myModalfg">
        <div class="modalBatch-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="lblPopupheading">
                    <i data-lucide="file-text"></i>
                    <b>Add @ViewData["FormName"]</b>
                </h5>
                <button type="button" class="closefg" title="Close"><i data-lucide="x"></i></button>
            </div>
            
            <!-- Modal body -->
            <div class="modal-body">
                <div id="dvAssign">
                    <div class="modal-fields-grid">
                        <div class="form-group-compact">
                            <label>Branch *</label>
                            <select class="form-control-compact FormclrcmbField" id="cmbBranch">
                                <option value="0">Select Branch</option>
                            </select>
                            <div id="divErrBranch" class="error-msg clrdiv"></div>
                        </div>

                        <div class="form-group-compact">
                            <label>From Date *</label>
                            <input type="text" id="txtID" hidden />
                            <input type="text" id="txtOrgFromDate" hidden />
                            <input type="text" id="txtOrgToDate" hidden />
                            <input type="text" id="txtOrgBranchID" hidden />
                            <input type="date" id="txtFromDate" class="form-control-compact" />
                            <div id="dvErrorFromDate" class="error-msg clrdiv"></div>
                        </div>

                        <div class="form-group-compact">
                            <label>To Date *</label>
                            <input type="date" id="txtToDate" class="form-control-compact" />
                            <div id="dvErrorToDate" class="error-msg clrdiv"></div>
                        </div>
                    </div>

                    <div style="border-top: 1px solid #f3f4f6; padding-top: 5px;">
                        <table class="table table-bordered" id="tblMasterData" width="100%">
                            <thead>
                                <tr class="trclrforcolheader">
                                    <th style="width:0%;">ID</th>
                                    <th style="width:3%;">#</th>
                                    <th style="width:50%;">Transaction</th>
                                    <th style="width:30%;">Prefix</th>
                                    <th style="width:17%;">Doc Value</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button tabindex="4" type="button" class="btn-action btn-danger" id="btnClear">
                    <span class="glyphicon glyphicon-refresh"> Clear</span>
                </button>
                <button tabindex="3" type="button" class="btn-action btn-success" id="btnSave">
                    <span class="glyphicon glyphicon-saved"> Save</span>
                </button>
                <button tabindex="5" type="button" class="btn-action btn-warning" id="btnClose">
                   <span class="glyphicon glyphicon-remove"> Close</span>
                </button>
            </div>
        </div>
    </div>
</body>

<script>
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: true,// $("#txtViewID").val() == 1,
            handler: (rowData) => {
                nMode = 3;
                var fromdate = rowData.hdFromDate;
                var todate = rowData.hdToDate;
                var BranchID = rowData.hdBranchID;
                var ID = rowData.hdID;
                GetData(3, ID);     
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                $(".clrdiv").html("");
                $("#btnSave,#txtFromDate,#txtToDate,#btnClear,#cmbBranch").prop("disabled", true);
                modal.style.display = "block";
                lucide.createIcons();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',           
            visible: true,//$("#txtModifyID").val() == 1,
            // 💡 NEW TAG: This action will be rendered in the 3-dot menu
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;
                var fromdate = rowData.hdFromDate;
                var todate = rowData.hdToDate;
                var BranchID = rowData.hdBranchID;
                var ID = rowData.hdID;
                GetData(3, ID);
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());               
                $("#btnSave,#txtFromDate,#txtToDate,#cmbBranch").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $(".clrdiv").html("");
                modal.style.display = "block";
                lucide.createIcons();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>
<script type="text/javascript">
    var Table = $('#tblMasterData').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        "bFilter": false,
        "bSearchable": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": true,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0], "visible": false, searchable: false }],
    });

    var Aurl = '@Session["APIurl"]';
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    var grid;
    GetColumnSettingsData(2, 34, 1);
    //GetData(1, 0);
    setTimeout(() => {
        GetData(2);
    }, 500);
    GetData(4);
    var arrData = [];
    function GetData(dMode, strID = "0") {
        $.ajax({
            url: Aurl + "documentseries/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: dMode, ID: strID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (dMode == 1) {
                    //Table.draw().clear(); Table.draw().clear();
                    if (data.length > 0) {
                        var docdata = JSON.parse(data);
                        $('#tblMasterData').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                            scrollY: "450px",
                            scrollX: true,
                            scrollCollapse: true,
                            paging: false,
                            destroy: true,
                            data: docdata,
                            fixedColumns: false,
                            searching: true,
                            ordering: false,
                            sorting: false,
                            columns: [
                                { "data": "TransID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                {
                                    className: "dt-body-center", width: "5%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var _action = (rowIndex + 1);// '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-pencil clsEdit" style="font-size:16px" title="Edit"></span></a>';
                                        return _action;
                                    }
                                },
                                { "data": "TransName", "autoWidth": true, className: "dt-body-left", width: "60%" },
                                {
                                    className: "dt-body-center", width: "20%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var _action = '<input name = "Prefix" type="text" class="form-control clsPrefix" id="txtPrefix' + rowIndex + '" value="' + value.DocPrefix + '">';
                                        return _action;
                                    }
                                },
                                {
                                    className: "dt-body-center", width: "15%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var _action = '<input name= "DocValue" type="number" class="form-control" value="1" id="txtDocValue' + rowIndex +'" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)">';
                                        return _action;
                                    }
                                },
                            ],
                        });
                        Table = $('#tblMasterData').DataTable();
                    }
                    else {
                        showErrorSnackbar("No Records Found");
                    }
                }
                if (dMode == 3) {
                    Table.draw().clear(); Table.draw().clear();
                    if (data.length > 0) {
                        //txtOrgFromDate,txtOrgToDate
                        var dsdata = JSON.parse(data);
                        var FromDate = dsdata[0].FromDate;
                        var ToDate = dsdata[0].ToDate;
                        FromDate = FromDate.split('T')[0];
                        ToDate = ToDate.split('T')[0];
                        $("#txtFromDate,#txtOrgFromDate").val(FromDate);
                        $("#txtToDate,#txtOrgToDate").val(ToDate);
                        $("#cmbBranch,#txtOrgBranchID").val(dsdata[0].BranchID);
                        $("#txtID").val(dsdata[0].ID)
                        $('#tblMasterData').DataTable({
                            pageLength: ItemsperPage, lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                            scrollY: "450px",
                            scrollX: true,
                            scrollCollapse: true,
                            paging: false,
                            destroy: true,
                            data: dsdata,
                            fixedColumns: false,
                            searching: true,
                            ordering: true,
                            sorting: false,
                            columns: [
                                { "data": "TransID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                {
                                    className: "dt-body-center", width: "5%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var _action = (rowIndex + 1);// '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-pencil clsEdit" style="font-size:16px" title="Edit"></span></a>';
                                        return _action;
                                    }
                                },
                                { "data": "TransName", "autoWidth": true, className: "dt-body-left", width: "60%" },
                                {
                                    className: "dt-body-center", width: "20%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var disb = nMode == 3 ? "disabled" : "";
                                        var _action = '<input ' + disb + ' name = "Prefix" type="text" class="form-control clsPrefix" id="txtPrefix' + rowIndex +'" value="' + value.DocPrefix + '">';
                                        return _action;
                                    }
                                },
                                {
                                    className: "dt-body-center", width: "15%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var disb = nMode == 3 ? "disabled" : "";
                                        var _action = '<input ' + disb + ' name= "DocValue" type="number" class="form-control" id="txtDocValue' + rowIndex +'" value="' + value.DocValue + '" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)">';
                                        return _action;
                                    }
                                },
                            ],
                        });
                        Table = $('#tblMasterData').DataTable();
                    }
                    else {
                        showErrorSnackbar("No Records Found");
                    }
                }
                if (dMode == 2) {
                    var DocSeries = JSON.parse(data)
                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                    grid = new GKBSDynamicGrid('#my-grid', columns, DocSeries, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                        enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                        enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                        enableSorting: true,

                        searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                        rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                        //onCellChange: handleCellUpdate,
                        customCellRenderer: (el, col, rowData) => {
                        },
                        customButtons: [
                            {
                                icon: '⚙️',
                                text: 'Settings',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {
                                    //console.log("gridInstance : ", gridInstance);
                                    //console.log("event : ", event);
                                    //alert('Settings clicked! Total rows: ' + gridInstance.originalData.length);
                                    modalGenColumnSettings.style.display = "block";
                                    GendralColumnSettings(1, 34, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'Add New',
                                title: 'Add New',
                                visible: true,//$("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {
                                    nMode = 1;
                                    $("#btnSave,#txtFromDate,#txtToDate,#btnClear,#cmbBranch").prop("disabled", false);
                                    $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                    modal.style.display = "block";
                                    lucide.createIcons();
                                    ClearForm();
                                }
                            },
                        ],
                        onCellClick: (rowData, fieldName, cellValue, column) => {
                           
                        },
                        onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                            
                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(34, 1, 0, colIndex, field, newWidth)
                        },
                    });
                }
                if (dMode == 4) {
                    $('#cmbBranch').find("option").remove();
                    $('#cmbBranch').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbBranch').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $('input[type=number]').focusin(function (e) {
        $(this).select();
    });
   
    $('#tblMasterData tbody').on('change', '.clsPrefix', function (e) {
        var currentValue = e.target.value.trim();
        $('.clsPrefix').removeClass("dupError");
        var duplicates = $('#tblMasterData tbody .clsPrefix').filter(function () {
            return $(this).val().trim() === currentValue;
        });
        if (duplicates.length > 1) {

            showErrorSnackbar("Document Prefix already given in another transaction");
            duplicates.addClass("dupError");
            //e.target.value = "";
            e.target.focus();
        }
    });

    //Prefix
    var modal = document.getElementById("myModalfg");
    var span = document.getElementsByClassName("closefg")[0];
    span.onclick = function () {
        modal.style.display = "none";
    }
    $('#btnClose').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.style.display = "none";
    }
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".clrdiv").html("");
        var crdate = new Date().toISOString().split('T')[0];
        $("#txtFromDate,#txtToDate").val(crdate);
        $("#cmbBranch").val(0);
        $("#txtOrgToDate,#txtOrgFromDate,#txtOrgBranchID,#txtID").val("");        
        GetData(1);
    }
    function ValidateOrder() {
        return true;
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        if (ValidateOrder()) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        } else {
            //alert("Order value should not be empty");
            showErrorSnackbar("Value should not be empty");
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");

        var fromDate = $("#txtFromDate").val();
        var toDate = $("#txtToDate").val();
        var BranchID = $("#cmbBranch").val();
        if (BranchID == 0 || BranchID == "") {
            $("#divErrBranch").html("Select Branch");
            $("#cmbBranch").focus();
            $("#btnSave").prop("disabled", false);
            return;
        }
        if (fromDate === "") {
            $("#dvErrorFromDate").html("From Date is mandatory");
            $("#txtFromDate").focus();
            $("#btnSave").prop("disabled", false);
            return;
        }
        if (toDate === "") {
            $("#dvErrorToDate").html("To Date is mandatory");
            $("#txtToDate").focus();
            $("#btnSave").prop("disabled", false);
            return;
        }
        if (fromDate > toDate) {
            showErrorSnackbar("From Date should be less than To Date");
            $("#btnSave").prop("disabled", false);
            return;
        }
        
        var listdoc = [];
        var isValid = true;
        $("#tblMasterData tbody tr").each(function () {
            var strPrefix = "", strDocval = "";
            rowdata = Table.row($(this)).data();
            var nTrans = rowdata.TransID;//[0];

            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                if (fieldName == "Prefix") {
                    strPrefix = $(this).val();
                }
                if (fieldName == "DocValue") {
                    strDocval = $(this).val();
                }
            });

            if (strPrefix === "" || strDocval === "") {
                isValid = false;
                $(this).css("background-color", "#ffdddd"); // Highlight invalid row
            } else {
                $(this).css("background-color", ""); // Reset background
            }

            var lst = {
                "ID": nTrans,
                "Prefix": strPrefix,
                "DocValue": strDocval
            }
            listdoc.push(lst);
        });
        if (!isValid) {
            showErrorSnackbar("Prefix and Doc Value are mandatory for all rows.");
            $("#btnSave").prop("disabled", false);
            return;
        }
        var prefixes = [];
        // remove old highlights
        $(".clsPrefix").removeClass("dupError");
        // loop all prefix inputs
        $("#tblMasterData tbody .clsPrefix").each(function () {
            var val = $(this).val().trim();
            if (val !== "") {
                // check duplicate
                if (prefixes.includes(val.toLowerCase())) {
                    // highlight duplicate cell
                    $(this).addClass("dupError");
                    $("#btnSave").prop("disabled", false);
                    showErrorSnackbar("Duplicate Prefix not allowed");
                    isValid = false;
                    return;
                }
                else {
                    prefixes.push(val.toLowerCase());
                }
            }
        });
        if (!isValid) {            
            $("#btnSave").prop("disabled", false);
            return;
        }
        var lstMaster = {
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "FromDate": fromDate,
            "ToDate": toDate,
            "BranchID": $("#cmbBranch").val(),
            "orgFromDate": $("#txtOrgFromDate").val(),
            "orgToDate": $("#txtOrgToDate").val(),
            "orgBranchID": $("#txtOrgBranchID").val(),
            "UserID": UID,
            "lstDocSeries": listdoc
        };
        $.ajax({
            url: Aurl + "documentseries/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        modal.style.display = "none";
                        GetData(2);
                        //alert(items.Message);
                    }
                    else {
                        //$("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $('input, select ,button, textarea').on('keydown', function (e) {
        if (e.key === "Enter") {
            if (e.target.localName != "button") {
                e.preventDefault(); // Prevent default behavior
                var nextinp = $('input,select,button, textarea').eq($('input,select,button, textarea').index(this) + 1);
                if (nextinp.length) {
                    if (nextinp[0].disabled) {
                        nextinp = $('input,select,button, textarea').eq($('input,select,button, textarea').index(this) + 2);
                    }
                    nextinp.focus();
                    nextinp.select();
                }
            }
        }
        if (e.shiftKey && e.which == 13) {
            e.preventDefault();
            var $canfocus = $(':focusable');
            var index = $canfocus.index(this) - 1;
            if (index >= $canfocus.length) index = 0;
            $canfocus.eq(index).focus();
        }
    });
