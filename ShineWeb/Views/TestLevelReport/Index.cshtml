        }
    ];


    // -- Drill Down State --
    var currentLevel = 1;
    var drillHistory = [];
    var breadcrumbList = []; // New: Breadcrumb state
    var ItemsperPage = (typeof ItemsperPage !== 'undefined' ? ItemsperPage : 15);

    function getLevelConfig(level) {
        switch (level) {
            case 1: return { data: Level1data, filterCol: null, linkCol: 'SalesmanGrpID', labelCol: 'Salesman Group' };
            case 2: return { data: Level2data, filterCol: 'SalesmanGrpID', linkCol: 'SalesmanID', labelCol: 'Salesman Name' };
            case 3: return { data: Level3data, filterCol: 'SalesmanID', linkCol: 'CustomerID', labelCol: 'Customer Name' };
            case 4: return { data: Level4data, filterCol: 'CustomerID', linkCol: null, labelCol: 'Invoice No' }; // Invoice No as label? Not strictly used for next level but useful context
            default: return null;
        }
    }

    function renderBreadcrumb() {
        var html = '';
        if (breadcrumbList.length > 0) {
            html = breadcrumbList.join(' <span style="color: #999;">&rarr;</span> ');
        }
        $("#breadcrumb-container").html(html);
    }

    // ... generateColumns function ...

    // ... loadLevel function ...

    function handleDrillDown(rowData) {
        var nextLevel = currentLevel + 1;
        var nextConfig = getLevelConfig(nextLevel);

        if (nextConfig) {
            // Get link value from current level's config
            var currentConfig = getLevelConfig(currentLevel);
            var linkValue = rowData[currentConfig.linkCol];
            var labelValue = rowData[currentConfig.labelCol]; // Get label for breadcrumb

            if(linkValue) {
                // Update History
                drillHistory.push({ level: currentLevel, filterValue: currentFilterValue });

                // Update Breadcrumb
                if (labelValue) {
                    breadcrumbList.push(labelValue);
                    renderBreadcrumb();
                }

                // Update Level
                currentLevel = nextLevel;
                loadLevel(nextLevel, linkValue);
            }
        }
    }

    var currentFilterValue = null;

    function handleBack() {
        if (drillHistory.length > 0) {
            var prevState = drillHistory.pop();

            // Update Breadcrumb
            breadcrumbList.pop();
            renderBreadcrumb();

            currentLevel = prevState.level;
            loadLevel(currentLevel, prevState.filterValue);
        }
    }

    // ... (Rest of code) ...

    function generateColumns(data) {
        if (!data || data.length === 0) return [];
        let keys = Object.keys(data[0]);
        let cols = [];
        for (var i = 0; i < keys.length; i++) {
            var coldata = {
                "field": keys[i],
                "header": keys[i],
                "type": "label",
                "width": 100,
                "align": "right",
                "visible": true,
                "EnableColumnMenu": true,
                "ShowinColumnOption": true,
                "Total": true,
                "TotalYN": "1",
                "EnableSum": true,
                "EnableAvg": false,
                "precision": "2",
                "ClickPopup": false,
                PrintColumnName: keys[i],
                PrintYN: true,
                Printwidth: 20
            }
            cols.push(coldata);
        }

        // Add Action Column for Drill Down or Back button
        if (currentLevel < 4 || currentLevel > 1) {
             cols.push({
                "field": "Action",
                "header": "Action",
                "type": "action",
                "width": 80,
                "align": "center",
                "visible": true,
                "EnableColumnMenu": false,
                "ShowinColumnOption": false,
                "PrintYN": false
            });
        }

        return cols;
    }

    function loadLevel(level, filterValue) {
        var config = getLevelConfig(level);
        if (!config) return;

        var filteredData = config.data;
        if (config.filterCol && filterValue) {
            // Loose equality check for ID matching (string vs number)
            filteredData = config.data.filter(item => item[config.filterCol] == filterValue);
        }

        if (filteredData.length === 0) {
            alert("No data found for this selection.");
            return;
        }

        // Update Button Visibility - HIDDEN (Moved to row actions)
        // if (level > 1) {
        //    $("#btnBackLevel").show();
        // } else {
        //    $("#btnBackLevel").hide();
        // }

        // Generate columns based on filtered data
        var columnsettings = generateColumns(filteredData);

        // Clear existing grid container contents
        $('#my-grid').empty();

        // Initialize Grid
        grid = new GKBSDynamicGrid('#my-grid', columnsettings, filteredData, {
            enablePagination: true,
            pageSize: ItemsperPage,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,

            searchTerm: "",

            // Drill Down & Back Action Buttons
            singleIconAction: [
                {
                    icon: '<i class="fa fa-arrow-left" aria-hidden="true" style="color: #dc3545; font-size: 14px;"></i>',
                    title: 'Back',
                    visible: level > 1, // Only show if deeper than level 1
                    handler: (rowData, gridInstance) => {
                        handleBack();
                    }
                },
                {
                    icon: '<i class="fa fa-arrow-right" aria-hidden="true" style="color: #007bff; font-size: 14px;"></i>',
                    title: 'Drill Down',
                    visible: level < 4, // Only show if not terminal level
                    handler: (rowData, gridInstance) => {
                        handleDrillDown(rowData);
                    }
                }
            ],
            rowActionsMenu: [],

            customCellRenderer: (el, col, rowData) => {
                if (col.field === 'Active') {
                    const val = rowData[col.field];
                    if (val === 'True') {
                        el.innerHTML = `<div class="dg-status-badge dg-status-active"><span class="dg-status-circle"></span> Active</div>`;
                    } else if (val === 'False') {
                        el.innerHTML = `<div class="dg-status-badge dg-status-inactive"><span class="dg-status-circle"></span> In-Active</div>`;
                    }
                }
            },
            customButtons: [
                {
                    icon: '⚙️',
                    text: '',
                    title: 'Settings',
                    visible: true,
                    onClick: (gridInstance, event) => {
                         if(typeof modalGenColumnSettings !== 'undefined') {
                            modalGenColumnSettings.style.display = "block";
                            if(typeof GendralColumnSettings === 'function') GendralColumnSettings(1, 1, 1, 0);
                         }
                    }
                },
                {
                    icon: '➕',
                    text: 'New',
                    title: 'New ' + $("#MainHeading").text(),
                    visible: $("#txtAddID").val() == 1,
                    onClick: (gridInstance, event) => {
                         nMode = 1;
                         $("#chkActive,#btnSave,#txtName,#btnClear").prop("disabled", false);
                         $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                         if(typeof modal !== 'undefined') modal.style.display = "block";
                         if(typeof ClearForm === 'function') ClearForm();
                    }
                },
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {
                // Optional: Keep cell click or disable it depending on user preference.
                // Keeping it as requested in previous step, but buttons are primary now.
                 handleDrillDown(rowData);
            },
            onColumnResize: (colIndex, field, header, newWidth) => {
                if(typeof UpdateColumnWidth === 'function') UpdateColumnWidth(1, 1, 0, colIndex, field, newWidth)
            },
        });
    }

    // Initial Load
    $(document).ready(function () {
        loadLevel(1, null);
    });

    // Override loadLevel to update currentFilterValue
    var originalLoadLevel = loadLevel;
    loadLevel = function(level, filterValue) {
        currentFilterValue = filterValue; // Update global state
        originalLoadLevel(level, filterValue);
    }

    // Backspace Navigation
    document.addEventListener('keydown', function(event) {
        if (event.key === "Backspace") {
            var target = event.target;
            var isInput = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable;

            if (!isInput) {
                event.preventDefault();
                handleBack();
            }
        }
    });
</script>