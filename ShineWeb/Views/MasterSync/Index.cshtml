@{
    ViewBag.Title = "Master Sync";
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}

@*<link href="~/Content/bootstrap.min.css" rel="stylesheet" />*@
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link rel="stylesheet" href="~/Content/jquery-ui.css">
<!-- FontAwesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Google Font for modern typography -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

@*<script src="~/Scripts/bootstrap.min.js"></script>*@
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/Validation.js"></script>
<script src="~/Scripts/datatable.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>

<style>
    :root {
        --primary-color: #4a6cf7;
        --primary-dark: #3651c9;
        --primary-light: #eef1ff;
        --secondary-color: #f5f6fa;
        --text-color: #2f3640;
        --text-muted: #8a94a6;
        --accent-color: #00d2d3;
        --danger-color: #ef4444;
        --danger-light: #fef2f2;
        --success-color: #16c98d;
        --success-light: #ecfdf5;
        --warning-color: #f5a623;
        --border-color: #e7e9f3;
        --card-shadow: 0 4px 6px rgba(35, 42, 80, 0.06), 0 1px 3px rgba(35, 42, 80, 0.08);
        --hover-shadow: 0 12px 24px rgba(35, 42, 80, 0.10), 0 4px 8px rgba(35, 42, 80, 0.06);
        --radius-lg: 16px;
        --radius-md: 10px;
        --radius-sm: 8px;
    }

    body {
        background: linear-gradient(180deg, #f4f6fb 0%, #eef0f8 100%);
        font-family: 'Inter', 'Roboto', sans-serif;
        color: var(--text-color);
    }

    /* ===================== Layout / Container ===================== */
    .modern-container {
        margin-top: 16px;
        margin-bottom: 24px;
        background: #ffffff;
        border-radius: var(--radius-lg);
        box-shadow: var(--card-shadow);
        padding: 28px;
        position: relative;
        animation: fadeInUp 0.5s cubic-bezier(0.22, 1, 0.36, 1);
        border: 1px solid var(--border-color);
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===================== Page Header ===================== */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 8px;
        padding-bottom: 5px;
        border-bottom: 1px solid var(--border-color);
    }

    .page-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 35px;
        height: 35px;
        border-radius: 14px;
        background: linear-gradient(135deg, var(--primary-color), #7c8cf8);
        color: #fff;
        font-size: 1.15rem;
        box-shadow: 0 6px 14px rgba(74, 108, 247, 0.35);
        flex-shrink: 0;
        animation: popIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.1s backwards;
    }

    @@keyframes popIn {
        from {
            opacity: 0;
            transform: scale(0.6) rotate(-10deg);
        }

        to {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }
    }

    .page-header h4 {
        font-weight: 700;
        color: #1a1f36;
        margin: 0;
        font-size: 1.25rem;
        letter-spacing: 0.2px;
    }

    .page-header .subtitle {
        margin: 2px 0 0;
        font-size: 0.8rem;
        color: var(--text-muted);
        font-weight: 500;
    }

    .header-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--primary-light);
        color: var(--primary-dark);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 50px;
    }

        .header-badge i {
            font-size: 0.7rem;
        }

    /* ===================== Table Styles ===================== */
    .table-responsive {
        border-radius: var(--radius-md);
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

        .table thead th {
            background: linear-gradient(180deg, #f9fafc 0%, #f1f3fa 100%);
            color: #444b63;
            border: none;
            border-bottom: 1px solid var(--border-color);
            padding: 10px 10px !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 1.1rem !important;
            letter-spacing: 0.6px;
        }

            .table thead th i {
                color: var(--primary-color);
                margin-right: 5px;
            }

        .table tbody tr {
            transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: var(--primary-light);
                transform: scale(1.003);
                box-shadow: 0 2px 8px rgba(35, 42, 80, 0.06);
                z-index: 10;
                position: relative;
            }

        .table td {
            vertical-align: middle !important;
            border-top: 1px solid #f0f1f7;
            padding: 8px 10px;
            font-size: 12.5px !important;
            color: #4a5068;
            transition: background-color 0.35s ease, color 0.35s ease;
        }

    /* Sync status colors (kept semantic, applied via JS on save response) */
    .row-sync-success td {
        background-color: var(--success-light) !important;
        color: #0a7a52 !important;
    }

    .row-sync-error td {
        background-color: var(--danger-light) !important;
        color: #b91c1c !important;
        font-weight: 500;
    }

    /* DataTables search / length controls */
    .dataTables_filter input {
        border-radius: 50px !important;
        padding: 7px 16px !important;
        border: 1px solid var(--border-color) !important;
        width: 250px !important;
        font-size: 0.85rem;
        outline: none;
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .dataTables_filter input:focus {
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 3px rgba(74, 108, 247, 0.15);
        }

    .dataTables_length select {
        border-radius: 8px !important;
        display: inline-block;
        width: auto;
        border: 1px solid var(--border-color) !important;
        padding: 4px 8px !important;
    }

    /* ===================== Action Buttons ===================== */
    .action-bar {
        margin-top: 22px;
        display: flex;
        justify-content: flex-end;
        gap: 14px;
        flex-wrap: wrap;
    }

    .btn-custom {
        border-radius: 50px;
        padding: 11px 26px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        box-shadow: 0 4px 10px rgba(35, 42, 80, 0.12);
        position: relative;
        overflow: hidden;
    }

        .btn-custom:active {
            transform: translateY(1px) scale(0.98);
        }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: var(--hover-shadow);
        }

        .btn-custom:disabled {
            opacity: 0.75;
            cursor: not-allowed;
            transform: none !important;
        }

        .btn-custom i {
            font-size: 0.95rem;
        }

    .btn-refresh {
        background-color: #ffffff;
        color: #555b73;
        border: 1px solid var(--border-color);
        box-shadow: 0 2px 6px rgba(35, 42, 80, 0.06);
    }

        .btn-refresh:hover {
            background-color: #f8f9fc;
            color: #333;
        }

        .btn-refresh i {
            transition: transform 0.5s ease;
        }

        .btn-refresh:hover i {
            transform: rotate(180deg);
        }

    .btn-save-custom {
        background: linear-gradient(135deg, var(--success-color), #0fae7a);
        color: white;
        min-width: 140px;
        justify-content: center;
    }

        .btn-save-custom:hover {
            background: linear-gradient(135deg, #0fae7a, var(--success-color));
            color: white;
        }

    /* ===================== Sync Loader Overlay ===================== */
    .sync-overlay {
        position: fixed;
        inset: 0;
        background: rgba(26, 31, 54, 0.45);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.25s ease, visibility 0.25s ease;
    }

        .sync-overlay.show {
            opacity: 1;
            visibility: visible;
        }

    .sync-card {
        background: #ffffff;
        border-radius: var(--radius-lg);
        padding: 34px 42px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        transform: scale(0.9);
        transition: transform 0.25s ease;
        max-width: 90vw;
    }

    .sync-overlay.show .sync-card {
        transform: scale(1);
    }

    .sync-icon-wrap {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(74, 108, 247, 0.35);
    }

        .sync-icon-wrap i {
            color: #fff;
            font-size: 1.6rem;
            animation: spinSync 1s linear infinite;
        }

    @@keyframes spinSync {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .sync-text {
        font-weight: 700;
        font-size: 1rem;
        color: #1a1f36;
        text-align: center;
    }

    .sync-subtext {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-align: center;
        margin-top: -8px;
    }

    .sync-dots span {
        display: inline-block;
        width: 6px;
        height: 6px;
        margin: 0 2px;
        border-radius: 50%;
        background: var(--primary-color);
        animation: dotPulse 1.2s ease-in-out infinite;
    }

        .sync-dots span:nth-child(2) {
            animation-delay: 0.15s;
        }

        .sync-dots span:nth-child(3) {
            animation-delay: 0.3s;
        }

    @@keyframes dotPulse {
        0%, 80%, 100% {
            opacity: 0.25;
            transform: scale(0.8);
        }

        40% {
            opacity: 1;
            transform: scale(1.15);
        }
    }


    /* ===================== Keyframes (legacy) ===================== */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Input Tweaks */
    input[type=number] {
        text-align: right;
        border-radius: 4px;
        border: 1px solid #ddd;
        padding: 5px;
    }

    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    /* ===================== Responsive ===================== */
    @@media (max-width: 767px) {
        .modern-container {
            padding: 13px;
            border-radius: 12px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-header-icon {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }

        .page-header h4 {
            font-size: 1.05rem;
        }

        .action-bar {
            justify-content: stretch;
            flex-direction: column-reverse;
        }

        .btn-custom {
            width: 100%;
            justify-content: center;
        }

        .dataTables_filter input {
            width: 100% !important;
        }

        .toastBox {
            top: 12px;
            right: 12px;
            left: 12px;
            width: auto;
            max-width: none;
        }

        .sync-card {
            padding: 26px 24px;
        }
    }

    @@media (min-width: 768px) {
        .modern-container {
            padding: 10px;
        }
    }
</style>
<body>
    <div class="container">
        <div class="modern-container">

            <div class="page-header">
                <div class="page-header-left">
                    <div class="page-header-icon">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </div>
                    <div>
                        <h4 id="MainHeading" class="mb-0">Master Sync</h4>
                    </div>
                </div>
                <span class="header-badge d-none"><i class="fa-solid fa-database"></i> <label id="lblMasterSourceDB" style="margin:0;"></label></span>
            </div>

            <div id="dvMainTable" class="row">
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-hover" id="tblMasterData" width="100%">

                            <thead>
                                <tr class="trclrforcolheader">
                                    <th style="text-align:center;font-size:12px;width:0%; display:none;" class="trclrforcolheader">ID</th>
                                    <th style="text-align:center;font-size:12px;width:0%; display:none;" class="trclrforcolheader">TableName</th>
                                    <th style="text-align:center;font-size:12px;width:0%; display:none;" class="trclrforcolheader">SyncDate</th>
                                    <th style="text-align:center;font-size:12px;width:5%;" class="trclrforcolheader">#</th>
                                    <th style="text-align:center;font-size:12px;width:30%;" class="trclrforcolheader">
                                        <i class="fa-solid fa-file-invoice"></i> Form Name
                                    </th>
                                    <th style="text-align:center;font-size:12px;width:25%;" class="trclrforcolheader">
                                        <i class="fa-solid fa-clock-rotate-left"></i> Sync Time
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>

            <div class="action-bar">

                <button type="button" class="btn-custom btn-refresh" id="btnClear">
                    <i class="fa-solid fa-rotate-left"></i> Reset
                </button>

                <button type="button" class="btn-custom btn-save-custom" id="btnSave">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Sync
                </button>

            </div>

        </div>
    </div>

    <!-- Sync Loading Overlay -->
    <div class="sync-overlay" id="syncOverlay">
        <div class="sync-card">
            <div class="sync-icon-wrap">
                <i class="fa-solid fa-arrows-rotate"></i>
            </div>
            <div class="sync-text">Syncing data<span class="sync-dots"><span></span><span></span><span></span></span></div>
            <div class="sync-subtext">Please wait, this won't take long</div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toastBox" id="toastBox"></div>
</body>

<script type="text/javascript">
    var Table = $('#tblMasterData').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        "bFilter": true,
        "bSearchable": true,
        "bInfo": true,
        "bPaginate": false,
        "ordering": false,
        scrollY: "320px",
        scrollX: true,
        scrollCollapse: false,
        "columnDefs": [{ "targets": [0, 1,2], "visible": false }
            ],
        "language": {
            "search": "_INPUT_",
            "searchPlaceholder": "Search records..."
        }
    });

    // Style DataTables Search Box
    $('.dataTables_filter input').addClass('form-control').css({ 'border-radius': '50px', 'padding': '7px 16px', 'width': '250px' });
    $('.dataTables_length select').addClass('form-control').css({ 'border-radius': '8px', 'display': 'inline-block', 'width': 'auto' });

    var Aurl = '@Session["APIurl"]';
    var arrData = [];
    var UID = '@Session["LoginUserID"]';
    var RID = '@Session["RoleID"]';
    var nMode = 1;
    var FID = 1;// $("#txtFormID").val();
    InitiateData();
    function InitiateData() {
        Table.clear().draw();
        $.ajax({
            url: Aurl + "mastersync/synctables",
            type: 'GET',
            datatype: 'json',
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    Table.row.add([
                        items.ID,
                        items.TableName,
                        items.SyncDate,
                        (i + 1),
                        '<label style="font-weight: normal; cursor:pointer; width:100%;" name="FormName">' + items.FormName + '</label>',
                        '<label style="font-weight: normal; cursor:pointer;" name="SyncTime">' + items.SyncTime +'</label>'
                    ]).draw(false);
                });
            }
        });
    }

    /* =========================================================
       Sync loader overlay helpers
       Shown right when a save/sync request starts, hidden as
       soon as the API responds (success or error).
    ========================================================= */
    function showSyncLoader() {
        $("#syncOverlay").addClass("show");
    }
    function hideSyncLoader() {
        $("#syncOverlay").removeClass("show");
    }


    $('#btnClear').click(function (e) {
        if (ClearcfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        InitiateData();
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        if (cfFocus != 3) {
            ConfirmDialogMsg("Do you want to save data?");
        } else {
            SaveData();
        }
    });
    function SaveData(Mode, DeviceID, UserID)
    {
        $("#btnSave").prop("disabled", true);
        showSyncLoader();
        var lstsyncdata = [];
        //lblMasterSourceDB
        $("#tblMasterData tbody tr").each(function () {
            rowdata = Table.row($(this)).data();
            var nID = rowdata[0];
            var strTableName = rowdata[1];
            var strSyncTime = rowdata[2];
            var ischk = false, IsAutomail = false,noofpages = 1;

            var prof = {
                "ID": nID,
                "TableName": strTableName,
                "SyncTime": strSyncTime,
            }
            lstsyncdata.push(prof);
        });
        $.ajax({
            url: Aurl + "mastersync/syncdata",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstsyncdata),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                hideSyncLoader();
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        ClearForm();
                    }
                    else {// Error Message
                        var errorTable = items.TableName;
                        var LastUpdateTime = items.LastUpdateTime;
                        var $errorRow = null;

                        $("#tblMasterData tbody tr").each(function () {
                            $(this).removeClass("row-sync-success row-sync-error");
                            rowdata = Table.row($(this)).data();
                            var strTableName = rowdata[1];

                            if (strTableName != errorTable) {
                                $(this).addClass("row-sync-success");
                                $(this).find("label[name=SyncTime]").text(LastUpdateTime);
                            }
                            else if (strTableName == errorTable) {
                                $(this).addClass("row-sync-error");
                                $(this).find('td').attr("title", items.Message);
                                $errorRow = $(this);
                                return false;
                            }
                        });

                        // Scroll the DataTable's scrollable body to bring the error row into view
                        if ($errorRow && $errorRow.length) {
                            var $scrollBody = $("#tblMasterData").closest(".dataTables_scrollBody");
                            if ($scrollBody.length) {
                                $scrollBody.animate({
                                    scrollTop: $scrollBody.scrollTop() + $errorRow.position().top - ($scrollBody.height() / 2)
                                }, 400);
                            } else {
                                $errorRow[0].scrollIntoView({ behavior: "smooth", block: "center" });
                            }
                        }

                        showErrorSnackbar("Error in table \"" + errorTable + "\": " + items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                hideSyncLoader();
                if (data.status == "401") {
                    var msg = data.responseJSON ? data.responseJSON.Message : "Session expired.";
                    showErrorSnackbar(msg + " Please logout and login again.");
                } else {
                    showErrorSnackbar("Unable to sync data right now. Please try again.");
                }
            }
        });
        //InitiateData();
    }

</script>
