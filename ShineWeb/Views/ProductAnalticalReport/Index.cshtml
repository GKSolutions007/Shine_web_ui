    $("#ProductInfo").click(function () {
        if (ProductInfo.length > 0) {
            var p = ProductInfo[0];
            function piRow(icon, label, value, opts) {
                opts = opts || {};
                var displayValue = (value === "" || value === null || value === undefined)
                    ? '<span class="pi-value muted">—</span>'
                    : '<span class="pi-value" title="' + value + '">' + value + '</span>';
                return `<div class="pi-row ${opts.highlight ? 'highlight' : ''} ${opts.full ? 'full' : ''}">
                    <div class="pi-icon-chip"><i class="${icon}"></i></div>
                    <div class="pi-label">${label}</div>
                    <div class="pi-colon">:</div>
                    ${displayValue}
                </div>`;
            }

            var html = '<div class="pi-grid">'
                + piRow('fas fa-barcode', 'HSN', p.HSNCode)
                + piRow('fas fa-industry', 'Manufacturer', p.Manuf)
                + piRow('fas fa-star', 'Brand', p.Brand)
                + piRow('fas fa-list', 'Category', p.Category)
                + piRow('fas fa-percent', 'Tax', p.TaxName)
                + piRow('fas fa-rupee-sign', 'ECP', p.ECP)
                + piRow('fas fa-rupee-sign', 'MRP', p.MRP)
                + piRow('fas fa-tags', 'SPL Price', p.SPLPrice)
                + '</div>';

            $("#prodTitle").text(p.Code + " - " + p.Name);
            $("#prodBody").html(html);
            new bootstrap.Modal(document.getElementById('productInfoModal')).show();
        } else {
            showErrorSnackbar("Select Product");
        }
    });

