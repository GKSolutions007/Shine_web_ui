    function GetProduct() {
        var nShowAll = $("#chkShowAll").is(":checked") ? 1 : 0
        $.ajax({
            url: Aurl + "productanalticalreport/getproduct",
            type: 'get',
            contentType: 'json',
            data: { ShowAll: nShowAll },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                bindDataTable(eval(data))
            }
        });
    }
    $("#chkShowAll").click(function (e) {
