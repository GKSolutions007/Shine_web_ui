    .pi-header {
        background: linear-gradient(135deg, #0d5c3f 0%, #14804f 100%);
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }

    .pi-header-icon {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: white;
        flex-shrink: 0;
    }

    .pi-header h4 {
        font-size: 17px;
    }

    .pi-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background-color: rgba(255,255,255,0.15) !important;
        border-radius: 6px;
        padding: 5px;
    }

    .pi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .pi-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 2px;
        padding: 9px 14px;
        border-bottom: 1px solid #f0f0f0;
        min-width: 0;
    }

        .pi-row.full {
            grid-column: 1 / -1;
        }

        .pi-row.highlight {
            background-color: #eafaf1;
        }

    .pi-icon-chip {
        width: 26px;
        height: 26px;
        background-color: #eafaf1;
        color: #14804f;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        margin-top: 1px;
    }

    .pi-label {
        width: auto;
        white-space: nowrap;
        color: #6b7280;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-colon {
        color: #9ca3af;
        width: 6px;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-value {
        font-weight: 600;
        color: #111827;
        font-size: 13px;
        min-width: 0;
        flex: 1;
        white-space: normal;
        overflow: visible;
        word-break: break-word;
        line-height: 1.35;
    }

        .pi-value.muted {
            color: #9ca3af;
            font-weight: 400;
        }

    .pi-badge-good {
        background-color: #eafaf1;
        color: #14804f;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 11px;
    }
</style>
<style>
    /* ============ LEFT PANEL: header + controls ============ */
    .panel-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 46px 3px 12px;
        flex-shrink: 0;
    }

    .panel-header-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #1a6fb5 0%, #2596f0 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
        box-shadow: 0 3px 8px rgba(26, 111, 181, 0.3);
    }

    .panel-title {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: #0f2f4d;
    }

    .panel-controls {
        padding: 0 16px 2px;
        flex-shrink: 0;
    }

    .showall-switch {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
        font-size: 13px;
        color: #37485c;
        font-weight: 500;
    }

        .showall-switch .form-check-input {
            width: 2.3em;
            height: 1.25em;
            cursor: pointer;
            margin-top: 0;
        }

            .showall-switch .form-check-input:checked {
                background-color: #1a6fb5;
                border-color: #1a6fb5;
            }

        .showall-switch label {
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

    .type-toggle {
        display: flex;
        background: #eef3f8;
        border-radius: 10px;
        padding: 4px;
        gap: 4px;
    }

        .type-toggle input {
            display: none;
        }

    .type-toggle-btn {
        flex: 1;
        text-align: center;
        padding: 6px 5px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        color: #5b6b7d;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin: 0;
        user-select: none;
    }

    .type-toggle input:checked + .type-toggle-btn {
        background: #ffffff;
        color: #1a6fb5;
        box-shadow: 0 2px 6px rgba(15, 47, 77, 0.15);
        transform: translateY(-1px);
    }

    .type-toggle-btn:hover {
        color: #1a6fb5;
    }

    .grid-wrap {
        flex: 1 1 auto;
        min-height: 0;
        padding: 3px 5px 0px;
        overflow: auto;
    }

    /* ============ RIGHT TOP PANEL: profile card ============ */
    .profile-card-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 7px 10px 6px;
        border-bottom: 1px solid #eef2f6;
    }

    .profile-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a6fb5 0%, #2596f0 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(26, 111, 181, 0.35);
        animation: popIn 0.35s ease;
    }

    .profile-main {
        flex: 1;
        min-width: 0;
    }

    .profile-name {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 2px 0 6px;
        font-size: 15px;
        font-weight: 700;
        color: #0f2f4d;
        flex-wrap: wrap;
    }

        .profile-name label {
            margin: 0;
            cursor: default;
        }

            .profile-name label:empty:before {
                content: "Select a party to view details";
                color: #9aa7b4;
                font-weight: 400;
                font-size: 14px;
            }

    .party-info-icon {
        cursor: pointer;
        color: #1a6fb5;
        font-size: 16px;
        transition: transform 0.2s ease, color 0.2s ease;
        display: inline-flex;
    }

        .party-info-icon:hover {
            transform: scale(1.2);
            color: #14804f;
        }

