@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>
    
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 35%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -55%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>

    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>

    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        <b>Add @ViewData["FormName"]</b>
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body text-center">
                    <table class="table w-100">
                        <tbody>
                            <tr>
                                <td class="border-0 px-2" colspan="2">

                                    <span class="form-label">
                                        <input tabindex="1"
                                               type="text"
                                               id="txtAccGrp"
                                               class="form-control FormclrField"
                                               onbeforeinput="return AlphaNumericBeforeInput(event, this, '#dvErrorAccGrp')"
                                               oninput="sanitizeAlphaNumeric(this, '#dvErrorAccGrp')" />

                                        <label class="labelup">Account Group Name *</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorAccGrp"></div>

                                </td>
                            </tr>

                            <tr>
                                <td class="border-0 px-2" colspan="2">

                                    <span class="form-label">
                                        <select tabindex="2"
                                                id="cmbFAType"
                                                class="form-control">
                                        </select>

                                        <label class="labelup">Account Type *</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorFAType"></div>

                                </td>
                            </tr>

                            <tr>
                                <td class="border-0 px-2" colspan="2">

                                    <span class="form-label">
                                        <input tabindex="3"
                                               type="text"
                                               id="txtParentGrp"
                                               class="form-control FormclrField" />

                                        <label class="labelup">Parent Group</label>
                                    </span>

                                    <div class="clrdiv text-danger" id="dvErrorParentGrp"></div>

                                </td>
                            </tr>

                            <tr>
                                <td class="border-0 text-start" colspan="2">
                                    <label for="chkActive">Active :</label>
                                    <input tabindex="4"
                                           type="checkbox"
                                           id="chkActive"
                                           checked
                                           disabled />

                                    <div class="clrdiv text-danger" id="dvErrorActive"></div>
                                </td>
                            </tr>

                        </tbody>
                    </table>


                </div>

                <!-- Modal footer -->
                <div class="modal-footer">

                    <div class="text-end w-100">

                        <button tabindex="6"
                                type="button"
                                class="btn btn-danger"
                                id="btnClear">
                            <span class="glyphicon glyphicon-refresh"> Clear</span>
                        </button>

                        <button tabindex="5"
                                type="button"
                                class="btn btn-success"
                                id="btnSave">
                            <span class="glyphicon glyphicon-saved"> Save</span>
                        </button>

                        <button tabindex="7"
                                type="button"
                                class="btn btn-warning"
                                id="btnClose">
                            <i class="bi bi-x-circle"></i> Close
                        </button>

                    </div>

                </div>

            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                nMode = 3;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                var ID = rowData.ID;//[0];
                var TypeID = rowData.TypeID;//[1];
                var FAGrp = rowData.FAGrpName;//[2];
                var ParGrp = rowData.ParentGrp;//[4];
                var Active = rowData.Active;//[5];

                $("#txtID").val(ID);
                $("#txtAccGrp").val(FAGrp);
                $("#txtParentGrp").val(ParGrp);
                $("#cmbFAType").val(TypeID);

                $("#chkActive").prop("checked", Active == "Yes");
                $(".FormclrField").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbFAType").prop("disabled", true);
                $("#btnClear,#btnSave").hide();
                $("#btnClose").show();
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                var ID = rowData.ID;//[0];
                var TypeID = rowData.TypeID;//[1];
                var FAGrp = rowData.FAGrpName;//[2];
                var ParGrp = rowData.ParentGrp;//[4];
                var Active = rowData.Active;//[5];
                GetData(6, TypeID);
                $("#txtID").val(ID);
                $("#txtAccGrp").val(FAGrp);
                $("#txtParentGrp").val(ParGrp);
                $("#cmbFAType").val(TypeID);
                $("#chkActive").prop("checked", Active == "Yes");
                $("#btnClear").prop("disabled", true);
                $(".FormclrField").prop("disabled", false);
                $("#btnClear").hide();
                $("#btnClose,#btnSave").show();
                $("#chkActive,#btnSave,#cmbFAType").prop("disabled", false);
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>


<script type="text/javascript">
        var UID = '@Session["LoginUserID"]';
var nMode = 1;
var FID = $("#txtFormID").val();
    var Aurl = '@Session["APIurl"]';
        
    var grid, FinancialAccountGroup;
    GetColumnSettingsData(2, 5, 1);
    //~Grid Data
    AllFAGData();
    function AllFAGData() {        
        $.ajax({
            url: Aurl + "financialaccountgroup/getalldata",
            type: "GET",
            datatype: "JSON",
            xhrFields: {
                withCredentials: true
            },
            data: { Mode: 3, Name: "" },
            success: function (data) {
                if (data.length == 0) {
                    showErrorSnackbar("No Records Found");
                }
                FinancialAccountGroup = data;
                var fagjsdata = eval(data);

                var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, FinancialAccountGroup, {
                    enablePagination: true,
                    pageSize: ItemsperPage,
                    enableSearch: true,
                    stickyToWindow: true,
                    enableExport: false,
                    enablePrint: false,
                    enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                    enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                    enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                    enableSorting: true,
                    searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                    rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                    //onCellChange: handleCellUpdate,
                    customCellRenderer: (el, col, rowData) => {
                        if (col.field === 'Active') {
                            const val = rowData[col.field];
                            console.log("Active : ", val);
                            if (val === 'Yes') {
                                el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                            } else if (val === 'No') {
                                el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                            }
                        }
                    },
                    customButtons: [
                        {
                            icon: '⚙️',
                            text: '',
                            title: 'Settings',
                            visible: true,
                            onClick: (gridInstance, event) => {                                
                                modalGenColumnSettings.show();
                                GendralColumnSettings(1, 5, 1, 0);
                            }
                        },
                        {
                            icon: '➕',
                            text: 'New',
                            title: 'New ' + $("#MainHeading").text(),
                            visible: $("#txtAddID").val() == 1,
                            onClick: (gridInstance, event) => {
                                nMode = 1;
                                $("#chkActive,#btnSave,#btnClear,.FormclrField,#cmbFAType").prop("disabled", false);
                                $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                $("#btnClear,#btnClose,#btnSave").show();
                                modal.show();
                                ClearForm();
                            }
                        },
                    ],
                    onCellClick: (rowData, fieldName, cellValue, column) => {                       
                    },
                    onCellDoubleClick: (rowData, fieldName, cellValue, column) => {                        
                    },
                    onColumnResize: (colIndex, field, header, newWidth) => {
                        UpdateColumnWidth(5, 1, 0, colIndex, field, newWidth)
                    },
                });
            }
        });
        
    }

    GetData(3);
    GetData(5);
    var arrData = [];
    var ArrAL = [];
    function GetData(nMode, Value = null) {
        $.ajax({
            url: Aurl + "financialaccountgroup/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, Name: Value },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 3) {
                    arrData = [];
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            //arrData[i] = items.FAGrpName
                            var al = {
                                "label": items.FAGrpName,
                                "id": items.ID,
                            }
                            arrData.push(al);                            
                        });
                        //~AutoList Acc Group
                        PaginatedAutocomplete({
                            inputId: "txtAccGrp",
                            data: arrData,
                            onSelect: function (item) {
                                $("#txtAccGrp").val(item.label);
                                return false;
                            }
                        });
                        //$("#txtAccGrp").autocomplete({
                        //    minLength: 0,
                        //    source: arrData,                            
                        //    select: function (event, ui) {
                        //        $("#txtAccGrp").val(ui.item.label);
                        //        return false;
                        //    },
                        //}).autocomplete("instance")._renderItem = function (ul, item) {
                        //    return $("<li class='each'>")
                        //        .append("<div class='acItem'><span class='name'>" +
                        //            item.label + "</span></div>")
                        //        .appendTo(ul);
                        //};                        
                    }
                    else {
                        showErrorSnackbar("No Records Found");
                    }
                }
                else if (nMode == 5) {
                    $('#cmbFAType').find("option").remove();
                    $('#cmbFAType').append($('<option/>', {
                        value: 0,
                        text: "-- Select Account Type --",
                        class: ""
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbFAType').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                }
                else if (nMode == 6) {
                    ArrAL = [];
                    $.each(data, function (i, items) {
                        //ArrAL[i] = items.Name;
                        var al = {
                            "label": items.Name,
                            "id": items.ID,
                        }
                        ArrAL.push(al);
                    });
                    //~AutoList Parent Group
                    PaginatedAutocomplete({
                        inputId: "txtParentGrp",
                        data: ArrAL,
                        onSelect: function (item) {
                            $("#txtParentGrp").val(item.label);
                            return false;
                        }
                    });
                    //$("#txtParentGrp").autocomplete({
                    //    minLength: 0,
                    //    source: ArrAL,                        
                    //    select: function (event, ui) {
                    //        $("#txtParentGrp").val(ui.item.label);
                    //        return false;
                    //    },
                    //}).autocomplete("instance")._renderItem = function (ul, item) {
                    //    return $("<li class='each'>")
                    //        .append("<div class='acItem'><span class='name'>" +
                    //            item.label + "</span></div>")
                    //        .appendTo(ul);
                    //};
                }

            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
   
    var modal = new bootstrap.Modal(document.getElementById('myModalfg')); //document.getElementById("myModalfg");
    $("#myModalfg").on("shown.bs.modal", function () {
        $("#txtAccGrp").focus();
    });

    //~Close
    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.hide();
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });    
    function ClearForm() {
        $(".FormclrField").val("");
        $("#cmbFAType").val(0)
        $("#chkDefault").prop("checked", false);
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#txtAccGrp").focus();
        if (nMode != 1)
            modal.hide();
    }
    $("#cmbFAType").change(function () {
        var TypeID = $("#cmbFAType").val();
        $('#txtParentGrp').val("");
        GetData(6, TypeID);
    });
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        //~Validation
        var IsValid = true, ChkFormation = true;
        if ($("#txtAccGrp").val() == "") {
            IsValid = false;
            $("#dvErrorAccGrp").html("Account Group should not be empty");
            showErrorSnackbar("Account Group should not be empty");
        }
        if ($("#txtParentGrp").val() != "") {            
            const exists = ArrAL.filter(acc => acc.label == $("#txtParentGrp").val().trim());
            if (exists.length == 0) {
                IsValid = false;
                $("#dvErrorParentGrp").html("Parent Group select from list");
                showErrorSnackbar("Parent Group select from list");
            }
        }

        if ($("#cmbFAType").val() == 0) {
            IsValid = false;
            $("#dvErrorFAType").html("Select Account Type");
            showErrorSnackbar("Select Account Type");
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var name = $("#txtAccGrp").val();
        var lstMaster = {
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "FAGrpName": $("#txtAccGrp").val(),
            "TypeID": $("#cmbFAType").val(),
            "ParentGrp": $("#txtParentGrp").val(),
            "UserAccount": 1,
            "LevelID": 2,
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID,
            "UserAccount" : 1
        };

            $.ajax({
                url: Aurl + "financialaccountgroup/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (window.opener && !window.opener.closed) {
                                //window.opener.GetData(1);
                                //window.opener.$('#txtReason').val(name)
                                //window.opener.$('#txtReasonID').val(items.ID)
                                window.opener.postMessage({
                                    source: $("#txtFormName").val(),// "CustomerMaster",
                                    id: items.ID,   // adjust to your actual field names
                                    name: name
                                }, "*");
                                window.close();
                            }
                            else { 
                            ClearForm();
                            AllFAGData();
                            GetData(3);
                            modal.hide();
                            }
                        }
                        else {
                            $("#dvErrorAccGrp").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }


    //~Depend Master Load 
    if ($("#txtTransType").val() == "2") {
        console.log("ID", $("#txtID").val());
        if ($("#txtID").val() > 0) {
            GetData();
            nMode = 2;
            $(".clrdiv").html("");
            var ID = $("#txtID").val();
            setTimeout(() => {
                var arr = arrData.filter(sm => sm.id == ID);
                if (arr.length > 0) {
                    modal.show();
                    $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                    $("#txtAccGrp").val(arr[0].label);
                    $("#chkActive,#btnSave,#txtAccGrp").prop("disabled", false);
                    $("#btnClear").prop("disabled", true);
                    $(".clrdiv").html("");
                }
                else {
                    $(".modal-title#lblPopupheading").text($("#MainHeading").text());
                    modal.hide();
                }
            }, 1000);
        }
    }

</script>