        //    }
        //    listdoc.push(lst);
        //});        
        
        $("#tblMasterData tbody tr").each(function () {
            var row = Table.row($(this));
            var rowdata = row.data();
            if (!rowdata) return;
            var opb = $(this).find("input[name=OpeningValue]").val();
            rowdata.OpeningBalance = opb;
            rowdata.FAType = $(this).find("select[name=FAType]").val();
            row.data(rowdata);
        });
        console.log("Total Rows : ", Table.rows().count());
        Table.rows().every(function () {
            var rowdata = this.data();
            if (!rowdata) return;            
            var nFAID = rowdata.FAID;
            var orgOpeningValue = rowdata.orgOpeningBalance;          // Original OpeningValue (hidden)
            var orgFAType = rowdata.orgFAType;          // Original FAType (hidden)
            var nOpeningValue = rowdata.OpeningBalance; // Synced selected value
            var nFAType = rowdata.FAType; // Synced selected value
            if ((nOpeningValue != orgOpeningValue) || (nFAType != orgFAType)) {
                    var lst = {
                        "FAID": parseInt(nFAID),
                        "OpeningValue": nOpeningValue != "" ? parseFloat(nOpeningValue) : parseFloat(0),
                        "FAType": parseInt(nFAType)
                    }
                    listdoc.push(lst);
            }
        });        
        console.log("acc data ", listdoc);
        if (!isValid) {
            $("#btnSave").prop("disabled", false);
            return;
        }
        var lstMaster = {
            "Mode": nMode,
            "ID": $("#txtID").val(),            
            "BranchID": $("#cmbBranch").val(),
            "Period": $("#cmbPeriod").val(),
            "UserID": UID,
            "lstAccOpeningvalues": listdoc
        };
        $.ajax({
            url: Aurl + "faopening/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        //GetData(2);
                        GetData(1);
                        ClearForm();
                        //alert(items.Message);
                    }
                    else {
                        //$("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    function GetColumnSettingsData(nMode, nFormID, nTableID) {
        $.ajax({
            url: Aurl + "columnsettings/getcolumnsettings",
            /*url: "http://localhost:44396/api/singlemaster/get",*/
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, FormID: nFormID, TableID: nTableID, FormorReport: 0 },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                if (data.length > 0) {
                    columns = (data);
                    columns.push(actions);
                } else {
                    showErrorSnackbar("No column data found");
                }
            }
        });
    }
