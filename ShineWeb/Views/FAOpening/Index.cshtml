@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/Snackbar.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />

<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>
    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
        z-index: 1000;
    }
    table.dataTable tfoot th, table.dataTable tfoot td {
        text-align: right !important;
    }

    table.dataTable thead th, table.dataTable thead td {
        text-align: left !important;
    }
    .gdInput {
        width: 100%;
        height: 25px;
        /* border-width: 0 0 0 0;
    border-color: #e0d6d6;
    color: brown*/
    }
    
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    
    /* Grid Layout for Header Fields */
    .modal-fields-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px; 
        /* margin-bottom: 20px;*/
    }

    @@media (max-width: 768px) {
        .modal-fields-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Compact Input Styles */
    .form-group-compact {
        position: relative;
    }

        .form-group-compact label {
            display: block;
            font-size: 12px;
            font-weight: 500;
            color: #4b5563;
            margin-bottom: 4px;
        }

    .form-control-compact {
        width: 100%;
        padding: 6px 10px;
        font-size: 13px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        transition: border-color 0.2s, box-shadow 0.2s;
        background-color: #fff;
    }

        .form-control-compact:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .form-control-compact:disabled {
            background-color: #f3f4f6;
            cursor: not-allowed;
        }

    .error-msg {
        font-size: 11px;
        color: #ef4444;
        margin-top: 2px;
        min-height: 15px;
    }


    /* Action Buttons */
    .btn-action {
        display: inline-flex;
        align-items: center;
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.2s;
        cursor: pointer;
        border: 1px solid transparent;
    }

        /* .btn-save { background: #10b981; color: white; }
    .btn-save:hover { background: #059669; }
    .btn-clear { background: #fff; border-color: #d1d5db; color: #374151; }
    .btn-clear:hover { background: #f9fafb; }
    .btn-close { background: #f3f4f6; color: #374151; }
    .btn-close:hover { background: #e5e7eb; } */

        .btn-action i {
            width: 10px;
            height: 10px;
        }

    .dupError {
        border: 2px solid red;
        background: #ffe6e6;
    }
    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -50%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.80em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
    .header-filter-container {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .trycard{
        display:block;
        background-color:gray;
    }
</style>
<body>
    @Html.HiddenFor(model => model.FormID, new { @autocomplete = "off", @class = "form-control", @id = "txtFormID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>
    <div id="dvDocuments">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>
    <div id="dvMain" class="w-100 " style="padding-bottom:200px;padding-top:5px;display:none;">
        <div id="dvAssign">

            <!-- Branch + Period -->
            <div class="row g-2">

                <div class="col-12 col-md-3">
                    <input id="txtID" hidden />

                    <span class="form-label">
                        <select class="form-control form-control-compact FormclrcmbField" id="cmbBranch">
                            <option value="0">Select Branch</option>
                        </select>
                        <label class="labelup" for="cmbBranch">Branch *</label>
                    </span>

                    <div id="divErrBranch" class="error-msg clrdiv"></div>
                </div>

                <div class="col-12 col-md-3">
                    <span class="form-label">
                        <select class="form-control form-control-compact FormclrcmbField" id="cmbPeriod">
                            <option value="0">Select Period</option>
                        </select>
                        <label class="labelup" for="cmbPeriod">Period *</label>
                    </span>

                    <div id="divErrPeriod" class="error-msg clrdiv"></div>
                </div>

            </div>


            <!-- Table -->
            <div style="border-top:1px solid #f3f4f6;padding-top:5px;">
                <div class="row">
                    <div class="col-12">
                        <table class="table table-bordered" id="tblMasterData" width="100%">
                            <thead>
                                <tr class="trclrforcolheader">
                                    <th style="width:0%;" class="trclrforcolheader">ID</th>
                                    <th style="width:0%;" class="trclrforcolheader">Org Opening Value</th>
                                    <th style="width:0%;" class="trclrforcolheader">Org FA Type</th>
                                    <th style="width:3%;" class="trclrforcolheader">#</th>
                                    <th style="width:35%;" class="trclrforcolheader">Account Name</th>
                                    <th style="width:20%;" class="trclrforcolheader">Account Group</th>
                                    <th style="width:20%;" class="trclrforcolheader">Type</th>
                                    <th style="width:5%;" class="trclrforcolheader">FA Type</th>
                                    <th style="width:17%;" class="trclrforcolheader">Opening Value</th>
                                </tr>
                            </thead>
                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- Footer Buttons -->
        <div class="footerAction modal-footer">
            <div class="d-flex justify-content-end gap-2 pe-3">
                <button tabindex="4" type="button" class="btn btn-danger" id="btnClear">
                    <i class="bi bi-arrow-clockwise"></i> Clear
                </button>
                <button tabindex="3" type="button" class="btn btn-success" id="btnSave">
                    <i class="bi bi-floppy"></i> Save
                </button>
                <button tabindex="5" type="button" class="btn btn-warning" id="btnClose">
                    <i class="bi bi-x-circle"></i> Close
                </button>
            </div>
        </div>

    </div>
</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: true,// $("#txtViewID").val() == 1,
            handler: (rowData) => {
                nMode = 3;
                var ID = rowData.ID;
                GetData(3, ID);
                $("#btnSave,#cmbPeriod,#btnClear,#cmbBranch").prop("disabled", true);
                $("#MainHeading").text("View " + $("#txtFormName").val());
                $("#dvMain").show();
                $("#dvDocuments").hide();                
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: true,//$("#txtModifyID").val() == 1,
            // 💡 NEW TAG: This action will be rendered in the 3-dot menu
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;               
                var ID = rowData.ID;
                GetData(3, ID);
                $("#btnSave,#cmbPeriod,#btnClear,#cmbBranch").prop("disabled", false);
                $("#MainHeading").text("Modify " + $("#txtFormName").val());
                $("#dvMain").show();
                $("#dvDocuments").hide();
                document.getElementById("cmbBranch").focus();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>
<script type="text/javascript">
    var Table = $('#tblMasterData').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        "bFilter": false,
        "bSearchable": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": true,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [{ "targets": [0,1,2], "visible": false, searchable: false }],
    });

    var Aurl = '@Session["APIurl"]';
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    var grid;
    GetColumnSettingsData(2, 35, 1);
    //GetData(1, 0);
    setTimeout(() => {
        GetData(4);
    }, 500);
    GetData(5);
    var arrData = [];
    function GetData(dMode, strID = "0",strSelID = 0) {
        $.ajax({
            url: Aurl + "faopening/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: dMode, ID: strID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (dMode == 1) {
                    Table.draw().clear(); Table.draw().clear();
                    if (data.length > 0) {
                        var docdata = JSON.parse(data);
                        $('#tblMasterData').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                            scrollY: "475px",
                            scrollX: true,
                            scrollCollapse: true,
                            paging: true,
                            destroy: true,
                            data: docdata,
                            fixedColumns: false,
                            searching: true,
                            ordering: false,
                            sorting: false,
                            columns: [
                                { "data": "FAID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                { "data": "orgOpeningBalance", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                { "data": "orgFAType", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                {
                                    className: "dt-body-center", width: "5%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var _action = (rowIndex + 1);// '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-pencil clsEdit" style="font-size:16px" title="Edit"></span></a>';
                                        return _action;
                                    }
                                },
                                { "data": "AccountName", "autoWidth": true, className: "dt-body-left", width: "30%" },
                                { "data": "FAGroup", "autoWidth": true, className: "dt-body-left", width: "18%" },
                                { "data": "TypeName", "autoWidth": true, className: "dt-body-left", width: "17%" },
                                {
                                    className: "dt-body-center", width: "15%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var _action = "<select name='FAType' class='form-control' id='cmbFAType" + rowIndex + "'><option value= '1'>Credit</option><option value= '2'>Debit</option></select>";                                        
                                        return _action;
                                    }
                                },
                                {
                                    className: "dt-body-center pe-5", width: "15%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var _action = '<input name= "OpeningValue" type="number" class="form-control .clsOpeningValue" value="0" id="txtOpeningValue' + rowIndex +'" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)">';
                                        return _action;
                                    }
                                },
                            ],
                            initComplete: function () {
                                this.api().columns().every(function (index) {
                                    if (index !== 0 && index !== 1 && index !== 2 && index !== 3 && index !== this.columns().indexes().length - 1
                                        && index !== this.columns().indexes().length - 2) {
                                        var column = this;
                                        const columnName = $(column.header()).text().trim();

                                        var filterContainer = $('<div class="header-filter-container"></div>');
                                        var label = $('<div style="font-weight:600; font-size:11px; color:var(--secondary);">' + columnName + '</div>');
                                        var input = $('<input type="text" placeholder="Search..." class="form-control-compact"/>')
                                            .on('keyup change', function () {
                                                column.search($(this).val()).draw();
                                            });

                                        filterContainer.append(label).append(input);
                                        $(column.header()).empty().append(filterContainer);
                                    }
                                });
                            },
                        });
                        Table = $('#tblMasterData').DataTable();
                    }
                    else {
                        showErrorSnackbar("No Records Found");
                    }
                }
                if (dMode == 3) {
                    Table.draw().clear(); Table.draw().clear();
                    if (data.length > 0) {
                        //txtOrgFromDate,txtOrgToDate
                        var dsdata = JSON.parse(data);
                        $("#cmbBranch").val(dsdata[0].BranchID);                        
                        GetData(2, dsdata[0].BranchID, dsdata[0].DocSeriesID)
                        $("#txtID").val(dsdata[0].ID)
                        $('#tblMasterData').DataTable({
                            pageLength: ItemsperPage, lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                            scrollY: "475px",
                            scrollX: true,
                            scrollCollapse: true,
                            paging: true,
                            destroy: true,
                            data: dsdata,
                            fixedColumns: false,
                            searching: true,
                            ordering: false,
                            sorting: false,
                            columns: [
                                { "data": "FAID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                { "data": "orgOpeningBalance", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                { "data": "orgFAType", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                {
                                    className: "dt-body-center", width: "5%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var _action = (rowIndex + 1);// '<a href="javascript:void(0) style="cursor: pointer;"><span class="glyphicon glyphicon-pencil clsEdit" style="font-size:16px" title="Edit"></span></a>';
                                        return _action;
                                    }
                                },
                                { "data": "AccountName", "autoWidth": true, className: "dt-body-left", width: "30%" },
                                { "data": "FAGroup", "autoWidth": true, className: "dt-body-left", width: "18%" },
                                { "data": "TypeName", "autoWidth": true, className: "dt-body-left", width: "17%" },
                                {
                                    className: "dt-body-center", width: "15%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var isCrsel = value.FAType == "1" ? "selected" : "";
                                        var isDrsel = value.FAType == "2" ? "selected" : "";
                                        var disb = nMode == 3 ? "disabled" : "";
                                        var _action = "<select " + disb + " name='FAType' class='form-control' id='cmbFAType" + rowIndex + "'><option value= '1' " + isCrsel + ">Credit</option><option value= '2' " + isDrsel +">Debit</option></select>";
                                        return _action;
                                    }
                                },
                                {
                                    className: "dt-body-center", width: "15%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var disb = nMode == 3 ? "disabled" : "";
                                        var _action = '<input ' + disb + ' name= "OpeningValue" type="number" class="form-control .clsOpeningValue" value="' + parseFloat(value.OpeningBalance).toFixed(2) +'" id="txtOpeningValue' + rowIndex + '" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)">';
                                        return _action;
                                    }
                                },
                            ],
                            initComplete: function () {
                                this.api().columns().every(function (index) {
                                    if (index !== 0 && index !== 1 && index !== 2 && index !== 3 && index !== this.columns().indexes().length - 1
                                        && index !== this.columns().indexes().length - 2) {
                                        var column = this;
                                        const columnName = $(column.header()).text().trim();

                                        var filterContainer = $('<div class="header-filter-container"></div>');
                                        var label = $('<div style="font-weight:600; font-size:11px; color:var(--secondary);">' + columnName + '</div>');
                                        var input = $('<input type="text" placeholder="Search..." class="form-control-compact"/>')
                                            .on('keyup change', function () {
                                                column.search($(this).val()).draw();
                                            });

                                        filterContainer.append(label).append(input);
                                        $(column.header()).empty().append(filterContainer);
                                    }
                                });                            },
                        });
                        Table = $('#tblMasterData').DataTable();
                    }
                    else {
                        showErrorSnackbar("No Records Found");
                    }
                }
                if (dMode == 4) {
                    var DocSeries = JSON.parse(data)
                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                    grid = new GKBSDynamicGrid('#my-grid', columns, DocSeries, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,
                        enableAddRow: false,
                        enableRemoveRow: false,
                        enableSorting: true,
                        searchTerm: currentSearchValue, singleIconAction: singleIconAction,
                        rowActionsMenu: menuActions,
                        customCellRenderer: (el, col, rowData) => {
                        },
                        customButtons: [
                            {
                                icon: '⚙️',
                                text: 'Settings',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {
                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 35, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'Add New',
                                title: 'Add New',
                                visible: true,//$("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {
                                    nMode = 1;
                                    $("#btnSave,#cmbPeriod,#btnClear,#cmbBranch").prop("disabled", false);
                                    $("#MainHeading").text("Add " + $("#txtFormName").val());
                                    $("#dvMain").show();
                                    $("#dvDocuments").hide();                                    
                                    ClearForm();
                                    document.getElementById("cmbBranch").focus();
                                    GetData(1);
                                }
                            },
                        ],
                        onCellClick: (rowData, fieldName, cellValue, column) => {

                        },
                        onCellDoubleClick: (rowData, fieldName, cellValue, column) => {

                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(34, 1, 0, colIndex, field, newWidth)
                        },
                    });
                }
                if (dMode == 2) {
                    $('#cmbPeriod').find("option").remove();
                    $('#cmbPeriod').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    var faperiod = JSON.parse(data);
                    $.each(faperiod, function (i, items) {
                        $('#cmbPeriod').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    $("#cmbPeriod").val(strSelID);
                }
                if (dMode == 5) {
                    $('#cmbBranch').find("option").remove();
                    $('#cmbBranch').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbBranch').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $(document).on('focusin', 'input[type=number]', function () {
        $(this).select();
    });
    $(document).on('change', '.clsOpeningValue', function (e) {
        var Period = $("#cmbBranch").val();
        if (Period == 0 || Period == "") {
            showErrorSnackbar("Select valid period");
            e.target.value = "0";
        }
        else {
            var rowdata = this.data();
            rowdata.OpeningBalance = e.target.value;
            this.data(rowdata);
        }
    });
    $("#cmbBranch").change(function (e) {
        $(".clrdiv").html("");
        var BID = e.target.value;
        if (BID > 0) {
            GetData(2,BID)
        } else {
            showErrorSnackbar("Select Valid Branch");
        }
    });

    $('#btnClose').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        $("#dvMain").hide();
        $("#dvDocuments").show();
        //GetData(rdo1 ? 4 : 7);
        GetData(4);
        $("#MainHeading").text($("#txtFormName").val());
    }
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".clrdiv").html("");
        $("#cmbBranch").val(0);
        $("#txtID").val("");
        //$("#MainHeading").text($("#txtFormName").val());
        $('#cmbPeriod').find("option").remove();
        $('#cmbPeriod').append($('<option/>', {
            value: 0,
            text: "-- Select --",
        }));
        if (nMode != 1) {
            $("#dvMain").hide();
            $("#dvDocuments").show();
        }
    }   
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        
        var Period = $("#cmbPeriod").val();
        var BranchID = $("#cmbBranch").val();
        if (BranchID == 0 || BranchID == "") {
            $("#divErrBranch").html("Select Branch");
            $("#cmbBranch").focus();
            $("#btnSave").prop("disabled", false);
            return;
        }
        if (Period == 0 || Period == "") {
            $("#divErrPeriod").html("Select Period");
            $("#cmbPeriod").focus();
            $("#btnSave").prop("disabled", false);
            return;
        }        
        var listdoc = [];
        var isValid = true;
        //$("#tblMasterData tbody tr").each(function () {
        //    var strFAType = "", strOpenValue = "";
        //    rowdata = Table.row($(this)).data();
        //    var nFAID = rowdata.FAID;//[0];
        //    var OrgOpenBalance = rowdata.orgOpeningBalance;
