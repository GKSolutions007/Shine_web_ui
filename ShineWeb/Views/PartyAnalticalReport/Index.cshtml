<style>
    td {
        font-size: 12px;
    }


    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -40%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    tr {
        cursor: pointer
    }
</style>
<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 20px;
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
    }

    .container {
        display: flex;
        gap: 20px;
        flex-wrap: nowrap; /* keep left/right side-by-side; prevents right panel from dropping below on collapse */
        align-items: flex-start;
        transition: gap 0.35s ease;
    }

    .left-section {
        flex: 1 1 0;
        min-width: 200px;
        max-width: 100%;
        position: relative;
        overflow: hidden;
        transition: flex-basis 0.35s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .right-section {
        flex: 2 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
        transition: flex-grow 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Collapsed state: left section shrinks to a slim rail, right section reclaims the space */
    .container.left-collapsed .left-section {
        flex: 0 0 52px;
        min-width: 52px;
        max-width: 52px;
    }

    .container.left-collapsed .right-section {
        flex: 1 1 0;
    }

    .party-box-content {
        opacity: 1;
        transition: opacity 0.2s ease 0.1s, visibility 0.2s ease 0.1s;
    }

    .container.left-collapsed .party-box-content {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.15s ease, visibility 0.15s ease;
    }

    .collapse-toggle-btn {
        position: absolute;
        top: 0px;
        right: 10px;
        z-index: 20;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: none;
        border-radius: 50%;
        background-color: transparent;
        color: #1a6fb5;
        cursor: pointer;
        /*box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);*/
        transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

        .collapse-toggle-btn:hover {
            background-color: #1a6fb5;
            color: #ffffff;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3);
            transform: scale(1.08);
        }

        .collapse-toggle-btn:active {
            transform: scale(0.95);
        }

        .collapse-toggle-btn .toggle-icon {
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

    .container.left-collapsed .collapse-toggle-btn .toggle-icon {
        transform: rotate(180deg);
    }

    /* Vertical label shown only while the left panel is collapsed */
    .collapsed-label {
        position: absolute;
        top: 100px;
        left: 50%;
        transform: translateX(-50%) rotate(90deg);
        transform-origin: center;
        white-space: nowrap;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: #1a6fb5;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease 0.15s, visibility 0.2s ease 0.15s;
    }

    .container.left-collapsed .collapsed-label {
        opacity: 1;
        visibility: visible;
    }

    .party-box {
        background-color: #e6f1fb;
        padding: 2px;
        min-height: 550px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
        position: relative;
        transition: background-color 0.3s ease;
    }

    .container.left-collapsed .party-box {
        background-color: #d7e9f8;
    }

    .party-info-box {
        background-color: #fffde8;
        padding: 10px;
        min-height: 100px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
        animation: fadeSlideIn 0.4s ease;
    }

    .documents-box {
        background-color: #ffffff;
        padding: 2px;
        min-height: 400px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
        animation: fadeSlideIn 0.4s ease;
    }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .container {
            flex-direction: column;
            flex-wrap: wrap;
        }

        .left-section,
        .right-section {
            flex: 1 0 100% !important;
            max-width: 100% !important;
            min-width: 100% !important;
        }

        .party-box-content,
        .collapsed-label {
            display: none !important;
        }

        .collapse-toggle-btn {
            display: none;
        }
    }

    @@media (min-width: 1200px) {
        .container {
            max-width: 100% !important;
            gap: 1px !important;
        }
    }

    .main {
        padding-left: 0px !important;
        padding-top: 40px !important;
        padding-bottom: 30px !important;
        width: 100% !important;
        margin-left: 0px !important;
    }
</style>
<style>
    .star-rating {
        direction: rtl;
        display: inline-flex;
        font-size: 3rem;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            color: #ccc;
            cursor: pointer;
            padding: 0 5px;
        }

        .star-rating input:checked ~ label {
            color: gold;
        }

        /* ============ RATING ENHANCEMENTS ============ */
        .star-rating label {
            transition: all 0.2s ease;
        }

            .star-rating label:hover {
                transform: scale(1.2);
                animation: bounce 0.5s;
            }
    .rating-excellent {
        color: #007BFF;
    }

    .rating-good {
        color: #28A745;
    }

    .rating-average {
        color: #FD7E14;
    }

    .rating-poor {
        color: #DC3545;
    }

    .rating-block {
        color: red;
    }

    .eye-number-icon {
        position: relative;
        display: inline-block;
        font-size: 24px;
        line-height: 1;
    }

        .eye-number-icon span {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -52%);
            font-size: 11px;
            font-weight: 700;
        }

    .pi-header {
        background: linear-gradient(135deg, #0d5c3f 0%, #14804f 100%);
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }

    .pi-header-icon {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: white;
        flex-shrink: 0;
    }

    .pi-header h4 {
        font-size: 17px;
    }

    .pi-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background-color: rgba(255,255,255,0.15) !important;
        border-radius: 6px;
        padding: 5px;
    }

    .pi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .pi-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 2px;
        padding: 9px 14px;
        border-bottom: 1px solid #f0f0f0;
        min-width: 0;
    }

        .pi-row.full {
            grid-column: 1 / -1;
        }

        .pi-row.highlight {
            background-color: #eafaf1;
        }

    .pi-icon-chip {
        width: 26px;
        height: 26px;
        background-color: #eafaf1;
        color: #14804f;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        margin-top: 1px;
    }

    .pi-label {
        width: auto;
        white-space: nowrap;
        color: #6b7280;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-colon {
        color: #9ca3af;
        width: 6px;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-value {
        font-weight: 600;
        color: #111827;
        font-size: 13px;
        min-width: 0;
        flex: 1;
        white-space: normal;
        overflow: visible;
        word-break: break-word;
        line-height: 1.35;
    }

    .pi-value.muted {
        color: #9ca3af;
        font-weight: 400;
    }

    .pi-badge-good {
        background-color: #eafaf1;
        color: #14804f;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 11px;
    }
</style>
