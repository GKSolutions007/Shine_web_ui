<style>
    td {
        font-size: 12px;
    }


    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }    
    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -40%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    tr {
        cursor: pointer
    }
</style>
<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 20px;
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
    }

    .container {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .left-section {
        flex: 1;
        min-width: 200px;
    }

    .right-section {
        flex: 2;
        min-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 0px;
    }

    .party-box {
        background-color: #e6f1fb;
        padding: 2px;
        min-height: 550px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    .party-info-box {
        background-color: #fffde8;
        padding: 10px;
        min-height: 100px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    .documents-box {
        background-color: #ffffff;
        padding: 2px;
        min-height: 400px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    @@media (max-width: 768px) {
        .container {
            flex-direction: column;
        }

        .left-section,
        .right-section {
            flex: 1 0 100%;
        }
    }

    @@media (min-width: 1200px) {
        .container {
            max-width: 100% !important;
            gap: 1px !important;
        }
    }

    .main {
        padding-left: 0px !important;
        padding-top: 40px !important;
        padding-bottom: 30px !important;
        width: 100% !important;
        margin-left: 0px !important;
    }
</style>
<body>

    <div class="toastBox"></div>
    <div class="container">
        <div class="left-section">
            <div class="party-box">
                <div align="center" style="font-size:13px">
                    <input type="radio" name="partytype" id="rdoCustomer" checked /><label for="rdoCustomer">&ensp; Customer</label>
                    &emsp; <input type="radio" name="partytype" id="rdoVendor" /><label for="rdoVendor">&ensp;Vendor</label>
                </div>
                <div id="MainGrid" style="width: 100%;"></div>
                <div id="Grid"></div>
            </div>

        </div>
        <div class="right-section">
            <div class="party-info-box">
                <table width="100%">
                    <tr>
                        <td colspan="3" width="100%">
                            <h5><span class="glyphicon glyphicon-info-sign" title="Party Info" id="PartyInfo"></span> &ensp; <label id="lblPartyName"></label></h5>
                        </td>
                    </tr>
                    <tr>
                        <td align="left" width="40%">
                            📱<label style="opacity:0.5;">&ensp; Mobile No</label> <br /><label id="lblMobNo"></label><br />
                            🏛<label style="opacity:0.5;">&ensp;Address</label><br /><label id="lblAddress"> </label>
                        </td>
                        <td align="center" width="30%">
                            <b>Average Collection Days : </b><br />
                            <label style="font-size:28px;font-weight:600;color:darkcyan" id="lblAccValue"></label>
                        </td>
                        <td align="center" width="30%">                            
                            <label style="font-size:medium">Balance</label><br />
                            <label style="font-size:large" id="lblClosingBalance"></label>
                        </td>
                    </tr>
                </table>

            </div>
            <div class="documents-box">
                <strong></strong>
                <div id="DocumentGrid"></div>
                <div id="TransactionGrid" style="width: 100%;"></div>
            </div>
        </div>
    </div>
</body>
<script type="text/javascript">
    var DecVal = '@Session["DecimalValues"]';
    var Aurl = '@Session["APIurl"]';
    var companyName = '@Session["companyname"]';
    var SelectTableID = 1;
    
    var Grid1, Grid2;
    var Grid1Columns = ReturnColumnSettingsData(2, 1001, 1)
    var Grid2Columns = ReturnColumnSettingsData(2, 1001, 2);

    var grid;
    var Documetsgrid;
    var columnsettings = [], documentcolumnsettings = [];
    
    var ColumnSettingData = [];
    
    function ClearForm()
    {
        $("#lblLastTransDate").text("--");
        $("#lblRatingName,#lblAccValue").text("");
        $("#lblYearlySales,#lblMonthlySales,#lblYearlyReturn,#lblMonthlyReturn").text("0.00");
        $("input[name=rating]").prop("checked", false);
    }
    $("#PartyInfo").click(function () {
        if (PartyInfo.length > 0) {
            var Partydata = `
            <table id="partyDetailsVertical" border="1" cellspacing="0" cellpadding="8" style="width:100%; border-collapse: collapse;">
    <tbody>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Code</th>
            <td>`+ PartyInfo[0].Code+`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Name</th>
            <td>`+ PartyInfo[0].Name +`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Mobile</th>
            <td>`+ PartyInfo[0].Mob1 +`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Phone</th>
            <td>`+ PartyInfo[0].Ph1 +`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Email</th>
            <td>`+ PartyInfo[0].Email +`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">GSTIN</th>
            <td>`+ PartyInfo[0].GSTIN +`</td>
        </tr>
        <tr>
    <th style="text-align:left;background-color:#eeeeee;">State Name</th>
    <td>`+ PartyInfo[0].StateName +`</td>
</tr>
                <tr>
            <th style="text-align:left;background-color:#eeeeee;">Billing Address</th>
            <td>`+ PartyInfo[0].BillingAddress + `</td>
        </tr>
        <tr>
    <th style="text-align:left;background-color:#eeeeee;">Shipping Address</th>
    <td>`+ PartyInfo[0].ShippingAddress +`</td>
</tr>
<tr>
    <th style="text-align:left;background-color:#eeeeee;">Pincode</th>
    <td>`+ PartyInfo[0].Pincode +`</td>
</tr>
<tr>
    <th style="text-align:left;background-color:#eeeeee;">Rating</th>
    <td>`+ PartyInfo[0].RatingName +`</td>
</tr>
    </tbody>
</table>`
            InfoDialogMsg(Partydata, 'Party Info');
        } else {
            showErrorSnackbar("Select Party");
        }
    });
    $("#PartyInfo").hide();
    setTimeout(() => {
        GetParty(1);
    }, 1000);
    $('#rdoCustomer').change(function (e) {
        GetParty(1);
    });
    $('#rdoVendor').change(function (e) {
        GetParty(2);
    });
    function GetParty(nPartyType) {
        $("#Grid").html("");
        $("#DocumentGrid").html("");
        $.ajax({
            url: Aurl + "partyanalticalreport/getparty",
            type: 'get',
            contentType: 'json',
            data: { PartyType: nPartyType },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                bindDataTable(eval(data))
            }
        });
    }

    var PartyInfo = [];
    function GetPartyDocuments(nParty, nAccID) {
        $("#lblRatingName,#lblAccValue,#lblMobNo,#lblAddress,#lblClosingBalance").text("");
        $("input[name=rating]").prop("checked", false);
        $.ajax({
            url: Aurl + "partyanalticalreport/getdocuments",
            type: 'get',
            contentType: 'json',
            data: { PartyType : nParty ,AccountID : nAccID},
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                if (data)//.length > 0
                {
                    var PartyDocuments = eval(data.Documents);
                    PartyInfo = eval(data.PartyInfo);
                    var Rate = PartyInfo[0].RatingValue;
                    if (Rate >= 1) $("#star1").prop("checked", true);
                    if (Rate >= 2) $("#star2").prop("checked", true);
                    if (Rate >= 3) $("#star3").prop("checked", true);
                    if (Rate >= 4) $("#star4").prop("checked", true);
                    if (Rate == 5)
                        $("input[name=rating]").prop("checked", false);
                    $("#lblRatingName").text(PartyInfo[0].RatingName);
                    $("#lblMobNo").text(PartyInfo[0].Mob1);
                    $("#lblAddress").text(PartyInfo[0].BillingAddress);
                    $("#lblClosingBalance").text(PartyInfo[0].Balance);
                    if (nParty == 2) {//vendor
                        if (PartyInfo[0].CrDr == "Cr") {
                            $("#lblClosingBalance").css("color", "red");
                        } else {
                            $("#lblClosingBalance").css("color", "green");
                        }
                    } else {//customer
                        if (PartyInfo[0].CrDr == "Dr") {
                            $("#lblClosingBalance").css("color", "red");
                        } else {
                            $("#lblClosingBalance").css("color", "green");
                        }
                    }
                    animateCounterNumber("lblAccValue", 0, PartyInfo[0].Acc, 1500);
                    bindDocumentDataTable(PartyDocuments)
                } else {
                    showErrorSnackbar("No records found");
                }
            }
        });
    }
    var DocGridSearchValue = "";
    function bindDataTable(data) {
        if (data.length === 0) {
            return; // No data to display
        }
        var Reporthd = "Party Analtical Report";
        var nHeight = "500px";
        console.log("bindDataTable columnsettings ", Grid1Columns);
        var currentSearchValue = '';
        //if (grid) {
        //    currentSearchValue = grid ? grid.state.searchTerm : '';
        //}
        Grid1 = new GKBSDynamicGrid('#MainGrid', Grid1Columns, data, {
            enablePagination: true,
            pageSize: ItemsperPage,
            height: nHeight,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: currentSearchValue,
            CompanyName: companyName,
            ReportName: "",
            fitersdata: [],
            singleIconAction: [],
            rowActionsMenu: [],
            //onCellChange: handleCellUpdate,
            customButtons: [
                {
                    icon: '🛠️',
                    text: '',
                    title: 'Settings',
                    onClick: (gridInstance, event) => {
                        $("#txtGenSetSubmitApplygridname").val("Grid1");
                        modalGenColumnSettings.show();
                        GendralColumnSettings(1, 1001, 1, 0);
                    }
                },
                {
                    icon: '📥',
                    text: 'Export',
                    title: 'Export to Excel',
                    onClick: (gridInstance, event) => {
                        gridInstance.exportToExcel();
                    }
                },
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {
                if (Grid2) {
                    DocGridSearchValue = Grid2.state.searchTerm || '';
                    //showInfoSnackbar("lastSearchText : " + lastSearchText);
                }
                $("#TransactionGrid").html("");
                $("#PartyInfo").show();
                GetPartyDocuments(rowData["PartyType"], rowData["FAID"]);
                $("#lblPartyName").text(rowData["Name"]);

            },
            customCellRenderer: (el, col, rowData) => {
                if (rowData.PartyType == 1) {
                    el.style.backgroundColor = 'lightcyan';
                } else{
                    el.style.backgroundColor = 'lightyellow';
                }
                if (col.field === 'CB') {
                    const value = rowData[col.field];                                        
                    var PartyType = rowData.PartyType;
                    if (PartyType == 1) {//customer
                        if (value >= 0) {
                            el.style.color = 'red';
                            el.innerText = formatIndianCurrency(value);
                        } else if (value < 0) {
                            el.style.color = 'green';
                            el.innerText = formatIndianCurrency(Math.abs(value));//Math.abs
                        }
                        //
                    }
                    else {//vendor
                        if (value >= 0) {
                            el.style.color = 'green';
                            el.innerText = formatIndianCurrency(value);
                        } else if (value < 0) {
                            el.style.color = 'red';
                            el.innerText = formatIndianCurrency(Math.abs(value));//Math.abs
                        }                       
                    }
                }
            },
            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                
            },
            onColumnResize: (colIndex, field, header, newWidth) => {
                UpdateColumnWidth(1001, 1, 0, colIndex, field, newWidth);
            },
        });
    }

    function bindDocumentDataTable(data) {
        if (data.length === 0) {
            return; // No data to display
        }
        var Reporthd = "Party Analtical Report";
        var nHeight = "400px";
        Grid2 = new GKBSDynamicGrid('#TransactionGrid', Grid2Columns, data, {
            enablePagination: true,
            pageSize: ItemsperPage,
            height: nHeight,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: false,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: DocGridSearchValue,
            CompanyName: companyName,
            ReportName: "",
            fitersdata: [],
            singleIconAction: [],
            rowActionsMenu: [],
            //onCellChange: handleCellUpdate,
            customButtons: [
                {
                    icon: '🛠️',
                    text: '',
                    title: 'Settings',
                    onClick: (gridInstance, event) => {
                        $("#txtGenSetSubmitApplygridname").val("Grid2");
                        modalGenColumnSettings.show();
                        GendralColumnSettings(1, 1001, 2, 0);
                    }
                },
                {
                    icon: '📥',
                    text: 'Export',
                    title: 'Export to Excel',
                    onClick: (gridInstance, event) => {
                        gridInstance.exportToExcel()
                    }
                },
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {

            },
            customCellRenderer: (el, col, rowData) => {

            },
            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                var dTransID = rowData.TransID;
                var DocID = rowData["Doc ID"];
                OpenTransactionDocument(dTransID, DocID);
            },
            onColumnResize: (colIndex, field, header, newWidth) => {
                //alert(`Column Resized via Callback:\nIndex: ${colIndex}\nName: ${header}\nNew Width: ${newWidth}`);
                UpdateColumnWidth(1001, 2, 0, colIndex, field, newWidth);
            },
        });
        isRebinding = true;
    }

    $("input[name=rating]").prop("disabled", true);
    var PartyInfo = [];
    function GetData(nPartyID) {
        var nTypeID = $("#rdoCustomer").is(":checked") ? 1 : 2;
        $.ajax({
            url: Aurl + "oneview/getdata",
            type: 'get',
            contentType: 'json',
            data: { Type: nTypeID, PartyID: nPartyID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                PartyInfo = [];
                $("#lblLastTransDate").text("--");
                $("#lblRatingName,#lblAccValue").text("");
                $("#lblYearlySales,#lblMonthlySales,#lblYearlyReturn,#lblMonthlyReturn").text("0.00");
                $("input[name=rating]").prop("checked", false);
                //$("#star1, #star2, #star3, #star4, #star5").prop("checked", false);

                $.each(data, function (i, items) {
                    PartyInfo = JSON.parse(items.PartyDetails);
                    $("#lblLastTransDate").text(PartyInfo[0].LastTranDate);
                    $("#lblAccValue").text(PartyInfo[0].Acc);
                    animateCounterNumber("lblAccValue", 0, PartyInfo[0].Acc, 1500);

                    var Rate = PartyInfo[0].RatingValue;
                    if (Rate >= 1) $("#star1").prop("checked", true);
                    if (Rate >= 2) $("#star2").prop("checked", true);
                    if (Rate >= 3) $("#star3").prop("checked", true);
                    if (Rate >= 4) $("#star4").prop("checked", true);
                    if (Rate == 5)
                        $("input[name=rating]").prop("checked", false);
                    $("#lblRatingName").text(PartyInfo[0].RatingName);
                    $("#txtSearch").val(PartyInfo[0].Name);
                    var Trans = JSON.parse(items.TransDetails);
                    if (Trans.length > 0) {
                        $("#lblYearlySales").text(Trans[0].YRSALE);
                        $("#lblMonthlySales").text(Trans[0].MNTSALE);
                        $("#lblYearlyReturn").text(Trans[0].YRRTN);
                        $("#lblMonthlyReturn").text(Trans[0].MNTRTN);
                        $("#lblAverageSales").text(Trans[0].AvgSaleValue);
                        $("#lblAverageReturn").text(Trans[0].AvgRTNValue);
                    }

                    var PartyOS = JSON.parse(items.OutstandingDetails);


                    var Partycheq = JSON.parse(items.ChequeDetails);
                    var CheqtotalValue = 0, CheqCount = 0;
                    if (Partycheq.length > 0) {
                        CheqtotalValue = parseFloat(Partycheq.reduce((sum, item) => sum + parseFloat(item.Value), 0)).toFixed(DecVal);
                        CheqCount = Partycheq.length;
                    }
                });

            }
        });
    }
    if ($("#txtID").val() > 0 && $("#txtTransType").val() > 0) {
        var TypeID = $("#txtTransType").val();
        var PartyID = $("#txtID").val();
        $("#rdoCustomer").prop("checked", TypeID == 1);
        $("#rdoVendor").prop("checked", TypeID == 2);
        $("#tdPartycell,#txtSearch").prop("disabled", true);
        GetData(PartyID);
    }
    function animateCounterNumber(id, start, end, duration) {
        if (end != "" && end != null) {
            const obj = document.getElementById(id);
            const range = end - start;
            let current = start;
            const increment = end > start ? 1 : -1;
            const stepTime = Math.abs(Math.floor(duration / range));

            const timer = setInterval(() => {
                current += increment;
                obj.textContent = current;
                if (current === end) {
                    clearInterval(timer);
                }
            }, stepTime);
        }
    }
</script>
