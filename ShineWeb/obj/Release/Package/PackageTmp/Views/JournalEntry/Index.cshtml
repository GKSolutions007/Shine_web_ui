                        //    $('#txtBranchName').append($('<option/>', {
                        //        value: items.ID,
                        //        text: items.Name,
                        //    }));
                        //}
                    });
                    SetAutlistforFields();
                    //$("#txtBranchName").val(DefBranch);
                    LoadBranchByRoles();
                }
                if (nMode == 3) {
                    TableJVData.draw().clear(); TableJVData.draw().clear();
                    $.each(data, function (i, items) {
                        if (nTransMode != 3)
                            $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);
