                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (nTransMode != 4) {
                                if (allowprint == 1) {
                                    PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                } else if (allowprint == 3 || allowprint == 4) {
                                    PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                }
                                if (SendAutoMail == 1) {
                                    EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                }
                            }
                            ClearForm();
                            //GetData(2,"");
                            GetFilterData();
                            modal.hide();
                        }
                        else if (items.Message == "AccountName") {
                            $("#dvErrorName").html("Account Name Already Exists in another master");
                        }
                        else {
                            //$("#divErrorOnCode").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }
    function ReorderSerialNo() {
        var sNo = 0;
        $("#tblJVData tbody tr").each(function () {
            $(this).find("p").each(function (index) {
                vals = (sNo + 1);
                $(this).text(vals);
            });
            sNo++;
        });
        //$("#tblProductData").DataTable().ajax.reload();
    }
    $('#tblJVData tbody').on('click', '.clsremoveprod', function () {
        TableJVData.row($(this).parents('tr')).remove().draw();
        calculateGrid();
        ReorderSerialNo()
    });
    var EditRowID = -1, BatchMode = 0;
    $('#tblJVData tbody').on('click', '.clseditprod', function () {
        //TableJVData.row($(this).parents('tr')).remove().draw();
        BatchMode = 1;
        rowdata = TableJVData.row($(this).parents('tr')).data();
        var RID = TableJVData.row($(this).parents('tr')).index();
        EditRowID = RID;
        var ID = rowdata[0];
        var AccID = rowdata[1];
        var nID = 0, nAccID = 0, CrDr = 0, Adj = 0, dCrdit = 0, dDebit = 0, strRemarks = "", strAccName = "", nSerial = 1;
        $(this).parents('tr').find("label").each(function (index) {
            const fieldName = $(this).attr("name");
            if (fieldName == "FAType") {
                CrDr = $(this).text() == "Credit" ? "1" : "2";
            }
            if (fieldName == "AccountName") {
                strAccName = $(this).text();
            }
            if (fieldName == "Adjustment") {
                Adj = $(this).text() == "Yes" ? "1" : "0";
            }
            if (fieldName == "Credit") {
                const tagval = $(this).attr("lbltag");
                dCrdit = parseFloat(tagval);//$(this).text()
            }
            if (fieldName == "Debit") {
                const tagval = $(this).attr("lbltag");
                dDebit = parseFloat(tagval);//$(this).text()
            }
            if (fieldName == "Remarks") {
                strRemarks = $(this).text();
            }
        });
        $('#txtAccID').val(AccID); $("#cmbFAType").val(CrDr);
        $('#cmbAdjustment').val(Adj);
        updateInputColumn("txtValue", CrDr == 1 ? dCrdit : dDebit);
        //$("#txtValue").val(CrDr == 1 ? dCrdit : dDebit);
        $("#txtRemarks").val(strRemarks); $("#txtAccountName").val(strAccName);
        //calculateGrid();
    });
    function GetColumnSettingsData(nMode, nFormID, nTableID) {
        $.ajax({
            url: Aurl + "columnsettings/getcolumnsettings",
            /*url: "http://localhost:44396/api/singlemaster/get",*/
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, FormID: nFormID, TableID: nTableID, FormorReport: 0 },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                if (data.length > 0) {
                    columns = (data);
                    console.log("columns : ", columns);
                    columns.push(actions);
                    columns.push(OtherActions);

                } else {
                    showErrorSnackbar("No column data found");
                }
            }
        });
    }
    if ($("#txtID").val() > 0 && $("#txtTransType").val() == 2) {
        $(".clrdivs").html("");
        $("#txtAccountName,#txtRemarks,#txtValue").val("")
        $("#cmbFAType").val(1);
        nTransMode = 5;
        var ID = $("#txtID").val();
        setTimeout(() => {
            GetData(3, ID);
        }, 500);
        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnPrint").show();
        $("#btnSave,#btnClear,#btnDraft").hide();
        $("#btnEmail,#btnWhatsapp").show();
        $(".modal-title#lblPopupheading").text("View " + $("#txtFormName").val());
    }
</script>