        $.ajax({
            url: Aurl + "journalentry/get",
            type: 'get',
            contentType: 'json',
            data: { TransID: FID, Mode: nMode, ID: nID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbUDN,#cmbFAType,#txtBranchName').find("option").remove();
                    $('#cmbUDN,#txtBranchName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrPartyData = [], arrBranchData = [], arrAccount = [], arrALBranchData =[];
                    nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch = 0;
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            arrPartyData[nIndexarrParty] = items.Name;
                            nIndexarrParty++;
                            var adata = {
                                "AccID": items.ID,
                                "AccName": items.Name,
                                "label": items.Name
                            }
                            arrAccount.push(adata);
                        }
                        if (items.FType == 2) {
                            //cmbFAType
                            $('#cmbFAType').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 3) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            $("#lblDocID").text(items.Name);
                        }
                        //if (items.FType == 5) {
                        //    var al = {
                        //        "label": items.Name,
                        //    }
                        //    arrALBranchData.push(al);
                        //    arrBranchData[nIndexarrBranch] = items.Name;
