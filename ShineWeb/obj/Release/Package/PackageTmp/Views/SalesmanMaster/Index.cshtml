@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    //Layout = "~/Views/Shared/_LayoutBT5.cshtml";
    if (ViewData["TransType"].ToString() == "2")
    {
        Layout = "~/Views/Shared/_LayoutWithoutheader.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/_LayoutBT5.cshtml";
    }
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }
    /* Mobile - Up to 500px */
    @@media (max-width: 500px) {
        .modalBatch-content {
            width: 95%;
            padding: 20px;
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    /* Tablet - 501px to 720px */
    @@media (min-width: 501px) and (max-width: 849px) {
        .modalBatch-content {
            width: 75%;
            max-width: 500px;
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    /* Desktop/Laptop - Above 720px */
    @@media (min-width: 850px) {
        .modalBatch-content {
            width: 35%;
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }
   
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -48%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        font-weight:500;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control", @id = "txtID" })
    @Html.HiddenFor(model => model.ChildURL1, new { @autocomplete = "off", @class = "form-control", @id = "txtChildSMGrpURL" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    @Html.HiddenFor(model => model.DependFrom, new { @autocomplete = "off", @class = "form-control", @id = "txtDependFrom" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>

    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>
    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="padding: 0px !important">

                    <table class="table w-100">
                        <tr>
                            <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">

                                <span class="form-label">
                                    <input tabindex="1" type="text" id="txtName"
                                           class="form-control FormclrField"
                                           onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorName')"
                                           oninput="sanitizeAlphaNumeric(this, '#dvErrorName')" />
                                    <label class="labelup">Salesman Name *</label>
                                </span>

                                <div class="clrdiv text-danger" id="dvErrorName"></div>
                            </td>
                        </tr>

                        <tr>
                            <td style="border:none;padding-left:12px;padding-right:7px" colspan="2" class="text-end">

                                <span class="form-label">
                                    <select tabindex="2" id="cmbSMGroup" class="form-control"></select>
                                    <label class="labelup">Salesman Group</label>
                                </span>

                                <a href="javascript:void(0)" id="hrefNewgroup" hidden>New Group</a>

                                <div class="clrdiv text-danger" id="dvErrorSMGroup"></div>
                            </td>
                        </tr>

                        <tr>
                            <td style="border:none;padding-left:12px;padding-right:7px">

                                <span class="form-label">
                                    <input tabindex="3" type="date" id="txtDOB" class="clsdtpfield FormclrField" />
                                    <label class="labelup">Date Of Birth</label>
                                </span>

                                <div class="clrdiv text-danger" id="dvErrorDOB"></div>
                            </td>

                            <td style="border:none;padding-left:12px;padding-right:7px">

                                <span class="form-label">
                                    <input tabindex="4" type="date" id="txtDOJ" class="clsdtpfield FormclrField" />
                                    <label class="labelup">Join Date</label>
                                </span>

                                <div class="clrdiv text-danger" id="dvErrorSAJ"></div>
                            </td>
                        </tr>

                        <tr>
                            <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">

                                <span class="form-label">
                                    <input tabindex="5" type="number"
                                           id="txtMobileNo"
                                           class="form-control FormclrField"
                                           maxlength="12"
                                           oninput="javascript: if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); }" />

                                    <label class="labelup">Mobile No</label>
                                </span>

                                <div class="clrdiv text-danger" id="dvErrorMobileNo"></div>
                            </td>
                        </tr>

                        <tr>
                            <td style="border:none;padding-left:12px;padding-right:7px">

                                <span class="form-label">
                                    <input tabindex="6" type="number"
                                           id="txtAadhaarNo"
                                           class="form-control FormclrField"
                                           maxlength="12"
                                           oninput="javascript: if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); }" />

                                    <label class="labelup">Aadhaar No</label>
                                </span>

                                <div class="clrdiv text-danger" id="dvErrorAadhaarNo"></div>
                            </td>

                            <td style="border:none;padding-left:12px;padding-right:7px">

                                <span class="form-label">
                                    <input tabindex="7" type="text"
                                           id="txtPANNo"
                                           class="form-control FormclrField"
                                           maxlength="10" />

                                    <label class="labelup">PAN No</label>
                                </span>

                                <div class="clrdiv text-danger" id="dvErrorPANNo"></div>
                            </td>
                        </tr>

                        <tr>
                            <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">

                                <span class="form-label">
                                    <textarea tabindex="8"
                                              class="form-control FormclrField"
                                              rows="1"
                                              id="txtAddress"
                                              onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorAddress')"
                                              oninput="sanitizeAlphaNumeric(this, '#dvErrorAddress')"></textarea>

                                    <label class="labelup">Address</label>
                                </span>

                                <div class="clrdiv text-danger" id="dvErrorAddress"></div>
                            </td>
                        </tr>

                        <tr>
                            <td class="text-start" style="border:none" colspan="2">
                                <label for="chkActive">Active :</label>
                                <input tabindex="9" type="checkbox" id="chkActive" checked disabled />
                                <div class="clrdiv text-danger" id="dvErrorActive"></div>
                            </td>
                        </tr>

                    </table>

                </div>

                <!-- Modal footer -->
                <div class="modal-footer" style="background-color:skyblue">

                    <button tabindex="11" type="button" class="btn btn-danger" id="btnClear">
                        <span class="glyphicon glyphicon-refresh"> Clear</span>
                    </button>

                    <button tabindex="10" type="button" class="btn btn-success" id="btnSave">
                        <span class="glyphicon glyphicon-saved"> Save</span>
                    </button>

                    <button tabindex="12" type="button" class="btn btn-warning" id="btnClose">
                        <i class="bi bi-x-circle"></i> Close
                    </button>

                </div>

            </div>
        </div>
    </div>

</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                $(".modal-title#lblPopupheading").text("View Salesman");
                nMode = 3;
                $(".clrdiv").html("");
                //rowData = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                GetData(4, ID);
                $(".FormclrField").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbSMGroup").prop("disabled", true);
                $("#btnClear,#btnSave").hide();
                $("#btnClose").show();
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                console.log("Rowdata",rowData)
                $(".modal-title#lblPopupheading").text("Edit Salesman");
                nMode = 2;
                $(".clrdiv").html("");
                //rowData = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                GetData(4, ID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbSMGroup").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $("#btnClear").hide();
                $("#btnClose,#btnSave").show();
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>
<script type="text/javascript">
 
    var today = new Date();
    var dd = today.getDate();
    var mm = today.getMonth() + 1; //January is 0!
    var yyyy = today.getFullYear();

    if (dd < 10) {
        dd = '0' + dd;
    }

    if (mm < 10) {
        mm = '0' + mm;
    }
    var dobmin = (yyyy - 16) + '-' + mm + '-' + dd;
    today = yyyy + '-' + mm + '-' + dd;
    document.getElementById("txtDOJ").setAttribute("max", today);
    document.getElementById("txtDOJ").setAttribute("min", dobmin);
    document.getElementById("txtDOB").setAttribute("max", dobmin);
    var Aurl = '@Session["APIurl"]';
        
    var grid, Salesman;
    GetColumnSettingsData(2, 11, 1);
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    setTimeout(() => {
        GetData(3);
    }, 500);
    GetData(5);
    //~Grid Data
    function GetData(dMode,SelID = 0) {
        $.ajax({
            url: Aurl + "salesman/get",
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: dMode, Name: SelID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                
                if (dMode == 3) {
                    if (data.length == 0) {
                        showErrorSnackbar("No Records Found");
                    }
                        Salesman = data;
                        var arrData = [];
                        //Table.draw().clear();
                        $.each(data, function (i, items) {
                            var al = {
                                "label": items.Name,
                                "active": items.Active,
                                "id": items.ID,
                            }
                            arrData.push(al);                            
                        });
                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                    grid = new GKBSDynamicGrid('#my-grid', columns, Salesman, {
                            enablePagination: true,
                            pageSize: ItemsperPage,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                            enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                            enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                            enableSorting: true,
                            searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                            rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                            //onCellChange: handleCellUpdate,
                            customCellRenderer: (el, col, rowData) => {
                                if (col.field === 'Active') {
                                    const val = rowData[col.field];
                                    console.log("Active : ", val);
                                    if (val === 'True') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                                    } else if (val === 'False') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                                    }
                                }
                            },
                            customButtons: [
                                {
                                    icon: '⚙️',
                                    text: '',
                                    title: 'Settings',
                                    visible: true,
                                    onClick: (gridInstance, event) => {
                                        
                                        //modalGenColumnSettings.style.display = "block";
                                        modalGenColumnSettings.show();
                                        GendralColumnSettings(1, 11, 1, 0);
                                    }
                                },
                                {
                                    icon: '➕',
                                    text: 'New',
                                    title: 'New ' + $("#MainHeading").text(),
                                    visible: $("#txtAddID").val() == 1,
                                    onClick: (gridInstance, event) => {
                                        
                                        nMode = 1;
                                        $("#chkActive,#btnSave,#cmbSMGroup,#btnClear,.FormclrField").prop("disabled", false);
                                        $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                        $("#btnClear,#btnClose,#btnSave").show();
                                        modal.show();
                                        ClearForm();
                                        //$("#txtDOB,#txtDOJ").prop("disabled", true);
                                    }
                                },
                            ],
                            onCellClick: (rowData, fieldName, cellValue, column) => {
                                
                            },
                            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                                
                            },
                            onColumnResize: (colIndex, field, header, newWidth) => {
                                UpdateColumnWidth(11, 1, 0, colIndex, field, newWidth)
                            },
                        });
                    //~AutoList
                    PaginatedAutocomplete({
                        inputId: "txtName",
                        data: arrData,
                        onSelect: function (item) {
                            $("#txtName").val(item.label);
                            return false;
                        }
                    });                        
                }
                    //~Assign Data
                    else if (dMode == 4) {                       
                        $.each(data, function (i, items) {
                            $("#txtID").val(items.ID);
                            $("#txtName").val(items.Name);
                            $("#txtDOB").val(items.DOB);
                            $("#txtDOJ").val(items.DOJ);
                            $("#txtMobileNo").val(items.MobileNo);
                            $("#txtAadhaarNo").val(items.AadharNo);
                            $("#txtPANNo").val(items.PANNumber);
                            $("#txtAddress").val(items.Address);
                            $("#cmbSMGroup").val(items.SalesmanGroupID);
                            $("#chkActive").prop("checked", items.Active == "True");
                        });
                    }
                    else if (dMode == 5) {
                        $('#cmbSMGroup').find("option").remove();
                        $('#cmbSMGroup').append($('<option/>', {
                            value: 0,
                            text: "-- Select Salesman Group --",
                            class: ""
                        }));
                        $.each(data, function (i, items) {
                            $('#cmbSMGroup').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        });
                        $('#cmbSMGroup').val(SelID)
                    }
                
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    var modal = new bootstrap.Modal(document.getElementById('myModalfg')); //document.getElementById("myModalfg");
    $("#myModalfg").on("shown.bs.modal", function () {
        $("#txtName").focus();
    });

    
    window.addEventListener('keydown', function (event) {
        // Check if the F8 key is pressed (key code 119)
        if (event.keyCode === 119) {
            var url = $("#txtChildSMGrpURL").val();
            if (url != "") {
                var id = event.target.id;
                if (id == "cmbSMGroup")
                {
                    $("#lbliframeheading").text("Salesman Group");
                    document.getElementById("ifrSMG").src = url + "&ParFFID=cmbSMGroup";                
                    // Prevent default action if any (e.g., browser F8 behavior)
                    event.preventDefault();
                    // Open the modal when F8 is pressed
                    modaliframe.style.display = "block";
                }
            }
            else {
                showErrorSnackbar("Dependancy info not found");
            }
        }
    });
    $("#hrefNewgroup").click(function () {
        var url = $("#txtChildSMGrpURL").val();
        if (url != "") {
            $("#lbliframeheading").text("Salesman Group");
            document.getElementById("ifrSMG").src = url;
            modaliframe.style.display = "block";
        }
        else {
            showErrorSnackbar("Dependancy info not found");
        }
    });
    //~Close
    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        if ($("#txtTransType").val() == "2") {
            this.close();
        } else {
            modal.hide();
        }
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".FormclrField").val("");
        $("#cmbSMGroup").val(0)
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#txtName").focus();
        GetData(5);
        if (nMode != 1)
            modal.hide();
    }
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        //~Validation
        var IsValid = true, ChkFormation = true;
        if ($("#txtName").val() == "") {
            IsValid = false;
            $("#dvErrorName").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        ChkFormation = MobilenoValidation($("#txtMobileNo"), $("#dvErrorMobileNo"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = PANValidation($("#txtPANNo"), $("#dvErrorPANNo"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = AadharValidation($("#txtAadhaarNo"), $("#dvErrorAadhaarNo"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $(".clrdiv").html("");
        $("#btnSave").prop("disabled", true);
        var lstMaster = {
            "FormID": FID,
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "Name": $("#txtName").val(),
            "DOB": $("#txtDOB").val(),
            "DOJ": $("#txtDOJ").val(),
            "MobileNo": $("#txtMobileNo").val(),
            "AadharNo": $("#txtAadhaarNo").val(),
            "PANNumber": $("#txtPANNo").val(),
            "Address": $("#txtAddress").val(),
            "SalesmanGroupID": $("#cmbSMGroup").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID
        };
        $.ajax({
            url: Aurl + "salesman/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        var depfrom = $("#txtDependFrom").val();
                        if (window.opener && !window.opener.closed) {
                            if (depfrom == "0") {// invoice
                                window.opener.postMessage({
                                    source: "SalesmanMaster",
                                    salesmanid: items.ID,   // adjust to your actual field names                                    
                                    salesmanname: name
                                }, "*");
                            }
                            window.close();
                        }
                        else {
                            ClearForm();
                            GetData(3);
                            modal.hide();
                        }
                    }
                    else if (items.Message == "OSPending") {
                        //$("#divErrorOnName").html("Outstanding Amount Pending. Cannot Deactivate");
                        showErrorSnackbar("Outstanding Amount Pending. Cannot Deactivate");
                    }
                    else {
                        $("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    console.log("txtTransType ", $("#txtTransType").val());
    //~Depend Master Load
    if ($("#txtTransType").val() == "2") {        
        if ($("#txtID").val() > 0) {
            setTimeout(() => {
                nMode = 2;
                $(".clrdiv").html("");
                var ID = $("#txtID").val();
                $(".modal-title#lblPopupheading").text("Edit Salesman");
                GetData(4, ID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbSMGroup").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                modal.show();
            }, 1000);
        }
        else {
            $(".modal-title#lblPopupheading").text($("#MainHeading").text());
            modal.hide();
        }
    }
</script>