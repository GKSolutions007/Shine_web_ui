        if (damt > 100 || damt < 0) {
            showErrorSnackbar("Invalid Discount Value");
            updateInputColumn("txtTradeDiscPern", 0);
            updateInputColumn("txtTradeDiscAmt", 0);
            CalculateTradediscpern(0);
        }
        else {
