    function GetData(nMode, strName = null, strID = null,strDraftID = null) {
        $.ajax({
            url: Aurl + "purchasereturn/get",
            type: 'get',
            contentType: 'json',
            data: {
                Mode: nMode, CodeName: strName, ID: strID, BranchID: $("#cmbBranch").val(), Date: $("#dtpDate").val(),
                "PriceID": $("#cmbPriceType").val(), DraftID: strDraftID
            },
            xhrFields: {
                withCredentials: true
            },
            async : false,
            success: function (data) {
                 if (nMode == 1) {
                    $('#cmbPaymode,#cmbCreditTerm,#cmbUDN,#cmbFilterBranch,#cmbReturnType,#cmbReason,#cmbPriceType,#cmbManuf').find("option").remove();
                    $('#cmbPaymode,#cmbCreditTerm,#cmbUDN,#cmbFilterBranch,#cmbReturnType,#cmbReason,#cmbManuf').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrVendor = [], arrVendorCode = [], arrVendorName = [], arrProd = [];
                    nIndexarrVendor = 0, nIndexarrProd = 0, strReasons = "<option value='0'>-Reason-</option>", arrReasons = [];
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            var ven = {
                                "label": items.Code + " | " + items.Name,
                                "name": items.Name,
                                "code": items.Code,
                                "id": items.ID,
                            }
                            arrVendor.push(ven);
                            arrVendorCode[nIndexarrVendor] = items.Code;
                            arrVendorName[nIndexarrVendor] = items.Name;
                            nIndexarrVendor++;
                        }
                        if (items.FType == 3) {
                            $('#cmbPaymode').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            $('#cmbCreditTerm').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 2) {
                            $('#cmbFilterBranch').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 5) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 6) {
                            $("#lblDocID").text(items.Name);
                        }
                        if (items.FType == 7) {
                            $('#cmbReturnType').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 8) {
                            $('#cmbReason').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                            strReasons += '<option value="' + items.ID + '">' + items.Name + '</option>';
                            var sch = {
                                "label": items.Name,
                                "id": items.ID,
                            }
                            arrReasons.push(sch);
                        }
                        if (items.FType == 9) {
                            $('#cmbPriceType').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 10) {
                            $('#cmbManuf').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                    });
                    SetAutlistforFields();
                    //$("#cmbBranch").val(DefBranch);
                    LoadBranchByRoles('#cmbBranch,#cmbFilterBranch');
                }
                else if (nMode == 3) {
                    $.each(data, function (i, items) {
                        $("#txtVendorID").val(items.ID),
                            $("#txtSearch").val(items.Name),
                            $("#lblName").text(items.Code),
                            $("#cmbRating").text(items.Ratings),
                            $("#lblMob1").text(items.Mob1),
                            $("#lblGSTIN").text(items.GSTIN),
                            $("#cmbCreditTerm").val(items.CreditTermID),
                            $("#cmbPaymode").val(items.PaymentModeID);
                            $("#txtBAdd1").val(items.Billadd1),
                            $("#txtBAdd2").val(items.Billadd2),
                            $("#txtBAdd3").val(items.Billadd3),
                            $("#txtSAdd1").val(items.Shipadd1),
                            $("#txtSAdd2").val(items.shipadd2),
                            $("#txtSAdd3").val(items.Shipadd3),
                            $("#txtPincode").val(items.Pincode);
                        //$("#cmbTaxType").val(items.TaxTypeID),
                        //$("#cmdPriceType").val(items.PriceTypeID),
                        OpenOneView(items.ID, 2);
                    });
                }
                else if (nMode == 4) {
                    arrPurchaseTaxDetails = [];
                    $('#cmbUOM').find("option").remove();
                    $('#cmbUOM').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        $('#txtHProdID').val(items.ID);
                        $('#txtHProdCode').val(items.Code);
                        $('#lblProdCodeAS').text("Code : " + items.Code);
                        $('#txtHProds').val(items.Name);
                        $('#txtHSN').val(items.HSNCode);
                        $('#txtTransPRPrice').val(items.TransactionPrice);
                        arrPurchaseTaxDetails = ReturnTaxDetails(items.PurchaseTaxID, 1);
                        var dApponMRPCum = arrPurchaseTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
                        $('#txtMRPonTax').val(dApponMRPCum);
                        for (var j = 0; j < items.UOMList.length; j++) {
                            $('#cmbUOM').append($('<option/>', {
                                value: items.UOMList[j].ID,
                                text: items.UOMList[j].Name,
                                name: items.UOMList[j].ConvRate,
                            }));
                        }
                        TempBatch = items.PRBatchInfo;
                    });
                    ConvFact = 1;
                    TempProd = data;
                    $('#cmbUOM').val(TempProd[0].BaseUomID);
                }
                else if (nMode == 14) {
                    TableProductInfo.draw().clear(); TableProductInfo.draw().clear();
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            TableProductInfo.row.add([
                                items.HID,
                                items.Date,
                                items.MRP,
                                items.UomQty,
                                items.UomID,
                                items.PurchasePrice,
                                items.SalePrice,
                                items.ECP,
                                items.SPLPrice,
                                items.ReturnPrice,
                                items.ProdDiscPern,
                                items.TradeDiscPern,
                                items.AddnlDiscPern,
                                items.BatchNo,
                                items.PKD,
                                items.Expiry,
                            ]).draw(false);
                        });
                    }
                    else {
                        showErrorSnackbar("No records found");
                    }
                }
                else if (nMode == 15) {
                    var rdo1 = $("#rdoMainTableData").is(":checked");
                    //GetData(rdo1 ? 6 : 9);
                    GetFilterData();
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
