                },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    console.log("MASTERLIST RESPONSE:", data);
                    console.log("MASTERLIST RESPONSE JSON:", JSON.stringify(data));
                    if (strForm == "returntype") {
                        console.log("strForm matched return type");
                        $('#cmbReturnType').find("option").remove();
                        $('#cmbReturnType').append($('<option/>', {
                            value: 0,
                            text: "-- Select --",
                        }));
                        $.each(data, function (i, items) {
                            console.log("Adding item:", items);
                            $('#cmbReturnType').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                            $('#cmbReturnType').val(strAssignValue);
                        });

                    }
                }
            });
        }

