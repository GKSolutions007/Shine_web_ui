<script>
    //~Filter Action Buttons
    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canEdit: $("#txtModifyID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canCancel: $("#txtCancelID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    var allGridActions = [], singleIconAction = [], menuActions = [], columns = [];
    var actions = {}, OtherActions = {};

    function LoadPermissions() {
        var Permrdo1 = $("#rdoMainTableData").is(":checked") ? "1" : $("#rdoDraftTableData").is(":checked") ? "2" : "3";
        var cancelperm = !mapusersRole.canCancel ? false : Permrdo1 == "1" ? true : Permrdo1 == "2" || Permrdo1 == "3" ? true : false;
        var ViewPerm = mapusersRole.canView && Permrdo1 == "1" ? true : false;
        allGridActions = [
            {
                icon: '👁️',
                title: 'View Data',
                className: 'dg-action-view',
                // 💡 NEW TAG: This action will be rendered as a single icon
                displayType: 'single_icon',
                visible: ViewPerm,
                // $("#txtViewID").val() == 1,
                handler: (rowdata) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;
                    nTransMode = 5;
                    $("#txtID").val(ID);
                    ViewActionButtonPermission();
                    GetProductViewData(7, ID);
                    $("#txtStatus").val(rowdata.CurrentStatus);
                    $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
                    $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
                    $("#btnPreview,#btnPDF,#btnPrint").show();
                    $("#btnSave,#btnClear,#btnDraft,.dvSelectItems").hide();
                    $("#dvMain").show();
                    $("#btnEmail,#btnWhatsapp").show();
                    $("#dvDocuments").hide();
                    $("#MainHeading").text("View Purchase Return_" + sts);
                    $("#balanceContainer").show();
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#cmbBranch").prop("disabled", true);
                    }
                }
            },
            {
                icon: '✏️',
                title: 'Edit',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed') {
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftModifyID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canEdit)
                                isVisible = true;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[9];
                    if (sts != "Cancelled") {
                        EditActionTrigger(rowdata);
                    }
                    else {
                        showErrorSnackbar("Cannot Modify.This document already cancelled");
                    }
                }
            },
            {
                icon: '📄',
                title: 'Variant',
                className: 'dg-action-edit',
                visible: mapusersRole.canVariant && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    $("#txtID").val(ID);
                    VariantActionTrigger(rowdata);
                }
            },
            {
                icon: '❌',
                title: 'Cancel',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed') {
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftCancelID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canCancel && Permrdo1 == "1")
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    var rdo1 = $("#rdoMainTableData").is(":checked") ? "1" : $("#rdoDraftTableData").is(":checked") ? "2" : $("#rdoAITableData").is(":checked") ? "3" : "4";
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[9];
                    var stsID = rowdata.CurrentStatus;
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        if (rdo1 == "1") {
                            CancelActionTrigger(rowdata);
                        }
                        else {
                            var conf = confirm("Do you want to remove draft data?");
                            if (conf) {
                                //GetData(15, ID);
                                ValidateCancelDraftData(2, 12, ID, stsID)
                            }
                        }
                    }
                    else {
                        showErrorSnackbar("This document already cancelled");
                    }
                }
            },
            {
                icon: '🖨️',
                title: 'Print',
                className: 'dg-action-edit',
                visible: mapusersRole.canPrint && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    //$("#btnPrint").click();
                    var getdef = TransactionPrintProfiles.filter(pr => pr.DefaultConfig == 1);
                    var defid = getdef.length > 0 ? getdef[0].ConfigID : 0;
                    var copies = getdef.length > 0 ? getdef[0].NoCopies : 1;
                    $("#txtNoofCopies").val(copies);
                    $('#cmbPrintProfile').val(defid);
                    PrintConfigID = defid;
                    setTimeout(() => {
                        $("#btnPrint").click();
                    }, 300);
                }
            },
            {
                icon: '🖨️',
                title: 'Preview',
                className: 'dg-action-edit',
                visible: mapusersRole.canPreview && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    //$("#btnPreview").click();
                    var getdef = TransactionPrintProfiles.filter(pr => pr.DefaultConfig == 1);
                    var defid = getdef.length > 0 ? getdef[0].ConfigID : 0;
                    var copies = getdef.length > 0 ? getdef[0].NoCopies : 1;
                    $("#txtNoofCopies").val(copies);
                    $('#cmbPrintProfile').val(defid);
                    PrintConfigID = defid;
                    setTimeout(() => {
                        $("#btnPreview").click();
                    }, 300);
                }
            },
            {
                icon: "<i class='fa-regular fa-file-pdf' style='color:brown'></i>",
                title: '&ensp;PDF',
                className: 'dg-action-edit',
                visible: mapusersRole.canPDF && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    //$("#btnPDF").click();
                    var getdef = TransactionPrintProfiles.filter(pr => pr.DefaultConfig == 1);
                    var defid = getdef.length > 0 ? getdef[0].ConfigID : 0;
                    var copies = getdef.length > 0 ? getdef[0].NoCopies : 1;
                    $("#txtNoofCopies").val(copies);
                    $('#cmbPrintProfile').val(defid);
                    PrintConfigID = defid;
                    setTimeout(() => {
                        $("#btnPDF").click();
                    }, 300);
                }
            },
            {
                icon: "<i class='fa-solid fa-envelope' style='color:brown'></i>",
                title: '&ensp;Mail',
                className: 'dg-action-edit',
                visible: Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    //$("#btnEmail").click();
                    var getdef = TransactionPrintProfiles.filter(pr => pr.DefaultConfig == 1);
                    var defid = getdef.length > 0 ? getdef[0].ConfigID : 0;
                    var copies = getdef.length > 0 ? getdef[0].NoCopies : 1;
                    $("#txtNoofCopies").val(copies);
                    $('#cmbPrintProfile').val(defid);
                    PrintConfigID = defid;
                    setTimeout(() => {
                        $("#btnEmail").click();
                    }, 300);
                }
            },
            {
                icon: "<i class='fa-brands fa-whatsapp' style='color:green'></i>",
                title: '&ensp;WhatsApp',
                className: 'dg-action-edit',
                visible: Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btniframeWhatsapp").click();
                }
            },
        ];
        singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
        menuActions = allGridActions.filter(a => a.displayType === 'menu_item');
        actions = {
            "header": 'View',
            "type": "action",
            "width": 60,
            "align": "center",
            "visible": Permrdo1 == 1,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": singleIconAction
        };
        OtherActions = {
            "header": "Action",
            "type": "action3dots",
            "width": 60,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": menuActions
        }
    }
    LoadPermissions();
    function ViewActionButtonPermission() {
        $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
        if (mapusersRole.canEdit)
            $("#btnTEdit").show();
        if (mapusersRole.canCancel)
            $("#btnTCancel").show();
        if (mapusersRole.canVariant)
            $("#btnTVariant").show();
    }
</script>
