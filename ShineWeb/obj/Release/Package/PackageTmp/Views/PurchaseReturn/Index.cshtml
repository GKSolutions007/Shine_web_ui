    //~Calulate Product Grid
    function calculateProdGrid() {
        $(".lblPT").text(0.00);
        var dPTQty = 0, dPTFreeQty = 0, dPTDmgQty = 0, dPTGoods = 0, dPTGross = 0, dPTTax = 0, dPTNet = 0, TotProdDisc = 0, TotTradeDisc = 0, TotAddnlDisc = 0,
            Value = 0, dQty = 0, dGross = 0, dNet = 0, DiffExcl = 0, DiffIncl = 0;
        $("#tblProductData tbody tr").each(function () {
            if (ProductTable.rows().count() > 0) {
                var allValues = {};
                var rowdata = ProductTable.row($(this)).data();
                var TInvoicePrice = parseFloat(rowdata[21]);
                var GridProdID = parseInt(rowdata[0] || 0);
                console.log("pr price ", TInvoicePrice);
                var TaxPern = parseFloat(rowdata[3]);
                $(this).find("input").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "Qty") {
                        Value = $(this).attr("txttag");
                        dPTQty += parseFloat(Value);
                        dQty = parseFloat(Value);
                    }
                    if (fieldName == "FreeQty") {
                        Value = $(this).attr("txttag");
                        dPTFreeQty += parseFloat(Value);
                    }
                    if (fieldName == "DmgQty") {
                        Value = $(this).attr("txttag");
                        dPTDmgQty += parseFloat(Value);
                    }
                    if (fieldName == "ProdDiscAmt") {
                        Value = $(this).attr("txttag");
                        TotProdDisc += parseFloat(Value);
                    }
                    if (fieldName == "TradeDiscAmt") {
                        Value = $(this).attr("txttag");
                        TotTradeDisc += parseFloat(Value);
                    }
                    if (fieldName == "AddnlDiscAmt") {
                        Value = $(this).attr("txttag");
                        TotAddnlDisc += parseFloat(Value);
                    }
                });
                $(this).find("label").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "Goods") {
                        dPTGoods += parseFloat($(this).attr("lbltag"));//$(this).text()
                    }
                    if (fieldName == "Gross") {
                        dPTGross += parseFloat($(this).attr("lbltag"));
                        dGross = parseFloat($(this).attr("lbltag"));
                    }
                    if (fieldName == "TaxAmt") {
                        dPTTax += parseFloat($(this).text());
                    }
                    if (fieldName == "NetAmt") {
                        dPTNet += parseFloat($(this).attr("lbltag"));
                        dNet = parseFloat($(this).attr("lbltag"));
                    }
                    if (fieldName == "DiffValue") {
                        var forItemUOM = BatchAcceptArray.filter(bt => bt.ProdID == GridProdID);
                        var CFValue = 1;
                        //if (forItemUOM.length > 0) {
                        //    CFValue = parseFloat(forItemUOM[0].ConversionRate) || 1;
                        //}
                        if (dQty > 0) {
                            var tp = parseFloat(1 + (TaxPern / 100));
                            var val = dGross / dQty;
                            var Diff = val - (TInvoicePrice * CFValue);
                            var AbsDiff = Diff;// Math.abs(Diff);
                            DiffExcl += (AbsDiff * dQty);
                            DiffIncl += ((AbsDiff * dQty) * tp);

                        } else {
                            DiffExcl += 0;
                            DiffIncl += 0;
                        }
                    }
                });
                if (dNet == 0) {
                    $(this).css("background-color", "lightgrey");
                }
                else {
                    $(this).css("background-color", "white");
                }
            }
        });
        updateLabelColumn("lblPTQty", dPTQty); updateLabelColumn("lblPTFreeQty", dPTFreeQty); updateLabelColumn("lblPTDmgQty", dPTDmgQty);
        updateLabelColumn("lblPTPDiscAmt", TotProdDisc); updateLabelColumn("lblPTTDiscAmt", TotTradeDisc); updateLabelColumn("lblPTADiscAmt", TotAddnlDisc);
        updateInputColumn("txtProdDiscAmt", TotProdDisc); updateInputColumn("txtTradeDiscAmt", TotTradeDisc); updateInputColumn("txtAddnlDiscAmt", TotAddnlDisc);
        updateLabelColumn("lblPTGoods", dPTGoods);
        updateLabelColumn("lblPTGross", dPTGross); updateLabelColumn("lblPTTax", dPTTax); updateLabelColumn("lblPTNet", dPTNet);
        updateLabelColumn("lblCGST", (dPTTax / 2)); updateLabelColumn("lblSGST", (dPTTax / 2)); updateLabelColumn("lblIGST", dPTTax); updateLabelColumn("lblTaxAmount", dPTTax);
        var trdgrss = PurTrdDiscb4Prod ? dPTGoods :(dPTGoods - TotProdDisc);
        var addnlgrss = PurAddnlDiscb4Prod ? dPTGoods : (dPTGoods - TotProdDisc);
        var TrdPern = parseFloat(trdgrss) > 0 ? parseFloat((TotTradeDisc / trdgrss) * 100) : 0;
        var AddnlPern = parseFloat(addnlgrss) > 0 ? parseFloat((TotAddnlDisc / addnlgrss) * 100) : 0;
        updateInputColumn("txtAddnlDiscPern", AddnlPern); updateInputColumn("txtTradeDiscPern", TrdPern);
        console.log("2. Tr Disc : " + TrdPern);
        // ceil - always Up value, floor - always down value
        var tofrg = parseFloat(document.getElementById("txtFright").getAttribute("txttag"));
        var tothrchrg = parseFloat(document.getElementById("txtOtherChargAmt").getAttribute("txttag"));
        var twrtoff = parseFloat(document.getElementById("txtWriteoff").getAttribute("txttag"));
        var tTCS = parseFloat(document.getElementById("txtTCS").getAttribute("txttag"));
        var tTDS = parseFloat(document.getElementById("txtTDS").getAttribute("txttag"));
        var AllotherAmt = (tothrchrg + tofrg + twrtoff + tTCS + tTDS);
        dPTNet = dPTNet + AllotherAmt;
        //var RoundNetAmt = Math.floor(dPTNet);
        var RoundNetAmt = ApplyRoundoff(dPTNet);
        var Roundoff = (RoundNetAmt - dPTNet);
        //$("#txtRoundOff").val(Roundoff.toFixed(DecVal)); $("#lblRoundNet").text(RoundNetAmt.toFixed(DecVal));
        updateInputColumn("txtRoundOff", Roundoff); updateLabelColumn("lblRoundNet", RoundNetAmt);
        updateLabelColumn("lblRoundNetFooter", RoundNetAmt);
        updateInputColumn("txtDiffExcl", DiffExcl); updateInputColumn("txtDiffIncl", DiffIncl);
        $("#txtDiffExcl").css("color", DiffExcl >= 0 ? "green" : "red");
        $("#txtDiffIncl").css("color", DiffIncl >= 0 ? "green" : "red");
        var ItemCount = parseInt(ProductTable.rows().count());
        $("#lblPTCount").text(ItemCount);
        let ptdisb = nTransMode == 4 || nTransMode == 5;
        $("#cmbPriceType").prop("disabled", ptdisb);
        if (ItemCount == 0) {
            $("#txtTradeDiscPern,#txtTradeDiscAmt,#txtAddnlDiscPern,#txtAddnlDiscAmt").prop("disabled", false);
        } else {
            //$("#cmbPriceType").prop("disabled", true);
        }
    }
    function ApplyRoundoff(dAmt) {
        var Value = 0;
        if (ConfigRoundtype == 1) {//nearest
            Value = Math.round(dAmt)
        }
        else if (ConfigRoundtype == 2) {//lowest
            Value = Math.floor(dAmt)
        }
        else if (ConfigRoundtype == 3) {//highest
            Value = Math.ceil(dAmt)
        }
        return Value;
    }
