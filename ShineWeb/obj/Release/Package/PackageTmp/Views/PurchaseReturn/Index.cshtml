                    dPTTax = parseFloat($(this).attr("lbltag"));
                }
                if (fieldName == "NetAmt") {
                    dPTNet = parseFloat($(this).attr("lbltag"));
                }
                if (fieldName == "DiffValue") {
                    dDiffAmt = parseFloat($(this).attr("lbltag"));
                }
            });
            var listProds = {
                "ProdID": nProdID,
                "UomID": nUOMID,
                "HSN": strHSN,
                "ReasonId":nReasonID,
                "UomQty": dPTQty,
                "UomFreeQty": dPTFreeQty,
                "UomDamageQty": dPTDmgQty,
                "ProdDiscPern": PDPern,
                "TradeDiscPern": TDPern,
                "AddnlDiscPern": ADPern,
                "ProdDiscAmt": PDAmt,
                "TradeDiscAmt": TDAmt,
                "AddnlDiscAmt": ADAmt,
                "GrossAmt": dPTGross,
                "TaxAmt": dPTTax,
                "NetAmt": dPTNet,
                "Serial": nSerial,
                "DiffAmt": dDiffAmt
            }
            ProductArray.push(listProds);
            nSerial++;
        });
    }
    function SaveData() {
        if (SaveValidation()) {
            $("#btnSave").prop("disabled", true);
            addProdinArray();
            var listTrans = {
                "IsDraft": nIsDraft,
                "ID": $("#txtID").val(),
                "Date": $("#dtpDate").val(),
                "TransMode": nTransMode,
                "TransID": 1,
                "BranchID": $("#cmbBranch").val(),
                "DocID": $("#lblDocID").val(),
                //"DocValue": $("#txtID").val(),
                "VendorID": $("#txtVendorID").val(),
                "RefNo": $("#txtRefNo").val(),
                "ReturnType": $("#cmbReturnType").val(),
                "ProdGroupID": 0,
                "TaxTypeID": 1,
                "PaymentModeID": 7,
                "PaymentTermID": 0,
                "PriceID": $("#cmbPriceType").val(),//nPriceID,
                //"PaymentDate": $("#txtID").val(),
                "VehicleNo": "",
                "Frieght": document.getElementById("txtFright").getAttribute("txttag"),// $("#txtFright").val(),
                "OtherChargePern": document.getElementById("txtOtherChargPern").getAttribute("txttag"),//$("#txtOtherChargPern").val(),
                "OtherChargeAmt": document.getElementById("txtOtherChargAmt").getAttribute("txttag"),//$("#txtOtherChargAmt").val(),
                "ProdDiscPern": document.getElementById("txtProdDiscPern").getAttribute("txttag"),//$("#txtProdDiscPern").val(),
                "TradeDiscPern": document.getElementById("txtTradeDiscPern").getAttribute("txttag"),//$("#txtTradeDiscPern").val(),
                "AddnlDiscPern": document.getElementById("txtAddnlDiscPern").getAttribute("txttag"),//$("#txtAddnlDiscPern").val(),
                "TotalProdDiscAmt": document.getElementById("txtProdDiscAmt").getAttribute("txttag"),//$("#txtProdDiscAmt").val(),
                "TotalTradeDiscAmt": document.getElementById("txtTradeDiscAmt").getAttribute("txttag"),//$("#txtTradeDiscAmt").val(),
                "TotalAddnlDiscAmt": document.getElementById("txtAddnlDiscAmt").getAttribute("txttag"),//$("#txtAddnlDiscAmt").val(),
                "WriteOffAmt": document.getElementById("txtWriteoff").getAttribute("txttag"),//$("#txtWriteoff").val(),
                "TCSTaxAmt": document.getElementById("txtTCS").getAttribute("txttag"),//$("#txtTCS").val(),
                "TDSAmount": document.getElementById("txtTDS").getAttribute("txttag"),//$("#txtTDS").val(),
                "RoundOffAmt": document.getElementById("txtRoundOff").getAttribute("txttag"),//$("#txtRoundOff").val(),
                "GrossAmt": document.getElementById("lblPTGross").getAttribute("lbltag"),//$("#lblPTGross").text(),
                "TaxAmt": document.getElementById("lblPTTax").getAttribute("lbltag"),//$("#lblPTTax").text(),
                "NetAmt": document.getElementById("lblRoundNet").getAttribute("lbltag"),//$("#lblRoundNet").text(),
                "DiffValueGross": document.getElementById("txtDiffExcl").getAttribute("txttag"),
                "DiffValueNet": document.getElementById("txtDiffIncl").getAttribute("txttag"),
                "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : $("#txtStatus").val(),
                "CurrentStatus": $("#txtStatus").val(),
                //"UDFId": $("#txtID").val(),
                "CBy": UID,
                //"TransactionType": $("#txtID").val(),
                //"DateBill": $("#txtID").val(),
                "Remarks": $("#txtRemarks").val(),
                "Narration": $("#txtNarration").val(),
                "DraftID": $("#txtDraftID").val() == "" ? 0 : $("#txtDraftID").val(),
                "lstBatchInfo": BatchAcceptArray,
                "lstProdInfo": ProductArray
            }
            $.ajax({
                url: Aurl + "purchasereturn/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(listTrans),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (nIsDraft == 0) {
                                if (nTransMode != 4) {
                                    if (allowprint == 1) {
                                        PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                    } else if (allowprint == 3 || allowprint == 4) {
                                        PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                    }
                                    //if (SendAutoMail == 1)
                                    {
                                        //EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                        AutoEmailDocument(items.ID, PrintTransID);
                                    }
                                }
                                ClearForm();
                            }
                            else {
                                $("#txtDraftID").val(items.ID);
                            }
                        }
                        else if (items.MsgID == 2) {
                            showErrorSnackbar(items.Message);
                            $("#tblProductData tbody tr").each(function () {
                                var RIndex = (ProductTable.row($(this)).index());
                                var rowdata = ProductTable.row($(this)).data();
                                var ProdID = rowdata[0];
                                var itemfield = $(rowdata[7]);
                                var itemname = itemfield[0].value;
                                $(this).css("color", "black");
                                $(this).find("p,label,input, select").animate({ color: 'black' }, 100);
                                if (ProdID == items.RowID) {
                                    $(this).css("color", "red");
                                    $(this).find("p,label,input, select").animate({ color: 'red' }, 1000);
                                    showErrorSnackbar("Error in Product : " + itemname);
                                }
                            });
                        }
                        else {
                            //$("#dvErrorName").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
        }
    }
    $("#btnSave").click(function () {
        //SaveData()
        nIsDraft = 0;
        if (cfFocus != 3) {
            ConfirmDialogMsg("Do you want to save data?");
        } else {
            SaveData();
        }
    });


    if ($("#txtID").val() > 0 && $("#txtTransType").val() == 1) {//Home Draft to New PR
        $("#txtDraftID").val($("#txtID").val())
        var ID = $("#txtID").val();
        GetProductViewData(11, ID);
        nTransMode = 1;
        //$(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#btnClear").prop("disabled", true);
        $("#dvMain").show();
        $("#dvDocuments").hide();
        $("#btnPrint,#btnPreview,#btnPDF,#btnEmail,#btnWhatsapp").hide();
        $("#MainHeading").text("Create Purchase Return");
        setTimeout(() => {
            var DocDate = $("#dtpDate").val();
            var Branch = $("#cmbBranch").val();
            GetDocumentID(DocDate, Branch, 12);
        }, 1000);
    }
    if ($("#txtID").val() > 0 && $("#txtTransType").val() == 2) {//Home Quick Access View
        var ID = $("#txtID").val();
        nTransMode = 5;
        GetProductViewData(7, ID);
        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
        $("#dvMain").show();
        $("#btnEmail,#btnWhatsapp").show();
        $("#dvDocuments").hide();
        $("#MainHeading").text("View Purchase Return");
    }
    if ($("#txtID").val() > 0 && $("#txtTransType").val() == 3) {//Trans Variant to New PR
        var ID = $("#txtID").val();
        var PartyID = $("#txtTransVariantPartyID").val();
        nTransMode = 1;       
        LoadPRVariantData(5, ID, PartyID);
        //$(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnClear,#btnPrint").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint,#btnClear").hide();
        $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
        $("#btnSave,#btnDraft,.dvSelectItems").show();
        $("#btnSave,#btnClose,#btnDraft").prop("disabled", false);
        $("#dvMain").show();
        $("#btnEmail,#btnWhatsapp").hide();
        $("#dvDocuments").hide();
        $("#balanceContainer").hide();
        if ($("#txtEnableBranch").val() == 1) {
            $("#cmbBranch").prop("disabled", true);
        }
        if ($("#txtEnableSaveButton").val() == 0) {
            $("#btnSave").hide();
        }
        $("#MainHeading").text("Create Purchase Return");
        setTimeout(() => {
            var DocDate = $("#dtpDate").val();
            var Branch = $("#cmbBranch").val();
            GetDocumentID(DocDate, Branch, 12);
        }, 1000);
    }
</script>