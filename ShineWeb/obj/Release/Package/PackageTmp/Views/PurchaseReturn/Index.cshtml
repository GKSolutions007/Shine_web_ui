    $("#txtAddnlDiscPern").change(function (e) {
        var value = e.target.value;
        updateInputColumn("txtAddnlDiscPern", value);
        CalculateAddnldiscpern(value)
        txtValuechanged = true;
    });
    $("#txtAddnlDiscAmt").change(function (e) {
        txtValuechanged = true;
        var value = e.target.value;
        updateInputColumn("txtAddnlDiscAmt", value);
        var dPTGross = 0, dPTTax = 0, dPTNet = 0, Proddiscamt = 0, Tradediscamt = 0, Addnldiscamt = 0;

        var goods = parseFloat(document.getElementById("lblPTGoods").getAttribute('lbltag'));
        var pdisc = parseFloat(document.getElementById("lblPTPDiscAmt").getAttribute('lbltag'));
        dPTGross = PurAddnlDiscb4Prod ? goods : goods - pdisc;
        var val = value != "" ? parseFloat(value) : 0;
        var damt = parseFloat((val / dPTGross) * 100);
        if (damt > 100 || damt < 0) {
            showErrorSnackbar("Invalid Discount Value");
            updateInputColumn("txtAddnlDiscPern", 0);
            updateInputColumn("txtAddnlDiscAmt", 0);
            CalculateAddnldiscpern(0);
        }
        else {
            updateInputColumn("txtAddnlDiscPern", damt);
            CalculateAddnldiscpern(damt);
        }
    });
    function CalculateAddnldiscpern(value) {
        var dPTGross = 0, dPTGoods = 0, dPTTax = 0, dPTNet = 0, Proddiscamt = 0, Tradediscamt = 0, Addnldiscamt = 0, Q1 = 0;
        $("#tblProductData tbody tr").each(function () {
            dPTGross = 0, dPTGoods = 0, dPTTax = 0, dPTNet = 0, Proddiscamt = 0, Tradediscamt = 0, Addnldiscamt = 0, Q1 = 0;
            var rowdata = ProductTable.row($(this)).data();
            var taxpern = parseFloat(rowdata[3]);
            var TInvoicePrice = parseFloat(rowdata[21]);
            var ProdID = rowdata[0];
            for (var i = 0; i < BatchAcceptArray.length; i++) {
                if (ProdID == BatchAcceptArray[i].ProdID) {
                    var grs = (parseFloat(BatchAcceptArray[i].Qty) + parseFloat(BatchAcceptArray[i].DmgQty)) * parseFloat(BatchAcceptArray[i].ReturnPrice);
                    var taxAmt = (parseFloat(BatchAcceptArray[i].TaxPern) * grs) / 100;
                    var net = grs + taxAmt;
                    dPTGoods = (parseFloat(dPTGoods) + parseFloat(grs));
                    dPTGross = (parseFloat(dPTGross) + parseFloat(grs));
                    dPTTax = (parseFloat(dPTTax) + parseFloat(taxAmt));
                    dPTNet = (parseFloat(dPTNet) + parseFloat(net));
                }
            }
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Qty") {
                    Q1 = parseFloat($(this).attr("txttag"));
                }
            });
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "TradeDiscAmt") {
                    var val = $(this).attr("txttag") != "" ? parseFloat($(this).attr("txttag")) : 0;//$(this).val() != "" ? parseFloat($(this).val()) : 0;
                    Tradediscamt = val;
                }
                if (fieldName == "ProdDiscAmt") {
                    var val = $(this).attr("txttag") != "" ? parseFloat($(this).attr("txttag")) : 0;
                    Proddiscamt = val;
                }
                if (fieldName == "AddnlDiscAmt") {
                    $(this).prop("disabled", value > 0 ? true : false);
                    var val = value != "" ? parseFloat(value) : 0;
                    var damt = PurAddnlDiscb4Prod ? parseFloat(((val * dPTGross) / 100)) :
                        parseFloat(((val * (dPTGross - Proddiscamt)) / 100));
                    //$(this).val(damt);
                    updateInputColumn(fieldID, damt)
                    Addnldiscamt = damt;
                }
                if (fieldName == "AddnlDiscPern") {
                    $(this).prop("disabled", value > 0 ? true : false);
                    var val = parseFloat(value);
                    //$(this).val(val);
                    updateInputColumn(fieldID, val)
                    //setTagValue(fieldID, fieldName, value);
                }
            });
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                if (fieldName == "ProdDiscAmt") {
                    Proddiscamt = parseFloat($(this).attr("txttag"));
                }
                if (fieldName == "TradeDiscAmt") {
                    Tradediscamt = parseFloat($(this).attr("txttag"));
                }
                if (fieldName == "AddnlDiscAmt") {
                    Addnldiscamt = parseFloat($(this).attr("txttag"));
                }
            });
            var ApponMRPCum = $(this).find("label[name='ApponMRPCum']").attr("lbltag") || 0;
            var TotMRPonTaxAmt = $(this).find("label[name='TotalMRPonTax']").attr("lbltag") || 0;
            $(this).find("label").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Goods") {
                    var gds = parseFloat(dPTGross);
                    //$(this).text(gds);
                    updateLabelColumn(fieldID, gds);
                    dPTGoods = gds;
                }
                if (fieldName == "Gross") {
                    var grs = (parseFloat(dPTGross) - Tradediscamt - Addnldiscamt - Proddiscamt);
                    //$(this).text(grs);
                    updateLabelColumn(fieldID, grs);
                    dPTGross = grs;
                }
