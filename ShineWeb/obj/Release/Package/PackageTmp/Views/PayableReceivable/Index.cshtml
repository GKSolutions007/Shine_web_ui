    function ReloadF8Autolistdata(strForm, strSub, strValue, strAssignValue) {
        console.log("ReloadF8Autolistdata CALLED");
        console.log("str Assign Value Parameters:", strForm, strSub, strValue, strAssignValue);
        $.ajax({
            url: Aurl + "masterlist",
            type: 'get',
            contentType: 'json',
            data: {
                FormName: strForm, SubField: strSub, Value: strValue
            },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                console.log("MASTERLIST RESPONSE:", data);
                console.log("MASTERLIST RESPONSE JSON:", JSON.stringify(data));

                if (strForm == "partyname") {
                    arrPartyData = [], arrALPartyData = [], nIndexarrParty = 0;
                    $.each(data, function (i, items) {
                        var al = {
                            "id": items.FAID,
                            "label": items.Name,
                        }
                        arrALPartyData.push(al);
                        arrPartyData[nIndexarrParty] = items.Name;
                        nIndexarrParty++;
                    });

                    //~AutoList PartyName
                    PaginatedAutocomplete({
                        inputId: "txtPartyName",
                        data: arrALPartyData,
                        startwitfieldname: startwithfield,
                        enablefilterstartwith: autolistfilterwith,
                        onSelect: function (item) {
                            $("#txtPartyName").val(item.label);
                            return false;
                        }
                    });
                    $("#txtPartyName").val(strAssignValue);
                }
                else if (strForm == "accountname") {
                    arrALAccountData = [], arrAccountData = [], nIndexarrAccount = 0

                    $.each(data, function (i, items) {

                        var al = {
                            "id": items.FAID,
                            "label": items.Name,
                        }
                        arrALAccountData.push(al);
                        arrAccountData[nIndexarrAccount] = items.Name;
                        nIndexarrAccount++;
                    });
                    //~AutoList AccountName
                    PaginatedAutocomplete({
                        inputId: "txtAccountName",
                        data: arrALAccountData,
                        startwitfieldname: startwithfield,
                        enablefilterstartwith: autolistfilterwith,
                        onSelect: function (item) {
                            $("#txtAccountName").val(item.label);
                            return false;
                        }
                    });
                    $("#txtAccountName").val(strAssignValue);
                }
                else if (strForm == "tax") {
                    console.log("strForm matched return type");
                    $('#cmbTax').find("option").remove();
                    $('#cmbTax').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        console.log("Adding item:", items);
                        $('#cmbTax').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                        $('#cmbTax').val(strAssignValue);
                    });

                }
            }
        });
    }


    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        var IsValid = true, ChkFormation = true;
        //~Validation
        if ($("#txtBranchName").val() == 0) {
            IsValid = false;
            $("#divErrBranch").html("Select Branch");
            showErrorSnackbar("Select Branch");
        }
        if ($("#txtPartyName").val() != "") {
            const exists = arrPartyData.indexOf($("#txtPartyName").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#dvErrorPartyName").html("Select Party Name from list");
            }
        }
        else{
            IsValid = false;
            $("#dvErrorPartyName").html("Select Party Name from list");
        }
        //txtAccountName,dvErrorAccountName
        if ($("#txtAccountName").val() != "") {
            const exists = arrAccountData.indexOf($("#txtAccountName").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#dvErrorAccountName").html("Select Account Name from list");
            }
        } else {
            IsValid = false;
            $("#dvErrorAccountName").html("Select Account Name from list");
        }
        if ($("#txtValue").val() == "") {
            IsValid = false;
            $("#dvErrorValue").html("Value should not be empty");
            showErrorSnackbar("Value should not be empty");
        }
        else {
            var val = $("#txtNetAmt").val();
            if (parseFloat(val) <= 0) {
                IsValid = false;
                $("#dvErrorNetAmt").html("Net Amount should be greater than zero");
                showErrorSnackbar("Net Amount should be greater than zero");
            }
        }
        var vv = HSNValidation($("#txtSAC"), $("#divErrSAC"))
        if (!vv) {
            IsValid = false;
        }
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#dvErrorDate").html("Date should not be empty");
            showErrorSnackbar("Date should not be empty");
        }
        if ($('#cmbTax').val() == 0) {
            IsValid = false;
            $("#divErrTax").html("Select Tax");
            showErrorSnackbar("Select Tax");
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var nStatus = $("#txtStatus").val() !== "" ? $("#txtStatus").val() : 1;
        var lstMaster = {
            "TransID": FID,
            "TransMode": nTransMode,
            "ID": $("#txtID").val(),
            "DocDate": $("#dtpDate").val(),
            "RefNo": $("#txtRefNo").val(),
            "BranchID": $("#txtBranchName").val(),
            "PartyID": $("#txtPartyName").val(),
            "FAID": $("#txtAccountName").val(),
            "NoteValue": document.getElementById("txtValue").getAttribute("txttag"),
            "Remark": $("#txtRemarks").val(),
            "Narration": $("#txtNarration").val(),
            "UDFId": $("#cmbUDN").val(),

            "TaxID": $("#cmbTax").val(),
            "SACHSN": $("#txtSAC").val(),
            "DiscAmt": document.getElementById("txtDiscAmt").getAttribute("txttag"),
            "DiscPern": document.getElementById("txtDiscPern").getAttribute("txttag"),
            "GrossAmt": document.getElementById("txtGrossAmt").getAttribute("txttag"),
            "TaxAmt": document.getElementById("txtTaxAmt").getAttribute("txttag"),
            "RoundoffAmt": document.getElementById("txtRoundoffAmt").getAttribute("txttag"),
            "NetAmt": document.getElementById("txtNetAmt").getAttribute("txttag"),
            "TDSAmt": document.getElementById("txtTDS").getAttribute("txttag"),
            "TaxPern":taxPern,
            "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : nStatus,
            "CurrentStatus": nStatus,
            "CBy": UID
        };
            $.ajax({
                url: Aurl + "prvoucher/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (nTransMode != 4) {
                                if (allowprint == 1) {
                                    PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                } else if (allowprint == 3 || allowprint == 4) {
                                    PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                }
                                if (SendAutoMail == 1) {
                                    EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                }
                            }
                            ClearForm();
                            //GetData(2,"");
                            GetFilterData();
                            modal.hide();
                        }
                        else if (items.Message == "AccountName") {
                            $("#dvErrorName").html("Account Name Already Exists in another master");
                        }
                        else {
                            //$("#divErrorOnCode").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }
    //~View from another form(Home, Fin Rep Space click)
    if ($("#txtID").val() > 0 && $("#txtTransType").val() == 2) {
        nTransMode = 5;
        var ID = $("#txtID").val();
        setTimeout(() => {
            GetData(3, ID);
        }, 500);
        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
        $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
        $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
        $("#btnPreview,#btnPDF,#btnPrint").show();
        $("#btnEmail,#btnWhatsapp").show();
        $("#btnSave,#btnClear,#btnDraft").hide();
        $("#txtGrossAmt,#txtTaxAmt,#txtNetAmt").prop("disabled", true);
        $(".modal-title#lblPopupheading").text("View " + $("#txtFormName").val());
    }
</script>