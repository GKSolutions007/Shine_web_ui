        var DecVal = '@Session["DecimalValues"]';
function updateInputColumn(inputID, netValue) {
    //const label = document.getElementById(`dgvProdGross${rowId}`);
    const input = document.getElementById(inputID);
    var value = netValue != "" ? netValue : 0;
    input.setAttribute('txttag', parseFloat(value).toFixed(4));
    input.value = parseFloat(value).toFixed(DecVal);
    input.title = netValue;
}
    $(".txtsettag").focusin(function (e) {
        var id = e.target.id;
        const val = document.getElementById(id).getAttribute("txttag");
        $("#" + id).val(val);
        $("#" + id).select();
    });
    $(".txtsettag").blur(function (e) {
        var val = e.target.value;
        var id = e.target.id;
        updateInputColumn(id, val);
        if (id != "txtRoundoffAmt") {
            CalculateValues();
        } else {
            var GrossAmt = parseFloat(document.getElementById("txtGrossAmt").getAttribute("txttag"));
            var TaxAmt = parseFloat(document.getElementById("txtTaxAmt").getAttribute("txttag"));

            var rdfvalue = parseFloat(val);

            var net = parseFloat(GrossAmt + TaxAmt);
            updateInputColumn("txtNetAmt", rdfvalue + net);
        }
    });
    function CalculateValues() {
        var DiscAmt = 0, grs = 0, tax = 0, net = 0, dpern = 0;
        var Goods = document.getElementById("txtValue").getAttribute("txttag");//ReturnTagValue("txtValue", "");
        if (Goods > 0)
        {
            DiscAmt = document.getElementById("txtDiscAmt").getAttribute("txttag");//ReturnTagValue("txtDiscAmt", "");
            grs = parseFloat(Goods) - parseFloat(DiscAmt);
            tax = (grs * parseFloat(taxPern)) / 100;
            net = grs + tax;
            dpern = (parseFloat(DiscAmt) / parseFloat(Goods)) * 100;
        }
        updateInputColumn("txtDiscAmt", DiscAmt); updateInputColumn("txtDiscPern", dpern);
        updateInputColumn("txtGrossAmt", grs); updateInputColumn("txtTaxAmt", tax);
        var RoundNetAmt = ApplyRoundoff(net);
        var Roundoff = (RoundNetAmt - net);
        updateInputColumn("txtRoundoffAmt", Roundoff);
        updateInputColumn("txtNetAmt", RoundNetAmt);
    }
    function ApplyRoundoff(dAmt) {
        var Value = 0;
        if (ConfigRoundtype == 1) {//nearest
            Value = Math.round(dAmt)
        }
        else if (ConfigRoundtype == 2) {//lowest
            Value = Math.floor(dAmt)
        }
        else if (ConfigRoundtype == 3) {//highest
            Value = Math.ceil(dAmt)
        }
        return Value;
    }
