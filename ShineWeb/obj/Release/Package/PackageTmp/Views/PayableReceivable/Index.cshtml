    $('#dtpDate,#txtBranchName').on('focus', function () {
        $(this).data("oldvalue", $(this).val());
    });
    $("#dtpDate").change(function (e) {
        var DocDate = e.target.value;
        var id = e.target.id;
        var Branch = $("#txtBranchName").val();
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });

    $("#txtBranchName").change(function (e) {
        if (typeof GetDocumentID !== "function") return;
        var DocDate = $("#dtpDate").val();
        var Branch = e.target.value;
        var id = e.target.id;
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });


    function GetData(nMode,nID) {
        $.ajax({
            url: Aurl + "prvoucher/get",
            type: 'get',
            contentType: 'json',
            data: { TransID: FID, Mode: nMode, ID: nID },
            xhrFields: {
                withCredentials: true
            },
            async:false,
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbUDN,#cmbTax,#txtBranchName').find("option").remove();
                    $('#cmbUDN,#cmbTax,#txtBranchName').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrPartyData = [], arrAccountData = [], arrBranchData = [], arrTax = [], arrALPartyData = [], arrALAccountData = [], arrALBranchData = [];
                    nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch = 0;
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            var al = {
                                "id": items.ID,
                                "label": items.Name,
                            }
                            arrALPartyData.push(al);
                            arrPartyData[nIndexarrParty] = items.Name;
                            nIndexarrParty++;
                        }
                        if (items.FType == 2) {
                            var al = {
                                "id": items.ID,
                                "label": items.Name,
                            }
                            arrALAccountData.push(al);
                            arrAccountData[nIndexarrAccount] = items.Name;
                            nIndexarrAccount++;
                        }
                        if (items.FType == 3) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            $("#lblDocID").text(items.Name);
                        }
                        if (items.FType == 5) {
                            var tlist = {
                                "ID": items.ID,
                                "Name": items.Name,
                                "Value":items.Code
                            }
                            arrTax.push(tlist);
                            $('#cmbTax').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                    });
                    SetAutlistforFields();
                    //$("#txtBranchName").val(DefBranch);
                    LoadBranchByRoles('#txtBranchName,#cmbFilterBranch')
                }
                if (nMode == 3) {
                    //~Assign Data
                    $.each(data, function (i, items) {
                        if (nTransMode != 3)
                            $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);

                        $("#txtID").val(items.ID), $("#dtpDate").val(items.DocDate),
                            $("#txtRefNo").val(items.RefNo), $("#txtBranchName").val(items.BranchID), $("#txtPartyName").val(items.PartyID), $("#txtAccountName").val(items.FAID),
                            $("#txtRemarks").val(items.Remark), $("#txtNarration").val(items.Narration), $("#cmbUDN").val(items.UDFId),
                            $("#txtStatus").val(items.Status), $("#cmbTax").val(items.TaxID), $("#txtSAC").val(items.SACHSN);

                        updateInputColumn("txtValue", items.NoteValue);
                        updateInputColumn("txtDiscAmt",  items.DiscAmt); updateInputColumn("txtDiscPern",  items.DiscPern);
                        updateInputColumn("txtGrossAmt", items.GrossAmt); updateInputColumn("txtTaxAmt",  items.TaxAmt);
                        updateInputColumn("txtNetAmt", items.NetAmt); updateInputColumn("txtTDS", items.TDSAmt);
                        updateInputColumn("txtRoundoffAmt", items.RoundoffAmt);

                        taxPern = items.TaxPern;
                        modal.show();
                    });
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#txtBranchName").prop("disabled", true);
                    }
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $('#btnTEdit').click(function (e) {
        var Did = $("#txtID").val();
        var Currsts = $("#txtStatus").val();
        $(".clrdivs").html("");
        var rowinfo = {
            ID: Did,
            CurrentStatus: $("#txtStatus").val()
        }
        $.ajax({
            url: Aurl + "validatedocument",
            type: 'get',
            contentType: 'json',
            data: { ActionType: 1, TransID: FID, ID: Did, Status: Currsts },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        EditActionTrigger(rowinfo);
                    }
                    else {
                        showErrorSnackbar(items.Message)
                    }
                });
            }
        });
    });
    function EditActionTrigger(rowData) {
        nTransMode = 2;
        GetData(3, rowData.ID);
