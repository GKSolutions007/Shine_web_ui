    // ---------------------------------------------------------------
    // Export visible rows to Excel (.xlsx) using SheetJS
    // Captures all entered values, pay info, and column filters state.
    // File name: Bulkcollection_YYYYMMDDHHmmssSSS.xlsx
    // ---------------------------------------------------------------
    function exportToExcel() {
        // Build datetime suffix: YYYYMMDDHHmmssSSS
        var now = new Date();
        var pad = function (v, n) { return String(v).padStart(n || 2, '0'); };
        var suffix = String(now.getFullYear()) +
            pad(now.getMonth() + 1) + pad(now.getDate()) +
            pad(now.getHours()) + pad(now.getMinutes()) +
            pad(now.getSeconds()) + pad(now.getMilliseconds(), 3);
        var fileName = 'Bulkcollection_' + suffix + '.xlsx';

        // --- Column definitions (header label + data extractor) ---
        var columns = [
            { header: '#',            get: function ($tr, idx) { return idx + 1; } },
            { header: 'Party Name',   get: function ($tr)      { return $tr.find('td[data-label="Party Name"] .cell-strong').attr('title') || $tr.find('td[data-label="Party Name"] .cell-strong').text().trim(); } },
            { header: 'Beat',         get: function ($tr)      {
                var txt = $tr.find('td[data-label="Party Name"]').text();
                // Beat is shown after BI geo-alt icon
                var parts = $tr.find('td[data-label="Party Name"]').clone();
                parts.find('.cell-strong, .badge-transname').remove();
                var lines = parts.text().replace(/\s+/g, ' ').trim().split(/\s{2,}/);
                // Extract from spans directly
                var spans = $tr.find('td[data-label="Party Name"] span');
                var beat = '', salesman = '';
                spans.each(function () {
                    var t = $(this).text().trim();
                    if ($(this).hasClass('bi-geo-alt') || $(this).hasClass('cell-strong') || $(this).hasClass('badge-transname')) return;
                    // The text node after bi-geo-alt and bi-person-fill spans
                });
                // Simpler: read raw text of the td and parse
                var rawText = $tr.find('td[data-label="Party Name"]').clone();
                // Use the span texts in order
                var allSpans = $tr.find('td[data-label="Party Name"]').find('span');
                var beatVal = '', salesmanVal = '';
                allSpans.each(function (i, el) {
                    var cls = $(el).attr('class') || '';
                    var t = $(el).text().trim();
                    if (cls.indexOf('bi-geo-alt') !== -1) beatVal = t.replace(/^[\s\u00a0]+/, '');
                    if (cls.indexOf('bi-person-fill') !== -1) salesmanVal = t.replace(/^[\s\u00a0]+/, '');
                });
                return beatVal;
            }},
            { header: 'Salesman',     get: function ($tr) {
                var allSpans = $tr.find('td[data-label="Party Name"]').find('span');
                var salesmanVal = '';
                allSpans.each(function (i, el) {
                    var cls = $(el).attr('class') || '';
                    if (cls.indexOf('bi-person-fill') !== -1) salesmanVal = $(el).text().replace(/^[\s\u00a0]+/, '').trim();
                });
                return salesmanVal;
            }},
            { header: 'Doc ID',       get: function ($tr) { return $tr.find('td[data-label="Doc ID"]').clone().find('.badge-transname').remove().end().text().trim(); } },
            { header: 'Trans Type',   get: function ($tr) { return $tr.attr('data-transname') || ''; } },
            { header: 'Date',         get: function ($tr) { return $tr.find('td[data-label="Date"]').text().trim(); } },
            { header: 'Ref No',       get: function ($tr) { return $tr.find('td[data-label="Ref No"]').text().trim(); } },
            { header: 'Net \u20b9',   get: function ($tr) { return parseFloat($tr.attr('data-net')) || 0; }, numeric: true },
            { header: 'Balance',      get: function ($tr) { return parseFloat($tr.attr('data-balance')) || 0; }, numeric: true },
            { header: 'Cash \u20b9',  get: function ($tr) { return parseFloat($tr.find('.inp-cashamt').val()) || 0; }, numeric: true },
            { header: 'Chq/BT \u20b9', get: function ($tr) { return parseFloat($tr.find('.inp-chqbtamt').val()) || 0; }, numeric: true },
            { header: 'Pay Mode',     get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                if (!payments.length) return '';
                return payments[0].mode === '2' ? 'Cheque' : (payments[0].mode === '4' ? 'Bank Transfer' : '');
            }},
            { header: 'Pay Amount',   get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return payments.length ? (parseFloat(payments[0].amount) || 0) : 0;
            }, numeric: true },
            { header: 'Chq No',       get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return (payments.length && payments[0].mode === '2') ? (payments[0].chqNo || '') : '';
            }},
            { header: 'Chq Date',     get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return (payments.length && payments[0].mode === '2') ? (payments[0].chqDate || '') : '';
            }},
            { header: 'Bank',         get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return (payments.length && payments[0].mode === '2') ? (payments[0].bank || '') : '';
            }},
            { header: 'Branch',       get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return (payments.length && payments[0].mode === '2') ? (payments[0].branch || '') : '';
            }},
            { header: 'IFSC',         get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return (payments.length && payments[0].mode === '2') ? (payments[0].ifsc || '') : '';
            }},
            { header: 'BT Bank Acc',  get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return (payments.length && payments[0].mode === '4') ? (payments[0].bankAcc || '') : '';
            }},
            { header: 'BT Ref No',    get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return (payments.length && payments[0].mode === '4') ? (payments[0].refNo || '') : '';
            }},
            { header: 'BT Transfer Mode', get: function ($tr) {
                var faid = $tr.attr('data-faid');
                var payments = getFaidPayments(faid);
                return (payments.length && payments[0].mode === '4') ? (payments[0].transferMode || '') : '';
            }},
            { header: 'Disc %',       get: function ($tr) { return parseFloat($tr.find('.inp-discpct').val()) || 0; }, numeric: true },
            { header: 'Disc \u20b9',  get: function ($tr) { return parseFloat($tr.find('.inp-discamt').val()) || 0; }, numeric: true },
            { header: 'Other %',      get: function ($tr) { return parseFloat($tr.find('.inp-otherpct').val()) || 0; }, numeric: true },
            { header: 'Other \u20b9', get: function ($tr) { return parseFloat($tr.find('.inp-otheramt').val()) || 0; }, numeric: true },
            { header: 'Adjusted \u20b9', get: function ($tr) {
                var v = parseFloat($tr.find('.lbl-adjusted').text());
                return isNaN(v) ? 0 : v;
            }, numeric: true },
            { header: 'Status',       get: function ($tr) { return $tr.find('.badge-status').text().trim(); } }
        ];

        // --- Collect filter context for info sheet ---
        var filterBeat     = $('#txtBeat').val() || '';
        var filterSalesman = $('#txtSalesman').val() || '';
        var filterCustomer = $('#txtCustomer').val() || '';
        var filterDate     = $('#txtAsonDate').val() || '';
        var filterSearch   = $('#txtSearchRow').val() || '';
        var filterTabs     = activeTransNames.length ? activeTransNames.join(', ') : 'All';
        var collDate       = $('#dtpDate').val() || '';

        // --- Collect only VISIBLE rows ---
        var visibleRows = [];
        $('#tblBody tr:visible').each(function () {
            visibleRows.push($(this));
        });

        if (!visibleRows.length) {
            toast('No visible rows to export.', 'warning');
            return;
        }

        // --- Build data array for main sheet ---
        var headers = columns.map(function (c) { return c.header; });
        var dataRows = visibleRows.map(function ($tr, i) {
            return columns.map(function (col) { return col.get($tr, i); });
        });

        // --- Build totals footer row ---
        var numericColIdxs = {};
        columns.forEach(function (col, i) { if (col.numeric) numericColIdxs[i] = true; });
        var totalsRow = columns.map(function (col, i) {
            if (i === 0) return 'TOTAL';
            if (!col.numeric) return '';
            var sum = 0;
            dataRows.forEach(function (row) { sum += parseFloat(row[i]) || 0; });
            return parseFloat(sum.toFixed(2));
        });

        // --- Assemble worksheet data ---
        var wsData = [headers].concat(dataRows).concat([totalsRow]);

        var wb = XLSX.utils.book_new();

        // Main data sheet
        var ws = XLSX.utils.aoa_to_sheet(wsData);

        // Column widths
        var colWidths = [4, 28, 18, 18, 12, 16, 10, 11, 11, 11, 12, 11, 10, 11, 10, 12, 16, 14, 14, 16, 12, 16, 8, 11, 8, 11, 12, 10];
        ws['!cols'] = colWidths.map(function (w) { return { wch: w }; });

        // Style header row and totals (SheetJS CE supports basic cell types; full style needs xlsx-style or pro)
        // We set types explicitly for numeric cells so Excel recognises them as numbers
        dataRows.forEach(function (row, ri) {
            columns.forEach(function (col, ci) {
                if (col.numeric) {
                    var cellAddr = XLSX.utils.encode_cell({ r: ri + 1, c: ci });
                    if (ws[cellAddr]) ws[cellAddr].t = 'n';
                }
            });
        });

        XLSX.utils.book_append_sheet(wb, ws, 'Bulk Collection');

        // --- Filter Info sheet ---
        var infoData = [
            ['Export Info', ''],
            ['Exported At',  now.toLocaleString()],
            ['File Name',    fileName],
            ['', ''],
            ['Applied Filters', ''],
            ['Beat',         filterBeat || '(all)'],
            ['Salesman',     filterSalesman || '(all)'],
            ['Customer',     filterCustomer || '(all)'],
            ['As on Date',   filterDate || '(all)'],
            ['Collection Date', collDate || ''],
            ['Trans Type Tab', filterTabs],
            ['Row Search',   filterSearch || '(none)'],
            ['', ''],
            ['Summary', ''],
            ['Visible Rows', visibleRows.length],
        ];
        // Add footer totals summary
        columns.forEach(function (col, i) {
            if (col.numeric && i > 0) {
                infoData.push([col.header, totalsRow[i]]);
            }
        });

        var wsInfo = XLSX.utils.aoa_to_sheet(infoData);
        wsInfo['!cols'] = [{ wch: 20 }, { wch: 35 }];
        XLSX.utils.book_append_sheet(wb, wsInfo, 'Export Info');

        // --- Trigger download ---
        XLSX.writeFile(wb, fileName);
        toast('Exported ' + visibleRows.length + ' rows to ' + fileName, 'success');
    }

