    // ---------------------------------------------------------------
    // TransName tab filter + text search  (both work together)
    // Multiple transaction tabs can be selected simultaneously.
    // Clicking a non-All tab toggles it; clicking All resets all.
    // ---------------------------------------------------------------
    var activeTransNames = [];  // empty = "All"

    function buildTransNameTabs() {
        // Collect unique TransNames from all rows
        var counts = { All: 0 };
        $('#tblBody tr').each(function () {
            var tn = $(this).attr('data-transname') || '';
            counts.All++;
            if (tn) {
                counts[tn] = (counts[tn] || 0) + 1;
            }
        });

        // Build tab HTML — All first, then sorted alphabetically
        var names = Object.keys(counts).filter(function (k) { return k !== 'All'; }).sort();
        var html = '';

        // "All" tab
        var allActive = (activeTransNames.length === 0) ? ' active' : '';
        html += '<button type="button" class="bc-tab all-tab' + allActive + '" data-transname="All">' +
            'All<span class="tab-count">' + counts['All'] + '</span>' +
            '</button>';

        names.forEach(function (name) {
            var isActive = (activeTransNames.indexOf(name) !== -1) ? ' active' : '';
            html += '<button type="button" class="bc-tab' + isActive + '" data-transname="' + escHtml(name) + '">' +
                escHtml(name) +
                '<span class="tab-count">' + counts[name] + '</span>' +
                '</button>';
        });

        $('#transnameTabs').html(html);
        $('#dvTransTabs').show();
    }

    // Tab click — toggle individual tabs; All resets selection
    $(document).on('click', '.bc-tab', function () {
        var name = $(this).attr('data-transname');

        if (name === 'All') {
            activeTransNames = [];
            $('.bc-tab').removeClass('active');
            $(this).addClass('active');
        } else {
            // Deactivate the All tab
            $('.bc-tab.all-tab').removeClass('active');

            var idx = activeTransNames.indexOf(name);
            if (idx === -1) {
                activeTransNames.push(name);
                $(this).addClass('active');
            } else {
                activeTransNames.splice(idx, 1);
                $(this).removeClass('active');
            }

            // If nothing is selected, revert to All
            if (activeTransNames.length === 0) {
                $('.bc-tab.all-tab').addClass('active');
            }
        }

        applyRowFilters();
    });

    // Combined filter: text search + active TransName tabs (multi-select)
    function applyRowFilters() {
        var q = $('#txtSearchRow').val().trim().toLowerCase();
        $('#tblBody tr').each(function () {
            var $tr = $(this);
            var tn = $tr.attr('data-transname') || '';
            var matchTab = (activeTransNames.length === 0) || (activeTransNames.indexOf(tn) !== -1);
            var hay = $tr.find('td').slice(1, 5).text().toLowerCase();
            var matchSearch = !q || (hay.indexOf(q) !== -1);
            $tr.toggle(matchTab && matchSearch);
        });
    }

    // Text search now calls the combined filter
    $('#txtSearchRow').on('input', function () {
        applyRowFilters();
    });

