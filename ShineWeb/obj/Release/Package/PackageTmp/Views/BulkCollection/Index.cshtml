    $('input[type=number]').on('focusin', function () { $(this).select(); });

    // ---------------------------------------------------------------
    // Multiple payment methods modal
    // Rules:
    //   • Only Cheque or Bank Transfer are allowed.
    //   • Only ONE mode may exist per document — once a mode is added
    //     the selector is locked to that mode and the other is hidden.
    //   • Cheque mandatory: Amount, Cheque No, Cheque Date
    //     Optional: Bank (dropdown), Branch, IFSC
    //   • Bank Transfer mandatory: Amount, Bank Account, Neft/Ref No, Transfer Mode
    // ---------------------------------------------------------------
    $('#tblBody').on('click', '.btn-collect', function () {
        openPaymentsModal($(this).closest('tr'));
    });

    function getLockedMode($tr) {
        var payments = getPayments($tr);
        return payments.length ? payments[0].mode : null;
    }

    // ── FAID cumulative balance helpers ──────────────────────────────
    // Sum the Chq/BT amounts already entered across ALL rows sharing the
    // same FAID (this is what's been "committed" as Chq/BT for that FAID).
    function getFaidChqBTTotal(faid, excludeRow) {
        var total = 0;
        $('#tblBody tr').each(function () {
            var $r = $(this);
            if (excludeRow && $r.is(excludeRow)) return;
            if ($r.attr('data-faid') == faid) {
                total += parseFloat($r.find('.inp-chqbtamt').val()) || 0;
            }
        });
        return total;
    }

    // Cumulative balance = sum of all row balances for the same FAID.
    function getFaidCumulativeBalance(faid) {
        var total = 0;
        $('#tblBody tr').each(function () {
            var $r = $(this);
            if ($r.attr('data-faid') == faid) {
                total += parseFloat($r.attr('data-balance')) || 0;
            }
        });
        return total;
    }

    // Returns the shared payments array stored on the first row of this FAID.
    // All rows with the same FAID share a single payments list.
    function getFaidPayments(faid) {
        var $first = $('#tblBody tr[data-faid="' + faid + '"]').first();
        if (!$first.length) return [];
        return getPayments($first);
    }

    function setFaidPayments(faid, arr) {
        $('#tblBody tr[data-faid="' + faid + '"]').each(function () {
            setPayments($(this), arr);
        });
    }

    function togglePayFieldsForMode(mode) {
        // Cheque fields
        $('#payChqNoWrap, #payChqDateWrap, #payChqBankWrap, #payChqBranchWrap, #payChqIfscWrap')
            .toggle(mode === '2');
        // Bank Transfer fields
        $('#payBTBankAccWrap, #payBTRefNoWrap, #payBTTransferModeWrap')//, #payChqDateWrap
            .toggle(mode === '4');
    }

    function applyModeLock($tr) {
        var faid = $tr.attr('data-faid');
        var payments = getFaidPayments(faid);
        var locked = payments.length ? payments[0].mode : null;
        var $sel = $('#paymodeMode');
        if (locked) {
            $sel.val(locked).prop('disabled', true);
            $sel.find('option').each(function () {
                if ($(this).val() !== locked) {
                    $(this).prop('disabled', true);
                }
            });
        } else {
            $sel.val('2').prop('disabled', false);
            $sel.find('option').prop('disabled', false);
        }
        togglePayFieldsForMode(locked || $sel.val());
    }

    $('#paymodeMode').on('change', function () {
        togglePayFieldsForMode($(this).val());
    });

    function resetPayForm() {
        $('#paymodeMode').val('Cheque').prop('disabled', false);
        $('#paymodeMode option').prop('disabled', false);
        $('#paymodeAmount').val('');
