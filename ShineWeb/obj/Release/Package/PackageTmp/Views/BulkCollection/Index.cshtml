    function openPaymentsModal($tr) {
        paymentsTargetRow = $tr;
        var faid = $tr.attr('data-faid');
        var docId = $tr.find('td[data-label="Doc ID"]').text().trim();
        var party = $tr.find('td[data-label="Party Name"]').text().trim();
        $('#payModalSub').text(party);// + ' \u2014 FAID: ' + faid

        $('#paymodeBTBankAcc').val(DefBankAcc);
        resetPayForm();
        applyModeLock($tr);


        // Pre-fill existing payment details if already entered
        var existingPayments = getFaidPayments(faid);
        if (existingPayments.length > 0) {
            var p = existingPayments[0];
            $('#paymodeMode').val(p.mode).prop('disabled', true);
            $('#paymodeAmount').val(p.amount ? parseFloat(p.amount).toFixed(DecVal) : '');
            if (p.mode === '2') {
                $('#paymodeChqNo').val(p.chqNo || '');
                $('#paymodeChqDate').val(p.chqDate || getCurrentDate());
                $('#paymodeChqBank').val(p.bank || '');
                $('#paymodeChqBranch').val(p.branch || '');
                $('#paymodeChqIfsc').val(p.ifsc || '');
            } else if (p.mode === '4') {
                $('#paymodeBTBankAcc').val(p.bankAcc || '');
                $('#paymodeBTRefNo').val(p.refNo || '');
                $('#paymodeBTTransferMode').val(p.transferMode || '');
