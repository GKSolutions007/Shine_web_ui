    $('#btnSave').on('click', function () {
        var rows = $('#tblBody tr');
        if (!rows.length) {
            toast('No documents to save.', 'warning');
            return;
        }

        var payload = [];
        rows.each(function () {
            var $tr = $(this);
            payload.push({
                TransID: $tr.attr('data-transid'),
                ID: $tr.attr('data-id'),
                FAID: $tr.attr('data-faid'),
                Balance: parseFloat($tr.attr('data-balance')) || 0,
                CashAmt: parseFloat($tr.find('.inp-cashamt').val()) || 0,
                ChqBTAmt: parseFloat($tr.find('.inp-chqbtamt').val()) || 0,
                DiscPct: parseFloat($tr.find('.inp-discpct').val()) || 0,
                DiscAmt: parseFloat($tr.find('.inp-discamt').val()) || 0,
                OtherPct: parseFloat($tr.find('.inp-otherpct').val()) || 0,
                OtherAmt: parseFloat($tr.find('.inp-otheramt').val()) || 0,
                Payments: getPayments($tr)
            });
        });

        // TODO: point this at your real save endpoint.
        $.ajax({
            url: Aurl + 'api/BulkCollection/SaveCollection',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ UserID: UID, BranchID: DefBranch, Rows: payload }),
            success: function () {
                toast('Collection saved successfully.', 'success');
            },
            error: function () {
                console.log('Save payload (connect your API in the btnSave handler):', payload);
                toast('Could not reach the Save API — payload logged to console for now.', 'warning');
            }
        });
    });

    // ---------------------------------------------------------------
    // Keyboard navigation
    //   • Enter / Arrow Down  → move to next input in same column (table)
    //                           or next field in the filter bar
    //   • Arrow Up            → move to previous input in same column (table)
    //   • Shift+Enter         → move backwards (filter bar)
    // ---------------------------------------------------------------

    // Returns all visible, enabled inputs in column order for the table.
    // For the filter bar, returns the filter fields in DOM order.
    function getNavigableFields() {
        return $('#txtBeat,#txtSalesman,#txtCustomer,#txtAsonDate,#dtpDate')
            .filter(':visible:not(:disabled)').toArray();
    }

    // Given an <input> inside a table row, find the input in the same
    // column of the adjacent row (direction: +1 = down, -1 = up).
    function navigateTableCell($input, direction) {
        var $td   = $input.closest('td');
        var $tr   = $td.closest('tr');
        var colIdx = $td.index();           // which <td> are we in?

        var $targetRow = direction === 1 ? $tr.next('tr') : $tr.prev('tr');
        if (!$targetRow.length) return null;

        // Walk through subsequent columns if the matched column has no
        // visible+enabled input (e.g. a disabled disc field).
        var totalCols = $targetRow.find('td').length;
        for (var c = colIdx; c < totalCols && c >= 0; c += direction) {
            var $targetTd = $targetRow.find('td').eq(c);
            var $inp = $targetTd.find('input:visible:not(:disabled)');
            if ($inp.length) return $inp[0];
        }
        return null;
    }

    $(document).on('keydown', function (e) {
        var key = e.key;
        var isEnter = (key === 'Enter');
        var isDown  = (key === 'ArrowDown');
        var isUp    = (key === 'ArrowUp');

        if (!isEnter && !isDown && !isUp) return;

        // ── Inside the payments modal ──────────────────────────────
        if ($(e.target).closest('#modalPayments').length) {
            if (e.target.tagName.toLowerCase() === 'textarea') return;
            if (isEnter) {
                e.preventDefault();
                $('#btnAddPayment').trigger('click');
            }
            return;
        }

        var $t = $(e.target);
        if (!$t.is('input,select')) return;

        // ── Inside the data table ──────────────────────────────────
        if ($t.closest('#tblBody').length) {
            if (isDown || isEnter) {
                e.preventDefault();
                var next = navigateTableCell($t, 1);
                if (next) { next.focus(); if (next.select) next.select(); }
                return;
            }
            if (isUp) {
                e.preventDefault();
                var prev = navigateTableCell($t, -1);
                if (prev) { prev.focus(); if (prev.select) prev.select(); }
                return;
            }
            return;
        }

        // ── Filter bar (Enter only) ────────────────────────────────
        if (isEnter) {
            e.preventDefault();
            var fields = getNavigableFields();
            var idx = fields.indexOf(e.target);
            if (idx === -1) return;
            var nextIdx = e.shiftKey ? idx - 1 : idx + 1;
            var nextFld = fields[nextIdx];
            if (nextFld) { nextFld.focus(); if (nextFld.select) nextFld.select(); }
        }
    });

    $('#trFooter').show();
</script>
