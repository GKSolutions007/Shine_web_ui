    $('input[type=number]').on('focusin', function () { $(this).select(); });

    // ---------------------------------------------------------------
    // Multiple payment methods modal
    // Rules:
    //   • Only Cheque or Bank Transfer are allowed.
    //   • Only ONE mode may exist per document — once a mode is added
    //     the selector is locked to that mode and the other is hidden.
    //   • Cheque mandatory: Amount, Cheque No, Cheque Date
    //     Optional: Bank (dropdown), Branch, IFSC
    //   • Bank Transfer mandatory: Amount, Bank Account, Neft/Ref No, Transfer Mode
    // ---------------------------------------------------------------
    $('#tblBody').on('click', '.btn-collect', function () {
        openPaymentsModal($(this).closest('tr'));
    });

    function getLockedMode($tr) {
        var payments = getPayments($tr);
        return payments.length ? payments[0].mode : null;
    }

    function togglePayFieldsForMode(mode) {
        // Cheque fields
        $('#payChqNoWrap, #payChqDateWrap, #payChqBankWrap, #payChqBranchWrap, #payChqIfscWrap')
            .toggle(mode === 'Cheque');
        // Bank Transfer fields
        $('#payBTBankAccWrap, #payBTRefNoWrap, #payBTTransferModeWrap')
            .toggle(mode === 'BankTransfer');
    }

    function applyModeLock($tr) {
        var locked = getLockedMode($tr);
        var $sel = $('#paymodeMode');
        if (locked) {
            $sel.val(locked).prop('disabled', true);
            // Hide the un-used mode option visually
            $sel.find('option').each(function () {
                if ($(this).val() !== locked && $(this).val() !== '') {
                    $(this).prop('disabled', true).hide();
                }
            });
        } else {
            $sel.val('').prop('disabled', false);
            $sel.find('option').prop('disabled', false).show();
        }
        togglePayFieldsForMode(locked || '');
    }

    $('#paymodeMode').on('change', function () {
        togglePayFieldsForMode($(this).val());
    });

    function resetPayForm() {
        $('#paymodeMode').val('').prop('disabled', false);
        $('#paymodeMode option').prop('disabled', false).show();
        $('#paymodeAmount').val('');
        // Cheque
        $('#paymodeChqNo').val('');
        $('#paymodeChqDate').val('');
        $('#paymodeChqBank').val('');
        $('#paymodeChqBranch').val('');
        $('#paymodeChqIfsc').val('');
        // Bank Transfer
        $('#paymodeBTBankAcc').val('');
        $('#paymodeBTRefNo').val('');
        $('#paymodeBTTransferMode').val('');
        // Hide all mode-specific wrappers
        togglePayFieldsForMode('');
    }

    function openPaymentsModal($tr) {
        paymentsTargetRow = $tr;
        var docId = $tr.find('td[data-label="Doc ID"]').text();
        var party = $tr.find('td[data-label="Party Name"]').text();
        $('#payModalSub').text(party + ' \u2014 ' + docId);

        resetPayForm();
        applyModeLock($tr);
        renderPaymentsModalList();
        $('#modalPayments').css('display', 'flex');
        setTimeout(function () { $('#paymodeAmount').focus(); }, 50);
    }

    function closePaymentsModal() {
        $('#modalPayments').css('display', 'none');
        paymentsTargetRow = null;
    }

    function renderPaymentsModalList() {
        if (!paymentsTargetRow) return;
        var balance = parseFloat(paymentsTargetRow.attr('data-balance')) || 0;
        var payments = getPayments(paymentsTargetRow);
        var added = sumPayments(payments);
        var remaining = Math.max(0, balance - added);

        $('#paySummaryBalance').text(formatNum(balance));
        $('#paySummaryAdded').text(formatNum(added));
        $('#paySummaryRemaining').text(formatNum(remaining));

        if (!payments.length) {
            $('#payList').html('<div class="pay-empty">No payment entry added yet.</div>');
            return;
        }

        var html = '';
        payments.forEach(function (p, i) {
            var modeLabel = p.mode === 'BankTransfer' ? 'Bank Transfer' : p.mode;
            var meta = '';
            if (p.mode === 'Cheque') {
                if (p.chqNo)   meta += ' &middot; Chq: ' + escHtml(p.chqNo);
                if (p.chqDate) meta += ' &middot; ' + escHtml(p.chqDate);
                if (p.bank)    meta += ' &middot; ' + escHtml(p.bank);
            } else {
                if (p.refNo)       meta += ' &middot; Ref: ' + escHtml(p.refNo);
                if (p.transferMode) meta += ' &middot; ' + escHtml(p.transferMode);
                if (p.bankAcc)     meta += ' &middot; ' + escHtml(p.bankAcc);
            }
            html += '<div class="pay-list-item">' +
                '<span><span class="mode-chip">' + escHtml(modeLabel) + '</span>₹' + formatNum(p.amount) +
                (meta ? '<span class="meta">' + meta + '</span>' : '') +
                '</span>' +
                '<button type="button" class="pay-del" data-idx="' + i + '" title="Remove"><i class="bi bi-trash3"></i></button>' +
                '</div>';
        });
        $('#payList').html(html);
    }

    $('#payList').on('click', '.pay-del', function () {
        if (!paymentsTargetRow) return;
        var idx = parseInt($(this).attr('data-idx'));
        var payments = getPayments(paymentsTargetRow);
        payments.splice(idx, 1);
        setPayments(paymentsTargetRow, payments);
        // Unlock mode selector if list is now empty
        applyModeLock(paymentsTargetRow);
        renderPaymentsModalList();
        recalcRow(paymentsTargetRow);
    });

    $('#btnAddPayment').on('click', function () {
        if (!paymentsTargetRow) return;
        var balance  = parseFloat(paymentsTargetRow.attr('data-balance')) || 0;
        var payments = getPayments(paymentsTargetRow);
        var already  = sumPayments(payments);

        var mode   = $('#paymodeMode').val();
        var amount = parseFloat($('#paymodeAmount').val());

        // Mode must be selected
        if (!mode) {
            toast('Please select a payment mode (Cheque or Bank Transfer).', 'warning');
            $('#paymodeMode').focus();
            return;
        }

        // Amount validation
        if (isNaN(amount) || amount <= 0) {
            toast('Enter a valid payment amount.', 'warning');
            $('#paymodeAmount').addClass('input-flash').focus();
            setTimeout(function () { $('#paymodeAmount').removeClass('input-flash'); }, 500);
            return;
        }

        // ── Cheque-specific mandatory fields ──
        if (mode === 'Cheque') {
            var chqNo   = $('#paymodeChqNo').val().trim();
            var chqDate = $('#paymodeChqDate').val();
            if (!chqNo) {
                toast('Cheque No is required.', 'warning');
                $('#paymodeChqNo').focus();
                return;
            }
            if (!chqDate) {
                toast('Cheque Date is required.', 'warning');
                $('#paymodeChqDate').focus();
                return;
            }
        }

        // ── Bank Transfer-specific mandatory fields ──
        if (mode === 'BankTransfer') {
            var bankAcc      = $('#paymodeBTBankAcc').val();
            var refNo        = $('#paymodeBTRefNo').val().trim();
            var transferMode = $('#paymodeBTTransferMode').val();
            if (!bankAcc) {
                toast('Bank Account is required.', 'warning');
                $('#paymodeBTBankAcc').focus();
                return;
            }
            if (!refNo) {
                toast('Neft/Ref No is required.', 'warning');
                $('#paymodeBTRefNo').focus();
                return;
            }
            if (!transferMode) {
                toast('Transfer Mode is required.', 'warning');
                $('#paymodeBTTransferMode').focus();
                return;
            }
        }

        // Clamp to remaining balance
        var remaining = balance - already;
        if (amount > remaining) {
            amount = Math.max(0, remaining);
            toast('Amount adjusted to the remaining balance (₹' + formatNum(amount) + ').', 'warning');
        }
        if (amount <= 0) {
            toast('This document already has the full balance allocated.', 'warning');
            return;
        }

        var entry = { mode: mode, amount: amount };

        if (mode === 'Cheque') {
            entry.chqNo   = $('#paymodeChqNo').val().trim();
            entry.chqDate = $('#paymodeChqDate').val();
            entry.bank    = $('#paymodeChqBank').val();
            entry.branch  = $('#paymodeChqBranch').val().trim();
            entry.ifsc    = $('#paymodeChqIfsc').val().trim().toUpperCase();
        } else {
            entry.bankAcc      = $('#paymodeBTBankAcc').val();
            entry.refNo        = $('#paymodeBTRefNo').val().trim();
            entry.transferMode = $('#paymodeBTTransferMode').val();
        }

        payments.push(entry);
        setPayments(paymentsTargetRow, payments);
        recalcRow(paymentsTargetRow);

        var modeLabel = mode === 'BankTransfer' ? 'Bank Transfer' : mode;
        toast(modeLabel + ' of ₹' + formatNum(amount) + ' added.', 'success');

        // Reset amount field only; keep mode locked
        $('#paymodeAmount').val('');
        if (mode === 'Cheque') {
            $('#paymodeChqNo').val('');
            $('#paymodeChqDate').val('');
            $('#paymodeChqBank').val('');
            $('#paymodeChqBranch').val('');
            $('#paymodeChqIfsc').val('');
        } else {
            $('#paymodeBTRefNo').val('');
        }

        // Re-lock the mode selector so the same mode stays selected
        applyModeLock(paymentsTargetRow);
        renderPaymentsModalList();
        $('#paymodeAmount').focus();
    });

