    // ---------------------------------------------------------------
    // Save Response Handler
    // Processes the structured API response and applies error badges
    // or clears data on full success.
    //
    // Response shape:
    //   { Success: bool, Response: [ { ResponseType, ResponseApplyby,
    //     TransID, ID, FAID, ResponseMessage }, ... ] }
    //
    // ResponseApplyby:
    //   "1" → Document-level error  → match TransID + ID + FAID
    //   "2" → FAID-level error      → match FAID only
    //   "3" → Common error          → show in Toast only
    // ---------------------------------------------------------------
    function handleSaveResponse(response) {
        // Clear any previous save-error state from rows
        clearSaveErrors();

        var allSuccess = response.Success === true || response.Success === 'true';

        if (allSuccess) {
            // ── Full success ──────────────────────────────────────────
            toast('Collection saved successfully.', 'success');
            clearAllData();
            return;
        }

        // ── Partial / full failure ────────────────────────────────────
        var responseArr = response.Response || [];
        var hasRowErrors = false;

        responseArr.forEach(function (item) {
            var respType = String(item.ResponseType || '').trim();
            var applyBy   = String(item.ResponseApplyby || '').trim();
            var message   = String(item.ResponseMessage || '').trim();
            var transId   = String(item.TransID  || '').trim();
            var docId     = String(item.ID       || '').trim();
            var faidStr   = String(item.FAID     || '').trim();

            if (applyBy === '1') {
                // ── Document-wise: match TransID + ID + FAID ─────────
                var $matchedRows = $('#tblBody tr').filter(function () {
                    var $tr = $(this);
                    return (
                        String($tr.attr('data-transid') || '').trim() === transId &&
                        String($tr.attr('data-id')      || '').trim() === docId   &&
                        String($tr.attr('data-faid')    || '').trim() === faidStr
                    );
                });
                if ($matchedRows.length) {
                    hasRowErrors = true;
                    $matchedRows.each(function () {
                        attachSaveErrorBadge($(this), message, respType);
                    });
                }
            } else if (applyBy === '2') {
                // ── FAID-wise: match FAID only ────────────────────────
                var $faidRows = $('#tblBody tr[data-faid="' + escHtml(faidStr) + '"]');
                if ($faidRows.length) {
                    hasRowErrors = true;
                    $faidRows.each(function () {
                        var casamt = (parseFloat($(this).find('.inp-cashamt').val()) || 0);
                        var cqbtamt = (parseFloat($(this).find('.inp-chqbtamt').val()) || 0);
                        if (casamt != 0 || cqbtamt != 0)
                            attachSaveErrorBadge($(this), message, respType);
                    });
                }
            } else if (applyBy === '3') {
                // ── Common error: Toast only ──────────────────────────
                toast(message, 'danger');
            }
        });

        // Show a summary toast when row-level errors exist
        if (hasRowErrors) {
            var errCount = $('#tblBody tr.row-save-error').length;
            toast('Save completed with errors. ' + errCount + ' row(s) highlighted — hover the \u26a0 badge for details.', 'warning');
        }
    }
    //row-save-error row-save-success 
    // Attaches a red/green error badge with hover tooltip to a row's Doc ID cell.
    // If a badge already exists on that row (e.g. multiple error entries), appends message.
    // respType - "Error" or "Success"
    function attachSaveErrorBadge($tr, message, respType) {
        var isError = (respType || '').trim().toLowerCase() === 'error';

        $tr.removeClass('row-save-error row-save-success');
        $tr.addClass(isError ? 'row-save-error' : 'row-save-success');

        // Use the Doc ID cell as the anchor for the badge
        var $docCell = $tr.find('td[data-label="Doc ID"]');
        if (!$docCell.length) $docCell = $tr.find('td').eq(2); // fallback

        // Check if a badge wrap already exists — stack messages if so
        var $existingWrap = $docCell.find('.save-error-wrap');
        if ($existingWrap.length) {
            var $tip = $existingWrap.find('.save-error-tooltip');
            $tip.html($tip.html() + '<div style="border-top:1px solid rgba(255,255,255,.3);margin-top:4px;padding-top:4px;">' + escHtml(message) + '</div>');
            return;
        }

        var badgeClass = isError ? 'save-badge-error' : 'save-badge-success';
        var tipClass = isError ? 'save-tip-error' : 'save-tip-success';
        var icon = isError ? '&#9888;' : '&#10003;';

        var $wrap = $(
            '<span class="save-error-wrap">' +
            '<span class="save-error-badge ' + badgeClass + '" title="">' + icon + '</span>' +
            '<span class="save-error-tooltip ' + tipClass + '">' + escHtml(message) + '</span>' +
            '</span>'
        );
        $docCell.append($wrap);
    }

    // Removes all save-error visual state from the table
    function clearSaveErrors() {
        $('#tblBody tr.row-save-error').removeClass('row-save-error');
        $('#tblBody .save-error-wrap').remove();
