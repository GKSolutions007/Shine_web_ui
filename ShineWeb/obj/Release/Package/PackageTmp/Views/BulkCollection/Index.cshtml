    function renderPaymentsModalList() {
        if (!paymentsTargetRow) return;
        var faid = paymentsTargetRow.attr('data-faid');
        var cumulativeBalance = getFaidCumulativeBalance(faid);
        var payments = getFaidPayments(faid);
        var added = sumPayments(payments);
        var recdamt = getFaidChqBTTotal(faid, false);
        var remaining = cumulativeBalance - added;
        document.getElementById("paySummaryAmtinword").innerHTML =
            numberToIndianCurrencyWords(added);

        $('#paySummaryBalance').text(formatNum(cumulativeBalance));
        $('#paySummaryRecd').text(formatNum(recdamt));
        $('#paySummaryAdded').text(formatNum(added));
        $('#paySummaryRemaining').text(formatNum(remaining));

        if (!payments.length) {
            $('#payList').html('<div class="pay-empty">No payment entry yet. Fill in the fields above and click Done.</div>');
            return;
        }

        var html = '';
        payments.forEach(function (p, i) {
            var modeLabel = p.mode === '4' ? 'Bank Transfer' : "Cheque";
            var meta = '';
            if (p.mode === '2') {
                if (p.chqNo)   meta += ' &middot; Chq: ' + escHtml(p.chqNo);
                if (p.chqDate) meta += ' &middot; ' + escHtml(p.chqDate);
                if (p.bank) meta += ' &middot; ' + $("#paymodeChqBank option:selected").text()//escHtml(p.bank);
            } else {
                if (p.refNo)       meta += ' &middot; Ref: ' + escHtml(p.refNo);
                if (p.transferMode) meta += ' &middot; ' + $("#paymodeBTTransferMode option:selected").text()//escHtml(p.transferMode);
                if (p.bankAcc) meta += ' &middot; ' + $("#paymodeBTBankAcc option:selected").text()//escHtml(p.bankAcc);
            }
            html += '<div class="pay-list-item">' +
                '<span><span class="mode-chip">' + escHtml(modeLabel) + '</span>₹' + formatNum(p.amount) +
                (meta ? '<span class="meta">' + meta + '</span>' : '') +
                '</span>' +
                '<button type="button" class="pay-del" data-idx="' + i + '" title="Remove"><i class="bi bi-trash3"></i></button>' +
                '</div>';
        });
        $('#payList').html(html);
    }

    $('#payList').on('click', '.pay-del', function () {
        if (!paymentsTargetRow) return;
        var faid = paymentsTargetRow.attr('data-faid');
        var idx = parseInt($(this).attr('data-idx'));
        var payments = getFaidPayments(faid);
        payments.splice(idx, 1);
        setFaidPayments(faid, payments);
        $('#tblBody tr[data-faid="' + faid + '"]').each(function () {
            //setPayments($(this), []);
            var $btn = $(this).find('.btn-collect');
            $btn.removeClass('has-pay').html('<i class="bi bi-plus-circle"></i> <span class="pay-count-lbl">Add</span>');
        });
        applyModeLock(paymentsTargetRow);
        renderPaymentsModalList();
        recalcRow(paymentsTargetRow);
    });

    // Done button — validates and saves the payment entry directly (no separate Add)
    $('#btnDonePayments').on('click', function () {
        if (!paymentsTargetRow) { closePaymentsModal(); return; }

        var faid = paymentsTargetRow.attr('data-faid');
        var cumulativeBalance = getFaidCumulativeBalance(faid);
        var existingPayments = getFaidPayments(faid);

        var mode = $('#paymodeMode').val();
        var selpaymode = $('#paymodeMode option:selected').text();
        var amtRaw = $('#paymodeAmount').val().trim();

        // If the amount field is empty and we already have a saved entry,
        // just close — user didn't change anything.
        if (amtRaw === '' && existingPayments.length > 0) {
            closePaymentsModal();
            $('#tblBody tr[data-faid="' + faid + '"]').each(function () { recalcRow($(this)); });
            return;
        }

        // If amount field is empty and no prior entry, just close.
        if (amtRaw === '') {
            closePaymentsModal();
            return;
        }

        var amount = parseFloat(amtRaw);

        // Mode validation
        if (!mode) {
            toast('Please select a payment mode (Cheque or Bank Transfer).', 'warning');
            $('#paymodeMode').focus();
            return;
        }

        // Amount validation
        if (isNaN(amount) || amount <= 0) {
            toast('Enter a valid payment amount.', 'warning');
            $('#paymodeAmount').addClass('input-flash').focus();
            setTimeout(function () { $('#paymodeAmount').removeClass('input-flash'); }, 500);
            return;
        }

        // Cheque mandatory fields
        if (mode === '2') {
            var chqNo   = $('#paymodeChqNo').val().trim();
            var chqDate = $('#paymodeChqDate').val();
            if (!chqNo) {
                toast('Cheque No is required.', 'warning');
                $('#paymodeChqNo').focus();
                return;
            }
            if (!chqDate) {
                toast('Cheque Date is required.', 'warning');
                $('#paymodeChqDate').focus();
                return;
            }
        }

        // Bank Transfer mandatory fields
        if (mode === '4') {
            var bankAcc      = $('#paymodeBTBankAcc').val();
            var refNo        = $('#paymodeBTRefNo').val().trim();
            var transferMode = $('#paymodeBTTransferMode').val();
            if (!bankAcc) {
                toast('Bank Account is required.', 'warning');
                $('#paymodeBTBankAcc').focus();
                return;
            }
            if (!refNo) {
                toast('Neft/Ref No is required.', 'warning');
                $('#paymodeBTRefNo').focus();
                return;
            }
            if (!transferMode) {
                toast('Transfer Mode is required.', 'warning');
                $('#paymodeBTTransferMode').focus();
                return;
            }
        }

        // Clamp to cumulative FAID balance
        if (amount > Math.abs(cumulativeBalance)) {
            amount = Math.abs(cumulativeBalance);
            toast('Amount adjusted to the FAID cumulative balance (₹' + formatNum(amount) + ').', 'warning');
        }

        var entry = { mode: mode, amount: amount, displaypmmode: (mode === '2' ? "CHQ" : "BT"), paymentmode: selpaymode };
        if (mode === '2') {
            entry.chqNo   = $('#paymodeChqNo').val().trim();
            entry.chqDate = $('#paymodeChqDate').val();
            entry.bank    = $('#paymodeChqBank').val();
            entry.branch  = $('#paymodeChqBranch').val().trim();
            entry.ifsc    = $('#paymodeChqIfsc').val().trim().toUpperCase();
        } else {
            entry.bankAcc      = $('#paymodeBTBankAcc').val();
            entry.refNo        = $('#paymodeBTRefNo').val().trim();
            entry.transferMode = $('#paymodeBTTransferMode').val();
        }

        // Replace (overwrite) — one entry per FAID
        setFaidPayments(faid, [entry]);

        var modeLabel = mode === '4' ? 'Bank Transfer' : "Cheque";
        toast(modeLabel + ' of ₹' + formatNum(amount) + ' saved.', 'success');// for FAID ' + faid + '.'

        // Recalc all rows for this FAID
        $('#tblBody tr[data-faid="' + faid + '"]').each(function () { recalcRow($(this)); });

        closePaymentsModal();
    });

