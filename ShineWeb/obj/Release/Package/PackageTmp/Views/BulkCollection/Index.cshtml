    // ---------------------------------------------------------------
    // Summary Modal — Customer-wise adjusted documents view
    // ---------------------------------------------------------------
    function buildSummaryData() {
        // customerMap[partyName] = {
        //   cashAdjPos, cashAdjPosCount, cashAdjNeg, cashAdjNegCount,
        //   chqBtAdjPos, chqBtAdjPosCount, chqBtAdjNeg, chqBtAdjNegCount,
        //   chqCount, btCount, discAmt, otherAmt, totalAdj
        // }
        var customerMap = {};
        var customerOrder = [];

        // Track FAIDs already processed for payment counting (payments are per-FAID not per-row)
        var seenFaidsPay = {};

        $('#tblBody tr').each(function () {
            var $tr = $(this);
            var cashVal  = parseFloat($tr.find('.inp-cashamt').val())  || 0;
            var chqBtVal = parseFloat($tr.find('.inp-chqbtamt').val()) || 0;
            var discAmt  = parseFloat($tr.find('.inp-discamt').val())  || 0;
            var otherAmt = parseFloat($tr.find('.inp-otheramt').val()) || 0;
            var adjVal   = parseFloat($tr.find('.lbl-adjusted').text()) || 0;

            // Only include rows that have any adjustment
            if (Math.abs(cashVal) < 0.004 && Math.abs(chqBtVal) < 0.004 &&
                Math.abs(discAmt) < 0.004 && Math.abs(otherAmt) < 0.004) return;

            var partyName = $tr.attr('data-partyname') ||
                            $tr.find('td[data-label="Party Name"] .cell-strong').attr('title') ||
                            $tr.find('td[data-label="Party Name"] .cell-strong').text().trim() ||
                            '(Unknown)';

            if (!customerMap[partyName]) {
                customerMap[partyName] = {
                    cashAdjPos: 0, cashAdjPosCount: 0,
                    cashAdjNeg: 0, cashAdjNegCount: 0,
                    chqBtAdjPos: 0, chqBtAdjPosCount: 0,
                    chqBtAdjNeg: 0, chqBtAdjNegCount: 0,
                    chqCount: 0, btCount: 0,
                    discAmt: 0, otherAmt: 0, totalAdj: 0
                };
                customerOrder.push(partyName);
            }

            // Cash: split into positive and negative buckets
            if (cashVal > 0.004) {
                customerMap[partyName].cashAdjPos += cashVal;
                customerMap[partyName].cashAdjPosCount++;
            } else if (cashVal < -0.004) {
                customerMap[partyName].cashAdjNeg += cashVal;
                customerMap[partyName].cashAdjNegCount++;
            }

            // Chq/BT: split into positive and negative buckets
            if (chqBtVal > 0.004) {
                customerMap[partyName].chqBtAdjPos += chqBtVal;
                customerMap[partyName].chqBtAdjPosCount++;
            } else if (chqBtVal < -0.004) {
                customerMap[partyName].chqBtAdjNeg += chqBtVal;
                customerMap[partyName].chqBtAdjNegCount++;
            }

            customerMap[partyName].discAmt  += discAmt;
            customerMap[partyName].otherAmt += otherAmt;
            customerMap[partyName].totalAdj += adjVal;

            // Count cheques/BTs per FAID (once per FAID, credited to the party)
            var faid = $tr.attr('data-faid');
            if (faid && !seenFaidsPay[faid]) {
                seenFaidsPay[faid] = true;
                var payments = getFaidPayments(faid);
                payments.forEach(function (p) {
                    if (p.mode === '2') customerMap[partyName].chqCount++;
                    else if (p.mode === '4') customerMap[partyName].btCount++;
                });
            }
        });

        return { map: customerMap, order: customerOrder };
    }

    function openSummaryModal() {
        var result = buildSummaryData();
        var map    = result.map;
        var order  = result.order;

        if (!order.length) {
            toast('No adjusted documents to summarise. Enter Cash or Chq/BT amounts first.', 'warning');
            return;
        }

        var html = '';
        var gCashPos = 0, gCashPosCount = 0, gCashNeg = 0, gCashNegCount = 0;
        var gChqBtPos = 0, gChqBtPosCount = 0, gChqBtNeg = 0, gChqBtNegCount = 0;
        var gChq = 0, gBT = 0, gDisc = 0, gOther = 0, gTotal = 0;

        order.forEach(function (name, i) {
            var c = map[name];
            gCashPos      += c.cashAdjPos;      gCashPosCount  += c.cashAdjPosCount;
            gCashNeg      += c.cashAdjNeg;      gCashNegCount  += c.cashAdjNegCount;
            gChqBtPos     += c.chqBtAdjPos;     gChqBtPosCount += c.chqBtAdjPosCount;
            gChqBtNeg     += c.chqBtAdjNeg;     gChqBtNegCount += c.chqBtAdjNegCount;
            gChq          += c.chqCount;
            gBT           += c.btCount;
            gDisc         += c.discAmt;
            gOther        += c.otherAmt;
            gTotal        += c.totalAdj;

            var cashPosCell  = c.cashAdjPosCount  > 0 ? '<span style="color:var(--bc-success);font-weight:700;">' + formatNum(c.cashAdjPos)  + '</span><span style="color:var(--bc-muted);font-size:9px;"> (' + c.cashAdjPosCount  + ')</span>' : '<span style="color:var(--bc-muted);">—</span>';
            var cashNegCell  = c.cashAdjNegCount  > 0 ? '<span style="color:var(--bc-danger);font-weight:700;">'  + formatNum(c.cashAdjNeg)  + '</span><span style="color:var(--bc-muted);font-size:9px;"> (' + c.cashAdjNegCount  + ')</span>' : '<span style="color:var(--bc-muted);">—</span>';
            var chqPosCell   = c.chqBtAdjPosCount > 0 ? '<span style="color:var(--bc-success);font-weight:700;">' + formatNum(c.chqBtAdjPos) + '</span><span style="color:var(--bc-muted);font-size:9px;"> (' + c.chqBtAdjPosCount + ')</span>' : '<span style="color:var(--bc-muted);">—</span>';
