    // ---------------------------------------------------------------
    // Per-row calculation engine
    // ---------------------------------------------------------------

    // ---------------------------------------------------------------
    // Negative-balance lock + Cash / Chq-BT helpers
    // ---------------------------------------------------------------

    // Balance < 0 (credit / refund document): Disc, Other and Pay Info are
    // switched off — only a direct Cash OR Chq/BT entry is allowed.
    function applyNegativeBalanceLock($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        var isNeg = balance < 0;
        $tr.find('.inp-discpct, .inp-discamt, .inp-otherpct, .inp-otheramt')
            .prop('disabled', isNeg)
            .toggleClass('bc-field-disabled', isNeg);
        $tr.find('.btn-collect').prop('disabled', isNeg);
        if (isNeg) {
            $tr.find('.inp-discpct, .inp-discamt, .inp-otherpct, .inp-otheramt').val('0.00');
        }
    }

    // Keeps min/max on the Cash & Chq/BT inputs in line with the document's
    // Balance sign, so native validation / spinners agree with it.
    function setCashChqBounds($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        var $cash = $tr.find('.inp-cashamt');
        var $chq = $tr.find('.inp-chqbtamt');
        if (balance < 0) {
            $cash.attr({ min: balance, max: 0 });
            $chq.attr({ min: balance, max: 0 });
        } else {
            $cash.attr({ min: 0, max: balance });
            $chq.attr({ min: 0, max: balance });
        }
    }

    // Only ONE of Cash / Chq-BT may carry a value in the same row —
    // as soon as one of them is filled, the other is locked until cleared.
    // This applies to ALL rows regardless of balance sign.
    function applyCashChqMutualExclusion($tr) {
        var $cash = $tr.find('.inp-cashamt');
        var $chq = $tr.find('.inp-chqbtamt');
        var $collbtn = $tr.find('.btn-collect');
        //btn-collect
        var cashVal = parseFloat($cash.val()) || 0;
        var chqVal  = parseFloat($chq.val())  || 0;

        if (Math.abs(cashVal) > 0.004) {
            // Cash has a value → lock Chq/BT
            $cash.prop('disabled', false).removeClass('bc-field-disabled');
            $chq.prop('disabled', true).addClass('bc-field-disabled').val('0.00');
            $collbtn.prop('disabled', true);
        } else if (Math.abs(chqVal) > 0.004) {
            // Chq/BT has a value → lock Cash
            $collbtn.prop('disabled', false);
            $chq.prop('disabled', false).removeClass('bc-field-disabled');
            $cash.prop('disabled', true).addClass('bc-field-disabled').val('0.00');
        } else {
            // Both are zero → unlock both
            $collbtn.prop('disabled', false);
            $cash.prop('disabled', false).removeClass('bc-field-disabled');
            $chq.prop('disabled', false).removeClass('bc-field-disabled');
        }
    }

    // Clamps whichever of Cash / Chq-BT the user just edited so the pair
    // never exceeds the document's Balance, and enforces mutual exclusion
    // so only one field can hold a value at a time.
    function clampCashChq($tr, which) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        var $cash = $tr.find('.inp-cashamt');
        var $chq = $tr.find('.inp-chqbtamt');

        if (balance < 0) {
            var $active = which === 'cash' ? $cash : $chq;
            var rawVal = $active.val();
            // Allow mid-typing states: bare "-" or empty — don't clamp yet
            if (rawVal === '' || rawVal === '-') {
                applyCashChqMutualExclusion($tr);
                return;
            }
            var v = parseFloat(rawVal);
            if (isNaN(v) || v > 0) v = 0;
            if (v < balance) v = balance;
            $active.val(v.toFixed(DecVal));
            applyCashChqMutualExclusion($tr);
            return;
        }

        // Positive balance: clamp the edited field to available room,
        // then enforce mutual exclusion (the other field becomes 0 & locked).
        var discamt  = parseFloat($tr.find('.inp-discamt').val())  || 0;
        var otheramt = parseFloat($tr.find('.inp-otheramt').val()) || 0;
        // Negative otheramt = discount (reduces balance); positive = no reduction.
        var otherSettlement = otheramt < 0 ? Math.abs(otheramt) : 0;
        var available = Math.max(0, balance - discamt - otherSettlement);

        if (which === 'cash') {
            var cashVal = parseFloat($cash.val()) || 0;
            if (isNaN(cashVal) || cashVal < 0) cashVal = 0;
            if (cashVal > available) cashVal = available;
            $cash.val(cashVal.toFixed(DecVal));
        } else {
            var chqVal = parseFloat($chq.val()) || 0;
            if (isNaN(chqVal) || chqVal < 0) chqVal = 0;
            if (chqVal > available) chqVal = available;
            $chq.val(chqVal.toFixed(DecVal));
        }

        applyCashChqMutualExclusion($tr);
    }

    // When Disc or Other is entered, Cash / Chq-BT must shrink so the row
    // never exceeds its Balance — Chq/BT is trimmed first, then Cash.
    // Note: positive Other ₹ does NOT reduce balance (no reconcile needed for positive).
    //       Only negative Other ₹ reduces balance (discount), so we use otherSettlement.
    function reconcileCashChqAfterDiscOther($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        if (balance < 0) return;

        var discamt = parseFloat($tr.find('.inp-discamt').val()) || 0;
        var otheramt = parseFloat($tr.find('.inp-otheramt').val()) || 0;
        // Negative otheramt = discount (reduces balance); positive = no reduction.
        var otherSettlement = otheramt < 0 ? Math.abs(otheramt) : 0;
        var available = Math.max(0, balance - discamt - otherSettlement);

        var $cash = $tr.find('.inp-cashamt');
        var $chq = $tr.find('.inp-chqbtamt');
        var cashVal = parseFloat($cash.val()) || 0;
        var chqVal = parseFloat($chq.val()) || 0;
        var excess = (cashVal + chqVal) - available;

        if (excess > 0.004) {
            var reduceChq = Math.min(chqVal, excess);
            chqVal -= reduceChq;
            excess -= reduceChq;
            if (excess > 0.004) {
                var reduceCash = Math.min(cashVal, excess);
                cashVal -= reduceCash;
            }
            $chq.val(chqVal.toFixed(DecVal));
            $cash.val(cashVal.toFixed(DecVal));
        }
    }

    // Pressing Space in Cash / Chq-BT fills it with whatever of the Balance
    // is still unallocated (Balance − the other field − Disc − Other).
    function spaceFillCashChq($tr, which) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        var $field = which === 'cash' ? $tr.find('.inp-cashamt') : $tr.find('.inp-chqbtamt');
        if ($field.prop('disabled')) return;

        if (balance < 0) {
            $field.val(balance.toFixed(DecVal));
        } else {
            var $other = which === 'cash' ? $tr.find('.inp-chqbtamt') : $tr.find('.inp-cashamt');
            var otherVal = parseFloat($other.val()) || 0;
            var discamt = parseFloat($tr.find('.inp-discamt').val()) || 0;
            var otheramt = parseFloat($tr.find('.inp-otheramt').val()) || 0;
            // Negative otheramt = discount (reduces balance); positive = no reduction.
            var otherSettlement = otheramt < 0 ? Math.abs(otheramt) : 0;
            var remaining = balance - otherVal - discamt - otherSettlement;
            if (remaining < 0) remaining = 0;
            $field.val(remaining.toFixed(DecVal));
        }

        clampCashChq($tr, which);
        recalcRow($tr);
    }

    // Called once per row (on render / reset) to set bounds + lock state.
    function initRowLockState($tr) {
        setCashChqBounds($tr);
        applyNegativeBalanceLock($tr);
        applyCashChqMutualExclusion($tr);
    }

    // ---------------------------------------------------------------
    // Disc % / Disc ₹ / Other % / Other ₹ handlers
    // (base = row Balance; disabled entirely when Balance is negative)
    // ---------------------------------------------------------------
    // ---------------------------------------------------------------
    // Guard: Disc % / Disc ₹ / Other % / Other ₹ require a non-zero
    // Cash or Chq/BT value on the same row before they accept input.
    // ---------------------------------------------------------------
    function hasCashOrChq($tr) {
        var cashVal  = parseFloat($tr.find('.inp-cashamt').val())  || 0;
        var chqVal   = parseFloat($tr.find('.inp-chqbtamt').val()) || 0;
        return (Math.abs(cashVal) > 0.004 || Math.abs(chqVal) > 0.004);
    }

    function flashDiscOtherError($input, msg) {
        $input.addClass('input-flash').val('0.00');
        setTimeout(function () { $input.removeClass('input-flash'); }, 500);
        toast(msg, 'warning');
        $input.blur();
    }

    function discPctChanged($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        if (balance < 0) { $tr.find('.inp-discpct, .inp-discamt').val('0.00'); recalcRow($tr); return; }
        if (!hasCashOrChq($tr)) {
            flashDiscOtherError($tr.find('.inp-discpct'), 'Enter Cash or Chq/BT amount first before applying Disc %.');
            $tr.find('.inp-discamt').val('0.00');
            recalcRow($tr); return;
        }
        var pct = parseFloat($tr.find('.inp-discpct').val());
        if (isNaN(pct) || pct < 0) pct = 0;
        if (pct > 100) pct = 100;
        var amt = balance * pct / 100;
        $tr.find('.inp-discamt').val(amt.toFixed(DecVal));
        $tr.find('.inp-discpct').val(pct.toFixed(2));
        reconcileCashChqAfterDiscOther($tr);
        recalcRow($tr);
    }

    function discAmtChanged($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        if (balance < 0) { $tr.find('.inp-discpct, .inp-discamt').val('0.00'); recalcRow($tr); return; }
        if (!hasCashOrChq($tr)) {
            flashDiscOtherError($tr.find('.inp-discamt'), 'Enter Cash or Chq/BT amount first before applying Disc ₹.');
            $tr.find('.inp-discpct').val('0.00');
            recalcRow($tr); return;
        }
        var amt = parseFloat($tr.find('.inp-discamt').val());
        if (isNaN(amt) || amt < 0) amt = 0;
        if (amt > balance) amt = balance;
        var pct = balance > 0 ? (amt / balance * 100) : 0;
        $tr.find('.inp-discamt').val(amt.toFixed(DecVal));
        $tr.find('.inp-discpct').val(pct.toFixed(2));
        reconcileCashChqAfterDiscOther($tr);
        recalcRow($tr);
    }

    function otherPctChanged($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        // Other % allows negative values (negative = discount, reduces balance;
        // positive = no balance reduction). Only block if balance itself is negative.
        if (balance < 0) { $tr.find('.inp-otherpct, .inp-otheramt').val('0.00'); recalcRow($tr); return; }
        if (!hasCashOrChq($tr)) {
            flashDiscOtherError($tr.find('.inp-otherpct'), 'Enter Cash or Chq/BT amount first before applying Other %.');
            $tr.find('.inp-otheramt').val('0.00');
            recalcRow($tr); return;
        }
        var pct = parseFloat($tr.find('.inp-otherpct').val());
        if (isNaN(pct)) pct = 0;
        // Clamp: negative side limited to -100%, positive side limited to +100%
        ///if (pct < -100) pct = -100;
        if(isNaN(pct) || pct < 0) pct = 0;
        if (pct > 100) pct = 100;
        var amt = balance * pct / 100;
        $tr.find('.inp-otheramt').val(amt.toFixed(DecVal));
        $tr.find('.inp-otherpct').val(pct.toFixed(2));
        // Only reconcile Cash/Chq when Other is positive (no reduction when positive)
        if (amt > 0) {
            reconcileCashChqAfterDiscOther($tr);
        }
        recalcRow($tr);
    }

    function otherAmtChanged($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        // Other ₹ allows negative values (negative = discount, reduces balance;
        // positive = no balance reduction). Only block if balance itself is negative.
        if (balance < 0) { $tr.find('.inp-otherpct, .inp-otheramt').val('0.00'); recalcRow($tr); return; }
        if (!hasCashOrChq($tr)) {
            flashDiscOtherError($tr.find('.inp-otheramt'), 'Enter Cash or Chq/BT amount first before applying Other ₹.');
            $tr.find('.inp-otherpct').val('0.00');
            recalcRow($tr); return;
        }
        var amt = parseFloat($tr.find('.inp-otheramt').val());
        if (isNaN(amt) || amt < 0) amt = 0;
        // Clamp: cannot exceed balance in either direction
        if (amt > balance) amt = balance;
        if (amt < -balance) amt = -balance;
        var pct = balance > 0 ? (amt / balance * 100) : 0;
        $tr.find('.inp-otheramt').val(amt.toFixed(DecVal));
        $tr.find('.inp-otherpct').val(pct.toFixed(2));
        // Only reconcile Cash/Chq when Other is positive (no reduction when positive)
        if (amt > 0) {
            reconcileCashChqAfterDiscOther($tr);
        }
        recalcRow($tr);
    }

    function recalcRow($tr) {
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        var cashamt = parseFloat($tr.find('.inp-cashamt').val()) || 0;
        var chqbtamt = parseFloat($tr.find('.inp-chqbtamt').val()) || 0;
        var discamt = parseFloat($tr.find('.inp-discamt').val()) || 0;
        var otheramt = parseFloat($tr.find('.inp-otheramt').val()) || 0;

        // Other ₹ behaviour:
        //   Positive value → does NOT reduce the balance (no deduction from balance).
        //   Negative value → acts as a discount and DOES reduce the balance.
        // So only negative otheramt contributes to settlement.
        var otherSettlement = otheramt < 0 ? Math.abs(otheramt) : 0;

        // Total Adjusted Amount = Cash + Chq/BT + Disc ₹ only.
        var adjusted = cashamt + chqbtamt + discamt;
        // Full settlement (incl. negative Other ₹ acting as discount).
        var settled = adjusted + otherSettlement;
        var remaining = balance - settled;

        $tr.find('.lbl-adjusted').text(formatNum(adjusted + otherSettlement));
        $tr.find('.lbl-remaininghint').text('Bal left: ' + formatNum(remaining));

        var faid = $tr.attr('data-faid');
        var payments = getFaidPayments(faid);
        var $btn = $tr.find('.btn-collect');
        if (payments.length > 0) {
            $btn.addClass('has-pay').html('<i class="bi bi-credit-card"></i> <span class="pay-count-lbl" title="' + payments[0].paymentmode +'">' + payments[0].displaypmmode + ' ₹' + formatNum(payments[0].amount) + '</span>');
        } else {
            $btn.removeClass('has-pay').html('<i class="bi bi-plus-circle"></i> <span class="pay-count-lbl">Add</span>');
        }

        var $badge = $tr.find('.badge-status');
        $tr.removeClass('row-settled row-partial');
        if (Math.abs(settled) <= 0.004) {
            $badge.attr('class', 'badge-status badge-pending').text('Pending');
        } else if (Math.abs(remaining) <= 0.004) {
            $badge.attr('class', 'badge-status badge-settled').text('Settled');
            $tr.addClass('row-settled');
        } else {
            $badge.attr('class', 'badge-status badge-partial').text('Partial');
            $tr.addClass('row-partial');
        }

        recalcFooterTotals();
    }

    function recalcFooterTotals() {
        var tNet = 0, tBalance = 0, tCash = 0, tChqBt = 0, tDisc = 0, tOther = 0, n = 0;
        var tChqAmt = 0, tBTAmt = 0, chqCount = 0, btCount = 0;
        var seenFaids = {};  // track FAIDs already counted for payments (shared per FAID)

        $('#tblBody tr').each(function () {
            var $tr = $(this);
            n++;
            tNet     += parseFloat($tr.attr('data-net'))    || 0;
            tBalance += parseFloat($tr.attr('data-balance')) || 0;
            tCash    += parseFloat($tr.find('.inp-cashamt').val())   || 0;
            tChqBt   += parseFloat($tr.find('.inp-chqbtamt').val())  || 0;
            tDisc    += parseFloat($tr.find('.inp-discamt').val())   || 0;
            tOther   += parseFloat($tr.find('.inp-otheramt').val())  || 0;

            // Count Cheque and Bank Transfer payments (per unique FAID to avoid double-counting)
            var faid = $tr.attr('data-faid');
            if (faid && !seenFaids[faid]) {
                seenFaids[faid] = true;
                var payments = getFaidPayments(faid);
                payments.forEach(function (p) {
                    var amt = parseFloat(p.amount) || 0;
                    if (p.mode === '2') {       // Cheque
                        tChqAmt += amt;
                        chqCount++;
                    } else if (p.mode === '4') { // Bank Transfer
                        tBTAmt += amt;
                        btCount++;
                    }
                });
            }
        });

        // Total Adjusted Amount = Cash + Chq/BT + Disc ₹ only.
        var tAdjusted = tCash + tChqBt + tDisc;
        // Only negative tOther (discount) reduces balance; positive does not.
        var tOtherSettlement = 0;
        // (We compute tOther as raw sum above; now apply sign logic for remaining)
        // tOther may contain mixed positive/negative values summed per row;
        // for footer remaining, apply same rule: negative reduces, positive doesn't.
        // Recompute per-row to get correct settlement total.
        var tOtherSettlementTotal = 0;
        $('#tblBody tr').each(function () {
            var oa = parseFloat($(this).find('.inp-otheramt').val()) || 0;
            tOtherSettlementTotal += (oa < 0 ? Math.abs(oa) : 0);
        });
        var remaining = tBalance - (tAdjusted + tOtherSettlementTotal);

        $('#ftNet').text(formatNum(tNet));
        $('#ftBalance').text(formatNum(tBalance));
        $('#ftCashCollected').text(formatNum(tCash));
        $('#ftChqBTCollected').text(formatNum(tChqBt));
        $('#ftDisc').text(formatNum(tDisc));
        $('#ftOther').text(formatNum(tOther));
        $('#ftAdjusted').text(formatNum(tAdjusted));

        $('#statRecords').text(n);
        $('#statBalance').text(formatNum(tBalance));

        // Cash collection amount
        $('#statcashCollected').text(formatNum(tCash));

        // Cheque: count in label + amount
        $('#statChqCount').text(chqCount);
        $('#statchqCollected').text(formatNum(tChqAmt));

        // Bank Transfer: count in label + amount
        $('#statBtCount').text(btCount);
        $('#statbtCollected').text(formatNum(tBTAmt));

        $('#statCollected').text(formatNum(tCash + tChqAmt + tBTAmt));
        $('#statDiscOther').text(formatNum(tDisc + tOther));
        $('#statRemaining').text(formatNum(remaining));
    }

    // ---------------------------------------------------------------
    // Event wiring (delegated, since rows are added dynamically)
    // ---------------------------------------------------------------
    $('#tblBody').on('input change', '.inp-discpct', function () { discPctChanged($(this).closest('tr')); });
    $('#tblBody').on('input change', '.inp-discamt', function () { discAmtChanged($(this).closest('tr')); });
    $('#tblBody').on('input change', '.inp-otherpct', function () { otherPctChanged($(this).closest('tr')); });
    $('#tblBody').on('input change', '.inp-otheramt', function () { otherAmtChanged($(this).closest('tr')); });

    $('#tblBody').on('input change', '.inp-cashamt', function () {
        var $tr = $(this).closest('tr');
        clampCashChq($tr, 'cash');
        // When both Cash and Chq/BT are 0, reset disc/other fields to 0
        if (!hasCashOrChq($tr)) {
            $tr.find('.inp-discpct, .inp-discamt, .inp-otherpct, .inp-otheramt').val('0.00');
            $tr.find('.lbl-adjusted').text('0.00');
        }
        recalcRow($tr);
    });
    $('#tblBody').on('input change', '.inp-chqbtamt', function () {
        var $tr = $(this).closest('tr');
        clampCashChq($tr, 'chqbt');
        // When both Cash and Chq/BT are 0, reset disc/other fields to 0
        if (!hasCashOrChq($tr)) {
            $tr.find('.inp-discpct, .inp-discamt, .inp-otherpct, .inp-otheramt').val('0.00');
            $tr.find('.lbl-adjusted').text('0.00');
        }
        recalcRow($tr);
    });

    // Finalise clamping when user leaves a Cash/Chq-BT field that may have
    // been left in a mid-typing state (e.g. bare "-" on a negative-balance row).
    $('#tblBody').on('focusout', '.inp-cashamt, .inp-chqbtamt', function () {
        var $tr = $(this).closest('tr');
        var balance = parseFloat($tr.attr('data-balance')) || 0;
        if (balance < 0) {
            var rawVal = $(this).val();
            if (rawVal === '' || rawVal === '-') {
                $(this).val('0.00');
                applyCashChqMutualExclusion($tr);
                recalcRow($tr);
            }
        }
    });

    // Space bar on Cash / Chq-BT auto-fills the field with the remaining
    // (unallocated) Balance amount instead of typing a literal space.
    $('#tblBody').on('keydown', '.inp-cashamt, .inp-chqbtamt', function (e) {
        if (e.key !== ' ' && e.code !== 'Space' && e.keyCode !== 32) return;
        e.preventDefault();
        var $tr = $(this).closest('tr');
        spaceFillCashChq($tr, $(this).hasClass('inp-cashamt') ? 'cash' : 'chqbt');
    });
    document.addEventListener("keydown", function (event) {
        if (event.key === "Space" || event.key === " ") {

            var FieldID = event.target.id;
