    // ---------------------------------------------------------------
    // Keyboard navigation
    //   • Enter / Arrow Down  → move to next input in same column (table)
    //                           or next field in the filter bar
    //   • Arrow Up            → move to previous input in same column (table)
    //   • Shift+Enter         → move backwards (filter bar)
    // ---------------------------------------------------------------

    // Returns all visible, enabled inputs in column order for the table.
    // For the filter bar, returns the filter fields in DOM order.
    function getNavigableFields() {
        return $('#txtBeat,#txtSalesman,#txtCustomer,#txtAsonDate,#dtpDate')
            .filter(':visible:not(:disabled)').toArray();
    }

    // Given an <input> inside a table row, find the input in the next
    // cell to the RIGHT in the same row (for Enter key navigation).
    function navigateTableCellRight($input) {
        var $td = $input.closest('td');
        var $tr = $td.closest('tr');
        var colIdx = $td.index();
        var totalCols = $tr.find('td').length;

        // Search right from the current cell
        for (var c = colIdx + 1; c < totalCols; c++) {
            var $targetTd = $tr.find('td').eq(c);
            var $inp = $targetTd.find('input:visible:not(:disabled)');
            if ($inp.length) return $inp[0];
        }
        // If at end of row, wrap to first input in next row
        var $nextRow = $tr.next('tr');
        if (!$nextRow.length) return null;
        for (var nc = 0; nc < $nextRow.find('td').length; nc++) {
            var $ntd = $nextRow.find('td').eq(nc);
            var $ni = $ntd.find('input:visible:not(:disabled)');
            if ($ni.length) return $ni[0];
        }
        return null;
    }

    // Given an <input> inside a table row, find the input in the same
    // column of the adjacent row (direction: +1 = down, -1 = up).
    function navigateTableCell($input, direction) {
        var $td   = $input.closest('td');
        var $tr   = $td.closest('tr');
        var colIdx = $td.index();

        var $targetRow = direction === 1 ? $tr.next('tr') : $tr.prev('tr');
        if (!$targetRow.length) return null;

        var totalCols = $targetRow.find('td').length;
        for (var c = colIdx; c < totalCols && c >= 0; c += direction) {
            var $targetTd = $targetRow.find('td').eq(c);
            var $inp = $targetTd.find('input:visible:not(:disabled)');
            if ($inp.length) return $inp[0];
        }
        return null;
    }

    $(document).on('keydown', function (e) {
        var key = e.key;
        var isEnter = (key === 'Enter');
        var isDown  = (key === 'ArrowDown');
        var isUp    = (key === 'ArrowUp');

        if (!isEnter && !isDown && !isUp) return;

        // ── Inside the payments modal ──────────────────────────────
        if ($(e.target).closest('#modalPayments').length) {
            if (e.target.tagName.toLowerCase() === 'textarea') return;
            if (isEnter) {
                e.preventDefault();
                $('#btnDonePayments').trigger('click');
            }
            return;
        }

        var $t = $(e.target);
        if (!$t.is('input,select')) return;

        // ── Inside the data table ──────────────────────────────────
        if ($t.closest('#tblBody').length) {
            if (isEnter) {
                e.preventDefault();
                var next = navigateTableCellRight($t);
                if (next) { next.focus(); if (next.select) next.select(); }
                return;
            }
            if (isDown) {
                e.preventDefault();
                var nextDown = navigateTableCell($t, 1);
                if (nextDown) { nextDown.focus(); if (nextDown.select) nextDown.select(); }
                return;
            }
            if (isUp) {
                e.preventDefault();
                var prev = navigateTableCell($t, -1);
                if (prev) { prev.focus(); if (prev.select) prev.select(); }
                return;
            }
            return;
        }

        // ── Filter bar (Enter only) ────────────────────────────────
        if (isEnter) {
            e.preventDefault();
            var fields = getNavigableFields();
            var idx = fields.indexOf(e.target);
            if (idx === -1) return;
            var nextIdx = e.shiftKey ? idx - 1 : idx + 1;
            var nextFld = fields[nextIdx];
            if (nextFld) { nextFld.focus(); if (nextFld.select) nextFld.select(); }
        }
    });

    // ---------------------------------------------------------------
    // Remarks & Narration — per FAID storage + tooltip + modal
    // ---------------------------------------------------------------

    // In-memory store keyed by FAID: { remarks: '', narration: '' }
    var faidRemarksStore = {};

    function getFaidRemarks(faid) {
        return faidRemarksStore[faid] || { remarks: '', narration: '' };
    }

    function setFaidRemarks(faid, obj) {
        faidRemarksStore[faid] = obj;
    }

    // Build the tooltip inner HTML for a given FAID and show/hide the tip
    function updateRemarkTooltip(faid) {
        var data = getFaidRemarks(faid);
        var hasR = (data.remarks || '').trim().length > 0;
        var hasN = (data.narration || '').trim().length > 0;

        // Update all remark buttons sharing this FAID
        $('#tblBody tr[data-faid="' + faid + '"] .btn-remark').each(function () {
            var $btn = $(this);
            if (hasR || hasN) {
                $btn.addClass('has-remark').attr('title', '');
            } else {
                $btn.removeClass('has-remark').attr('title', 'Add Remarks & Narration');
            }
        });

        // Update tooltip content (one tooltip per unique FAID row — rows sharing FAID share tooltip)
        $('#tblBody tr[data-faid="' + faid + '"] .remark-tooltip').each(function () {
            var $tip = $(this);
            if (!hasR && !hasN) {
                $tip.hide().html('');
                return;
            }
            var html = '';
            if (hasR) {
                html += '<div class="tt-label">Remarks</div><div class="tt-value">' + escHtml(data.remarks) + '</div>';
                if (hasN) html += '<div style="margin-top:5px;border-top:1px solid rgba(255,255,255,.2);padding-top:5px;"></div>';
            }
            if (hasN) {
                html += '<div class="tt-label">Narration</div><div class="tt-value">' + escHtml(data.narration) + '</div>';
            }
            $tip.html(html).css('display', ''); // let CSS :hover control visibility
        });
    }

    // Re-apply tooltip visibility rule via CSS hover (we set display:'none' initially per row;
    // after saving, remove the inline display:none so the CSS :hover rule takes over)
    $('#tblBody').on('mouseenter', '.remark-tooltip-wrap', function () {
        var $tip = $(this).find('.remark-tooltip');
        if ($tip.html()) $tip.show();
    }).on('mouseleave', '.remark-tooltip-wrap', function () {
        $(this).find('.remark-tooltip').hide();
    });

    // ── Remarks modal open ───────────────────────────────────────────
    var remarksTargetFaid = null;

    $('#tblBody').on('click', '.btn-remark', function (e) {
        e.stopPropagation();
        var $tr = $(this).closest('tr');
        var faid = $tr.attr('data-faid');
        var party = $tr.find('td[data-label="Party Name"] .cell-strong').attr('title') ||
                    $tr.find('td[data-label="Party Name"] .cell-strong').text().trim();
        var docId = $tr.find('td[data-label="Doc ID"]').clone().find('.badge-transname').remove().end().text().trim();

        remarksTargetFaid = faid;
        $('#remarkModalSub').text(party + ' — ' + docId);

        var data = getFaidRemarks(faid);
        $('#txtRemarkText').val(data.remarks || '');
        $('#txtNarrationText').val(data.narration || '');

        $('#modalRemarks').css('display', 'flex');
        setTimeout(function () { $('#txtRemarkText').focus(); }, 60);
    });

    // ── Save remarks ─────────────────────────────────────────────────
    $('#btnSaveRemarks').on('click', function () {
        if (!remarksTargetFaid) { closeRemarksModal(); return; }

        var remarks   = $('#txtRemarkText').val().trim();
        var narration = $('#txtNarrationText').val().trim();

        setFaidRemarks(remarksTargetFaid, { remarks: remarks, narration: narration });
        updateRemarkTooltip(remarksTargetFaid);

        var hasAny = remarks.length > 0 || narration.length > 0;
        toast(hasAny ? 'Remarks saved.' : 'Remarks cleared.', 'success');
        closeRemarksModal();
    });

    // ── Clear remarks ─────────────────────────────────────────────────
    $('#btnClearRemarks').on('click', function () {
        $('#txtRemarkText').val('');
        $('#txtNarrationText').val('');
    });

    function closeRemarksModal() {
        $('#modalRemarks').css('display', 'none');
        remarksTargetFaid = null;
    }

    $('#btnCloseRemarks').on('click', closeRemarksModal);

    // Close remarks modal on backdrop click
    $('#modalRemarks').on('click', function (e) {
        if ($(e.target).is('#modalRemarks')) closeRemarksModal();
    });

    // Also dismiss with Escape key
    $(document).on('keydown.remarks', function (e) {
        if (e.key === 'Escape' && $('#modalRemarks').css('display') !== 'none') {
            closeRemarksModal();
        }
    });

    $('#trFooter').show();
    //$('#txtRemarkText').on('keypress', function (e) {
    //    if (e.which == 32)
    //        return false;
    //});
</script>
