@model ShineWeb.Models.SingleMasterModel
@{
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
    ViewBag.Title = ViewData["FormName"];
}

<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />

<link href="~/datatable/1.13.6/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<!-- Bootstrap 5 -->
@*<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />*@
<script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>

<script src="~/datatable/1.13.6/jquery.dataTables.min.js"></script>
<script src="~/datatable/1.13.6/dataTables.bootstrap5.min.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/Scripts/multiselect/GKBSmultiselectiondropdown.js"></script>
<header>
    <link rel="stylesheet" href="~/Content/index.css">
    <!-- Icon font for the modernized UI. Host locally if this environment has no internet access. -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
</header>

<style>
    :root {
        --bc-primary: #4f46e5;
        --bc-primary-dark: #3c35b5;
        --bc-primary-light: #eef0ff;
        --bc-success: #16a34a;
        --bc-success-light: #e7f8ed;
        --bc-warning: #d97706;
        --bc-warning-light: #fef3e2;
        --bc-danger: #dc2626;
        --bc-danger-light: #fdeaea;
        --bc-bg: #f3f5fb;
        --bc-surface: #ffffff;
        --bc-text: #1e2433;
        --bc-muted: #707b8c;
        --bc-border: #e3e7ef;
        --bc-radius: 12px;
        --bc-radius-sm: 7px;
        --bc-shadow-sm: 0 1px 3px rgba(20,24,40,.06);
        --bc-shadow-md: 0 6px 20px rgba(20,24,40,.09);
    }

    #dvBulkCollection, #dvBulkCollection input, #dvBulkCollection button, #dvBulkCollection select {
        font-family: 'Segoe UI', Inter, Roboto, Arial, sans-serif;
    }

    #dvBulkCollection {
        background: var(--bc-bg);
        padding: 10px 10px 64px 10px;
        color: var(--bc-text);
    }

    .bc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
    }

        .bc-header h4 {
            margin: 0;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: -.2px;
        }

        .bc-header p {
            margin: 1px 0 0 0;
            color: var(--bc-muted);
            font-size: 11px;
        }

    .bc-card {
        background: var(--bc-surface);
        border: 1px solid var(--bc-border);
        border-radius: var(--bc-radius);
        box-shadow: var(--bc-shadow-sm);
        padding: 9px 10px;
        margin-bottom: 8px;
    }

    .bc-filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 8px 10px;
        align-items: end;
    }

    .form-label {
        position: relative;
        display: block;
        margin: 0;
    }

    .form-control.FormclrField {
        height: 30px;
        border-radius: var(--bc-radius-sm);
        border: 1.3px solid var(--bc-border);
        font-size: 12px;
        padding: 0 9px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .form-control.FormclrField:focus {
            border-color: var(--bc-primary);
            box-shadow: 0 0 0 2px var(--bc-primary-light);
            outline: none;
        }

    .labelup {
        position: absolute;
        top: -7px;
        left: 8px;
        background: var(--bc-surface);
        color: var(--bc-muted);
        font-size: 10px;
        font-weight: 600;
        padding: 0 4px;
        pointer-events: none;
        letter-spacing: .2px;
    }

    .clrdivs {
        font-size: 10px;
        min-height: 12px;
        margin-top: 2px;
        color: var(--bc-danger) !important;
    }

    .bc-btn {
        height: 30px;
        border-radius: var(--bc-radius-sm);
        border: none;
        font-size: 12px;
        font-weight: 600;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
        transition: transform .08s ease, box-shadow .15s ease, opacity .15s ease;
        white-space: nowrap;
    }

        .bc-btn:active {
            transform: scale(.97);
        }

        .bc-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .bc-btn-primary {
        background: var(--bc-primary);
        color: #fff;
    }

        .bc-btn-primary:hover:not(:disabled) {
            background: var(--bc-primary-dark);
        }

    .bc-btn-outline {
        background: #fff;
        color: var(--bc-text);
        border: 1.3px solid var(--bc-border);
    }

        .bc-btn-outline:hover:not(:disabled) {
            border-color: var(--bc-primary);
            color: var(--bc-primary);
        }

    .bc-btn-success {
        background: var(--bc-success);
        color: #fff;
    }

    .bc-btn-danger {
        background: #fff;
        color: var(--bc-danger);
        border: 1.3px solid var(--bc-danger-light);
    }

        .bc-btn-danger:hover:not(:disabled) {
            background: var(--bc-danger-light);
        }

    .bc-btn-sm {
        height: 25px;
        padding: 0 9px;
        font-size: 11px;
    }

    /* ---- Toolbar ---- */
    .bc-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .bc-search {
        position: relative;
        flex: 1 1 200px;
        max-width: 280px;
    }

        .bc-search input {
            width: 100%;
            height: 28px;
            border-radius: 18px;
            border: 1.3px solid var(--bc-border);
            padding: 0 12px 0 30px;
            font-size: 11.5px;
        }

        .bc-search i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--bc-muted);
            font-size: 12px;
        }

    .bc-bulkactions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* ---- Table ---- */
    .bc-table-wrap {
        background: var(--bc-surface);
        border: 1px solid var(--bc-border);
        border-radius: var(--bc-radius);
        box-shadow: var(--bc-shadow-sm);
        overflow: auto;
        max-height: 74vh;
    }

    #tblBulkCollectionData {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        #tblBulkCollectionData thead th {
            position: sticky;
            top: 0;
            background: #f7f8fc;
            color: var(--bc-text);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .2px;
            padding: 6px 6px;
            border-bottom: 1.3px solid var(--bc-border);
            white-space: nowrap;
            z-index: 2;
        }

        #tblBulkCollectionData tbody td {
            padding: 4px 6px;
            border-bottom: 1px solid #eef0f5;
            white-space: nowrap;
            vertical-align: middle;
            line-height: 1.25;
        }

        #tblBulkCollectionData tbody tr:hover {
            background: #fafbff;
        }

        #tblBulkCollectionData tbody tr {
            border-left: 3px solid transparent;
        }

            #tblBulkCollectionData tbody tr.row-settled {
                border-left-color: var(--bc-success);
            }

            #tblBulkCollectionData tbody tr.row-partial {
                border-left-color: var(--bc-warning);
            }

    .cell-strong {
        font-weight: 700;
    }

    .text-end {
        text-align: right;
    }

    .text-center {
        text-align: center;
    }

    .cell-input input {
        width: 75px;
        height: 25px;
        border-radius: 6px;
        border: 1.2px solid var(--bc-border);
        text-align: right;
        font-size: 11px;
        padding: 0 5px;
        transition: border-color .12s ease, box-shadow .12s ease, background .15s ease;
    }

        .cell-input input:focus {
            border-color: var(--bc-primary);
            box-shadow: 0 0 0 2px var(--bc-primary-light);
            outline: none;
        }

        .cell-input input.input-flash {
            border-color: var(--bc-danger);
            background: var(--bc-danger-light);
        }

    .disccell-input input {
        width: 55px;
        height: 25px;
        border-radius: 6px;
        border: 1.2px solid var(--bc-border);
        text-align: right;
        font-size: 11px;
        padding: 0 5px;
        transition: border-color .12s ease, box-shadow .12s ease, background .15s ease;
    }

        .disccell-input input:focus {
            border-color: var(--bc-primary);
            box-shadow: 0 0 0 2px var(--bc-primary-light);
            outline: none;
        }

        .disccell-input input.input-flash {
            border-color: var(--bc-danger);
            background: var(--bc-danger-light);
        }

        .cell-input input:disabled,
        .disccell-input input:disabled {
            background: #f1f2f6;
            color: #aab0bd;
            border-color: var(--bc-border);
            cursor: not-allowed;
            opacity: .75;
        }

    .btn-collect:disabled {
        opacity: .5;
        cursor: not-allowed;
        background: #fff;
        color: var(--bc-muted);
        border-style: dashed;
    }

    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .remaining-hint {
        font-size: 9px;
        color: var(--bc-muted);
        margin-top: 0;
    }

    .badge-transname {
        display: inline-block;
        font-size: 8.5px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 16px;
        margin-top: 2px;
        letter-spacing: .2px;
        background: #d7e4fc;
        color: #183dce;
    }

    .badge-status {
        display: inline-block;
        font-size: 8.5px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 16px;
        margin-top: 2px;
        letter-spacing: .2px;
    }

    .badge-pending {
        background: #eef0f4;
        color: var(--bc-muted);
    }

    .badge-partial {
        background: var(--bc-warning-light);
        color: var(--bc-warning);
    }

    .badge-settled {
        background: var(--bc-success-light);
        color: var(--bc-success);
    }

    /* ---- Collected / payments cell ---- */
    .pay-cell {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 1px;
    }

    .btn-collect {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: 1.2px dashed var(--bc-border);
        background: #fff;
        color: var(--bc-primary);
        font-size: 10px;
        font-weight: 600;
        border-radius: 14px;
        padding: 1px 8px;
        cursor: pointer;
        transition: all .15s ease;
    }

        .btn-collect:hover {
            background: var(--bc-primary-light);
        }

        .btn-collect.has-pay {
            border-style: solid;
            border-color: var(--bc-primary);
            background: var(--bc-primary);
            color: #fff;
        }

        .btn-collect.flash-warn {
            border-color: var(--bc-danger);
            color: var(--bc-danger);
        }

    #tblBulkCollectionData tfoot td {
        padding: 6px 6px;
        font-size: 11px;
        background: #f7f8fc;
        border-top: 2px solid var(--bc-border);
        font-weight: 700;
        white-space: nowrap;
    }

    #emptyState {
        text-align: center;
        padding: 40px 20px;
        color: var(--bc-muted);
    }

        #emptyState i {
            font-size: 32px;
            opacity: .35;
            display: block;
            margin-bottom: 8px;
        }

    .bc-loading {
        display: none;
        text-align: center;
        padding: 30px 0;
        color: var(--bc-muted);
        font-size: 12px;
    }

        .bc-loading .spinner {
            width: 24px;
            height: 24px;
            border: 3px solid var(--bc-border);
            border-top-color: var(--bc-primary);
            border-radius: 50%;
            margin: 0 auto 8px auto;
            animation: bc-spin 0.7s linear infinite;
        }

    @@keyframes bc-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ---- Bottom action / summary bar ---- */
    .footerAction {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--bc-surface);
        border-top: 1px solid var(--bc-border);
        box-shadow: 0 -6px 18px rgba(20,24,40,.08);
        padding: 6px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        z-index: 50;
    }

        .footerAction .bc-mini-summary {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            font-size: 11px;
            color: var(--bc-text);
        }

            .footerAction .bc-mini-summary .stat {
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

                .footerAction .bc-mini-summary .stat .lbl {
                    font-size: 8.5px;
                    text-transform: uppercase;
                    letter-spacing: .2px;
                    color: var(--bc-muted);
                    font-weight: 700;
                }

                .footerAction .bc-mini-summary .stat .val {
                    font-size: 12.5px;
                    font-weight: 700;
                }

                .footerAction .bc-mini-summary .stat.acc-collected .val {
                    color: var(--bc-success);
                }

                .footerAction .bc-mini-summary .stat.acc-remaining .val {
                    color: var(--bc-danger);
                }

        .footerAction .bc-actions {
            display: flex;
            gap: 8px;
        }

    /* ---- Toasts ---- */
    .toastBox {
        position: fixed;
        top: 10px;
        right: 10px;
        z-index: 999;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .bc-toast {
        min-width: 220px;
        max-width: 320px;
        background: var(--bc-text);
        color: #fff;
        padding: 9px 12px;
        border-radius: var(--bc-radius-sm);
        font-size: 11.5px;
        box-shadow: var(--bc-shadow-md);
        display: flex;
        align-items: flex-start;
        gap: 7px;
        animation: bc-toast-in .2s ease;
    }

        .bc-toast.success {
            background: var(--bc-success);
        }

        .bc-toast.warning {
            background: var(--bc-warning);
        }

        .bc-toast.danger {
            background: var(--bc-danger);
        }

    @@keyframes bc-toast-in {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---- Payments modal (multiple payment methods per document) ---- */
    .modalPayments {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 200;
        background: rgba(15,18,30,.45);
        align-items: center;
        justify-content: center;
    }

    .modalPayments-content {
        background: #fff;
        width: 94%;
        max-width: 480px;
        max-height: 88vh;
        overflow: auto;
        border-radius: var(--bc-radius);
        padding: 16px;
        box-shadow: var(--bc-shadow-md);
    }

        .modalPayments-content h5 {
            margin: 0 0 4px 0;
            font-weight: 700;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modalPayments-content .sub {
            font-size: 11px;
            color: var(--bc-muted);
            margin-bottom: 10px;
        }

    .closePay {
        cursor: pointer;
        color: var(--bc-muted);
        font-size: 16px;
    }

        .closePay:hover {
            color: var(--bc-text);
        }

    .pay-summary-row {
        display: flex;
        justify-content: space-between;
        background: var(--bc-bg);
        border-radius: var(--bc-radius-sm);
        padding: 7px 10px;
        font-size: 11px;
        margin-bottom: 10px;
    }

        .pay-summary-row b {
            font-size: 12.5px;
        }

    .pay-add-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin-bottom: 8px;
    }

    .pay-field label {
        font-size: 10.5px;
        font-weight: 600;
        color: var(--bc-muted);
        display: block;
        margin-bottom: 2px;
    }

    .pay-field input, .pay-field select, .pay-field textarea {
        width: 100%;
        height: 30px;
        border-radius: var(--bc-radius-sm);
        border: 1.3px solid var(--bc-border);
        padding: 0 8px;
        font-size: 12px;
    }

    .pay-field textarea {
        height: 44px;
        padding: 6px 8px;
        resize: vertical;
    }

    .pay-field.full {
        grid-column: 1 / -1;
    }

    #btnAddPayment {
        width: 100%;
        justify-content: center;
        margin-bottom: 10px;
    }

    .pay-list {
        border-top: 1px dashed var(--bc-border);
        padding-top: 8px;
    }

    .pay-list-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 7px 4px;
        border-bottom: 1px solid #f1f2f7;
        font-size: 12px;
    }

        .pay-list-item .mode-chip {
            font-size: 10px;
            font-weight: 700;
            background: var(--bc-primary-light);
            color: var(--bc-primary);
            border-radius: 12px;
            padding: 2px 8px;
            margin-right: 6px;
        }

        .pay-list-item .meta {
            font-size: 10px;
            color: var(--bc-muted);
        }

        .pay-list-item .pay-del {
            border: none;
            background: none;
            color: var(--bc-danger);
            cursor: pointer;
            font-size: 14px;
        }

    .pay-empty {
        text-align: center;
        font-size: 11px;
        color: var(--bc-muted);
        padding: 14px 0;
    }

    /* =========================================================
       RESPONSIVE BREAKPOINTS
       ========================================================= */
    @@media (max-width: 768px) {
        .footerAction {
            flex-direction: column;
            align-items: stretch;
        }

            .footerAction .bc-mini-summary {
                justify-content: space-between;
            }

            .footerAction .bc-actions .bc-btn {
                flex: 1;
                justify-content: center;
            }
        /* Convert the data grid into stacked cards on small screens */
        #tblBulkCollectionData thead {
            display: none;
        }

        #tblBulkCollectionData, #tblBulkCollectionData tbody, #tblBulkCollectionData tr, #tblBulkCollectionData td {
            display: block;
            width: 100% !important;
        }

        .bc-table-wrap {
            max-height: none;
            overflow: visible;
            background: transparent;
            border: none;
            box-shadow: none;
        }

        #tblBulkCollectionData tbody tr {
            background: var(--bc-surface);
            border: 1px solid var(--bc-border);
            border-radius: var(--bc-radius);
            padding: 4px 10px;
            margin-bottom: 8px;
            box-shadow: var(--bc-shadow-sm);
        }

        #tblBulkCollectionData tbody td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px dashed #eef0f5;
            padding: 7px 0;
            white-space: normal;
        }

            #tblBulkCollectionData tbody td:last-child {
                border-bottom: none;
            }

            #tblBulkCollectionData tbody td::before {
                content: attr(data-label);
                font-size: 10px;
                font-weight: 700;
                color: var(--bc-muted);
                text-transform: uppercase;
                letter-spacing: .2px;
                flex: 0 0 40%;
            }

        .pay-cell {
            align-items: flex-end;
        }

        #tblBulkCollectionData tfoot {
            display: none;
        }
    }

    @@media (max-width: 480px) {
        .bc-header h4 {
            font-size: 15px;
        }

        .pay-add-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<body>
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    @Html.HiddenFor(model => model.EnableReturnPrice, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtReurnPricePerm" })

    <div class="toastBox"></div>

    <div id="dvBulkCollection">

        <div class="bc-header">
            <div>
                <h4 id="MainHeading">@ViewData["FormName"]</h4>
            </div>
        </div>

        <!-- ===================== FILTER CARD ===================== -->
        <div class="bc-card">
            <div class="bc-filter-grid">
                <div>
                    <span class="form-label flex-grow-1">
                        <select class="form-control FormclrcmbField" id="cmbBranch"><option value="0">Select Branch</option></select>
                        <label class="labelup" for="txtCode"> Branch *</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrBranch"></div>
                </div>
                <div>
                    <span class="form-label">
                        <input class="form-control FormclrField" id="txtBeat" placeholder=" " autocomplete="off" />
                        <label class="labelup">Beat</label>
                    </span>
                    <div id="divErrBeat" class="clrdivs"></div>
                </div>
                <div>
                    <span class="form-label">

                        <input class="form-control FormclrField" id="txtSalesman" placeholder=" " autocomplete="off" />
                        <label class="labelup">Salesman</label>
                    </span>
                    <div id="divErrSalesman" class="clrdivs"></div>
                </div>
                <div>
                    <span class="form-label">
                        <input class="form-control FormclrField" id="txtCustomer" placeholder=" " style="width:250px" autocomplete="off" />
                        <label class="labelup">Customer</label>
                    </span>
                    <div id="divErrCustomer" class="clrdivs"></div>
                </div>
                <div>
                    <span class="form-label">
                        <input class="form-control FormclrField" type="date" id="txtAsonDate" style="width:auto" placeholder=" " />
                        <label class="labelup">As on Date</label>
                    </span>
                    <div id="divErrAsonDate" class="clrdivs"></div>
