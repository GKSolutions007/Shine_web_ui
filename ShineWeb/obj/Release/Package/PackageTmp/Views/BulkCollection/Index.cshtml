@model ShineWeb.Models.SingleMasterModel
@{
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
    ViewBag.Title = ViewData["FormName"];
}

<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />

<link href="~/datatable/1.13.6/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<!-- Bootstrap 5 -->
@*<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />*@
<script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>

<script src="~/datatable/1.13.6/jquery.dataTables.min.js"></script>
<script src="~/datatable/1.13.6/dataTables.bootstrap5.min.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/Scripts/multiselect/GKBSmultiselectiondropdown.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<header>
    <link rel="stylesheet" href="~/Content/index.css">
    <!-- Icon font for the modernized UI. Host locally if this environment has no internet access. -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
</header>

<style>
    :root {
        --bc-primary: #4f46e5;
        --bc-primary-dark: #3c35b5;
        --bc-primary-light: #eef0ff;
        --bc-success: #16a34a;
        --bc-success-light: #e7f8ed;
        --bc-warning: #d97706;
        --bc-warning-light: #fef3e2;
        --bc-danger: #dc2626;
        --bc-danger-light: #fdeaea;
        --bc-bg: #f3f5fb;
        --bc-surface: #ffffff;
        --bc-text: #1e2433;
        --bc-muted: #707b8c;
        --bc-border: #e3e7ef;
        --bc-radius: 12px;
        --bc-radius-sm: 7px;
        --bc-shadow-sm: 0 1px 3px rgba(20,24,40,.06);
        --bc-shadow-md: 0 6px 20px rgba(20,24,40,.09);
    }

    #dvBulkCollection, #dvBulkCollection input, #dvBulkCollection button, #dvBulkCollection select {
        font-family: 'Segoe UI', Inter, Roboto, Arial, sans-serif;
    }

    #dvBulkCollection {
        background: var(--bc-bg);
        padding: 10px 10px 64px 10px;
        color: var(--bc-text);
    }

    .bc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
    }

        .bc-header h4 {
            margin: 0;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: -.2px;
        }

        .bc-header p {
            margin: 1px 0 0 0;
            color: var(--bc-muted);
            font-size: 11px;
        }

    .bc-card {
        background: var(--bc-surface);
        border: 1px solid var(--bc-border);
        border-radius: var(--bc-radius);
        box-shadow: var(--bc-shadow-sm);
        padding: 9px 10px;
        margin-bottom: 8px;
    }

    .bc-filter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 8px 10px;
        align-items: end;
    }

    .form-label {
        position: relative;
        display: block;
        margin: 0;
    }

    .form-control.FormclrField {
        height: 30px;
        border-radius: var(--bc-radius-sm);
        border: 1.3px solid var(--bc-border);
        font-size: 12px;
        padding: 0 9px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .form-control.FormclrField:focus {
            border-color: var(--bc-primary);
            box-shadow: 0 0 0 2px var(--bc-primary-light);
            outline: none;
        }

    .labelup {
        position: absolute;
        top: -7px;
        left: 8px;
        background: var(--bc-surface);
        color: var(--bc-muted);
        font-size: 10px;
        font-weight: 600;
        padding: 0 4px;
        pointer-events: none;
        letter-spacing: .2px;
    }

    .clrdivs {
        font-size: 10px;
        min-height: 12px;
        margin-top: 2px;
        color: var(--bc-danger) !important;
    }

    .bc-btn {
        height: 30px;
        border-radius: var(--bc-radius-sm);
        border: none;
        font-size: 12px;
        font-weight: 600;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
        transition: transform .08s ease, box-shadow .15s ease, opacity .15s ease;
        white-space: nowrap;
    }

        .bc-btn:active {
            transform: scale(.97);
        }

        .bc-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .bc-btn-primary {
        background: var(--bc-primary);
        color: #fff;
    }

        .bc-btn-primary:hover:not(:disabled) {
            background: var(--bc-primary-dark);
        }

    .bc-btn-outline {
        background: #fff;
        color: var(--bc-text);
        border: 1.3px solid var(--bc-border);
    }

        .bc-btn-outline:hover:not(:disabled) {
            border-color: var(--bc-primary);
            color: var(--bc-primary);
        }

    .bc-btn-success {
        background: var(--bc-success);
        color: #fff;
    }

    .bc-btn-danger {
        background: #fff;
        color: var(--bc-danger);
        border: 1.3px solid var(--bc-danger-light);
    }

        .bc-btn-danger:hover:not(:disabled) {
            background: var(--bc-danger-light);
        }

    .bc-btn-sm {
        height: 25px;
        padding: 0 9px;
        font-size: 11px;
    }

    /* ---- Toolbar ---- */
    .bc-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

    .bc-search {
        position: relative;
        flex: 1 1 200px;
        max-width: 280px;
    }

        .bc-search input {
            width: 100%;
            height: 28px;
            border-radius: 18px;
            border: 1.3px solid var(--bc-border);
            padding: 0 12px 0 30px;
            font-size: 11.5px;
        }

        .bc-search i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--bc-muted);
            font-size: 12px;
        }

    .bc-bulkactions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* ---- Table ---- */
    .bc-table-wrap {
        background: var(--bc-surface);
        border: 1px solid var(--bc-border);
        border-radius: var(--bc-radius);
        box-shadow: var(--bc-shadow-sm);
        overflow: auto;
        max-height: 74vh;
    }

    #tblBulkCollectionData {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        #tblBulkCollectionData thead th {
            position: sticky;
            top: 0;
            background: #f7f8fc;
            color: var(--bc-text);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .2px;
            padding: 6px 6px;
            border-bottom: 1.3px solid var(--bc-border);
            white-space: nowrap;
            z-index: 2;
        }

        #tblBulkCollectionData tbody td {
            padding: 4px 6px;
            border-bottom: 1px solid #eef0f5;
            white-space: nowrap;
            vertical-align: middle;
            line-height: 1.25;
        }

        #tblBulkCollectionData tbody tr:hover {
            background: #fafbff;
        }

        #tblBulkCollectionData tbody tr {
            border-left: 3px solid transparent;
        }

            #tblBulkCollectionData tbody tr.row-settled {
                border-left-color: var(--bc-success);
            }

            #tblBulkCollectionData tbody tr.row-partial {
                border-left-color: var(--bc-warning);
            }

    .cell-strong {
        font-weight: 700;
    }

    .text-end {
        text-align: right;
    }

    .text-center {
        text-align: center;
    }

    .cell-input input {
        width: 75px;
        height: 25px;
        border-radius: 6px;
        border: 1.2px solid var(--bc-border);
        text-align: right;
        font-size: 11px;
        padding: 0 5px;
        transition: border-color .12s ease, box-shadow .12s ease, background .15s ease;
    }

        .cell-input input:focus {
            border-color: var(--bc-primary);
            box-shadow: 0 0 0 2px var(--bc-primary-light);
            outline: none;
        }

        .cell-input input.input-flash {
            border-color: var(--bc-danger);
            background: var(--bc-danger-light);
        }

    .disccell-input input {
        width: 55px;
        height: 25px;
        border-radius: 6px;
        border: 1.2px solid var(--bc-border);
        text-align: right;
        font-size: 11px;
        padding: 0 5px;
        transition: border-color .12s ease, box-shadow .12s ease, background .15s ease;
    }

        .disccell-input input:focus {
            border-color: var(--bc-primary);
            box-shadow: 0 0 0 2px var(--bc-primary-light);
            outline: none;
        }

        .disccell-input input.input-flash {
            border-color: var(--bc-danger);
            background: var(--bc-danger-light);
        }

        .cell-input input:disabled,
        .disccell-input input:disabled {
            background: #f1f2f6;
            color: #aab0bd;
            border-color: var(--bc-border);
            cursor: not-allowed;
            opacity: .75;
        }

    .btn-collect:disabled {
        opacity: .5;
        cursor: not-allowed;
        background: #fff;
        color: var(--bc-muted);
        border-style: dashed;
    }

    input[type=number]::-webkit-outer-spin-button,
    input[type=number]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .remaining-hint {
        font-size: 9px;
        color: var(--bc-muted);
        margin-top: 0;
    }

    .badge-transname {
        display: inline-block;
        font-size: 8.5px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 16px;
        margin-top: 2px;
        letter-spacing: .2px;
        background: #d7e4fc;
        color: #183dce;
    }

    .badge-status {
        display: inline-block;
        font-size: 8.5px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 16px;
        margin-top: 2px;
        letter-spacing: .2px;
    }

    .badge-pending {
        background: #eef0f4;
        color: var(--bc-muted);
    }

    .badge-partial {
        background: var(--bc-warning-light);
        color: var(--bc-warning);
    }

    .badge-settled {
        background: var(--bc-success-light);
        color: var(--bc-success);
    }

    /* ---- Collected / payments cell ---- */
    .pay-cell {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 1px;
    }

    .btn-collect {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: 1.2px dashed var(--bc-border);
        background: #fff;
        color: var(--bc-primary);
        font-size: 10px;
        font-weight: 600;
        border-radius: 14px;
        padding: 1px 8px;
        cursor: pointer;
        transition: all .15s ease;
    }

        .btn-collect:hover {
            background: var(--bc-primary-light);
        }

        .btn-collect.has-pay {
            border-style: solid;
            border-color: var(--bc-primary);
            background: var(--bc-primary);
            color: #fff;
        }

        .btn-collect.flash-warn {
            border-color: var(--bc-danger);
            color: var(--bc-danger);
        }

    #tblBulkCollectionData tfoot td {
        padding: 6px 6px;
        font-size: 11px;
        background: #f7f8fc;
        border-top: 2px solid var(--bc-border);
        font-weight: 700;
        white-space: nowrap;
    }

    #emptyState {
        text-align: center;
        padding: 40px 20px;
        color: var(--bc-muted);
    }

        #emptyState i {
            font-size: 32px;
            opacity: .35;
            display: block;
            margin-bottom: 8px;
        }

    .bc-loading {
        display: none;
        text-align: center;
        padding: 30px 0;
        color: var(--bc-muted);
        font-size: 12px;
    }

        .bc-loading .spinner {
            width: 24px;
            height: 24px;
            border: 3px solid var(--bc-border);
            border-top-color: var(--bc-primary);
            border-radius: 50%;
            margin: 0 auto 8px auto;
            animation: bc-spin 0.7s linear infinite;
        }

    @@keyframes bc-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ---- Bottom action / summary bar ---- */
    .footerAction {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        background: var(--bc-surface);
        border-top: 1px solid var(--bc-border);
        box-shadow: 0 -6px 18px rgba(20,24,40,.08);
        padding: 6px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        z-index: 50;
    }

        .footerAction .bc-mini-summary {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            font-size: 11px;
            color: var(--bc-text);
        }

            .footerAction .bc-mini-summary .stat {
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }

                .footerAction .bc-mini-summary .stat .lbl {
                    font-size: 8.5px;
                    text-transform: uppercase;
                    letter-spacing: .2px;
                    color: var(--bc-muted);
                    font-weight: 700;
                }

                .footerAction .bc-mini-summary .stat .val {
                    font-size: 12.5px;
                    font-weight: 700;
                }

                .footerAction .bc-mini-summary .stat.acc-collected .val {
                    color: var(--bc-success);
                }

                .footerAction .bc-mini-summary .stat.acc-remaining .val {
                    color: var(--bc-danger);
                }

        .footerAction .bc-actions {
            display: flex;
            gap: 8px;
        }

    /* ---- Toasts ---- */
    .toastBox {
        position: fixed;
        top: 30px;
        right: 10px;
        z-index: 999;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .bc-toast {
        min-width: 220px;
        max-width: 320px;
        background: var(--bc-text);
        color: #fff;
        padding: 9px 12px;
        border-radius: var(--bc-radius-sm);
        font-size: 11.5px;
        box-shadow: var(--bc-shadow-md);
        display: flex;
        align-items: flex-start;
        gap: 7px;
        animation: bc-toast-in .2s ease;
    }

        .bc-toast.success {
            background: var(--bc-success);
        }

        .bc-toast.warning {
            background: var(--bc-warning);
        }

        .bc-toast.danger {
            background: var(--bc-danger);
        }

    @@keyframes bc-toast-in {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---- Payments modal (multiple payment methods per document) ---- */
    .modalPayments {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 200;
        background: rgba(15,18,30,.45);
        align-items: center;
        justify-content: center;
    }

    .modalPayments-content {
        background: #fff;
        width: 94%;
        max-width: 480px;
        max-height: 88vh;
        overflow: auto;
        border-radius: var(--bc-radius);
        padding: 16px;
        box-shadow: var(--bc-shadow-md);
    }

        .modalPayments-content h5 {
            margin: 0 0 4px 0;
            font-weight: 700;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modalPayments-content .sub {
            font-size: 11px;
            color: var(--bc-muted);
            margin-bottom: 10px;
        }

    .closePay {
        cursor: pointer;
        color: var(--bc-muted);
        font-size: 16px;
    }

        .closePay:hover {
            color: var(--bc-text);
        }

    .pay-summary-row {
        display: flex;
        justify-content: space-between;
        background: var(--bc-bg);
        border-radius: var(--bc-radius-sm);
        padding: 7px 10px;
        font-size: 11px;
        margin-bottom: 2px;
    }

        .pay-summary-row b {
            font-size: 13px;
        }

    .pay-add-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin-bottom: 8px;
    }

    .pay-field label {
        font-size: 10.5px;
        font-weight: 600;
        color: var(--bc-muted);
        display: block;
        margin-bottom: 2px;
    }

    .pay-field input, .pay-field select, .pay-field textarea {
        width: 100%;
        height: 30px;
        border-radius: var(--bc-radius-sm);
        border: 1.3px solid var(--bc-border);
        padding: 0 8px;
        font-size: 12px;
    }

    .pay-field textarea {
        height: 44px;
        padding: 6px 8px;
        resize: vertical;
    }

    .pay-field.full {
        grid-column: 1 / -1;
    }

    .pay-list {
        border-top: 1px dashed var(--bc-border);
        padding-top: 8px;
    }

    .pay-list-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 7px 4px;
        border-bottom: 1px solid #f1f2f7;
        font-size: 12px;
    }

        .pay-list-item .mode-chip {
            font-size: 10px;
            font-weight: 700;
            background: var(--bc-primary-light);
            color: var(--bc-primary);
            border-radius: 12px;
            padding: 2px 8px;
            margin-right: 6px;
        }

        .pay-list-item .meta {
            font-size: 10px;
            color: var(--bc-muted);
        }

        .pay-list-item .pay-del {
            border: none;
            background: none;
            color: var(--bc-danger);
            cursor: pointer;
            font-size: 14px;
        }

    .pay-empty {
        text-align: center;
        font-size: 11px;
        color: var(--bc-muted);
        padding: 14px 0;
    }

    /* ---- TransName filter tabs ---- */
    .bc-transname-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        align-items: center;
    }

    .bc-tab {
        height: 26px;
        padding: 0 11px;
        border-radius: 14px;
        border: 1.3px solid var(--bc-border);
        background: #fff;
        color: var(--bc-muted);
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background .12s ease, color .12s ease, border-color .12s ease;
        white-space: nowrap;
    }

        .bc-tab:hover {
            border-color: var(--bc-primary);
            color: var(--bc-primary);
        }

        .bc-tab.active {
            background: var(--bc-primary);
            color: #fff;
            border-color: var(--bc-primary);
        }

        .bc-tab.all-tab.active {
            background: var(--bc-text);
            border-color: var(--bc-text);
        }

        .bc-tab .tab-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,0.25);
            color: inherit;
            border-radius: 10px;
            min-width: 18px;
            height: 16px;
            font-size: 9.5px;
            font-weight: 700;
            padding: 0 4px;
        }

        .bc-tab:not(.active) .tab-count {
            background: var(--bc-bg);
            color: var(--bc-muted);
        }

    /* =========================================================
       RESPONSIVE BREAKPOINTS
       ========================================================= */
    @@media (max-width: 768px) {
        .footerAction {
            flex-direction: column;
            align-items: stretch;
        }

            .footerAction .bc-mini-summary {
                justify-content: space-between;
            }

            .footerAction .bc-actions .bc-btn {
                flex: 1;
                justify-content: center;
            }
        /* Convert the data grid into stacked cards on small screens */
        #tblBulkCollectionData thead {
            display: none;
        }

        #tblBulkCollectionData, #tblBulkCollectionData tbody, #tblBulkCollectionData tr, #tblBulkCollectionData td {
            display: block;
            width: 100% !important;
        }

        .bc-table-wrap {
            max-height: none;
            overflow: visible;
            background: transparent;
            border: none;
            box-shadow: none;
        }

        #tblBulkCollectionData tbody tr {
            background: var(--bc-surface);
            border: 1px solid var(--bc-border);
            border-radius: var(--bc-radius);
            padding: 4px 10px;
            margin-bottom: 8px;
            box-shadow: var(--bc-shadow-sm);
        }

        #tblBulkCollectionData tbody td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px dashed #eef0f5;
            padding: 7px 0;
            white-space: normal;
        }

            #tblBulkCollectionData tbody td:last-child {
                border-bottom: none;
            }

            #tblBulkCollectionData tbody td::before {
                content: attr(data-label);
                font-size: 10px;
                font-weight: 700;
                color: var(--bc-muted);
                text-transform: uppercase;
                letter-spacing: .2px;
                flex: 0 0 40%;
            }

        .pay-cell {
            align-items: flex-end;
        }

        #tblBulkCollectionData tfoot {
            display: none;
        }
    }

    @@media (max-width: 480px) {
        .bc-header h4 {
            font-size: 15px;
        }

        .pay-add-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ---- Remarks button ---- */
    .btn-remark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        border: 1.2px solid var(--bc-border);
        background: #fff;
        color: var(--bc-muted);
        font-size: 13px;
        cursor: pointer;
        transition: all .15s ease;
        position: relative;
    }

        .btn-remark:hover {
            border-color: var(--bc-primary);
            color: var(--bc-primary);
            background: var(--bc-primary-light);
        }

        .btn-remark.has-remark {
            border-color: var(--bc-warning);
            color: var(--bc-warning);
            background: var(--bc-warning-light);
        }

    /* ---- Remark tooltip ---- */
    .remark-tooltip-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .remark-tooltip {
        display: none;
        position: absolute;
        bottom: calc(100% + 6px);
        right: 0;
        min-width: 200px;
        max-width: 280px;
        background: var(--bc-text);
        color: #fff;
        font-size: 10.5px;
        padding: 7px 10px;
        border-radius: var(--bc-radius-sm);
        box-shadow: var(--bc-shadow-md);
        z-index: 300;
        white-space: normal;
        line-height: 1.5;
        pointer-events: none;
    }

        .remark-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            right: 9px;
            border: 5px solid transparent;
            border-top-color: var(--bc-text);
        }

        .remark-tooltip .tt-label {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            color: rgba(255,255,255,.65);
            margin-bottom: 2px;
        }

        .remark-tooltip .tt-value {
            word-break: break-word;
        }

    .remark-tooltip-wrap:hover .remark-tooltip {
        display: block;
    }

    /* ---- Save Response Badge ---- */
    .save-error-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        margin-left: 4px;
        vertical-align: middle;
        flex-shrink: 0;
        position: relative;
        border: none;
        line-height: 1;
    }

        /* Error badge — red */
        .save-error-badge.save-badge-error {
            background: var(--bc-danger, #dc2626);
        }

            .save-error-badge.save-badge-error:hover {
                background: #b91c1c;
            }

        /* Success badge — green */
        .save-error-badge.save-badge-success {
            background: var(--bc-success, #16a34a);
        }

            .save-error-badge.save-badge-success:hover {
                background: #15803d;
            }

    .save-error-tooltip {
        display: none;
        position: absolute;
        bottom: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        min-width: 190px;
        max-width: 260px;
        color: #fff;
        font-size: 10.5px;
        padding: 7px 10px;
        border-radius: var(--bc-radius-sm, 4px);
        box-shadow: var(--bc-shadow-md);
        z-index: 400;
        white-space: normal;
        line-height: 1.5;
        pointer-events: none;
        font-weight: 600;
        text-align: left;
    }

        /* Error tooltip — red */
        .save-error-tooltip.save-tip-error {
            background: var(--bc-danger, #dc2626);
        }

            .save-error-tooltip.save-tip-error::after {
                border-top-color: var(--bc-danger, #dc2626);
            }

        /* Success tooltip — green */
        .save-error-tooltip.save-tip-success {
            background: var(--bc-success, #16a34a);
        }

            .save-error-tooltip.save-tip-success::after {
                border-top-color: var(--bc-success, #16a34a);
            }

        .save-error-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 5px solid transparent;
        }

    .save-error-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

        .save-error-wrap:hover .save-error-tooltip {
            display: block;
        }

    /* Row highlight */
    #tblBulkCollectionData tbody tr.row-save-error {
        border-left-color: var(--bc-danger, #dc2626) !important;
        background-color: #fff5f5 !important;
    }

    #tblBulkCollectionData tbody tr.row-save-success {
        border-left-color: var(--bc-success, #16a34a) !important;
        background-color: #f0fdf4 !important;
    }
    /* ---- Remarks modal ---- */
    .modalRemarks {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 250;
        background: rgba(15,18,30,.45);
        align-items: center;
        justify-content: center;
    }

    .modalRemarks-content {
        background: #fff;
        width: 94%;
        max-width: 440px;
        border-radius: var(--bc-radius);
        padding: 18px;
        box-shadow: var(--bc-shadow-md);
    }

        .modalRemarks-content h5 {
            margin: 0 0 4px 0;
            font-weight: 700;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modalRemarks-content .sub {
            font-size: 11px;
            color: var(--bc-muted);
            margin-bottom: 14px;
        }

    .remark-field label {
        font-size: 10.5px;
        font-weight: 600;
        color: var(--bc-muted);
        display: block;
        margin-bottom: 3px;
    }

    .remark-field textarea {
        width: 100%;
        border-radius: var(--bc-radius-sm);
        border: 1.3px solid var(--bc-border);
        padding: 7px 9px;
        font-size: 12px;
        font-family: inherit;
        resize: vertical;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .remark-field textarea:focus {
            border-color: var(--bc-primary);
            box-shadow: 0 0 0 2px var(--bc-primary-light);
            outline: none;
        }

    .closeRemark {
        cursor: pointer;
        color: var(--bc-muted);
        font-size: 16px;
    }

        .closeRemark:hover {
            color: var(--bc-text);
        }

    /* ---- FAID row background colour palette ---- */
    /* 12 distinct light tints that cycle per unique FAID */
    .faid-bg-0 {
        background-color: #eef4ff !important;
    }

    .faid-bg-1 {
        background-color: #fff8ee !important;
    }

    .faid-bg-2 {
        background-color: #edfff5 !important;
    }

    .faid-bg-3 {
        background-color: #fff0f0 !important;
    }

    .faid-bg-4 {
        background-color: #f4eeff !important;
    }

    .faid-bg-5 {
        background-color: #edfffe !important;
    }

    .faid-bg-6 {
        background-color: #fffbee !important;
    }

    .faid-bg-7 {
        background-color: #f0f9ff !important;
    }

    .faid-bg-8 {
        background-color: #fff0fa !important;
    }

    .faid-bg-9 {
        background-color: #f0fff4 !important;
    }

    .faid-bg-10 {
        background-color: #fef9ee !important;
    }

    .faid-bg-11 {
        background-color: #eef6ff !important;
    }

    #tblBulkCollectionData tbody tr:hover td {
        filter: brightness(0.97);
    }

    /* ---- Summary Modal ---- */
    .modalSummary {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 300;
        background: rgba(15,18,30,.5);
        align-items: center;
        justify-content: center;
    }

    .modalSummary-content {
        background: #fff;
        width: 96%;
        max-width: 820px;
        max-height: 88vh;
        overflow: auto;
        border-radius: var(--bc-radius);
        padding: 18px;
        box-shadow: var(--bc-shadow-md);
    }

        .modalSummary-content h5 {
            margin: 0 0 4px 0;
            font-weight: 700;
            font-size: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modalSummary-content .sub {
            font-size: 11px;
            color: var(--bc-muted);
            margin-bottom: 12px;
        }

    .closeSummary {
        cursor: pointer;
        color: var(--bc-muted);
        font-size: 16px;
    }

        .closeSummary:hover {
            color: var(--bc-text);
        }

    #tblSummary {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
    }

        #tblSummary thead th {
            background: #f7f8fc;
            color: var(--bc-text);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .2px;
            padding: 7px 8px;
            border-bottom: 1.5px solid var(--bc-border);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #tblSummary tbody td {
            padding: 6px 8px;
            border-bottom: 1px solid #eef0f5;
            vertical-align: middle;
        }

        #tblSummary tbody tr:hover {
            background: #fafbff;
        }

        #tblSummary tfoot td {
            padding: 7px 8px;
            font-size: 11.5px;
            background: #f7f8fc;
            border-top: 2px solid var(--bc-border);
            font-weight: 700;
        }

    .sum-customer {
        font-weight: 700;
    }

    .sum-badge {
        display: inline-block;
        font-size: 9px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 12px;
        background: var(--bc-primary-light);
        color: var(--bc-primary);
        margin-left: 4px;
    }
</style>

<body>
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    @Html.HiddenFor(model => model.EnableReturnPrice, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtReurnPricePerm" })

    <div class="toastBox"></div>

    <div id="dvBulkCollection">

        <div class="bc-header">
            <div>
                <h4 id="MainHeading">@ViewData["FormName"]</h4>
            </div>
        </div>

        <!-- ===================== FILTER CARD ===================== -->
        <div class="bc-card">
            <div class="bc-filter-grid">
                <div>
                    <span class="form-label flex-grow-1">
                        <select class="form-control FormclrcmbField" id="cmbBranch"><option value="0">Select Branch</option></select>
                        <label class="labelup" for="txtCode"> Branch *</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrBranch"></div>
                </div>
                <div>
                    <span class="form-label">
                        <input class="form-control FormclrField" id="txtBeat" placeholder=" " autocomplete="off" />
                        <label class="labelup">Beat</label>
                    </span>
                    <div id="divErrBeat" class="clrdivs"></div>
                </div>
                <div>
                    <span class="form-label">

                        <input class="form-control FormclrField" id="txtSalesman" placeholder=" " autocomplete="off" />
                        <label class="labelup">Salesman</label>
                    </span>
                    <div id="divErrSalesman" class="clrdivs"></div>
                </div>
                <div>
                    <span class="form-label">
                        <input class="form-control FormclrField" id="txtCustomer" placeholder=" " style="width:250px" autocomplete="off" />
                        <label class="labelup">Customer</label>
                    </span>
                    <div id="divErrCustomer" class="clrdivs"></div>
                </div>
                <div>
                    <span class="form-label">
                        <input class="form-control FormclrField" type="date" id="txtAsonDate" style="width:auto" placeholder=" " />
                        <label class="labelup">As on Date</label>
                    </span>
                    <div id="divErrAsonDate" class="clrdivs"></div>
                </div>
                <div>

                    <button id="btnFilter" type="button" class="bc-btn bc-btn-primary" style="width:auto;justify-content:center;top:-10px">
                        <i class="bi bi-funnel"></i> Filter
                    </button>

                </div>
                <div>

                    <span class="form-label">
                        <input class="form-control FormclrField" type="date" id="dtpDate" oninput="if (this.value > this.max) { this.value = this.max; }" />
                        <label class="labelup">Date *</label>
                    </span>
                    <div id="divErrDate" class="clrdivs"></div>
                </div>

            </div>


        </div>

        <!-- ===================== TOOLBAR ===================== -->
        <div class="bc-toolbar" id="dvToolbar" style="display:none;">
            <div class="bc-search">
                <i class="bi bi-search"></i>
                <input type="text" id="txtSearchRow" placeholder="Search party, doc id or ref no..." />
            </div>
            <!-- TransName filter tabs (shown below toolbar after data loads) -->
            <div id="dvTransTabs" style="display:none;">
                <div class="bc-transname-tabs" id="transnameTabs"></div>
            </div>
            <div class="bc-bulkactions">
                <button type="button" class="bc-btn bc-btn-outline bc-btn-sm" id="btnResetAll">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset all
                </button>
                <button type="button" class="bc-btn bc-btn-outline bc-btn-sm" id="btnExport" title="Export visible data to Excel">
                    <i class="bi bi-file-earmark-spreadsheet"></i> Export
                </button>
                <button type="button" class="bc-btn bc-btn-outline bc-btn-sm" id="btnSummary" title="Customer-wise Adjusted Summary">
                    <i class="bi bi-bar-chart-line"></i> Summary
                </button>
            </div>
        </div>


        <!-- ===================== DATA TABLE ===================== -->
        <div class="bc-loading" id="dvLoading">
            <div class="spinner"></div>
            Loading pending documents...
        </div>

        <div id="emptyState">
            <i class="bi bi-inbox"></i>
            Select your filters above and click <b>Filter</b> to load pending documents.
        </div>

        <div class="bc-table-wrap" id="dvTableWrap" style="display:none;">
            <table id="tblBulkCollectionData" width="100%">
                <thead>
                    <tr>
                        <th style="width:2%;">#</th>
                        <th style="width:13%;">Party Name</th>
                        <th style="width:7%;">Doc ID</th>
                        <th style="width:6%;">Date</th>
                        <th style="width:7%;">Ref No</th>
                        <th style="width:6%;">Net ₹</th>
                        <th style="width:6%;">Balance</th>
                        <th style="width:7%;">Cash ₹</th>
                        <th style="width:7%;">Chq/BT ₹</th>
                        <th style="width:2%;">Pay Info</th>
                        <th style="width:5%;">Disc %</th>
                        <th style="width:5%;">Disc ₹</th>
                        <th style="width:5%;">Other %</th>
                        <th style="width:5%;">Other ₹</th>
                        <th style="width:7%;">Adjusted ₹</th>
                        <th style="width:3%;">Note</th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
                <tfoot id="trFooter">
                    <tr>
                        <td colspan="5" align="right">Total :</td>
                        <td align="right" id="ftNet">0.00</td>
                        <td align="right" id="ftBalance">0.00</td>
                        <td align="right" id="ftCashCollected">0.00</td>
                        <td align="right" id="ftChqBTCollected">0.00</td>
                        <td></td>
                        <td></td>
                        <td align="right" id="ftDisc">0.00</td>
                        <td></td>
                        <td align="right" id="ftOther">0.00</td>
                        <td align="right" id="ftAdjusted">0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- ===================== BOTTOM ACTION + SUMMARY BAR ===================== -->
    <div class="footerAction" id="dvFooterAction" style="display:none;">
        <div class="bc-mini-summary">
            <div class="stat"><span class="lbl">Records</span><span class="val" id="statRecords">0</span></div>
            <div class="stat"><span class="lbl">Balance</span><span class="val" id="statBalance">0.00</span></div>
            <div class="stat" title="Cash Collection Amount">
                <span class="lbl">Cash Collected</span>
                <span class="val" id="statcashCollected">0.00</span>
            </div>
            <div class="stat" title="Cheque Collection - Count &amp; Amount">
                <span class="lbl">CHQ (<span id="statChqCount">0</span>)</span>
                <span class="val" id="statchqCollected">0.00</span>
            </div>
            <div class="stat" title="Bank Transfer Collection - Count &amp; Amount">
                <span class="lbl">BT (<span id="statBtCount">0</span>)</span>
                <span class="val" id="statbtCollected">0.00</span>
            </div>
            <div class="stat acc-collected"><span class="lbl">Collected</span><span class="val" id="statCollected">0.00</span></div>
            <div class="stat"><span class="lbl">Disc+Other</span><span class="val" id="statDiscOther">0.00</span></div>
            <div class="stat acc-remaining"><span class="lbl">Remaining</span><span class="val" id="statRemaining">0.00</span></div>
        </div>
        <div class="bc-actions">
            <button type="button" class="bc-btn bc-btn-danger" id="btnClear"><i class="bi bi-x-circle"></i> Clear</button>
            <button type="button" class="bc-btn bc-btn-success" id="btnSave"><i class="bi bi-check-circle"></i> Save Collection</button>
        </div>
    </div>

    <!-- ===================== PAYMENTS MODAL (Cheque / Bank Transfer only) ===================== -->
    <div class="modalPayments" id="modalPayments">
        <div class="modalPayments-content">
            <h5>
                <span id="payModalTitle">Payment Info</span>
                <span class="closePay" id="btnClosePayments"><i class="bi bi-x-lg"></i></span>
            </h5>
            <div class="sub" id="payModalSub">Doc ID</div>

            <div class="pay-summary-row">
                <span>Cum. Balance: <b id="paySummaryBalance">0.00</b></span>
                <span>Remaining: <b id="paySummaryRemaining">0.00</b></span>
                <span>Recd Amt: <b id="paySummaryRecd">0.00</b></span>
            </div>
            <div class="pay-summary-row d-none">

                <span>Entered: <b id="paySummaryAdded">0.00</b></span>
            </div>
            <div class="pay-summary-row">
                <label id="paySummaryAmtinword"></label>
            </div>
            <!-- Mode selector: only Cheque or Bank Transfer allowed; one at a time -->
            <div class="pay-add-grid" id="payAddGrid">

                <!-- Row 1: Mode + Amount (always visible) -->
                <div class="pay-field">
                    <label>Mode <span style="color:var(--bc-danger)">*</span></label>
                    <select id="paymodeMode">
                        <option value="2" selected>Cheque</option>
                        <option value="4">Bank Transfer</option>
                    </select>
                </div>
                <div class="pay-field">
                    <label>Amount <span style="color:var(--bc-danger)">*</span></label>
                    <input type="number" id="paymodeAmount" min="0" step="1" placeholder="0.00" />
                </div>

                <!-- ── CHEQUE fields ── -->
                <div class="pay-field" id="payChqNoWrap" style="display:none;">
                    <label>Cheque No <span style="color:var(--bc-danger)">*</span></label>
                    <input type="text" id="paymodeChqNo" placeholder="e.g. 004521" />
                </div>
                <div class="pay-field" id="payChqDateWrap" style="display:none;">
                    <label>Cheque Date <span style="color:var(--bc-danger)">*</span></label>
                    <input type="date" id="paymodeChqDate" />
                </div>
                <div class="pay-field" id="payChqBankWrap" style="display:none;">
                    <label>Bank</label>
                    <select id="paymodeChqBank">
                        <option value="0">-- Select Bank --</option>
                        <option value="1">State Bank of India</option>
                        <option value="2">HDFC Bank</option>
                        <option value="3">ICICI Bank</option>
                        <option value="4">Axis Bank</option>
                        <option value="5">Kotak Mahindra Bank</option>
                        <option value="6">Bank of Baroda</option>
                        <option value="65">Other</option>
                    </select>
                </div>
                <div class="pay-field" id="payChqBranchWrap" style="display:none;">
                    <label>Branch</label>
                    <input type="text" id="paymodeChqBranch" placeholder="e.g. Anna Nagar" />
                </div>
                <div class="pay-field" id="payChqIfscWrap" style="display:none;">
                    <label>IFSC</label>
                    <input type="text" id="paymodeChqIfsc" placeholder="e.g. HDFC0001234" style="text-transform:uppercase;" />
                </div>

                <!-- ── BANK TRANSFER fields ── -->
                <div class="pay-field" id="payBTBankAccWrap" style="display:none;">
                    <label>Bank Account <span style="color:var(--bc-danger)">*</span></label>
                    <select id="paymodeBTBankAcc">
                        <option value="0">-- Select Account --</option>
                        <option value="23">SBI - 00001234567890</option>
                        <option value="34">HDFC - 50100123456789</option>
                    </select>
                </div>
                <div class="pay-field" id="payBTRefNoWrap" style="display:none;">
                    <label>Neft/Ref No <span style="color:var(--bc-danger)">*</span></label>
                    <input type="text" id="paymodeBTRefNo" placeholder="e.g. UTR123456789" />
                </div>
                <div class="pay-field" id="payBTTransferModeWrap" style="display:none;">
                    <label>Transfer Mode <span style="color:var(--bc-danger)">*</span></label>
                    <select id="paymodeBTTransferMode">
                        <option value="0">-- Select --</option>
                        <option value="3">NEFT</option>
                        <option value="4">RTGS</option>
                        <option value="5">IMPS</option>
                        <option value="6">UPI</option>
                    </select>
                </div>

            </div>

            <div class="pay-list" id="payList"></div>

            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:10px;">
                <button type="button" class="bc-btn bc-btn-outline" id="btnDonePayments">Done</button>
            </div>
        </div>
    </div>
    <!-- ===================== SUMMARY MODAL (Customer-wise) ===================== -->
    <div class="modalSummary" id="modalSummary">
        <div class="modalSummary-content">
            <h5>
                <span><i class="bi bi-bar-chart-line" style="margin-right:6px;"></i>Adjusted Documents — Customer Summary</span>
                <span class="closeSummary" id="btnCloseSummary"><i class="bi bi-x-lg"></i></span>
            </h5>
            <div class="sub" id="summaryModalSub">Showing customer-wise totals for all adjusted documents.</div>
            <div style="overflow:auto;">
                <table id="tblSummary" width="100%">
                    <thead>
                        <tr>
                            <th rowspan="2" style="width:3%;vertical-align:middle;">#</th>
                            <th rowspan="2" style="width:18%;vertical-align:middle;">Customer Name</th>
                            <th colspan="2" style="text-align:center;border-bottom:1px solid var(--bc-border);">Cash Adj ₹</th>
                            <th colspan="2" style="text-align:center;border-bottom:1px solid var(--bc-border);">Chq/BT Adj ₹</th>
                            <th rowspan="2" style="width:5%;text-align:center;vertical-align:middle;" class="d-none">CHQ</th>
                            <th rowspan="2" style="width:5%;text-align:center;vertical-align:middle;" class="d-none">BT</th>
                            <th rowspan="2" style="width:8%;text-align:right;vertical-align:middle;">Disc ₹</th>
                            <th rowspan="2" style="width:8%;text-align:right;vertical-align:middle;">Other ₹</th>
                            <th rowspan="2" style="width:9%;text-align:right;vertical-align:middle;">Total Adj ₹</th>
                        </tr>
                        <tr>
                            <th style="width:8%;text-align:right;color:var(--bc-success);">+ Amt</th>
                            <th style="width:8%;text-align:right;color:var(--bc-danger);">− Amt</th>
                            <th style="width:8%;text-align:right;color:var(--bc-success);">+ Amt</th>
                            <th style="width:8%;text-align:right;color:var(--bc-danger);">− Amt</th>
                        </tr>
                    </thead>
                    <tbody id="tblSummaryBody"></tbody>
                    <tfoot id="tblSummaryFoot"></tfoot>
