                        <label class="labelup" for="txtCode"> To</label>
                    </span>
                    <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrFTo" class="clrdivs"></div>
                </td>
                <td style="padding-right:10px" id="tdchkShowall" width="3%">
