    function ClearForm() {
        $(".FormclrField").val("");
        $(".FormclrcmbField").val(0);
        $(".clrdivs").html("");
        $(".FormclrField,.FormclrcmbField,#btnSave,#btnClear,#btnDraft,#btnClose").prop("disabled", false);
        $("#btnPreview,#btnPDF").prop("disabled", true);
        DocumentData.draw().clear();
        DocumentData.draw().clear();
