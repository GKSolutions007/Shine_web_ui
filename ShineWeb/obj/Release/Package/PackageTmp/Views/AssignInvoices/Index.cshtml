@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
@*<link href="~/Content/bootstrap.min.css" rel="stylesheet" />*@
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/dataTables.bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

@*<script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>*@
<script src="~/Scripts/jquery-1.11.1.min.js"></script>
@*<script src="~/Scripts/bootstrap_3.3.7.min.js"></script>*@
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>


<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>

<style>
    th, td {
        white-space: nowrap;
    }
    hr {
        margin: 1rem 0;
        color: inherit;
        border: 0;
        border-top: 1px solid;
        opacity: .25;
    }
    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 75%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .modalProdInfo {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 10; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalProdInfo-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 75%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalProdInfo-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closePinfo {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closePinfo:hover,
        .closePinfo:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        /*padding: 6px 12px;*/
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -60%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -28%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }
    /*input:focus + .labelup,
    input:not(:placeholder-shown) + .labelup, textarea:focus + .labelup, textarea:not(:placeholder-shown) + .labelup {
        top: -35%;
        font-size: .9em;
        padding: 0 .3em;
        background: #F9F9F9;
        color: #000000;
    }*/
    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }

    /* ===== Compact Input Styling ===== */
    .form-control,
    select.form-control,
    input.form-control,
    textarea.form-control,
    .gdInput,
    select.gdInput,
    input.gdInput {
        padding: 4px 8px !important;
        font-size: 12px !important;
        height: 28px !important;
        line-height: 1.4 !important;
    }

    textarea.form-control {
        height: auto !important;
        min-height: 60px !important;
    }

    select.form-control,
    select.FormclrcmbField {
        padding: 3px 8px !important;
    }

    /* Reduce spacing in form-label containers */
    .form-label {
        margin-bottom: 6px !important;
    }

    /* Reduce label font size */
    /*    .labelup {
        font-size: 12px !important;
    }*/

    /* Reduce table cell padding */
    table td {
        padding: 4px !important;
    }

    /* Reduce spacing for error divs */
    div[id^="divErr"] {
        padding-top: 2px !important;
        padding-left: 5px !important;
        font-size: 11px !important;
    }

    /* Compact row spacing */
    .row {
        margin-bottom: 8px !important;
    }

    /* Reduce button sizes slightly */
    .btn {
        padding: 5px 12px !important;
        font-size: 13px !important;
    }
</style>
<style>
    /* Align dropdown in DataTable cell */
    .action-dropdown {
        min-width: 100px;
        font-size: 12px;
        z-index: 1000;
        text-align: left;
    }

        /* Optional: Add hover effect */
        .action-dropdown > li > a {
            padding: 3px 12px;
            color: #333;
            text-decoration: none;
        }

            .action-dropdown > li > a:hover {
                background-color: #f5f5f5;
                color: #000;
            }

    /* Optional: Make dropdown button minimal */
    .dropdown-toggle {
        background-color: transparent !important;
        border: none !important;
        font-size: 15px;
        line-height: 1;
        padding: 2px 5px;
    }

        .dropdown-toggle::after {
            display: none;
        }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.Return, new { @autocomplete = "off", @class = "form-control", @id = "txtReturnID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.Cancel, new { @autocomplete = "off", @class = "form-control", @id = "txtCancelID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.EnableReturnPrice, new { @autocomplete = "off", @class = "form-control", @id = "txtReurnPricePerm" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })


    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <div class="toastBox"></div>
    <div id="dvDocuments">
        <hr />
        <input hidden id="txtStatus" />
        <div class="w-100 mt-3">
            <div class="d-flex justify-content-end align-items-start mb-2 flex-wrap gap-2">

                <!-- Filter Controls -->
                <div class="d-flex align-items-start gap-2 flex-wrap">

                    <!-- Date Type -->
                    <div>
                        <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                    </div>

                    <!-- From Date -->
                    <div>
                        <span class="form-label">
                            <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFFrom"
                                   oninput="if (this.value > this.max) { this.value = this.max; }">
                            <label class="labelup" for="dtpFFrom">From</label>
                        </span>
                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFFrom"></div>
                    </div>

                    <!-- To Date -->
                    <div>
                        <span class="form-label">
                            <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFTo"
                                   oninput="if (this.value > this.max) { this.value = this.max; }">
                            <label class="labelup" for="dtpFTo">To</label>
                        </span>
                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFTo"></div>
                    </div>

                    <!-- All Status Checkbox -->
                    <div class="d-flex align-items-center gap-1">
                        <input tabindex="1" class="form-check-input FormfilterclrField" type="checkbox" id="chkShowAll" style="font-size:14px;">
                        <label class="form-check-label" for="chkShowAll" style="font-size:14px;">All Status</label>
                    </div>

                    <!-- Filter Button -->
                    <div>
                        <button id="btnFilter" class="btn btn-primary">
                            <i class="bi bi-funnel" style="color:white;"></i>&#x2009;Filter
                        </button>
                    </div>

                </div>

            </div>

            <!-- Grid -->
            <div id="my-grid" style="height:600px; width:100%;"></div>

        </div>
    </div>
    <div id="dvMain">
        <hr />
        <!-- Row 1: Salesman, Branch, RefNo, DocID+Date -->
        <div class="row g-3 mb-3">

            <!-- Assign To -->
            <div class="col-12 col-md-2">
                <span class="form-label">
                    <select class="form-control FormclrcmbField" id="cmbSalesman">
                        <option value="0">Select Salesman</option>
                    </select>
                    <label class="labelup" for="cmbSalesman">Assign To *</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrSalesman"></div>
            </div>

            <!-- Branch -->
            <div class="col-12 col-md-2">
                <span class="form-label">
                    <select class="form-control FormclrcmbField" id="txtBranchName" @(Model.EnableBranch == "1" ? "disabled" : "")>
                        <option value="0">Select Branch</option>
                    </select>
                    <label class="labelup" for="txtBranchName">Branch *</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrBranch"></div>
            </div>

            <!-- Ref No -->
            <div class="col-12 col-md-2">
                <span class="form-label">
                    <input tabindex="1" class="form-control FormclrField" type="text" id="txtRefNo" placeholder=""
                           onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRefNo')"
                           oninput="sanitizeAlphaNumeric(this, '#divErrRefNo')" />
                    <label class="labelup" for="txtRefNo">Ref No</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrRefNo"></div>
            </div>

            <!-- Spacer -->
            <div class="col-12 col-md-3 col-lg-4"></div>

            <!-- Doc ID + Date (right side, stacked) -->
            <div class="col-12 col-md-3 col-lg-2 ms-auto" style="min-width: 200px;">
                <table>
                    <tr>
                        <td style="border:none;">
                            <span class="fw-semibold">Doc ID :</span>
                        </td>
                        <td style="border:none;">
                            <label id="lblDocID" docprefix="" class="fw-bolder" style="font-size:14px;">AI/2425/001</label>
                        </td>
                    </tr>
                    <tr>
                        <td style="border:none;">
                            <label style="font-size:14px">Date :</label>
                        </td>
                        <td style="border:none;">
                            <input class="clsdtpfieldbottomborder FormclrField" type="date" id="dtpDate"
                                   style="font-size:14px"
                                   oninput="if (this.value > this.max) { this.value = this.max; }" />
                        </td>
                    </tr>
                    @*<tr>
                        <td style="border:none;">
                            <span class="form-label">
                                <input class="clsdtpfieldbottomborderfull FormclrField form-control"
                                       type="date" id="dtpDate"
                                       oninput="if (this.value > this.max) { this.value = this.max; }" />
                                <label class="labelup" for="dtpDate">Date *</label>
                            </span>
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrDate"></div>
                        </td>
                    </tr>*@
                </table>
            </div>

        </div>

        <!-- Row 2: Filter Bar -->
        <hr />
        <div class="row g-3 align-items-start mt-1">
            <!-- Beat -->
            <div class="col-12 col-md-2 col-lg-2">
                <span class="form-label">
                    <select class="form-control FormclrcmbField" id="cmbFilterBeat">
                        <option value="0">Select Beat</option>
                    </select>
                    <label class="labelup" for="cmbFilterBeat">Beat</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFilterBeat"></div>
            </div>

            <!-- Salesman -->
            <div class="col-12 col-md-2 col-lg-2">
                <span class="form-label">
                    <select class="form-control FormclrcmbField" id="cmbFilterSalesman">
                        <option value="0">Select Salesman</option>
                    </select>
                    <label class="labelup" for="cmbFilterSalesman">Salesman</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFilterSalesman"></div>
            </div>

            <!-- Customer Name -->
            <div class="col-12 col-md-3 col-lg-3">
                <span class="form-label">
                    <input tabindex="1" class="form-control FormclrField" type="text" id="txtFilterCustomer" placeholder="">
                    <label class="labelup" for="txtFilterCustomer">Customer Name</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFilterCustomer"></div>
            </div>

            <!-- As on Date -->
            <div class="col-12 col-md-2 col-lg-1">
                <span class="form-label">
                    <input tabindex="1" class="form-control FormclrField" type="date" id="dtpDocTo" placeholder=""
                           oninput="if (this.value > this.max) { this.value = this.max; }">
                    <label class="labelup" for="dtpDocTo">As on Date *</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrDocTo"></div>
            </div>

            <!-- Load Button -->
            <div class="col-12 col-md-2 col-lg-1 d-flex align-items-center">
                <button id="btnDocFilter" class="btn btn-primary w-100">
                    <i class="bi bi-download" style="color:white;"></i>&#x2009;Load
                </button>
            </div>

        </div>

        <!-- Row 3: Invoice Table -->
        <div class="row pb-3 mb-3">
            <div class="col-12 d-flex gap-2 mb-1">
                <button class="btn btn-info" id="btnAddInvoices">
                    <i class="bi bi-plus"></i> Add
                </button>
                <button class="btn btn-primary" id="btnViewInvoices">
                    <i class="bi bi-eye"></i> View
                </button>
            </div>
            <div class="col-12">
                <table class="table table-bordered row-border order-column" id="tblInvoiceData" width="100%">
                    <thead>
                        <tr>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:0%;">ID</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:10%;">
                                <input type="checkbox" class="form-check-input" id="chkSelectAllInvoice" />
                            </th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:2%;">#</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:10%;">Doc ID</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:10%;">Doc Date</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:8%;">Ref No</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:9%;">Beat</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:8%;">Salesman</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:8%;">Customer</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:15%;">Net Amount</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:10%;">Balance</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:10%;">Ageing</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px; width:10%;" title="Assigned Invoice Count">AIC</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Row 4: Remarks + Narration -->
        <div class="row pb-5 mb-5">
            <div class="col-12 col-md-3"></div>
            <div class="col-12 col-md-3"></div>
            <div class="col-12 col-md-3"></div>
            <div class="col-12 col-md-3">

                <!-- Remarks -->
                <div class="mb-3">
                    <span class="form-label">
                        <input class="form-control FormclrField" type="text" id="txtRemarks" placeholder=""
                               onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRemarks')"
                               oninput="sanitizeAlphaNumeric(this, '#divErrRemarks')" />
                        <label class="labelup" for="txtRemarks">Remarks</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrRemarks"></div>
                </div>

                <!-- Narration -->
                <div class="mb-3">
                    <span class="form-label">
                        <textarea class="form-control FormclrField" rows="3" id="txtNarration"
                                  onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrNarration')"
                                  oninput="sanitizeAlphaNumeric(this, '#divErrNarration')"></textarea>
                        <label class="labelupfortextarea" for="txtNarration">Narration</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrNarration"></div>
                </div>

            </div>
        </div>

        <!-- Footer: Print Profile, Copies, Action Buttons -->
        <div class="footerAction modal-footer d-flex align-items-start justify-content-between gap-3 flex-wrap p-2">

            <!-- Left: Print Profile + Copies -->
            <div class="d-flex align-items-start gap-2 flex-wrap">

                <!-- Print Profile -->
                <div>
                    <span class="form-label">
                        <select class="form-control" id="cmbPrintProfile" style="min-width:160px;">
                            <option value="0">Select</option>
                        </select>
                        <label class="labelup" for="cmbPrintProfile">Print Profile</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrPrintProfile"></div>
                </div>

                <!-- Copies -->
                <div>
                    <span class="form-label">
                        <input id="txtNoofCopies" class="form-control" placeholder="" value="1" style="min-width:90px;"
                               onbeforeinput="return NumericOnlyBeforeInput(event, this,'#divErrNoofCopies')"
                               oninput="sanitizeNumericOnly(this, '#divErrNoofCopies')" />
                        <label class="labelup" for="txtNoofCopies">Copies</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrNoofCopies"></div>
                </div>

            </div>

            <!-- Right: Action Buttons -->
            <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
