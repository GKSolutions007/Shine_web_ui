<script>

    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canEdit: $("#txtModifyID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canCancel: $("#txtCancelID").val() == 1,
        canReturn: $("#txtReturnID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    var allGridActions = [], singleIconAction = [], menuActions = [], columns = [];
    var actions = {}, OtherActions = {};

    function LoadPermissions() {
        allGridActions = [
            {
                icon: '👁️',
                title: 'View Data',
                className: 'dg-action-view',
                // 💡 NEW TAG: This action will be rendered as a single icon
                displayType: 'single_icon',
                visible: mapusersRole.canView,
                // $("#txtViewID").val() == 1,
                handler: (rowdata) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    nTransMode = 5;
                    $("#txtID").val(ID);
                    GetData(3, ID);
                    $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDocFilter,#btnViewInvoices, #btnAddInvoices,#chkSelectAllInvoice").prop("disabled", true);
                    //$("#btnClose").prop("disabled", false);
                    $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
                    $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
                    $("#btnPreview,#btnPDF,#btnPrint").show();
                    $("#btnSave,#btnClear,#btnDraft").hide();
                    $("#dvMain").show();
                    $("#dvDocuments").hide();
                    $("#btnEmail,#btnWhatsapp").show();
                    $("#MainHeading").text("View Assign Invoices");
                }
            },
            {
                icon: '✏️',
                title: 'Edit',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed') {
                        if (mapusersRole.canEdit)
                            isVisible = true;
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[9];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        nTransMode = 2;
                        //showErrorSnackbar("Bill Table : " + rdo1 + ", Draft : " + rdo2);
                        GetData(3, ID);
                        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
                        $("#btnSave,#btnClose,#btnDocFilter,#btnViewInvoices, #btnAddInvoices,#chkSelectAllInvoice").prop("disabled", false);
                        //$("#btnClear").prop("disabled", true);
                        $("#btnPreview,#btnPDF,#btnClear,#btnPrint").prop("disabled", true);
                        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
                        $("#btnSave").show();
                        $("#btnSave,#btnClose").prop("disabled", false);
                        $("#dvMain").show();
                        $("#dvDocuments").hide();
                        $("#btnEmail,#btnWhatsapp").hide();
                        $("#MainHeading").text("Modify Assign Invoices");
                        if ($("#txtEnableBranch").val() == 1) {
                            $("#txtBranchName").prop("disabled", true);
                        }
                    }
                    else {
                        showErrorSnackbar("Cannot Modify.This document already cancelled");
                    }
                }
            },
            {
                icon: '↩️',
                title: 'Return',
                className: 'dg-action-return',
                visible: (row) => {
                    var isVisible = false;
                    var RTNYN = row.Status == 'Amended' || row.Status == 'Cancelled' || row.Status == 'Close' || row.Status == 'Processed' ? false : true;
                    if (mapusersRole.canReturn && RTNYN) {
                        isVisible = true;
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status[9];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        $("#MainHeading").text("Return Assign Invoices")
                        nTransMode = 6;
                        GetData(3, ID);
                        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                        //$("#btnSave,#btnClose").prop("disabled", false);
                        //$("#btnClear,#btnDocFilter").prop("disabled", true);
                        $("#btnSave,#btnClose").prop("disabled", false);
                        $("#btnPreview,#btnPDF,#btnClear,#btnDraft,#btnPrint").prop("disabled", true);
                        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
                        $("#btnEmail,#btnWhatsapp").hide();
                        $("#btnSave").show();
                        //,#btnViewInvoices, #btnAddInvoices,#chkSelectAllInvoice
                        $("#dvMain").show();
                        $("#dvDocuments").hide();
                    }
                    else {
                        showErrorSnackbar("This document already cancelled");
                    }
                }
            },
            {
                icon: '❌',
                title: 'Cancel',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed') {
                        if (mapusersRole.canCancel)
                            isVisible = true;
                        else
                            isVisible = false;
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status[9];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        $("#MainHeading").text("Cancel Assign Invoices")
                        nTransMode = 4;
                        GetData(3, ID);
                        $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                        $("#txtNarration,#txtRemarks").prop("disabled", false);
                        $("#btnSave,#btnClose").prop("disabled", false);
                        $("#btnClear,#btnDocFilter,#btnViewInvoices, #btnAddInvoices,#chkSelectAllInvoice").prop("disabled", true);
                        $("#dvMain").show();
                        $("#dvDocuments").hide();
                        $("#btnEmail,#btnWhatsapp").hide();
                    }
                    else {
                        showErrorSnackbar("This document already cancelled");
                    }
                }
            },
            {
                icon: '🖨️',
                title: 'Print',
                className: 'dg-action-edit',
                visible: mapusersRole.canPrint,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPrint").click();
                }
            },
            {
                icon: '🖨️',
                title: 'Preview',
                className: 'dg-action-edit',
                visible: mapusersRole.canPreview,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPreview").click();
                }
            },
            {
                icon: "<i class='fa-regular fa-file-pdf' style='color:brown'></i>",
                title: '&ensp;PDF',
                className: 'dg-action-edit',
                visible: mapusersRole.canPDF,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPDF").click();
                }
            },
            {
                icon: "<i class='fa-solid fa-envelope' style='color:brown'></i>",
                title: '&ensp;Mail',
                className: 'dg-action-edit',
                visible: true,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnEmail").click();
                }
            },
            {
                icon: "<i class='fa-brands fa-whatsapp' style='color:green'></i>",
                title: '&ensp;WhatsApp',
                className: 'dg-action-edit',
                visible: true,
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btniframeWhatsapp").click();
                }
            },
        ];
        singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
        menuActions = allGridActions.filter(a => a.displayType === 'menu_item');
        actions = {
            "header": 'View',
            "type": "action",
            "width": 60,
            "align": "center",
            "visible": mapusersRole.canView,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": singleIconAction
        };
        OtherActions = {
            "header": "Action",
            "type": "action3dots",
            "width": 60,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": menuActions
        }
    }

    LoadPermissions();

</script>

