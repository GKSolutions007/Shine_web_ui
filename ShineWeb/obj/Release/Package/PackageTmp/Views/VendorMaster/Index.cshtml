        var arrCodeData = [], arrNameData = [];
        function GetData(nFlagMode, strName = null) {
            $.ajax({
                url: Aurl + "vendormaster/get",
                type: 'get',
                contentType: 'json',
                data: { Mode: nFlagMode, Name: strName },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    if (nFlagMode == 3)
                    {
                        arrCodeData = [], arrNameData = [];
                        if (data.length > 0)
                        {
                            $.each(data, function (i, items) {
                                var al = {
                                    "label": items.Code,
                                    "id": items.ID,
                                }
                                arrCodeData.push(al);
                                al = {
                                    "label": items.Name,
                                    "id": items.ID,
                                }
                                arrNameData.push(al);
                            });
                            //~AutoList Vendor Code
                            PaginatedAutocomplete({
                                inputId: "txtCode",
                                data: arrCodeData,
                                onSelect: function (item) {
                                    $("#txtCode").val(item.label);
                                    return false;
                                }
                            });
                            //~AutoList Vendor Name
                            PaginatedAutocomplete({
                                inputId: "txtName",
                                data: arrNameData,
                                onSelect: function (item) {
                                    $("#txtName").val(item.label);
                                    return false;
                                }
                            });
                            //$("#txtCode").autocomplete({
                            //    minLength: 0,
                            //    source: arrCodeData,
                            //    select: function (event, ui) {
                            //        $("#txtCode").val(ui.item.label);
                            //        return false;
                            //    },
                            //}).autocomplete("instance")._renderItem = function (ul, item) {
                            //    return $("<li class='each'>")
                            //        .append("<div class='acItem'><span class='name'>" +
                            //            item.label + "</span></div>")
                            //        .appendTo(ul);
                            //};
                            //$("#txtName").autocomplete({
                            //    minLength: 0,
                            //    source: arrNameData,
                            //    select: function (event, ui) {
                            //        $("#txtName").val(ui.item.label);
                            //        return false;
                            //    },
                            //}).autocomplete("instance")._renderItem = function (ul, item) {
                            //    return $("<li class='each'>")
                            //        .append("<div class='acItem'><span class='name'>" +
                            //            item.label + "</span></div>")
                            //        .appendTo(ul);
                            //};
                        }
                        else {
                            showErrorSnackbar("No Records Found");
                        }
                    }
                        //~Assign Data
                    else if (nFlagMode == 4) {
                        $.each(data, function (i, items) {
                            $("#txtID").val(items.ID),
                                $("#txtCode").val(items.Code),
                                $("#txtName").val(items.Name),
                                $("#cmbCustomerType").val(items.CustomerType),
                                $("#cmbRating").val(items.Ratings),
                                $("#txtBAdd1").val(items.Billadd1),
                                $("#txtBAdd2").val(items.Billadd2),
                                $("#txtBAdd3").val(items.Billadd3),
                                $("#txtSAdd1").val(items.Shipadd1),
                                $("#txtSAdd2").val(items.Shipadd2),
                                $("#txtSAdd3").val(items.Shipadd3),
                                $("#txtPincode").val(items.Pincode),
                                $("#txtContactperson").val(items.ContactPerson),
                                $("#txtPh1").val(items.Ph1),
                                $("#txtPh2").val(items.Ph2),
                                $("#txtMob1").val(items.Mob1),
                                $("#txtMob2").val(items.Mob2),
                                $("#txtEMail").val(items.Email),
                                $("#txtPAN").val(items.PANNumber),
                                $("#txtAadhaar").val(items.AadharNo),
                                $("#txtDL20").val(items.DLNo20),
                                $("#txtDL21").val(items.DLNo21),
                                $("#txtFSSAI").val(items.FSSAINo),
                                $("#cmbState").val(items.StateID),
                                $("#txtGSTIN").val(items.GSTIN),
                                $("#cmbCreditTerm").val(items.CreditTermID),
                                $("#cmbPayMode").val(items.PaymentModeID),
                                $("#cmbCreditTerm").prop("disabled", items.PaymentModeID != 7);
                                $("#cmbTaxType").val(items.TaxTypeID),
                                updateInputColumn("txtOSValue", items.OSValue),
                            $("#txtOSCount").val(items.OverDueValue),
                                $("#cmdPriceType").val(items.PriceTypeID),
                                $("#txtOwnerName").val(items.OwnerName),
                                $("#txtDiscPern").val(items.DiscountPern),
                                $("#chkShowTP").prop("checked", items.TrackPoint == "True"),
                                $("#chkApplyTCS").prop("checked", items.TCSTax == "True"),
                                $("#cmbWeekCycle").val(items.WeekCycle),
                                $("#txtLocation").val(items.Latitude),
                                $("#txtDistance").val(items.Distance),
                                $("#txtRemarks").val(items.Remark),
                                $("#chkActive").prop("checked", items.Active == "True");
                            if (nMode == 3) {
                                $("#cmbCreditTerm").prop("disabled", true);
