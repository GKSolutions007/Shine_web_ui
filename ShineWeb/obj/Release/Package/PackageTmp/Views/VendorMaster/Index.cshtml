        function LoadCreditTerms(selID) {
            $.ajax({
                url: Aurl + "vendormaster/get",
                type: 'get',
                contentType: 'json',
                data: { Mode: 5, Name: null },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $('#cmbCreditTerm').find("option").remove();
                    $('#cmbCreditTerm').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        if (items.FType == 3) {
                            $('#cmbCreditTerm').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                    });
                    $('#cmbCreditTerm').val(selID);
                }
            });
        }
        GetData(3);
