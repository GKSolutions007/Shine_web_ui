                "Mob2": $("#txtMob2").val(),
                "Email": $("#txtEMail").val(),
                "PANNumber": $("#txtPAN").val(),
                "AadharNo": $("#txtAadhaar").val(),
                "DLNo20": $("#txtDL20").val(),
