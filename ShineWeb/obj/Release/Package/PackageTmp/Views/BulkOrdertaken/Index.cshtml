    function SaveData() {
        $("#btnSave").prop("disabled", true);
        var SelIDs = "",selStatusIDs = "";
        var checkeditems = $('#tblOrdertakenData tbody input[type=checkbox]:checked');
        checkeditems.each(function () {
            var row = $(this).closest('tr'); // Find the parent row
            var rowData = $('#tblOrdertakenData').DataTable().row(row).data(); // Get full row data
            //CheckedInvoices.push(rowData);
            selStatusIDs += $(this).data("statusid") + ",";
            SelIDs += rowData.ID + ",";
        });
        var TrimID = SelIDs.substring(0, SelIDs.length - 1);
        var TrimStatusIDs = selStatusIDs.substring(0, selStatusIDs.length - 1);
        GetData(5, TrimID, TrimStatusIDs);
    }
    $("#btnSave").click(function () {
        if (SaveValidation()) {
            if (cfFocus != 3) {
                ConfirmDialogMsg("Do you want to save data?");
            } else {
                SaveData();
            }
        }
    });
