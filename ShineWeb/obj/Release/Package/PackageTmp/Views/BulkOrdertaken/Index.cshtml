@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/datatable/1.13.6/dataTables.bootstrap5.min.css" rel="stylesheet" />
<script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/datatable/1.13.6/jquery.dataTables.min.js"></script>
<script src="~/datatable/1.13.6/dataTables.bootstrap5.min.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/Autocomplete/GKBSautocompleteMultiCol.js"></script>
<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>

<style>
    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    th, td {
        white-space: nowrap;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .modalBatch {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
    }

    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto;
            padding: 2px;
            border: 1px solid #888;
            width: 75%;
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto;
            padding: 2px;
            border: 1px solid #888;
            width: 95%;
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }

    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }


    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            .tab button:hover {
                background-color: #ddd;
            }

            .tab button.active {
                background-color: #ccc;
            }

    .tabcontent {
        display: none;
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -50%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -18%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }

    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }

    #tblOrdertakenData tbody tr {
        transition: all 0.2s ease;
    }

        #tblOrdertakenData tbody tr:hover td {
            background-color: #c9defa !important;
        }
    /*#tblOrdertakenData tbody tr:hover {
            transform: scale(1.01);
        }*/
    .row-error {
        color: red !important;
        font-weight: 500;
    }

    .row-success {
        color: green !important;
        font-weight: 500;
    }

    .stsOpen {
        background-color: slateblue;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }

    .stsCancel {
        background-color: orangered;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }

    .stsClose {
        background-color: darkgreen;
        border-radius: 10px;
        font-weight: 600;
        font-size: 11px;
        padding: 1px 5px;
        color: white;
    }

    .highlight-error-row td {
        background-color: #fb5767 !important;
        color: #fff;
    }

    .highlight-success-row td {
        background-color: #81ad4f !important;
        color: #fff;
    }
</style>
<body>
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAdd" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>
    <div class="row">
        <div class="container-fluid">
            <div class="row g-2 align-items-end">
                <!-- Beat -->
                <div class="col-12 col-md-2 col-lg-2">
                    <span class="form-label w-100">
                        <select class="form-control FormclrcmbField" id="cmbBeatName">
                            <option value="0">Select</option>
                        </select>
                        <label class="labelup">Beat</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrBeat"></div>
                </div>
                <!-- Salesman -->
                <div class="col-12 col-md-2 col-lg-2">
                    <span class="form-label w-100">
                        <select class="form-control FormclrcmbField" id="cmbSalesManName">
                            <option value="0">Select</option>
                        </select>
                        <label class="labelup">Salesman</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrSalesman"></div>
                </div>
                <!-- Customer -->
                <div class="col-12 col-md-4 col-lg-4">
                    <span class="form-label w-100">
                        <input hidden id="txtCustomerID" class="FormclrField" />
                        <input class="form-control FormclrField" id="txtCustomer" />
                        <label class="labelup">Customer</label>
                    </span>
                    <div class="text-danger pt-1 ps-1 clrdivs" id="divErrCustomer"></div>
                </div>
                   
                <div class="col-12 col-md-3 d-flex flex-wrap align-items-center gap-2">
                    <!-- Checkbox -->
                    <div class="form-check me-3">
                        <input class="form-check-input" type="checkbox" id="chkShowAll">
                        <label class="form-check-label" for="chkShowAll">
                            Show All
                        </label>
                    </div>

                    <!-- Filter Button -->
                    <div class="flex-grow-1 flex-md-grow-0">
                        <button id="btnFilter" class="btn btn-primary w-100">
                            <i class="bi bi-funnel-fill"></i> <span class="textforabv800">Filter</span>
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>
    <div class="row mt-4">

        <div class="col-12 pb-4">

            <div class="table-responsive">

                <table class="table table-bordered table-striped align-middle"
                       id="tblOrdertakenData"
                       style="width:100%; border:1px solid #dee2e6;">

                    <thead class="table-light">

                        <!-- Summary Row -->
                        <tr hidden>

                            <th colspan="16" class="text-center" style="letter-spacing:0.75px;text-align:center !important">
                                Order Taken :
                                <label id="lblCash" style="font-size:16px"
                                       class="lblPMValuecount fw-bold text-danger">
                                    0.00 / 0
                                </label>
                            </th>
                        </tr>

                        <!-- Column Headers -->
                        <tr class="text-center small">

                            <th style="width:0%" class="trclrforcolheader">ID</th>
                            <th style="width:0%" class="trclrforcolheader">EncID</th>
                            <th style="width:0%" class="trclrforcolheader">StatusID</th>
                            <th style="width:3%" class="trclrforcolheader">
                                <input id="chkSelectAll" type="checkbox" />
                            </th>

                            <th style="width:3%" class="trclrforcolheader">Action</th>
                            <th style="width:2%" class="trclrforcolheader">#</th>
                            <th style="width:10%" class="trclrforcolheader">Date</th>
                            <th style="width:12%" class="trclrforcolheader">Beat</th>
                            <th style="width:12%" class="trclrforcolheader">Salesman</th>
                            <th style="width:16%" class="trclrforcolheader">Customer</th>
                            <th style="width:10%" class="trclrforcolheader">Value</th>
                            <th style="width:10%" class="trclrforcolheader">Total Items</th>                            
                            <th style="width:10%" class="trclrforcolheader">Disc ₹</th>                                                        
                            <th style="width:10%" class="trclrforcolheader">Status</th>
                            <th style="width:10%" class="trclrforcolheader">Remarks</th>
                            <th style="width:10%" class="trclrforcolheader">Narration</th>

                        </tr>

                    </thead>

                </table>

            </div>

        </div>

    </div>
    <div class="footerAction modal-footer">

        <div class="d-flex justify-content-between align-items-center w-100 p-2">

            <!-- Left Corner -->
            <button type="button" class="btn btn-warning" id="btnCancel">
                <i class="bi bi-x-circle"></i> Cancel
            </button>

            <!-- Right Corner -->
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-danger" id="btnClear">
                    <span class="glyphicon glyphicon-refresh"> Clear</span>
                </button>

                <button type="button" class="btn btn-success" id="btnSave">
                    <span class="glyphicon glyphicon-saved"> Save</span>
                </button>
            </div>

        </div>

    </div>
    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">

        <div class="modal-dialog modal-xl">

            <div class="modal-content modalBatch-content">

                <!-- Modal Header -->
                <div class="modal-header text-white" style="background-color:#0d6efd;">

                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Products
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

                </div>


                <!-- Modal Body -->
                <div class="modal-body">

                    <div class="table-responsive">

                        <table class="table table-bordered table-striped align-middle"
                               id="tblOTProductData"
                               style="width:100%;">

                            <thead class="text-center small">
                                <tr>
                                    <th style="width:2%" class="trclrforcolheader">#</th>
                                    <th style="width:25%" class="trclrforcolheader">Product Code</th>
                                    <th style="width:25%" class="trclrforcolheader">Product Name</th>
                                    <th style="width:10%" class="trclrforcolheader">Qty</th>
                                    <th style="width:15%" class="trclrforcolheader">Price</th>
                                    <th style="width:10%" class="trclrforcolheader">Discount %</th>
                                    <th style="width:10%" class="trclrforcolheader">Discount ₹</th>
                                    <th style="width:10%" class="trclrforcolheader">Net ₹</th>
                                </tr>
                            </thead>

                        </table>

                    </div>

                </div>


                <!-- Modal Footer -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-warning"
                            id="btnPopupClose"
                            data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Close
                    </button>

                </div>

            </div>

        </div>

    </div>
</body>

<script type="text/javascript">
    var OrderTakenTable = $('#tblOrdertakenData').DataTable({
        paging: false,
        searching: false,
        info: false,
        ordering: true,
        scrollY: "450px",
        scrollX: true,
        scrollCollapse: true,
        order: [[1, 'asc']],
        "columnDefs": [{ "targets": [0,1,2], "visible": false, searchable: false, ordering: false }, { "targets": [1], "class": "text-center" }]
    });
    var OTProductTable = $('#tblOTProductData').DataTable({
        paging: false,
        searching: false,
        info: false,
        ordering: true,
        scrollY: "350px",
        scrollX: true,
        scrollCollapse: true,
        //"columnDefs": [{ "targets": [0], "visible": false, searchable: false, ordering: false }, { "targets": [1], "class": "text-center" }]
    });

    var UID = '@Session["LoginUserID"]';
    var Aurl = '@Session["APIurl"]';
    var DecVal = '@Session["DecimalValues"]';
    var DefBranch = '@Session["DefaultBranch"]';
    var BatchMode = 0;
    var nTransMode = 1, nIsDraft = 0;
    //GetData(1);
    var RtnDisp = 1;
    var modal = new bootstrap.Modal(document.getElementById('myModalfg'));//document.getElementById("myModalfg");

    $('#btnPopupClose').click(function (e) {
        //modal.style.display = "none";
        modal.hide();
    });
    document.getElementById('myModalfg')
        .addEventListener('shown.bs.modal', function () {
            if (OTProductTable) OTProductTable.columns.adjust().draw();
        });
    
    $('input[type=number]').focusin(function (e) {
        $(this).select();
    });
    if ($("#txtAdd").val() == "0"){
        $("#btnSave,#btnCancel").hide()
    }
    
    var EditRowID = -1;
    //GetData(1, "");
    InitalData()
    LoadFilterData();
    var arrParty = [];
    //~Preload Data
    function InitalData() {
        $.ajax({
            url: Aurl + "bulkordertaken/filterdata",
            type: 'get',
            contentType: 'json',
            data: { },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                var BeatNames = data.Table1;
                var SalesmanNames = data.Table;
                var CustomerNames = data.Table2;
                arrParty = [];
                $('#cmbBeatName,#cmbSalesManName').find("option").remove();
                $('#cmbBeatName,#cmbSalesManName').append($('<option/>', {
                    value: 0,
                    text: "-- Select --",
                }));
                $.each(SalesmanNames, function (i, items) {
                    $('#cmbSalesManName').append($('<option/>', {
                        value: items.ID,
                        text: items.Name,
                    }));
                });
                $.each(BeatNames, function (i, items) {
                    $('#cmbBeatName').append($('<option/>', {
                        value: items.ID,
                        text: items.Name,
                    }));
                });
                $.each(CustomerNames, function (i, items) {
                    var al = {
                        "address": items.Address,
                        "name": items.Name,
                        "code": items.Code,
                        "id": items.ID,
                    }
                    arrParty.push(al);
                });
                PaginatedAutocompleteMultiCol({
                    inputId: "txtCustomer",
                    data: arrParty,
                    columns: [
                        { key: "code", label: "Code", width: "20%" },
                        { key: "name", label: "Name", width: "40%" },
                        { key: "address", label: "Address", width: "40%" },
                    ],
                    searchFields: ["code", "name", "address"],
                    selectField: "name",
                    onSelect: function (item) {
                        //console.log("Selected item:", item);                        
                        $("#txtCustomerID").val(item.id);
                        return false;
                    }
                });
            },
            error: function (data) {                
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    function GetData(nMode, strID = null,stsid = null) {
        $.ajax({
            url: Aurl + "webcollection/getdata",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, ID: strID, UserID: UID,Status:stsid },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                 if (nMode == 4) {
                    showSuccessSnackbar("Cancelled successfully");
                    LoadFilterData();
                }
                else if (nMode == 5) {
                    $("#btnSave").prop("disabled", false);
                    $("#tblOrdertakenData tbody tr").css("color", "black").attr("title", "");
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                        }
                        else {
                            var ErrorIDs = items.RowID.split(',');
                            var ErrorMSGs = items.Message.split(',');
                            for (var i = 0; i < ErrorIDs.length; i++) {
                                var WCID = ErrorIDs[i];
                                var WCErrorMsg = ErrorMSGs[i];
                                if (WCID != "") {
                                    $("#tblOrdertakenData tbody tr").each(function () {
                                        var rowdata = OrderTakenTable.row($(this)).data();
                                        var isChk = $(this).find('input[type=checkbox]').is(':checked');
                                        var CustomerName = rowdata.CustomerName;
                                        if (WCID == rowdata.ID) {
                                            //$(this).css('color','red').attr("title", WCErrorMsg);
                                            $(this).find("td").css("color", "red").attr("title", WCErrorMsg);
                                        }
                                        else if (isChk) {
                                            //$(this).css('color', 'green').attr("title", "Saved Successfully");
                                            $(this).find("td").css("color", "green").attr("title", "Saved Successfully");
                                        }
                                    });
                                }
                                if (ErrorIDs.length == (i + 1)) {
                                    var errorCount = ErrorIDs.filter(id => id !== "").length;
                                    if (errorCount > 0) {
                                        showErrorSnackbar(errorCount + " records have errors. Hover on red rows for details.");
                                    }
                                }
                            }

                        }
                    });

                }                
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $("#txtCustomer").change(function (e) {
        $("#txtCustomerID").val("");
    });
    function LoadFilterData() {//arrVendorName,divErrFTo,divErrFFrom,divErrFParty
        var IsValid = true;
        $(".clrdivs").html("");
        //rdoCustomer,rdoProduct
        if ($("#txtCustomer").val() != "") {
            var pd = arrParty.filter(t => t.name == $("#txtCustomer").val().trim());
            const exists = pd.length > 0;
            if (!exists) {
                IsValid = false;
                $("#divErrCustomer").html("Select Customer Name from list");
            }
        }
        
        if (IsValid) {
            //$('#cmbBeatName,#cmbSalesManName,#cmbActiontype')
            var strBeat = $('#cmbBeatName').val(), strSalesman = $('#cmbSalesManName').val(),
                strCustomer = $("#txtCustomerID").val(),strShowAll = $("#chkShowAll").is(":checked") ? 1 : 0;

            $.ajax({
                url: Aurl + "bulkordertaken/filterdocuments",
                type: 'get',
                contentType: 'json',
                data: {
                    BeatID: strBeat, SalesmanID: strSalesman,
                    CustomerID: strCustomer, ShowAll: strShowAll
                },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                        var custjsdata = data;
                        $('#tblOrdertakenData').DataTable({
                            scrollY: "325px",
                            scrollX: true,
                            scrollCollapse: true,
                            paging: false,
                            destroy: true,
                            data: custjsdata,
                            fixedColumns: false,
                            searching: true,
                            ordering: false,
                            sorting: false,
                            columns: [
                                { "data": "ID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                { "data": "EncID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                { "data": "StatusID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                                {
                                    className: "dt-body-center",width:"2%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var checkboxId = 'chkCustomerCheck_' + rowIndex;//value.CustomerID
                                        var _action = value.StatusID == "1" || value.StatusID == "3" ? '<input type="checkbox" id="' + checkboxId + '" data-statusid = "' + value.StatusID + '" data-id="' + value.ID +'"  name="CustomerCheck" style="" />': '';
                                        return _action;
                                    },
                                },
                                {
                                    className: "dt-body-center", width: "4%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = meta.row;
                                        var checkboxId = 'dgvCustCode_' + rowIndex;//value.CustomerID
                                        var _action = '<a href="javascript:void(0)" style="cursor: pointer;"><span class="glyphicon glyphicon-eye-open clsView" style="font-size:16px" title="View"></span></a>&ensp;' +
                                            (($("#txtAdd").val() == "1" && (value.StatusID == "1" || value.StatusID == "3")) ? '<a href="javascript:void(0)" style="cursor: pointer;"><span class="glyphicon glyphicon-edit clsEdit" style="font-size:16px" title="Edit"></span></a>' : '');
                                        return _action;
                                    },
                                },
                                {
                                    className: "dt-body-center", width: "3%",
                                    "mRender": function (data, type, value, meta) {
                                        var rowIndex = (meta.row + 1);
                                        var _action = rowIndex;
                                        return _action;
                                    },
                                },
                                //{ "data": "Date", "autoWidth": true, className: "dt-body-left" },
                                {
                                    className: "dt-body-left", width: "6%",
                                    mRender: function (data, type, value) {
                                        return '<label>' + value.Date + '</label>';
                                    }
                                },
                                { "data": "BeatName", width: "10%", "autoWidth": true, className: "dt-body-left" },
                                { "data": "SalesManName", width: "10%", "autoWidth": true, className: "dt-body-left" },
                                //{ "data": "CustomerName", "autoWidth": true, className: "dt-body-left" },
                                {
                                    className: "dt-body-left", width: "17%",
                                    mRender: function (data, type, value) {
                                        var sCustomerName = value.CustomerName || '';
                                        var displayText = sCustomerName.length > 30
                                            ? sCustomerName.substring(0, 30) + '...'
                                            : sCustomerName;

                                        return '<label title="' + sCustomerName + '">' + displayText + '</label>';
                                    }
                                },
                                { "data": "Value", width: "7%", "autoWidth": true, className: "dt-body-right" },
                                { "data": "ItemCount", width: "3%", "autoWidth": true, className: "dt-body-right" },
                                { "data": "DiscAmt", width: "5%", "autoWidth": true, className: "dt-body-right" },    
                                {
                                    className: "dt-body-right", width: "7%",
                                    mRender: function (data, type, value) {
                                        var stsclass = value.StatusID == "1" || value.StatusID == "3" ? "stsOpen" : value.StatusID == "4" || value.StatusID == "2" ? "stsCancel" :
                                            value.StatusID == "5" || value.StatusID == "8" ? "stsClose" : "";
                                        return '<label class="' + stsclass + '">' + value.Status + '</label>';
                                    }
                                },
                                {
                                    className: "dt-body-left", width: "12%",
                                    mRender: function (data, type, value) {
                                        var sRemarks = value.Remarks || '';
                                        var displayText = sRemarks.length > 15
                                            ? sRemarks.substring(0, 15) + '...'
                                            : sRemarks;

                                        return '<label title="' + sRemarks + '">' + displayText + '</label>';
                                    }
                                },
                                {
                                    className: "dt-body-left", width: "14%",
                                    mRender: function (data, type, value) {
                                        var sNarration = value.Narration || '';
                                        var displayText = sNarration.length > 15
                                            ? sNarration.substring(0, 15) + '...'
                                            : sNarration;

                                        return '<label title="' + sNarration + '">' + displayText + '</label>';
                                    }
                                },
                            ],
                        });
                        OrderTakenTable = $('#tblOrdertakenData').DataTable();
                        if (custjsdata.length == 0) {
                            showErrorSnackbar("No data found");
                        }
                    
                }
            });
        }
    }
    function LoadOTItems(OTID) {
        $.ajax({
            url: Aurl + "bulkordertaken/otdata",
            type: 'get',
            contentType: 'json',
            data: {
                ID: OTID
            },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                var custjsdata = data;
                $('#tblOTProductData').DataTable({
                    scrollY: "325px",
                    scrollX: true,
                    scrollCollapse: true,
                    paging: false,
                    destroy: true,
                    data: custjsdata,
                    fixedColumns: false,
                    searching: true,
                    ordering: false,
                    sorting: false,
                    columns: [
                        {
                            className: "dt-body-center", width: "3%",
                            "mRender": function (data, type, value, meta) {
                                var rowIndex = (meta.row + 1);
                                var _action = rowIndex;
                                return _action;
                            },
                        },
                        { "data": "Code", width: "10%", "autoWidth": true, "visible": false, className: "dt-body-left" },
                        { "data": "Name", width: "25%", "autoWidth": true, className: "dt-body-left" },
                        { "data": "Qty", width: "8%", "autoWidth": true, className: "dt-body-right" },
                        { "data": "Price", width: "8%", "autoWidth": true, className: "dt-body-right" },
                        { "data": "DiscPern", width: "8%", "autoWidth": true, className: "dt-body-right" },
                        { "data": "DiscAmt", width: "8%", "autoWidth": true, className: "dt-body-right" },
                        { "data": "GrossAmt", width: "8%", "autoWidth": true, className: "dt-body-right" },
                    ],
                });
                OTProductTable = $('#tblOTProductData').DataTable();
                if (custjsdata.length == 0) {
                    showErrorSnackbar("No items found");
                }

            }
        });
    }
    $(document).on("click", "#chkSelectAll", function () {
        var IsChk = $('#chkSelectAll').is(':checked');
