    $("#btnClear").click(function () {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    $("#btnFilter").click(function () {
        LoadFilterData();
    });
    
    $("#btnCancel").click(function () {
        var checkeditems = $('#tblOrdertakenData tbody input[type=checkbox]:checked');
        var validateitems = [];
        if (checkeditems.length > 0) {
            var SelIDs = "";
            const validateitems = checkeditems.map(function () {
                return {
                    ID: $(this).data("id"),
                    Status: $(this).data("statusid")
                };
            }).get();
            console.log("validateitems", validateitems);
            var conf = confirm("Do you want to cancel?");
            if (conf) {
                //var TrimID = SelIDs.substring(0, SelIDs.length - 1);
                //GetData(4, TrimID);
                $.ajax({
                    url: Aurl + "bulkordertaken/cancel",
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        Mode: 2,
                        UserID: UID,
                        Items: validateitems
                    }),
                    xhrFields: {
                        withCredentials: true
                    },
                    success: function (data) {
                        if (data) {
                            var anyerrors = data.some(d => d.Type == "Error");
                            if (anyerrors) {
                                showErrorSnackbar("Errors in some document");
                                    var checkinputitems = $('#tblOrdertakenData tbody input[type=checkbox]');
                                    checkinputitems.each(function (i, items) {
                                        var row = $(this).closest('tr'); // Find the parent row
                                        var rowData = $('#tblOrdertakenData').DataTable().row(row).data(); // Get full row data
                                        row.removeClass("highlight-error-row"); row.removeClass("highlight-success-row");
                                        var highlightdata = data.filter(t => t.ID == rowData.ID);
                                        if (highlightdata.length > 0) {

                                            if (highlightdata[0].Type == "Error")
                                                row.addClass("highlight-error-row");
                                            else
                                                row.addClass("highlight-success-row");

                                            row.find('td').prop("title", highlightdata[0].Message);
                                        }
                                    });
                            }
                            else {
                                showSuccessSnackbar("Cancelled successfully");
                                LoadFilterData();                                
                            }
                        } else {
                            showErrorSnackbar("Something went wrong");
                        }
                    }
                });

            }
        }
        else {
            showErrorSnackbar("Select anyone data");
        }
    });

