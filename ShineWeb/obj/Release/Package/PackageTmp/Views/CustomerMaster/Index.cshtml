<style>
  
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 75%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            /*overflow: auto;*/
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 2px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            /*overflow: auto;*/
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
        /*height:40px;*/
    }

        /* Style the buttons inside the tab */
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding-top: 5px;
            padding-bottom: 5px;
            padding-left: 12px;
            transition: 0.5s;
            font-size: 13px;
            font-weight:500;
            border-radius: 5px;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: lightskyblue;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        /*padding: 6px 12px;*/
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -48%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    @@media only screen and (max-width: 850px) {

        /* Modal uses full width */
        .modal-dialog.modal-xl {
            margin-top: 200px; /* change this number to move it lower */
            margin-left: 5px;
            margin-right: 5px;
            max-width: calc(100% - 10px);
        }

        /* Tab buttons smaller to fit in one row */
        .tab button {
            font-size: 11px;
            padding: 4px 8px;
        }

        /* Shrink all text and inputs */
        .tabcontent td {
            font-size: 10px;
            padding: 2px 4px !important;
        }

        .tabcontent .form-control {
            font-size: 10px;
            height: 28px;
            padding: 2px 6px;
        }

        .tabcontent .labelup {
            font-size: 0.75em;
        }

        .tabcontent label {
            font-size: 10px;
        }

        /* Tighten column padding */
        .tabcontent [class*="col-md-"] {
            padding-left: 4px !important;
            padding-right: 4px !important;
        }

        /* KEY FIX - override Bootstrap col-12 stacking */
        .tabcontent .col-12.col-md-4 {
            flex: 0 0 33.33% !important;
            max-width: 33.33% !important;
            width: 33.33% !important;
        }

        /* For BeatMapping and Remarks tabs which use col-md-8 */
        .tabcontent .col-12.col-md-8,
        .tabcontent .col-sm-12.col-md-8.col-lg-8 {
            flex: 0 0 66.66% !important;
            max-width: 66.66% !important;
            width: 66.66% !important;
        }

        /* For the empty side columns col-md-2 */
        .tabcontent .col-sm-12.col-md-2.col-lg-2 {
            flex: 0 0 16.66% !important;
            max-width: 16.66% !important;
            width: 16.66% !important;
        }
    }

    /*  input:focus + .labelup,
    input:not(:placeholder-shown) + .labelup, textarea:focus + .labelup, textarea:not(:placeholder-shown) + .labelup {
        top: -35%;
        font-size: .7em;
        padding: 0 .3em;
        background: #F9F9F9;
        color: #000000;
    }*/
    .clsnewitem {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 2px 5px;
        font-size: 12px;
        font-weight: 500;
        color: #0C447C;
        background: #E6F1FB;
        border: 0.5px solid #85B7EB;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, transform 0.1s;
        white-space: nowrap;
        user-select: none;
    }

        .clsnewitem:hover {
            background: #B5D4F4;
            transform: scale(1.05)
        }
</style>
