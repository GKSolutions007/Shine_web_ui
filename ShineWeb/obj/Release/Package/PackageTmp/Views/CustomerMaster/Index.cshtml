<script>
    //~Filter Action Buttons
    var nTransMode = 1;
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                $(".modal-title#lblPopupheading").text("View Customer");
                nTransMode = 3;
                $(".clrdiv").html("");

                var ID = rowData.ID;

                $("#txtID").val(ID);
                openTabs(null, 'CustomerDetails', 1);
                GetData(5, ID);
                $(".FormclrField,.FormclrcmbField,#btnBSAddRow,#btnRemarksAddRow").prop("disabled", true);
                $("input[type=checkbox],#btnSave,#btnClear").prop("disabled", true);
                $("#chkShowTP").prop("disabled", false);
                $("#txtOSCount").prop("disabled", true);
                $("#txtOSValue").prop("disabled", true);
                $(".clrdivs").html("");
                $("#dvErrorDetail,#btnBSAddBeat,#btnBSAddSalesman,#btnBSAddRow").hide();
                $("#lblSaveError").html("");
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                $(".modal-title#lblPopupheading").text("Edit Customer");
                nTransMode = 2;
                $(".clrdiv").html("");
                openTabs(null, 'CustomerDetails', 1);

                //rowData = Table.row($(this).parents('tr')).data();
                //var ID = rowData[0];
                var ID = rowData.ID;
                $("#txtID").val(ID);
                GetData(5, ID);
                $(".FormclrField,.FormclrcmbField,#btnBSAddRow,#btnRemarksAddRow").prop("disabled", false);
                $("input[type=checkbox],#chkActive,#btnSave").prop("disabled", false);
                $("#txtOSValue,#txtOSCount").prop("disabled", true);
