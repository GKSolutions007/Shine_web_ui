    var objItemDetails = [];
    function AddBeatSalesman() {
        objItemDetails = [];
        var Beatname = '', SalesmanName = '', IsGO = false;
        $('#tblBeatSalesman tr td input').each(function (i, items) {
            //ShowMsgPopup(items.value + i);
            //isGridEmpty++;
            if (items.value != "") {
                if (i % 2 == 0) {
                    Beatname = items.value;
                    IsGO = false;
                }
                else {
                    SalesmanName = items.value;
                    IsGO = true;
                }
                if (IsGO) {
                    if (Beatname != "" && SalesmanName != "") {
                        var singleList = {
                            'BeatName': Beatname,
                            'SalesmanName': SalesmanName
                        };
                        IsGO = false;
                        objItemDetails.push(singleList);
                    }
                }
            }
            else {
                showErrorSnackbar("Beat/Salesman Name should not empty for added row. Select Value for added row otherwise Remove it");
            }
        });
    }
    //~Validation Beatsalesman
    function ValidateBeatsalesman() {
        var IsValid = true;
        var bearmaprows = TableBS.rows().count();
        if (bearmaprows > 0) {
            $('#tblBeatSalesman tr').each(function (i, items) {
                $(this).find("input").each(function (n) {
                    $(this).css("border-color", "black");
                    const fieldName = $(this).attr("name");
                    if (fieldName == "Beat") {
                        //const exists = arrBeat.indexOf($(this).val().trim()) !== -1;
                        var btarr = arrBeat.filter(a => a.label == $(this).val().trim());
                        if (btarr.length == 0) {
                            IsValid = false;
                            showErrorSnackbar("Select Beat Name from list");
                            $(this).css("border-color", "red");
                        }
                    }
                    if (fieldName == "Salesman") {
                        var smarr = arrSalesman.filter(a => a.label == $(this).val().trim());
                        if (smarr.length == 0) {
                            IsValid = false;
                            showErrorSnackbar("Select Salesman Name from list");
                            $(this).css("border-color", "red");
                        }
                    }
                });
            });
        }
        else {
            if (BeatMandatoryinCustomer == 1) {
                IsValid = false;
                showErrorSnackbar("Beat Mapping is mandatory.");
            }
        }
        return IsValid;
    }
