    function LoadDependData(DependModeID,AssignValue) {
        $.ajax({
            url: Aurl + "customermaster/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: 6, Name: RoleID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                var AssignLoadData = [];
                if (DependModeID == 1) {//Customer Type
                    $('#cmbCustomerType').find("option").remove().append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    AssignLoadData = data.filter(FT => FT.FType == 7);
                    $.each(AssignLoadData, function (i, items) {
                        $('#cmbCustomerType').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    $('#cmbCustomerType').val(AssignValue);
                } else if (DependModeID == 2) {//Credit Term
                    $('#cmbCreditTerm').find("option").remove().append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    AssignLoadData = data.filter(FT => FT.FType == 4);
                    $.each(AssignLoadData, function (i, items) {
                        $('#cmbCreditTerm').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    $('#cmbCreditTerm').val(AssignValue);
                } else if (DependModeID == 3) {//Beat
                    arrBeat = [];
                    AssignLoadData = data.filter(FT => FT.FType == 8);
                    $.each(AssignLoadData, function (i, items) {
                        var al = {
                            "label": items.Name,
                        }
                        arrBeat.push(al);
                    });
                } else if (DependModeID == 4) {//Salesman
                    arrSalesman = [];
                    AssignLoadData = data.filter(FT => FT.FType == 9);
                    $.each(AssignLoadData, function (i, items) {
                        var al = {
                            "label": items.Name,
                        }
                        arrSalesman.push(al);
                    });
                }
            }
        });

