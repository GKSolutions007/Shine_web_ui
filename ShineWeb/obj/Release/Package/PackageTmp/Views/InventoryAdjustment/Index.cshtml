
@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}

<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />

<link href="~/datatable/1.13.6/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />
<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<script src="~/Scripts/5.3.8/bootstrap.bundle.min.js"></script>
<script src="~/datatable/1.13.6/jquery.dataTables.min.js"></script>

<script src="~/datatable/1.13.6/dataTables.bootstrap5.min.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>


<header>
    <link rel="stylesheet" href="~/Content/index.css">
</header>

<style>
    .gdInput {
        width: 100%;
        height: 25px;
        border-width: 0 0 0.1px 0;
        border-color: #e0d6d6;
    }

    th, td {
        white-space: nowrap;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000000;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .modalBatch {
        display: none;
        position: fixed;
        z-index: 200;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
    }

    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto;
            padding: 10px;
            border: 1px solid #888;
            width: 85%;
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto;
            padding: 25px;
            border: 1px solid #888;
            width: 95%;
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }

    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .modalProdInfo {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
    }

    @@media only screen and (min-width: 600px) {
        .modalProdInfo-content {
            background-color: #ffffff;
            margin: 3% auto;
            padding: 10px;
            border: 1px solid #888;
            width: 30%;
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalProdInfo-content {
            background-color: #ffffff;
            margin: 10% auto;
            padding: 25px;
            border: 1px solid #888;
            width: 95%;
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }

    .closePinfo {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closePinfo:hover,
        .closePinfo:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .modalProdHistory {
        display: none;
        position: fixed;
        z-index: 10;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgb(0,0,0);
        background-color: rgba(0,0,0,0.4);
    }

    .modal-body {
        padding: 5px !important;
    }

    @@media only screen and (min-width: 600px) {
        .modalProdHistory-content {
            background-color: #ffffff;
            margin: 2% auto;
            padding: 2px;
            border: 1px solid #888;
            width: 80%;
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalProdHistory-content {
            background-color: #ffffff;
            margin: 10% auto;
            padding: 2px;
            border: 1px solid #888;
            width: 95%;
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }

    .closePHistory {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closePHistory:hover,
        .closePHistory:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }


    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.5s;
            font-size: 17px;
        }

            .tab button:hover {
                background-color: #ddd;
            }

            .tab button.active {
                background-color: #ccc;
            }

    .tabcontent {
        display: none;
        border: none;
        border-top: none;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -60%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -28%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.9em;
        font-weight: 600;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        color: white;
        background-color: azure;
    }

    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background-color: #c2f6b5;
        z-index: 1000;
    }
</style>
<style>
    /* Align dropdown in DataTable cell */
    .action-dropdown {
        min-width: 100px;
        font-size: 12px;
        z-index: 1000;
        text-align: left;
    }

        /* Optional: Add hover effect */
        .action-dropdown > li > a {
            padding: 3px 12px;
            color: #333;
            text-decoration: none;
        }

            .action-dropdown > li > a:hover {
                background-color: #f5f5f5;
                color: #000;
            }

    /* Optional: Make dropdown button minimal */
    .dropdown-toggle {
        background-color: transparent !important;
        border: none !important;
        font-size: 15px;
        line-height: 1;
        padding: 2px 5px;
    }

        .dropdown-toggle::after {
            display: none;
        }

    #tblProductHistory td {
        font-size: 12px;
    }

    .zero-width-column {
        width: 0 !important; /* enforce zero width */
        padding: 0 !important; /* remove any cell padding */
        overflow: hidden; /* hide content */
        white-space: nowrap; /* prevent wrapping */
    }

    .form-floating > label {
        font-size: 10px;
        font-weight: 600;
        color: black;
    }



    @@media (min-width: 801px) {
        .custom-col_blank {
            flex: 0 0 auto;
            width: 25%; /* col-md-3 = 2/12 = 16.66% */
        }
    }

    @@media (max-width: 800px) {
        .custom-col_blank {
            flex: 0 0 auto;
            width: 16.66%; /* col-md-4 = 3/12 = 25% */
        }
    }

    @@media (min-width: 801px) {
        .custom-col {
            flex: 0 0 auto;
            width: 25%; /* col-md-3 = 3/12 = 25% */
        }
    }

    @@media (max-width: 800px) {
        .custom-col {
            flex: 0 0 auto;
            width: 33.333333%; /* col-md-4 = 4/12 = 33.33% */
        }
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control", @id = "txtTransType" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })

    <input hidden id="txtStatus" /><input hidden class="FormclrField" id="txtDraftID" />
    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>

    <div id="dvDocuments">
        <div>
            <table style="width:100%;">
                <tr>
                    <td width="20%" hidden>
                        <button id="btnAdd" class="btn btn-info"><span class="glyphicon glyphicon-plus" style="color: white"></span>&#x2009;Add</button>
                    </td>
                    <td align="right">
                        <table>
                            <tr>
                                <td width="50%"></td>
                                <td width="20%">
                                    <span class="form-label">
                                        <select class="form-control FormfilterclrField" id="cmbFilterBranch"><option value="0">Select Branch</option></select>
                                        <label class="labelup" for="txtCode"> Branch </label>
                                    </span>                                   
                                </td>
                                <td width="3%">
                                    <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                                </td>
                                <td width="10%">
                                    <span class="form-label">
                                        <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFFrom" placeholder="" oninput="javascript: if (this.value > this.max) { this.value = this.max; }">
                                        <label class="labelup" for="txtCode"> From</label>
                                    </span>                                   
                                    <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrFFrom" class="text-danger pt-1 ps-1 clrdivs"></div>
                                </td>
                                <td width="10%">

                                    <span class="form-label">
                                        <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFTo" placeholder="" oninput="javascript: if (this.value > this.max) { this.value = this.max; }">
                                        <label class="labelup" for="txtCode"> To</label>
                                    </span>                                   
                                    <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrFTo" class="text-danger pt-1 ps-1 clrdivs"></div>
                                </td>
                                <td width="7%">
                                    <button id="btnFilter" class="btn btn-primary"><span class="glyphicon glyphicon-export" style="color: white"></span>&#x2009;Filter</button>
                                </td>
                            </tr>
                        </table>

                    </td>
                </tr>
            </table>

            <div id="my-grid" style="height: 600px; width: 100%;"></div>

        </div>       
        <hr />        
    </div>

    <div id="dvMain">
        <div class="row">
            <!-- Branch -->
            <div class="col-12 col-md-3 mb-3">
                <span class="form-label">
                    <select class="form-control FormclrcmbField" id="cmbBranch"><option value="0">Select Branch</option></select>
                    <label class="labelup" for="txtCode"> Branch *</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrBranch"></div>
            </div>

            <!-- Ref No -->
            <div class="col-12 col-md-2 mb-3">
                <span class="form-label">
                    <input tabindex="1"
                           class="form-control FormclrField"
                           type="text"
                           id="txtRefNo"
                           placeholder="Ref No"
                           onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRefNo')"
                           oninput="sanitizeAlphaNumeric(this, '#divErrRefNo')" />
                    <label class="labelup" for="txtRefNo">Ref No</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrRefNo"></div>
            </div>
            <!-- Blank -->
            <div class="col-12 col-md-5 mb-3"></div>
            <!-- Doc ID + Date -->
            <div class="col-12 col-md-2 mb-3">
                <div>
                    <table>
                        <tr>
                            <td align="right">
                                <span class="fw-semibold">
                                    Doc ID :
                                </span>
                            </td>
                            <td>
                                <span id="lblDocID" docprefix="" style="font-size:14px" class="fw-bolder">IA/2425/1</span>
                            </td>
                        </tr>
                        <tr>
                            <td align="right">
                                <span class="fw-semibold">
                                    Date :
                                </span>
                            </td>
                            <td>
                                <input class="clsdtpfieldbottomborder FormclrField"
                                       type="date"
                                       id="dtpDate"
                                       oninput="if (this.value > this.max) { this.value = this.max; }"
                                       placeholder="Date" />
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrDate"></div>
            </div>
        </div>
        <div class="row">

            <input hidden id="txtHProdID" class="FormclrField" />
            <input hidden id="txtHTrackInventory" />
            <input hidden id="txtHTrackBatch" />
            <input hidden id="txtHPKD" />
            <input hidden id="txtHPPrice" />
            <input hidden id="txtHSPrice" />
            <input hidden id="txtHECP" />
            <input hidden id="txtHSPL" />
            <input hidden id="txtHMRP" />
            <input hidden id="txtHRTNPrice" />
            <div class="col-12 col-md-1 mb-3">
                <div class="form-check" style="font-size:14px;">
                    <input class="form-check-input FormfilterclrField" type="checkbox" id="chkQtyonly" style="width:14px; height:14px;">
                    <label class="form-check-label" for="chkQtyonly" style="font-size:11px;">Qty Batch Only</label>
                </div>
            </div>
            <div class="col-12 col-md-5 mb-3">
                <div class="input-group">
                    <span class="form-label flex-grow-1">
                        <input class="form-control FormclrField" id="txtHProds" />
                        <input id="txtHProdCode" hidden />
                        <label class="labelup" for="txtCode">Item Details </label>
                    </span>
                    <span id="sItemHistroy" class="input-group-text" title="Product History" style="cursor:pointer;"><span class="glyphicon glyphicon-info-sign" style="background-color:white;"></span></span>
                </div>
                <label class="form-label" style="padding-left: 1em" id="lblProdCodeAS"></label>
                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrProduct" class="clrdivs"></div>
            </div>
            <div class="col-12 col-md-2 mb-3">
                <span class="form-label">
                    <select tabindex="3" class="form-control FormclrcmbField" id="cmbUOM">
                        <option value="0">Select UOM</option>
                    </select>
                    <label class="labelup">UOM </label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrUOM"></div>
            </div>
            <div class="col-12 col-md-1 mb-3">
                <button class="btn btn-primary" id="btnBatch">Batch</button>&ensp;@*<button class="btn btn-info" tabindex="5">Add</button>*@
                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrProductBatch" class="clrdivs"></div>
            </div>
            <div class="col-12 col-md-3 mb-3">

            </div>

        </div>
        <div class="row">
            <div class="table-responsive">
                <table class="table table-bordered  row-border order-column" id="tblProductData" width="100%">
                    <thead>
                        <tr class="trclrforcolheader">
                            <th style="text-align:center;font-size: 12px;width:0px;" class="trclrforcolheader">ProdID</th>
                            <th style="text-align: center; font-size: 12px; width: 0px;" class="trclrforcolheader">ProdCode</th>
                            <th style="text-align: center; font-size: 12px; width: 0px;" class="trclrforcolheader">UOMID</th>
                            <th style="text-align: center; font-size: 12px; width: 0px;" class="trclrforcolheader">TaxPern</th>
                            <th style="text-align: center; font-size: 12px; width: 10px;" class="trclrforcolheader">Action</th>
                            <th style="text-align: center; font-size: 12px; width: 5px;" class="trclrforcolheader">#</th>
                            <th style="text-align: center; font-size: 12px; width: 200px;" class="trclrforcolheader">Item Names</th>
                            <th style="text-align: center; font-size: 12px; width: 60px;" class="trclrforcolheader">ABS Qty</th>
                            <th style="text-align: center; font-size: 12px; width: 60px;" class="trclrforcolheader">ABS Free</th>
                            <th style="text-align: center; font-size: 12px; width: 60px;" title="Damage Qty" class="trclrforcolheader">ABS Dmg</th>
                            <th style="text-align: center; font-size: 12px; width: 60px;" title="Product Discount" class="trclrforcolheader">UOM</th>
                            <th style="text-align: center; font-size: 12px; width: 60px;" class="trclrforcolheader">Adj Qty</th>
                            <th style="text-align: center; font-size: 12px; width: 60px;" class="trclrforcolheader">Adj Free</th>
                            <th style="text-align: center; font-size: 12px; width: 60px;" title="Damage Qty" class="trclrforcolheader">Adj Dmg</th>
                            <th style="text-align: center; font-size: 12px; width: 60px;" class="trclrforcolheader">Gross ₹</th>
                        </tr>

                    </thead>
                    <tfoot>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td align="right">
                                <label> Total :</label>
                            </td>

                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td align="right"><label id="lblPTQty" style="text-align:right" class="lblPT">0.00</label></td>
                            <td align="right"><label id="lblPTFreeQty" style="text-align:right" class="lblPT">0.00</label></td>
                            <td align="right"><label id="lblPTDmgQty" style="text-align:right" class="lblPT">0.00</label></td>
                            <td align="right"><label id="lblPTAmt" class="lblPT">0.00</label></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="row pb-5" style="padding-bottom:200px;padding-top:20px">

            <div class="col-12 col-md-3"></div>
            <div class="col-12 col-md-3"></div>
            <div class="col-12 col-md-3"></div>

            <div class="col-12 col-md-3">

                <!-- Remarks -->
                <span class="form-label">
                    <input tabindex="1" class="form-control FormclrField" type="text" id="txtRemarks" placeholder=""
                           onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRemarks')"
                           oninput="sanitizeAlphaNumeric(this, '#divErrRemarks')" />
                    <label class="labelup" for="txtCode">Remarks</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs mb-3" id="divErrRemarks"></div>

                <!-- Narration -->
                <span class="form-label">
                    <textarea class="form-control FormclrField" rows="3" id="txtNarration"
                              onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrNarration')"
                              oninput="sanitizeAlphaNumeric(this, '#divErrNarration')"></textarea>
                    <label class="labelupfortextarea" for="txtCode">Narration</label>
                </span>
                <div class="text-danger pt-1 ps-1 clrdivs" id="divErrNarration"></div>
            </div>
        </div>
        <div>
            <div class="footerAction modal-footer">
                <table width="100%">
                    <tr>
                        <td width="15%" align="left" style="padding-left: 20px; border: none;">
                            <div>
                                <span class="form-label">
                                    <select class="form-control" id="cmbPrintProfile"><option value="0">Select</option></select>
                                    <label class="labelup"> Print Profile</label>
                                </span>
                                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrPrintProfile" class="clrdivs"></div>
                            </div>                            
                            <div class="text-danger pt-1 ps-1 clrdivs" id="divErrPrintProfile"></div>
                        </td>
                        <td style="border:none;" width="5%">
                            <div>
                                <span class="form-label">
                                    <input id="txtNoofCopies" class="form-control" value="1"
                                           onbeforeinput="return NumericOnlyBeforeInput(event, this,'#divErrPrintProfile')" oninput="sanitizeNumericOnly(this, '#divErrPrintProfile')" />
                                    <label class="labelup">Copies</label>
                                </span>
                                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrPrintProfile" class="clrdivs"></div>
                            </div>
                            <div id="dverrnoofcopy" class="text-danger pt-1 clrdivs"></div>
                        </td>

                        <td width="80%" align="right" style="border:none">
                            <div style="padding-right:20px" align="right" class="p-2">
                                <button type="button" class="btn" title="Whatsapp" id="btnWhatsapp" style="background-color:green;color:white"><i class='fa-brands fa-whatsapp' style='color:white'></i> </button>
