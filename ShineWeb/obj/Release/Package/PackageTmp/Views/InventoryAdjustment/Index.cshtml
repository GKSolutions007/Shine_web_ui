    function CalculateBatchGrid() {
        let result = [];
        var dTotQty = 0, dFreeTotQty = 0, dDmgTotQty = 0, dPPrice = 0, dQty = 0, dFreeQty = 0, dDmgQty = 0, dQtyTotValue = 0, dDmgQtyTotValue = 0;
        $("#tblBatch tbody tr").each(function () {
            var allValues = {};
            var chk = true;
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                if (fieldName == "CheckBatch") {
                    chk = $(this).is(":checked")//.val();
                }
                else {
                    $(this).prop("disabled", !chk);
                    if (fieldName != "PurchasePrice" && !chk)
                        $(this).val(0);
                }
            });
            chk = true;
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                allValues[fieldName] = $(this).val();
                if (fieldName == "CheckBatch") {
                    chk = $(this).is(":checked")//.val();
                    if (!chk)
                        return false;
                }
                else if (fieldName == "Qty") {
                    //dQty = parseFloat($(this).val());
                    const tagval = $(this).attr("txttag");
                    dQty = parseFloat(tagval)
                    dTotQty += parseFloat(dQty);
                } else if (fieldName == "FreeQty") {
                    //dFreeQty = parseFloat($(this).val());
                    const tagval = $(this).attr("txttag");
                    dFreeQty = parseFloat(tagval)
                    dFreeTotQty += parseFloat(dFreeQty);
                } else if (fieldName == "DmgQty") {
                    //dDmgQty = parseFloat($(this).val());
                    const tagval = $(this).attr("txttag");
                    dDmgQty = parseFloat(tagval)
                    dDmgTotQty += parseFloat(dDmgQty);//$(this).val()
                }
                else if (fieldName == "PurchasePrice") {
                    const tagval = $(this).attr("txttag");
                    //dPPrice = parseFloat($(this).val());
                    dPPrice = parseFloat(tagval);
                }
            });
            if (chk) {
                dQtyTotValue += (dQty * dPPrice);
                dDmgQtyTotValue += (dDmgQty * dPPrice);
                var grs = (dQty + dDmgQty) * dPPrice;
                result.push(allValues);
            }
        });
        updateInputColumn("txtBatchQtyTotal", dQtyTotValue); updateInputColumn("txtBatchDmgQtyTotal", dDmgQtyTotValue);
        //$("#txtBatchQtyTotal").val(dQtyTotValue.toFixed(DecVal)); $("#txtBatchDmgQtyTotal").val(dDmgQtyTotValue.toFixed(DecVal));
        updateInputColumn("txtBatchQty", dTotQty); updateInputColumn("txtBatchFreeQty", dFreeTotQty);
        //$("#txtBatchQty").val(dTotQty.toFixed(DecVal)); $("#txtBatchFreeQty").val(dFreeTotQty.toFixed(DecVal));
        updateInputColumn("txtBatchDmgQty", dDmgTotQty);
        //$("#txtBatchDmgQty").val(dDmgTotQty.toFixed(DecVal));
    }
