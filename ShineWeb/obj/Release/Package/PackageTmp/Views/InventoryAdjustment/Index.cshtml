    function GetData(nMode, strName = null, strID = null) {
        $.ajax({
            url: Aurl + "inventoryadjustment/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, CodeName: strName, ID: strID, BranchID: $("#cmbBranch").val(), Date: $("#dtpDate").val() },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbBranch,#cmbFilterBranch,#cmbUDN').find("option").remove();
                    $('#cmbBranch,#cmbFilterBranch,#cmbUDN').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrVendor = [], arrVendorCode = [], arrVendorName = [], arrProd = [];
                    nIndexarrVendor = 0, nIndexarrProd = 0;
                    $.each(data, function (i, items) {

                        if (items.FType == 1) {
                            $('#cmbBranch,#cmbFilterBranch').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 2) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 3) {
                            $("#lblDocID").text(items.Name);
                        }
                    });
                    //$("#cmbBranch").val(DefBranch);
                    LoadBranchByRoles('#cmbBranch,#cmbFilterBranch');
                }
                else if (nMode == 2) {
                    arrProdCode = [], arrProdName = [], arrProdCodeName = [],TempAL = [];
                    TableSelectProd.draw().clear();
                    if (data.length > 0) {
                        var tpn = "";
                        $.each(data, function (i, items) {
                            arrProdCode[i] = items.Code;
                            arrProdName[i] = items.Name;
                            arrProdCodeName[i] = items.Code + "|" + items.Name + "<br>" + "|HSN : " + items.HSNCode + "|Price : " + items.PurchasePrice + " | Qty : " + items.ABSQty;
                            tpn = items.Name;
                            var clr = parseFloat(items.ABSQty) > 0 ? "green" : "red";
                            var al = {
                                "label": items.Code + " | " + items.Name,
                                "name": items.Name,
                                "code": items.Code,
                                "id": items.ID,
                                "ABS": "Qty:<label style='color:" + clr + "'> " + items.ABSQty + " </label>",
                                "line2": "Price : " + items.PurchasePrice + " | Qty :  <label style='color:" + clr + "'> " + items.ABSQty + " </label>"
                            }
                            TempAL.push(al);
                        });
                        //~AutoList
                        PaginatedAutocomplete({
                            inputId: "txtHProds",
                            data: TempAL,
                            onSelect: function (item) {
                                $("#txtHProds").val(item.code);
                                if ($("#cmbBranch").val() > 0) {
                                    var qtyonly = $("#chkQtyonly").is(":checked") ? 1 : 0;
                                    GetData(3, item.code, qtyonly);
                                    $("#btnBatch").focus();
                                }
                                else {
                                    showErrorSnackbar("Select Branch");
                                    $('#txtHProds').val("");
                                    $("#cmbBranch").focus();
                                }
                                return false;
                            }
                        });                        
                    }
                    else {
                    }
                }
                else if (nMode == 3) {
                    $('#cmbUOM').find("option").remove();
                    //$('#cmbUOM').append($('<option/>', {
                    //    value: 0,
                    //    text: "-- Select --",
                    //}));
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            $('#txtHProdID').val(items.ID);
                            $('#txtHProdCode').val(items.Code);
                            $('#lblProdCodeAS').text("Code : " + items.Code);
                            $('#txtHProds').val(items.Name);
                            $('#txtHSN').val(items.HSNCode);
                            updateInputColumn("txtNBPPrice", items.PurchasePrice); updateInputColumn("txtNBSPrice", items.SalesPrice);
                            updateInputColumn("txtNBSPL", items.SPLPrice); updateInputColumn("txtNBECP", items.ECP);
                            updateInputColumn("txtNBMRP", items.MRP); updateInputColumn("txtNBRtnPrice", items.ReturnPrice);
                            $('#txtBatchTrackBatch').val(items.BatchNo); $('#txtBatchTrackPKD').val(items.PKD);
                            var BatEnb = items.BatchNo == "True" ? true : false;
                            var PKDEnb = items.PKD == "True" ? true : false;
                            $('#txtNBBathNo').prop("disabled", !BatEnb);
                            $('#dtpNBPKD,#dtpNBExp').prop("disabled", !PKDEnb);
                            $('#txtNBUOMName').prop("disabled", true);
                            $('#dtpNBPKD').prop("max", mind);
                            $('#dtpNBExp').prop("min", mind);
                            $("#lblNewBatchHeading,#lblBatchHeading").text(items.Name);
                            //txtBatchTrackBatch, txtBatchTrackPKD
                            TableBatch.column(9).visible(BatEnb);
                            TableBatch.column(10).visible(PKDEnb);
                            TableBatch.column(11).visible(PKDEnb);
                            for (var j = 0; j < items.UOMList.length; j++) {
                                $('#cmbUOM').append($('<option/>', {
                                    value: items.UOMList[j].ID,
                                    text: items.UOMList[j].Name,
                                    name: items.UOMList[j].ConvRate,
                                }));
                            }
                            TempBatch = items.PRBatchInfo;
                        });
                        TempProd = data;
                        $('#cmbUOM').val(TempProd[0].BaseUomID);
                        var uomname = $('#cmbUOM option:selected').text();
                        $('#txtNBUOMName').val(uomname);
                    }
                }                
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
