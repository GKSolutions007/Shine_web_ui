    //~Validation
    function SaveValidation() {
        var IsValid = true;
        $(".clrdivs").html("");
        if (nIsDraft == 0) {
            if ($("#cmbBranch ").val() == 0) {
                IsValid = false;
                $("#divErrBranch").html("Select Branch");
                showErrorSnackbar("Select Branch");
            }
        }
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#divErrDate").html("Party should not be empty");
            showErrorSnackbar("");
        }
        if ($("#lblPTAmt").text() == "") {
            IsValid = false;
            showErrorSnackbar("Net Amount should be greater than Zero")
        }
        else {
            if (parseFloat($("#lblPTAmt").text()) < 0) {
                IsValid = false;
                showErrorSnackbar("Amount should be greater than Zero")
            }
        }
        if (ProductTable.rows().count() == 0) {
            IsValid = false;
            $("#divErrProduct").html("Add atleat one product in Grid");
            showErrorSnackbar("Add atleat one product in Grid");
        }
        else {
            if (BatchAcceptArray.length == 0) {
                IsValid = false;
                $("#divErrProductBatch").html("Add Batch details for added products");
                showErrorSnackbar("Add Batch details for added products");
            }
        }
        return IsValid;
    }

    var ProductArray = [];
    function addProdinArray() {
        ProductArray = [];
        var dPTQty = 0, dPTFreeQty = 0, dPTDmgQty = 0, dPTGross = 0, dPTActQty = 0, dPTActFreeQty = 0, dPTActDmgQty = 0,
            nProdID = 0, nUOMID = 0, PDAmt = 0, nSerial = 1, val = 0;
        $("#tblProductData tbody tr").each(function () {
            var allValues = {};
            rowdata = ProductTable.row($(this)).data();
            nProdID = rowdata[0];
            nUOMID = rowdata[2];

            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Qty") {
                    val = $(this).attr("txttag");
                    dPTQty = parseFloat(val);//$(this).val()
                }
                if (fieldName == "FreeQty") {
                    val = $(this).attr("txttag");
                    dPTFreeQty = parseFloat(val);//$(this).val()
                }
                if (fieldName == "DmgQty") {
                    val = $(this).attr("txttag");
                    dPTDmgQty = parseFloat(val);//$(this).val()
                }
                if (fieldName == "ActQty") {
                    val = $(this).attr("txttag");
                    dPTActQty = parseFloat(val);//$(this).val()
                }
                if (fieldName == "ActFreeQty") {
                    val = $(this).attr("txttag");
                    dPTActFreeQty = parseFloat(val);//$(this).val()
                }
                if (fieldName == "ActDmgQty") {
                    val = $(this).attr("txttag");
                    dPTActDmgQty = parseFloat(val);//$(this).val()
                }

            });
            $(this).find("label").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");

                if (fieldName == "Gross") {
                    val = $(this).attr("lbltag")
                    dPTGross = parseFloat(val);//$(this).text()
                }

            });
            var listProds = {
                "ProdID": nProdID,
                "UomID": nUOMID,
                "UomQty": dPTQty,
                "UomFreeQty": dPTFreeQty,
                "UomDamageQty": dPTDmgQty,
                "AdjQty": dPTActQty,
                "AdjFreeQty": dPTActFreeQty,
                "AdjDmgQty": dPTActDmgQty,
                "GrossAmt": dPTGross,
                "Serial": nSerial
            }
            ProductArray.push(listProds);
            nSerial++;
        });
    }
    //~Save
    function SaveData() {
        if (SaveValidation()) {
            $("#btnSave").prop("disabled", true);
            addProdinArray();
            var listTrans = {
                "IsDraft": nIsDraft,
                "ID": $("#txtID").val(),
                "Date": $("#dtpDate").val(),
                "TransMode": nTransMode,
                "TransID": 13,
                "BranchID": $("#cmbBranch").val(),
                "DocID": $("#lblDocID").val(),
                "RefNo": $("#txtRefNo").val(),
                "TaxTypeID": 1,
                "GrossAmt": document.getElementById("lblPTAmt").getAttribute("lbltag"),// $("#lblPTAmt").text(),
                "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : $("#txtStatus").val(),
                "CurrentStatus": $("#txtStatus").val(),
                "CBy": UID,
                "Remarks": $("#txtRemarks").val(),
                "Narration": $("#txtNarration").val(),
                "lstBatchInfo": BatchAcceptArray,
                "lstProdInfo": ProductArray
            }
            $.ajax({
                url: Aurl + "inventoryadjustment/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(listTrans),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            //ClearForm();
                            if (nTransMode != 4) {
                                if (allowprint == 1) {
                                    PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                } else if (allowprint == 3 || allowprint == 4) {
                                    PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                }
                                //if (SendAutoMail == 1)
                                {
                                    //    EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                    AutoEmailDocument(items.ID, PrintTransID);
                                }
                            }
                            ClearForm();
                        }
                        else {
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
        }
    }
    $("#btnSave").click(function () {
        nIsDraft = 0;
