    function GetProductHistoryData(nProdID) {

        var modal = new bootstrap.Modal(document.getElementById('myModalPHistory'));
        modal.show();

        $.ajax({
            url: Aurl + "inventoryadjustment/producthistory",
            type: 'GET',
            data: { ProdID: nProdID, BranchID: $("#cmbBranch").val() },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                var Response = JSON.parse(data);

                if (Response.length === 0) {
                    showErrorSnackbar("No Record Found");
                    if (TableProductHistory) TableProductHistory.clear().draw();
                    return;
                }

                if ($.fn.DataTable.isDataTable('#tblProductHistory')) {
                    TableProductHistory.clear().rows.add(Response).columns.adjust().draw();
                } else {
                    TableProductHistory = $('#tblProductHistory').DataTable({
                        responsive: false,
                        autoWidth: false,
                        scrollX: true,
                        scrollY: '300px',
                        scrollCollapse: true,
                        paging: true,
                        pageLength: 10,
                        colResize: true,   // ← Enables mouse drag resize
                        data: Response,
                        columns: [
                            { title: 'Doc ID', data: 'DocID' },
                            { title: 'Doc Date', data: 'DocDate' },
                            { title: 'Purchase Price', data: 'PurchasePrice' },
                            { title: 'Qty', data: 'Qty' },
                            { title: 'Free Qty', data: 'FreeQty' },
                            { title: 'Damage Qty', data: 'DamageQty' },
                            { title: 'Remarks', data: 'Remarks' },
                            { title: 'Narration', data: 'Narration' }
                        ]
                    });
                }
            }
        });
    }
