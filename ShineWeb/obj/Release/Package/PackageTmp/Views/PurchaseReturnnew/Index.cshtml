<style>
    .summary-box {
        display: inline-block;
        min-width: 100px;
        padding: 15px 20px;
        border-radius: 8px;
        margin: 5px;
        text-align: center;
        vertical-align: middle;
    }

    .bg-paid {
        background-color: #ccf5e7;
    }

    .bg-unpaid {
        background-color: #d8eaff;
    }

    .bg-total {
        background-color: #ffd999;
    }

    .summary-label {
        font-size: 11px;
        color: #333;
        margin-bottom: 5px;
    }

    .summary-value {
        font-size: 12px;
        font-weight: bold;
        color: #000;
    }

    .summary-symbol {
        font-size: 20px;
        font-weight: bold;
        margin: 0 8px;
        display: inline-block;
        vertical-align: middle;
    }

    .input-group .form-label {
        display: flex;
        flex: 1;
        margin-bottom: 0;
    }

    .table {
        margin-bottom: 0px !important;
    }
</style>
<style>
    /* Align dropdown in DataTable cell */
    .action-dropdown {
        min-width: 100px;
        font-size: 12px;
        z-index: 1000;
        text-align: left;
    }

        /* Optional: Add hover effect */
        .action-dropdown > li > a {
            padding: 3px 12px;
            color: #333;
            text-decoration: none;
        }

            .action-dropdown > li > a:hover {
                background-color: #f5f5f5;
                color: #000;
            }

    /* Optional: Make dropdown button minimal */
    .dropdown-toggle {
        background-color: transparent !important;
        border: none !important;
        font-size: 15px;
        line-height: 1;
        padding: 2px 5px;
    }

        .dropdown-toggle::after {
            display: none;
        }
    /* ============ COMPACT FORM CONTROLS ============ */
    .form-control,
    select.form-control,
    input.form-control,
    textarea.form-control,
    .gdInput,
    select.gdInput,
    input.gdInput {
        padding: 4px 8px !important;
        font-size: 12px !important;
        height: 28px !important;
        line-height: 1.4 !important;
    }

    textarea.form-control {
        height: auto !important;
        min-height: 60px !important;
    }

    .input-group-addon {
        padding: 4px 8px !important;
        font-size: 12px !important;
    }

    select.form-control {
        padding-right: 20px !important;
    }

    .pi-header {
        background: linear-gradient(135deg, #0d5c3f 0%, #14804f 100%);
        padding: 8px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }

    .pi-header-icon {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: white;
        flex-shrink: 0;
    }

    .pi-header h4 {
        font-size: 17px;
    }

    .pi-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background-color: rgba(255,255,255,0.15) !important;
        border-radius: 6px;
        padding: 5px;
    }

    .pi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .pi-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 2px;
        padding: 9px 14px;
        border-bottom: 1px solid #f0f0f0;
        min-width: 0;
    }

        .pi-row.full {
            grid-column: 1 / -1;
        }

        .pi-row.highlight {
            background-color: #eafaf1;
        }

    .pi-icon-chip {
        width: 26px;
        height: 26px;
        background-color: #eafaf1;
        color: #14804f;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        margin-top: 1px;
    }

    .pi-label {
        width: auto;
        white-space: nowrap;
        color: #6b7280;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-colon {
        color: #9ca3af;
        width: 6px;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-value {
        font-weight: 600;
        color: #111827;
        font-size: 13px;
        min-width: 0;
        flex: 1;
        white-space: normal;
        overflow: visible;
        word-break: break-word;
        line-height: 1.35;
    }

        .pi-value.muted {
            color: #9ca3af;
            font-weight: 400;
        }

    .pi-badge-good {
        background-color: #eafaf1;
        color: #14804f;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 11px;
    }
</style>

<div class="modal fade" id="vendorInfoModal" tabindex="-1" data-bs-backdrop="static">
