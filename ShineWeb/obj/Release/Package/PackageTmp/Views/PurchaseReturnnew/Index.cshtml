                    "UomDamageQty": itemrow.dmgqty,
                    "ProdDiscPern": itemrow.prodPct,
                    "TradeDiscPern": itemrow.tradePct,
                    "AddnlDiscPern": itemrow.addPct,
                    "ProdDiscAmt": itemrow.prodAmt,
                    "TradeDiscAmt": itemrow.tradeAmt,
                    "AddnlDiscAmt": itemrow.addAmt,
                    "GrossAmt": itemrow.gross,
                    "GoodsAmt": itemrow.goods,
                    "TaxAmt": itemrow.taxAmt,
                    "NetAmt": itemrow.net,
                    "ReasonId": itemrow.reason,
                    "Serial": nSerial,
                    "DiffAmt": itemrow.diff
