    function getManufProducts() {
        var Mfrid = $("#cmbManuf").val();
        if (Mfrid > 0) {
            $.ajax({
                url: Aurl + "purchasereturn/manufproducts",
                type: 'get',
                contentType: 'json',
                data: {
                    BranchID: $("#cmbBranch").val(), PriceType: $("#cmbPriceType").val(), TransDate: $("#dtpDate").val(),
                    ManufID: Mfrid
                },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    console.log(data);
                    ProductTable.draw().clear(); ProductTable.draw().clear();
                    G.clearAllRows();
                    G.setLocked(nTransMode == 4 || nTransMode == 5);
                    if (data.length > 0) {
                        BatchAcceptArray = [];
                        var lstProducts = data[0].ProductData;
                        var lstBatches = data[0].BatchData;
                        if (lstProducts.length > 0) {
                            ProductRID = 0;
                            var disbfields = nTransMode == 4 || nTransMode == 5 ? "disabled" : "";
                            var dataSet = lstProducts.map(function (itemsProd, nRowIndex) {

                                console.log(" itemsProd ", itemsProd);
                                var itembatch = lstBatches.filter(a => a.ProdID == itemsProd.ProdID);
                                var firstmrp = 0, CFValue = 1, TaxID = 0;
                                if (itembatch.length > 0) {
                                    firstmrp = itembatch[0].MRP || 0;
                                    CFValue = parseFloat(itembatch[0].ConversionRate) || 1;
                                    TaxID = itembatch[0].TaxID || 0;
                                } 
                                var goods = parseFloat(itemsProd.GoodsAmt);
                                var gross = parseFloat(itemsProd.GrossAmt);
                                var ProdDiscPern = itemsProd.ProdPern != "" ? parseFloat(itemsProd.ProdPern) : 0;
                                var ProdDiscAmt = parseFloat((goods * ProdDiscPern) / 100);
                                var addnlgross = PurAddnlDiscb4Prod ? goods : (goods - ProdDiscAmt);
                                var trdgross = PurTrdDiscb4Prod ? goods : (goods - ProdDiscAmt);
                                var TradeDiscPern = itemsProd.TradePern != "" ? parseFloat(itemsProd.TradePern) : 0;
                                var TradeDiscAmt = parseFloat((trdgross * TradeDiscPern) / 100);
                                var AddnlDiscPern = itemsProd.AddnlPern != "" ? parseFloat(itemsProd.AddnlPern) : 0;
                                var AddnlDiscAmt = parseFloat((addnlgross * AddnlDiscPern) / 100);
                                //var Reasons = "<select name= 'Reasons' " + disbfields + " class='gdInput dgvcmbReasons' id='dgvReasons" + nRowIndex + "'>" + strReasons + "</select>";
                                
                                var q1 = parseFloat(itemsProd.Qty);
                                var q3 = parseFloat(itemsProd.DmgQty);
                                var PRTransPrice = parseFloat(itemsProd.TransactionPrice);

                                var Diffval = gross / (q1 + q3);
                                var Diff = Diffval - PRTransPrice
                                var DiffInclval = Diff * (1 + (parseFloat(itemsProd.TaxPern) / 100)) || 0;

                                const t = taxById(TaxID) || taxOf(itemsProd.TaxPern);
                                var uoms = [];
                                var opt = {
                                    Name: itemsProd.UOM,
                                    ID: itemsProd.UomID,
                                    CF: CFValue
                                }
                                uoms.push(opt);
                                G.addRow();
                                G.patch(nRowIndex, {
                                    productID: itemsProd.ProdID, ApponMRPCum: itemsProd.CumMRPonTax, MRPonTaxAmt: itemsProd.MRPonTax, TransPrice: +PRTransPrice,
                                    ItemBatchdetail: itembatch,
                                    itemName: itemsProd.Name, code: itemsProd.Code, stock: parseFloat(itemsProd.ABSQty).toFixed(DecVal), freestock: parseFloat(itemsProd.ABSFreeQty).toFixed(DecVal), dmgstock: parseFloat(itemsProd.ABSDmgQty).toFixed(DecVal),
                                    mrp: +firstmrp, qty: +itemsProd.Qty, freeqty: +itemsProd.FreeQty, dmgqty: +itemsProd.DmgQty, _uoms: uoms,
                                    uomID: itemsProd.UomID, uom: itemsProd.UOM,
                                    uomCF: +CFValue, reason: itemsProd.ReasonID,
                                    taxID: +TaxID, prodPct: +ProdDiscPern, prodAmt: +ProdDiscAmt, tradePct: +TradeDiscPern,
                                    tradeAmt: +TradeDiscAmt, addPct: +AddnlDiscPern, addAmt: +AddnlDiscAmt,
                                    goods: goods, gross: gross, taxPct: +itemsProd.TaxPern, taxAmt: +itemsProd.TaxAmt,
                                    net: +itemsProd.NetAmt, diff: +Diff, Incldiff: +DiffInclval
                                }, 'items');
                            });                           
                            BatchAcceptArray = lstBatches;
                            RecalcFooterTotals();
                        }
                        else {
                            showErrorSnackbar("No Products Found")
                        }
                    }
                    else {
                        showErrorSnackbar("No Products Found")
                        calculateProdGrid();
                    }
                }
            });
        }
        else {
            showErrorSnackbar("Select Valid Manufacturer Name");
        }
    }
