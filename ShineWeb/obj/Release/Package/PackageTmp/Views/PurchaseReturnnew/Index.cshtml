    // manualRoundOff : pass a number only when the user typed in txtRoundOff, otherwise round off is auto calculated
    function RecalcFooterTotals(manualRoundOff) {
        var GridNet = 0;
        var rowdatas = G.getData();
        if (rowdatas.length > 0) {
            GridNet = rowdatas.filter(item => Number(item.productID) > 0).reduce((sum, a) => sum + Number(a.net || 0), 0);
        }
        var FrAmt = getTag('txtFright');
        var WOAmt = getTag('txtWriteoff');
        var TCSAmt = getTag('txtTCS');
        var Base = GridNet + FrAmt + WOAmt + TCSAmt;

        var OCAmt, OCPern;
        if (OCMode === 'pct') {
            OCPern = getTag('txtOtherChargPern');
            OCAmt = (Base * OCPern) / 100;
        } else {
            OCAmt = getTag('txtOtherChargAmt');
            OCPern = Base != 0 ? (OCAmt / Base) * 100 : 0;
        }
        var Total = Base + OCAmt;
        var RoundNetAmt, Roundoff;
        if (manualRoundOff !== undefined) {
            Roundoff = manualRoundOff;
            RoundNetAmt = Total + Roundoff;
        } else {
            RoundNetAmt = ApplyRoundoff(Total);
            Roundoff = RoundNetAmt - Total;
        }
        updateInputColumn("txtOtherChargAmt", OCAmt);
        updateInputColumn("txtOtherChargPern", OCPern);
        updateInputColumn("txtRoundOff", Roundoff);
        updateLabelColumn("lblRoundNet", RoundNetAmt);
        //ApplyMultimodeAmount(RoundNetAmt);
        var ro = document.getElementById('txtRoundOff');
        if (ro) ro.style.color = Roundoff > 0 ? 'var(--pos)' : Roundoff < 0 ? 'var(--neg)' : '';

        var Diff = 0, incldiff = 0;
        var rowdatas = G.getData();
        if (rowdatas.length > 0) {
            Diff = rowdatas.filter(item => Number(item.productID) > 0).reduce((sum, a) => sum + Number((a.diff * (a.qty + a.dmgqty)) || 0), 0);
            incldiff = rowdatas.filter(item => Number(item.productID) > 0).reduce((sum, a) => sum + Number((a.Incldiff * (a.qty + a.dmgqty)) || 0), 0);
        }
        updateInputColumn("txtDiffExcl", Diff); updateInputColumn("txtDiffIncl", incldiff);
        $("#txtDiffExcl").css("color", Diff >= 0 ? "green" : "red");
        $("#txtDiffIncl").css("color", Diff >= 0 ? "green" : "red");
    }
