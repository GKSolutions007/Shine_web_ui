<script title="app.js">
    var uomlist = [{
        ID: 1,
        Name: "PCS",
        CF: "1.0000"
    },
    {
        ID: 2,
        Name: "BOX",
        CF: "10.0000"
    },
    {
        ID: 3,
        Name: "KG",
        CF: "1.0000"
    }
    ]
    /* Invoice page: grid configuration, calculations, outside-field sync, save. */
    /* ---- GLOBAL helpers: also used by the other scripts (e.g. GetProductViewData / item tax lookup),
            so they must stay OUTSIDE InitInvoiceGrid(). They only read master lists at call time. ---- */
    /* ---- master lists lookups ---- */
    const itemOf = id => TempAL.find(x => +x.id === +id);                                             // productID -> item (with its own uomlist)
    const uomsOf = r => r._uoms || (itemOf(r.productID) || {}).uomlist || uomlist;                        // UOM list of THIS row (item list, else master list)
    const cfOf = r => { const u = uomsOf(r).find(x => +x.ID === +r.uomID); return u ? (+u.CF || 1) : 1 };          // CF of the row's selected UOM (same value as the option's data-cf)
    const taxById = id => gsttax.find(x => +x.ID === +id);                                              // tax ID    -> tax row
    const taxOf = pct => gsttax.find(x => +x.TaxPern === (+pct || 0));                                    // TaxPern   -> tax row (fallback for saved rows without taxID)
    /* make uomID / uom (name) / uomCF consistent with the row's UOM list */
    function syncUom(r) {
        const l = uomsOf(r), u = l.find(x => +x.ID === +r.uomID) || l.find(x => x.Name === r.uom) || l[0];
        if (u) { r.uomID = +u.ID; r.uom = u.Name; r.uomCF = +u.CF || 1 }
    }

    var G;          // global grid instance (used by the other scripts) - created in InitInvoiceGrid() AFTER the column settings are loaded
    async function InitInvoiceGrid() {
        await LoadColumnSettings();          // 1) column settings from server -> colsettcols
        // 2) everything below (grid creation, handlers) runs only after that
        const byId = id => document.getElementById(id), log = t => byId('msg').textContent = t;


        /* ---- row calculation ---- */
        function calc(r, ch, src) {
            const n = v => +v || 0;
            /* ---- UOM ---- */
            if (ch === 'load') {
                r._uoms = uomsOf({ productID: r.productID });     // saved row: UOM list of its item (else master list)
                if (!(src && 'uomID' in src)) r.uomID = 0;                        // saved row has only the UOM name -> resolve the ID by name
                syncUom(r)
            }                                                  // sets uomID / uom / uomCF
            if (ch === 'item') syncUom(r);                                    // item picked: _uoms + uomID were patched in -> select item's default UOM
            if (ch === 'uomID') {                                             // UOM changed: qty x CF, priceExcl / CF
                const cf = cfOf(r), k = cf / (n(r.uomCF) || 1);                      // k = new CF relative to the previous UOM's CF
                r.qty = rnd(n(r.qty) * k); r.priceExcl = rnd(n(r.priceExcl) / k); syncUom(r);
            }
            /* ---- TAX: dropdown value = gsttax.ID, percentage used in ALL calculations = TaxPern ---- */
            if (ch === 'load' || ch === 'taxID' || ch === 'item') {
                const t = (ch === 'load' && !(src && 'taxID' in src)) ? taxOf(r.taxPct) : taxById(r.taxID);   // saved row without taxID -> find tax by its percentage
                if (t) { r.taxID = +t.ID; r.taxPct = +t.TaxPern; r.mrpOnTax = +t.MRPONTax || 0 } else if (ch === 'load') r.taxID = 0;
            }
            if (ch === 'priceIncl') r.priceExcl = r.priceIncl ? n(r.ApponMRPCum) > 0 ? rnd(n(r.priceIncl) - n(r.MRPonTaxAmt)) : rnd(n(r.priceIncl) / (1 + n(r.taxPct) / 100))
                : rnd(n(r.priceIncl) / (1 + n(r.taxPct) / 100));
            console.log("row calc data", r);
            //r.goods = rnd(n(r.qty) * n(r.priceExcl));
            let base = r.goods;
            [['prod', 'Prod %']].forEach(([p, lbl]) => {
                const pc = p + 'Pct', am = p + 'Amt';
                let pct = n(r[pc]);
                if (ch === am) pct = rnd(base ? n(r[am]) / base * 100 : (n(r[am]) > 0 ? 101 : 0));        // amount typed -> equivalent % (amount on 0 goods counts as > 100)
                if (pct > 100) { r[pc] = 0; r[am] = 0; log(`${lbl} cannot exceed 100 - value reset to 0`) }   // validation: above 100 -> 0
                else if (ch === am) r[pc] = pct; else r[am] = rnd(base * pct / 100);
                base = rnd(base - r[am])
            });
            [['trade', 'Trade %']].forEach(([p, lbl]) => {
                var grsamt = PurTrdDiscb4Prod ? r.goods : (r.goods - r.prodAmt);
                const pc = p + 'Pct', am = p + 'Amt';
                let pct = n(r[pc]);
                if (ch === am) pct = rnd(grsamt ? n(r[am]) / grsamt * 100 : (n(r[am]) > 0 ? 101 : 0));        // amount typed -> equivalent % (amount on 0 goods counts as > 100)
                if (pct > 100) { r[pc] = 0; r[am] = 0; log(`${lbl} cannot exceed 100 - value reset to 0`) }   // validation: above 100 -> 0
                else if (ch === am) r[pc] = pct; else r[am] = rnd(grsamt * pct / 100);
                base = rnd(grsamt - r[am])
            });
            [['add', 'Addnl %']].forEach(([p, lbl]) => {
                var grsamt = PurAddnlDiscb4Prod ? r.goods : (r.goods - r.prodAmt);
                const pc = p + 'Pct', am = p + 'Amt';
                let pct = n(r[pc]);
                if (ch === am) pct = rnd(grsamt ? n(r[am]) / grsamt * 100 : (n(r[am]) > 0 ? 101 : 0));        // amount typed -> equivalent % (amount on 0 goods counts as > 100)
                if (pct > 100) { r[pc] = 0; r[am] = 0; log(`${lbl} cannot exceed 100 - value reset to 0`) }   // validation: above 100 -> 0
                else if (ch === am) r[pc] = pct; else r[am] = rnd(grsamt * pct / 100);
                base = rnd(grsamt - r[am])
            });
            r.gross = r.goods - (r.prodAmt + r.addAmt + r.tradeAmt);
            r.taxAmt = n(r.ApponMRPCum) > 0 ? rnd(r.MRPonTaxAmt * r.qty) : rnd(r.gross * n(r.taxPct) / 100);
            r.net = rnd(r.gross + r.taxAmt);
            if (ch !== 'priceIncl') r.priceIncl = n(r.ApponMRPCum) > 0 ? rnd(n(r.priceExcl) + n(r.MRPonTaxAmt)) : rnd(n(r.priceExcl) * (1 + n(r.taxPct) / 100));
            var valdf = rnd(n(r.gross) / (n(r.qty) + n(r.dmgqty)));
            var Diff = valdf - (n(r.TransPrice) * n(r.uomCF));
            var InclDiff = (Diff * ((n(r.taxPct) / 100) + 1));
            r.diff = rnd(Diff);
            r.Incldiff = rnd(InclDiff)
            /* hidden column values are available here too: r.productID, r.TrackInentoryYN, r.TrackBatchYN, r.TrackPKDYN */
        }

        /* ---- Trade / Addition: only ONE side can be used at a time ----
           source 'grid'   : any grid row has Trade/Addnl % or ₹ (not 0) -> footer % and ₹ are read-only
                             (footer ₹ = total of rows, footer % = total / base * 100); when ALL rows are 0 the footer is editable again
           source 'footer' : footer % or ₹ given (not 0)                  -> that grid column is read-only; both 0 -> editable again */
        const discSrc = { trade: null, add: null };
        const DISC = [
            { k: 'trade', pK: 'tradePct', aK: 'tradeAmt', fp: 'txtTradeDiscPern', fa: 'txtTradeDiscAmt' },
            { k: 'add', pK: 'addPct', aK: 'addAmt', fp: 'txtAddnlDiscPern', fa: 'txtAddnlDiscAmt' }
        ];
        function applyDiscLock(rows) {
            rows = rows || (typeof G !== 'undefined' && G && G.rows) || [];
            const nz = v => (+v || 0) !== 0;
            DISC.forEach(d => {
                const fGiven = nz(byId(d.fp).value) || nz(byId(d.fa).value);
                const gGiven = rows.some(r => nz(r[d.pK]) || nz(r[d.aK]));
                if (discSrc[d.k] === 'grid' && !gGiven) {            // every grid value back to 0 -> release the footer
                    discSrc[d.k] = null; updateInputColumn(d.fp, 0); updateInputColumn(d.fa, 0);
                    return applyDiscLock.paint(d, null);
                }
                if (discSrc[d.k] === 'footer' && !fGiven) discSrc[d.k] = null;
                if (!discSrc[d.k]) discSrc[d.k] = gGiven ? 'grid' : (fGiven ? 'footer' : null);
                applyDiscLock.paint(d, discSrc[d.k]);
            });
        }
        applyDiscLock.paint = function (d, src) {
            const lockGrid = src === 'footer', lockFooter = src === 'grid';
            byId('grid').querySelectorAll(`input[data-key="${d.pK}"],input[data-key="${d.aK}"]`).forEach(el => {
                el.readOnly = lockGrid; el.classList.toggle('ro', lockGrid); el.tabIndex = lockGrid ? -1 : 0;
            });
            [d.fp, d.fa].forEach(id => {
                const el = byId(id); el.readOnly = lockFooter; el.tabIndex = lockFooter ? -1 : 0;
                el.style.backgroundColor = lockFooter ? '#e9ecef' : '';
            });
        };
        /* base on which the row Trade / Addnl % is applied = goods - prod ₹ (goods only when the company setting says trade disc before prod disc; same rule as calc) */
        function discBase(rows) {
            return rows.reduce((a, r) => a + (+r.goods || 0) - (PurTrdDiscb4Prod ? 0 : (+r.prodAmt || 0)), 0);
        }
        /* grid totals -> footer Trade % / ₹ and Addition % / ₹ (only while the grid is the source) */
        function syncFooterDisc(rowData, t) {
            const base = discBase(rowData), act = document.activeElement;
            [['trade', 'txtTradeDiscPern', 'txtTradeDiscAmt', t.tradeAmt], ['add', 'txtAddnlDiscPern', 'txtAddnlDiscAmt', t.addAmt]].forEach(([k, pId, aId, amt]) => {
                if (discSrc[k] === 'grid') {
                    updateInputColumn(aId, amt);
                    updateInputColumn(pId, base ? amt / base * 100 : 0);
                } else if (discSrc[k] === 'footer' && (+byId(pId).value || 0) > 0 && act !== byId(aId)) {
                    updateInputColumn(aId, amt);                       // footer % in use: keep footer ₹ = total of the rows
                }
            });
        }

        /* ---- called on EVERY grid change (edit, add, remove, drag/move, load) with all row data.
                Manipulate rowData here and assign to the fields outside the grid. ---- */
        function updateSummary(rowData) {
            const t = rowData.reduce((a, r) => ({
                prodAmt: a.prodAmt + r.prodAmt,
                tradeAmt: a.tradeAmt + r.tradeAmt,
                addAmt: a.addAmt + r.addAmt,
                gross: a.gross + r.gross,
                tax: a.tax + r.taxAmt,
                net: a.net + r.net
            }), { prodAmt: 0, tradeAmt: 0, addAmt: 0, gross: 0, tax: 0, net: 0 });
            //const roundOff = rnd(Math.round(t.net) - t.net);
            //byId('lblGross').value = f(t.gross, 2);
            //byId('lblTaxAmount').value = f(t.tax, 2);
            //byId('txtRoundOff').value = f(roundOff, 2);
            //byId('lblRoundNet').value = f(t.net + roundOff, 2);
            //byId('txtRoundOff').style.color = roundOff > 0 ? 'var(--pos)' : roundOff < 0 ? 'var(--neg)' : '';

            // grid net -> footer net, then Freight / Writeoff / TCS / Other charge / Round off are applied on top of it
            RecalcFooterTotals();
            // grid Trade / Addnl (% or ₹) -> footer: ₹ = total of the rows' amounts, % = that total / (goods - prod ₹) * 100
            // (a footer field the user is typing in is left alone - its own handler finalises it)
            applyDiscLock(rowData);                 // decides grid / footer source first
            syncFooterDisc(rowData, t);
            //Gross & Tot Disc Amt
            updateLabelColumn("lblGross", t.gross);
            updateLabelColumn("lblTaxAmount", t.tax);
            updateLabelColumn("lblCGST", (t.tax / 2)); updateLabelColumn("lblSGST", (t.tax / 2));
            updateLabelColumn("lblTotalDiscAmt", (t.prodAmt + t.tradeAmt + t.addAmt));

        }

        const hid = (title, key) => ({ id: title, title, visible: false, controls: [{ type: 'hidden', key }] });
        const num = (key, o = {}) => ({ type: 'number', key, ...o });
        const numLabel = (key, o = {}) => ({ type: 'label', key, ...o });
        const dual = p => [num(p + 'Pct', { prefix: '%', max: 100 }), num(p + 'Amt', { prefix: '₹' })];   // % is flagged red live when > 100 (also checked in validate())
        /* ---- item-name autocomplete on EVERY row (re-bound after each grid render: add / delete / move / load / columns) ---- */
        const AC = { field: 'name', startsWith: true };      // search by item name, starts-with (same as the original testitemlist setup)
        let acInst = [];
        const acDestroy = () => { acInst.forEach(a => a.destroy()); acInst = [] };
        function acBind(g) {
            applyDiscLock(g.rows);                                    // new / re-drawn rows pick up the Trade / Addition lock
            //g.rows.forEach((r, i) => {
            //    const id = 'itemName_' + i; if (!byId(id)) return;                  // column hidden -> nothing to bind
            //    acInst.push(PaginatedAutocomplete({
            //        inputId: id, data: TempAL, startwitfieldname: startwithfield, enablefilterstartwith: autolistfilterwith,//AC.startsWith,
            //        onSelect: item => {
            //            $('#' + id).val(item.name);                                   // show the NAME (library puts the code by default)
            //            var CustID = $("#txtCustomerID").val() != "" ? $("#txtCustomerID").val() : 0;
            //            $("#lblTempABS").text(item.absqty);
            //            loadselectedproductdetail(g, i, item.code, CustID, null, $("#cmbPriceType").val());
            //            G.addRow();
            //            const e = byId('qty_' + i); e && e.focus()                                 // add a new row after selecting an item
            //            return false;
            //        }
            //    }));
            //});
        }

        /* ---- GRID COLUMN SETTINGS -> initial grid ----
           colsettcols (columnsettingscolumns table): { ColumnID, ColumnName, DisplayColumnName, Width, Visible, Permission }
           ColumnName must equal the grid column id (id: '...'). The grid is created with:
             - column ORDER   = ColumnID order of colsettcols (columns missing from colsettcols are appended at the end)
             - header text    = DisplayColumnName
             - width          = Width
             - visibility     = Visible ("0" -> not drawn)  /  Permission ("1" -> never drawn, not in the Columns dialog)
           The factory values (title / width in the code below) are kept in defTitle / defWidth for "Reset to default". */
        const colSettSource = () => typeof colsettcols !== 'undefined' && Array.isArray(colsettcols) ? colsettcols : [];
        const colSettKey = v => String(v == null ? '' : v).toLowerCase();
        function applyColSetting(c, s) {                       // s = settings row of column c (or undefined -> factory defaults)
            const w = s ? parseInt(s.Width, 10) : 0;
            c.title = s && s.DisplayColumnName ? s.DisplayColumnName : c.defTitle;
            c.width = w > 0 ? w : c.defWidth;
            c.forceHidden = !!s && String(s.Permission) === '0';
            c.hidden = c.forceHidden || (!!s && String(s.Visible) === '0')
        }
        function buildGridColumns(defs, settings) {
            const cid = c => colSettKey(c.id || c.title), sc = Array.isArray(settings) ? settings : [];
            const mandatory = defs.filter(c => c.visible === false);            // hid(...) columns: always in the row, never listed
            const shown = defs.filter(c => c.visible !== false);
            shown.forEach(c => { c.defTitle = c.title; c.defWidth = c.width });  // factory defaults
            const ordered = [];
            sc.map((x, i) => ({ x, i })).sort((a, b) => ((+a.x.ColumnID || 0) - (+b.x.ColumnID || 0)) || (a.i - b.i)).forEach(({ x }) => {
                const c = shown.find(k => cid(k) === colSettKey(x.ColumnName));
                if (c && !ordered.includes(c)) ordered.push(c)
            });
            shown.forEach(c => { if (!ordered.includes(c)) ordered.push(c) });   // not in settings -> keep after the others
            ordered.forEach(c => applyColSetting(c, sc.find(x => colSettKey(x.ColumnName) === cid(c))));
            return [...mandatory, ...ordered]
        }

        G = new DynGrid(byId('grid'), {
            calc, onChange: updateSummary, onBeforeRender: acDestroy, onRender: acBind,
            onLock: l => { const b = byId('bAdd'); if (b) b.disabled = l },
            newRow: () => ({
                productID: 0, ApponMRPCum: 0, MRPonTaxAmt: 0, TransPrice: 0, ItemBatchdetail: [], itemName: '', code: '', stock: 0, freestock: 0, dmgstock: 0,
                mrp: 0, hsncode: '', qty: 0, freeqty: 0, dmgqty: 0, uomID: 1, uom: 'PCS', uomCF: 1, reason: 0, locationID: 0,
                taxID: 2, prodPct: 0, prodAmt: 0,
                tradePct: 0, tradeAmt: 0, addPct: 0, addAmt: 0, goods: 0, gross: 0, taxPct: 5, taxAmt: 0, net: 0//, diff: 0
            }),

            columns: buildGridColumns([
                /* mandatory hidden columns: always in every row (calc, validate, getData, save), never drawn, never in the Columns list */
                hid('ProductID', 'productID'), hid('ApponMRPCum', 'ApponMRPCum'), hid('MRPonTax', 'MRPonTaxAmt'), hid('TransPrice', 'TransPrice'), hid('InclDiff', 'Incldiff'), hid('ItemBatchdetail', 'ItemBatchdetail'),
                { id: 'Sno', title: '#', width: 50, controls: [{ type: 'drag' }, { type: 'index' }] },
                {
                    id: 'Actions', title: 'Actions', width: 70, controls: [{
                        type: 'icons', key: 'act', icons: [
                            {
                                name: 'info', html: IC.info, cls: 'blue', title: 'Item info', onClick: r =>
                                    ProductInfoPopup(r.productID || 0)
                            },
                            { name: 'edit', html: IC.edit, title: 'Edit item', onClick: (r, i) => { EditItemBatch(r, i); } },
                            { name: 'cart', html: IC.cart, cls: 'blue', title: 'Add to cart', onClick: r => GetBranchwiseABSQty(r.productID || 0) },
                            { name: 'del', html: IC.del, cls: 'red', title: 'Remove row', onClick: (r, i) => G.deleteRow(i) }]
                    }]
                },
                { id: 'itemName', title: 'Item Name', width: 230, controls: [{ type: 'label', key: 'itemName', ac: true }, { type: 'p', key: 'itemCode', sign: true, text: r => `${r.code} | Qty :  ${r.stock} + ${r.freestock} + ${r.dmgstock}` }] },
                { id: 'mrp', title: 'MRP', width: 80, controls: [{ type: 'label', key: 'mrp', ro: false }] },
                { id: 'qty', title: 'Qty', width: 80, total: 'qty', controls: [numLabel('qty')] },
                { id: 'freeqty', title: 'Free Qty', width: 80, total: 'freeqty', controls: [numLabel('freeqty')] },
                { id: 'dmgqty', title: 'Damage Qty', width: 80, total: 'dmgqty', controls: [numLabel('dmgqty')] },
                {
                    id: 'uomID', title: 'UOM', width: 85, controls: [{
                        type: 'select', key: 'uomID', num: true,   // value = UOM ID, options come from the row's own item UOM list; CF kept in data-cf
                        options: r => uomsOf(r).map(u => ({ v: u.ID, t: u.Name, attrs: { cf: u.ConvRate } }))
                    }]
                },
                { id: 'prodPct', title: 'Prod % / ₹', width: 90, total: 'prodAmt', controls: dual('prod') },
                { id: 'tradePct', title: 'Trade % / ₹', width: 90, total: 'tradeAmt', controls: dual('trade') },
                { id: 'addPct', title: 'Addnl % / ₹', width: 90, total: 'addAmt', controls: dual('add') },
                { id: 'goods', title: 'Goods ₹', width: 90, total: 'goods', controls: [{ type: 'label', key: 'goods' }] },
                { id: 'gross', title: 'Gross ₹', width: 90, total: 'gross', controls: [{ type: 'label', key: 'gross' }] },
                {
                    id: 'taxAmt', title: 'Tax ₹ / %', width: 90, total: 'taxAmt', controls: [{ type: 'label', key: 'taxAmt' },
                    {
                        type: 'select', key: 'taxID', num: true, disabled: true,  // value = ID, text = Name, TaxPern / MRPONTax kept in data-taxpern / data-mrpontax
                        options: gsttax.map(v => ({ v: v.ID, t: v.Name, attrs: { TaxPern: v.TaxPern, MRPONTax: v.MRPONTax } }))
                    }]
                },
                { id: 'net', title: 'Net ₹', width: 95, total: 'net', controls: [{ type: 'label', key: 'net' }] },
                {
                    title: 'Diff', width: 90, total: 'diff', sign: true, controls: [{ type: 'label', key: 'diff', sign: true },
                    {
                        type: 'select', key: 'reason',
                        options: [{ v: '0', t: '-- Reason --' }, ...reasonlist.map(v => ({ v: v.ID, t: v.Name }))]
                    }]
                },               
            ], colSettSource())          // <- initial order / header / width / visibility come from colsettcols
        });

        /* ---- validation (red/green rows) ---- */
        const PCTS = [['prodPct', 'Prod %'], ['tradePct', 'Trade %'], ['addPct', 'Addnl %']];
        function validate() {
            let bad = 0; G.rows.forEach((r, i) => {
                const over = PCTS.filter(([k]) => (+r[k] || 0) > 100).map(([, l]) => l);                  // Prod / Trade / Addnl % must not exceed 100
                const m = !r.itemName ? 'Item name required' : r.qty <= 0 ? 'Qty must be greater than 0' : r.qty > r.stock ? `Qty exceeds stock (${r.stock})` :
                    over.length ? `${over.join(', ')} cannot exceed 100` : '';
                G.setRowStatus(i, m ? 'error' : 'success', m || 'OK'); if (m) bad++
            }); return bad
        }


        function bindInvoice(inv) { byId('invNo').value = inv.invoiceNo; byId('invDate').value = inv.date; byId('customer').value = inv.customer; G.load(inv.items) }

        /* ---- SAVE: collect header + outside fields + ALL grid rows ---- */
        function buildPayload() {
            return {
                date: byId('dtpDate').value, customer: byId('txtCustomerID').value,
                gross: +byId('lblPTGross').value, tax: +byId('lblPTTax').value, roundOff: +byId('txtRoundOff').value, net: +byId('lblRoundNet').value,
                items: G.getData()
            }
        }                                   // items include the hidden columns (productID, Track*YN)

        function saveInvoice() {
            if (validate()) { log('Fix the red rows before saving'); return }
            const payload = buildPayload();
            //byId('out').textContent = JSON.stringify(payload, null, 2);
            //log(`Saved ${payload.items.length} rows`);
            console.log("Grid Row Data ", JSON.stringify(payload, null, 2));
            /* fetch('/api/invoice/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}); */
        }

        /* ---- footer Trade % / Trade Amount: apply to the trade cell of EVERY grid row (recalc + >100 validation happen in calc) ---- */
        /* ---- footer Trade % / Addition %: apply the % to the trade / addnl cell of EVERY grid row,
                then the total of the rows' amounts is assigned to the footer Trade ₹ / Addition ₹ ---- */
        const ftPct = byId('txtTradeDiscPern'), ftAmt = byId('txtTradeDiscAmt');
        const faPct = byId('txtAddnlDiscPern'), faAmt = byId('txtAddnlDiscAmt');
        const sumRows = k => G.rows.reduce((a, r) => a + (+r[k] || 0), 0);
        // base on which the row discount % is applied (same order as calc): goods -> prod -> trade -> addnl
        const tradeBase = () => discBase(G.rows);
        const addBase = () => discBase(G.rows);          // calc applies Addnl % on the same base as Trade % (goods - prod ₹)

        /* % given -> every row's %, rows recalculated, total of the rows' amounts -> footer ₹ field */
        function applyFooterPct(pctEl, pctId, amtId, rowPctKey, rowAmtKey, label) {
            let v = +pctEl.value || 0;
            if (v > 100) { v = 0; pctEl.value = 0; log(label + ' % cannot exceed 100 - value reset to 0') }
            discSrc[DISC.find(d => d.pK === rowPctKey).k] = v !== 0 ? 'footer' : null;
            G.patchAll({ [rowPctKey]: v }, rowPctKey);
            updateInputColumn(amtId, sumRows(rowAmtKey));
            applyDiscLock();
        }
        /* ₹ given -> % = amount / base * 100 -> footer % field -> that % applied to every row (so row amounts add up to the given ₹) */
        function applyFooterAmt(amtEl, pctId, rowPctKey, rowAmtKey, baseFn, label) {
            const amt = +amtEl.value || 0, base = baseFn();
            let pct = base ? amt / base * 100 : (amt > 0 ? 101 : 0);
            if (pct > 100) { pct = 0; amtEl.value = 0; log(label + ' amount cannot exceed the goods amount - value reset to 0') }
            updateInputColumn(pctId, pct);                                // footer % shows the equivalent % (full precision goes to the rows)
            discSrc[DISC.find(d => d.pK === rowPctKey).k] = amt !== 0 ? 'footer' : null;
            G.patchAll({ [rowPctKey]: pct }, rowPctKey);
            applyDiscLock();
        }

        ftPct.oninput = () => applyFooterPct(ftPct, 'txtTradeDiscPern', 'txtTradeDiscAmt', 'tradePct', 'tradeAmt', 'Trade');
        faPct.oninput = () => applyFooterPct(faPct, 'txtAddnlDiscPern', 'txtAddnlDiscAmt', 'addPct', 'addAmt', 'Addition');
        ftAmt.oninput = () => applyFooterAmt(ftAmt, 'txtTradeDiscPern', 'tradePct', 'tradeAmt', tradeBase, 'Trade');
        faAmt.oninput = () => applyFooterAmt(faAmt, 'txtAddnlDiscPern', 'addPct', 'addAmt', addBase, 'Addition');
        // when the ₹ field is left, show the amount actually applied on the rows (row rounding can differ by a paisa)
        ftAmt.addEventListener('change', () => { txtValuechanged = true; updateInputColumn('txtTradeDiscAmt', sumRows('tradeAmt')); applyDiscLock() });
        faAmt.addEventListener('change', () => { txtValuechanged = true; updateInputColumn('txtAddnlDiscAmt', sumRows('addAmt')); applyDiscLock() });
        ftPct.addEventListener('change', () => { txtValuechanged = true; updateInputColumn('txtTradeDiscPern', +ftPct.value || 0); applyDiscLock() });
        faPct.addEventListener('change', () => { txtValuechanged = true; updateInputColumn('txtAddnlDiscPern', +faPct.value || 0); applyDiscLock() });

        byId('bAdd').onclick = () => G.addRow();
        byId('bVal').onclick = () => { const b = validate(); log(b ? b + ' row(s) have errors (hover a red row)' : 'All rows valid') };
        byId('bDb').onclick = () => { bindInvoice(JSON.parse(JSON.stringify(dbInvoice))); log('Grid rebound from saved invoice') };
        byId('bSave').onclick = saveInvoice;
        /* GET: read everything (header + summary + every row incl. hidden columns) and show it in the log (also in the browser console) */
        byId('bGet').onclick = () => {
            const p = buildPayload(), { items, ...head } = p; console.log('GET', p);
            log(`GET -> ${items.length} row(s)\n${JSON.stringify(head)}\n` + items.map(r => JSON.stringify(r)).join('\n'));
        };
        /* ================= COLUMN SETTINGS (header text / width / visible) ================= */
        /* Data source = colsettcols (same structure as the DB table):
           { ColumnID, ColumnName, DisplayColumnName, Width, Visible ("1"/"0"), Permission ("1"/"0") }
           ColumnName must equal the grid column id (id: '...' in the grid columns list).
           Set ColSettingsSaveUrl to your save endpoint: it receives the full array as JSON (same structure). */
        const ColSettingsSaveUrl = Aurl + 'columnsettings/Savetransactioncolumnsettings';          // e.g. Aurl + 'columnsettings/save'
        function saveColumnSettingsToServer(list, done) {
            if (!ColSettingsSaveUrl) { console.warn('ColSettingsSaveUrl not set - settings applied on screen only', list); done(); return }
            const ColumnSettingData = {
                FormID: 5,
                FormType: 3,
                TableID: 1,
                ColumnSettings: list   // rename to match your server-side property name
            };
            $.ajax({
                url: ColSettingsSaveUrl, type: 'post', contentType: 'application/json', data: JSON.stringify(ColumnSettingData),
                xhrFields: { withCredentials: true }, success: () => done(), error: () => alert('Could not save column settings.')
            })
        }
        const ColSettings = (() => {
            const cid = c => c.id || c.title;                                         // ColumnName of a grid column
            const list = () => G.cols.filter(c => c.visible !== false && !c.forceHidden);   // hid(...) and Permission=0 columns are never listed
            /* factory defaults (defTitle / defWidth) were already stored by buildGridColumns when the grid was created */
            let db = colSettSource().map(x => ({ ...x }));
            const find = c => db.find(x => String(x.ColumnName).toLowerCase() === String(cid(c)).toLowerCase());
            const apply = (render = true) => {
                list().forEach(c => applyColSetting(c, find(c)));
                if (render) G.render();
                G.locked && G.setLocked(true)
            };
            let ov;
            const close = () => { if (ov) { ov.remove(); ov = null } };
            function open() {
                close();
                ov = document.createElement('div'); ov.className = 'cs-ov';
                ov.innerHTML = `<div class="cs-box"><div class="cs-hd">Column Settings<span class="cs-x" title="Close">&times;</span></div>
              <div class="cs-bd"><table class="cs-t"><thead><tr><th style="width:55px">Show</th><th>Column</th><th>Header Text</th><th style="width:90px">Width (px)</th></tr></thead><tbody></tbody></table></div>
              <div class="cs-ft"><button class="cs-reset d-none" type="button">Reset to default</button><span style="flex:1"></span><button class="cs-cancel" type="button">Cancel</button><button class="cs-save" type="button">Save</button></div></div>`;
                const tb = ov.querySelector('tbody');
                list().forEach(c => {
                    const s = find(c), tr = document.createElement('tr'); tr.dataset.id = cid(c);
                    const w = s ? parseInt(s.Width, 10) : 0;
                    tr.innerHTML = `<td style="text-align:center"><input type="checkbox" class="cs-v"></td><td class="cs-n"></td><td><input type="text" class="cs-h"></td><td><input type="number" class="cs-w" min="50" max="800"></td>`;
                    tr.querySelector('.cs-n').textContent = c.defTitle;
                    tr.querySelector('.cs-v').checked = s ? String(s.Visible) !== '0' : true;
                    tr.querySelector('.cs-h').value = s && s.DisplayColumnName ? s.DisplayColumnName : c.defTitle;
                    tr.querySelector('.cs-w').value = w > 0 ? w : c.defWidth;
                    tb.append(tr)
                });
                ov.querySelector('.cs-x').onclick = ov.querySelector('.cs-cancel').onclick = close;
                ov.onmousedown = e => { if (e.target === ov) close() };
                ov.querySelector('.cs-reset').onclick = () => tb.querySelectorAll('tr').forEach(tr => {
                    const c = list().find(x => cid(x) === tr.dataset.id);
                    tr.querySelector('.cs-v').checked = true; tr.querySelector('.cs-h').value = c.defTitle; tr.querySelector('.cs-w').value = c.defWidth
                });
                ov.querySelector('.cs-save').onclick = () => {
                    const out = db.map(x => ({ ...x })); let shown = 0;                        // keep every existing DB row (incl. hidden columns)
                    tb.querySelectorAll('tr').forEach(tr => {
                        const id = tr.dataset.id, c = list().find(x => cid(x) === id), v = tr.querySelector('.cs-v').checked;
                        let w = parseInt(tr.querySelector('.cs-w').value, 10); w = isNaN(w) ? c.defWidth : Math.min(800, Math.max(50, w));
                        const row = { ColumnName: id, DisplayColumnName: tr.querySelector('.cs-h').value.trim() || c.defTitle, Width: String(w), Visible: v ? '1' : '0' };
                        const ex = out.find(x => String(x.ColumnName).toLowerCase() === id.toLowerCase());
                        if (ex) Object.assign(ex, row);
                        else out.push({ ColumnID: String(out.reduce((m, x) => Math.max(m, +x.ColumnID || 0), 0) + 1), ...row, Permission: '1' });
                        if (v) shown++
                    });
                    if (!shown) { alert('Select at least one column.'); return }
                    saveColumnSettingsToServer(out, () => {
                        db = out; colsettcols = out;                                             // keep the page-level settings array in sync
                        console.log("colsettcols", out);
                        apply(); close()                                                         // apply to the current grid
                    })
                };
                document.body.append(ov)
            }
            return { open, apply, close }
        })();
        byId('bCols').onclick = e => { e.preventDefault(); ColSettings.open() };
        document.addEventListener('keydown', e => { if (e.key === 'Escape') ColSettings.close() });
        /* grid was already created from colsettcols (buildGridColumns) - no extra apply / re-render needed on page load */

        //bindInvoice(dbInvoice);
    }   // end InitInvoiceGrid
    InitInvoiceGrid();
</script>