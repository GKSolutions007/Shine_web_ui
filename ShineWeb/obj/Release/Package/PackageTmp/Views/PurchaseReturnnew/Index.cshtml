<script title="grid.js">
    async function LoadColumnSettings() {
        colsettcols = await TransactionColumnSettingsData(3, 5, 1, 3);
        //console.log("colsettcols ", colsettcols);
    }
    /* DynGrid - reusable editable grid. No dependencies. */
    const f = (v, d) => (+v || 0).toFixed(d), rnd = v => Math.round((v + Number.EPSILON) * 1e4) / 1e4;
    const svg = p => `<svg viewBox="0 0 24 24">${p}</svg>`;
    const IC = {
        info: svg('<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>'), edit: svg('<path d="M4 20h4L19 9l-4-4L4 16z"/>'),
        del: svg('<circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/>'), cart: svg('<circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M3 4h3l2.5 11h9L20 8H7"/>'),
        up: svg('<path d="M6 15l6-6 6 6"/>'), down: svg('<path d="M6 9l6 6 6-6"/>')
    };

    class DynGrid {
        /* cfg: { columns, newRow():obj, calc(row,changedKey), onChange(allRowsArray) } */
        constructor(el, cfg) { this.el = el; this.cfg = cfg; this.cols = cfg.columns; this.rows = []; this.dragFrom = null; this.locked = false; this.render(); this.el.addEventListener('keydown', e => this.onKey(e)) }

        /* ---- data binding ---- */
        load(data, recalc = true) {
            const def = this.cfg.newRow(), low = {}; Object.keys(def).forEach(k => low[k.toLowerCase()] = k);
            this.rows = data.map(src => {
                const d = {}; Object.keys(src).forEach(k => d[low[k.toLowerCase()] || k] = src[k]);          // ProductID / productId / productID -> productID, UOM -> uom ...
                const r = { ...def, ...d };                                                                // every column key (incl. hidden ones) always exists
                Object.keys(def).forEach(k => { if (typeof def[k] === 'number') r[k] = +r[k] || 0 });          // "12.0000" -> 12 (server often sends numbers as text)
                if (recalc && this.cfg.calc) this.cfg.calc(r, 'load', d); return r
            });   // 3rd arg = row exactly as supplied (calc can tell supplied vs default values)
            this.render(); this.fire()
        }
        getData() { return this.rows.map((r, i) => { const o = { slNo: i + 1 }; Object.keys(r).forEach(k => { if (k[0] !== '_') o[k] = r[k] }); return o }) }   // keys starting with _ (e.g. _st, _uoms) are internal, never returned   // ALL rows, in current order (use this on Save)
        fire() { if (this.cfg.onChange) this.cfg.onChange(this.getData()) }      // notifies outside fields
        /* remove ALL rows, refresh the grid (footer shows "Total: 0") and notify outside fields once */
        clearAllRows() {
            this.rows = [];
            this.dragFrom = null;
            this.render();
            this.fire()
        }
        /* ---- row operations ---- */
        addRow(d) {
            this.rows.push({ ...this.cfg.newRow(), ...d });
            this.render();
            this.fire()
        }
        /* update several fields of row i at once, then recalc + refresh (used by autocomplete item pick) */
        patch(i, data, key) { const r = this.rows[i]; if (!r) return; Object.assign(r, data); this.changed(r, key || 'patch') }
        /* apply the same values to EVERY row, recalc each row with calc(row,key), refresh all cells / footer once, notify once */
        patchAll(data, key) {
            this.rows.forEach(r => { Object.assign(r, data); if (this.cfg.calc) this.cfg.calc(r, key || 'patch') });
            this.rows.forEach((r, ri) => this.tb.children[ri].querySelectorAll('[data-key]').forEach(el => this.upd(el, r)));
            this.footer(); this.fire()
        }
        deleteRow(i) { this.rows.splice(i, 1); this.render(); this.fire() }
        moveTo(from, to) { if (from === to || to < 0 || to >= this.rows.length) return; const [x] = this.rows.splice(from, 1); this.rows.splice(to, 0, x); this.render(); this.fire() }
        moveRow(i, d) { this.moveTo(i, i + d) }
        setRowStatus(i, type, msg) { this.rows[i]._st = type ? { type, msg } : null; const tr = this.tb.children[i], s = this.rows[i]._st; tr.className = s ? 'row-' + s.type : ''; tr.title = s ? s.msg : '' }

        /* ---- keyboard navigation: Enter / Shift+Enter = next / previous field, Up / Down = same field in row above / below ---- */
        focusables(root) { return [...root.querySelectorAll('input,select')].filter(x => !x.readOnly && !x.disabled && x.type !== 'hidden' && x.offsetParent !== null) }
        go(n) { n.focus(); if (n.type !== 'checkbox' && n.select) try { n.select() } catch (_) { } n.scrollIntoView({ block: 'nearest', inline: 'nearest' }) }
        onKey(e) {
            const el = e.target, k = e.key; if (!el.matches || !el.matches('input,select') || !this.tb.contains(el)) return;
            // if(k==='Enter'){
            //   e.preventDefault();
            //   const all=this.focusables(this.tb),n=all[all.indexOf(el)+(e.shiftKey?-1:1)];
            //   if(n)this.go(n)
            //   }
            if (k == 'F4') {
                if ($("#txtVendorID").val() != "") {
                    modalPinfo.show();
                    var productID = el.closest('tr').querySelector('[data-key="productID"]').value;
                    GetData(14, $("#txtVendorID").val(), productID)
                }
                else {
                    showErrorSnackbar("Select Vendor");
                }
            }
            if (k === 'F8') {
                if (el.dataset.key === 'itemName') {
                    var productID = el.closest('tr').querySelector('[data-key="productID"]').value;
                    F8ItemID = e.target.id;
                    var dtros = el.closest('tr')
                    F8RowIndex = dtros.dataset.ri
                    let vw = window.innerWidth;
                    let vh = window.innerHeight;
                    const hasPermission = productID == 0
                        ? checkAddEditPermission("111")
                        : checkAddEditPermission("112");
                    if (hasPermission) {

                        var ProdUrl = Url + "ProductMaster?name=dFLU9MS0CpfVS5wW5G17EQ%3D%3D&strFormID=RjZMX%2BX6NiPSRFI2WDoZJA%3D%3D&TypeID=BOII5FUynjpl5RZJJ8nW1g==&TranID=jJOtHsRVwYECOhoiBc69dA%3D%3D&ID=" + productID;
                        window.open(ProdUrl, "_blank", "width=" + vw + ",height=" + vh + ",scrollbars=yes,resizable=yes");
                    }
                    else {
                        showErrorSnackbar("You don't have pemission for &ensp;<h4><code>" + (productID == 0 ? "Add" : "Edit") + " Product</code></h4>")
                    }
                }
            }
            if (e.altKey && (e.key == 'a')) {
                if (el.dataset.key === 'itemName') {
                    startwithfield = (startwithfield == "code" ? "name" : startwithfield == "search" ? "code" : "search");
                    showInfoSnackbar("Search field changed to&ensp; <h4><code>'" + startwithfield + "'</code></h4>");
                    ReLoadProductAutolists();
                }
            }
            if (e.altKey && (e.key == 's')) {
                if (el.dataset.key === 'itemName') {
                    var infomessage = "Search mode changed to&ensp;" + (autolistfilterwith ? "<h4><code>Contains </code></h4>" : "<h4><code>Start with</code></h4>");
                    autolistfilterwith = !autolistfilterwith;
                    showInfoSnackbar(infomessage);
                    ReLoadProductAutolists();
                }
            }
            if (k === 'Enter') {
                e.preventDefault();
                if (!e.shiftKey && el.dataset.key === 'qty') {                       // Enter on Qty -> Item Name of the NEXT row
                    const tr = el.closest('tr'), nx = tr.nextElementSibling;
                    if (nx) { const n = nx.querySelector('[data-key="itemName"]') || this.focusables(nx)[0]; if (n) this.go(n) }
                    else { this.addRow(); const n = this.tb.lastElementChild.querySelector('[data-key="itemName"]'); if (n) this.go(n) }
                    return;
                }
                if (!e.shiftKey && el.dataset.key === 'itemName') {                       // Enter on Qty -> Item Name of the NEXT row
                    var productID = el.closest('tr').querySelector('[data-key="productID"]').value;
                    if (productID == 0) {
                        const firstInput = $("#dvFooterRow")
                            .find("input")
                            .filter(function () {
                                return $(this).is(":visible") &&
                                    !this.disabled &&
                                    !this.readOnly;
                            }).first();

                        if (firstInput.length) {
                            firstInput.focus();
                        }
                    }
                    else {
                        const all = this.focusables(this.tb), n = all[all.indexOf(el) + (e.shiftKey ? -1 : 1)];   // any other field -> next (Shift = previous)
                        if (n) this.go(n)
                    }
                    return;
                }
                const all = this.focusables(this.tb), n = all[all.indexOf(el) + (e.shiftKey ? -1 : 1)];   // any other field -> next (Shift = previous)
                if (n) this.go(n)
            }
            else if ((k === 'ArrowUp' || k === 'ArrowDown') && !e.altKey && !el.dataset.ac) {          // Alt+Down still opens a select list; autocomplete fields keep Up/Down for their own list
                if (el.type === 'number') e.preventDefault();                                          // never increment/decrement the number (even on first/last row)
                const td = el.closest('td'), tr = td.parentElement, pos = this.focusables(td).indexOf(el);
                const tr2 = k === 'ArrowUp' ? tr.previousElementSibling : tr.nextElementSibling; if (!tr2) return;
                e.preventDefault(); const fs = this.focusables(tr2.children[td.cellIndex]); if (fs.length) this.go(fs[Math.min(pos, fs.length - 1)])
            }
        }

        /* ---- rendering ---- */
        render() {
            if (this.cfg.onBeforeRender) this.cfg.onBeforeRender(this);   // e.g. destroy old autocomplete instances
            const vis = this.vis = this.cols.filter(c => !c.hidden && c.visible !== false), W = vis.reduce((s, c) => s + c.width, 0);
            this.el.innerHTML = `<table class="g" style="width:${W}px"><colgroup>${vis.map(c => `<col style="width:${c.width}px">`).join('')}</colgroup>
  <thead><tr>${vis.map((c, i) => `<th>${c.title}<span class="rz" data-i="${i}"></span></th>`).join('')}</tr></thead><tbody></tbody><tfoot><tr></tr></tfoot></table>`;
            this.tb = this.el.querySelector('tbody'); this.ft = this.el.querySelector('tfoot tr');
            this.rows.forEach((r, ri) => this.tb.append(this.buildRow(r, ri))); this.footer();
            this.el.querySelectorAll('.rz').forEach(h => h.onpointerdown = e => {
                e.preventDefault();
                const c = vis[+h.dataset.i], x0 = e.clientX, w0 = c.width, col = this.el.querySelectorAll('col')[h.dataset.i], t = this.el.querySelector('table');
                const mv = m => { c.width = Math.max(50, w0 + m.clientX - x0); col.style.width = c.width + 'px'; t.style.width = vis.reduce((s, k) => s + k.width, 0) + 'px' };
                const up = () => { removeEventListener('pointermove', mv); removeEventListener('pointerup', up) };
                addEventListener('pointermove', mv); addEventListener('pointerup', up)
            });
            if (this.cfg.onRender) this.cfg.onRender(this);               // e.g. bind autocomplete to every row's item field
        }
        buildRow(r, ri) {
            const tr = document.createElement('tr'); tr.dataset.ri = ri;
            this.vis.forEach(c => { const td = document.createElement('td'); c.controls.forEach(s => td.append(this.control(s, r, ri))); tr.append(td) });
            /* mandatory hidden columns (visible:false): no column / header / checkbox entry, but each value lives in a real
               <input type=hidden id=key_row name=key[row]> inside the row, always kept in sync with the row data */
            if (tr.firstChild) this.cols.filter(c => c.visible === false).forEach(c => c.controls.forEach(s => tr.firstChild.append(this.control({ ...s, type: 'hidden' }, r, ri))));
            tr.querySelectorAll('[data-key]').forEach(el => this.upd(el, r));
            if (r._st) { tr.className = 'row-' + r._st.type; tr.title = r._st.msg }
            /* ---- mouse drag & drop row reorder (drag the ⠿ handle) ---- */
            const side = e => { const b = tr.getBoundingClientRect(); return e.clientY < b.top + b.height / 2 };
            tr.ondragstart = e => { this.dragFrom = this.rows.indexOf(r); e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', '' + this.dragFrom); tr.classList.add('dragging') };
            tr.ondragover = e => {
                if (this.dragFrom == null) return; e.preventDefault(); this.clearDrop(); tr.classList.add(side(e) ? 'drop-before' : 'drop-after');
                if (e.clientY < 80) scrollBy(0, -15); else if (innerHeight - e.clientY < 80) scrollBy(0, 15)
            };
            tr.ondrop = e => {
                e.preventDefault(); const f0 = this.dragFrom; this.dragFrom = null; if (f0 == null) return;
                let t = this.rows.indexOf(r) + (side(e) ? 0 : 1); if (f0 < t) t--; this.moveTo(f0, t)
            };
            tr.ondragend = () => { this.dragFrom = null; tr.draggable = false; this.clearDrop(); tr.classList.remove('dragging') };
            if (this.locked) this.applyLock(tr);
            return tr;
        }
        /* ---- lock / unlock: disables every field inside the grid rows (inputs, selects, drag handle, remove icon) ---- */
        applyLock(tr) {
            const L = this.locked;
            tr.querySelectorAll('input,select,textarea').forEach(x => x.disabled = L);
            tr.querySelectorAll('.gc-drag,[id^="act_del_"]').forEach(x => { x.style.pointerEvents = L ? 'none' : ''; x.style.opacity = L ? '.4' : '' });
            if (L) tr.draggable = false;
        }
        setLocked(v) {
            this.locked = !!v;
            if (this.tb) [...this.tb.children].forEach(tr => this.applyLock(tr));
            if (this.cfg.onLock) this.cfg.onLock(this.locked)
        }
        clearDrop() { this.tb.querySelectorAll('.drop-before,.drop-after').forEach(x => x.classList.remove('drop-before', 'drop-after')) }

        /* every control gets id=key_rowIndex  name=key[rowIndex]  class="gc gc-type gc-key" */
        control(s, r, ri) {
            const key = s.key || s.type, id = `${key}_${ri}`, name = `${key}[${ri}]`, cls = `gc gc-${s.type} gc-${key} ${s.cls || ''}`; let el;
            switch (s.type) {
                case 'index': case 'label': el = document.createElement('span'); break;
                case 'p': el = document.createElement('p'); break;
                case 'drag': el = document.createElement('span'); el.id = id; el.className = cls; el.textContent = '⠿'; el.title = 'Drag to reorder';
                    el.onmousedown = e => e.target.closest('tr').draggable = true;
                    el.onmouseup = e => e.target.closest('tr').draggable = false; return el;
                case 'icons': el = document.createElement('div'); el.id = id; el.className = cls;
                    s.icons.forEach(ic => {
                        const i = document.createElement('i'); i.className = 'gi ' + (ic.cls || ''); i.id = `${key}_${ic.name}_${ri}`; i.title = ic.title || ic.name;
                        i.innerHTML = ic.html || ''; i.onclick = e => ic.onClick(r, this.rows.indexOf(r), e); el.append(i)
                    }); return el;
                case 'select': el = document.createElement('select'); this.fillSelect(el, s, r); el.disabled = s.disabled; break;
                default: el = document.createElement('input'); el.type = s.type;
            }
            el.id = id; el.setAttribute('name', name);
            el.className = cls + (s.ro ? ' ro' : '');
            el.dataset.key = s.key || '';
            if (s.ac) { el.dataset.ac = '1'; el.autocomplete = 'off' }                // autocomplete field: no browser suggestions, arrows belong to the list
            el._s = s;
            const k = s.key, ch = () => this.changed(r, k);
            if (s.type === 'number') {
                el.step = 'any'; if (s.readonly) el.readOnly = true;
                if (s.key == "hsncode") {
                    el.maxlength = 8;
                }
                el.onfocus = () => {

                    el.value = s.key == "hsncode" ? r[k] : f(r[k], 4);
                    el.select()
                };                         // focus: 4 decimals
                if (!s.allowNeg) el.min = 0;                                                       // grid numbers cannot be negative (set allowNeg:true on a column to opt out)
                el.oninput = () => {
                    if (!s.allowNeg && parseFloat(el.value) < 0) { el.value = 0; el.select() }     // negative typed/pasted -> 0
                    r[k] = parseFloat(el.value) || 0; ch()
                };
                el.onblur = () => { el.value = s.key == "hsncode" ? r[k] : f(r[k], s.dec ?? 2); el.dataset.full = s.key == "hsncode" ? r[k] : f(r[k], 4); };     // blur: 2 decimals
            } else if (s.type === 'text') { el.onfocus = () => el.select(); el.oninput = () => { r[k] = el.value; ch() } }
            else if (s.type === 'checkbox') el.onchange = () => { r[k] = el.checked; ch() };
            else if (s.type === 'select') el.onchange = () => { r[k] = s.num ? +el.value : el.value; ch() };
            if (s.prefix) { const w = document.createElement('div'); w.className = 'gw'; w.innerHTML = `<b>${s.prefix}</b>`; w.append(el); return w }
            return el;
        }
        /* (re)build <option>s of a select. s.options = array OR function(row)->array of {v,t,attrs:{name:value}}.
           attrs are written as data-<name> attributes on the <option> (e.g. data-cf, data-taxpern, data-mrpontax).
           Rebuilds only when the option list really changed. Returns true when rebuilt. */
        fillSelect(el, s, r) {
            const list = typeof s.options === 'function' ? s.options(r) : s.options, sig = JSON.stringify(list);
            if (el._sig === sig) return false;
            el.innerHTML = '';
            list.forEach(o => {
                const op = new Option(o.t ?? o, o.v ?? o);
                Object.entries(o.attrs || {}).forEach(([a, v]) => op.setAttribute('data-' + a.toLowerCase(), v)); el.add(op)
            });
            el._sig = sig; return true;
        }
        upd(el, r) {
            const s = el._s, v = r[s.key];
            if (s.type === 'number') {
                const act = el === document.activeElement;
                if (!act) el.value = s.key == "hsncode" ? v : f(v, s.dec ?? 2);
                else if (Math.abs((parseFloat(el.value) || 0) - (+v || 0)) > 1e-9) { el.value = f(v, 4); el.select() }   // focused field whose value was changed by calc (e.g. % reset to 0) -> show it
                el.dataset.full = s.key == "hsncode" ? v : f(v, 4);
                el.title = s.key == "hsncode" ? v : f(v, 4);
                if (s.key == "hsncode") {
                    el.maxlength = 8;
                }
                if (s.max != null) { const bad = (+v || 0) > s.max; el.classList.toggle('bad', bad); el.title = bad ? `Cannot exceed ${s.max}` : '' }
            }   // live flag when value > max
            else if (s.type === 'label') el.textContent = typeof v === 'number' ? f(v, s.dec ?? 2) : v;
            else if (s.type === 'index') el.textContent = this.rows.indexOf(r) + 1;
            else if (s.type === 'p') {
                el.textContent = s.text(r);
                if (s.key == "itemCode")
                    el.style.color = (parseFloat(r.stock) > 0 || parseFloat(r.freestock) > 0 || parseFloat(r.dmgstock) > 0) ? 'green' : 'red';
            }
            else if (s.type === 'checkbox') el.checked = !!v;
            else if (s.type === 'select') { const rb = this.fillSelect(el, s, r); if (rb || el !== document.activeElement) el.value = v ?? '' }   // options may change per row (item UOM list)
            else if (el !== document.activeElement) el.value = v ?? '';
            if (s.key == "diff") {
                const c = s.style ? s.style(v, r) : s.sign ? { color: v > 0 ? 'var(--pos)' : v < 0 ? 'var(--neg)' : '' } : null;
                el.style.color = (c && c.color) || ''; el.style.background = (c && c.bg) || '';
            }
        }
        changed(r, key) {
            if (this.cfg.calc) this.cfg.calc(r, key);
            const ri = this.rows.indexOf(r); this.tb.children[ri].querySelectorAll('[data-key]').forEach(el => this.upd(el, r));
            this.footer(); this.fire();
        }
        footer() {
            this.ft.innerHTML = '';
            this.vis.forEach((c, i) => {
                if (i === 1 && this.ft.firstChild && this.ft.firstChild.colSpan === 2) return;     // covered by the first cell's colspan
                const td = document.createElement('td');
                if (i === 0) {
                    td.textContent = 'Total: ' + this.rows.length; td.style.textAlign = 'left'; if (this.vis[1] && !this.vis[1].total) td.colSpan = 2
                }
                else if (c.total) {
                    const t = this.rows.reduce((s, r) => s + (+r[c.total] || 0), 0); td.textContent = f(t, 2);
                    if (c.sign) td.style.color = t > 0 ? 'var(--pos)' : t < 0 ? 'var(--neg)' : ''
                }
                this.ft.append(td)
            });
        }
    }

