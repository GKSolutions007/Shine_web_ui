                    updateInputColumn(fieldID, damt);
                    //$(this).val(damt);
                    //setTagValue(fieldID, fieldName, damt);
                    Tradediscamt = damt;
                }
                if (fieldName == "TradeDiscPern") {
                    $(this).prop("disabled", value > 0 ? true : false);
                    updateInputColumn(fieldID, value);
                    //$(this).val(parseFloat(value)).toFixed(DecVal));
                    //setTagValue(fieldID, fieldName, value);
                }
            });
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "ProdDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Proddiscamt = parseFloat(fullValue);//$(this).val()
                }
                if (fieldName == "TradeDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Tradediscamt = parseFloat(fullValue);
                }
                if (fieldName == "AddnlDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Addnldiscamt = parseFloat(fullValue);
                }
