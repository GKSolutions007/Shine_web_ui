@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
@*<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />*@
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/datatable/1.13.6/dataTables.bootstrap5.min.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />
<script src="~/Scripts/jquery-1.11.1.min.js"></script>
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/datatable.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<script src="~/Scripts/js/mrptaxcall.js"></script>
@*<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>*@
<script src="~/Scripts/qrcode.min.js"></script>
<script src="~/Autocomplete/GKBSautocomplete.js"></script>
<header><link rel="stylesheet" href="~/Content/index.css"></header>
<style>

    /* ===================================================
    INVOICE FORM — CONSOLIDATED STYLES
    =================================================== */

    /* --- Reset & Base --- */
    hr {
        margin: .5rem 0;
        border: 0;
        border-top: 1px solid rgba(0,0,0,.1);
    }

    td {
        font-size: 11px;
    }

    th, td {
        white-space: nowrap;
    }

    input[type=number] {
        text-align: right;
        -moz-appearance: textfield;
    }

        input[type=number]::placeholder {
            text-align: left;
        }

    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* --- Compact form controls --- */
    .form-control, select.form-control, input.form-control,
    textarea.form-control, .gdInput, select.gdInput, input.gdInput {
        padding: 3px 7px !important;
        font-size: 12px !important;
        height: 28px !important;
        line-height: 1.4 !important;
    }

    textarea.form-control {
        height: auto !important;
        min-height: 56px !important;
    }

    select.form-control {
        padding-right: 18px !important;
    }

    .input-group-addon {
        padding: 3px 7px !important;
        font-size: 12px !important;
    }

    /* --- Floating label --- */
    .form-label {
        position: relative;
        display: block;
        clear: both;
        margin: 0 auto;
    }

    .labelup {
        position: absolute;
        top: -50%;
        left: 1em;
        transform: translateY(50%);
        transition: all .2s ease-in-out;
        background: #fff;
        color: #2b2828;
        font-size: .82em;
        font-weight: 600;
        letter-spacing: .5px;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    .labelupfortextarea {
        position: absolute;
        top: -22%;
        left: 1em;
        transform: translateY(50%);
        transition: all .2s ease-in-out;
        background: #fff;
        color: #2b2828;
        font-size: .88em;
        font-weight: 600;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    /* --- Datatable inputs --- */
    .gdInput {
        width: 100%;
        border-width: 0 0 .1px 0;
        border-color: #e0d6d6;
    }

    .gdInputPMAccNo {
        width: 92%;
        border-width: 0 0 .1px 0;
        border-color: #e0d6d6;
    }

    div.dataTables_wrapper {
        width: 100%;
        margin: 0 auto;
    }

    #tblProductInfo td {
        font-size: 9px;
    }

    /* --- Loader --- */
    .loader, .loader:after {
        border-radius: 50%;
        width: 10em;
        height: 10em;
    }

    .loader {
        margin: 60px auto;
        font-size: 10px;
        text-indent: -9999em;
        border-top: 1.1em solid rgba(255,255,255,.2);
        border-right: 1.1em solid rgba(255,255,255,.2);
        border-bottom: 1.1em solid rgba(255,255,255,.2);
        border-left: 1.1em solid #fff;
        transform: translateZ(0);
        animation: load8 2.1s infinite linear;
    }

    @@keyframes load8 {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    #loadingDiv {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 150%;
        opacity: .9;
        background-color: #C7E1BA;
    }

    .LoaderMsg {
        font-size: 20px;
        text-align: center;
    }

    /* --- Drag & schema --- */
    tr.dragging {
        opacity: .5;
    }

    th.dragging-col {
        opacity: .5;
    }

    .clsSchema {
        cursor: pointer;
    }

    .trtext-line {
        border: none;
        border-bottom: 1px #000;
    }

    /* --- Status badges --- */
    .status-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        transition: all .25s;
    }

    .status-paid {
        background: linear-gradient(135deg,#10b981,#059669);
        color: #fff;
    }

    .status-unpaid {
        background: linear-gradient(135deg,#ef4444,#dc2626);
        color: #fff;
    }

    .status-partial {
        background: linear-gradient(135deg,#f59e0b,#d97706);
        color: #fff;
    }

    .status-badge:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 8px rgba(0,0,0,.15);
    }

    /* --- Summary boxes --- */
    .summary-box {
        display: inline-block;
        min-width: 100px;
        padding: 12px 18px;
        border-radius: 8px;
        margin: 4px;
        text-align: center;
        vertical-align: middle;
        position: relative;
        overflow: hidden;
        transition: all .3s cubic-bezier(.4,0,.2,1);
    }

        .summary-box::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg,rgba(255,255,255,.4),transparent);
            opacity: 0;
            transition: opacity .3s;
        }

        .summary-box:hover::before {
            opacity: 1;
        }

        .summary-box:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0,0,0,.12);
        }

    .bg-paid {
        background: linear-gradient(135deg,#a8e6cf,#88d8a0);
    }

    .bg-unpaid {
        background: linear-gradient(135deg,#b3d9ff,#8fc7ff);
    }

    .bg-total {
        background: linear-gradient(135deg,#ffe066,#ffcc33);
    }

    .summary-label {
        font-size: 12px;
        color: #333;
        font-weight: 500;
        margin-bottom: 4px;
    }

    .summary-value {
        font-size: 13px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .summary-symbol {
        font-size: 18px;
        font-weight: 700;
        margin: 0 6px;
        display: inline-block;
        vertical-align: middle;
    }

    /* --- Badges --- */
    .badge {
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
    }

        .badge.success {
            background: #d1fae5;
            color: #065f46;
        }

        .badge.warning {
            background: #fef3c7;
            color: #92400e;
        }

        .badge.danger {
            background: #fee2e2;
            color: #991b1b;
        }

    .badge-label {
        font-size: 11px;
        font-weight: 600;
        color: #065f46;
        background-color: #d1fae5;
        padding: 4px 10px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    /* --- New item button --- */
    .clsnewitem {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 5px;
        font-size: 12px;
        font-weight: 500;
        color: #0C447C;
        background: #E6F1FB;
        border: .5px solid #85B7EB;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s, transform .1s;
    }

        .clsnewitem:hover {
            background: #B5D4F4;
            transform: scale(1.04);
        }

    /* --- Button enhancements --- */


    /* --- Toggle radio tabs (document list) --- */
    .toggle {
        display: flex;
        flex-wrap: wrap;
        gap: 2px;
    }

        .toggle label {
            transition: all .25s;
            padding: 5px 12px;
            border-radius: 5px;
            font-size: 12px;
            cursor: pointer;
        }

            .toggle label:hover {
                background: #f0f9ff;
                transform: translateY(-1px);
            }

        .toggle input[type="radio"] {
            display: none;
        }

            .toggle input[type="radio"]:checked + label {
                background: linear-gradient(135deg,#1a5fa8,#2176d9);
                color: #fff;
                font-weight: 600;
            }

    /* --- Selected row --- */
    .rowselected {
        background-color: #daf6fb !important;
    }

    /* ===================================================
    COLLAPSIBLE SECTION CARDS
    =================================================== */
    .inv-section-card {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        margin-bottom: 6px;
        overflow: hidden;
    }

    .inv-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 12px;
        background: #f8f9fa;
        cursor: pointer;
        user-select: none;
        border-bottom: 1px solid transparent;
        transition: background .2s;
    }

        .inv-section-header:hover {
            background: #e9ecef;
        }

        .inv-section-header.is-open {
            border-bottom-color: #dee2e6;
            background: #eef4fb;
        }

    .inv-section-title {
        font-size: 12px;
        font-weight: 600;
        color: #185FA5;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .inv-section-title .sec-icon {
            font-size: 13px;
        }

    .inv-section-toggle {
        font-size: 11px;
        color: #6c757d;
        transition: transform .25s;
        flex-shrink: 0;
    }

    .inv-section-header.is-open .inv-section-toggle {
        transform: rotate(180deg);
    }

    .inv-section-body {
        padding: 10px 12px;
        background: #fff;
        animation: sectionFadeIn .2s ease-out;
    }

    @@keyframes sectionFadeIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===================================================
    INV TABS (E-Way / E-Inv)
    =================================================== */
    .inv-tab-btn {
        display: inline-flex;
        align-items: center;
        padding: 0 5px;
        font-size: 11.5px;
        font-weight: 500;
        color: #666;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        white-space: nowrap;
        transition: color .18s, border-color .18s, background .18s;
        margin-bottom: -1.5px;
    }

        .inv-tab-btn:hover {
            color: #222;
            background: #f5f5f5;
        }

        .inv-tab-btn.active {
            color: #185FA5;
            border-bottom-color: #185FA5;
        }

    .inv-tab-panel {
        opacity: 0;
        transform: translateY(5px);
        transition: opacity .2s, transform .2s;
    }

        .inv-tab-panel.active {
            opacity: 1;
            transform: translateY(0);
            color: black;
        }

    .ewicircle {
        width: 5px;
        height: 5px;
        background: green;
        border-radius: 50%;
        animation: ewiblink 1s infinite;
        padding: 5px;
        display: none;
    }

    @@keyframes ewiblink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .2;
        }
    }

    /* ===================================================
    FOOTER ACTIONS
    =================================================== */
    .footerAction {
        position: fixed;
        right: 0;
        bottom: 0;
        width: 85%;
        background: #f8f9fa;
        border-top: 1px solid #dee2e6;
        z-index: 100;
        /*padding: 6px 12px;*/
    }

    @@media (max-width: 767px) {
        .footerAction {
            width: 100%;
        }
    }


    /* ===================================================
    MODALS — unified responsive sizing
    =================================================== */
    .modalBatch {
        display: none;
        position: fixed;
        z-index: 1000;
        top: 65%;
        right: 0;
        bottom: 0;
        overflow: auto;
    }

    @@media (min-width: 1000px) {
        .modalBatch {
            width: 30%;
        }
    }

    @@media (min-width: 801px) and (max-width: 999px) {
        .modalBatch {
            width: 45%;
        }
    }

    @@media (max-width: 800px) {
        .modalBatch {
            width: 60%;
        }
    }

    .modalBatch-content, .modalProdInfo-content,
    .modalPaymode-content, .modalCreditLimPassword-content,
    .modalSchema-content, .modalEway-content, .modaliframePreview-content {
        background: #fff;
        padding: 8px;
        border: 1px solid #888;
        overflow: auto;
    }

    @@media (min-width: 600px) {
        .modalBatch-content {
            margin: auto;
            width: 95%;
        }

        .modalProdInfo-content {
            margin: 3% auto;
            width: 75%;
            height: 70%;
        }

        .modalPaymode-content {
            margin: 3% auto;
            width: 75%;
            height: 70%;
        }

        .modalCreditLimPassword-content {
            margin: 3% auto;
            width: 60%;
            height: 70%;
        }

        .modalSchema-content {
            margin: 3% auto;
            width: 45%;
            height: 70%;
        }

        .modalEway-content {
            margin: 3% auto;
            width: 25%;
            height: 70%;
        }

        .modaliframePreview-content {
            margin: auto;
            width: 70%;
            height: 100%;
        }
    }

    @@media (max-width: 599px) {
        .modalBatch-content, .modalProdInfo-content,
        .modalPaymode-content, .modalCreditLimPassword-content,
        .modalSchema-content, .modalEway-content,
        .modaliframePreview-content {
            margin: 10% auto;
            width: 95%;
        }
    }

    .modalBatch {
        position: fixed !important;
    }

    .modal-close-btn {
        position: absolute;
        top: -5px;
        right: 0;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-size: 16px;
        cursor: pointer;
        z-index: 11000;
    }

    #tblBatch tbody {
        min-height: 100px;
    }

    /* modaliframePreview backdrop */
    .modaliframePreview {
        display: none;
        position: fixed;
        z-index: 10;
        top: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
    }

    iframe#iframepreview {
        width: 100%;
        height: 450px;
        border: none;
        background: #fff;
        display: block;
    }

    /* Prod info panel fixed */
    .clsProd {
        position: fixed;
        right: 1%;
        bottom: 8%;
        width: 30%;
        height: 45%;
        color: black;
        background: #c2f6b5;
        z-index: 1000;
    }

    /* ===================================================
    ANIMATIONS
    =================================================== */
    @@keyframes fadeInSection {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in-section {
        animation: fadeInSection .5s ease-out;
    }

    @@keyframes slideInLeft {
        from {
            opacity: 0;
            transform: translateX(-24px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .animate-slide-left {
        animation: slideInLeft .4s ease-out;
    }

    .stagger-delay-1 {
        animation-delay: .08s;
    }

    .stagger-delay-2 {
        animation-delay: .18s;
    }

    .stagger-delay-3 {
        animation-delay: .28s;
    }

    /* ===================================================
    RESPONSIVE HELPERS
    =================================================== */
    .textforabv800, .textforblw800 {
        display: none;
    }

    @@media (min-width: 800px) {
        .textforabv800 {
            display: inline;
        }
    }

    @@media (max-width: 799px) {
        .textforblw800 {
            display: inline;
        }
    }

    /* Mobile: stack footer buttons */
    @@media (max-width: 575px) {
        .footerAction .btn {
            padding: 4px 7px;
            font-size: 11px;
            margin: 1px;
        }

        .inv-section-body {
            padding: 8px;
        }
    }

    table.dataTable > tbody > tr > th, table.dataTable > tbody > tr > td {
        padding: 2px 10px !important;
    }
</style>
<body>
    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.Variant, new { @autocomplete = "off", @class = "form-control", @id = "txtVariantID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.Cancel, new { @autocomplete = "off", @class = "form-control", @id = "txtCancelID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.EnableReturnPrice, new { @autocomplete = "off", @class = "form-control", @id = "txtReurnPricePerm" })
    @Html.HiddenFor(model => model.EnableSave, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableSaveButton" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtTransType" })
    @Html.HiddenFor(model => model.EnablePriceEditInTransaction, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtPriceEditInTransaction" })
    @Html.HiddenFor(model => model.DraftModify, new { @autocomplete = "off", @class = "form-control", @id = "txtDraftModifyID" })
    @Html.HiddenFor(model => model.DraftCancel, new { @autocomplete = "off", @class = "form-control", @id = "txtDraftCancelID" })
    @Html.HiddenFor(model => model.EnablePaid, new { @autocomplete = "off", @class = "form-control", @id = "txtEnablePaid" })
    <input hidden id="txtCustomerID" /><input hidden class="FormclrField" id="txtDraftID" />
    <input hidden id="txtBAdd1" /><input hidden id="txtBAdd2" /><input hidden id="txtBAdd3" />
    <input hidden id="txtSAdd1" /><input hidden id="txtSAdd2" /><input hidden id="txtSAdd3" />
    <input hidden id="txtPincode" /><input hidden id="txtStatus" /><input hidden id="txtCustomerScheme" class="FormclrField" />

    <!-- Page Title -->
    <div class="d-flex align-items-center gap-2">
        <h4 class="mb-0" style="font-size:14px;padding-top:8px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>

    <!-- =============================================
         DOCUMENT LIST VIEW
    ============================================= -->
    <div id="dvDocuments" class="animate-fade-in-section">

        <!-- ── Filters Section (collapsible, like Customer & Basic Info) ── -->
        <div class="inv-section-card">
            <div class="inv-section-header is-open" data-target="sec-doc-filters">
                <span class="inv-section-title">
                    <span class="sec-icon">🔍</span> Document Type &amp; Filters
                </span>
                <span class="inv-section-toggle">&#9660;</span>
            </div>
            <div class="inv-section-body" id="sec-doc-filters">
                <div class="row align-items-center g-2">

                    <!-- Toggle (Invoice / Draft / QTN / Order) -->
                    <div class="col-12 col-md-4">
                        <div class="toggle d-flex flex-wrap gap-1">
                            <input type="radio" name="sizeBy" id="rdoMainTableData" checked />
                            <label for="rdoMainTableData"><i class="fas fa-file-invoice me-1"></i>Invoices</label>
                            <input type="radio" name="sizeBy" id="rdoDraftTableData" />
                            <label for="rdoDraftTableData"><i class="fas fa-pencil me-1"></i>Draft</label>
                            <input type="radio" name="sizeBy" id="rdoQTNTableData" />
                            <label for="rdoQTNTableData"><i class="fas fa-file-lines me-1"></i>Quotation</label>
                            <input type="radio" name="sizeBy" id="rdoOrdertakenData" />
                            <label for="rdoOrdertakenData"><i class="fas fa-cart-shopping me-1"></i>Order Taken</label>
                        </div>
                    </div>

                    <!-- Filters -->
                    <div class="col-12 col-md-8">
                        <div class="row g-1 align-items-end">
                            <div class="col-6 col-sm-4 col-md-2">
                                <span class="form-label">
                                    <select class="form-control FormfilterclrField" id="cmbFilterBranch">
                                        <option value="0">Select Branch</option>
                                    </select>
                                    <label class="labelup">Branch</label>
                                </span>
                            </div>
                            <div class="col-6 col-sm-5 col-md-3">
                                <span class="form-label">
                                    <input class="form-control FormfilterclrField" type="text" id="txtFilterParty">
                                    <label class="labelup">Party</label>
                                </span>
                                <div class="text-danger ps-1" id="divErrFParty"></div>
                            </div>
                            <div class="col-4 col-sm-3 col-md-1">
                                <select class="form-control gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                            </div>
                            <div class="col-4 col-sm-3 col-md-2">
                                <span class="form-label">
                                    <input class="form-control FormfilterclrField" type="date" id="dtpFFrom"
                                           oninput="if(this.value>this.max){this.value=this.max;}">
                                    <label class="labelup">From</label>
                                </span>
                                <div class="text-danger ps-1 clrdivs" id="divErrFFrom"></div>
                            </div>
                            <div class="col-4 col-sm-3 col-md-2">
                                <span class="form-label">
                                    <input class="form-control FormfilterclrField" type="date" id="dtpFTo"
                                           oninput="if(this.value>this.max){this.value=this.max;}">
                                    <label class="labelup">To</label>
                                </span>
