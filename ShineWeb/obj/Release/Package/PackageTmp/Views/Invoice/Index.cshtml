                const fieldID = $(this).attr("id");
                if (fieldName == "Goods") {
                    var gds = (parseFloat(dPTGoods));
                    //$(this).text(gds.toFixed(DecVal));
                    updateLabelColumn(fieldID, gds);
                    //setTagValue(fieldID, fieldName, grs,2);
                    dPTGoods = gds.toFixed(DecVal);
                }
                if (fieldName == "Gross") {
                    var grs = (parseFloat(dPTGoods) - (Tradediscamt + Addnldiscamt + Proddiscamt));
                    //$(this).text(grs.toFixed(DecVal));
                    updateLabelColumn(fieldID, grs);
                    //setTagValue(fieldID, fieldName, grs,2);
                    dPTGross = grs.toFixed(DecVal);
                }
                if (fieldName == "TaxAmt") {
                    var tamt = parseFloat(ApponMRPCum) > 0 ? (parseFloat(TotMRPonTaxAmt) * Qty) : ((taxpern * dPTGross) / 100);
                    //$(this).text(tamt.toFixed(DecVal));
                    updateLabelColumn(fieldID, tamt);
                    //setTagValue(fieldID, fieldName, tamt,2);
                    dPTTax = tamt.toFixed(DecVal);
                }
                if (fieldName == "NetAmt") {
                    var neta = (parseFloat(dPTGross) + parseFloat(dPTTax));
                    //$(this).text(neta.toFixed(DecVal));
                    updateLabelColumn(fieldID, neta);
                    //setTagValue(fieldID, fieldName, neta, 2);
                    //dPTNet = parseFloat($(this).text());
                }
                if (fieldName == "DiffValue") {
                    var dDiffGross = 0, dDiffNet = 0;
                    var dQty = Qty;
                    if (dQty > 0) {
                        var val = dPTGross / dQty;
                        var Diff = val - (TInvoicePrice * CFValue);
                        var AbsDiff = Diff;// Math.abs(Diff);
                        updateLabelColumn(fieldID, AbsDiff);
                        var clrcolor = Diff >= 0 ? "green" : "red";
                        $(this).css("color", clrcolor);
                        dDiffGross += (AbsDiff * dQty);
                        val = dPTNet / dQty;
                        Diff = val - (TInvoicePrice * CFValue);
                        AbsDiff = Diff;// Math.abs(Diff);
                        dDiffNet += (AbsDiff * dQty);
                    } else {
                        updateLabelColumn(fieldID, 0);
                        $(this).css("color", "black");
                        dDiffGross += 0;
                        dDiffNet += 0;
                    }
                }
            });

        });
        calculateProdGrid();
    }

    /* --- Shared: compute pern from amt and validate, then call calc fn --- */
    function _applyDiscAmt(amtFieldID, pernFieldID, calcFn) {
        var amt = getTag(amtFieldID) || 0;
        var goods = getTag('lblPTGoods');
        var pdisc = getTag('lblPTPDiscAmt');
        var base = goods - pdisc;
        var pern = base > 0 ? (amt / base) * 100 : 0;
        if (!validateDiscPern(pern, "Invalid Discount Value")) {
            updateInputColumn(pernFieldID, 0);
            updateInputColumn(amtFieldID, 0);
            calcFn(0);
        } else {
            updateInputColumn(pernFieldID, pern);
            calcFn(pern);
        }
    }

