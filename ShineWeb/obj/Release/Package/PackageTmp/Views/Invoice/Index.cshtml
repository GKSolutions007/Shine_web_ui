    function CalculateItemDiffPrice() {

        $("#tblProductData tbody tr").each(function () {

            const rowData = ProductTable.row(this).data();
            const invoicePrice = parseFloat(rowData[28]) || 0;

            const $row = $(this);

            // Qty
            const qtyAttr = $row.find('input[name="Qty"]').attr('txttag');
            const qty = parseFloat(qtyAttr) || 0;

            // UOM Conversion Factor
            const uomCF = parseFloat(
                $row.find('select[name="UOM"] option:selected').attr('name')
            ) || 1;

            // Gross
            const grossAttr = $row.find('label[name="Gross"]').attr('lbltag');
            const gross = parseFloat(grossAttr) || 0;

            // Diff Value label
            const $diffLabel = $row.find('label[name="DiffValue"]');

            if (qty > 0) {
                const rate = gross / qty;
                const diff = (invoicePrice * uomCF) - rate;

                $diffLabel.css("color", diff >= 0 ? "green" : "red");
                updateLabelColumn($diffLabel.attr("id"), diff);
            } else {
                $diffLabel.css("color", "black");
                updateLabelColumn($diffLabel.attr("id"), 0);
            }
        });
    }
