        $("#lblPTCount").text(rowCount);

        //Gross & Tot Disc Amt
        updateLabelColumn("lblGross", dPTGross);
        updateLabelColumn("lblTotalDiscAmt", (TotProdDisc + TotTradeDisc + TotAddnlDisc));

        ApplyMultimodeAmount(roundedNet);
        ProductTable.columns.adjust().draw();
    }

