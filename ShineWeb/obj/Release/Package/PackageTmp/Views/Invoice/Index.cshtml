<script>
    /* =============================================
       SECTION COLLAPSE / EXPAND
       ============================================= */
    document.querySelectorAll('.inv-section-header').forEach(function (header) {
        var targetId = header.getAttribute('data-target');
        var body = document.getElementById(targetId);
        if (!body) return;

        // Sync initial state
        if (header.classList.contains('is-open')) {
            body.style.display = '';
        } else {
            body.style.display = 'none';
        }

        header.addEventListener('click', function () {
            var isOpen = header.classList.contains('is-open');
            if (isOpen) {
                header.classList.remove('is-open');
                body.style.display = 'none';
            } else {
                header.classList.add('is-open');
                body.style.display = '';
                // Re-adjust DataTables when their section is revealed
                if (targetId === 'sec-products') {
                    if (typeof ProductTable !== 'undefined') {
                        setTimeout(function () { ProductTable.columns.adjust(); }, 50);
                    }
                }
            }
        });
    });

    /* Auto-expand Discounts section when any discount field is filled */
    (function () {
        var discountFields = ['#txtTradeDiscPern', '#txtTradeDiscAmt', '#txtAddnlDiscPern', '#txtAddnlDiscAmt',
            '#txtOtherChargPern', '#txtOtherChargAmt', '#txtFright', '#txtTCS'];
        function expandDiscounts() {
            var hdr = document.querySelector('[data-target="sec-discounts"]');
            var body = document.getElementById('sec-discounts');
            if (hdr && body && !hdr.classList.contains('is-open')) {
                hdr.classList.add('is-open');
                body.style.display = '';
            }
        }
        discountFields.forEach(function (sel) {
            var el = document.querySelector(sel);
            if (el) el.addEventListener('change', function () { if (this.value) expandDiscounts(); });
        });
    })();

    /* Update product count badge */
    function updateProductBadge() {
        try {
            if (typeof ProductTable !== 'undefined') {
                var count = ProductTable.rows().count();
                var badge = document.getElementById('badgeProductCount');
                if (badge) badge.textContent = count + ' item' + (count === 1 ? '' : 's');
            }
        } catch (e) { }
    }

    /* =============================================
       tblProductInfo — column drag-resize
       ============================================= */
    function initProductInfoResize() {
        var table = document.getElementById('tblProductInfo');
        if (!table) return;
        var ths = table.querySelectorAll('thead th');
        ths.forEach(function (th) {
            // add resizer handle if not already present
            if (th.querySelector('.col-resizer')) return;
            var resizer = document.createElement('div');
            resizer.className = 'col-resizer';
            th.appendChild(resizer);

            var startX, startW;
            resizer.addEventListener('mousedown', function (e) {
                startX = e.clientX;
                startW = th.offsetWidth;
                resizer.classList.add('resizing');
                document.addEventListener('mousemove', onMove);
                document.addEventListener('mouseup', onUp);
                e.preventDefault();
            });
            function onMove(e) {
                var newW = Math.max(40, startW + (e.clientX - startX));
                th.style.width = newW + 'px';
                th.style.minWidth = newW + 'px';
                if (typeof TableProductInfo !== 'undefined') {
                    TableProductInfo.columns.adjust();
                }
            }
            function onUp() {
                resizer.classList.remove('resizing');
                document.removeEventListener('mousemove', onMove);
                document.removeEventListener('mouseup', onUp);
            }
        });
    }

    // Run after modal opens (DataTable columns adjust fires first)
    document.getElementById('myModalPinfo') &&
        document.getElementById('myModalPinfo').addEventListener('shown.bs.modal', function () {
            if (typeof TableProductInfo !== 'undefined') {
                TableProductInfo.columns.adjust().draw();
            }
            initProductInfoResize();
        });
</script>
