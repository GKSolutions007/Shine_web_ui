        <td style="word-wrap: break-word; white-space: normal;">
            <b>${rowdata.narration || ''}</b>
        </td>
    </tr>
</table>`;
                                InfoDialogMsg(Message, "Info Message");
                            } else {
                                showErrorSnackbar("No info found")
                            }
                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(33, 1, 0, colIndex, field, newWidth)
                        },
                    });

                    if (data.length == 0) {
                        if (ClickType == 1)
                            showErrorSnackbar("No records found");
                    }
                        // Step 1: Define statuses to exclude
                        const excludeStatuses = ['amended', 'cancelled'];

                        // Step 2: Calculate cumulative total excluding those statuses
                        let totalNetAmt = 0;
                        let totalBalance = 0;

                        InvoicejsData.forEach(item => {
                            const status = item.Status.toLowerCase();
                            if (!excludeStatuses.includes(status)) {
                                totalNetAmt += parseFloat(item.NetAmt);
                                totalBalance += parseFloat(item.Balance);
                            }
                        });
                        $("#dvPaid").html(formatIndianCurrency(parseFloat(totalNetAmt - totalBalance).toFixed(DecVal)));
                        $("#dvUnPaid").html(formatIndianCurrency(parseFloat(totalBalance).toFixed(DecVal)));
                        $("#dvTotal").html(formatIndianCurrency(parseFloat(totalNetAmt).toFixed(DecVal)));

                }, error: function (data) {
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
        }
    }

