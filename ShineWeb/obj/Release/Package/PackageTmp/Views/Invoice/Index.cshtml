    //~Validation
    function SaveValidation(SaveMode) {
        var IsValid = true;
        $(".clrdivs").html("");
        if ($("#txtSearch").val() == "") {
            IsValid = false;
            $("#divErrSearch").html("Party should not be empty");
            showErrorSnackbar("Party should not be empty");
        }
        else {
            const exists = arrVendorName.indexOf($("#txtSearch").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#divErrSearch").html("Select Party Name from list");
                showErrorSnackbar("Select Party Name from list");
            }
        }
        if ($("#cmbBranch ").val() == 0) {
            IsValid = false;
            $("#divErrBranch").html("Select Branch");
            showErrorSnackbar("Select Branch");
        }

        if (nIsDraft == 0) {
            if ($("#cmbPriceType").val() == 0) {
                IsValid = false;
                $("#divErrPriceType").html("Select Price Type");
                showErrorSnackbar("Select Price Type");
            }
            if ($("#cmbPaymode").val() == 0) {
                IsValid = false;
                $("#divErrPaymode").html("Select Payment Mode");
                showErrorSnackbar("Select Payment Mode");
            }
            if ($("#cmbPaymode").val() == 7 && ($("#cmbCreditTerm").val() == 0 || $("#cmbCreditTerm").val() == "" || $("#cmbCreditTerm").val() == null)) {
                IsValid = false;
                $("#divErrCreditTerm").html("Select Credit Term");
                showErrorSnackbar("Select Credit Term");
            }
        }
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#divErrDate").html("Date should not be empty");
            showErrorSnackbar("Date should not be empty");
        }
        if ($("#lblPTNet").text() == "") {
            IsValid = false;
            showErrorSnackbar("Net Amount should be greater than Zero");
        }
        else {
            if (parseFloat($("#lblPTNet").text()) < 0) {
                IsValid = false;
                showErrorSnackbar("Net Amount should be greater than Zero");
            }
        }
        var ProdRowCounts = ProductTable.rows().count();
        if (ProdRowCounts == 0) {
            IsValid = false;
            $("#divErrProduct").html("Add atleat one product");
            showErrorSnackbar("Add atleat one product");
        }
        $("#lblRoundNet").css("color", "black");
        var valu = document.getElementById("lblRoundNet").getAttribute("lbltag");
        if (parseFloat(valu) <= 0) {
            IsValid = false;
            $("#lblRoundNet").css("color", "red");
            showErrorSnackbar("Net Amount should be greater than Zero");
        }
        if (IsValid) {
            var errorthrowwed = false;
            $("#tblProductData tbody tr").each(function () {
                const $r = $(this);
                let Balance = getTagEl($r, "label[name='NetAmt']");
                let currentNetAmtid = $r.find("label[name='NetAmt']").attr("id");
                if (Balance < 0) {
                    $(this).find('td').css("background-color", "#FFB6C1");
                    $("#" + currentNetAmtid).css("color", "red");
                    IsValid = false;
                    if (!errorthrowwed) {
                        showErrorSnackbar("Some items are have nagative values");
                    }
                }
                else {
                    $(this).find('td').css("background-color", "white");
                    $("#" + currentNetAmtid).css("color", "black");
                }
            });
        }
        if (IsValid) {
            if ($("#cmbPaymode").val() == 8 && nIsDraft == 0) {
                if (PaymodeArray.length == 0) {
                    IsValid = false;
                    modalPayment.show();
                }
                else {
                    var Tot = parseFloat(document.getElementById("txtPMPTotal").getAttribute("txttag"));
                    var AdjAmt = parseFloat(document.getElementById("txtPMPAdjAmt").getAttribute("txttag"));
                    if (Tot != AdjAmt) {
                        IsValid = false;
                        var Bal = Tot - AdjAmt;
                        showErrorSnackbar("₹ " + Bal + " Pending, Adjust full Value");
                        modalPayment.show();
                    }
                }
                if (IsValid && SaveMode == 2) {
                    IsValid = false;
                    modalPayment.show();
                }
            }
            else {
                IsValid = true;
            }

        }
        if (IsValid) {
            IsValid = ValidateDuplicateitem();
        }
        if (IsValid) {
            if ($("#cmbPaymode").val() == 7 && nIsDraft == 0 && !CreditLimValidate) {
                modalCreditLimPassword.hide();
                TableCreditLimPassword.draw().clear(); TableCreditLimPassword.draw().clear();
                var nID = $("#txtID").val() != "" ? $("#txtID").val() : 0;
                var nCustID = $("#txtCustomerID").val() != "" ? $("#txtCustomerID").val() : 0;
                //IsValid = false;
                $.ajax({
                    url: Aurl + "invoice/validatecreditlimit",
                    type: 'get',
                    contentType: 'json',
                    data: { CustID: nCustID, Date: $("#dtpDate").val(), CreditTermID: $("#cmbCreditTerm").val(), NetAmt: $("#lblRoundNet").text(), TransID: nID },
                    xhrFields: {
                        withCredentials: true
                    },
                    async: false,
                    success: function (data) {
                        if (data.length > 0) {
                            $.each(data, function (i, items) {
                                TableCreditLimPassword.row.add([
                                    items.ID,
                                    '<label>' + items.Name + '</label>',
                                    items.Value,
                                    '<input type="password" id="dgvPWD' + i + '" name ="Password" class="gdInput"/>'
                                ]).draw(false);
                            });
                            modalCreditLimPassword.show();
                            setupArrowKeyNavigationforPasswordTable();
                            IsValid = false;
                        }
                        else {
                            IsValid = true;
                        }
                    }
                });
            }
        }
        return IsValid;
    }
    var CreditLimValidate = false;
    var CreditLimitPassword = [];
    $('#btnCreditLimPasswordAccept').click(function (e) {
        var IsValid = true;
        CreditLimitPassword = []
        $("#tblCreditLimPassword tbody tr").each(function () {
            var rowdata = TableCreditLimPassword.row($(this)).data();
            var PWDID = rowdata[0];
            var Pwd = "";
