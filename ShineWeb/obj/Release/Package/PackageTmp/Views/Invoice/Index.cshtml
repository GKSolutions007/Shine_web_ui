    function CalculateTradediscpern(value) {
        var dPTGross = 0, dPTGoods = 0, dPTTax = 0, dPTNet = 0, Proddiscamt = 0, Tradediscamt = 0, Addnldiscamt = 0;
        $("#tblProductData tbody tr").each(function () {
