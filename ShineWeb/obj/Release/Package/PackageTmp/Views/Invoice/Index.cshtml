            $(this).find("input").each(function (index) {
                $(this).css("border-color", "black");
                if ($(this).val() == "") {
                    IsValid = false;
                    $(this).css("border-color", "red");
                }
                else {
                    Pwd = $(this).val();
                }
            });
            var p = {
                "ID": PWDID,
                "Passwords": Pwd
            }
            CreditLimitPassword.push(p);
        });
        if (IsValid) {
            var lstPWD = {
                "lstConfigPasswords": CreditLimitPassword
            }
            $.ajax({
                url: Aurl + "invoice/verifycreditlimit",
