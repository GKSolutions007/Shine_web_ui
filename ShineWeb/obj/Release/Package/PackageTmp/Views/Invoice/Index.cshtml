    async function GetCustomerList() {
        try {
            const response = await fetch(
                Aurl + "invoice/getcustomerlist",
                {
                    method: "GET",
                    credentials: "include", // equivalent to xhrFields.withCredentials = true
                    headers: {
                        "Content-Type": "application/json"
                    }
                }
            );

            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const data = await response.json();

            customersalllist = data;
            CustomerAutolist(customersalllist);
            FiltersCustomerAutolist(customersalllist);

        } catch (error) {
            console.error("Failed to load customer list:", error);
        }
    }
