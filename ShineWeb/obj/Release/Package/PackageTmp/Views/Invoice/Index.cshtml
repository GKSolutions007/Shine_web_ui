    function ProductGridChange(e) {
        var rowdata = ProductTable.row(nCurrentRowIndex).data();
        if (rowdata != null) {
            var value = e.target.value;
            var CurrentFieldname = e.target.name;
            var clslist = e.target.classList;
            var fname = clslist.length > 1 ? clslist[1] : fname;
            var dPTGross = 0, dPTGoods = 0, dPTTax = 0, dPTNet = 0, Proddiscamt = 0, Tradediscamt = 0, Addnldiscamt = 0;
            var ProdID = rowdata[0];
            var taxpern = parseFloat(rowdata[2]);
            var ExclPrice = 0, InclPrice = 0, Qty = 0, ProdDisc = 0, dProdDiscAmt = 0, CFValue = 1;
            $("#tblProductData tbody tr").each(function () {
                const $r = $(this);
                var rowdata = ProductTable.row($(this)).data();
                var RowIndex = ProductTable.row($(this)).index();
                var GridProdID = rowdata[0];
                var TaxPern = parseFloat(rowdata[2]);
