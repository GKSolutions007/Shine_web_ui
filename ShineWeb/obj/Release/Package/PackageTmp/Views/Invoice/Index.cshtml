    function invSwitchTab(idx, btn) {
        //inv-panel-0,inv-panel-1,inv-panel-2
        if (idx == 0) {
            $("#inv-panel-1,#inv-panel-2").hide()
            $("#inv-panel-0").show()
        } else if (idx == 1) {
            $("#inv-panel-0,#inv-panel-2").hide()
            $("#inv-panel-1").show()
        } else if (idx == 2) {
            $("#inv-panel-1,#inv-panel-0").hide()
            $("#inv-panel-2").show()
        }
        document.querySelectorAll('.inv-tab-btn').forEach((b, i) => b.classList.toggle('active', i === idx));
        document.querySelectorAll('.inv-tab-panel').forEach((p, i) => {
            if (i === idx) {
                p.style.display = 'block';
                requestAnimationFrame(() => p.classList.add('active'));
            } else {
                p.classList.remove('active');
                setTimeout(() => { if (!p.classList.contains('active')) p.style.display = 'none'; }, 200);
            }
        });
    }

    function invRenderQR(onReady) {          // ← accept a callback
        const canvas = document.getElementById('cnvQR');
        if (!canvas) return;

        var data = $("#lblSignedQR").text();
        const tempDiv = document.createElement('div');
        tempDiv.style.display = 'none';
        document.body.appendChild(tempDiv);

        new QRCode(tempDiv, {
            text: data,
            width: 225,
            height: 225,
            correctLevel: QRCode.CorrectLevel.L
        });

        setTimeout(() => {
            const generated = tempDiv.querySelector('canvas');
            if (generated) {
                canvas.width = generated.width;
                canvas.height = generated.height;
                canvas.getContext('2d').drawImage(generated, 0, 0);
            }
            document.body.removeChild(tempDiv);

            if (onReady) onReady();          // ← fire callback AFTER canvas is ready
        }, 100);
    }

    function invShowQR() {
        const canvas = document.getElementById('cnvQR');
        if (!canvas) return;

        const existing = document.getElementById('qrOverlay');
        if (existing) document.body.removeChild(existing);

        const overlay = document.createElement('div');
        overlay.id = 'qrOverlay';
        overlay.style.cssText = `
        position:fixed;top:0;left:0;width:100%;height:100%;
        background:rgba(0,0,0,0.55);z-index:9999;
        display:flex;align-items:center;justify-content:center;
        animation:qrFadeIn .18s ease;
    `;

        const modal = document.createElement('div');
        modal.style.cssText = `
        background:#fff;border-radius:10px;padding:20px;
        text-align:center;box-shadow:0 8px 32px rgba(0,0,0,0.18);
        min-width:220px;
    `;

        const title = document.createElement('p');
        title.textContent = 'Signed QR Code';
        title.style.cssText = 'margin:0 0 12px;font-size:13px;font-weight:500;color:#333;';

        const img = document.createElement('img');
        img.style.cssText = 'width:200px;height:200px;display:block;margin:0 auto;border:1px solid #eee;border-radius:6px;';
        // ↑ Do NOT set img.src here — canvas is still blank at this point

        const closeBtn = document.createElement('button');
        closeBtn.textContent = 'Close';
        closeBtn.style.cssText = `
        margin-top:14px;padding:5px 20px;font-size:12px;
        border:1px solid #ccc;border-radius:5px;background:#f5f5f5;
        cursor:pointer;color:#333;
    `;
        closeBtn.onclick = () => document.body.removeChild(overlay);

        modal.appendChild(title);
        modal.appendChild(img);
        modal.appendChild(closeBtn);
        overlay.appendChild(modal);
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) document.body.removeChild(overlay);
        });
        document.body.appendChild(overlay);

        // Render QR first, THEN set the image src
        invRenderQR(() => {
            img.src = canvas.toDataURL();    // ← runs only after canvas is populated
        });
    }

</script>

