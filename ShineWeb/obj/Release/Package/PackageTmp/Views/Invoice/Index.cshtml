    function calculateProdGrid() {
        // Reset footer labels to zero
        $(".lblPT").text("0.00");

        const rowCount = ProductTable.rows().count();
        if (rowCount === 0) {
            updateInputColumn("txtTradeDiscPern", 0);
            updateInputColumn("txtAddnlDiscPern", 0);
            $("#txtTradeDiscPern,#txtTradeDiscAmt,#txtAddnlDiscPern,#txtAddnlDiscAmt").prop("disabled", false);
            ApplyMultimodeAmount(0);
            return;
        }

        // Accumulators
        let dPTQty = 0, dPTGoods = 0, dPTGross = 0, dPTTax = 0, dPTNet = 0;
        let TotProdDisc = 0, TotTradeDisc = 0, TotAddnlDisc = 0;
        let DiffExcl = 0, DiffIncl = 0;

        // Helper: read txttag/lbltag as float from any element
        const tag = (el, attr) => parseFloat(el?.getAttribute(attr) || 0) || 0;

        $("#tblProductData tbody tr").each(function () {
            const $row = $(this);
            const rowdata = ProductTable.row(this).data();
            const TaxPern = parseFloat(rowdata[2]) || 0;
            const TInvPrice = parseFloat(rowdata[28]) || 0;
            const tp = 1 + TaxPern / 100;

            // Read all inputs by name using txttag attribute
            const getInput = (name) => {
                const el = this.querySelector(`input[name="${name}"]`);
                return el ? tag(el, "txttag") : 0;
            };
            const getLabel = (name) => {
                const el = this.querySelector(`label[name="${name}"]`);
                return el ? tag(el, "lbltag") : 0;
            };

            const qty = getInput("Qty");
            const prodDisc = getInput("ProdDiscAmt");
            const tradeDisc = getInput("TradeDiscAmt");
            const addnlDisc = getInput("AddnlDiscAmt");
            const gross = getLabel("Gross");
            const net = getLabel("NetAmt");

            dPTQty += qty;
            TotProdDisc += prodDisc;
            TotTradeDisc += tradeDisc;
            TotAddnlDisc += addnlDisc;
            dPTGoods += getLabel("Goods");
            dPTGross += gross;
            dPTTax += getLabel("TaxAmt");
            dPTNet += net;

            // UOM conversion factor
            const uomEl = this.querySelector("select[name='UOM'] option:checked");
            const cf = parseFloat(uomEl?.getAttribute("name") || 1) || 1;

            // Diff calc
            if (qty > 0) {
                const perUnit = gross / qty;
                const diff = perUnit - TInvPrice * cf;
                DiffExcl += diff * qty;
                DiffIncl += diff * qty * tp;
            }

            // Row highlight: grey if no net value
