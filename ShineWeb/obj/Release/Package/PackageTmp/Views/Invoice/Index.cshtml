                                onClick: (gridInstance, event) => {
                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 33, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'New',
                                //id:'btnGKBSGNew',
                                title: 'New Invoice',
                                visible: $("#txtAddID").val() == 1 && rdo1 == "1",
                                onClick: (gridInstance, event) => {
                                    nTransMode = 1;
                                    $("#dvMain,#btnAddNewProduct").show();
                                    $("#dvDocuments").hide();
                                    $("#balanceContainer").hide()
                                    $("#btnTEdit,#btnTCancel,#btnTVariant").hide();
                                    ClearForm();
                                    Addprodgridline();
                                    setTimeout(() => {
                                        var DocDate = $("#dtpDate").val();
                                        var Branch = $("#cmbBranch").val();
                                        GetDocumentID(DocDate, Branch, 15);
                                    }, 1000);
                                }
                            },
                        ],
                        customCellRenderer: (el, col, rowData) => {
                            if (col.field === 'GrossAmt' && rdo1 == "1") {
                                const val = rowData[col.field];
                                if (val >= 0) {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-active"><span class="dg-status-circle"></span> `+ val +`</div>`;
                                } else {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-inactive"><span class="dg-status-circle"></span> `+ val +`</div>`;
                                }
                                col.header = "Diff Excl";
                            }
                            if (col.field === 'TaxAmt' && rdo1 == "1") {
                                const val = rowData[col.field];
                                if (val >= 0) {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-active"><span class="dg-status-circle"></span> ` + val + `</div>`;
                                } else {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-inactive"><span class="dg-status-circle"></span> ` + val + `</div>`;
                                }
                                col.header = "Diff Incl";
                            }


                        },
                        onCellClick: (rowdata, fieldName, cellValue, column) => {
                            $(".clrdivs").html("");
                            if (rdo1 == 1 && fieldName == "DocID") {
                                var ID = rowdata.ID;//[0];
                                InvoiceCollectionModalPopup(ID,15);
                            }
                        },
                        onCellDoubleClick: (rowdata, fieldName, cellValue, column) => {
                            if (rowdata) {
                                var Message = rowdata.InfoMessage;
                                Message = `
<table class="table table-bordered" style="table-layout: fixed; width: 100%;">
    <tr>
        <td style="width:30%" align="right">Party Name :</td>
        <td style="width:70%; word-wrap: break-word; white-space: normal;">
            <b>${rowdata.VendorID || ''}</b>
        </td>
    </tr>
    <tr>
        <td style="width:30%" align="right">Salesman :</td>
        <td style="width:70%; word-wrap: break-word; white-space: normal;">
            <b>${rowdata.Salesman || ''}</b>
        </td>
    </tr>
    <tr>
        <td style="width:30%" align="right">Beat Name :</td>
        <td style="width:70%; word-wrap: break-word; white-space: normal;">
            <b>${rowdata.BeatName || ''}</b>
        </td>
    </tr>
    <tr>
        <td style="width:30%" align="right">Remarks :</td>
        <td style="width:70%; word-wrap: break-word; white-space: normal;">
