    function SortCustomerslist() {
        const beatID = Number($("#cmbBeat").val());
        const salesmanID = Number($("#cmbSalesman").val());
        const allSalesman = Number('@Session["AllSalesmanInvoice"]');

        const filtcusts = customersalllist.filter(customer =>
            customer.BeatDetails.some(detail =>
                (beatID === 0 || detail.BeatID === beatID) &&
                (
                    allSalesman === 1 ||
                    salesmanID === 0 ||
                    detail.SalesmanID === salesmanID
                )
            ) ||
            (
                beatID === 0 &&
                (salesmanID === 0 || allSalesman === 1)
            )
        );
        //console.log(filtcusts);
        CustomerAutolist(filtcusts);
        $("#txtCustomerID,#txtSearch").val(""), $("#lblName,#lblPartyCloseBal,#lblPartyACDRating").text("");
        $("#lblCustomerScheme").hide();
    }

    function CustomerAutolist(listdata) {
        arrVendor = [], arrVendorName = [], nIndexarrVendor = 0;
        $.each(listdata, function (i, items) {
            var ven = {
                "label": items.Code + " | " + items.Name,
                "name": items.Name,
                "code": items.Code,
                "id": items.ID,
                "add1": items.Billadd1,
                "line2": items.Billadd1,
            }
            if (items.ID == DefCustID) {
                DefCustCode = items.Code;
            }
            arrVendor.push(ven);
            arrVendorName[nIndexarrVendor] = items.Name;
            nIndexarrVendor++;
        });
        //~AutoList Customer
        PaginatedAutocomplete({
            inputId: "txtSearch",
            data: arrVendor,
            onSelect: function (item) {
                $("#txtSearch").val(item.name);
                GetData(3, item.code);
                window.scrollTo({
                    top: document.body.scrollHeight,
                    behavior: 'smooth'
                });
                return false;
            }
        });
    }
