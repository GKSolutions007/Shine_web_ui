            IsValid = false;
            $("#divErrFFrom").html("From date should not be empty");
        }
        if ($("#dtpFTo").val() == "") {
            IsValid = false;
            $("#divErrFTo").html("To date should not be empty");
        }
        if ($("#dtpFFrom").val() > $("#dtpFTo").val()) {
            IsValid = false;
            $("#divErrFFrom").html("From date should be lessthan To Date");
        }
        if (IsValid) {//rdoOrdertakenData,,rdoQTNTableData
            var rdo1 = $("#rdoMainTableData").is(":checked") ? "1" : $("#rdoDraftTableData").is(":checked") ? "2" : $("#rdoQTNTableData").is(":checked") ? "3" :"4";
            var strBranch = $("#cmbFilterBranch").val(), strParty = $("#txtFilterParty").val(), dFrom = $("#dtpFFrom").val(),
                dTo = $("#dtpFTo").val(), chkshow = $("#chkShowAll").is(":checked") ? "1" : "0";

            $.ajax({
                url: Aurl + "invoice/getfilterdata",
                type: 'get',
                contentType: 'json',
                data: { TransID: 15, FType: rdo1, Branch: strBranch, Party: strParty, FromDate: dFrom, ToDate: dTo, Showall: chkshow },
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    var InvoicejsData = eval(data);
                    if (rdo1 == "1")
                    {
                        var index = columns.findIndex(col => col.field === "GrossAmt");
                        columns[index].header = "Diff Excl";
                        index = columns.findIndex(col => col.field === "TaxAmt");
                        columns[index].header = "Diff Incl";
                    }

                    var currentSearchValue = '';
                    if (grid) {
                        currentSearchValue = grid ? grid.state.searchTerm : '';
                    }
                    grid = new GKBSDynamicGrid('#my-grid', columns, InvoicejsData, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        height: '500px',
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,
                        enableAddRow: false,
                        enableRemoveRow: false,
                        enableSorting: true,
                        searchTerm: currentSearchValue, singleIconAction: singleIconAction,
                        rowActionsMenu: menuActions,
