@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>    
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 60%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -50%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.ChildURL1, new { @autocomplete = "off", @class = "form-control", @id = "txtChildBankAccURL" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>
    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>

    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content ">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold " id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="height:300px">
                    <div style="padding-top:2px" class="text-center">

                        <div class="row">
                            <!-- LEFT SECTION -->
                            <div class="col-md-6">
                                <table class="table w-100" id="tblData">

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">

                                            <span class="form-label">
                                                <input tabindex="1" type="text" id="txtRefNo"
                                                       class="form-control FormclrField"
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorRefNo')"
                                                       oninput="sanitizeAlphaNumeric(this, '#dvErrorRefNo')" />

                                                <label class="labelup">Ref.No *</label>
                                            </span>

                                            <div class="clrdiv text-danger" id="dvErrorRefNo"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">

                                            <span class="form-label">
                                                <select tabindex="2" id="cmbAccNo" class="form-control"></select>
                                                <label class="labelup">Bank A/c No *</label>
                                            </span>

                                            <div class="clrdiv text-danger" id="dvErrorAccNo"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" width="50%">

                                            <span class="form-label">
                                                <input tabindex="3" type="number"
                                                       id="txtStartingNo"
                                                       class="form-control FormclrField"
                                                       maxlength="6"
                                                       oninput="if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); }" />

                                                <label class="labelup">Starting No *</label>
                                            </span>

                                            <div class="clrdiv text-danger" id="dvErrorStartingNo"></div>
                                        </td>

                                        <td style="border:none;padding-left:12px;padding-right:7px" width="50%">

                                            <span class="form-label">
                                                <input tabindex="4" type="number"
                                                       id="txtNoofleaves"
                                                       class="form-control FormclrField"
                                                       maxlength="3"
                                                       min="1"
                                                       oninput="if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); sanitizeNumericOnly(this, '#dvErrorNoofleaves') }"
                                                       onbeforeinput="return NumericOnlyBeforeInput(event, this,'#dvErrorNoofleaves')" />

                                                <label class="labelup">No.of Leaves *</label>
                                            </span>

                                            <div class="clrdiv text-danger" id="dvErrorNoofleaves"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td align="left" style="border: none; padding-left: 12px" colspan="2">
                                            <label for="chkActive">Active :</label>
                                            <input tabindex="5" type="checkbox" id="chkActive" checked disabled />
                                            <div class="clrdiv text-danger" id="dvErrorActive"></div>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- RIGHT SECTION -->
                            <div class="col-md-6">

                                <table id="tblChequeleaves" class="table table-bordered w-100">
                                    <thead>
                                        <tr class="trclrforcolheader">
                                            <th class="text-center" style="font-size:12px;width:10%">#</th>
                                            <th class="text-center" style="font-size:12px;width:50%">Cheque No</th>
                                            <th class="text-center" style="font-size:12px;width:40%">Status</th>
                                        </tr>
                                    </thead>
                                </table>

                            </div>

                        </div>

                        </div>
                    </div>

                <!-- Modal footer -->
                <div class="modal-footer">

                    <div class="row w-100">
                        <div class="col-12 text-end">

                            <button tabindex="7" type="button" class="btn btn-danger" id="btnClear">
                                <span class="glyphicon glyphicon-refresh"> Clear</span>
                            </button>

                            <button tabindex="6" type="button" class="btn btn-success" id="btnSave">
                                <span class="glyphicon glyphicon-saved"> Save</span>
                            </button>

                            <button tabindex="8" type="button" class="btn btn-warning" id="btnClose">
                                <i class="bi bi-x-circle"></i> Close
                            </button>

                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                $(".clrdiv").html("");
                nMode = 3;
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                var BankAccID = rowData.BankAccID;//[1];
                var RefNo = rowData.Refno;//[2];
                var BankAccName = rowData.BankAccName;//[3];
                var StartNo = rowData.StartingNo;//[4];
                var Noofleaves = rowData.NoofLeaves;//[5];
                var Active = rowData.Active;//[6];
                GetData(6, ID);
                $("#txtID").val(ID), $("#txtRefNo").val(RefNo), $("#cmbAccNo").val(BankAccID), $("#txtStartingNo").val(StartNo), $("#txtNoofleaves").val(Noofleaves),
                    $("#chkActive").prop("checked", Active == "Yes" || Active == "True");
                $(".FormclrField,#cmbAccNo").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbAccNo").prop("disabled", true);
                $("#tblChequeleaves").prop("disabled", true);
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                var BankAccID = rowData.BankAccID;//[1];
                var RefNo = rowData.Refno;//[2];
                var BankAccName = rowData.BankAccName;//[3];
                var StartNo = rowData.StartingNo;//[4];
                var Noofleaves = rowData.NoofLeaves;//[5];
                var Active = rowData.Active;//[6];
                GetData(6, ID);
                $("#txtID").val(ID), $("#txtRefNo").val(RefNo), $("#cmbAccNo").val(BankAccID), $("#txtStartingNo").val(StartNo), $("#txtNoofleaves").val(Noofleaves),
                    $("#chkActive").prop("checked", Active == "Yes" || Active == "True");
                //$(".FormclrField").prop("disabled", false);

                $("#btnSave,#cmbAccNo").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $("#tblChequeleaves").prop("disabled", false);
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>


<script type="text/javascript">

    var Aurl = '@Session["APIurl"]';

    var TableChqs = $('#tblChequeleaves').DataTable({
        "bSearchable": true,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        "bFilter": false,
        scrollY: "200px",
        scrollX: true,
        scrollCollapse: true,
    });
    var modal = new bootstrap.Modal(document.getElementById('myModalfg')); //document.getElementById("myModalfg");
    $("#myModalfg").on("shown.bs.modal", function () {
        $("#txtRefNo").focus();
    });
    
    var arrData = [];
    var grid, ChequeBook;
    GetColumnSettingsData(2, 7, 1);
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    var arrStatus = [];
    setTimeout(() => { GetData(5, ""); }, 1000);
    
    GetData(7, "");
    GetData(8, "");
    //GetData(3);
    function GetData(dMode, Value ="") {
        $.ajax({
            url: Aurl + "chequebook/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: dMode, Name: Value },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                //~Grid Data
                if (dMode == 5) {
                    ChequeBook = data;
                    arrData = [];
                    if (data.length == 0) {
                        showErrorSnackbar("No Records Found");
                    }
                    $.each(data, function (i, items) {
                        //arrData[i] = items.Refno
                        var al = {
                            "label": items.Refno,
                            "id": items.ID,
                        }
                        arrData.push(al);
                    });

                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                    grid = new GKBSDynamicGrid('#my-grid', columns, ChequeBook, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                        enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                        enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                        enableSorting: true,
                        searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                        rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                        //onCellChange: handleCellUpdate,
                        customCellRenderer: (el, col, rowData) => {
                            if (col.field === 'Active') {
                                const val = rowData[col.field];                                
                                if (val === 'True') {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                                } else if (val === 'False') {
                                    el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                                }
                            }
                        },
                        customButtons: [
                            {
                                icon: '⚙️',
                                text: 'Settings',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {
                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 7, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'Add New',
                                title: 'Add New',
                                visible: $("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {
                                    nMode = 1;
                                    TableChqs.draw().clear();
                                    $("#chkActive,#btnSave,#cmbAccNo,#btnClear,.FormclrField").prop("disabled", false);
                                    $("#txtNoofleaves").prop("disabled", true);
                                    $("#cmbAccNo").val(0);
                                    $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                    modal.show();
                                    ClearForm();
                                }
                            },
                        ],
                        onCellClick: (rowData, fieldName, cellValue, column) => {
                        },
                        onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(7, 1, 0, colIndex, field, newWidth)
                        },
                    });
                    //~AutoList
                    PaginatedAutocomplete({
                        inputId: "txtRefNo",
                        data: arrData,
                        onSelect: function (item) {
                            $("#txtRefNo").val(item.label);
                            return false;
                        }
                    });
                    //$("#txtRefNo").autocomplete({
                    //    minLength: 0,
                    //    source: arrData,                            
                    //    select: function (event, ui) {
                    //        $("#txtRefNo").val(ui.item.label);                                
                    //        return false;
                    //    },
                    //}).autocomplete("instance")._renderItem = function (ul, item) {
                    //    return $("<li class='each'>")
                    //        .append("<div class='acItem'><span class='name'>" +
                    //            item.label + "</span></div>")
                    //        .appendTo(ul);
                    //};
                }
                    //~Cheque Leaf table Data
                else if (dMode == 6) {
                    TableChqs.draw().clear();
                    var anyStatus5 = false;
                    $.each(data, function (i, items) {
                        var enbordisb = (items.Status == 5 || nMode == 3) ? "disabled" : "";
                        if (!anyStatus5)
                            anyStatus5 = items.Status == 5;
                        var clscmb = "clscmbsts" + (i);
                        var Selc = '<select ' + enbordisb + ' id=' + items.ChequeNo + ' class="form-control ' + clscmb + '"> ';
                        var arrstslen = items.Status == 5 ? arrStatus.length : (arrStatus.length - 1);
                        for (var j = 0; j < arrstslen; j++) {
                                Selc += '<option value="' + arrStatus[j].ID + '">' + arrStatus[j].Status + '</option> '
                        }
                        Selc += ' </select>';
                        TableChqs.row.add([
                            (i + 1),
                            items.ChequeNo,
                            Selc,
                        ]).draw(false);
                        $("#" + items.ChequeNo).val(items.Status)
                    });
                    //if (anyStatus5) {
                    $("#chkActive,.FormclrField,#cmbAccNo").prop("disabled", anyStatus5);
                    //}
                }
                else if (dMode == 7) {
                    $('#cmbAccNo').find("option").remove();
                    $('#cmbAccNo').append($('<option/>', {
                        value: 0,
                        text: "-- Select Account --",
                        class: ""
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbAccNo').append($('<option/>', {
                            value: items.ID,
                            text: items.ChequeNo,
                        }));
                    });
                }
                else if (dMode == 8) {
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            var liststs = {
                                "ID": items.ID,
                                "Status": items.ChequeNo
                            }
                            arrStatus.push(liststs);
                        });
                    }
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $("#txtStartingNo").keyup(function (e) {
        var val = e.target.value;
        $("#txtNoofleaves").prop("disabled", true);
        $("#txtNoofleaves").val("");
        TableChqs.draw().clear(); TableChqs.draw().clear();
        if (val.length == 6) {
            $("#txtNoofleaves").prop("disabled", false);
        }
    });
    $("#txtNoofleaves").focusout(function () {
        TableChqs.draw().clear(); TableChqs.draw().clear();
        var startNo = parseInt($("#txtStartingNo").val());
        var count = parseInt($("#txtNoofleaves").val());
        var IsDisable = nMode == 1 ? "disabled" : "";
        for (var i = 0; i < count; i++) {
            var ChqNo = (startNo + i);
            var clscmb = "clscmbsts" + (i);
            var Selc = '<select ' + IsDisable +' id=' + ChqNo + ' class="form-control ' + clscmb + '">';
            for (var j = 0; j < (arrStatus.length - 1); j++) {
                Selc += '<option value="' + arrStatus[j].ID + '">' + arrStatus[j].Status + '</option> '
            }
            Selc += ' </select>';
            TableChqs.row.add([
                (i + 1),
                ChqNo,
                Selc
            ]).draw(false);
            $("#" + ChqNo).val(1);
        }
    });
    //~Close
    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.hide();
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        TableChqs.draw().clear();
        $(".FormclrField").val("");
        $("#cmbAccNo").val(0)
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#txtRefNo").focus();
        TableChqs.draw().clear();
        if (nMode != 1)
            modal.hide();
    }
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        //~Validation
        var IsValid = true;
        if ($("#txtRefNo").val() == "") {
            IsValid = false;
            $("#dvErrorRefNo").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        if ($("#txtStartingNo").val() == "") {
            IsValid = false;
            $("#dvErrorStartingNo").html("Starting No should not be empty");
            showErrorSnackbar("Starting No should not be empty");
        }
        console.log(parseInt($("#txtNoofleaves").val()));
        if ($("#txtNoofleaves").val() == "") {
            IsValid = false;
            $("#dvErrorNoofleaves").html("No.of leaves should not be empty");
            showErrorSnackbar("No.of leaves should not be empty");
        }
        else if (parseInt($("#txtNoofleaves").val()) <= 0) {
                IsValid = false;
                $("#dvErrorNoofleaves").html("No.of leaves should be greater than zero");
                showErrorSnackbar("No.of leaves should be greater than zero");
            }

        if ($("#cmbAccNo").val() == 0) {
            $("#dvErrorAccNo").html("Select Bank Account");
            showErrorSnackbar("Select Bank Account");
            IsValid = false;
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var lstvData = [];
        $('#tblChequeleaves tr td select').each(function (i, items) {
            var singlelist = {
                "ChequeNo": items.id,
                "Status": items.value,
            }
            lstvData.push(singlelist);
        });
        var lstMaster = {
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "Refno": $("#txtRefNo").val(),
            "BankAccID": $("#cmbAccNo").val(),
            "StartingNo": $("#txtStartingNo").val(),
            "NoofLeaves": $("#txtNoofleaves").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID,
            "CBDetails": lstvData
        };
        $.ajax({
            url: Aurl + "chequebook/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        ClearForm();
                        GetData(5, "");
                        modal.hide();
                    }
                    else {
                        $("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    window.addEventListener('keydown', function (event) {
        // Check if the F8 key is pressed (key code 119)
        if (event.keyCode === 119) {
            var url = $("#txtChildBankAccURL").val();
            if (url != "") {
                var id = event.target.id;
                if (id == "cmbAccNo") {
                    $("#lbliframeheading").text("Bank");
                    document.getElementById("ifrSMG").src = url + "&ParFFID=cmbAccNo";
                    // Prevent default action if any (e.g., browser F8 behavior)
                    event.preventDefault();
                    // Open the modal when F8 is pressed
                    modaliframe.style.display = "block";
                }
            }
            else {
                showErrorSnackbar("Dependancy info not found");
            }
        }
    });
</script>