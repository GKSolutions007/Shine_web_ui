<script>
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                $(".clrdiv").html("");
                nMode = 3;
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                var BankAccID = rowData.BankAccID;//[1];
                var RefNo = rowData.Refno;//[2];
                var BankAccName = rowData.BankAccName;//[3];
                var StartNo = rowData.StartingNo;//[4];
                var Noofleaves = rowData.NoofLeaves;//[5];
                var Active = rowData.Active;//[6];
                GetData(6, ID);
                $("#txtID").val(ID), $("#txtRefNo").val(RefNo), $("#cmbAccNo").val(BankAccID), $("#txtStartingNo").val(StartNo), $("#txtNoofleaves").val(Noofleaves),
                    $("#chkActive").prop("checked", Active == "Yes" || Active == "True");
                $(".FormclrField,#cmbAccNo").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbAccNo").prop("disabled", true);
                $("#tblChequeleaves").prop("disabled", true);
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                var BankAccID = rowData.BankAccID;//[1];
                var RefNo = rowData.Refno;//[2];
                var BankAccName = rowData.BankAccName;//[3];
                var StartNo = rowData.StartingNo;//[4];
                var Noofleaves = rowData.NoofLeaves;//[5];
                var Active = rowData.Active;//[6];
                GetData(6, ID);
                $("#txtID").val(ID), $("#txtRefNo").val(RefNo), $("#cmbAccNo").val(BankAccID), $("#txtStartingNo").val(StartNo), $("#txtNoofleaves").val(Noofleaves),
                    $("#chkActive").prop("checked", Active == "Yes" || Active == "True");
                //$(".FormclrField").prop("disabled", false);

                $("#btnSave,#cmbAccNo").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $("#tblChequeleaves").prop("disabled", false);
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>


<script type="text/javascript">    
    var TableChqs = $('#tblChequeleaves').DataTable({
        "bSearchable": true,
        "bInfo": false,
        "bPaginate": false,
        "ordering": true,
        "bFilter": false,
        scrollY: "200px",
        scrollX: true,
        scrollCollapse: true,
    });
    var modal = new bootstrap.Modal(document.getElementById('myModalfg')); //document.getElementById("myModalfg");
    //var span = document.getElementsByClassName("closefg")[0];
    //span.onclick = function () {
    //    modal.hide();
    //}
    function CloseForm() {
        modal.hide();
    }

    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    var Aurl = '@Session["APIurl"]';
    
    if ($("#txtModifyID").val() == 0 && $("#txtViewID").val() == 0 && $("#txtAddID").val() == 1) {
        $("#dvMainTable").hide();
    }
    var arrData = [];

    var grid, ChequeBook;
    GetColumnSettingsData(2, 7, 1);
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    var arrStatus = [];
    GetData(5,"");
    GetData(7, "");
    GetData(8, "");
    //GetData(3);
    function GetData(dMode, Value ="") {
        $.ajax({
            url: Aurl + "chequebook/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: dMode, Name: Value },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (dMode == 5) {
                    ChequeBook = data;
                    arrData = [];
                    if (data.length == 0) {
                        showErrorSnackbar("No Records Found");
                    }                   
                        $.each(data, function (i, items) {
                            //arrData[i] = items.Refno
                            var al = {
                                "label": items.Refno,
                                "id": items.ID,
                            }
                            arrData.push(al);                           
                        });

                        var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, ChequeBook, {
                            enablePagination: true,
                            pageSize: ItemsperPage,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                            enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                            enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                            enableSorting: true,
                            searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                            rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                            //onCellChange: handleCellUpdate,
                            customCellRenderer: (el, col, rowData) => {
                                if (col.field === 'Active') {
                                    const val = rowData[col.field];
                                    console.log("Active : ", val);
                                    if (val === 'True') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                                    } else if (val === 'False') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                                    }
                                }
                            },
                            customButtons: [
                                {
                                    icon: '⚙️',
                                    text: 'Settings',
                                    title: 'Settings',
                                    visible: true,
                                    onClick: (gridInstance, event) => {
                                        //console.log("gridInstance : ", gridInstance);
                                        //console.log("event : ", event);
                                        //alert('Settings clicked! Total rows: ' + gridInstance.originalData.length);
                                        /*modalGenColumnSettings.style.display = "block";*/
                                        modalGenColumnSettings.show();
                                        GendralColumnSettings(1, 7, 1, 0);
                                    }
                                },
                                {
                                    icon: '➕',
                                    text: 'Add New',
                                    title: 'Add New',
                                    visible: $("#txtAddID").val() == 1,
                                    onClick: (gridInstance, event) => {
                                        //console.log("gridInstance : ", gridInstance);
                                        //console.log("event : ", event);
                                        //alert('Settings clicked! Total rows: ' + gridInstance.originalData.length);
                                        nMode = 1;
                                        TableChqs.draw().clear();
                                        $("#chkActive,#btnSave,#cmbAccNo,#btnClear,.FormclrField").prop("disabled", false);
                                        $("#txtNoofleaves").prop("disabled", true);
                                        $("#cmbAccNo").val(0);
                                        $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                        modal.show();
                                        ClearForm();
                                    }
                                },
                            ],
                            onCellClick: (rowData, fieldName, cellValue, column) => {
                                //let message = `Clicked Cell:\n`;
                                //message += `• Field: ${fieldName}\n`;
                                //message += `• Value: ${cellValue}\n\n`;
                                //message += `Row Data:\n`;
                                //for (const key in rowData) {
                                //    if (key !== '_gridId') {
                                //        message += `• ${key}: ${rowData[key]}\n`;
                                //    }
                                //}
                                //alert(message);
                            },
                            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                                //// Double-click handler - shows JSON format
                                //let message = `Double-Clicked Cell:\n`;
                                //message += `• Field: ${fieldName}\n`;
                                //message += `• Value: ${cellValue}\n\n`;
                                //message += `Full Row Data:\n${JSON.stringify(rowData, null, 2)}`;
                                //alert(message);
                            },
                            onColumnResize: (colIndex, field, header, newWidth) => {
                                UpdateColumnWidth(7, 1, 0, colIndex, field, newWidth)
                            },
                        });

                        $("#txtRefNo").autocomplete({
                            minLength: 0,
                            source: arrData,
                            //autoFocus: true,
                            //focus: function (event, ui) {
                            //    $("#txtName").val(ui.item.label);
                            //    return false;
                            //},
                            select: function (event, ui) {
                                $("#txtRefNo").val(ui.item.label);
                                //$("#txtRemarks").val(ui.item.id);
                                return false;
                            },
                        }).autocomplete("instance")._renderItem = function (ul, item) {
                            return $("<li class='each'>")
                                .append("<div class='acItem'><span class='name'>" +
                                    item.label + "</span></div>")
                                .appendTo(ul);
                        };
                }
                else if (dMode == 6) {
                    TableChqs.draw().clear();
                    var anyStatus5 = false;
                    $.each(data, function (i, items) {
                        var enbordisb = (items.Status == 5 || nMode == 3) ? "disabled" : "";
                        if (!anyStatus5)
                            anyStatus5 = items.Status == 5;
                        var clscmb = "clscmbsts" + (i);
                        var Selc = '<select ' + enbordisb + ' id=' + items.ChequeNo + ' class="form-control ' + clscmb + '"> ';
                        var arrstslen = items.Status == 5 ? arrStatus.length : (arrStatus.length - 1);
                        for (var j = 0; j < arrstslen; j++) {
                                Selc += '<option value="' + arrStatus[j].ID + '">' + arrStatus[j].Status + '</option> '
                        }
                        Selc += ' </select>';
                        TableChqs.row.add([
                            (i + 1),
                            items.ChequeNo,
                            Selc,
                        ]).draw(false);
                        $("#" + items.ChequeNo).val(items.Status)
                    });
                    //if (anyStatus5) {
                    $("#chkActive,.FormclrField,#cmbAccNo").prop("disabled", anyStatus5);
                    //}
                }
                else if (dMode == 7) {
                    $('#cmbAccNo').find("option").remove();
                    $('#cmbAccNo').append($('<option/>', {
                        value: 0,
                        text: "-- Select Account --",
                        class: ""
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbAccNo').append($('<option/>', {
                            value: items.ID,
                            text: items.ChequeNo,
                        }));
                    });
                }
                else if (dMode == 8) {
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            var liststs = {
                                "ID": items.ID,
                                "Status": items.ChequeNo
                            }
                            arrStatus.push(liststs);
                        });
                    }
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $("#txtStartingNo").keyup(function (e) {
        var val = e.target.value;
        $("#txtNoofleaves").prop("disabled", true);
        $("#txtNoofleaves").val("");
        TableChqs.draw().clear(); TableChqs.draw().clear();
        if (val.length == 6) {
            $("#txtNoofleaves").prop("disabled", false);
        }
    });
    $("#txtNoofleaves").focusout(function () {
        TableChqs.draw().clear(); TableChqs.draw().clear();
        var startNo = parseInt($("#txtStartingNo").val());
        var count = parseInt($("#txtNoofleaves").val());
        var IsDisable = nMode == 1 ? "disabled" : "";
        for (var i = 0; i < count; i++) {
            var ChqNo = (startNo + i);
            var clscmb = "clscmbsts" + (i);
            var Selc = '<select ' + IsDisable +' id=' + ChqNo + ' class="form-control ' + clscmb + '">';
            for (var j = 0; j < (arrStatus.length - 1); j++) {
                Selc += '<option value="' + arrStatus[j].ID + '">' + arrStatus[j].Status + '</option> '
            }
            Selc += ' </select>';
            TableChqs.row.add([
                (i + 1),
                ChqNo,
                Selc
            ]).draw(false);
            $("#" + ChqNo).val(1);
        }
    });    
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        TableChqs.draw().clear();
        $(".FormclrField").val("");
        $("#cmbAccNo").val(0)
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#txtRefNo").focus();
        TableChqs.draw().clear();
        if (nMode != 1)
            modal.hide();
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        var IsValid = true;
        if ($("#txtRefNo").val() == "") {
            IsValid = false;
            $("#dvErrorRefNo").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        if ($("#txtStartingNo").val() == "") {
            IsValid = false;
            $("#dvErrorStartingNo").html("Starting No should not be empty");
            showErrorSnackbar("Starting No should not be empty");
        }
        console.log(parseInt($("#txtNoofleaves").val()));
        if ($("#txtNoofleaves").val() == "") {
            IsValid = false;
            $("#dvErrorNoofleaves").html("No.of leaves should not be empty");
            showErrorSnackbar("No.of leaves should not be empty");
        }
        else if (parseInt($("#txtNoofleaves").val()) <= 0) {
                IsValid = false;
                $("#dvErrorNoofleaves").html("No.of leaves should be greater than zero");
                showErrorSnackbar("No.of leaves should be greater than zero");
            }

        if ($("#cmbAccNo").val() == 0) {
            $("#dvErrorAccNo").html("Select Bank Account");
            showErrorSnackbar("Select Bank Account");
            IsValid = false;
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var lstvData = [];
        $('#tblChequeleaves tr td select').each(function (i, items) {
            var singlelist = {
                "ChequeNo": items.id,
                "Status": items.value,
            }
            lstvData.push(singlelist);
        });
        var lstMaster = {
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "Refno": $("#txtRefNo").val(),
            "BankAccID": $("#cmbAccNo").val(),
            "StartingNo": $("#txtStartingNo").val(),
            "NoofLeaves": $("#txtNoofleaves").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID,
            "CBDetails": lstvData
        };
        $.ajax({
            url: Aurl + "chequebook/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        ClearForm();
                        GetData(5, "");
                        modal.hide();
                    }
                    else {
                        $("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                    }
                });
            }, error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    window.addEventListener('keydown', function (event) {
        // Check if the F8 key is pressed (key code 119)
        if (event.keyCode === 119) {
            var url = $("#txtChildBankAccURL").val();
            if (url != "") {
                var id = event.target.id;
                if (id == "cmbAccNo") {
                    $("#lbliframeheading").text("Bank");
                    document.getElementById("ifrSMG").src = url + "&ParFFID=cmbAccNo";
                    // Prevent default action if any (e.g., browser F8 behavior)
                    event.preventDefault();
                    // Open the modal when F8 is pressed
                    modaliframe.style.display = "block";
                }
            }
            else {
                showErrorSnackbar("Dependancy info not found");
            }
        }
    });

