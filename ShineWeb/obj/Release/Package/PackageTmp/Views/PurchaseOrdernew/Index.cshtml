                            <table>
                                <tr>
                                    <td hidden>
                                        <button id="btnAdd" class="btn btn-info">
                                            Add
                                        </button>
                                    </td>

                                    <td class="ps-2 p-0" width="15%">
                                        <span class="form-label">
                                            <select class="form-control FormclrcmbField" id="cmbFilterBranch">
                                                <option value="0">Select Branch</option>
                                            </select>
                                            <label class="labelup">Branch</label>
                                        </span>
                                    </td>

                                    <td class="ps-2 p-0" width="30%">
                                        <span class="form-label">
                                            <input tabindex="1" class="form-control FormfilterclrField" type="text" id="txtFilterParty">
                                            <label class="labelup">Party</label>
                                        </span>
                                        <div id="divErrFParty" class="clrdivs text-danger pt-1 ps-1"></div>
                                    </td>

                                    <td class="ps-2 p-0" width="6%">
                                        <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                                    </td>

                                    <td class="p-0" width="12%">
                                        <span class="form-label">
                                            <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFFrom">
                                            <label class="labelup">From</label>
                                        </span>

                                        <div id="divErrFFrom" class="clrdivs text-danger pt-1 ps-1"></div>
                                    </td>

                                    <td class="ps-2 p-0" width="12%">
                                        <span class="form-label">
                                            <input tabindex="1" class="form-control FormfilterclrField" type="date" id="dtpFTo">
                                            <label class="labelup">To</label>
                                        </span>

                                        <div id="divErrFTo" class="clrdivs text-danger pt-1 ps-1"></div>
                                    </td>

                                    <td class="ps-2 p-0" width="8%">
                                        <input tabindex="1" class="FormfilterclrField" type="checkbox" id="chkShowAll">
                                        <label for="chkShowAll" class="fs-6">All Status</label>
                                    </td>

                                    <td class="ps-2 p-0" width="12%">
                                        <button id="btnFilter" class="btn btn-filter-style">
