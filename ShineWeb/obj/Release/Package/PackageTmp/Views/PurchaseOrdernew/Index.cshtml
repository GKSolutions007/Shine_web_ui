            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, CodeName: strName, ID: strID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                //ProductTable.draw().clear(); ProductTable.draw().clear()
                G.clearAllRows();
                G.setLocked(nTransMode == 4 || nTransMode == 5);

                $.each(data, function (i, items) {
                    var rdo1 = $("#rdoMainTableData").is(":checked");
                    if (rdo1) {
                        $("#txtID").val(items.ID);
                    } else {
                        $("#txtDraftID").val(items.ID);
                    }
                    $("#txtVendorID").val(items.VendorID);
                    $("#dtpDate").val(items.Date), $("#cmbBranch").val(items.BranchID);
                    if (nTransMode != 3) {
                        $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);
                    }
                    $("#txtRefNo").val(items.RefNo),

                        updateInputColumn("txtRoundOff", items.RoundOffAmt);//$("#txtRoundOff").val(items.RoundOffAmt),
                    updateLabelColumn("lblPTGross", items.GrossAmt);//$("#lblPTGross").text(items.GrossAmt),
                    updateLabelColumn("lblPTTax", items.TaxAmt);//$("#lblPTTax").text(items.TaxAmt),
                    updateLabelColumn("lblRoundNet", items.NetAmt);//$("#lblRoundNet").text(items.NetAmt),
                    $("#txtRemarks").val(items.Remarks);
                    $("#txtNarration").val(items.Narration);
                    //$("#txtStatus").val(items.Status);
                    $("#cmbUOMType").val(items.UOMType);
                    $.each(items.lstPartyInfo, function (i, itemsParty) {
                        $("#txtSearch").val(itemsParty.Name),
                            $("#lblName").text(itemsParty.Code),
                            $("#cmbRating").text(itemsParty.Ratings),
                            $("#lblMob1").text(itemsParty.Mob1),
                            $("#lblGSTIN").text(itemsParty.GSTIN),
                            $("#txtBAdd1").val(itemsParty.Billadd1),
                            $("#txtBAdd2").val(itemsParty.Billadd2),
                            $("#txtBAdd3").val(itemsParty.Billadd3),
                            $("#txtSAdd1").val(itemsParty.Shipadd1),
                            $("#txtSAdd2").val(itemsParty.shipadd2),
                            $("#txtSAdd3").val(itemsParty.Shipadd3),
                            $("#txtPincode").val(itemsParty.Pincode);
                            $("#lblOpenPOCount").text(itemsParty.POopen),
                            $("#lblOpenAICount").text(itemsParty.AIopen);
                    });
                    var disbfields = nTransMode == 4 || nTransMode == 5 ? "disabled" : "";
                    var hdnfields = nTransMode == 4 || nTransMode == 5 ? "hidden" : "";
                    ProductRID = 0;
                    var dataSet = items.lstProdGrid.map(function (itemsProd, nRowIndex) {
                        const t = taxById(itemsProd.TaxID) || taxOf(itemsProd.TaxPern);                // item tax (TaxID, else by GST %)
                        var uomforselprod = [{
                            ID: itemsProd.UomID,
                            Name: itemsProd.UomName,
                            ConvRate: itemsProd.UOM
                        }];
                        G.addRow();
                        G.patch(nRowIndex, {
                            itemName: itemsProd.Name, code: itemsProd.Code, productID: +itemsProd.ProdID || 0, mrp: +itemsProd.MRP || 0, stock: parseFloat(itemsProd.ABSQty).toFixed(DecVal),
                            ApponMRPCum: itemsProd.MRPonTax, MRPonTaxAmt: itemsProd.MRPonTax,
                            priceExcl: +itemsProd.ExclPrice || 0, priceIncl: +itemsProd.InclPrice || 0,
                            qty: +itemsProd.Qty || 0,
                            _uoms: uomforselprod, uomID: +itemsProd.UomID || 0,          // item's own UOM list + its default UOM -> dropdown is rebound in the row
                            taxID: t ? +t.ID : 0, taxPct: t ? +t.TaxPern : (+itemsProd.TaxPern || 0),
                            gross: itemsProd.GrossAmt, taxAmt: itemsProd.TaxAmt, net: itemsProd.NetAmt
                        }, 'itemsProd');
                    });

                    if (nTransMode == 1 || nTransMode == 2 || nTransMode == 3) {
                        G.addRow();
                    }
                    G.setLocked(nTransMode == 4 || nTransMode == 5);
                    Scrolltoid($("#lblRoundNet"));
                    var $scrollBody = $(ProductTable.table().node()).parent();
                    $scrollBody.scrollTop($scrollBody.get(0).scrollHeight);
                    //calculateProdGrid();
                    if (nMode != 14) {
                        updateInputColumn("txtRoundOff", items.RoundOffAmt);
                        updateLabelColumn("lblRoundNet", items.NetAmt);
                    }
                    if (nTransMode == 3 || nTransMode == 2)
                        GetData(2, $("#cmbUOMType").val());
                });
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
