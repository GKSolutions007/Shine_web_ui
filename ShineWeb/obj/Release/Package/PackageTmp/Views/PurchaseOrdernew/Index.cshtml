    function setProductBatchInfo(CF) {
        $("#tblBatch tbody tr").each(function () {
            rowdata = TableBatch.row($(this)).data();
            var basepurqty = parseFloat(rowdata[0]);
            var basepurprice = parseFloat(rowdata[1]);
            var basesaleqty = parseFloat(rowdata[2]);
            $(this).find("label").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                var Value = parseFloat($(this).text());
                if (fieldName == "PurchaseQty") {
                    var setvalue = parseFloat(basepurqty / parseFloat(CF)).toFixed(DecVal)
                    $(this).text(setvalue);
                }
                if (fieldName == "PurchasePrice") {
                    var setvalue = parseFloat(basepurprice * parseFloat(CF)).toFixed(DecVal)
                    $(this).text(setvalue);
                }
                if (fieldName == "SaleQty") {
                    var setvalue = parseFloat(basesaleqty / parseFloat(CF)).toFixed(DecVal)
                    $(this).text(setvalue);
                }
            });
        });
        var ABSQty = parseFloat(arrBaseProductBatchInfo[0].ABSQty);
        $("#lblAbsqty").text(parseFloat(ABSQty / CF).toFixed(DecVal));

        //var ABSValue = parseFloat(arrBaseProductBatchInfo[0].ABSValue);
        //$("#lblABSValue").text(parseFloat(ABSValue / CF).toFixed(DecVal));

        var SalesReturnPrice = parseFloat(arrBaseProductBatchInfo[0].SRQty);
        $("#lblRTNQty").text(parseFloat(SalesReturnPrice / CF).toFixed(DecVal));

        var DamageReturnPrice = parseFloat(arrBaseProductBatchInfo[0].DRQty);
        $("#lblDMGRTNQty").text(parseFloat(DamageReturnPrice / CF).toFixed(DecVal));
    }
