    function loadselectedproductdetail(gridrow, rowindex, strName = null, strID = null,absqty = 0) {
        var UOMType = $("#cmbUOMType").val();
        $.ajax({
            url: Aurl + "purchaseorder/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: 4, CodeName: strName, ID: strID },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                console.log("gridrow", gridrow, "data ", data, "ROW index ", rowindex);
                $.each(data, function (i, items) {
                    
                    var UOMName = UOMType == 1 ? items.BaseUOMName : items.PurchaseUomName;
                    var UOMID = UOMType == 1 ? parseInt(items.BaseUomID) : parseInt(items.PurchaseUomID);
                    var UOMCF = UOMType == 1 ? parseInt(items.BaseCR) : parseInt(items.PurchaseCR);
                    var uomforselprod = [{
                        ID: UOMID,
                        Name: UOMName,
                        ConvRate: UOMCF
                    }];
                    const t = taxById(items.PurchaseTaxID) || taxOf(items.GSTPern);                // item tax (TaxID, else by GST %)
                    //gridrow.patch(rowindex, {
                    //    itemName: items.Name, code: items.Code, productID: +items.ID || 0, mrp: +items.MRP || 0,
                    //    TrackInentoryYN: +items.TrackInentoryYN || 0, TrackBatchYN: +items.TrackBatchYN || 0, TrackPKDYN: +items.TrackPKDYN || 0,   // hidden columns
                    //    priceExcl: +items.SalesPrice || 0, taxPct: +items.SalesTaxID || 0
                    //}, 'items');
                    var TaxPern = (parseFloat(items.GSTPern) / 100) + 1;
                    arrPurchaseTaxDetails = ReturnTaxDetails(items.PurchaseTaxID, 1);
                    var dApponMRPCum = arrPurchaseTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
                    var dMRPonTax = getPurchaseMRPontax(items.MRP);
                    console.log("Item Name : ", items.Name);
                    var PPrice = UOMType == 1 ? parseFloat(items.PurchasePrice) : (parseFloat(items.PurchasePrice) * parseFloat(items.PurchaseCR))
                    var InclPPrice = dApponMRPCum > 0 ? PPrice + dMRPonTax : PPrice * TaxPern;
                    gridrow.patch(rowindex, {
                        itemName: items.Name, code: items.Code, productID: +items.ID || 0, mrp: +items.MRP || 0, stock: absqty,
                        ApponMRPCum: dApponMRPCum, MRPonTaxAmt: dMRPonTax, qty: 1,
                        priceExcl: +PPrice || 0,
                        _uoms: uomforselprod, uomID: +UOMID || 0,          // item's own UOM list + its default UOM -> dropdown is rebound in the row
                        taxID: t ? +t.ID : 0, taxPct: t ? +t.TaxPern : (+items.GSTPern || 0)
                    }, 'items'); // fills row, recalculates, refreshes totals
                });

            }
        });
    }
    function getPurchaseMRPontax(MRP) {
        var dTaxAmt = 0;
        var dApponMRPCum = arrPurchaseTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
        for (var i = 0; i < arrPurchaseTaxDetails.length; i++) {
            var nAppon = arrPurchaseTaxDetails[i].AppOn;
            var dCumTax = arrPurchaseTaxDetails[i].CumulativeTax;
            if (nAppon == -1) {
                var dPrice = (MRP / (1 + (dApponMRPCum / 100)));
                dTaxAmt += (dPrice * dCumTax) / 100;
            }
        }

        return dTaxAmt;
    }

