                IsValid = false;
                $("#divErrFParty").html("Select Party Name from list");
            }
        }
        if ($("#txtFilterAccount").val() != "") {
            const exists = arrExpenseData.indexOf($("#txtFilterAccount").val().trim()) !== -1;
