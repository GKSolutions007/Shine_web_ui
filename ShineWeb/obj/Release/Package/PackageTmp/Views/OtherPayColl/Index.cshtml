                        value: 0,
                        text: "-- Select --",
                    }));
                    arrPartyData = [], arrExpenseData = [], arrBranchData = [], arrALPartyData = [], arrALBranchData = [], arrALExpenseData = [], arrALBranchData = [], arrALBranchData = [];
                    nIndexarrParty = 0, nIndexarrAccount = 0, nIndexarrBranch = 0, nIndexarrBranch = 0;
                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            var al = {
                                "label": items.Name,
                            }
                            arrALPartyData.push(al);
                            arrPartyData[nIndexarrParty] = items.Name;
                            nIndexarrParty++;
                        }
                        if (items.FType == 2) {
                            var al = {
                                "label": items.Name,
                            }
                            arrALExpenseData.push(al);
                            arrExpenseData[nIndexarrAccount] = items.Name;
                            nIndexarrAccount++;
                        }
                        if (items.FType == 3) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            $("#lblDocID").text(items.Name);
                        }
                        if (items.FType == 5) {
                            $('#cmbPaymode').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 6) {
                            $('#cmbBTmode').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 7) {
                            var BADetails = (items.Name).split('|');
                            $('#cmbBankAccount').append($('<option/>', {
                                value: items.ID,
                                text: BADetails[0],
                            }));
                            var BAInfo = {
                                "ID": items.ID,
                                "AccNo": BADetails[0],
                                "Bank": BADetails[1],
                                "Branch": BADetails[2],
                                "IFSC": BADetails[3],
                                "MICR": BADetails[4],
                                "FAID" : items.Code
                            }
                            arrBankData.push(BAInfo);
                        }
                        if (items.FType == 8) {
                            $('#cmbBank').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        
                    });
                    SetAutlistforFields();
                    //$("#txtBranchName").val(DefBranch);
                    LoadBranchByRoles('#txtBranchName,#cmbFilterBranch');
                }
                if (nMode == 3) {
                    //~Assign Data
                    $("#cmbChequeNo").val(0);
                    $.each(data, function (i, items) {
                        if (nTransMode != 3)
                            $("#lblDocID").text(items.DocID).attr("docprefix", items.DocPrefix);
                        //$("#txtValue").val(items.NoteValue);

                        updateInputColumn("txtValue",  items.NoteValue);
                            $("#txtID").val(items.ID), $("#dtpDate").val(items.DocDate),
                                $("#txtRefNo").val(items.RefNo), $("#txtBranchName").val(items.BranchID), $("#txtPartyName").val(items.PartyID), $("#txtAccountName").val(items.FAID),
                         $("#txtRemarks").val(items.Remark), $("#txtNarration").val(items.Narration),
                            $("#cmbUDN").val(items.UDFId), $("#txtStatus").val(items.StatusID);
                        $("#rdoOCinOPEx").prop("checked", items.OCPType == "2");
                        $("#rdoOCOPParty").prop("checked", items.OCPType == "3");
                        $("#cmbPaymode").val(items.ContType),
                            $("#cmbBTmode").val(items.ContMode),
                            //$("#txtNEFT").val(items.NEFTNo),
                            //$("#cmbChequeNo").val(items.ChequeNo),
                            //$("#dtpChqueDate").val(items.ChequeDate),
                            updateInputColumn("txtVisaAmt", items.VisaPern); updateInputColumn("txtVisaPern", items.VisaAmt);
                        console.log("items.OCPPMData ", items.OCPPMData);
                        if (items.OCPPMData.length > 0) {
                            var BankAccID = 0;
                            var md = [];
                            if (FID == 11) {
                                md = arrBankData.filter(t => t.FAID == items.OCPPMData[0].BankAccID);
                            } else {
                                md = arrBankData.filter(t => t.ID == items.OCPPMData[0].BankAccID);
                            }
                            if (md.length > 0) {
                                BankAccID = md[0].ID;
                            }
                            if (FID == 11 && $("#cmbPaymode").val() == 2) {
                                GetData(4, BankAccID, items.OCPPMData[0].ChequeID);
                            }
                            if (FID == 10) {//other collection
                                if ($("#cmbPaymode").val() == 4 || $("#cmbPaymode").val() == 5) {
                                    $("#txtNEFT").val(items.OCPPMData[0].NeftID);
                                } else if ($("#cmbPaymode").val() == 2) {
                                    $("#txtNEFT").val(items.OCPPMData[0].ChequeID);
                                }
                            }
                            if (FID == 11) {//other payment
                                if ($("#cmbPaymode").val() == 4 || $("#cmbPaymode").val() == 5) {
                                    $("#txtNEFT").val(items.OCPPMData[0].NeftID);
                                } else if ($("#cmbPaymode").val() == 2) {
                                    $("#txtNEFT").val(items.OCPPMData[0].ChequeID);
                                }
                            }
                            //if (FID == 10 && $("#cmbPaymode").val() == 4)
                            //    $("#txtNEFT").val(items.OCPPMData[0].NeftID);
                            //else
                            //    $("#txtNEFT").val(items.OCPPMData[0].ChequeID);

                            //$("#cmbChequeNo").val(items.OCPPMData[0].ChequeID);
                            $("#dtpChqueDate").val(items.OCPPMData[0].Date);
                            $("#cmbBankAccount").val(BankAccID);//items.OCPPMData[0].BankAccID
                            $("#txtIFSC").val(items.OCPPMData[0].IfscCode);
                            $("#cmbBank").val(items.OCPPMData[0].BankName);
                            $("#txtBranch").val(items.OCPPMData[0].BranchName);
                        }
                        EnableDisableFields();
                        if ($("#cmbPaymode").val() != 1 && md.length > 0) {//cash
                            var faid = md[0].FAID;
                            GetClosingBalance(6, faid, $("#dtpDate").val());
                        } else if ($("#cmbPaymode").val() == 1) {
                            GetClosingBalance(6, 13, $("#dtpDate").val());
                            $("#lblBalance").text("0.00");
                        } else {

                        }
                        modal.show();
                    });
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#txtBranchName").prop("disabled", true);
                    }
                }
                if (nMode == 4) {
                    $('#cmbChequeNo').find("option").remove();
                    $('#cmbChequeNo').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbChequeNo').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    $("#cmbChequeNo").val(strVal);
                }
                if (nMode == 6 || nMode == 7) {// type change
                    $("#lblBalance").text("0.00");
                    $.each(data, function (i, items) {
                        var bal = parseFloat(items.Balance).toFixed(DecVal) + " " + items.ContType;
                        $("#lblBalance").text(bal);
                    });
                }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    function GetClosingBalance(nMode, nID, strVal = "") {
        $.ajax({
            url: Aurl + "contra/get",
            type: 'get',
            contentType: 'json',
            data: { TransID: FID, Mode: nMode, ID: nID, Value: strVal },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 6) {// type change
                    $("#lblBalance").text("0.00");
                    $.each(data, function (i, items) {
                        var bal = parseFloat(items.Balance).toFixed(DecVal) + " " + items.ContType;
                        $("#lblBalance").text(bal);
                    });
                }
            }
        });
    }

