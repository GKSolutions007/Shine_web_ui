                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbUDN,#cmbPaymode,#cmbBTmode,#cmbBankAccount,#cmbChequeNo,#cmbBank,#txtBranchName').find("option").remove();
