<script>
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                var ID = rowData.ID;//[0];
                GetData(4, ID);
                $(".FormclrField").prop("disabled", true);
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                $("#chkActive,#btnSave,#btnClear,#cmbTax").prop("disabled", true);
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                $(".clrdiv").html("");
                nMode = 2;
                var ID = rowData.ID;//[0];
                GetData(4, ID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbTax").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>

<script type="text/javascript">
   
    var Aurl = '@Session["APIurl"]';
    
    if ($("#txtModifyID").val() == 0 && $("#txtViewID").val() == 0 && $("#txtAddID").val() == 1) {
        $("#dvMainTable").hide();
    }
    var grid, Services;
    GetColumnSettingsData(2, 3, 1);
    function displayResult(item) {
        $('.alert').show().html('You selected <strong>' + item.value + '</strong>: <strong>' + item.text + '</strong>');
    }
    var arrData = [];
    var UID = '@Session["LoginUserID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    GetData(3);
    GetData(5);
    function GetData(nMode,nID = 0) {
        $.ajax({
            url: Aurl + "service/get",
            /*url: "http://localhost:44396/api/singlemaster/get",*/
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: nMode, Name: nID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {                                    
                if (nMode == 3) {
                    if (data.length == 0) {
                        showErrorSnackbar("No Records Found");
                    }
                    Services = data
                        arrData = [];
                        $.each(data, function (i, items) {
                            //arrData[i] = items.Name
                            var al = {
                                "label": items.Name,
                                "active": items.Active,
                                "id": items.ID,
                            }
                            arrData.push(al);                            
                        });

                        var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, Services, {
                            enablePagination: true,
                            pageSize: ItemsperPage,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                            enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                            enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                            enableSorting: true,
                            searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                            rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                            //onCellChange: handleCellUpdate,
                            customCellRenderer: (el, col, rowData) => {
                                if (col.field === 'Active') {
                                    const val = rowData[col.field];
                                    console.log("Active : ", val);
                                    if (val === 'True') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                                    } else if (val === 'False') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                                    }
                                }
                            },
                            customButtons: [
                                {
                                    icon: '⚙️',
                                    text: 'Settings',
                                    title: 'Settings',
                                    visible: true,
                                    onClick: (gridInstance, event) => {
                                        //console.log("gridInstance : ", gridInstance);
                                        //console.log("event : ", event);
                                        //alert('Settings clicked! Total rows: ' + gridInstance.originalData.length);
                                        /*modalGenColumnSettings.style.display = "block";*/
                                        modalGenColumnSettings.show();
                                        GendralColumnSettings(1, 3, 1, 0);
                                    }
                                },
                                {
                                    icon: '➕',
                                    text: 'Add New',
                                    title: 'Add New',
                                    visible: $("#txtAddID").val() == 1,
                                    onClick: (gridInstance, event) => {
                                        //console.log("gridInstance : ", gridInstance);
                                        //console.log("event : ", event);
                                        //alert('Settings clicked! Total rows: ' + gridInstance.originalData.length);
                                        nMode = 1;
                                        $("#chkActive,#btnSave,#cmbTax,#btnClear,.FormclrField").prop("disabled", false);
                                        $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                        modal.show();
                                        ClearForm();
                                    }
                                },
                            ],
                            onCellClick: (rowData, fieldName, cellValue, column) => {
                                
                            },
                            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {                                
                            },
                            onColumnResize: (colIndex, field, header, newWidth) => {
                                UpdateColumnWidth(3, 1, 0, colIndex, field, newWidth)
                            },
                        });
                        $("#txtName").autocomplete({
                            minLength: 0,
                            source: arrData,
                            //autoFocus: true,
                            //focus: function (event, ui) {
                            //    $("#txtName").val(ui.item.label);
                            //    return false;
                            //},
                            select: function (event, ui) {
                                $("#txtName").val(ui.item.label);
                                //$("#txtRemarks").val(ui.item.id);
                                return false;
                            },
                        }).autocomplete("instance")._renderItem = function (ul, item) {
                            return $("<li class='each'>")
                                .append("<div class='acItem'><span class='name'>" +
                                    item.label + "</span></div>")
                                .appendTo(ul);
                        };
                    }
                    else if (nMode == 4) {
                        $.each(data, function (i, items) {
                            $("#txtID").val(items.ID);
                            $("#txtName").val(items.Name);
                            $("#txtSAC").val(items.SACCode);
                            $("#cmbTax").val(items.TaxID);
                            updateInputColumn("txtInwardPrice", items.Inwardprice);
                            updateInputColumn("txtOutwardPrice", items.Outwardprice);
                            $("#chkActive").prop("checked", items.Active == "True");
                        });
                    }
                    else {
                        $('#cmbTax').find("option").remove();
                        $('#cmbTax').append($('<option/>', {
                            value: 0,
                            text: "-- Select Tax --",
                            class: ""
                        }));
                        $.each(data, function (i, items) {
                            $('#cmbTax').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        });
                    }
                
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
        var DecVal = '@Session["DecimalValues"]';
function updateInputColumn(inputID, netValue) {
    //const label = document.getElementById(`dgvProdGross${rowId}`);
    const input = document.getElementById(inputID);
    var value = netValue != "" ? netValue : 0;
    input.setAttribute('txttag', parseFloat(value).toFixed(4));
    input.value = parseFloat(value).toFixed(DecVal);
    input.title = netValue;
}
    $(".txtsettag").focusin(function (e) {
        var id = e.target.id;
        const val = document.getElementById(id).getAttribute("txttag");
        $("#" + id).val(val);
        $("#" + id).select();
    });
    $(".txtsettag").blur(function (e) {
        var val = e.target.value;
        var id = e.target.id;
        updateInputColumn(id, val);
    });
    function SetTagZero() {
        var inputs = $(".txtsettag");
        for (var i = 0; i < inputs.length; i++) {
            var field = $(inputs[i]);
            var FID = field[0].id;
            updateInputColumn(FID, "0");
        }
    }
    var modal = new bootstrap.Modal(document.getElementById('myModalfg')); //document.getElementById("myModalfg");
    var span = document.getElementsByClassName("closefg")[0];
    //span.onclick = function () {
    //    modal.hide();
    //}
    function CloseForm() {
        modal.hide();
    }

    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
   
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".FormclrField").val("");
        $("#cmbTax").val(0)
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        SetTagZero();
        $(".clrdiv").html("");
        $("#txtName").focus();
        
        if (nMode != 1)
            modal.hide();
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        var IsValid = true, ChkFormation = true;
        if ($("#txtName").val() == "") {
            IsValid = false;
            $("#dvErrorName").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        if ($("#cmbTax").val() == 0) {
            IsValid = false;
            $("#dvErrorTax").html("Select Tax");
            showErrorSnackbar("Select Tax");
        }
        ChkFormation = SACValidation($("#txtSAC"), $("#dvErrorSAC"));
        if (!ChkFormation) {
            IsValid = false;
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $(".clrdiv").html("");
        $("#btnSave").prop("disabled", true);
        var lstMaster = {
            "FormID": FID,
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "Name": $("#txtName").val(),
            "TaxID": $("#cmbTax").val(),
            "SACCode": $("#txtSAC").val(),
            "Inwardprice": document.getElementById("txtInwardPrice").getAttribute("txttag"),//$("#txtInwardPrice").val(),
            "Outwardprice": document.getElementById("txtOutwardPrice").getAttribute("txttag"),//$("#txtOutwardPrice").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID
        };
            $.ajax({
                url: Aurl + "service/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                            GetData(3);
                            modal.hide();
                        }
                        else {
                            $("#dvErrorName").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }   
    function GetColumnSettingsData(nMode, nFormID, nTableID) {
        $.ajax({
            url: Aurl + "columnsettings/getcolumnsettings",
            /*url: "http://localhost:44396/api/singlemaster/get",*/
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, FormID: nFormID, TableID: nTableID, FormorReport: 0 },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                if (data.length > 0) {
                    columns = (data);
                    console.log("columns : ", columns);
                    columns.push(actions);
                } else {
                    showErrorSnackbar("No column data found");
                }
            }
        });
    }

</script>