<style>
    td {
        font-size: 12px;
    }
    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    
    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -40%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    tr {
        cursor: pointer
    }
</style>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 20px;
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
    }

    .container {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .left-section {
        flex: 1;
        min-width: 200px;
    }

    .right-section {
        flex: 2;
        min-width: 300px;
        display: flex;
        flex-direction: column;
        gap: 0px;
    }

    .party-box {
        background-color: #e6f1fb;
        padding: 2px;
        min-height: 550px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

    .party-info-box {
        background-color: #fffde8;
        padding: 10px;
        min-height: 100px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    }

  

    /* Collapsed state: left section shrinks to a slim rail, right section reclaims the space */
    .container.left-collapsed .left-section {
        flex: 0 0 52px;
        min-width: 52px;
        max-width: 52px;
    }

    .container.left-collapsed .right-section {
        flex: 1 1 0;
    }

    .party-box-content {
        opacity: 1;
        transition: opacity 0.2s ease 0.1s, visibility 0.2s ease 0.1s;
    }

    .container.left-collapsed .party-box-content {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.15s ease, visibility 0.15s ease;
    }

    .collapse-toggle-btn {
        position: absolute;
        top: 0px;
        right: 10px;
        z-index: 20;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: none;
        border-radius: 50%;
        background-color: transparent;
        color: #1a6fb5;
        cursor: pointer;
       /* box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);*/
        transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

        .collapse-toggle-btn:hover {
            background-color: #1a6fb5;
            color: #ffffff;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3);
            transform: scale(1.08);
        }

        .collapse-toggle-btn:active {
            transform: scale(0.95);
        }

        .collapse-toggle-btn .toggle-icon {
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

    .container.left-collapsed .collapse-toggle-btn .toggle-icon {
        transform: rotate(180deg);
    }

    /* Vertical label shown only while the left panel is collapsed */
    .collapsed-label {
        position: absolute;
        top: 100px;
        left: 50%;
        transform: translateX(-50%) rotate(90deg);
        transform-origin: center;
        white-space: nowrap;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: #1a6fb5;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease 0.15s, visibility 0.2s ease 0.15s;
    }

    .container.left-collapsed .collapsed-label {
        opacity: 1;
        visibility: visible;
    }

    .party-box {
        background-color: #e6f1fb;
        padding: 2px;
        min-height: 550px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
        position: relative;
        transition: background-color 0.3s ease;
    }

    .container.left-collapsed .party-box {
        background-color: #d7e9f8;
    }

    .party-info-box {
        background-color: #fffde8;
        padding: 10px;
        min-height: 100px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
        animation: fadeSlideIn 0.4s ease;
    }
    
    .documents-box {
        background-color: #ffffff;
        padding: 2px;
        min-height: 500px;
        border: 1px solid #ccc;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
        animation: fadeSlideIn 0.4s ease;
    }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 768px) {
        .container {
            flex-direction: column;
            flex-wrap: wrap;
        }

        .left-section,
        .right-section {
            flex: 1 0 100% !important;
            max-width: 100% !important;
            min-width: 100% !important;
        }

        .party-box-content,
        .collapsed-label {
            display: none !important;
        }

        .collapse-toggle-btn {
            display: none;
        }
    }

    @@media (min-width: 1200px) {
        .container {
            max-width: 100% !important;
            gap: 1px !important;
        }
    }
</style>
