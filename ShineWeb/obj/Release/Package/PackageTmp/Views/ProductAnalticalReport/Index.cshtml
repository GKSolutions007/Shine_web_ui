<script type="text/javascript">
    var DecVal = '@Session["DecimalValues"]';
    var Aurl = '@Session["APIurl"]';
    var companyName = '@Session["companyname"]';
    var SelectTableID = 1;
    var tblReportSettings = $('#tblReportSettings').DataTable({
        "bFilter": false,
        "bSearchable": false,
        "bInfo": false,
        "bPaginate": false,
        "ordering": false,
        scrollY: "250px",
        "columnDefs": [{ "targets": [0, 1, 2], "visible": false, searchable: false }],
    });

    var grid;
    var Grid1;
    var Grid2, columns = [], documentcolumnsettings = [];
    var columnsettings = [];
    var Grid1Columns = ReturnColumnSettingsData(2, 1002, 1)
    var Grid2Columns = ReturnColumnSettingsData(2, 1002, 2);
    function ClearForm()
    {
        $("#lblLastTransDate").text("--");
        $("#lblRatingName,#lblAccValue").text("");
        $("#lblYearlySales,#lblMonthlySales,#lblYearlyReturn,#lblMonthlyReturn").text("0.00");
        $("input[name=rating]").prop("checked", false);
    }
    $("#ProductInfo").click(function () {
        if (ProductInfo.length > 0) {
            var Partydata = `
            <table id="partyDetailsVertical" border="1" cellspacing="0" cellpadding="8" style="width:100%; border-collapse: collapse;">
    <tbody>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Code</th>
            <td>`+ ProductInfo[0].Code+`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Name</th>
            <td>`+ ProductInfo[0].Name +`</td>
        </tr>
        <tr>
    <th style="text-align:left;background-color:#eeeeee;">HSN</th>
    <td>`+ ProductInfo[0].HSNCode +`</td>
</tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Manufacturer</th>
            <td>`+ ProductInfo[0].Manuf +`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Brand</th>
            <td>`+ ProductInfo[0].Brand +`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Category</th>
            <td>`+ ProductInfo[0].Category +`</td>
        </tr>
        <tr>
            <th style="text-align:left;background-color:#eeeeee;">Tax</th>
            <td>`+ ProductInfo[0].TaxName +`</td>
        </tr>
        <tr>
    <th style="text-align:left;background-color:#eeeeee;">ECP</th>
    <td>`+ ProductInfo[0].ECP +`</td>
</tr>
                <tr>
            <th style="text-align:left;background-color:#eeeeee;">MRP</th>
            <td>`+ ProductInfo[0].MRP + `</td>
        </tr>
        <tr>
    <th style="text-align:left;background-color:#eeeeee;">SPL Price</th>
    <td>`+ ProductInfo[0].SPLPrice +`</td>
</tr>
    </tbody>
</table>`
            InfoDialogMsg(Partydata, 'Product Info');
        } else {
            showErrorSnackbar("Select Product");
        }
    });
    $("#ProductInfo").hide();
    $("#btnToggleLeft").click(function (e) {
        e.stopPropagation();
        var $container = $(".container");
        var isCollapsed = $container.toggleClass("left-collapsed").hasClass("left-collapsed");
        $(this).attr("title", isCollapsed ? "Expand Panel" : "Collapse Panel");
        // Give the grid a moment to settle into the newly freed/reclaimed space before resizing it
        setTimeout(function () {
            $(window).trigger("resize");
        }, 380);
    });
    setTimeout(() => {
        GetProduct();
    }, 1000);
    
    function GetProduct() {
        $.ajax({
            url: Aurl + "productanalticalreport/getproduct",
            type: 'get',
            contentType: 'json',
            data: {  },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                bindDataTable(eval(data))
            }
        });
    }
    var ProductInfo = [];
    function GetProductDocuments(nProdID) {
        $("#lblStockValue,#lblPurchasePrice,#lblSalesPrice,#lblStockQty,#lblDmgStockQty,#lblDmgStockValue,#lblFreeStockQty").text("");
        $.ajax({
            url: Aurl + "productanalticalreport/getdocuments",
            type: 'get',
            contentType: 'json',
            data: { ProductID: nProdID },
            xhrFields: {
                withCredentials: true
            },
            async: false,
            success: function (data) {
                if (data)//.length > 0
                {
                    var PartyDocuments = eval(data.Documents);
                    ProductInfo = eval(data.ProductInfo);
                    $("#lblStockQty").text(Valuewithcomma(ProductInfo[0].ActualQty));
                    $("#lblPurchasePrice").text(Valuewithcomma(ProductInfo[0].PurchasePrice));
                    $("#lblSalesPrice").text(Valuewithcomma(ProductInfo[0].SalesPrice));
                    $("#lblStockValue").text(Valuewithcomma(ProductInfo[0].ActualValue));
                    $("#lblDmgStockQty").text(Valuewithcomma(ProductInfo[0].ActualDmgQty));
                    $("#lblDmgStockValue").text(Valuewithcomma(ProductInfo[0].ActualDmgValue));
                    $("#lblFreeStockQty").text(Valuewithcomma(ProductInfo[0].ActualFreeQty));

                    bindDocumentDataTable(PartyDocuments)
                } else {
                    showErrorSnackbar("No records found");
                }
            }
        });
    }
    var DocGridSearchValue = "";
    function bindDataTable(data) {
        if (data.length === 0) {
            return; // No data to display
        }
        var Reporthd = "Product Analtical Report";
        var nHeight = "500px";
        console.log("bindDataTable columnsettings ", Grid1Columns);
        var currentSearchValue = '';
        //if (grid) {
        //    currentSearchValue = grid ? grid.state.searchTerm : '';
        //}
        Grid1 = new GKBSDynamicGrid('#MainGrid', Grid1Columns, data, {
            enablePagination: true,
            pageSize: ItemsperPage,
            height: nHeight,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: true,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: currentSearchValue,
            CompanyName: companyName,
            ReportName: "",
            fitersdata: [],
            singleIconAction: [],
            rowActionsMenu: [],
            //onCellChange: handleCellUpdate,
            customButtons: [
                {
                    icon: '🛠️',
                    text: '',
                    title: 'Settings',
                    onClick: (gridInstance, event) => {                       
                        $("#txtGenSetSubmitApplygridname").val("Grid1");
                        modalGenColumnSettings.show();
                        GendralColumnSettings(1, 1002, 1, 0);
                    }
                },
                {
                    icon: '📥',
                    text: 'Export',
                    title: 'Export to Excel via Custom Button',
                    onClick: (gridInstance, event) => {
                        gridInstance.exportToExcel();
                    }
                },                
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {                
                $("#TransactionGrid").html("");
                $("#ProductInfo").show();
                if (Grid2) {
                    DocGridSearchValue = Grid2.state.searchTerm || '';
                    //showInfoSnackbar("lastSearchText : " + lastSearchText);
                }
                GetProductDocuments(rowData["ID"]);
                $("#lblProductName").text(rowData["Name"]);
            },
            customCellRenderer: (el, col, rowData) => {
            },
            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {                
            },
            onColumnResize: (colIndex, field, header, newWidth) => {                
                UpdateColumnWidth(1002, 1, 0, colIndex, field, newWidth);
            },
        });
    }
    var DocGridSearchValue = '';
    var isRebinding = false;
    function bindDocumentDataTable(data) {
        if (data.length === 0) {
            return; // No data to display
        }
        var Reporthd = "Product Analtical Report";        
        var nHeight = "400px";
        Grid2 = new GKBSDynamicGrid('#TransactionGrid', Grid2Columns, data, {
            enablePagination: true,
            pageSize: ItemsperPage,
            height: nHeight,
            enableSearch: true,
            stickyToWindow: true,
            enableExport: false,
            enablePrint: false,
            enableColumnsBtn: true,
            enableAddRow: false,
            enableRemoveRow: false,
            enableSorting: true,
            searchTerm: DocGridSearchValue,
            CompanyName: companyName,
            ReportName: "",
            fitersdata: [],
            singleIconAction: [],
            rowActionsMenu: [],
            //onCellChange: handleCellUpdate,
            customButtons: [
                {
                    icon: '🛠️',
                    text: '',
                    title: 'Settings',
                    onClick: (gridInstance, event) => {                        
                        $("#txtGenSetSubmitApplygridname").val("Grid2");
                        modalGenColumnSettings.show();
                        GendralColumnSettings(1, 1002, 2, 0);
                    }
                },
                {
                    icon: '📥',
                    text: 'Export',
                    title: 'Export to Excel via Custom Button',
                    onClick: (gridInstance, event) => {
                        gridInstance.exportToExcel()                        
                    }
                },
            ],
            onCellClick: (rowData, fieldName, cellValue, column) => {
                
            },
            customCellRenderer: (el, col, rowData) => {
                if (col.field === 'Qty') {
                    const val = rowData[col.field];
                    if (val >= 0) {
                        el.innerHTML = `<div style="color:green"> ` + val + `</div>`;
                    } else {
                        el.innerHTML = `<div style="color:red"> ` + val + `</div>`;
                    }
                }
                if (col.field === 'Free Qty') {
                    const val = rowData[col.field];
                    if (val >= 0) {
                        el.innerHTML = `<div style="color:green"> ` + val + `</div>`;
                    } else {
                        el.innerHTML = `<div style="color:red"> ` + val + `</div>`;
                    }
                }
                if (col.field === 'Dmg Qty') {
                    const val = rowData[col.field];
                    if (val >= 0) {
                        el.innerHTML = `<div style="color:green"> ` + val + `</div>`;
                    } else {
                        el.innerHTML = `<div style="color:red"> ` + val + `</div>`;
                    }
                }
            },
            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                var dTransID = rowData.TransID;
                var DocID = rowData["Doc ID"];
                OpenTransactionDocument(dTransID, DocID);
            },
            onColumnResize: (colIndex, field, header, newWidth) => {
                //alert(`Column Resized via Callback:\nIndex: ${colIndex}\nName: ${header}\nNew Width: ${newWidth}`);
                UpdateColumnWidth(1002, 2, 0, colIndex, field, newWidth);
            },
        });
        isRebinding = true;

    }
    var ProductInfo = [];
</script>