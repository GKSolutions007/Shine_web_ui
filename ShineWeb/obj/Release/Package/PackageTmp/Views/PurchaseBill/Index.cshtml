    //~Calculation Trade Disc change
    function CalculateTradediscpern(value) {
        var dPTGross = 0, dPTGoods = 0, dPTTax = 0, dPTNet = 0, Proddiscamt = 0, Tradediscamt = 0, Addnldiscamt = 0, Q1= 0,Q3 = 0;
        $("#tblProductData tbody tr").each(function () {
            dPTGross = 0, dPTGoods = 0, dPTTax = 0, dPTNet = 0, Proddiscamt = 0, Tradediscamt = 0, Addnldiscamt = 0, Q1 = 0,Q3 = 0;
            var rowdata = ProductTable.row($(this)).data();
            var taxpern = parseFloat(rowdata[3]);
            var DiffPrice = rowdata[20];
            var ProdID = rowdata[0];
            //console.log(("Prod ID : " + ProdID);
            for (var i = 0; i < BatchAcceptArray.length; i++) {
                if (ProdID == BatchAcceptArray[i].ProdID) {
                    var grs = (parseFloat(BatchAcceptArray[i].Qty) + parseFloat(BatchAcceptArray[i].DmgQty)) * parseFloat(BatchAcceptArray[i].PurchasePrice);
                    var taxAmt = (parseFloat(BatchAcceptArray[i].TaxPern) * grs) / 100;
                    var net = grs + taxAmt;
                    dPTGoods = (parseFloat(dPTGoods) + parseFloat(grs));
                    dPTGross = (parseFloat(dPTGross) + parseFloat(grs));
                    dPTTax = (parseFloat(dPTTax) + parseFloat(taxAmt));
                    dPTNet = (parseFloat(dPTNet) + parseFloat(net));
                }
            }
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Qty") {
                    Q1 = parseFloat($(this).attr("txttag"));
                }
                if (fieldName == "DmgQty") {
                    Q3 = parseFloat($(this).attr("txttag"));
                }
            });
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "AddnlDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    var val = fullValue != "" ? parseFloat(fullValue) : 0;
                    //var val = $(this).val() != "" ? parseFloat($(this).val()) : 0;
                    //var val = ReturnTagValue(fieldID, fieldName);
                    Addnldiscamt = val;//.toFixed(DecVal);
                }
                if (fieldName == "ProdDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    var val = fullValue != "" ? parseFloat(fullValue) : 0;
                    //var val = $(this).val() != "" ? parseFloat($(this).val()) : 0;
                    //var val = ReturnTagValue(fieldID, fieldName);
                    Proddiscamt = val;//.toFixed(DecVal);
                }
                if (fieldName == "TradeDiscAmt") {
                    $(this).prop("disabled", value > 0 ? true : false);
                    //var val = value != "" ? parseFloat(value) : 0;
                    //var val = ReturnTagValue(fieldID, fieldName);
                    var grsamt = (dPTGoods - Proddiscamt);
                    var damt = parseFloat((value * grsamt) / 100);//.toFixed(DecVal);
                    updateInputColumn(fieldID, damt);
                    //$(this).val(damt);
                    //setTagValue(fieldID, fieldName, damt);
                    Tradediscamt = damt;
                }
                if (fieldName == "TradeDiscPern") {
                    $(this).prop("disabled", value > 0 ? true : false);
                    updateInputColumn(fieldID, value);
                    //$(this).val(parseFloat(value)).toFixed(DecVal));
                    //setTagValue(fieldID, fieldName, value);
                }
            });
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "ProdDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Proddiscamt = parseFloat(fullValue);//$(this).val()
                }
                if (fieldName == "TradeDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Tradediscamt = parseFloat(fullValue);
                }
                if (fieldName == "AddnlDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Addnldiscamt = parseFloat(fullValue);
                }
            });
            var ApponMRPCum = $(this).find("label[name='ApponMRPCum']").attr("lbltag") || 0;
            var TotMRPonTaxAmt = $(this).find("label[name='TotalMRPonTax']").attr("lbltag") || 0;
            $(this).find("label").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Goods") {
                    var gds = (parseFloat(dPTGoods));
                    //$(this).text(gds.toFixed(DecVal));
                    updateLabelColumn(fieldID, gds);
                    //setTagValue(fieldID, fieldName, grs,2);
                    dPTGoods = gds.toFixed(DecVal);
                }
                if (fieldName == "Gross") {
                    var grs = (parseFloat(dPTGross) - Tradediscamt - Addnldiscamt - Proddiscamt);
                    //$(this).text(grs.toFixed(DecVal));
                    updateLabelColumn(fieldID, grs);
                    //setTagValue(fieldID, fieldName, grs,2);
                    dPTGross = grs.toFixed(DecVal);
                }
                if (fieldName == "TaxAmt") {
                    var tamt = parseFloat(ApponMRPCum) > 0 ? parseFloat(TotMRPonTaxAmt) : ((taxpern * dPTGross) / 100);
                    updateLabelColumn(fieldID, tamt);
                    dPTTax = tamt.toFixed(DecVal);
                }
                if (fieldName == "NetAmt") {
                    var neta = (parseFloat(dPTGross) + parseFloat(dPTTax));
                    //$(this).text(neta.toFixed(DecVal));
                    updateLabelColumn(fieldID, neta);
                    //setTagValue(fieldID, fieldName, neta, 2);
                    //dPTNet = parseFloat($(this).text());
