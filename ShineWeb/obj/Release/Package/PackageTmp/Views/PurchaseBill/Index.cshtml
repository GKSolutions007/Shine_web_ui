    //~Grid Data
    function GetFilterData(ClickType = 0) {
        var IsValid = true;
        $(".clrdivs").html("");
        if ($("#txtFilterParty").val() != "") {
            const exists = arrVendorName.indexOf($("#txtFilterParty").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#divErrFParty").html("Select Party Name from list");
            }
        }
        if ($("#dtpFFrom").val() == "") {
            IsValid = false;
            $("#divErrFFrom").html("From date should not be empty");
        }
        if ($("#dtpFTo").val() == "") {
            IsValid = false;
            $("#divErrFTo").html("To date should not be empty");
        }
        if ($("#dtpFFrom").val() > $("#dtpFTo").val()) {
            IsValid = false;
            $("#divErrFFrom").html("From date should be lessthan To Date");
        }
        if (IsValid) {//rdoDraftTableData
            var rdo1 = $("#rdoMainTableData").is(":checked") ? "1" : $("#rdoDraftTableData").is(":checked") ? "2" : "3";
            var strBranch = $("#cmbFilterBranch").val(), strParty = $("#txtFilterParty").val(), dFrom = $("#dtpFFrom").val(),
                dTo = $("#dtpFTo").val(), chkshow = $("#chkShowAll").is(":checked") ? "1" : "0";
            $.ajax({
                url: Aurl + "purchasebill/getfilterdata",
                type: 'get',
                contentType: 'json',
                data: { TransID: 1, FType: rdo1, Branch: strBranch, Party: strParty, FromDate: dFrom, ToDate: dTo, Showall: chkshow },
                xhrFields: {
                    withCredentials: true
                },
                async: false,
                success: function (data) {
                    PurchaseBill = data;

                    var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; } grid = new GKBSDynamicGrid('#my-grid', columns, PurchaseBill, {
                        enablePagination: true,
                        pageSize: ItemsperPage,
                        enableSearch: true,
                        stickyToWindow: true,
                        enableExport: false,
                        enablePrint: false,
                        enableColumnsBtn: false,
                        enableAddRow: false,
                        enableRemoveRow: false,
                        enableSorting: true,
                        searchTerm: currentSearchValue, singleIconAction: singleIconAction,
                        rowActionsMenu: menuActions,
                        customCellRenderer: (el, col, rowData) => {
                        },

                        customButtons: [
                            {
                                icon: '⚙️',
                                text: 'Settings',
                                title: 'Settings',
                                visible: true,
                                onClick: (gridInstance, event) => {

                                    modalGenColumnSettings.show();
                                    GendralColumnSettings(1, 25, 1, 0);
                                }
                            },
                            {
                                icon: '➕',
                                text: 'Add New',
                                title: 'Add New',
                                visible: $("#txtAddID").val() == 1,
                                onClick: (gridInstance, event) => {
                                    nTransMode = 1;
                                    $("#dvMain,#dvUpdateVendor").show();
                                    $("#dvDocuments").hide();
                                    $("#balanceContainer").hide();
                                    ClearForm();
                                    setTimeout(() => {
                                        var DocDate = $("#dtpDate").val();
                                        var Branch = $("#cmbBranch").val();
                                        GetDocumentID(DocDate, Branch, 1);
                                    }, 1000);
                                }
                            },
                        ],
                        onCellClick: (rowData, fieldName, cellValue, column) => {
                            $(".clrdivs").html("");
                            if (rdo1 == 1 && fieldName == "DocID") {
                                var ID = rowData.ID;//[0];
                                InvoiceCollectionModalPopup(ID, 1);
                            }
                        },
                        onCellDoubleClick: (rowData, fieldName, cellValue, column) => {

                        },
                        onColumnResize: (colIndex, field, header, newWidth) => {
                            UpdateColumnWidth(25, 1, 0, colIndex, field, newWidth)
                        },
                    });
                    var billjsdata = eval(data);
                    if (billjsdata.length == 0) {
                        if (ClickType == 1)
                            showErrorSnackbar("No records found");
                    }

                    // Step 1: Define statuses to exclude
                    const excludeStatuses = ['amended', 'cancelled'];

                    // Step 2: Calculate cumulative total excluding those statuses
                    let totalNetAmt = 0;
                    let totalBalance = 0;

                    billjsdata.forEach(item => {
                        const status = item.Status.toLowerCase();
                        if (!excludeStatuses.includes(status)) {
                            totalNetAmt += parseFloat(item.NetAmt);
                            totalBalance += parseFloat(item.Balance);
                        }
                    });
                    $("#dvPaid").html(formatIndianCurrency(parseFloat(totalNetAmt - totalBalance).toFixed(DecVal)));
                    $("#dvUnPaid").html(formatIndianCurrency(parseFloat(totalBalance).toFixed(DecVal)));
                    $("#dvTotal").html(formatIndianCurrency(parseFloat(totalNetAmt).toFixed(DecVal)));
                }
            });

        }
    }
