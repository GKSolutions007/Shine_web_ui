    $('#tblProductData tbody').on('change', '.dgvProddiscPernchange', function (e) {
        var id = e.target.id;
        var val = e.target.value;
        var name = e.target.name;
        ProdGridChange = true;

        updateInputColumn(id, val);
        var $input = $(this);
        var $r = $input.closest('tr');

        rowdata = ProductTable.row($(this).parents('tr')).data();

        var GridProdID = rowdata[0];
        var taxpern = parseFloat(rowdata[3]);
        var TInvoicePrice = parseFloat(rowdata[20]);

        //showSuccessSnackbar("dAppMRPonTax : " + dAppMRPonTax + "<br/>TotMRPonTaxAmt : " + TotMRPonTaxAmt);
        let existTradeDiscPern = getTagEl($r, "input[name='TradeDiscPern']");
        let existAddnlDiscPern = getTagEl($r, "input[name='AddnlDiscPern']");
        let existGoodsAmt = getTagEl($r, "label[name='Goods']");
        let Qty = getTagEl($r, "input[name='Qty']");
        let DmgQty = getTagEl($r, "input[name='DmgQty']");

        var ProdDiscAmt = (existGoodsAmt * val) / 100;
        updateInput($r, "input[name='ProdDiscAmt']", ProdDiscAmt);

        var price = (existGoodsAmt - ProdDiscAmt);
        var trdamt = ((existTradeDiscPern * price) / 100);
        updateInput($r, "input[name='TradeDiscAmt']", trdamt);
        if (trdamt <= 0) {
            updateInput($r, "input[name='TradeDiscPern']", 0);
        }
        //
        var addnlamt = ((existAddnlDiscPern * price) / 100);
        updateInput($r, "input[name='AddnlDiscAmt']", addnlamt);
        if (addnlamt <= 0) {
            updateInput($r, "input[name='AddnlDiscPern']", 0);
        }

        var dGross = (existGoodsAmt - (trdamt + addnlamt + ProdDiscAmt));
        updateLbl($r, "label[name='Gross']", dGross);
        var ApponMRPCum = $r.find("label[name='ApponMRPCum']").attr("lbltag") || 0;
        var TotMRPonTaxAmt = $r.find("label[name='TotalMRPonTax']").attr("lbltag") || 0;
        var tamt = parseFloat(ApponMRPCum) > 0 ? parseFloat(TotMRPonTaxAmt) : ((taxpern * dGross) / 100);
        updateLbl($r, "label[name='TaxAmt']", tamt);

        var neta = (parseFloat(dGross) + parseFloat(tamt));
        updateLbl($r, "label[name='NetAmt']", neta);

        var forItemUOM = BatchAcceptArray.filter(bt => bt.ProdID == GridProdID);
        var CFValue = 1;
        if (forItemUOM.length > 0) {
            CFValue = forItemUOM[0].ConversionRate
        }
        var PerQty = dGross / (Qty + DmgQty);
        var Diff = (TInvoicePrice * CFValue) - PerQty;
        updateLbl($r, "label[name='DiffValue']", Diff);
        let difffid = $r.find("label[name='DiffValue']").attr("id");
        var clrcolor = Diff >= 0 ? "green" : "red";
        document.getElementById(difffid).style.color = clrcolor

        calculateProdGrid();
    });
