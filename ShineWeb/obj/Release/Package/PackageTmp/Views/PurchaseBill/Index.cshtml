    function CalculateAddnldiscpern(value) {
        var dPTGross = 0, dPTGoods = 0, dPTTax = 0, dPTNet = 0, Proddiscamt = 0, Tradediscamt = 0, Addnldiscamt = 0,Q1 = 0,Q3 = 0;
