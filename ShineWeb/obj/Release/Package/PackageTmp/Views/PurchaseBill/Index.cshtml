<script>
    //~Filter Action Buttons
    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canEdit: $("#txtModifyID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canCancel: $("#txtCancelID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    var allGridActions = [], singleIconAction = [], menuActions = [], columns = [];
    var actions = {}, OtherActions = {};

    function LoadPermissions() {
        var Permrdo1 = $("#rdoMainTableData").is(":checked") ? "1" : $("#rdoDraftTableData").is(":checked") ? "2" : "3";
        var cancelperm = !mapusersRole.canCancel ? false : Permrdo1 == "1" ? true : Permrdo1 == "2" || Permrdo1 == "3" ? true : false;
        var ViewPerm = mapusersRole.canView && Permrdo1 == "1" ? true : false;
        allGridActions = [
            {
                icon: '👁️',
                title: 'View Data',
                className: 'dg-action-view',
                displayType: 'single_icon',
                visible: ViewPerm,
                handler: (rowdata) => {
                    $(".clrdivs").html("");
                    $("#txtHProds,#txtHProdCode,#txtHSN,#txtCode").val("");
                    $("#lblProdCodeAS,#lblABSLoc").text("");
                    $('#cmbUOM').find("option").remove();
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    nTransMode = 5;
                    $("#txtID").val(ID);
                    GetProductViewData(7, ID);
                    $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
                    $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
                    $("#btnPreview,#btnPDF,#btnPrint").show();
                    $("#btnEmail,#btnWhatsapp,#PaymentInfoPopup").show();
                    $("#btnSave,#btnClear,#btnDraft").hide();
                    $("#dvMain").show();
                    $("#dvDocuments,#dvUpdateVendor").hide();
                    $("#balanceContainer").show();
                    $("#MainHeading").text("View Purchase Bill_" + sts);
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#cmbBranch").prop("disabled", true);
                    }
                }
            },
            {
                icon: '✏️',
                title: 'Edit',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled') {
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftModifyID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canEdit)
                                isVisible = true;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    $("#txtHProds,#txtHProdCode,#txtHSN,#txtCode").val("");
                    $("#lblProdCodeAS,#lblABSLoc").text("");
                    $('#cmbUOM').find("option").remove();
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        nTransMode = 2;
                        var rdo1 = $("#rdoMainTableData").is(":checked");
                        var rdo2 = $("#rdoDraftTableData").is(":checked");
                        var rdo3 = $("#rdoPOTableData").is(":checked");
                        GetProductViewData(rdo1 ? 7 : rdo2 ? 11 : 17, ID);
                        nTransMode = rdo1 ? 2 : 1;
                        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
                        $("#btnPreview,#btnPDF,#btnClear,#btnPrint").prop("disabled", true);
                        $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
                        $("#btnSave,#PaymentInfoPopup").show();
                        $("#btnSave,#btnClose").prop("disabled", false);
                        $("#btnDraft").prop("disabled", !rdo2);
                        $("#dvMain,#dvUpdateVendor").show();
                        $("#dvDocuments").hide();
                        $("#btnEmail,#btnWhatsapp").hide();
                        $("#balanceContainer").show();
                        if ($("#txtEnableBranch").val() == 1) {
                            $("#cmbBranch").prop("disabled", true);
                        }
                        $("#MainHeading").text(rdo1 ? "Modify Purchase Bill" : "Create Purchase Bill");
                    }
                    else {
                        showErrorSnackbar("Cannot Modify.This document already cancelled");
                    }
                }
            },
            {
                icon: '📄',
                title: 'Variant',
                className: 'dg-action-edit',
                visible: mapusersRole.canVariant && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    $("#txtHProds,#txtHProdCode,#txtHSN,#txtCode").val("");
                    $("#lblProdCodeAS,#lblABSLoc").text("");
                    $('#cmbUOM').find("option").remove();
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    $("#txtID").val(ID);
                    nTransMode = 3;
                    GetData(1);
                    GetProductViewData(7, ID);
                    $("#dvMain,#dvUpdateVendor").show();
                    $("#dvDocuments").hide();
                    $("#btnEmail,#btnWhatsapp,#PaymentInfoPopup").hide();
                    $("#MainHeading").text("Variant Purchase Bill");
                    $(".FormclrField,.FormclrcmbField").prop("disabled", false);
                    $("#btnSave,#btnClear,#btnDraft").prop("disabled", false);
                    $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", true);
                    $("#btnPreview,#btnPDF,#btnPrint").hide();
                    $("#btnSave,#btnClear,#btnDraft").show();
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#cmbBranch").prop("disabled", true);
                    }
                    $("#balanceContainer").hide();
                    setTimeout(() => {
                        var DocDate = $("#dtpDate").val();
                        var Branch = $("#cmbBranch").val();
                        GetDocumentID(DocDate, Branch, 1);
                    }, 1000);
                }
            },
            {
                icon: '❌',
                title: 'Cancel',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled') {
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftCancelID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canCancel && Permrdo1 == "1")
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    $("#txtHProds,#txtHProdCode,#txtHSN,#txtCode").val("");
                    $("#lblProdCodeAS,#lblABSLoc").text("");
                    $('#cmbUOM').find("option").remove();
                    var rdo1 = $("#rdoMainTableData").is(":checked");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        if (rdo1) {
                            $("#MainHeading").text("Cancel Purchase Bill");
                            nTransMode = 4;
                            GetProductViewData(7, ID);
                            $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                            $("#txtNarration,#txtRemarks").prop("disabled", false);
                            $("#btnPreview,#btnPDF,#btnClear,#btnDraft,#btnPrint").prop("disabled", true);
                            $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
                            $("#btnSave,#btnClose").prop("disabled", false);
                            $("#btnSave,#PaymentInfoPopup").show();
                            $("#dvMain").show();
                            $("#dvDocuments,#dvUpdateVendor").hide();
                            $("#btnEmail,#btnWhatsapp").hide();
                            $("#balanceContainer").show();
                            if ($("#txtEnableBranch").val() == 1) {
                                $("#cmbBranch").prop("disabled", true);
                            }
                        }
                        else {
                            var conf = confirm("Do you want to remove draft data?");
                            if (conf) {
                                GetData(15, ID);
                            }
                        }
                    }
                    else {
                        showErrorSnackbar("This document already cancelled");
                    }
                }
            },
            {
                icon: '🖨️',
                title: 'Print',
                className: 'dg-action-edit',
                visible: mapusersRole.canPrint && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPrint").click();
                }
            },
            {
                icon: '🖨️',
                title: 'Preview',
                className: 'dg-action-edit',
                visible: mapusersRole.canPreview && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPreview").click();
                }
            },
            {
                icon: "<i class='fa-regular fa-file-pdf' style='color:brown'></i>",
                title: '&ensp;PDF',
                className: 'dg-action-edit',
                visible: mapusersRole.canPDF && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPDF").click();
                }
            },
            {
