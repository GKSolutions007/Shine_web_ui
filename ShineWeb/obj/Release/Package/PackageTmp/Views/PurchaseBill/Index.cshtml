    function CalculateDiffPrice() {
        var Q1 = 0, Q2 = 0, Q3 = 0, gross = 0, TAmt = 0, NAmt = 0;
        $("#tblProductData tbody tr").each(function () {
            Q1 = 0, Q2 = 0, Q3 = 0, gross = 0, TAmt = 0, NAmt = 0;
            rowdata = ProductTable.row($(this)).data();
            var TBillPrice = parseFloat(rowdata[20] || 0);
            Q1 = $(this).find("input[name=Qty]").attr("txttag");
            Q2 = $(this).find("input[name=FreeQty]").attr("txttag");
            Q3 = $(this).find("input[name=DmgQty]").attr("txttag");

            gross = $(this).find("label[name=Gross]").attr("lbltag");
            TAmt = $(this).find("label[name=TaxAmt]").attr("lbltag");
            NAmt = $(this).find("label[name=NetAmt]").attr("lbltag");

            var difffieldid = $(this).find("label[name=DiffValue]").attr("id");

            var val = parseFloat(gross) / (parseFloat(Q1) + parseFloat(Q3));
            var Diff = TBillPrice - val;
            var AbsDiff = Diff;// Math.abs(Diff);
            updateLabelColumn(difffieldid, AbsDiff);
            var clrcolor = Diff >= 0 ? "green" : "red";
            $("#" + difffieldid).css("color", clrcolor);
        });
    }
