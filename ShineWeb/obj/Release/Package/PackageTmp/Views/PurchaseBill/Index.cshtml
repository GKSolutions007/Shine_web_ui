    function PaymentmodeValidation() {
        var IsValid = true;
        var AdjAmt = parseFloat(document.getElementById("txtPMPRecdAmt").getAttribute("txttag"));
        var Bal = parseFloat(document.getElementById("txtPMPBalance").getAttribute("txttag"));
        if (AdjAmt > 0) {
            $("#tblPayment tbody tr").each(function () {
                var allValues = {};
                rowdata = TablePaymode.row($(this)).data();
                PMID = rowdata[0];
                var Amount = 0;
                $(this).find("input").each(function (index) {
                    $(this).css("border-color", "black");
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "PaymentAmount") {
                        Amount = parseFloat($(this).attr("txttag"));
                    }
                    if (fieldName == "IFSC") {
                        if ($(this).val() != "") {
                            var BANKIFSC = IFSCValidation($(this), "");
                            if (!BANKIFSC) {
                                IsValid = false;
                                showErrorSnackbar("Invalid IFSC Code");
                                $(this).css("border-color", "red");
                            }
                        }
                    }
                    if (fieldName == "BankName") {
                        Bankname = $(this).val();
                    }
                    if (fieldName == "BranchName") {
                        Branch = $(this).val();
                    }
                    if (fieldName == "VisaPern") {
                        VisaPern = parseFloat($(this).attr("txttag"));
                    }
                    if (fieldName == "VisaAmt") {
                        VisaAmt = parseFloat($(this).attr("txttag"));
                    }
                    if (fieldName == "NEFT") {
                        NEFT = $(this).val();
                    }
                    if (fieldName == "ChqDate") {
                        if (PMID == "2") {
                            if (Amount > 0 && $(this).val() == "") {
                                $(this).css("border-color", "red");
                                showErrorSnackbar("Cheque Date should not be emtpy");
                                IsValid = false;
                            } else {
                                ChqDate = $(this).val();
                            }

                        }

                    }
                });
                $(this).find("select").each(function (index) {
                    $(this).css("border-color", "black");
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "dgvPMAccNo") {
                        if (PMID == "2" || PMID == "3"||PMID == "4" || PMID == "5" || PMID == "7") {
                            if (Amount > 0 && $(this).val() == 0) {
                                $(this).css("border-color", "red");
                                var errmsg = PMID == "7" ? "Select Credit Term" : "Select Bank Account";
                                showErrorSnackbar(errmsg);
                                IsValid = false;
                                BankAccID = 0;
                                BankAccNo = "";
                            } else {
                                BankAccID = $(this).val();
                                BankAccNo = $(this).val() > 0 ? $(this).text() : "";
                            }
                        }
                    }
                    if (fieldName == "dgvPMChqNo") {
                        if (PMID == "2") {
                            if (Amount > 0 && $(this).val() == 0) {
                                $(this).css("border-color", "red");
                                showErrorSnackbar("Select Cheque No");
                                IsValid = false;
                                TransMode = 0;
                            } else {
                                TransMode = $(this).val();
                            }
                        }
                    }
                    if (fieldName == "dgvPMTransMode")
                    {
                        if (PMID == "4") {
                            if (Amount > 0 && $(this).val() == 0) {
                                $(this).css("border-color", "red");
                                showErrorSnackbar("Select Transfer Mode");
                                IsValid = false;
                                TransMode = 0;
                            } else {
                                TransMode = $(this).val();
                            }
                        }

                    }
                });
            });
        }
        else {
            IsValid = false;
            showErrorSnackbar("Adjust Value in anyone Payment Mode");
        }
        if (IsValid) {
            if (Bal > 0) {
                IsValid = false;
                showErrorSnackbar("₹ " + Bal + " Pending, Adjust full Value");
            }
        }
        return IsValid;
    }
