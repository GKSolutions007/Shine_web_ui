    function GetData(nMode, strName = null, strID = null, dtpDt = null) {
        //~Preload Data
        $.ajax({
            url: Aurl + "purchasebill/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, CodeName: strName, ID: strID },
            xhrFields: {
                withCredentials: true
            },
            async : false,
            success: function (data) {
                if (nMode == 1) {
                    $('#cmbPaymode,#cmbCreditTerm,#cmbUDN,#cmbFilterBranch,#cmbLocation').find("option").remove();
                    $('#cmbPaymode,#cmbCreditTerm,#cmbUDN,#cmbFilterBranch,#cmbLocation').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    arrVendor = [], arrVendorCode = [], arrVendorName = [], arrProd = [], arrBankAcc = [], arrAllPaymode = [];
                    nIndexarrVendor = 0, nIndexarrProd = 0, strBankAcc = "", strCreditTerm = "", strTransmode = "", DefBankAcc = 0
                        , strReasons = "<option value='0'>-Reason-</option>", arrReasons = [],
                        strLocation = "<option value='0'>-Location-</option>";

                    $.each(data, function (i, items) {
                        if (items.FType == 1) {
                            var ven = {
                                "label": items.Code + " | " + items.Name,
                                "name": items.Name,
                                "code": items.Code,
                                "id": items.ID,
                            }
                            arrVendor.push(ven);
                            arrVendorCode[nIndexarrVendor] = items.Code;
                            arrVendorName[nIndexarrVendor] = items.Name;
                            nIndexarrVendor++;
                        }
                        if (items.FType == 3) {
                            $('#cmbPaymode').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 4) {
                            $('#cmbCreditTerm').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                            strCreditTerm += '<option value="' + items.ID + '">' + items.Name + '</option>';
                        }
                        if (items.FType == 2) {
                            $('#cmbFilterBranch').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 5) {
                            $('#cmbUDN').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                        if (items.FType == 6) {
                            $("#lblDocID").text(items.Name);
                        }
                        if (items.FType == 7) {
                            var cr = {
                                "ID": items.ID,
                                "Name": items.Name
                            }
                            arrAllPaymode.push(cr);

                        }
                        if (items.FType == 8) {
                            var BADetails = (items.Name).split('|');
                            var BAInfo = {
                                "ID": items.ID,
                                "AccNo": BADetails[0],
                                "Bank": BADetails[1],
                                "Branch": BADetails[2],
                                "IFSC": BADetails[3],
                                "MICR": BADetails[4],
                                "DefYN": BADetails[5],
                            }
                            var sel = "";
                            if (BADetails[5] == "1")
                            {
                                DefBankAcc = items.ID;
                                strIFSC = BADetails[3];
                                strBank = BADetails[1];
                                strBranch = BADetails[2];
                                //sel = "selected";
                            }
                            strBankAcc += '<option value="' + items.ID + '" ' + sel + '>' + BADetails[0] + '</option>';
                            arrBankAcc.push(BAInfo);
                        }
                        if (items.FType == 9) {
                            strTransmode += '<option value="' + items.ID + '">' + items.Name + '</option>';
                        }
                        if (items.FType == 10) {
                            strReasons += '<option value="' + items.ID + '">' + items.Name + '</option>';
                            var sch = {
                                "label": items.Name,
                                "id": items.ID,
                            }
                            arrReasons.push(sch);
                        }
                        if (items.FType == 11) {
                            strLocation += '<option value="' + items.ID + '">' + items.Name + '</option>';
                            $('#cmbLocation').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        }
                    });
                    SetAutlistforFields();
                    //$("#cmbBranch").val(DefBranch);
                    LoadBranchByRoles('#cmbBranch,#cmbFilterBranch');
                    LoadPaymentModeData();
                }
                else if (nMode == 3) {
                    //~Assign Data Vendor
                    $.each(data, function (i, items) {
                        $("#txtVendorID").val(items.ID),
                            $("#txtSearch").val(items.Name),
                            $("#lblName").text(items.Code),
                            $("#cmbRating").text(items.Ratings),
                            $("#lblMob1").text(items.Mob1),
                            $("#lblGSTIN").text(items.GSTIN),
                            $("#cmbCreditTerm").val(items.CreditTermID),
                            $("#cmbPaymode").val(items.PaymentModeID);
                        $("#txtBAdd1").val(items.Billadd1),
                            $("#txtBAdd2").val(items.Billadd2),
                            $("#txtBAdd3").val(items.Billadd3),
                            $("#txtSAdd1").val(items.Shipadd1),
                            $("#txtSAdd2").val(items.shipadd2),
                            $("#txtSAdd3").val(items.Shipadd3),
                            $("#txtPincode").val(items.Pincode);
                        if (items.PaymentModeID != "7") {
                            $("#cmbPaymode").val(8);
                            $("#cmbCreditTerm").val(0);
                        }
                        OpenOneView(items.ID, 2);
                    });
                }
                else if (nMode == 4) {
                    //~Assign Data Product
                    arrPurchaseTaxDetails = [];
                    $('#cmbUOM').find("option").remove();
                    $('#cmbUOM').append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                        name:0
                    }));
                    $.each(data, function (i, items) {
                        $('#txtHProdID').val(items.ID);
                        $('#txtHProdCode').val(items.Code);
                        $('#lblProdCodeAS').text("Code : " + items.Code);
                        $('#txtHProds').val(items.Name);
                        $('#txtHSN').val(items.HSNCode);
                        $('#cmbLocation').val(items.LocationID);
                        $('#txtTransBillPrice').val(items.PurchaseBillPrice);
                        arrPurchaseTaxDetails = ReturnTaxDetails(items.PurchaseTaxID, 1);
                        var dApponMRPCum = arrPurchaseTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
                        $('#txtMRPonTax').val(dApponMRPCum);
                        var sel = "<select class='gdInput'>";
                        for (var j = 0; j < items.UOMList.length; j++) {
                            sel += "<option value=" + items.UOMList[j].ID + " name=" + items.UOMList[j].ConvRate +">" + items.UOMList[j].Name + "</option>";
                            $('#cmbUOM').append($('<option/>', {
                                value: items.UOMList[j].ID,
                                text: items.UOMList[j].Name,
                                name: items.UOMList[j].ConvRate,
                            }));
                        }
                        sel += "</select>";
                        TempProd = items;
                        $('#cmbUOM').val(TempProd.PurchaseUomID);//BaseUomID
                        ConvFact = TempProd.PurchaseCR;
                        if (BatchFromProductMaster == 1) {
                            setTimeout(() => {
                                ReInitializeBatchfromProdMaster()
                            }, 500);
                        }
                    });
                }
                else if (nMode == 14) {
                    TableProductInfo.draw().clear(); TableProductInfo.draw().clear();
                    if (data.length > 0) {
                        $.each(data, function (i, items) {
                            TableProductInfo.row.add([
                                items.HID,
                                items.Date,
                                items.MRP,
                                items.UomQty,
                                items.UomID,
                                items.PurchasePrice,
                                items.SalePrice,
                                items.ECP,
                                items.SPLPrice,
                                items.ReturnPrice,
                                items.ProdDiscPern,
                                items.TradeDiscPern,
                                items.AddnlDiscPern,
                                items.BatchNo,
                                items.PKD,
                                items.Expiry,
                            ]).draw(false);
                        });
                    }
                    else {
                        showErrorSnackbar("No records found");
                    }
                }
                else if (nMode == 15) {
                    var rdo1 = $("#rdoMainTableData").is(":checked");
                    //GetData(rdo1 ? 6 : 9);
                    GetFilterData();
                }
                else if (nMode == 20) {
                    $('#' + dtpDt).find("option").remove();
                    $('#' + dtpDt).append($('<option/>', {
                        value: 0,
                        text: "-- Select Cheque No --",
                    }));
                    $.each(data, function (i, items) {
                        $('#' + dtpDt).append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                }
            }, error: function (data) {
                //console.log(("error ", data);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }

        });
    }
