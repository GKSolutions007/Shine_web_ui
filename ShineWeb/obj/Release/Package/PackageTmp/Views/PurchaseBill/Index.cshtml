    //~Calculation Product Grid
    function calculateProdGrid() {
        $(".lblPT").text(0.00);
        var dPTQty = 0, dPTFreeQty = 0, dPTDmgQty = 0, dPTGoods = 0, dPTGross = 0, dPTTax = 0, dPTNet = 0, TotProdDisc = 0, TotTradeDisc = 0,
            TotAddnlDisc = 0, Value = 0, dQty = 0,dDmgQty = 0, dGross = 0, dNet = 0, DiffExcl = 0, DiffIncl = 0;
        if (ProductTable.rows().count() == 0) return;
        $("#tblProductData tbody tr").each(function () {
            var allValues = {};
            var rowdata = ProductTable.row($(this)).data();

            var TInvoicePrice = parseFloat(rowdata[20] || 0);//$(this).find("td").eq(20).text()
            var TaxPern = parseFloat(rowdata[3] || 0);

            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");

                if (fieldName == "Qty") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Value = fullValue != "" ? fullValue : 0;
                    //Value = $(this).val() != "" ? $(this).val() : 0;
                    dPTQty += parseFloat(Value);
                    dQty = parseFloat(Value);
                }
                if (fieldName == "FreeQty") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Value = fullValue != "" ? fullValue : 0;
                    //Value = $(this).val() != "" ? $(this).val() : 0;
                    dPTFreeQty += parseFloat(Value);
                }
                if (fieldName == "DmgQty") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Value = fullValue != "" ? fullValue : 0;
                    //Value = $(this).val() != "" ? $(this).val() : 0;
                    dPTDmgQty += parseFloat(Value);
                    dDmgQty = parseFloat(Value);
                }
                if (fieldName == "ProdDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Value = fullValue != "" ? fullValue : 0;
                    //Value = $(this).val() != "" ? $(this).val() : 0;
                    TotProdDisc += parseFloat(Value);
                }
                if (fieldName == "TradeDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Value = fullValue != "" ? fullValue : 0;
                    //Value = $(this).val() != "" ? $(this).val() : 0;
                    TotTradeDisc += parseFloat(Value);
                }
                if (fieldName == "AddnlDiscAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('txttag');
                    Value = fullValue != "" ? fullValue : 0;
                    //Value = $(this).val() != "" ? $(this).val() : 0;
                    TotAddnlDisc += parseFloat(Value);
                }
                //allValues[fieldName] = $(this).val();
            });
            $(this).find("label").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Goods") {
                    const fullValue = document.getElementById(fieldID).getAttribute('lbltag');
                    Value = fullValue != "" ? fullValue : 0;
                    dPTGoods += parseFloat(Value);
                }
                if (fieldName == "Gross") {
                    const fullValue = document.getElementById(fieldID).getAttribute('lbltag');
                    Value = fullValue != "" ? fullValue : 0;
                    dPTGross += parseFloat(Value);
                    dGross = parseFloat(Value);
                }
                if (fieldName == "TaxAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('lbltag');
                    Value = fullValue != "" ? fullValue : 0;
                    dPTTax += parseFloat(Value);
                }
                if (fieldName == "NetAmt") {
                    const fullValue = document.getElementById(fieldID).getAttribute('lbltag');
                    Value = fullValue != "" ? fullValue : 0;
                    dPTNet += parseFloat(Value);
                    dNet = parseFloat(Value);
                }
                if (fieldName == "DiffValue") {
                    if (dQty > 0) {
                        var tp = parseFloat(1 + (TaxPern / 100));
                        var val = dGross / (dQty + dDmgQty);
                        var Diff = TInvoicePrice - val;
                        var AbsDiff = Diff;// Math.abs(Diff);
                        DiffExcl += (AbsDiff * dQty);
                        DiffIncl += ((AbsDiff * dQty) * tp);

                    } else {
                        DiffExcl += 0;
                        DiffIncl += 0;
                    }
                }
            });

            if (dNet == 0) {
                $(this).css("background-color", "lightgrey");
            }
            else {
                $(this).css("background-color", "white");
            }
        });
        updateLabelColumn("lblPTQty", dPTQty); updateLabelColumn("lblPTFreeQty", dPTFreeQty); updateLabelColumn("lblPTDmgQty", dPTDmgQty);
        updateLabelColumn("lblPTPDiscAmt", TotProdDisc); updateLabelColumn("lblPTTDiscAmt", TotTradeDisc); updateLabelColumn("lblPTADiscAmt", TotAddnlDisc);
        updateInputColumn("txtProdDiscAmt", TotProdDisc); updateInputColumn("txtTradeDiscAmt", TotTradeDisc); updateInputColumn("txtAddnlDiscAmt", TotAddnlDisc);
        updateLabelColumn("lblPTGoods", dPTGoods); updateLabelColumn("lblPTGross", dPTGross); updateLabelColumn("lblPTTax", dPTTax); updateLabelColumn("lblPTNet", dPTNet);
        updateLabelColumn("lblTaxAmount", dPTTax);
        updateLabelColumn("lblCGST", (dPTTax / 2)); updateLabelColumn("lblSGST", (dPTTax / 2));
        var grss = (dPTGoods - TotProdDisc);
        var TrdPern = parseFloat(grss) > 0 ?parseFloat((TotTradeDisc / grss) * 100) : 0;//.toFixed(DecVal)
        var AddnlPern = parseFloat(grss) > 0 ? parseFloat((TotAddnlDisc / grss) * 100) : 0;//.toFixed(DecVal)
        updateInputColumn("txtTradeDiscPern", TrdPern); updateInputColumn("txtAddnlDiscPern", AddnlPern);
        // ceil - always Up value, floor - always down value
        var tofrg = parseFloat(document.getElementById("txtFright").getAttribute("txttag"));
        var tothrchrg = parseFloat(document.getElementById("txtOtherChargAmt").getAttribute("txttag"));
        var twrtoff = parseFloat(document.getElementById("txtWriteoff").getAttribute("txttag"));
        var tTCS = parseFloat(document.getElementById("txtTCS").getAttribute("txttag"));
        var tTDS = parseFloat(document.getElementById("txtTDS").getAttribute("txttag"));
        var AllotherAmt = (tothrchrg  + tofrg + twrtoff + tTCS + tTDS);
        dPTNet = dPTNet + AllotherAmt;
        //var RoundNetAmt = Math.floor(dPTNet)
        var RoundNetAmt = ApplyRoundoff(dPTNet);
        var Roundoff = (RoundNetAmt - dPTNet);
        //$("#txtRoundOff").val(Roundoff.toFixed(DecVal));
        //$("#lblRoundNet").text(RoundNetAmt.toFixed(DecVal));
        updateLabelColumn("lblRoundNet", RoundNetAmt);
        updateLabelColumn("lblRoundNetFooter", RoundNetAmt);

        updateInputColumn("txtRoundOff", Roundoff);
        updateInputColumn("txtDiffExcl", DiffExcl); updateInputColumn("txtDiffIncl", DiffIncl);
        $("#txtDiffExcl").css("color", DiffExcl >= 0 ? "green" : "red");
        $("#txtDiffIncl").css("color", DiffIncl >= 0 ? "green" : "red");
        ApplyMultimodeAmount(RoundNetAmt);
        var ItemCount = parseInt(ProductTable.rows().count());
        $("#lblPTCount").text(ItemCount);
        if (ItemCount == 0) {
            $("#txtTradeDiscPern,#txtTradeDiscAmt,#txtAddnlDiscPern,#txtAddnlDiscAmt").prop("disabled", false);
        }
        if (ProductTable) {
            ProductTable.columns.adjust();
        }
    }
    function ApplyMultimodeAmount(dNetAmt) {
