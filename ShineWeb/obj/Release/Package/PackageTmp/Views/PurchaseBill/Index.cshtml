    .table {
        margin-bottom: 0px !important;
    }

    iframe#iframepreview {
        width: 100%;
        height: 450px;
        border: none;
        background: white;
        display: block;
    }
</style>
<style>
    .summary-box {
        display: inline-block;
        min-width: 100px;
        padding: 15px 20px;
        border-radius: 8px;
        margin: 5px;
        text-align: center;
        vertical-align: middle;
    }

    .bg-paid {
        background-color: #ccf5e7;
    }

    .bg-unpaid {
        background-color: #d8eaff;
    }

    .bg-total {
        background-color: #ffd999;
    }

    .summary-label {
        font-size: 11px;
        color: #333;
        margin-bottom: 5px;
    }

    .summary-value {
        font-size: 12px;
        font-weight: bold;
        color: #000;
    }

    .summary-symbol {
        font-size: 20px;
        font-weight: bold;
        margin: 0 8px;
        display: inline-block;
        vertical-align: middle;
    }
</style>
<style>
    /* Align dropdown in DataTable cell */
    .action-dropdown {
        min-width: 100px;
        font-size: 12px;
        z-index: 1000;
        text-align: left;
    }

        /* Optional: Add hover effect */
        .action-dropdown > li > a {
            padding: 3px 12px;
            color: #333;
            text-decoration: none;
        }

            .action-dropdown > li > a:hover {
                background-color: #f5f5f5;
                color: #000;
            }

    /* Optional: Make dropdown button minimal */
    .dropdown-toggle {
        background-color: transparent !important;
        border: none !important;
        font-size: 15px;
        line-height: 1;
        padding: 2px 5px;
    }

        .dropdown-toggle::after {
            display: none;
        }
    /* ============ COMPACT FORM CONTROLS ============ */
    .form-control,
    select.form-control,
    input.form-control,
    textarea.form-control,
    .gdInput,
    select.gdInput,
    input.gdInput {
        padding: 4px 8px !important;
        font-size: 12px !important;
        height: 28px !important;
        line-height: 1.4 !important;
    }

    textarea.form-control {
        height: auto !important;
        min-height: 60px !important;
    }

    .input-group-addon {
        padding: 4px 8px !important;
        font-size: 12px !important;
    }

    select.form-control {
        padding-right: 20px !important;
    }
    @@media (max-width:800px) {
    .filter-text{
        display:none;
    }
}    
</style>
<body>
    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.Variant, new { @autocomplete = "off", @class = "form-control", @id = "txtVariantID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.Cancel, new { @autocomplete = "off", @class = "form-control", @id = "txtCancelID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.EnableReturnPrice, new { @autocomplete = "off", @class = "form-control", @id = "txtReurnPricePerm" })
    @Html.HiddenFor(model => model.EnableSave, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableSaveButton" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.TransType, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtTransType" })
    @Html.HiddenFor(model => model.EnablePriceEditInTransaction, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtPriceEditInTransaction" })
    @Html.HiddenFor(model => model.DraftModify, new { @autocomplete = "off", @class = "form-control", @id = "txtDraftModifyID" })
    @Html.HiddenFor(model => model.DraftCancel, new { @autocomplete = "off", @class = "form-control", @id = "txtDraftCancelID" })
    @Html.HiddenFor(model => model.EnableBranch, new { @autocomplete = "off", @class = "form-control", @id = "txtEnableBranch" })
    @Html.HiddenFor(model => model.EnablePaid, new { @autocomplete = "off", @class = "form-control", @id = "txtEnablePaid" })

    <input hidden id="txtVendorID" />
    <input hidden id="txtBAdd1" /><input hidden id="txtBAdd2" /><input hidden id="txtBAdd3" />
    <input hidden id="txtSAdd1" /><input hidden id="txtSAdd2" /><input hidden id="txtSAdd3" />
    <input hidden id="txtPincode" />
    <input hidden id="txtSAdd1" /><input hidden id="txtSAdd2" /><input hidden id="txtSAdd3" />
    <input hidden id="txtPincode" /><input hidden id="txtStatus" /><input hidden class="FormclrField" id="txtDraftID" />

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>   
    <div id="dvDocuments">
        <div class="row w-100">
            <div class="col-12 col-md-4">
                <div class="toggle">
                    <input type="radio" name="sizeBy" id="rdoMainTableData" checked="checked" />
                    <label for="rdoMainTableData">Bill <span class="filter-text">Data</span></label>
                    <input type="radio" name="sizeBy" id="rdoDraftTableData" />
                    <label for="rdoDraftTableData">Draft <span class="filter-text">Data</span></label>
                    <input type="radio" name="sizeBy" id="rdoPOTableData" />
                    <label for="rdoPOTableData">PO <span class="filter-text">Data</span></label>
                </div>
            </div>

            <!-- Filters -->
            <div class="col-12 col-md-8">
                <div class="d-flex flex-wrap align-items-end">
                    <div class="col-12 col-md-2">
                        <span class="form-label">
                            <select class="form-control FormfilterclrField" id="cmbFilterBranch">
                                <option value="0">Select Branch</option>
                            </select>
                            <label class="labelup" for="cmbFilterBranch">Branch</label>
                        </span>
                    </div>

                    <div class="col-12 col-md-3">
                        <span class="form-label">
                            <input class="form-control FormfilterclrField" type="text" id="txtFilterParty">
                            <label class="labelup" for="txtFilterParty">Party</label>
                        </span>
                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFParty"></div>
                    </div>

                    <div class="col-12 col-md-1">
                        <select class="gdInput" id="cmbFilterDatetype" onchange="SetFilterDate();"></select>
                    </div>

                    <div class="col-12 col-md-2">
                        <span class="form-label">
                            <input class="form-control FormfilterclrField" type="date" id="dtpFFrom"
                                   oninput="if (this.value > this.max) { this.value = this.max; }">
                            <label class="labelup" for="dtpFFrom">From</label>
                        </span>
                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFFrom"></div>
                    </div>

                    <div class="col-12 col-md-2">
                        <span class="form-label">
                            <input class="form-control FormfilterclrField" type="date" id="dtpFTo"
                                   oninput="if (this.value > this.max) { this.value = this.max; }">
                            <label class="labelup" for="dtpFTo">To</label>
                        </span>
                        <div class="text-danger pt-1 ps-1 clrdivs" id="divErrFTo"></div>
                    </div>
                    <div class="col-12 col-md-1">
                        <div class="form-check pb-3">
                            <input class="form-check-input FormfilterclrField" type="checkbox" id="chkShowAll">
                            <label class="form-check-label" for="chkShowAll">All Status</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-1">
                        <button id="btnFilter" class="btn btn-primary">
                            <i class="bi bi-funnel-fill"></i>  <span class="filter-text">Filter</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>      
        <table width="100%">
            <tr>
                <td width="10%" hidden>
                    <button id="btnAdd" class="btn btn-info"><span class="glyphicon glyphicon-plus" style="color: white"></span>&#x2009;Add</button>
                </td>
                <td align="left" width="70%">
                    <div class="container text-center" style="display:none;">
                        <div class="summary-box bg-paid">
                            <div class="summary-label">Paid</div>
                            <div class="summary-value" id="dvPaid">₹ 0.00</div>
                        </div>

                        <div class="summary-symbol">+</div>

                        <div class="summary-box bg-unpaid">
                            <div class="summary-label">Unpaid</div>
                            <div class="summary-value" id="dvUnPaid">₹ 0.00</div>
                        </div>

                        <div class="summary-symbol">=</div>

                        <div class="summary-box bg-total">
                            <div class="summary-label">Total</div>
                            <div class="summary-value" id="dvTotal">₹ 0.00</div>
                        </div>
                    </div>
                </td>
            </tr>
        </table>
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>

    <div id="dvMain">

        <div class="row g-2  align-items-start">
            <!-- Branch -->
            <div class="col mb-2" style="min-width: 150px;">
                <span class="form-label">
                    <select class="form-control FormclrcmbField" id="cmbBranch">
                        <option value="0">Select Branch</option>
                    </select>
                    <label class="labelup">Branch *</label>
                </span>
                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrBranch" class="clrdivs"></div>
            </div>

            <!-- Vendor -->
            <div class="col-auto mb-2" style="width: 400px;">
                <div class="input-group">
                    <span id="openvendor" class="input-group-text" title="New Vendor">
                        <span class="glyphicon glyphicon-export"></span>
                    </span>
                    <span class="form-label flex-grow-1">
                        <input class="form-control FormclrField" type="text" id="txtSearch" placeholder="Select Vendor">
                        <label class="labelup" for="txtSearch">Select *</label>
                    </span>
                    <span id="VendInfo" class="input-group-text">
                        <span class="glyphicon glyphicon-info-sign"></span>
                    </span>
                </div>
                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrSearch" class="clrdivs"></div>

                <!-- Hidden vendor info labels -->
                <div hidden>
                    <label id="lblName"></label>
                    <label id="lblMob1"></label>
                    <label id="lblGSTIN"></label>
                </div>
            </div>

            <!-- Payment Mode -->
            <div class="col mb-2" style="min-width: 120px; max-width: 140px;">
                <span class="form-label">
                    <select class="form-control FormclrcmbField" id="cmbPaymode">
                        <option value="0">Select Paymode</option>
                    </select>
                    <label class="labelup">Payment Mode *</label>
                </span>
                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrPaymode" class="clrdivs"></div>
            </div>

            <!-- Credit Term -->
            <div class="col mb-2" style="min-width: 120px; max-width: 140px;">
                <span class="form-label">
                    <select class="form-control FormclrcmbField" id="cmbCreditTerm">
                        <option value="0">Select Credit Term</option>
                    </select>
                    <label class="labelup">Credit Term *</label>
                </span>
                <div style="color: red; padding-top: 5px; padding-left: 5px;" id="divErrCreditTerm" class="clrdivs"></div>
            </div>

            <!-- Ref No -->
            <div class="col mb-2" style="min-width: 120px; max-width: 120px;">
                <span class="form-label">
                    <input class="form-control FormclrField" type="text" id="txtRefNo"
                           onbeforeinput="return AlphaNumericBeforeInput(event, this,'#divErrRefNo')"
                           oninput="sanitizeAlphaNumeric(this, '#divErrRefNo')" />
                    <label class="labelup">Ref No</label>
                </span>
                <div id="divErrRefNo" style="color: red; padding-top: 5px; padding-left: 5px;" class="clrdivs"></div>
