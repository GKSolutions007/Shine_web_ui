                        </div>
                        <div id="MainGrid" class="grid-wrap" style="width: 100%;"></div>
                    </div>
                </div>

            </div>
            <div class="right-section">
                <div class="party-info-box">
                    <input id="txtPartyID" hidden />

                    <div class="profile-card-header">
