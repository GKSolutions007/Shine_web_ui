        <div class="modal-content" style="border-radius:16px; overflow:hidden;">
            <div class="pi-header">
                <div class="pi-header-icon"><i class="fas fa-user"></i></div>
                <div>
                    <h4 class="mb-0 text-white fw-bold" id="piTitle">Party Information</h4>
                </div>
                <button type="button" class="btn-close btn-close-white pi-close" data-bs-dismiss="modal"></button>
            </div>
