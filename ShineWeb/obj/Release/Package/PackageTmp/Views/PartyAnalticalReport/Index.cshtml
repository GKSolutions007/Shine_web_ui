                        <div class="profile-main">
                            <h5 class="profile-name">
                                <label id="lblPartyName"></label>
                                <span class="glyphicon glyphicon-info-sign party-info-icon" title="Party Info" id="PartyInfo"></span>
                            </h5>
                            <div id="dvRatings" class="profile-rating">
                                <div class="star-rating">
                                    <input type="radio" id="star1" name="rating" value="1"><label for="star1">&#9733;</label>
                                    <input type="radio" id="star2" name="rating" value="2"><label for="star2">&#9733;</label>
                                    <input type="radio" id="star3" name="rating" value="3"><label for="star3">&#9733;</label>
                                    <input type="radio" id="star4" name="rating" value="4"><label for="star4">&#9733;</label>
                                    <input type="radio" id="star5" name="rating" value="5"><label for="star5">&#9733;</label>
                                </div>
                                <label id="lblRatingName" class="rating-name-label"></label>
                            </div>
                        </div>
                        <div class="stat-chip stat-balance">
                            <div class="stat-icon"><i class="bi bi-wallet2"></i></div>
                            <div class="stat-text">
                                <span class="stat-label">Balance</span>
                                <label id="lblClosingBalance" class="stat-value stat-value-big">0.00 Cr</label>
                            </div>
                        </div>
                        <div class="stat-chip stat-highlight">
                            <div class="stat-icon"><i class="bi bi-speedometer2"></i></div>
                            <div class="stat-text">
                                <span class="stat-label">Avg. Collection Days</span>
                                <label id="lblAccValue" class="stat-value stat-value-big">0</label>
                            </div>
                        </div>
                    </div>

                    <div class="profile-stats" hidden>
                        <div class="stat-chip">
                            <div class="stat-icon"><i class="bi bi-telephone-fill"></i></div>
                            <div class="stat-text">
                                <label id="lblMobNo" class="stat-value"></label>
                            </div>
                        </div>
                        <div class="stat-chip">
                            <div class="stat-icon"><i class="bi bi-geo-alt-fill"></i></div>
                            <div class="stat-text">
                                <label id="lblAddress" class="stat-value" style="padding-top:3px"></label>
