<style>
    td {
        font-size: 12px;
    }


    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -40%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }

    tr {
        cursor: pointer
    }
</style>
<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 6px 2px;
        font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
        background-color: #f2f5f9;
        color: #1f2d3d;
    }

    /* ============ PAGE HEADER ============ */
    .app-shell {
        max-width: 1700px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 4px 4px 16px;
        animation: fadeSlideIn 0.4s ease;
    }

    .page-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, #1a6fb5 0%, #2596f0 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 10px rgba(26, 111, 181, 0.3);
        flex-shrink: 0;
    }

    .page-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 800;
        color: #0f2f4d;
        letter-spacing: 0.2px;
    }

    .page-header p {
        margin: 2px 0 0;
        font-size: 12.5px;
        color: #7c8a99;
    }

    /* ============ LAYOUT ============ */
    .containerPartyAnalytics {
        display: flex;
        gap: 0px;
        flex-wrap: nowrap; /* keep left/right side-by-side; prevents right panel from dropping below on collapse */
        align-items: stretch;
        height: calc(100vh - 70px);
        min-height: 600px;
        transition: gap 0.35s ease;
    }

    .left-section {
        flex: 1 1 0;
        min-width: 230px;
        max-width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: flex-basis 0.35s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .right-section {
        flex: 2 1 0;
        min-width: 0;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 2px;
        transition: flex-grow 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Collapsed state: left section shrinks to a slim rail, right section reclaims the space */
    .containerPartyAnalytics.left-collapsed .left-section {
        flex: 0 0 56px;
        min-width: 56px;
        max-width: 56px;
    }

    .containerPartyAnalytics.left-collapsed .right-section {
        flex: 1 1 0;
    }

    .party-box-content {
        opacity: 1;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: opacity 0.2s ease 0.1s, visibility 0.2s ease 0.1s;
    }

    .containerPartyAnalytics.left-collapsed .party-box-content {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.15s ease, visibility 0.15s ease;
    }

    .collapse-toggle-btn {
        position: absolute;
        top: 3px;
        right: 8px;
        z-index: 20;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: none;
        border-radius: 50%;
        background-color: #eef3f8;
        color: #1a6fb5;
        cursor: pointer;
        transition: background-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

        .collapse-toggle-btn:hover {
            background-color: #1a6fb5;
            color: #ffffff;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3);
            transform: scale(1.08);
        }

        .collapse-toggle-btn:active {
            transform: scale(0.95);
        }

        .collapse-toggle-btn .toggle-icon {
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

    .containerPartyAnalytics.left-collapsed .collapse-toggle-btn .toggle-icon {
        transform: rotate(180deg);
    }

    /* Rail icon shown only while the left panel is collapsed */
    .rail-icon {
        position: absolute;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 18px;
        color: #1a6fb5;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease 0.15s, visibility 0.2s ease 0.15s;
    }

    .containerPartyAnalytics.left-collapsed .rail-icon {
        opacity: 1;
        visibility: visible;
    }

    /* Vertical label shown only while the left panel is collapsed */
    .collapsed-label {
        position: absolute;
        top: 110px;
        left: 50%;
        transform: translateX(-50%) rotate(90deg);
        transform-origin: center;
        white-space: nowrap;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #1a6fb5;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease 0.15s, visibility 0.2s ease 0.15s;
    }

    .containerPartyAnalytics.left-collapsed .collapsed-label {
        opacity: 1;
        visibility: visible;
    }

    .party-box {
        background-color: #ffffff;
        padding: 0;
        height: 100%;
        border-radius: 16px;
        border: 1px solid #e6ebf1;
        box-shadow: 0 4px 18px rgba(15, 47, 77, 0.07);
        position: relative;
        overflow: hidden;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
        animation: fadeSlideIn 0.4s ease;
    }

    .containerPartyAnalytics.left-collapsed .party-box {
        background-color: #f7fbff;
    }

    .party-info-box {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        padding: 0;
        flex: 0 0 auto;
        border-radius: 16px;
        border: 1px solid #e6ebf1;
        box-shadow: 0 4px 18px rgba(15, 47, 77, 0.07);
        overflow: hidden;
        animation: fadeSlideIn 0.4s ease;
    }

    .documents-box {
        background-color: #ffffff;
        padding: 0;
        flex: 1 1 auto;
        min-height: 0;
        border-radius: 16px;
        border: 1px solid #e6ebf1;
        box-shadow: 0 4px 18px rgba(15, 47, 77, 0.07);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: fadeSlideIn 0.4s ease 0.05s both;
    }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes popIn {
        0% {
            transform: scale(0.85);
            opacity: 0;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@media (max-width: 900px) {
        .containerPartyAnalytics {
            flex-direction: column;
            flex-wrap: wrap;
            height: auto;
            min-height: 0;
        }

        .left-section,
        .right-section {
            flex: 1 0 100% !important;
            max-width: 100% !important;
            min-width: 100% !important;
            height: auto;
        }
        /* On mobile the left panel becomes a full-width accordion; same left-collapsed
           class/logic as desktop, just re-skinned from a vertical rail to a horizontal bar */
        .party-box {
            height: auto;
            max-height: 640px;
            overflow: hidden;
            transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s ease;
        }

        .containerPartyAnalytics.left-collapsed .party-box {
            max-height: 58px;
        }

        .party-box-content {
            opacity: 1;
            visibility: visible;
            height: auto;
            pointer-events: auto;
        }

        .containerPartyAnalytics.left-collapsed .party-box-content {
            opacity: 0;
            visibility: hidden;
            height: 0;
            pointer-events: none;
            transition: opacity 0.15s ease, visibility 0.15s ease;
        }

        .collapse-toggle-btn {
            position: absolute;
            top: 14px;
            right: 14px;
        }

            .collapse-toggle-btn .toggle-icon {
                transform: rotate(90deg);
            }

        .containerPartyAnalytics.left-collapsed .collapse-toggle-btn .toggle-icon {
            transform: rotate(-90deg);
        }

        .rail-icon,
        .collapsed-label {
            position: static;
            transform: none;
            display: none;
            align-items: center;
            font-size: 14px;
            opacity: 1;
            visibility: visible;
        }

        .containerPartyAnalytics.left-collapsed .rail-icon {
            display: inline-flex;
            padding: 18px 0 18px 18px;
        }

        .containerPartyAnalytics.left-collapsed .collapsed-label {
            display: inline-flex;
            padding: 18px 50px 18px 8px;
        }

        .profile-stats {
            grid-template-columns: repeat(2, 1fr) !important;
        }
    }

    @@media (max-width: 480px) {
        .profile-stats {
            grid-template-columns: 1fr !important;
        }

        .profile-card-header {
            flex-wrap: wrap;
        }
    }

    @@media (min-width: 1200px) {
        .containerPartyAnalytics {
            max-width: 100% !important;
        }
    }

    .main {
        padding-left: 0px !important;
        padding-top: 8px !important;
        padding-bottom: 12px !important;
        width: 100% !important;
        margin-left: 0px !important;
    }
</style>
<style>
    .star-rating {
        direction: rtl;
        display: inline-flex;
        font-size: 3rem;
    }

        .star-rating input {
            display: none;
        }

        .star-rating label {
            color: #ccc;
            cursor: pointer;
            padding: 0 5px;
        }

        .star-rating input:checked ~ label {
            color: gold;
        }

        /* ============ RATING ENHANCEMENTS ============ */
        .star-rating label {
            transition: all 0.2s ease;
        }

            .star-rating label:hover {
                transform: scale(1.2);
                animation: bounce 0.5s;
            }

    .rating-excellent {
        color: #007BFF;
    }

    .rating-good {
        color: #28A745;
    }

    .rating-average {
        color: #FD7E14;
    }

    .rating-poor {
        color: #DC3545;
    }

    .rating-block {
        color: red;
    }

    .eye-number-icon {
        position: relative;
        display: inline-block;
        font-size: 24px;
        line-height: 1;
    }

        .eye-number-icon span {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -52%);
            font-size: 11px;
            font-weight: 700;
        }

    .pi-header {
        background: linear-gradient(135deg, #0d5c3f 0%, #14804f 100%);
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }

    .pi-header-icon {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        color: white;
        flex-shrink: 0;
    }

    .pi-header h4 {
        font-size: 17px;
    }

    .pi-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background-color: rgba(255,255,255,0.15) !important;
        border-radius: 6px;
        padding: 5px;
    }

    .pi-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .pi-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 2px;
        padding: 9px 14px;
        border-bottom: 1px solid #f0f0f0;
        min-width: 0;
    }

        .pi-row.full {
            grid-column: 1 / -1;
        }

        .pi-row.highlight {
            background-color: #eafaf1;
        }

    .pi-icon-chip {
        width: 26px;
        height: 26px;
        background-color: #eafaf1;
        color: #14804f;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        margin-top: 1px;
    }

    .pi-label {
        width: auto;
        white-space: nowrap;
        color: #6b7280;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-colon {
        color: #9ca3af;
        width: 6px;
        font-size: 12px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .pi-value {
        font-weight: 600;
        color: #111827;
        font-size: 13px;
        min-width: 0;
        flex: 1;
        white-space: normal;
        overflow: visible;
        word-break: break-word;
        line-height: 1.35;
    }

        .pi-value.muted {
            color: #9ca3af;
            font-weight: 400;
        }

    .pi-badge-good {
        background-color: #eafaf1;
        color: #14804f;
        padding: 2px 10px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 11px;
    }
</style>
<style>
    /* ============ LEFT PANEL: header + controls ============ */
    .panel-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 46px 3px 12px;
        flex-shrink: 0;
    }

    .panel-header-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #1a6fb5 0%, #2596f0 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
        box-shadow: 0 3px 8px rgba(26, 111, 181, 0.3);
    }

    .panel-title {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: #0f2f4d;
    }

    .panel-controls {
        padding: 0 16px 2px;
        flex-shrink: 0;
    }

    .showall-switch {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
        font-size: 13px;
        color: #37485c;
        font-weight: 500;
    }

        .showall-switch .form-check-input {
            width: 2.3em;
            height: 1.25em;
            cursor: pointer;
            margin-top: 0;
        }

            .showall-switch .form-check-input:checked {
                background-color: #1a6fb5;
                border-color: #1a6fb5;
            }

        .showall-switch label {
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
        }

    .type-toggle {
        display: flex;
        background: #eef3f8;
        border-radius: 10px;
        padding: 4px;
        gap: 4px;
    }

        .type-toggle input {
            display: none;
        }

    .type-toggle-btn {
        flex: 1;
        text-align: center;
        padding: 6px 5px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        color: #5b6b7d;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin: 0;
        user-select: none;
    }

    .type-toggle input:checked + .type-toggle-btn {
        background: #ffffff;
        color: #1a6fb5;
        box-shadow: 0 2px 6px rgba(15, 47, 77, 0.15);
        transform: translateY(-1px);
    }

    .type-toggle-btn:hover {
        color: #1a6fb5;
    }

    .grid-wrap {
        flex: 1 1 auto;
        min-height: 0;
        padding: 3px 5px 0px;
        overflow: auto;
    }

    /* ============ RIGHT TOP PANEL: profile card ============ */
    .profile-card-header {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 7px 10px 6px;
        border-bottom: 1px solid #eef2f6;
    }

    .profile-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a6fb5 0%, #2596f0 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(26, 111, 181, 0.35);
        animation: popIn 0.35s ease;
    }

    .profile-main {
        flex: 1;
        min-width: 0;
    }

    .profile-name {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 2px 0 6px;
        font-size: 15px;
        font-weight: 700;
        color: #0f2f4d;
        flex-wrap: wrap;
    }

        .profile-name label {
            margin: 0;
            cursor: default;
        }

            .profile-name label:empty:before {
                content: "Select a party to view details";
                color: #9aa7b4;
                font-weight: 400;
                font-size: 14px;
            }

    .party-info-icon {
        cursor: pointer;
        color: #1a6fb5;
        font-size: 16px;
        transition: transform 0.2s ease, color 0.2s ease;
        display: inline-flex;
    }

        .party-info-icon:hover {
            transform: scale(1.2);
            color: #14804f;
        }

    .profile-rating {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .profile-rating .star-rating {
            font-size: 1.35rem !important;
            gap: 1px;
        }

            .profile-rating .star-rating label {
                padding: 0 2px;
            }

    .rating-name-label {
        font-size: 12px;
        font-weight: 700;
        padding: 3px 11px;
        border-radius: 20px;
        background: #f3f5f7;
        margin: 0;
        letter-spacing: 0.2px;
    }

    .profile-stats {
        display: grid;
        /*grid-template-columns: repeat(4, 1fr);*/
        grid-template-columns: 1fr 2.3fr 1fr;
    }

    .stat-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 3px 6px;
        border-right: 1px solid #eef2f6;
        border-top: 1px solid #eef2f6;
        transition: background 0.2s ease;
        min-width: 0;
    }

        .stat-chip:hover {
            background: #f7fbff;
        }

        .stat-chip:nth-child(4n) {
            border-right: none;
        }

    .stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #eaf3fb;
        color: #1a6fb5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
    }

    .stat-text {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .stat-label {
        font-size: 9.5px;
        color: #8996a5;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .stat-value {
        font-size: 11px;
        font-weight: 600;
        color: #1f2d3d;
        white-space: normal;
        word-break: break-word;
        margin: 0;
        line-height: 1.3;
    }

        .stat-value:empty:before {
            content: "--";
            color: #c3cbd4;
        }

    .stat-value-big {
        font-size: 16px;
        font-weight: 800;
    }

    .stat-balance .stat-icon {
        background: #fdeceb;
        color: #dc3545;
    }

    .stat-highlight .stat-icon {
        background: #eafaf1;
        color: #14804f;
    }

    /* ============ RIGHT BOTTOM PANEL: transactions ============ */
    .doc-panel-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 18px;
        border-bottom: 1px solid #eef2f6;
        flex-shrink: 0;
    }

    .doc-panel-header-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: linear-gradient(135deg, #14804f 0%, #1fae72 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .doc-panel-title {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #0f2f4d;
    }

    .grid-body {
        flex: 1 1 auto;
        min-height: 0;
       /* overflow: auto;*/
        padding: 5px 8px 12px;
    }
</style>
<div class="modal fade" id="partyInfoModal" tabindex="-1" data-bs-backdrop="static">
