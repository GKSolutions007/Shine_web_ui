                <div class="party-box">

                    @*<button type="button" id="btnToggleLeft" class="collapse-toggle-btn" title="Collapse Panel">
                            <i class="bi bi-chevron-left toggle-icon"></i>
                        </button>*@
                    <button type="button" id="btnToggleLeft" class="collapse-toggle-btn" title="Collapse Panel">
                        <i class="bi bi-layout-sidebar-inset" style="font-size:14px"></i>
