                        </div>
                    </div>
                </div>

                <!-- Modern Footer -->
                <div class="modern-footer d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-success btn-modern" id="btnYes">Yes</button>
                    <button type="button" class="btn btn-danger btn-modern" id="btnNo">No</button>
                </div>

            </div>
        </div>
    </div>
    <script>
        var RID = '@Session["RoleID"]';
        var ItemsperPage =  parseInt('@Session["ItemsperPage"]', 10) < 0 ? 'All' :parseInt('@Session["ItemsperPage"]', 10)  || 10;
        var SendAutoMail = 0;
        var RetainDate = parseInt('@Session["RetainDate"]');
        var PreviousItemsCount = 0, PreviousNetAmt = 0;
        var autoDraftInterval = null;
        var autosavetimeinterval = (parseInt('@Session["DraftAutoSaveTimeInterval"]') * (60 * 1000));//
        function DraftAutosavetrigger() {
            var currentItemCount = ProductTable.rows().count();
            var currentNetAmt = document.getElementById("lblRoundNet").getAttribute("lbltag");
            if ((currentItemCount != PreviousItemsCount) || (currentNetAmt != PreviousNetAmt)) {
                if (nTransMode == 1 || nTransMode == 2) {
                    PreviousItemsCount = ProductTable.rows().count();
                    PreviousNetAmt = document.getElementById("lblRoundNet").getAttribute("lbltag");
                    //$("#btnDraft").click();
                    nIsDraft = 1;
                    SaveData(1);
                }
            }
        }
        function startAutoDraftSave() {
            if (autoDraftInterval) return; // prevent multiple intervals
            autoDraftInterval = setInterval(function () {
                DraftAutosavetrigger();
            }, autosavetimeinterval);
        }
        function stopAutoDraftSave() {
            clearInterval(autoDraftInterval);
            autoDraftInterval = null;
        }
        function formatIndianCurrency(num) {
            return '₹ ' + parseFloat(num).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    </script>
