                            <i class="fas fa-refresh fa-2x mb-2" id="clearcfdicon"></i>
                            <i class="fas fa-times fa-2x" id="closecfdicon"></i>
                        </div>
                        <!-- Message on the right -->
                        <div id="confirmMessageWrapper">
