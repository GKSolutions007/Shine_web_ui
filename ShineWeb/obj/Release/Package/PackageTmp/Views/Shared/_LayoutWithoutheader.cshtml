    function GetDocumentID(dtpDate, nBranchID, nTransID, oldprefix, isModify, fieldid) {
        if (nBranchID > 0 && dtpDate != "") {
            $.ajax({
                url: Aurl + "documentseries/docid",
                type: 'get',
                contentType: 'json',
                data: { TransID: nTransID, BranchID: nBranchID, DocDate: dtpDate },
                xhrFields: {
                    withCredentials: true
                }, async: false,
                success: function (data) {
                    $.each(data, function (i, items) {
                        if (items.MsgID == "0") {
                            if (isModify) {
                                if (oldprefix == items.Prefix) {
                                    $("#lblDocID").text(items.DocID);
                                    document.getElementById("lblDocID").setAttribute("docprefix", items.Prefix);
                                }
                                else {
                                    showErrorSnackbar("Value cannot be changed");
                                    var olddata = $("#" + fieldid).data("oldvalue");
                                    $("#" + fieldid).val(olddata);
                                }
                            } else {
                                $("#lblDocID").text(items.DocID);
                                document.getElementById("lblDocID").setAttribute("docprefix", items.Prefix);
                            }
                        }
                        else {
                            if (isModify) {
                                if (oldprefix != items.Prefix) {
                                    showErrorSnackbar("Value cannot be changed");
                                    var olddata = $("#" + fieldid).data("oldvalue");
                                    $("#" + fieldid).val(olddata);
                                }
                            } else {
                                showErrorSnackbar(items.Message);
                                $("#lblDocID").text("--");
                            }
                        }
                    });
                },
                error: function (data) {

                },
            });
        } else {
            showErrorSnackbar("Select Valid Branch/Date");
        }
    }
