    <div id="dvMainTable">
        <div class="row">
            <div class="col-12">

                <input type="text" class="gdInput" name="CustomeFilter" id="txtCustomFilter" hidden />

                <table class="table table-bordered" id="tblMasterFAData" style="width:100%">
                    <thead>
                        <tr class="trclrforcolheader">
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:0%;">ID</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:2%;">#</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:48%;">Account Name</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:10%;">Amount</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:10%;">Ref No</th>
                            <th class="text-center trclrforcolheader" style="font-size:12px;width:30%;">Remarks</th>
                        </tr>
                    </thead>

                    <tfoot>
                        <tr>
                            <td colspan="3"></td>

                            <td class="text-end">
                                <label id="lblTotal">0.00</label>
                            </td>

                            <td colspan="2">
                                <div class="text-end pt-0">

                                    <button type="button" class="btn btn-danger" id="btnClear">
                                        Clear
                                    </button>

                                    <button type="button" class="btn btn-success" id="btnSave">
                                        Save
                                    </button>

                                </div>
                            </td>
                        </tr>
                    </tfoot>

                </table>
            </div>
        </div>
    </div>

</body>
<script type="text/javascript">

    var Table = $('#tblMasterFAData').DataTable({pageLength: ItemsperPage,lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        "bFilter": true,
        "bSearchable": true,
        "bInfo": false,
        "bPaginate": false,
        "ordering": true,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        order: [[3, 'asc']],
        "columnDefs": [{ "targets": [0], "visible": false, searchable: false }, { "targets": [1], "class": "text-center" },
            { "targets": [3], "class": "text-right" }, { "targets": [2], width: "48%" }, { "targets": [3], width: "10%" }, { "targets": [4], width: "12%" }
            , { "targets": [5], width: "30%" },
            {
                "targets": 3, // Amount column index
                "className": "text-right",
                render: function (data, type, row, meta) {
                    if (type === 'sort') {
                        // Extract value from the input HTML
                        var input = $('<div>').html(data).find('input').val();
                        console.log("Value - ", parseFloat(input) || 0);
                        return parseFloat(input) || 0;
                    }
                    return data; // return raw HTML for display
                }
            },
        ],
    });
    function bindLiveSortEvents() {
        $('#tblMasterFAData tbody').on('keyup change', 'input', function () {
            Table.draw(); // Redraw and re-sort the table
        });
    }
    if ($("#txtEnableBranch").val() == 1) {
        $("#txtBranchName").prop("disabled", true);
    }
    // Call it once on page load
    //bindLiveSortEvents();
    function filterme(searchValue) {
        //var searchValue = $('#txtCustomFilter').val().trim();

        $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
            var value = parseFloat(data[3]) || 0; // Convert first column to number
            var category = data[2] || ''; // Get the second column value

            //return (searchValue == "" || category.toUpperCase() == searchValue.toUpperCase());//value > 0 &&
            return (category.includes(searchValue));
        });

        Table.draw();
        $.fn.dataTable.ext.search.pop(); // Remove the filter after applying it
    }
    $('#txtCustomFilter').on('change', function (e) {
        var val = e.target.value;
        filterme(val);
    });
    var Aurl = '@Session["APIurl"]';
    var UID = '@Session["LoginUserID"]';
    var DecVal = '@Session["DecimalValues"]';
    @*var DefBranch = '@Session["DefaultBranch"]';*@
    LoadBranchByRoles();
    var RID = '@Session["RoleID"]';
    GetData();

    $('#dtpDate,#txtBranchName').on('focus', function () {
        $(this).data("oldvalue", $(this).val());
    });
    $("#dtpDate").change(function (e) {
        var DocDate = e.target.value;
        var id = e.target.id;
        var Branch = $("#txtBranchName").val();
        var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        var isedit = nTransMode == 2;
        GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });

    $("#txtBranchName").change(function (e) {
        //if (typeof GetDocumentID !== "function") return;
        //var DocDate = $("#dtpDate").val();
        //var Branch = e.target.value;
        //var id = e.target.id;
        //var prefix = document.getElementById("lblDocID").getAttribute("docprefix");
        //var isedit = nTransMode == 2;
        //GetDocumentID(DocDate, Branch, FID, prefix, isedit, id);
    });

    function GetData() {
        $.ajax({
            url: Aurl + "dailycashexpenses/get",
            type: 'get',
            contentType: 'json',
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (data.length > 0) {
                    var accdata = JSON.parse(data);
                    console.log('var data :', accdata);
                    Table.draw().clear(); Table.draw().clear();
                    var billjsdata = accdata.Table;
                    var branchdata = accdata.Table1;
                    console.log('var branchdata :', branchdata);
                    $('#tblMasterFAData').DataTable({
                        pageLength: ItemsperPage, lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                        scrollY: "450px",
                        scrollX: true,
                        scrollCollapse: true,
                        paging: true,
                        destroy: true,
                        data: billjsdata,
                        fixedColumns: false,
                        searching: true,
                        ordering: true,
                        sorting: false,
                        pageLength: ItemsperPage, // default page size
                        lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                        columns: [
                            { "data": "FAID", "autoWidth": true, "visible": false, className: "dt-body-left" },//0
                            {
                                className: "dt-body-center", width: "5%",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = (meta.row + 1);
                                    var _action = rowIndex;
                                    return _action;
                                },
                            },
                            { "data": "AccountName", width: "40%", "autoWidth": true, className: "dt-body-left" },//1
                            {
                                //
                                className: "dt-body-right",width:"10%",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = (meta.row + 1);
                                    var _action = rowIndex;
                                    return '<input type="number" name ="Amount" txttag="0" class="gdInput txtsettag dgvAmount" value="" id="txtAmount' + rowIndex + '" onbeforeinput="return NumericOnlyBeforeInput(event, this,null)"oninput="sanitizeNumericOnly(this, null)"/>';
                                },
                            },
                            {
                                className: "dt-body-left", width: "15%",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = (meta.row + 1);
                                    var _action = rowIndex;
                                    return '<input type="text" name ="RefNo" class="gdInput" value="" id="txtRefNo' + rowIndex + '"/>';
                                },
                            },
                            {
                                className: "dt-body-left", width: "30%",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = (meta.row + 1);
                                    var _action = rowIndex;
                                    return '<input type="text" name ="Remarks" class="gdInput" value="" id="txtRemarks' + rowIndex + '"/>';
                                },
                            },
                        ],

                    });
                    Table = $('#tblMasterFAData').DataTable();

                    if ($("#txtEnableBranch").val() == 1) {
                        $("#txtBranchName").prop("disabled", true);
                    }
                    $('#txtBranchName').find("option").remove().append($('<option/>', {
                        value: 0,
                        text: "-- Select --",
                    }));
                    $.each(branchdata, function (i, Britems) {
                        $('#txtBranchName').append($('<option/>', {
                            value: Britems.ID,
                            text: Britems.Name,
                        }));
                    });
                    //$("#txtBranchName").val(DefBranch);
                    LoadBranchByRoles();
                }
                else {
                    showErrorSnackbar("No Records Found");
                }
            }
            , error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
    $('#sortOrder').change(function () {
        var direction = $(this).val(); // 'asc' or 'desc'
        Table.order([3, direction]).draw(); // 0 is the column index
    });
    setDate("dtpDate", 0);
    function setDate(FieldID,Type) {
    $.ajax({
         url: "@Url.Action("setdate", "Home")",
        type: 'get',
        contentType: 'json',
        data: { TypeID: Type },
        success: function (data) {
            $.each(data, function (i, items) {
                $("#" + FieldID).attr("max", items.MaxDate);
                $("#" + FieldID).attr("min", items.MinDate);
                $("#" + FieldID).val(items.Value);
            });
        }, error: function (data) {
            if (data.status == "401") {
                var msg = data.responseJSON.Message;
                //showErrorSnackbar(msg + " Logout and Login again.");
            }
        }
    })
    }
    $('input[type=number]').focusin(function (e) {
        $(this).select();
    });
    function SetTagZero() {
        var inputs = $(".txtsettag");
        for (var i = 0; i < inputs.length; i++) {
            var field = $(inputs[i]);
            var FID = field[0].id;
            if (FID != "")
                updateInputColumn(FID, 0);
        }
        inputs = $(".lblsettag");
        for (var i = 0; i < inputs.length; i++) {
            var field = $(inputs[i]);
            var FID = field[0].id;
            if (FID != "") {
                updateLabelColumn(FID, 0);
            }
        }
    }
    $('#tblMasterFAData tbody').on('focusin', 'td>.txtsettag', function (e) {
        // .txtsettag
        var id = e.target.id;
        var name = e.target.name;
        var value = e.target.value;
        //getTagValue(id, name);
        const val = document.getElementById(id).getAttribute("txttag");
        $("#" + id).val(val);
        $("#" + id).select();
        gridchanges = false;
    });
    var batgridchanges = false;
    $('#tblMasterFAData tbody').on('blur', 'td>.txtsettag', function (e) {
        // .txtsettag
        var id = e.target.id;
        var name = e.target.name;
        var value = e.target.value;
        if (!gridchanges)
            updateInputColumn(id, e.target.value);
    });
    function updateLabelColumn(labelID, netValue) {
        //const label = document.getElementById(`dgvProdGross${rowId}`);
        const label = document.getElementById(labelID);
        label.setAttribute('lbltag', netValue.toFixed(4));
        label.innerText = netValue.toFixed(DecVal);
        label.title = netValue.toFixed(4);
    }
    function updateInputColumn(inputID, netValue) {
        //const label = document.getElementById(`dgvProdGross${rowId}`);
        const input = document.getElementById(inputID);
        var value = netValue != "" ? netValue : 0;
        input.setAttribute('txttag', parseFloat(value).toFixed(4));
        input.value = parseFloat(value).toFixed(DecVal);
        input.title = netValue;
    }
    var gridchanges = false;
    $('#tblMasterFAData tbody').on('change', '.dgvAmount', function (e) {
        var TotAmt = 0
        gridchanges = true;
        var id = e.target.id;
        var name = e.target.name;
        var value = e.target.value;
        //showSuccessSnackbar("Value : " + value);
        updateInputColumn(id, e.target.value);
        $("#tblMasterFAData tbody tr").each(function () {
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Amount") {
                    TotAmt += parseFloat($(this).attr("txttag"));
                }
            });
        });
        updateLabelColumn("lblTotal", TotAmt)
    });

    function LoadBranchByRoles() {
        var RID = '@Session["RoleID"]';
        console.log("RoleID being sent:", RID);
        $.ajax({
            url: Aurl + "BranchMapping/getByRole",
            type: 'GET',
            dataType: 'json',
            data: { RoleID: RID },
            xhrFields: { withCredentials: true },
            success: function (data) {
                console.log("Data returned from API:", data);
                $('#txtBranchName').empty();
                $('#txtBranchName').append($('<option/>', { value: 0, text: "-- Select --" }));
                var defaultBranch = 0;
                $.each(data, function (i, item) {
                    console.log("Adding item to dropdown:", item);
                    $('#txtBranchName').append($('<option/>', {
                        value: item.BranchID,
                        text: item['Branch Name']
                    }));
                    if (item.SetAsDefault) {
                        defaultBranch = item.BranchID;
                    }
                });
                if (defaultBranch != 0) {
                    $('#txtBranchName').val(defaultBranch).trigger("change");
                }
            }
        });
    }


    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        setDate("dtpDate", 0);
        $(".clrdiv").html("");
        $("#lblTotal").text("0.00");
        GetData();
    }
    var AccArray = [];
    function addAccountsinArray() {
        AccArray = [];
        $("#tblMasterFAData tbody tr").each(function () {
            var allValues = {}, nFAID = 0, Amount = 0, strRefNo = '', strRemark = '';
            rowdata = Table.row($(this)).data();
            nFAID = rowdata.FAID;//[0];
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Amount") {
                    Amount = parseFloat($(this).attr("txttag"));
                }
                if (fieldName == "RefNo") {
                    strRefNo = $(this).val();
                }
                if (fieldName == "Remarks") {
                    strRemark = $(this).val();
                }
            });
            if (Amount > 0) {
                allValues = {
                    "FAID": nFAID,
                    "CollAmt": Amount,
                    "DocRef": strRefNo,
                    "TransName": strRemark
                };
                AccArray.push(allValues);
            }
        });
    }
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        $("#lblTotal").css("color", "black");
        var IsValid = true;
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#divErrDate").html("Select Date");
            showErrorSnackbar("Select Date");
        }
        if ($("#txtBranchName").val() == 0) {
            IsValid = false;
            $("#divErrBranch").html("Select Branch");
            showErrorSnackbar("Select Branch");
        }
        var value = document.getElementById("lblTotal").getAttribute("lbltag");
        if (parseFloat(value) <= 0) {
            IsValid = false;
            $("#lblTotal").css("color", "red");
            showErrorSnackbar("Enter value in any one account");
        }
        if (IsValid) {
            addAccountsinArray();
            if (cfFocus != 3) {
                ConfirmDialogMsg("Do you want to save data?");
            } else {
                SaveData();
            }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        var lstMaster = {
            "Mode": 1,
            "ID": $("#txtID").val(),
            "DocDate": $("#dtpDate").val(),
            "UserID": UID,
            "BranchID": $("#txtBranchName").val(),
            "lstCollPayDtl": AccArray
        }
        console.log("Save Payload:",lstMaster)
        $.ajax({
            url: Aurl + "dailycashexpenses/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstMaster),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        ClearForm();
                        showSuccessSnackbar(items.Message);
                    }
                    else {
                        $("#dvErrorName").html(items.Message);
                        showErrorSnackbar(items.Message);
                        //alert(items.Message);
                    }
                });
            },
            error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }
</script>