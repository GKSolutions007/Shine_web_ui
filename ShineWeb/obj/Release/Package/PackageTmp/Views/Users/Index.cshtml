@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />

<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>
   
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 35%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -50%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
    .password-wrapper {
        position: relative;
    }

    .form-label {
        position: relative;
        display: block;
    }

    .toggle-password {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #777;
        font-size: 16px;
        z-index: 10;
    }

    #txtPassword {
        padding-right: 40px;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })
    @Html.HiddenFor(model => model.ChildURL1, new { @autocomplete = "off", @class = "form-control", @id = "txtChildRoleURL" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>
    
    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>

    <div class="modal fade" id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title  fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body text-center">
                        <table class="table w-100">
                            <tbody>

                                <tr>
                                    <td class="border-0 px-2" colspan="2">
                                        <span class="form-label">
                                            <input tabindex="1" type="text" id="txtUserName"
                                                   class="form-control FormclrField"
                                                   onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorUserName')"
                                                   oninput="sanitizeAlphaNumeric(this, '#dvErrorUserName')" />

                                            <label class="labelup">User Name *</label>
                                        </span>

                                        <div class="clrdiv text-danger" id="dvErrorUserName"></div>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="border-0 px-2" colspan="2">
                                        <div class="password-wrapper">
                                            <span class="form-label">
                                                <input tabindex="2"
                                                       type="password"
                                                       id="txtPassword"
                                                       class="form-control FormclrField" />
                                                <label class="labelup">Password *</label>

                                                <span class="toggle-password" onclick="togglePassword()">
                                                    <i style=" opacity: 0.6;" id="eyeIcon" class="fa fa-eye"></i>
                                                </span>
                                            </span>
                                        </div>
                                        <div class="clrdiv text-danger" id="dvErrorPassword"></div>

                                    </td>
                                </tr>

                                <tr>
                                    <td class="border-0 px-2" colspan="2">

                                        <span class="form-label">
                                            <input tabindex="3"
                                                   type="number"
                                                   id="txtMobileNo"
                                                   class="form-control FormclrField"
                                                   maxlength="12"
                                                   oninput="if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); }" />

                                            <label class="labelup">Mobile No</label>
                                        </span>

                                        <div class="clrdiv text-danger" id="dvErrorMobileNo"></div>

                                    </td>
                                </tr>

                                <tr>
                                    <td class="border-0 px-2" colspan="2">

                                        <span class="form-label">
                                            <input tabindex="4"
                                                   type="text"
                                                   id="txtEMail"
                                                   class="form-control FormclrField" style="text-transform:lowercase" />

                                            <label class="labelup">E-Mail ID *</label>
                                        </span>

                                        <div class="clrdiv text-danger" id="dvErrorEmailID"></div>

                                    </td>
                                </tr>

                                <tr>
                                    <td class="border-0 px-2" colspan="2">
                                        <div class="input-group">
                                            <span id="openrole" class="input-group-text" title="New Bank Name"><span class="fas fa-arrow-up-right-from-square"></span></span>
                                            <span class="form-label flex-fill">
                                                <select tabindex="5"
                                                        id="cmbRole"
                                                        class="form-control">
                                                </select>

                                                <label class="labelup">Role</label>
                                            </span>

                                            <a href="javascript:void(0)" id="hrefNewRole" hidden>New Role</a>

                                            <div class="clrdiv text-danger" id="dvErrorRole"></div>
                                        </div>

                                    </td>
                                </tr>

                                <tr>
                                    <td class="border-0 text-start ps-2" colspan="2">
                                        <label for="chkActive">Active :</label>
                                        <input tabindex="6"
                                               type="checkbox"
                                               id="chkActive"
                                               checked
                                               disabled />

                                        <div class="clrdiv text-danger" id="dvErrorActive"></div>
                                    </td>
                                </tr>

                            </tbody>
                        </table>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">@*//bg-info*@

                    <button tabindex="8" type="button" class="btn btn-danger" id="btnClear">
                        <span class="glyphicon glyphicon-refresh"> Clear</span>
                    </button>

                    <button tabindex="7" type="button" class="btn btn-success" id="btnSave">
                        <span class="glyphicon glyphicon-saved"> Save</span>
                    </button>

                    <button tabindex="9" type="button" class="btn btn-warning" id="btnClose">
                        <i class="bi bi-x-circle"></i> Close
                    </button>

                </div>

            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                nMode = 3;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                GetData(4, ID);
                $(".FormclrField").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbRole").prop("disabled", true);
                $("#btnClear,#btnSave").hide();
                $("#btnClose").show();
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                $(".clrdiv").html("");
                nMode = 2;
                //rowData = Table.row($(this).parents('tr')).data();
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                var ID = rowData.ID;//[0];
                GetData(4, ID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbRole").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                $("#btnClear").hide();
                $("#btnClose,#btnSave").show();
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>

<script type="text/javascript">

    var Aurl = '@Session["APIurl"]';
    var itemorderby = '@Session["ItemOrderby"]';
var EnableALStartWith = '@Session["ALSearchstartwith"]' == "1";
var autolistfilterwith = EnableALStartWith;
var startwithfield = itemorderby == "1" ? "code" : itemorderby == "2" ? "name" : "search";

    var grid, User;
    GetColumnSettingsData(2, 8, 1);
    var arrData = [];
    var UID = '@Session["LoginUserID"]';
    var RID = '@Session["RoleID"]';
    var nMode = 1;
    var FID = $("#txtFormID").val();
    GetData(3, "");
    GetData(7, RID, 0);
    //~Grid Data
    function GetData(nMode, strName, DepID = 0) {
        console.log("GetData called:", nMode, strName, DepID);
        $.ajax({
            url: Aurl + "signup/get",
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: nMode, Name: strName },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                console.log("GetData response:", data);
                if (nMode == 3) {
                    if (data.length == 0) {
                        showErrorSnackbar("No Records Found");
                    }
                    User = data;
                    arrData = [];
                    //Table.draw().clear();
                        $.each(data, function (i, items) {
                            //arrData[i] = items.UserName;
                            var al = {
                                "label": items.UserName,
                                "id": items.ID,
                            }
                            arrData.push(al);
                        });

                        var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                        grid = new GKBSDynamicGrid('#my-grid', columns, User, {
                            enablePagination: true,
                            pageSize: ItemsperPage,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: false,  // Controls the '⚙️ Columns' button (Assuming you want to rename enableColumnVisibility)
                            enableAddRow: false,      // 💡 NEW: Controls '➕ Add Row'
                            enableRemoveRow: false,   // 💡 NEW: Controls '➖ Remove Selected'
                            enableSorting: true,
                            searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                            rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                            //onCellChange: handleCellUpdate,
                            customCellRenderer: (el, col, rowData) => {
                                if (col.field === 'Active') {
                                    const val = rowData[col.field];
                                    console.log("Active : ", val);
                                    if (val === 'True') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                                    } else if (val === 'False') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                                    }
                                }
                            },
                            customButtons: [
                                {
                                    icon: '⚙️',
                                    text: '',
                                    title: 'Settings',
                                    visible: true,
                                    onClick: (gridInstance, event) => {

                                        modalGenColumnSettings.show();
                                        GendralColumnSettings(1, 8, 1, 0);
                                    }
                                },
                                {
                                    icon: '➕',
                                    text: 'New',
                                    title: 'New ' + $("#MainHeading").text(),
                                    visible: $("#txtAddID").val() == 1,
                                    onClick: (gridInstance, event) => {

                                        nMode = 1;
                                        $("#chkActive,#btnSave,#txtName,#btnClear").prop("disabled", false);
                                        $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                        $("#btnClear,#btnClose,#btnSave").show();
                                        modal.show();
                                        ClearForm();
                                    }
                                },
                            ],
                            onColumnResize: (colIndex, field, header, newWidth) => {
                                UpdateColumnWidth(8, 1, 0, colIndex, field, newWidth)
                            },
                        });
                    //~AutoList
                    PaginatedAutocomplete({
                        inputId: "txtUserName",
                        data: arrData,
                        startwitfieldname: startwithfield,
                        enablefilterstartwith: autolistfilterwith,
                        onSelect: function (item) {
                            $("#txtUserName").val(item.label);
                            return false;
                        }
                    });
                        //$("#txtUserName").autocomplete({
                        //    minLength: 0,
                        //    source: arrData,

                        //    select: function (event, ui) {
                        //        $("#txtUserName").val(ui.item.label);
                        //        //$("#txtRemarks").val(ui.item.id);
                        //        return false;
                        //    },
                        //}).autocomplete("instance")._renderItem = function (ul, item) {
                        //    return $("<li class='each'>")
                        //        .append("<div class='acItem'><span class='name'>" +
                        //            item.label + "</span></div>")
                        //        .appendTo(ul);
                        //};
                }
                    //~Assign Data
                else if (nMode == 4) {
                    $.each(data, function (i, items) {
                        $("#txtID").val(items.ID);
                        $("#txtUserName").val(items.UserName);
                        $("#txtPassword").val(items.Password);
                        $("#txtMobileNo").val(items.Mobilenumber);
                        $("#txtEMail").val(items.EMailID);
                        $("#cmbRole").val(items.RoleID);
                        $("#chkActive").prop("checked", items.Active == "True");
                    });
                }
                else if (nMode == 7) {
                    $('#cmbRole').find("option").remove();
                    $('#cmbRole').append($('<option/>', {
                        value: 0,
                        text: "-- Select Role --",
                        class: ""
                    }));
                    $.each(data, function (i, items) {
                        $('#cmbRole').append($('<option/>', {
                            value: items.ID,
                            text: items.Name,
                        }));
                    });
                    $('#cmbRole').val(DepID);
                }

            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    //showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }

    var modal = new bootstrap.Modal(document.getElementById('myModalfg')); //document.getElementById("myModalfg");
    $("#myModalfg").on("shown.bs.modal", function () {
        $("#txtUserName").focus();
    });

    //~Close
    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.hide();
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".FormclrField").val("");
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#cmbRole").val();
        $("#txtUserName").focus();
        if (nMode != 1)
            modal.hide();
    }
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        //~Validation
        var IsValid = true, ChkFormation = true;
        if ($("#txtUserName").val() == "") {
            IsValid = false;
            $("#dvErrorUserName").html("User Name should not be empty");
            showErrorSnackbar("User Name should not be empty");
        }
        if ($("#txtPassword").val() == "") {
            IsValid = false;
            $("#dvErrorPassword").html("Password should not be empty");
            showErrorSnackbar("Password should not be empty");
        }
        ChkFormation = EmailValidation($("#txtEMail"), $("#dvErrorEmailID"), true);
        if (!ChkFormation) {
            IsValid = false;
            //$("#dvErrorEmailID").html("E-Mail ID should not be empty");
        }
        ChkFormation = MobilenoValidation($("#txtMobileNo"), $("#dvErrorMobileNo"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });

    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");


        var lstMaster = {
            "FormID": FID,
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "UserName": $("#txtUserName").val(),
            "Password": $("#txtPassword").val(),
            "RoleID": $("#cmbRole").val(),
            "Mobilenumber": $("#txtMobileNo").val(),
            "EMailID": $("#txtEMail").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID
        };
            $.ajax({
                url: Aurl + "signup/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                            GetData(3, "");
                            modal.hide();
                        }
                        else if (items.Message == "UserName") {
                            $("#dvErrorUserName").html("User Name already exists");
                            showErrorSnackbar("User Name already exists");
                        }
                        else if (items.Message == "MobileNo") {
                            $("#dvErrorMobileNo").html("Mobile No already exists");
                            showErrorSnackbar("Mobile No already exists");
                        }
                        else if (items.Message == "EMailID") {
                            $("#dvErrorEmailID").html("E-Mail ID already exists");
                            showErrorSnackbar("E-Mail ID already exists");
                        }
                        else {
                            //$("#dvErrorUserName").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }
    //window.addEventListener('keydown', function (event) {
    //    // Check if the F8 key is pressed (key code 119)
    //    if (event.keyCode === 119) {
    //        var url = $("#txtChildRoleURL").val();
    //        if (url != "") {//
    //            var id = event.target.id;
    //            if (id == "cmbRole") {
    //                $("#lbliframeheading").text("Role");
    //                document.getElementById("ifrSMG").src = url + "&ParFFID=cmbRole";;
    //                // Prevent default action if any (e.g., browser F8 behavior)
    //                event.preventDefault();
    //                // Open the modal when F8 is pressed
    //                modaliframe.style.display = "block";
    //            }
    //        }
    //        else {
    //            showErrorSnackbar("Dependancy info not found");
    //        }
    //    }
    //});
    $("#hrefNewRole").click(function () {
        var url = $("#txtChildRoleURL").val();
        if (url != "") {
            $("#lbliframeheading").text("User");
            document.getElementById("ifrSMG").src = url;
            modaliframe.style.display = "block";
        }
        else {
            showErrorSnackbar("Dependancy info not found");
        }
    });
    function togglePassword() {
        var password = document.getElementById("txtPassword");
        var icon = document.getElementById("eyeIcon");

        if (password.type === "password") {
            password.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            password.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }

                    var Url = '@Session["url"].ToString()';
    $("#openrole").click(function (e) {
        var nCustomerTypeID = $("#cmbRole").val() != "" ? $("#cmbRole").val() : 0;
        console.log("ID", nCustomerTypeID);
        vw = window.innerWidth;
        vh = window.innerHeight;
        const hasPermission = nCustomerTypeID == 0
            ? checkAddEditPermission("47")
            : checkAddEditPermission("48");
        if (hasPermission) {
            var ProdUrl = Url + "SingleMaster?name=TpY3HtDSsHf3ZceMOWToaA%3D%3D&strFormID=mEzZBKPOkXLjMUDj1TaO%2FQ%3D%3D&TypeID=BOII5FUynjpl5RZJJ8nW1g%3D%3D&TranID=jJOtHsRVwYECOhoiBc69dA%3D%3D&ID=" + nCustomerTypeID;
            window.open(ProdUrl, "_blank", "width=" + vw + ",height=" + vh + ",scrollbars=yes,resizable=yes");
        }
        else {
            showErrorSnackbar("You don't have pemission for &ensp;<h4><code>" + (nCustomerTypeID == 0 ? "Add" : "Edit") + " Role</code></h4>");
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "F8") {
            event.preventDefault();
            var FieldID = event.target.id;
            var FieldName = event.target.name;
            if (FieldID == "cmbRole") {
                $("#openrole").trigger("click");
            }
        }
        if (event.altKey && (event.key == 's')) {//Switch contains & startwith
            event.preventDefault();
            var fieldid = event.target.id;
            var infomessage = "Search mode changed to&ensp;" + (autolistfilterwith ? "<h4><code>Contains </code></h4>" : "<h4><code>Start with</code></h4>");
            autolistfilterwith = !autolistfilterwith;
            if (fieldid == "txtUserName") {
                showInfoSnackbar(infomessage);
                //~AutoList
                PaginatedAutocomplete({
                    inputId: "txtUserName",
                    data: arrData,
                    startwitfieldname: startwithfield,
                    enablefilterstartwith: autolistfilterwith,
                    onSelect: function (item) {
                        $("#txtUserName").val(item.label);
                        return false;
                    }
                });
            }
        }
        // autolistfilterwith = 1;
        else if (event.altKey && (event.key == 'q')) {//Info about Autolist property
            var containinfo = autolistfilterwith ? "Start With" : "Contains";
            var searchcolumninfo = startwithfield;

            var alinfo = `
<div class="p-3" style="min-width:360px;">  
    <!-- Search Mode -->
    <div class="border rounded-3 p-3 mb-2 bg-light">
        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary me-2"
                     style="width:34px;height:34px;">
                    <i class="bi bi-search"></i>
                </div>

                <div>
                    <div class="text-muted medium fw-semibold">Search Mode</div>
                    <div class="fw-bold text-dark" style="font-size:16px">&emsp;<code>${containinfo}</code></div>
                </div>
            </div>

            <i class="bi bi-chevron-right text-muted"></i>
        </div>
    </div>

    <!-- Search Field -->
    <div class="border rounded-3 p-3 bg-light">
        <div class="d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success me-2"
                     style="width:34px;height:34px;">
                    <i class="bi bi-tag"></i>
                </div>

                <div>
                    <div class="text-muted medium fw-semibold">Search Field</div>
                    <div class="fw-bold text-dark" style="font-size:16px">&emsp;<code>${searchcolumninfo}</code></div>
