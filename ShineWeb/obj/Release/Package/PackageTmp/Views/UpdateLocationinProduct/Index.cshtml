@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/jquery-ui.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.7.1.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --secondary: #64748b;
        --bg-main: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #1e293b;
        --border-color: #e2e8f0;
        --success: #10b981;
        --danger: #ef4444;
        --accent: #f1f5f9;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        padding: 20px;
        line-height: 1.5;
    }

    /* Typography */
    #MainHeading {
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.25rem;
    }

    /* Container Card */
    .feature-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        padding: 24px;
        margin-bottom: 24px;
        transition: var(--transition);
    }

    .feature-card:hover {
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    /* Form Elements */
    .card-header-layout {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 20px;
        margin-bottom: 24px;
        gap: 20px;
    }

    .branch-container {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 !important;
        width: auto !important;
    }

    .form-group-custom {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 320px;
    }

    .form-label-standalone {
        font-size: 14px;
        font-weight: 500;
        color: var(--secondary);
        white-space: nowrap;
    }

    .form-control-modern {
        flex: 1;
        height: 40px;
        padding: 8px 16px;
        font-size: 14px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: #fff;
        transition: var(--transition);
        appearance: none;
        color: var(--text-main);
    }

    .form-control-modern:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(79, 229, 229, 0.1);
    }

    .form-control-modern:disabled {
        background-color: var(--accent);
        cursor: not-allowed;
    }

    /* Table Styling */
    .table-container {
        overflow-x: auto;
    }

    #tblMasterData {
        border-collapse: separate;
        border-spacing: 0;
        width: 100% !important;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

    #tblMasterData thead th {
       /* background-color: var(--accent);
        color: var(--secondary);*/
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 12px 16px;
        border: none;
        border-bottom: 2px solid var(--border-color);
    }

    #tblMasterData tbody td {
/*        padding: 10px 16px;*/
        font-size: 11px;
        vertical-align: middle;
        border-bottom: 1px solid var(--border-color);
    }

    #tblMasterData tbody tr:hover {
        background-color: #f8fafc;
    }

    /* Grid Input */
    .gdInput {
        width: 100%;
        height: 32px;
        padding: 4px 12px;
        font-size: 13px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        background: #fff;
        transition: var(--transition);
    }

    .gdInput:focus {
        outline: none;
        border-color: var(--primary);
    }

    /* Buttons */
    .btn-modern {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 500;
        border-radius: 8px;
        transition: var(--transition);
        cursor: pointer;
        border: none;
    }

    .btn-save {
        background-color: var(--primary);
/*        color: white;*/
    }

    .btn-save:hover {
        background-color: var(--primary-hover);
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.3);
    }

    .btn-clear {
        background-color: #fff;
/*        color: var(--text-main);*/
        border: 1px solid var(--border-color);
    }

    .btn-clear:hover {
        background-color: var(--accent);
    }

    .apply-all-btn {
        background: var(--primary);
        color: white;
        padding: 1px 2px;
        border-radius: 6px;
        font-size: 11px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 1px;
        white-space: nowrap;
    }

    .apply-all-btn:hover {
        background: var(--primary-hover);
    }

    /* Helper Classes */
    .mt-4 { margin-top: 1.5rem; }
    .flex-end { display: flex; justify-content: flex-end; gap: 12px; }
    
    /* Toast Box (Modernized) */
    .toastBox {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 10000;
    }

    /* Header Search Inputs */
    .header-filter-container {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .header-filter-input {
        width: 100%;
        font-size: 11px;
        padding: 4px 8px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
    }

    #cmbLocation {
        margin-bottom: 4px;
    }

    /* Override for DataTables */
    .dataTables_wrapper .dataTables_scrollBody {
        border-bottom: none !important;
    }
</style>

<body>
    <div class="toastBox"></div>
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @id = "txtFormName" })
    
    <div class="container-fluid">
        <div class="feature-card">
            <div class="card-header-layout">
                <div style="grid-column: 1;">
                    <h4 id="MainHeading">
                        <i data-lucide="package-search" style="width: 24px; height: 24px; color: var(--primary);"></i>
                        @ViewData["FormName"]
                    </h4>
                </div>

                <div style="grid-column: 2;">
                    <div class="branch-container">
                        <div class="form-group-custom">
                            <label class="form-label-standalone" for="txtBranchName">Branch *</label>
                            <div style="position: relative; flex: 1; min-width: 240px;">
                                <select class="form-control-modern FormclrcmbField" id="txtBranchName" @(Model.EnableBranch == "1" ? "disabled" : "")>
                                    <option value="0">Select Branch</option>
                                </select>                                
                            </div>
                        </div>
                    </div>
                </div>
                
                <div style="grid-column: 3;"></div> <!-- Spacer for centering -->
            </div>

            <div id="divErrBranch" class="clrdiv" style="color:var(--danger); font-size: 12px; text-align: center; margin-top: -16px; margin-bottom: 24px;"></div>

            <div class="table-container">
                <table id="tblMasterData" class="table" style="width:100%">
                    <thead>
                        <tr class="trclrforcolheader">
                            <th>ID</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>
                                <div style="display:flex; flex-direction:column; gap:8px;">
                                    <div style="font-size: 11px;">Location (Bulk Apply)</div>
                                    <div style="display:flex; gap:6px;">
                                        <select class="form-control-modern" id="cmbLocation" style="height: 28px; font-size: 12px; padding: 4px 8px;">
                                            <option value="0">Select Location</option>
                                        </select>
                                        <button type="button" id="btnApplyAll" class="apply-all-btn">
                                            <i data-lucide="check-check" style="width:14px;"></i> Apply
                                        </button>
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="flex-end mt-4">
                <button type="button" class="btn-modern btn-clear btn-danger" id="btnClear">
                    <i data-lucide="rotate-ccw" style="width: 18px;"></i> Clear
                </button>
                <button type="button" class="btn-modern btn-save btn-success" id="btnSave">
                    <i data-lucide="save" style="width: 18px;"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</body>

<script type="text/javascript">
    // Re-initialize Lucide icons
    function initIcons() {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    }

    var Table = $('#tblMasterData').DataTable({
        pageLength: typeof ItemsperPage !== 'undefined' ? ItemsperPage : 10,
        lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
        "bFilter": true,
        "bSearchable": true,
        "bInfo": false,
        "bPaginate": false,
        "ordering": true,
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        "columnDefs": [
            { "targets": [0], "visible": false, searchable: false },
            { "targets": [1], width: "15%" },
            { "targets": [2], width: "35%" },
            { "targets": [3], width: "25%" },
            { "targets": [4], width: "25%" }
        ],
    });

    var Aurl = '@Session["APIurl"]';
    var UID = '@Session["LoginUserID"]';
    var RID = '@Session["RoleID"]';
    var DefBranch = '@Session["DefaultBranch"]';
    var nMode = 1;

    $(document).ready(function() {
        initIcons();
        GetData(1);
        setTimeout(() => {
            GetData(2);
        }, 1000);
    });

    var arrLocation = [], strLocation = "";
    function GetData(nMode) {
        $.ajax({
            url: Aurl + "updateproductlocation/get",
            type: 'get',
            contentType: 'json',
            data: { Mode: nMode, BranchID: $('#txtBranchName').val()  },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                if (nMode == 1) {
                    if (data && data.length > 0) {
                        $('#cmbLocation').empty().append($('<option/>', { value: 0, text: "-- Select --" }));
                        $('#txtBranchName').empty().append($('<option/>', { value: 0, text: "-- Select Branch --" }));

                        arrLocation = [];
                        strLocation = '<option value="0">-Select-</option>';

                        $.each(data, function (i, items) {
                            if (items.FType == "1") {
                                var loc = { "name": items.Name, "id": items.ID };
                                arrLocation.push(loc);
                                $('#cmbLocation').append($('<option/>', { value: items.ID, text: items.Name }));
                                strLocation += '<option value="' + items.ID + '">' + items.Name + '</option>';
                            }
                            else if (items.FType == "2") {
                                $('#txtBranchName').append($('<option/>', { value: items.ID, text: items.Name }));
                            }
                        });
                    }
                    else if (nMode == 1) {
                        showErrorSnackbar("No Records Found");
                    }
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#txtBranchName").prop("disabled", true);
                    }
                    $("#txtBranchName").val(DefBranch);
                }
                else if (nMode == 2) {
                    var Prodjsdata = (typeof data === 'string') ? JSON.parse(data) : data;
                    $('#tblMasterData').DataTable({
                        pageLength: typeof ItemsperPage !== 'undefined' ? ItemsperPage : 10,
                        lengthMenu: [[10, 20, 50, 100, -1], [10, 20, 50, 100, "All"]],
                        scrollY: "400px",
                        scrollX: true,
                        scrollCollapse: true,
                        paging: false,
                        destroy: true,
                        data: Prodjsdata,
                        fixedColumns: false,
                        searching: true,
                        ordering: false,
                        sorting: false,
                        columns: [
                            { "data": "ID", "autoWidth": true, "visible": false, className: "dt-body-left" },
                            { "data": "Code", "autoWidth": true, className: "dt-body-left" },
                            { "data": "Name", "autoWidth": true, className: "dt-body-left" },
                            { "data": "CategoryName", "autoWidth": true, className: "dt-body-left" },
                            {
                                className: "dt-body-left",
                                "mRender": function (data, type, value, meta) {
                                    var rowIndex = meta.row;
                                    var fId = 'dgvLocation_' + rowIndex;
                                    var selectedLocationID = value.LocationID;

                                    var optionsHtml = strLocation.replace(
                                        new RegExp('value="' + selectedLocationID + '"', 'g'),
                                        'value="' + selectedLocationID + '" selected'
                                    );

                                    return "<select name='Location' class='gdInput dgvLocation' id='" + fId + "'>" + optionsHtml + "</select>";
                                }
                            },
                        ],
                        initComplete: function () {
                            this.api().columns().every(function (index) {
                                if (index !== 0 && index !== this.columns().indexes().length - 1) {
                                    var column = this;
                                    const columnName = $(column.header()).text().trim();
                                    
                                    var filterContainer = $('<div class="header-filter-container"></div>');
                                    var label = $('<div style="font-weight:600; font-size:11px; color:var(--secondary);">' + columnName + '</div>');
                                    var input = $('<input type="text" placeholder="Search..." class="header-filter-input"/>')
                                        .on('keyup change', function () {
                                            column.search($(this).val()).draw();
                                        });
                                    
                                    filterContainer.append(label).append(input);
                                    $(column.header()).empty().append(filterContainer);
                                }
                            });
                            initIcons();
                        },
                    });
                    Table = $('#tblMasterData').DataTable();
                }
            }
            , error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                }
            }
        });
    }

    $('#txtBranchName').change(function (e) {
        GetData(2);
    });

    $(document).on('click', '#btnApplyAll', function () {
        var selLocationID = $('#cmbLocation').val();
        if(selLocationID == 0) {
            showErrorSnackbar("Please select a location first");
            return;
        }
        $("#tblMasterData tbody tr").each(function () {
            $(this).find("select.dgvLocation").each(function () {
                $(this).val(selLocationID);
            });
        });
    });

    $('#btnClear').click(function (e) {
        if (typeof ClearcfFocus !== 'undefined' && ClearcfFocus != 3) { 
            ClearConfirmDialogMsg("Do you want to clear?"); 
        } else { 
            ClearForm(); 
        }
    });

    function ClearForm() {
        $("#cmbLocation").val(0);
        GetData(1);
        $(".clrdiv").html("");
        const table1 = $('#tblMasterData').DataTable();
        table1.columns().every(function () {
            const column = this;
            const headerInput = $('input', column.header());
            if (headerInput.length) headerInput.val('');
            column.search('');
        });
        Table.search("").draw();
        setTimeout(() => {
            GetData(2);
        }, 1000);
    }

    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        if (typeof cfFocus !== 'undefined' && cfFocus != 3) {
            ConfirmDialogMsg("Do you want to save data?");
        } else {
            SaveData();
        }
    });

    function SaveData() {
        if ($("#txtBranchName").val() == 0 || $("#txtBranchName").val() == null) {
            $("#divErrBranch").html("Select Branch");
            showErrorSnackbar("Select Branch");
            return;            
        }
        $("#btnSave").prop("disabled", true);

        var lstProd = [];
        $(".clrdiv").html("");
        
        $("#tblMasterData tbody tr").each(function () {
            var row = Table.row($(this));
            var rowdata = row.data();
            if(!rowdata) return;

            var nProdID = rowdata.ID;
            var nLocationID = $(this).find("select.dgvLocation").val();

            var loc = {
                "ID": nProdID,
                "LocationID": nLocationID,
                "BranchID": $("#txtBranchName").val(),
                "CBy": UID
            }
            lstProd.push(loc)
        });

        $.ajax({
            url: Aurl + "updateproductlocation/save",
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            data: JSON.stringify(lstProd),
            cache: false,
            processData: false,
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                $("#btnSave").prop("disabled", false);
                $.each(data, function (i, items) {
                    if (items.MsgID == 0) {
                        showSuccessSnackbar(items.Message);
                        ClearForm();
                    }
                    else {
                        showErrorSnackbar(items.Message);
                    }
                });
            },
            error: function (data) {
                $("#btnSave").prop("disabled", false);
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                }
            }
        });
    }
</script>