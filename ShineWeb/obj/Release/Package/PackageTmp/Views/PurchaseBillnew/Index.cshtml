            CurrentStatus: $("#txtStatus").val()
        }
        $.ajax({
            url: Aurl + "validatedocument",
            type: 'get',
            contentType: 'json',
            data: { ActionType: 1, TransID: 1, ID: Did, Status: Currsts },
