    function ReloadMultimodedata(rowdetail) {
        $("#tblPayment tbody tr").each(function () {
            var allValues = {};
            rowdata = TablePaymode.row($(this)).data();
            PMID = rowdata[0];
            if (rowdetail.Mode == PMID) {
                $(this).find("input").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "PaymentAmount") {
                        updateInputColumn(fieldID, rowdetail.RecdAmt)
                    }
                    if (fieldName == "IFSC") {
                        $(this).val(rowdetail.IFSC);
                    }
                    if (fieldName == "VisaPern") {
                        updateInputColumn(fieldID, rowdetail.VisaPern)

                    }
                    if (fieldName == "VisaAmt") {
                        updateInputColumn(fieldID, rowdetail.VisaAmt)
                    }
                    if (fieldName == "NEFT") {
                        $(this).val(rowdetail.Neft);
                    }
                    if (fieldName == "ChqDate") {
                        $(this).val(rowdetail.Date);
                    }
                });
                $(this).find("select").each(function (index) {
                    const fieldName = $(this).attr("name");
                    const fieldID = $(this).attr("id");
                    if (fieldName == "dgvPMAccNo") {
                        $(this).val(rowdetail.BankAccId);
                    }

                    if (fieldName == "dgvPMChqNo" && PMID == 2) {
                        var BID = $("#txtID").val() != "" ? $("#txtID").val() : 0;
                        GetData(20, rowdetail.BankAccId, BID, fieldID, rowdetail.ChequeBookID);
                    }
                    if (fieldName == "dgvPMBank") {
                        $(this).val(rowdetail.BankID);
                    }
                });
            }
        });
    }
