  <thead><tr>${vis.map((c, i) => `<th>${c.title}<span class="rz" data-i="${i}"></span></th>`).join('')}</tr></thead><tbody></tbody><tfoot><tr></tr></tfoot></table>`;
            this.tb = this.el.querySelector('tbody'); this.ft = this.el.querySelector('tfoot tr');
            this.rows.forEach((r, ri) => this.tb.append(this.buildRow(r, ri))); this.footer();
            this.el.querySelectorAll('.rz').forEach(h => h.onpointerdown = e => {
