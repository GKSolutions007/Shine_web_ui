<script title="app.js">
    var uomlist = [{
        ID: 1,
        Name: "PCS",
        CF: "1.0000"
    },
    {
        ID: 2,
        Name: "BOX",
        CF: "10.0000"
    },
    {
        ID: 3,
        Name: "KG",
        CF: "1.0000"
    }
    ]
    /* Invoice page: grid configuration, calculations, outside-field sync, save. */
    /* ---- GLOBAL helpers: also used by the other scripts (e.g. GetProductViewData / item tax lookup),
            so they must stay OUTSIDE InitInvoiceGrid(). They only read master lists at call time. ---- */
    /* ---- master lists lookups ---- */
    const itemOf = id => TempAL.find(x => +x.id === +id);                                             // productID -> item (with its own uomlist)
    const uomsOf = r => r._uoms || (itemOf(r.productID) || {}).uomlist || uomlist;                        // UOM list of THIS row (item list, else master list)
    const cfOf = r => { const u = uomsOf(r).find(x => +x.ID === +r.uomID); return u ? (+u.CF || 1) : 1 };          // CF of the row's selected UOM (same value as the option's data-cf)
    const taxById = id => gsttax.find(x => +x.ID === +id);                                              // tax ID    -> tax row
    const taxOf = pct => gsttax.find(x => +x.TaxPern === (+pct || 0));                                    // TaxPern   -> tax row (fallback for saved rows without taxID)
    /* make uomID / uom (name) / uomCF consistent with the row's UOM list */
    function syncUom(r) {
        const l = uomsOf(r), u = l.find(x => +x.ID === +r.uomID) || l.find(x => x.Name === r.uom) || l[0];
        if (u) { r.uomID = +u.ID; r.uom = u.Name; r.uomCF = +u.CF || 1 }
    }

    var G;          // global grid instance (used by the other scripts) - created in InitInvoiceGrid() AFTER the column settings are loaded
    async function InitInvoiceGrid() {
        await LoadColumnSettings();          // 1) column settings from server -> colsettcols
        // 2) everything below (grid creation, handlers) runs only after that
        const byId = id => document.getElementById(id), log = t => byId('msg').textContent = t;


        /* ---- row calculation ---- */
        function calc(r, ch, src) {
            const n = v => +v || 0;
            /* ---- UOM ---- */
            if (ch === 'load') {
                r._uoms = uomsOf({ productID: r.productID });     // saved row: UOM list of its item (else master list)
                if (!(src && 'uomID' in src)) r.uomID = 0;                        // saved row has only the UOM name -> resolve the ID by name
                syncUom(r)
            }                                                  // sets uomID / uom / uomCF
            if (ch === 'item') syncUom(r);                                    // item picked: _uoms + uomID were patched in -> select item's default UOM
            if (ch === 'uomID') {                                             // UOM changed: qty x CF, priceExcl / CF
                const cf = cfOf(r), k = cf / (n(r.uomCF) || 1);                      // k = new CF relative to the previous UOM's CF
                r.qty = rnd(n(r.qty) * k); r.priceExcl = rnd(n(r.priceExcl) / k); syncUom(r);
            }
            /* ---- TAX: dropdown value = gsttax.ID, percentage used in ALL calculations = TaxPern ---- */
            if (ch === 'load' || ch === 'taxID' || ch === 'item') {
                const t = (ch === 'load' && !(src && 'taxID' in src)) ? taxOf(r.taxPct) : taxById(r.taxID);   // saved row without taxID -> find tax by its percentage
                if (t) { r.taxID = +t.ID; r.taxPct = +t.TaxPern; r.mrpOnTax = +t.MRPONTax || 0 } else if (ch === 'load') r.taxID = 0;
            }
            if (ch === 'priceIncl') r.priceExcl = r.priceIncl ? n(r.ApponMRPCum) > 0 ? rnd(n(r.priceIncl) - n(r.MRPonTaxAmt)) : rnd(n(r.priceIncl) / (1 + n(r.taxPct) / 100))
                : rnd(n(r.priceIncl) / (1 + n(r.taxPct) / 100));
            console.log("row calc data", r);
            //r.goods = rnd(n(r.qty) * n(r.priceExcl));
            let base = r.goods;
            [['prod', 'Prod %']].forEach(([p, lbl]) => {
                const pc = p + 'Pct', am = p + 'Amt';
                let pct = n(r[pc]);
                if (ch === am) pct = rnd(base ? n(r[am]) / base * 100 : (n(r[am]) > 0 ? 101 : 0));        // amount typed -> equivalent % (amount on 0 goods counts as > 100)
                if (pct > 100) { r[pc] = 0; r[am] = 0; log(`${lbl} cannot exceed 100 - value reset to 0`) }   // validation: above 100 -> 0
                else if (ch === am) r[pc] = pct; else r[am] = rnd(base * pct / 100);
                base = rnd(base - r[am])
            });
            [['trade', 'Trade %']].forEach(([p, lbl]) => {
                var grsamt = PurTrdDiscb4Prod ? r.goods : (r.goods - r.prodAmt);
                const pc = p + 'Pct', am = p + 'Amt';
                let pct = n(r[pc]);
                if (ch === am) pct = rnd(grsamt ? n(r[am]) / grsamt * 100 : (n(r[am]) > 0 ? 101 : 0));        // amount typed -> equivalent % (amount on 0 goods counts as > 100)
                if (pct > 100) { r[pc] = 0; r[am] = 0; log(`${lbl} cannot exceed 100 - value reset to 0`) }   // validation: above 100 -> 0
                else if (ch === am) r[pc] = pct; else r[am] = rnd(grsamt * pct / 100);
                base = rnd(grsamt - r[am])
            });
            [['add', 'Addnl %']].forEach(([p, lbl]) => {
                var grsamt = PurAddnlDiscb4Prod ? r.goods : (r.goods - r.prodAmt);
                const pc = p + 'Pct', am = p + 'Amt';
                let pct = n(r[pc]);
                if (ch === am) pct = rnd(grsamt ? n(r[am]) / grsamt * 100 : (n(r[am]) > 0 ? 101 : 0));        // amount typed -> equivalent % (amount on 0 goods counts as > 100)
                if (pct > 100) { r[pc] = 0; r[am] = 0; log(`${lbl} cannot exceed 100 - value reset to 0`) }   // validation: above 100 -> 0
                else if (ch === am) r[pc] = pct; else r[am] = rnd(grsamt * pct / 100);
                base = rnd(grsamt - r[am])
            });
            r.gross = r.goods - (r.prodAmt + r.addAmt + r.tradeAmt);
            r.taxAmt = n(r.ApponMRPCum) > 0 ? rnd(r.MRPonTaxAmt * r.qty) : rnd(r.gross * n(r.taxPct) / 100);
            r.net = rnd(r.gross + r.taxAmt);
            if (ch !== 'priceIncl') r.priceIncl = n(r.ApponMRPCum) > 0 ? rnd(n(r.priceExcl) + n(r.MRPonTaxAmt)) : rnd(n(r.priceExcl) * (1 + n(r.taxPct) / 100));
            var valdf = rnd(n(r.gross) / n(r.qty) + n(r.dmgqty));
            var Diff = (n(r.TransPrice) * n(r.uomCF)) - valdf;
            var InclDiff = (Diff * ((n(r.taxPct) /100) +1));
            r.diff = rnd(Diff);
            r.Incldiff = rnd(InclDiff)
            /* hidden column values are available here too: r.productID, r.TrackInentoryYN, r.TrackBatchYN, r.TrackPKDYN */
        }

        /* ---- Trade / Addition: only ONE side can be used at a time ----
           source 'grid'   : any grid row has Trade/Addnl % or ₹ (not 0) -> footer % and ₹ are read-only
                             (footer ₹ = total of rows, footer % = total / base * 100); when ALL rows are 0 the footer is editable again
           source 'footer' : footer % or ₹ given (not 0)                  -> that grid column is read-only; both 0 -> editable again */
        const discSrc = { trade: null, add: null };
        const DISC = [
            { k: 'trade', pK: 'tradePct', aK: 'tradeAmt', fp: 'txtTradeDiscPern', fa: 'txtTradeDiscAmt' },
            { k: 'add', pK: 'addPct', aK: 'addAmt', fp: 'txtAddnlDiscPern', fa: 'txtAddnlDiscAmt' }
        ];
        function applyDiscLock(rows) {
            rows = rows || (typeof G !== 'undefined' && G && G.rows) || [];
            const nz = v => (+v || 0) !== 0;
            DISC.forEach(d => {
                const fGiven = nz(byId(d.fp).value) || nz(byId(d.fa).value);
                const gGiven = rows.some(r => nz(r[d.pK]) || nz(r[d.aK]));
                if (discSrc[d.k] === 'grid' && !gGiven) {            // every grid value back to 0 -> release the footer
                    discSrc[d.k] = null; updateInputColumn(d.fp, 0); updateInputColumn(d.fa, 0);
                    return applyDiscLock.paint(d, null);
                }
                if (discSrc[d.k] === 'footer' && !fGiven) discSrc[d.k] = null;
                if (!discSrc[d.k]) discSrc[d.k] = gGiven ? 'grid' : (fGiven ? 'footer' : null);
                applyDiscLock.paint(d, discSrc[d.k]);
            });
        }
        applyDiscLock.paint = function (d, src) {
            const lockGrid = src === 'footer', lockFooter = src === 'grid';
            byId('grid').querySelectorAll(`input[data-key="${d.pK}"],input[data-key="${d.aK}"]`).forEach(el => {
                el.readOnly = lockGrid; el.classList.toggle('ro', lockGrid); el.tabIndex = lockGrid ? -1 : 0;
            });
            [d.fp, d.fa].forEach(id => {
                const el = byId(id); el.readOnly = lockFooter; el.tabIndex = lockFooter ? -1 : 0;
                el.style.backgroundColor = lockFooter ? '#e9ecef' : '';
            });
        };
        /* base on which the row Trade / Addnl % is applied = goods - prod ₹ (goods only when the company setting says trade disc before prod disc; same rule as calc) */
        function discBase(rows) {
            return rows.reduce((a, r) => a + (+r.goods || 0) - (PurTrdDiscb4Prod ? 0 : (+r.prodAmt || 0)), 0);
        }
        /* grid totals -> footer Trade % / ₹ and Addition % / ₹ (only while the grid is the source) */
        function syncFooterDisc(rowData, t) {
            const base = discBase(rowData), act = document.activeElement;
            [['trade', 'txtTradeDiscPern', 'txtTradeDiscAmt', t.tradeAmt], ['add', 'txtAddnlDiscPern', 'txtAddnlDiscAmt', t.addAmt]].forEach(([k, pId, aId, amt]) => {
                if (discSrc[k] === 'grid') {
                    updateInputColumn(aId, amt);
                    updateInputColumn(pId, base ? amt / base * 100 : 0);
                } else if (discSrc[k] === 'footer' && (+byId(pId).value || 0) > 0 && act !== byId(aId)) {
                    updateInputColumn(aId, amt);                       // footer % in use: keep footer ₹ = total of the rows
                }
            });
        }

        /* ---- called on EVERY grid change (edit, add, remove, drag/move, load) with all row data.
                Manipulate rowData here and assign to the fields outside the grid. ---- */
        function updateSummary(rowData) {
            const t = rowData.reduce((a, r) => ({
                prodAmt: a.prodAmt + r.prodAmt,
                tradeAmt: a.tradeAmt + r.tradeAmt,
                addAmt: a.addAmt + r.addAmt,
                gross: a.gross + r.gross,
                tax: a.tax + r.taxAmt,
                net: a.net + r.net
            }), { prodAmt: 0, tradeAmt: 0, addAmt: 0, gross: 0, tax: 0, net: 0 });
            //const roundOff = rnd(Math.round(t.net) - t.net);
            //byId('lblGross').value = f(t.gross, 2);
            //byId('lblTaxAmount').value = f(t.tax, 2);
            //byId('txtRoundOff').value = f(roundOff, 2);
            //byId('lblRoundNet').value = f(t.net + roundOff, 2);
            //byId('txtRoundOff').style.color = roundOff > 0 ? 'var(--pos)' : roundOff < 0 ? 'var(--neg)' : '';

            // grid net -> footer net, then Freight / Writeoff / TCS / Other charge / Round off are applied on top of it
            RecalcFooterTotals();
            // grid Trade / Addnl (% or ₹) -> footer: ₹ = total of the rows' amounts, % = that total / (goods - prod ₹) * 100
            // (a footer field the user is typing in is left alone - its own handler finalises it)
            applyDiscLock(rowData);                 // decides grid / footer source first
            syncFooterDisc(rowData, t);
            //Gross & Tot Disc Amt
            updateLabelColumn("lblGross", t.gross);
            updateLabelColumn("lblTaxAmount", t.tax);
            updateLabelColumn("lblCGST", (t.tax / 2)); updateLabelColumn("lblSGST", (t.tax / 2));
            updateLabelColumn("lblTotalDiscAmt", (t.prodAmt + t.tradeAmt + t.addAmt));

        }

        const hid = (title, key) => ({ id: title, title, visible: false, controls: [{ type: 'hidden', key }] });
        const num = (key, o = {}) => ({ type: 'number', key, ...o });
        const numLabel = (key, o = {}) => ({ type: 'label', key, ...o });
        const dual = p => [num(p + 'Pct', { prefix: '%', max: 100 }), num(p + 'Amt', { prefix: '₹' })];   // % is flagged red live when > 100 (also checked in validate())
        /* ---- item-name autocomplete on EVERY row (re-bound after each grid render: add / delete / move / load / columns) ---- */
        const AC = { field: 'name', startsWith: true };      // search by item name, starts-with (same as the original testitemlist setup)
        let acInst = [];
        const acDestroy = () => { acInst.forEach(a => a.destroy()); acInst = [] };
        function acBind(g) {
            applyDiscLock(g.rows);                                    // new / re-drawn rows pick up the Trade / Addition lock
            //g.rows.forEach((r, i) => {
            //    const id = 'itemName_' + i; if (!byId(id)) return;                  // column hidden -> nothing to bind
            //    acInst.push(PaginatedAutocomplete({
