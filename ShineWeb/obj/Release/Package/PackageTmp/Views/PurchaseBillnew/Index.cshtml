<script>
    if ($("#txtAllowPO").val() == 0)
        $(".rdoPOField").hide();
    //~Filter Action Buttons
    let mapusersRole = {
        canView: $("#txtViewID").val() == 1,
        canEdit: $("#txtModifyID").val() == 1,
        canVariant: $("#txtVariantID").val() == 1,
        canCancel: $("#txtCancelID").val() == 1,
        canPrint: $("#txtViewID").val() == 1,
        canPreview: $("#txtViewID").val() == 1,
        canPDF: $("#txtViewID").val() == 1
    };
    var allGridActions = [], singleIconAction = [], menuActions = [], columns = [];
    var actions = {}, OtherActions = {};

    function LoadPermissions() {
        var Permrdo1 = $("#rdoMainTableData").is(":checked") ? "1" : $("#rdoDraftTableData").is(":checked") ? "2" :
            $("#rdoPOTableData").is(":checked") ? "3" : "4";
        var cancelperm = !mapusersRole.canCancel ? false : Permrdo1 == "1" ? true : Permrdo1 == "2" || Permrdo1 == "3" ? true : false;
        var ViewPerm = mapusersRole.canView && Permrdo1 == "1" ? true : false;
        allGridActions = [
            {
                icon: '👁️',
                title: 'View Data',
                className: 'dg-action-view',
                displayType: 'single_icon',
                visible: ViewPerm,
                handler: (rowdata) => {
                    GetData(1);
                    $(".clrdivs").html("");
                    $("#txtHProds,#txtHProdCode,#txtHSN,#txtCode").val("");
                    $("#lblProdCodeAS,#lblABSLoc").text("");
                    $('#cmbUOM').find("option").remove();
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    nTransMode = 5;
                    $("#txtID").val(ID);
                    ViewActionButtonPermission();
                    GetProductViewData(7, ID);
                    $("#txtStatus").val(rowdata.CurrentStatus);
                    $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
                    $("#btnPreview,#btnPDF,#btnPrint").prop("disabled", false);
                    $("#btnPreview,#btnPDF,#btnPrint").show();
                    $("#btnEmail,#btnWhatsapp,#PaymentInfoPopup").show();
                    $("#btnSave,#btnClear,#btnDraft,#btnPaymentClear,#btnPaymentAccept").hide();
                    $("#dvMain").show();
                    $("#dvDocuments,#dvUpdateVendor,#dvSelectItems").hide();
                    $("#balanceContainer").show();
                    $("#MainHeading").text("View Purchase Bill_" + sts);
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#cmbBranch").prop("disabled", true);
                    }
                }
            },
            {
                icon: '✏️',
                title: 'Edit',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    const isValidStatus = checkValidStatus(row.Status, row.PaymentModeID);
                    if (isValidStatus) {//row.Status !== 'Amended' && row.Status !== 'Cancelled'
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftModifyID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canEdit)
                                isVisible = true;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    GetData(1);
                    $(".clrdivs").html("");
                    $("#txtHProds,#txtHProdCode,#txtHSN,#txtCode").val("");
                    $("#lblProdCodeAS,#lblABSLoc").text("");
                    $('#cmbUOM').find("option").remove();
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        EditActionTrigger(rowdata);
                    }
                    else {
                        showErrorSnackbar("Cannot Modify.This document already cancelled");
                    }
                }
            },
            {
                icon: '📄',
                title: 'Variant',
                className: 'dg-action-edit',
                visible: mapusersRole.canVariant && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    $("#txtHProds,#txtHProdCode,#txtHSN,#txtCode").val("");
                    $("#lblProdCodeAS,#lblABSLoc").text("");
                    $('#cmbUOM').find("option").remove();
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    $("#txtID").val(ID);
                    VariantActionTrigger(rowdata);
                }
            },
            {
                icon: '❌',
                title: 'Cancel',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    const isValidStatus = checkValidStatus(row.Status, row.PaymentModeID);
                    if (isValidStatus) {//row.Status !== 'Amended' && row.Status !== 'Cancelled'
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftCancelID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canCancel && (Permrdo1 == "1" || Permrdo1 == "4"))
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    $("#txtHProds,#txtHProdCode,#txtHSN,#txtCode").val("");
                    $("#lblProdCodeAS,#lblABSLoc").text("");
                    $('#cmbUOM').find("option").remove();
                    var rdo1 = $("#rdoMainTableData").is(":checked");
                    var rdo4 = $("#rdoInvoiceTableData").is(":checked");
                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[10];
                    var stsID = rowdata.CurrentStatus;
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        if (rdo1) {
                            CancelActionTrigger(rowdata);
                        }
                        else if (rdo4) {
                            var sender = rowdata.VendorID;
                            var conf = confirm("Do you want to cancel Invoice Transfer data?");
                            if (conf) {
                                //GetData(15, ID);
                                var isSuccess = ValidateCancelInvoiceTransferData(15, ID, stsID, sender);
                                if (isSuccess) {
                                    GetFilterData();
                                }
                            }

                        }
                        else {
                            var conf = confirm("Do you want to remove draft data?");
                            if (conf) {
                                //GetData(15, ID);
                                ValidateCancelDraftData(2, 1, ID, stsID)
                            }
                        }
                    }
                    else {
                        showErrorSnackbar("This document already cancelled");
                    }
                }
            },
            {
                icon: '🖨️',
                title: 'Print',
                className: 'dg-action-edit',
                visible: mapusersRole.canPrint && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    //$("#btnPrint").click();
                    var getdef = TransactionPrintProfiles.filter(pr => pr.DefaultConfig == 1);
                    var defid = getdef.length > 0 ? getdef[0].ConfigID : 0;
                    var copies = getdef.length > 0 ? getdef[0].NoCopies : 1;
                    $("#txtNoofCopies").val(copies);
                    $('#cmbPrintProfile').val(defid);
                    PrintConfigID = defid;
                    setTimeout(() => {
                        $("#btnPrint").click();
                    }, 300);
                }
            },
            {
                icon: '🖨️',
                title: 'Preview',
                className: 'dg-action-edit',
                visible: mapusersRole.canPreview && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    //$("#btnPreview").click();
                    var getdef = TransactionPrintProfiles.filter(pr => pr.DefaultConfig == 1);
                    var defid = getdef.length > 0 ? getdef[0].ConfigID : 0;
                    var copies = getdef.length > 0 ? getdef[0].NoCopies : 1;
                    $("#txtNoofCopies").val(copies);
