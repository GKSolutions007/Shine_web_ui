            '<input txttag ="0" title="0" value ="0" type="number" step="any" class="gdInput txtsettag"txtsettag name="FreeQty" id="txtBTFreeQty' + BatchRID + '" onbeforeinput = "return NumericOnlyBeforeInput(event, this,null)" oninput = "sanitizeNumericOnly(this, null)"/>',
