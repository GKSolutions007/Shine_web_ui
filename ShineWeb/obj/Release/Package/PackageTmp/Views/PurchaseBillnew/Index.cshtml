            MRP = (parseFloat(TempProd.MRP));// * TaxPern * parseFloat(ConvFact);
            dApponMRPCum = arrPurchaseTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
            dMRPonTax = getPurchaseMRPontax(MRP);

            PurchasePrice = dApponMRPCum > 0 ? parseFloat(TempProd.PurchasePrice) + dMRPonTax : (parseFloat(TempProd.PurchasePrice) * TaxPern) * parseFloat(ConvFact);
            SalesPrice = dApponMRPCum > 0 ? parseFloat(TempProd.SalesPrice) + dMRPonTax : (parseFloat(TempProd.SalesPrice) * TaxPern) * parseFloat(ConvFact);
            ECP = dApponMRPCum > 0 ? parseFloat(TempProd.ECP) + dMRPonTax : (parseFloat(TempProd.ECP) * TaxPern) * parseFloat(ConvFact);
            SPLPrice = dApponMRPCum > 0 ? parseFloat(TempProd.SPLPrice) + dMRPonTax : (parseFloat(TempProd.SPLPrice) * TaxPern) * parseFloat(ConvFact);
            MRP = (parseFloat(TempProd.MRP));// * TaxPern * parseFloat(ConvFact);
            ReturnPrice = dApponMRPCum > 0 ? parseFloat(TempProd.ReturnPrice) + dMRPonTax : (parseFloat(TempProd.ReturnPrice) * TaxPern);// * parseFloat(ConvFact);
        } else {
            PurchasePrice = (parseFloat(TempProd.PurchasePrice)) * parseFloat(ConvFact);
            SalesPrice = (parseFloat(TempProd.SalesPrice)) * parseFloat(ConvFact);
            ECP = (parseFloat(TempProd.ECP)) * parseFloat(ConvFact);
            SPLPrice = (parseFloat(TempProd.SPLPrice)) * parseFloat(ConvFact);
            MRP = (parseFloat(TempProd.MRP));// * parseFloat(ConvFact);
            ReturnPrice = (parseFloat(TempProd.ReturnPrice));// * parseFloat(ConvFact);
        }

