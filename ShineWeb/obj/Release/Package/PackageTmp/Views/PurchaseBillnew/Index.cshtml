        /* ---- GRID COLUMN SETTINGS -> initial grid ----
           colsettcols (columnsettingscolumns table): { ColumnID, ColumnName, DisplayColumnName, Width, Visible, Permission }
           ColumnName must equal the grid column id (id: '...'). The grid is created with:
             - column ORDER   = ColumnID order of colsettcols (columns missing from colsettcols are appended at the end)
             - header text    = DisplayColumnName
             - width          = Width
             - visibility     = Visible ("0" -> not drawn)  /  Permission ("1" -> never drawn, not in the Columns dialog)
           The factory values (title / width in the code below) are kept in defTitle / defWidth for "Reset to default". */
        const colSettSource = () => typeof colsettcols !== 'undefined' && Array.isArray(colsettcols) ? colsettcols : [];
        const colSettKey = v => String(v == null ? '' : v).toLowerCase();
        function applyColSetting(c, s) {                       // s = settings row of column c (or undefined -> factory defaults)
            const w = s ? parseInt(s.Width, 10) : 0;
            c.title = s && s.DisplayColumnName ? s.DisplayColumnName : c.defTitle;
            c.width = w > 0 ? w : c.defWidth;
            c.forceHidden = !!s && String(s.Permission) === '0';
            c.hidden = c.forceHidden || (!!s && String(s.Visible) === '0')
        }
        function buildGridColumns(defs, settings) {
            const cid = c => colSettKey(c.id || c.title), sc = Array.isArray(settings) ? settings : [];
            const mandatory = defs.filter(c => c.visible === false);            // hid(...) columns: always in the row, never listed
            const shown = defs.filter(c => c.visible !== false);
            shown.forEach(c => { c.defTitle = c.title; c.defWidth = c.width });  // factory defaults
            const ordered = [];
            sc.map((x, i) => ({ x, i })).sort((a, b) => ((+a.x.ColumnID || 0) - (+b.x.ColumnID || 0)) || (a.i - b.i)).forEach(({ x }) => {
                const c = shown.find(k => cid(k) === colSettKey(x.ColumnName));
                if (c && !ordered.includes(c)) ordered.push(c)
            });
            shown.forEach(c => { if (!ordered.includes(c)) ordered.push(c) });   // not in settings -> keep after the others
            ordered.forEach(c => applyColSetting(c, sc.find(x => colSettKey(x.ColumnName) === cid(c))));
            return [...mandatory, ...ordered]
        }

        G = new DynGrid(byId('grid'), {
            calc, onChange: updateSummary, onBeforeRender: acDestroy, onRender: acBind,
            onLock: l => { const b = byId('bAdd'); if (b) b.disabled = l },
            newRow: () => ({
                productID: 0, ApponMRPCum: 0, MRPonTaxAmt: 0, TransPrice: 0, ItemBatchdetail:[], itemName: '', code: '', stock: 0, freestock: 0, dmgstock: 0,
                mrp: 0, hsncode: '', qty: 0, freeqty: 0, dmgqty: 0, uomID: 1, uom: 'PCS', uomCF: 1, reason: 0, locationID: 0,
                taxID: 2, prodPct: 0, prodAmt: 0,
                tradePct: 0, tradeAmt: 0, addPct: 0, addAmt: 0, goods: 0, gross: 0, taxPct: 5, taxAmt: 0, net: 0//, diff: 0
            }),

            columns: buildGridColumns([
                /* mandatory hidden columns: always in every row (calc, validate, getData, save), never drawn, never in the Columns list */
                hid('ProductID', 'productID'), hid('ApponMRPCum', 'ApponMRPCum'), hid('MRPonTax', 'MRPonTaxAmt'), hid('TransPrice', 'TransPrice'), hid('InclDiff', 'Incldiff'), hid('ItemBatchdetail', 'ItemBatchdetail'),
                { id: 'Sno', title: '#', width: 50, controls: [{ type: 'drag' }, { type: 'index' }] },
                {
                    id: 'Actions', title: 'Actions', width: 70, controls: [{
