                    }
                });
            }
        });
    });
    function EditActionTrigger(rowData) {
        nTransMode = 2;
        var rdo1 = $("#rdoMainTableData").is(":checked");
        var rdo2 = $("#rdoDraftTableData").is(":checked");
        var rdo3 = $("#rdoPOTableData").is(":checked");
        var rdo4 = $("#rdoInvoiceTableData").is(":checked");
        var stsID = rowData.CurrentStatus;
        if (rdo2 && !ValidateCancelDraftData(1, 1, rowData.ID, stsID)) {
            return;
        }
        if (rdo4) {
            GetInvoiceTransferData(rowData.ID, stsID);
        } else {
            //GetData(1);
            GetProductViewData(rdo1 ? 7 : rdo2 ? 11 : 17, rowData.ID);
            nTransMode = rdo1 ? 2 : 1;
            $(".FormclrField,.FormclrcmbField").prop("disabled", false);
