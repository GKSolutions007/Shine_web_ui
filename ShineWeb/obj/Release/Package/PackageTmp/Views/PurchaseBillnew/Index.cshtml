    function SaveValidation(SaveMode) {
        var IsValid = true;
        $(".clrdivs").html("");
        if ($("#txtSearch").val() == "") {
            IsValid = false;
            $("#divErrSearch").html("Party should not be empty");
            showErrorSnackbar("Party should not be empty");
        }
        else {
            const exists = arrVendorName.indexOf($("#txtSearch").val().trim()) !== -1;
            if (!exists) {
                IsValid = false;
                $("#divErrSearch").html("Select Party Name from list");
                showErrorSnackbar("Select Party Name from list");
            }
        }
        if (nIsDraft == 0) {
            if ($("#cmbBranch ").val() == 0) {
                IsValid = false;
                $("#divErrBranch").html("Select Branch");
                showErrorSnackbar("Select Branch");
            }
            if ($("#cmbPaymode").val() == 0) {
                IsValid = false;
                $("#divErrPaymode").html("Select Payment Mode");
                showErrorSnackbar("Select Payment Mode");
            }
            if ($("#cmbPaymode").val() == 7 && $("#cmbCreditTerm").val() == 0) {
                IsValid = false;
                $("#divErrCreditTerm").html("Select Credit Term");
                showErrorSnackbar("Select Credit Term");
            }
        }
        if ($("#dtpDate").val() == "") {
            IsValid = false;
            $("#divErrDate").html("Date should not be empty");
            showErrorSnackbar("Date should not be empty");
        }
        
        var griditems = G.getData();
        var items = griditems.filter(item => Number(item.productID) > 0).map(a => a.productID);
        if (items.length == 0) {
            IsValid = false;
            $("#divErrProduct").html("Add atleat one product in Grid");
            showErrorSnackbar("Add atleast one product in Grid");
        }
        else {
            if (BatchAcceptArray.length == 0) {
                IsValid = false;
                $("#divErrProductBatch").html("Add Batch details for added products");
                showErrorSnackbar("Add Batch details for added products");
            }
        }
        $("#lblRoundNet").css("color", "black");
        var valu = document.getElementById("lblRoundNet").getAttribute("lbltag");
        if (parseFloat(valu) <= 0) {
            IsValid = false;
            $("#lblRoundNet").css("color", "red");
            showErrorSnackbar("Net Value should be greater than Zero");
        }
        if (IsValid)
        {
            if ($("#cmbPaymode").val() == 8 && nIsDraft == 0 && nTransMode != 4) {
                if (PaymodeArray.length == 0) {
                    IsValid = false;
                    modalPayment.show();
                }
                else {
                    var Tot = parseFloat(document.getElementById("txtPMPTotal").getAttribute("txttag"));
                    var AdjAmt = parseFloat(document.getElementById("txtPMPAdjAmt").getAttribute("txttag"));
                    if (Tot != AdjAmt) {
                        IsValid = false;
                        var Bal = Tot - AdjAmt;
                        showErrorSnackbar("₹ " + Bal + " Pending, Adjust full Value");
