@model ShineWeb.Models.SingleMasterModel
@{
    ViewBag.Title = ViewData["FormName"];
    Layout = "~/Views/Shared/_LayoutBT5.cshtml";
}
<link href="~/Content/5.3.8/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/navbar.css" rel="stylesheet" />
<link href="~/Content/buttonTop.css" rel="stylesheet" />
<link href="~/Content/dataTables.dataTables.2.2.2.css" rel="stylesheet" />
<link href="~/GKBS_Grid/css/gridui.css" rel="stylesheet" />
<script src="~/Scripts/5.3.8/bootstrap.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/Scripts/jquery-ui.js"></script>
<script src="~/Scripts/dataTables.2.2.2.js"></script>
<script src="~/Scripts/js/refreshtoken.js"></script>
<script src="~/GKBS_Grid/js/gridui.js"></script>
<style>    
    td {
        font-size: 11px;
    }

    input[type=number] {
        text-align: right;
    }

        input[type=number]::placeholder {
            text-align: left;
        }
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    /* The Modal (background) */
    .modalBatch {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 200; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content/Box */
    @@media only screen and (min-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 3% auto; /* 15% from the top and centered */
            padding: 10px;
            border: 1px solid #888;
            width: 65%; /* Could be more or less, depending on screen size */
            height: 70%;
            top: 5%;
            overflow: auto;
        }
    }

    @@media only screen and (max-width: 600px) {
        .modalBatch-content {
            background-color: #ffffff;
            margin: 10% auto; /* 15% from the top and centered */
            padding: 25px;
            border: 1px solid #888;
            width: 95%; /* Could be more or less, depending on screen size */
            height: 80%;
            top: 20%;
            overflow: auto;
        }
    }
    /* The Close Button */
    .closefg {
        color: #aaa;
        float: right;
        font-size: 10px;
        font-weight: bold;
    }

        .closefg:hover,
        .closefg:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    .form-label {
        position: relative;
        display: block;
        clear: both;
        max-width: 500px;
        margin: 0 auto;
    }

    .labelup {
        -webkit-transform: translateY(50%);
        -moz-transform: translateY(-50%);
        -ms-transform: translateY(-50%);
        -o-transform: translateY(-50%);
        transform: translateY(50%);
        -webkit-transition: all 0.2s ease-in-out;
        -moz-transition: all 0.2s ease-in-out;
        transition: all 0.2s ease-in-out;
        position: absolute;
        top: -52%;
        left: 1em;
        background: #fffefe;
        color: #2b2828;
        font-size: 0.90em;
        cursor: text;
        pointer-events: none;
        font-family: sans-serif;
    }
</style>
<body>

    @Html.HiddenFor(model => model.Add, new { @autocomplete = "off", @class = "form-control", @id = "txtAddID" })
    @Html.HiddenFor(model => model.Modify, new { @autocomplete = "off", @class = "form-control", @id = "txtModifyID" })
    @Html.HiddenFor(model => model.View, new { @autocomplete = "off", @class = "form-control", @id = "txtViewID" })
    @Html.HiddenFor(model => model.FormName, new { @autocomplete = "off", @class = "form-control", @id = "txtFormName" })
    @Html.HiddenFor(model => model.ID, new { @autocomplete = "off", @class = "form-control FormclrField", @id = "txtID" })

    <div class="d-flex align-items-center gap-2">
        <!-- Larger heading -->
        <h4 class="mb-0" style="font-size:14px; padding-top:10px;" id="MainHeading">@ViewData["FormName"]</h4>
    </div>
    <hr />
    <div class="toastBox"></div>   
    <div id="dvMainTable">
        <div id="my-grid" style="height: 600px; width: 100%;"></div>
    </div>
    <div class="modal fade " id="myModalfg" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Modal Header -->
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="lblPopupheading">
                        Add @ViewData["FormName"]
                    </h5>
                    <button type="button" class="btn-close" id="modelcloseX"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow:auto">

                    <div class="container-fluid">
                        <div class="row">

                            <!-- LEFT COLUMN -->
                            <div class="col-md-6">
                                <table class="table w-100">

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                            <span class="form-label">
                                                <input type="text" id="txtCode"
                                                       class="form-control FormclrField"
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorCode')"
                                                       oninput="sanitizeAlphaNumeric(this, '#dvErrorCode')" />
                                                <label class="labelup">Branch Code *</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorCode"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                            <span class="form-label">
                                                <input type="text" id="txtName"
                                                       class="form-control FormclrField"
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this,'#dvErrorName')"
                                                       oninput="sanitizeAlphaNumeric(this, '#dvErrorName')" />
                                                <label class="labelup">Branch Name *</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorName"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                            <span class="form-label">
                                                <input type="text" id="txtContactPerson"
                                                       class="form-control FormclrField"
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this, '#dvErrorContactPerson')"
                                                       oninput="sanitizeAlphaNumeric(this, '#dvErrorContactPerson')" />
                                                <label class="labelup">Contact Person</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorContactPerson"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px">
                                            <span class="form-label">
                                                <input type="number" id="txtMobileNo"
                                                       class="form-control FormclrField"
                                                       maxlength="12"
                                                       oninput="if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); }" />
                                                <label class="labelup">Mobile No</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorMobileNo"></div>
                                        </td>

                                        <td style="border:none;padding-left:12px;padding-right:7px">
                                            <span class="form-label">
                                                <input type="number" id="txtPhoneNo"
                                                       class="form-control FormclrField"
                                                       maxlength="12"
                                                       oninput="if (this.value.length > this.maxLength) { this.value = this.value.slice(0, this.maxLength); }" />
                                                <label class="labelup">Phone No</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorPhoneNo"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                            <span class="form-label">
                                                <input type="text" id="txtEMail"
                                                       class="form-control FormclrField" />
                                                <label class="labelup">E-Mail ID</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorEMail"></div>
                                        </td>
                                    </tr>

                                </table>
                            </div>


                            <!-- RIGHT COLUMN -->
                            <div class="col-md-6">
                                <table class="table w-100">

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                            <span class="form-label">
                                                <input type="text" id="txtAddress1"
                                                       class="form-control FormclrField"
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this, '#dvErrorAddress1')"
                                                       oninput="sanitizeAlphaNumeric(this, '#dvErrorAddress1')" />
                                                <label class="labelup">Address 1</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorAddress1"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                            <span class="form-label">
                                                <input type="text" id="txtAddress2"
                                                       class="form-control FormclrField"
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this, '#dvErrorAddress2')"
                                                       oninput="sanitizeAlphaNumeric(this, '#dvErrorAddress2')" />
                                                <label class="labelup">Address 2</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorAddress2"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px" colspan="2">
                                            <span class="form-label">
                                                <input type="text" id="txtAddress3"
                                                       class="form-control FormclrField"
                                                       onbeforeinput="return AlphaNumericBeforeInput(event, this, '#dvErrorAddress3')"
                                                       oninput="sanitizeAlphaNumeric(this, '#dvErrorAddress3')" />
                                                <label class="labelup">Address 3</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorAddress3"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="border:none;padding-left:12px;padding-right:7px">
                                            <span class="form-label">
                                                <select id="cmbStateName" class="form-control"></select>
                                                <label class="labelup">State Name</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorStateName"></div>
                                        </td>

                                        <td style="border:none;padding-left:12px;padding-right:7px">
                                            <span class="form-label">
                                                <input type="text" id="txtGSTIN"
                                                       class="form-control FormclrField"
                                                       maxlength="15" style="text-transform:uppercase" />
                                                <label class="labelup">GSTIN</label>
                                            </span>
                                            <div class="clrdiv text-danger" id="dvErrorGSTIN"></div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td align="left" style="border:none" colspan="2">
                                            <label for="chkActive">Active :</label>
                                            <input type="checkbox" id="chkActive" checked disabled />
                                            <div class="clrdiv text-danger" id="dvErrorActive"></div>
                                        </td>                                        
                                    </tr>
                                </table>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- Modal footer -->
                <div class="modal-footer">
                    <div class="text-end w-100">
                        <button type="button" class="btn btn-danger" id="btnClear"><span class="glyphicon glyphicon-refresh"> Clear</span></button>
                        <button type="button" class="btn btn-success" id="btnSave"><span class="glyphicon glyphicon-saved"> Save</span></button>
                        <button type="button" class="btn btn-warning" id="btnClose"><i class="bi bi-x-circle"></i> Close</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</body>

<script>
    //~Filter Action Buttons
    const allGridActions = [
        {
            icon: '👁️',
            title: 'View Data',
            className: 'dg-action-view',
            // 💡 NEW TAG: This action will be rendered as a single icon
            displayType: 'single_icon',
            visible: $("#txtViewID").val() == 1,
            handler: (rowData) => {
                nMode = 3;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("View " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                GetData(4, ID);                
                $(".FormclrField").prop("disabled", true);
                $("#chkActive,#btnSave,#btnClear,#cmbStateName").prop("disabled", true);
                modal.show();
            }
        },
        {
            icon: '✏️',
            title: 'Edit Data',
            className: 'dg-action-edit',
            visible: $("#txtModifyID").val() == 1,
            displayType: 'single_icon',
            handler: (rowData, gridInstance) => {
                nMode = 2;
                $(".clrdiv").html("");
                $(".modal-title#lblPopupheading").text("Edit " + $("#MainHeading").text());
                //rowdata = Table.row($(this).parents('tr')).data();
                var ID = rowData.ID;//[0];
                GetData(4, ID);
                $(".FormclrField").prop("disabled", false);
                $("#chkActive,#btnSave,#cmbStateName").prop("disabled", false);
                $("#btnClear").prop("disabled", true);
                modal.show();
            }
        }]
    var columns = [

    ];
    const singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
    const menuActions = [];// allGrid3dotActions.filter(a => a.displayType === 'menu_item');
    var actions = {
        "field": "Action",
        "header": "Action",
        "type": "action",
        "width": 80,
        "align": "center",
        "visible": true,
        "specialColumn": true,
        "ShowinColumnOption": false,
        "actions": allGridActions
    };
</script>

<script type="text/javascript">
  //Declarations
    var Aurl = '@Session["APIurl"]';
     var DefStateID = '@Session["StateID"]';
 var UID = '@Session["LoginUserID"]';
 var nMode = 1;
 var FID = $("#txtFormID").val();
    var grid, BranchOffice;

    GetColumnSettingsData(2, 12, 1);
    GetData(3);
    GetData(5);
    var arrCodeData = [], arrNameData = [];
    //~Grid Data
    function GetData(dMode,ID = 0) {
        $.ajax({
            url: Aurl + "branchoffice/get",
            type: 'get',
            contentType: 'json',
            data: { FormID: FID, Mode: dMode, Name: ID },
            xhrFields: {
                withCredentials: true
            },
            success: function (data) {
                    if (dMode == 3) {
                        if (data.length == 0) {
                            showErrorSnackbar("No Records Found");
                        }
                        BranchOffice = data;
                        arrCodeData = [], arrNameData = [];
                        $.each(data, function (i, items) {
                            var al = {
                                "label": items.Code,
                                "id": items.ID,
                            }
                            arrCodeData.push(al);
                            al = {
                                "label": items.Name,
                                "id": items.ID,
                            }
                            arrNameData.push(al);
                        });
                        var currentSearchValue = ''; if (grid) { currentSearchValue = grid ? grid.state.searchTerm : ''; }
                        grid = new GKBSDynamicGrid('#my-grid', columns, BranchOffice, {
                            enablePagination: true,
                            pageSize: ItemsperPage,
                            enableSearch: true,
                            stickyToWindow: true,
                            enableExport: false,
                            enablePrint: false,
                            enableColumnsBtn: false,
                            enableAddRow: false,
                            enableRemoveRow: false,
                            enableSorting: true,
                            searchTerm: currentSearchValue, singleIconAction: singleIconAction, // Pass the single View action
                            rowActionsMenu: menuActions,       // Pass the Delete/Print actions
                            //onCellChange: handleCellUpdate,
                            customCellRenderer: (el, col, rowData) => {
                                if (col.field === 'Active') {
                                    const val = rowData[col.field];
                                    console.log("Active : ", val);
                                    if (val === 'True') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-active">
                      <span class="dg-status-circle"></span> Active
                  </div>`;
                                    } else if (val === 'False') {
                                        el.innerHTML = `<div class="dg-status-badge dg-status-inactive">
                      <span class="dg-status-circle"></span> In-Active
                  </div>`;
                                    }
                                }
                            },
                            customButtons: [
                                {
                                    icon: '⚙️',
                                    text: '',
                                    title: 'Settings',
                                    visible: true,
                                    onClick: (gridInstance, event) => {
                                        modalGenColumnSettings.show();
                                        GendralColumnSettings(1, 12, 1, 0);
                                    }
                                },
                                {
                                    icon: '➕',
                                    text: 'New',
                                    title: 'New ' + $("#MainHeading").text(), 
                                    visible: $("#txtAddID").val() == 1,
                                    onClick: (gridInstance, event) => {
                                        nMode = 1;
                                        $("#chkActive,#btnSave,#cmbStateName,#btnClear,.FormclrField").prop("disabled", false);
                                        $("#cmbStateName").val(0);
                                        $(".modal-title#lblPopupheading").text("Add " + $("#MainHeading").text());
                                        modal.show();
                                        ClearForm();                                    }
                                },
                            ],
                            onCellClick: (rowData, fieldName, cellValue, column) => {
                            },
                            onCellDoubleClick: (rowData, fieldName, cellValue, column) => {
                            },
                            onColumnResize: (colIndex, field, header, newWidth) => {
                                UpdateColumnWidth(12, 1, 0, colIndex, field, newWidth)
                            },
                        });
                        //~AutoList
                        PaginatedAutocomplete({
                            inputId: "txtName",
                            data: arrNameData,
                            onSelect: function (item) {
                                $("#txtName").val(item.label);
                                return false;
                            }
                        });
                        PaginatedAutocomplete({
                            inputId: "txtCode",
                            data: arrCodeData,
                            onSelect: function (item) {
                                $("#txtCode").val(item.label);
                                return false;
                            }
                        });
                        //$("#txtName").autocomplete({
                        //    minLength: 0,
                        //    source: arrNameData,
                        //    select: function (event, ui) {
                        //        $("#txtName").val(ui.item.label);
                        //        //$("#txtRemarks").val(ui.item.id);
                        //        return false;
                        //    },
                        //}).autocomplete("instance")._renderItem = function (ul, item) {
                        //    return $("<li class='each'>")
                        //        .append("<div class='acItem'><span class='name'>" +
                        //            item.label + "</span></div>")
                        //        .appendTo(ul);
                        //};
                        //$("#txtCode").autocomplete({
                        //    minLength: 0,
                        //    source: arrCodeData,
                        //    select: function (event, ui) {
                        //        $("#txtCode").val(ui.item.label);
                        //        //$("#txtRemarks").val(ui.item.id);
                        //        return false;
                        //    },
                        //}).autocomplete("instance")._renderItem = function (ul, item) {
                        //    return $("<li class='each'>")
                        //        .append("<div class='acItem'><span class='name'>" +
                        //            item.label + "</span></div>")
                        //        .appendTo(ul);
                        //};
                    }
                    //~Assign Data
                    else if (dMode == 4) {
                        $.each(data, function (i, items) {
                            $("#txtID").val(items.ID), $("#txtCode").val(items.Code), $("#txtName").val(items.Name), $("#txtAddress1").val(items.Billadd1), $("#txtAddress2").val(items.Billadd2),
                                $("#txtAddress3").val(items.Billadd3), $("#txtContactPerson").val(items.ContactPerson), $("#txtPhoneNo").val(items.Ph1), $("#txtMobileNo").val(items.Mob1),
                                $("#txtEMail").val(items.Email), $("#cmbStateName").val(items.StateID), $("#txtGSTIN").val(items.GSTIN), $("#chkActive").prop("checked", items.Active == "True");
                        });
                    }
                    else {
                        $('#cmbStateName').find("option").remove();
                        $('#cmbStateName').append($('<option/>', {
                            value: 0,
                            text: "-- Select --",
                            class: ""
                        }));
                        $.each(data, function (i, items) {
                            $('#cmbStateName').append($('<option/>', {
                                value: items.ID,
                                text: items.Name,
                            }));
                        });
                        $('#cmbStateName').val(DefStateID);
                    }
            }, error: function (data) {
                if (data.status == "401") {
                    var msg = data.responseJSON.Message;
                    ////showErrorSnackbar(msg + " Logout and Login again.");
                }
            }
        });
    }

    var modal = new bootstrap.Modal(document.getElementById('myModalfg'));//document.getElementById("myModalfg");
    $("#myModalfg").on("shown.bs.modal", function () {
        //setTimeout(function () {
        //    document.getElementById("txtCode").focus();

        //}, 300);
        document.getElementById("txtCode").focus();

    });

    //~Close
    $('#btnClose,#modelcloseX').click(function (e) {
        if (ClosecfFocus != 3) { CloseConfirmDialogMsg("Do you want to close?"); } else { CloseForm(); }
    });
    function CloseForm() {
        modal.hide();
    }
    //~Clear
    $('#btnClear').click(function (e) {
        if (cfFocus != 3) { ClearConfirmDialogMsg("Do you want to clear?"); } else { ClearForm(); }
    });
    function ClearForm() {
        $(".FormclrField").val("");
        $("#cmbTax").val(0)
        $("#chkActive").prop("checked", true);
        $("#chkActive").prop("disabled", nMode != 2);
        $(".clrdiv").html("");
        $("#txtCode").focus();
        $('#cmbStateName').val(DefStateID);
        if (nMode != 1)
            modal.hide();
    }
    //~Save
    $("#btnSave").click(function () {
        $(".clrdiv").html("");
        //~Validation
        var IsValid = true, ChkFormation = true;
        if ($("#txtName").val() == "") {
            IsValid = false;
            $("#dvErrorName").html("Name should not be empty");
            showErrorSnackbar("Name should not be empty");
        }
        if ($("#txtCode").val() == "") {
            IsValid = false;
            $("#dvErrorCode").html("Code should not be empty");
            showErrorSnackbar("Code should not be empty");
        }
        ChkFormation = MobilenoValidation($("#txtMobileNo"), $("#dvErrorMobileNo"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = PhonenoValidation($("#txtPhoneNo"), $("#dvErrorPhoneNo"), false);
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = GSTINValidation($("#txtGSTIN"), $("#dvErrorGSTIN"));
        if (!ChkFormation) {
            IsValid = false;
        }
        ChkFormation = EmailValidation($("#txtEMail"), $("#dvErrorEMail"));
        if (!ChkFormation) {
            IsValid = false;
        }

        if (IsValid) {
            if (cfFocus != 3) { ConfirmDialogMsg("Do you want to save data?"); } else { SaveData(); }
        }
    });
    function SaveData() {
        $("#btnSave").prop("disabled", true);
        $(".clrdiv").html("");
        var lstMaster = {
            "FormID": FID,
            "Mode": nMode,
            "ID": $("#txtID").val(),
            "Code": $("#txtCode").val(),
            "Name": $("#txtName").val(),
            "Billadd1": $("#txtAddress1").val(),
            "Billadd2": $("#txtAddress2").val(),
            "Billadd3": $("#txtAddress3").val(),
            "ContactPerson": $("#txtContactPerson").val(),
            "Ph1": $("#txtPhoneNo").val(),
            "Mob1": $("#txtMobileNo").val(),
            "Email": $("#txtEMail").val(),
            "StateID": $("#cmbStateName").val(),
            "GSTIN": $("#txtGSTIN").val(),
            "Active": $("#chkActive").is(":checked") ? 1 : 0,
            "UserID": UID
        };
            $.ajax({
                url: Aurl + "branchoffice/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(lstMaster),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            //showErrorSnackbar(items.Message);
                            showSuccessSnackbar(items.Message);
                            ClearForm();
                            GetData(3);
                            modal.hide();
                        }
                        else if (items.Message == "Code") {
                            $("#dvErrorCode").html("Code Already Exists");
                            showErrorSnackbar("Code Already Exists");
                        }
                        else if (items.Message == "Name") {
                            $("#dvErrorName").html("Name Already Exists");
                            showErrorSnackbar("Name Already Exists");
                        }
                        else if (items.Message == "AccountName") {
                            $("#dvErrorName").html("Account Name Already Exists in another master");
                            showErrorSnackbar("Account Name Already Exists in another master");
                        }
                        else {
                            //$("#divErrorOnCode").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        ////showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
    }


    $('input, select , textarea').on('keydown', function (e) {
        if (e.key === "Enter") {
            e.preventDefault(); // Prevent default behavior
            let $next = $(this).nextAll('input, select').first(); // Find the next input or select
            if ($next.length) {
                $next.focus(); // Focus the next element
            }
        }
    });
</script>

