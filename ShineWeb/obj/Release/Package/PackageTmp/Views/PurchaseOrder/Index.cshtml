            {
                icon: '👁️',
                title: 'View Data',
                className: 'dg-action-view',
                // 💡 NEW TAG: This action will be rendered as a single icon
                displayType: 'single_icon',
                visible: ViewPerm,
                // $("#txtViewID").val() == 1,
                handler: (rowdata) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    nTransMode = 5;
                    $("#txtID").val(ID);
                    GetProductViewData(7, ID);
                    $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft,#btnClear").hide();
                    $("#btnPDF,#btnPreview").prop("disabled", false);
                    $("#btnPreview,#btnPDF,#btnPrint").show();
                    $("#dvMain").show();
                    $("#btnEmail,#btnWhatsapp").show();
                    $("#dvDocuments").hide();
                    $("#MainHeading").text("View " + $("#txtFormName").val());
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#cmbBranch").prop("disabled", true);
                    }
                    LoadBranchByRoles();
                }
            },
            {
                icon: '✏️',
                title: 'Edit',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed') {
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftModifyID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canEdit)
                                isVisible = true;
                        }
                    }
                    return isVisible;
