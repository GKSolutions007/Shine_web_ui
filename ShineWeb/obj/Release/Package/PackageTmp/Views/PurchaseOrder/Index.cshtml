        function LoadBranchByRoles() {
        var RID = '@Session["RoleID"]';
        console.log("RoleID being sent:", RID);
        $.ajax({
            url: Aurl + "BranchMapping/getByRole",
            type: 'GET',
            dataType: 'json',
            data: { RoleID: RID },
            xhrFields: { withCredentials: true },
            success: function (data) {
                console.log("Data returned from API:", data);
                $('#cmbBranch,#cmbFilterBranch').empty();
                $('#cmbBranch,#cmbFilterBranch').append($('<option/>', { value: 0, text: "-- Select --" }));
                var defaultBranch = 0;
                $.each(data, function (i, item) {
                    console.log("Adding item to dropdown:", item);
                    $('#cmbBranch,#cmbFilterBranch').append($('<option/>', {
                        value: item.BranchID,
                        text: item['Branch Name']
                    }));
                    if (item.SetAsDefault) {
                        defaultBranch = item.BranchID;
                    }
                });
                if (defaultBranch != 0) {
                    $('#cmbBranch,#cmbFilterBranch').val(defaultBranch);//.trigger("change");
                }
            }
        });
    }

