    var ProductArray = [];
    function addProdinArray() {
        ProductArray = [];
        var dPTQty = 0, dPTPrice = 0, dPTPriceIncl = 0, dPTGross = 0, dPTTax = 0, dPTNet = 0, nSerial = 1,dUOMCR = 1;
        $("#tblProductData tbody tr").each(function () {
            var allValues = {};
            rowdata = ProductTable.row($(this)).data();
            nProdID = rowdata[0];
            nUOMID = rowdata[2];
            nTaxID = rowdata[3];
            nTaxPern = rowdata[4];
            dUOMCR = rowdata[5];
            var val = 0;
            $(this).find("input").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Qty") {
                    val = $(this).attr("txttag");
                    dPTQty = parseFloat(val);// ReturnTagValue(fieldID, fieldName);// parseFloat($(this).val());
                }
                if (fieldName == "Excl") {
                    val = $(this).attr("txttag");
                    dPTPrice = parseFloat(val);// ReturnTagValue(fieldID, fieldName);//parseFloat($(this).val());
                }
                if (fieldName == "Incl") {
                    val = $(this).attr("txttag");
                    dPTPriceIncl = parseFloat(val);// ReturnTagValue(fieldID, fieldName);//parseFloat($(this).val());
                }
            });

            $(this).find("label").each(function (index) {
                const fieldName = $(this).attr("name");
                const fieldID = $(this).attr("id");
                if (fieldName == "Gross") {
                    val = $(this).attr("lbltag");
                    dPTGross = parseFloat(val);//ReturnTagValue(fieldID, fieldName);//parseFloat($(this).text());
                }
                if (fieldName == "TaxAmt") {
                    val = $(this).attr("lbltag");
                    dPTTax = parseFloat(val);//ReturnTagValue(fieldID, fieldName);//parseFloat($(this).text());
                }
                if (fieldName == "NetAmt") {
                    val = $(this).attr("lbltag");
                    dPTNet = parseFloat(val);//ReturnTagValue(fieldID, fieldName);//parseFloat($(this).text());
                }
            });
            var listProds = {
                "ProdID": nProdID,
                "UomID": nUOMID,
                "TaxID": nTaxID,
                "TaxPern": nTaxPern,
                "ExclPrice": dPTPrice,
                "InclPrice": dPTPriceIncl,
                "Qty": dPTQty   ,
                "GrossAmt": dPTGross,
                "TaxAmt": dPTTax,
                "NetAmt": dPTNet,
                "UOM": dUOMCR
            }
            ProductArray.push(listProds);
            nSerial++;
        });
    }
    function SaveData() {
        if (SaveValidation()) {
            $("#btnSave").prop("disabled", true);
            //showErrorSnackbar("Validation success");
            addProdinArray();
            var listTrans = {
                "IsDraft": nIsDraft,
                "ID": $("#txtID").val(),
                "Date": $("#dtpDate").val(),
                "TransMode": nTransMode,
                "TransID": 1,
                "UOMType": $("#cmbUOMType").val(), //1 - Base, 2 - Purchase
                "BranchID": $("#cmbBranch").val(),
                "DocID": $("#lblDocID").val(),
                "VendorID": $("#txtVendorID").val(),
                "RefNo": $("#txtRefNo").val(),
                "Status": nTransMode == 1 || nTransMode == 3 ? 1 : nTransMode == 2 ? 3 : $("#txtStatus").val(),
                "CurrentStatus": $("#txtStatus").val(),
                "CBy": UID,
                "Remarks": $("#txtRemarks").val(),
                "Narration": $("#txtNarration").val(),
                "DraftID": $("#txtDraftID").val() == "" ? 0 : $("#txtDraftID").val(),
                "lstProdGrid": ProductArray,
                "RoundOffAmt": document.getElementById("txtRoundOff").getAttribute("txttag"),// ReturnTagValue("txtRoundOff", ""),//$("#txtRoundOff").val(),
                "GrossAmt": document.getElementById("lblPTGross").getAttribute("lbltag"),//ReturnTagValue("lblPTGross", ""),//$("#lblPTGross").text(),
                "TaxAmt": document.getElementById("lblPTTax").getAttribute("lbltag"),//ReturnTagValue("lblPTTax", ""),//$("#lblPTTax").text(),
                "NetAmt": document.getElementById("lblRoundNet").getAttribute("lbltag"),//ReturnTagValue("lblRoundNet", ""),//$("#lblRoundNet").text(),
            }
            $.ajax({
                url: Aurl + "purchaseorder/save",
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(listTrans),
                cache: false,
                processData: false,
                xhrFields: {
                    withCredentials: true
                },
                success: function (data) {
                    $("#btnSave").prop("disabled", false);
                    $.each(data, function (i, items) {
                        if (items.MsgID == 0) {
                            showSuccessSnackbar(items.Message);
                            if (nIsDraft == 0) {
                                //PrintDocument(items.ID, 6);
                                if (nTransMode != 4) {
                                    if (allowprint == 1) {
                                        PrintDocument(items.ID, PrintTransID, PrintConfigID);
                                    } else if (allowprint == 3 || allowprint == 4) {
                                        PrintConfirmDialogMsg(items.ID, PrintTransID, PrintConfigID, "Do you want to print ?");
                                    }
                                    //if (SendAutoMail == 1)
                                    {
                                        //EmailDocument(items.ID, PrintTransID, PrintConfigID);
                                        AutoEmailDocument(items.ID, PrintTransID);
                                    }
                                }
                                ClearForm();
                            }
                            else {
                                $("#txtDraftID").val(items.ID);
                            }
                        }
                        else {
                            //$("#dvErrorName").html(items.Message);
                            showErrorSnackbar(items.Message);
                        }
                    });
                }, error: function (data) {
                    $("#btnSave").prop("disabled", false);
                    if (data.status == "401") {
                        var msg = data.responseJSON.Message;
                        //showErrorSnackbar(msg + " Logout and Login again.");
                    }
                }
            });
        }
    }
