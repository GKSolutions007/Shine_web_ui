                        $(".FormclrField,.FormclrcmbField").prop("disabled", false);
                        //$("#btnSave,#btnClose").prop("disabled", false);
                        //$("#btnPreview,#btnPDF,#btnClear").prop("disabled", true);
                        $("#btnDraft").prop("disabled", rdo1);
                        $("#btnPreview,#btnPDF,#btnClear").prop("disabled", true);
                        $("#btnPreview,#btnPDF,#btnPrint,#btnClear").hide();
                        $("#btnEmail,#btnWhatsapp").hide();
                        $("#btnSave,#btnClose").prop("disabled", false);
                        $("#btnSave,#btnClose").show();
                        $("#dvMain").show();
                        $("#dvDocuments").hide();
                        $("#MainHeading").text((rdo1 ? "Modify " : "Create") + $("#txtFormName").val());
                        if ($("#txtEnableBranch").val() == 1) {
                            $("#cmbBranch").prop("disabled", true);
                        }
                        LoadBranchByRoles();
                    }
                    else {
                        showErrorSnackbar("Cannot Modify.This document already cancelled");
                    }
                }
            },
            {
                icon: '📄',
                title: 'Variant',
                className: 'dg-action-edit',
                visible: mapusersRole.canVariant && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var ID = rowdata.ID;//[0];
                    $("#txtID").val(ID);
                    nTransMode = 3;
                    GetData(1);
                    var rdo1 = $("#rdoMainTableData").is(":checked");
                    var rdo2 = $("#rdoDraftTableData").is(":checked");
                    GetProductViewData(rdo1 ? 7 : rdo2 ? 10 : 14, ID);
                    $("#dvMain").show();
                    $("#dvDocuments").hide();
                    $("#MainHeading").text("Variant " + $("#txtFormName").val());
                    $(".FormclrField,.FormclrcmbField").prop("disabled", false);
                    //$("#btnSave,#btnClear,#btnDraft,#btnClose").prop("disabled", false);
                    //$("#btnPreview,#btnPDF").prop("disabled", true);
                    $("#btnSave,#btnClear,#btnDraft").prop("disabled", false);
                    $("#btnPreview,#btnPDF").prop("disabled", true);
                    $("#btnPreview,#btnPDF,#btnPrint,#btnClear").hide();
                    $("#btnEmail,#btnWhatsapp").hide();
                    $("#btnSave,#btnClose,#btnDraft").show();
                    if ($("#txtEnableBranch").val() == 1) {
                        $("#cmbBranch").prop("disabled", true);
                    }
                    setTimeout(() => {
                        var DocDate = $("#dtpDate").val();
                        var Branch = $("#cmbBranch").val();
                        LoadBranchByRoles();
                        GetDocumentID(DocDate, Branch, 3);
                    }, 1000);
                }
            },
            {
                icon: '❌',
                title: 'Cancel',
                className: 'dg-action-edit',
                visible: (row) => {
                    var isVisible = false;
                    if (row.Status !== 'Amended' && row.Status !== 'Cancelled' && row.Status !== 'Processed') {
                        if (Permrdo1 == "2") {
                            if ($("#txtDraftCancelID").val() != 0)
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                        else {
                            if (mapusersRole.canCancel && Permrdo1 == "1")
                                isVisible = true;
                            else
                                isVisible = false;
                        }
                    }
                    return isVisible;
                },
                displayType: 'menu_item',
                handler: (rowdata, gridInstance) => {
                    $(".clrdivs").html("");
                    var rdo1 = $("#rdoMainTableData").is(":checked") ? "1" : $("#rdoDraftTableData").is(":checked") ? "2" : $("#rdoAITableData").is(":checked") ? "3" : "4";

                    var ID = rowdata.ID;//[0];
                    var sts = rowdata.Status;//[9];
                    if (sts != "Cancelled") {
                        $("#txtID").val(ID);
                        if (rdo1) {
                            nTransMode = 4;
                            var rdo1 = $("#rdoMainTableData").is(":checked");
                            var rdo2 = $("#rdoDraftTableData").is(":checked");
                            GetProductViewData(7, ID);
                            $(".FormclrField,.FormclrcmbField").prop("disabled", true);
                            $("#txtNarration,#txtRemarks").prop("disabled", false);
                            //$("#btnSave,#btnClose").prop("disabled", false);
                            //$("#btnPreview,#btnPDF,#btnClear,#btnDraft").prop("disabled", true);
                            $("#btnPreview,#btnPDF,#btnClear,#btnDraft").prop("disabled", true);
                            $("#btnSave,#btnClose").prop("disabled", false);
                            $("#btnPreview,#btnPDF,#btnPrint,#btnClear,#btnDraft").hide();
                            $("#btnSave,#btnClose").show();
                            $("#dvMain").show();
                            $("#dvDocuments").hide();
                            $("#btnEmail,#btnWhatsapp").hide();
                            $("#MainHeading").text("Cancel " + $("#txtFormName").val());
                            if ($("#txtEnableBranch").val() == 1) {
                                $("#cmbBranch").prop("disabled", true);
                            }
                            LoadBranchByRoles();
                        }
                        else {
                            var conf = confirm("Do you want to remove draft data?");
                            if (conf) {
                                GetData(12, ID);
                            }
                        }
                    }
                    else {
                        showErrorSnackbar("This document already cancelled");
                    }
                }
            },
            {
                icon: '🖨️',
                title: 'Print',
                className: 'dg-action-edit',
                visible: mapusersRole.canPrint && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPrint").click();
                }
            },
            {
                icon: '🖨️',
                title: 'Preview',
                className: 'dg-action-edit',
                visible: mapusersRole.canPreview && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPreview").click();
                }
            },
            {
                icon: "<i class='fa-regular fa-file-pdf' style='color:brown'></i>",
                title: '&ensp;PDF',
                className: 'dg-action-edit',
                visible: mapusersRole.canPDF && Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnPDF").click();
                }
            },
            {
                icon: "<i class='fa-solid fa-envelope' style='color:brown'></i>",
                title: '&ensp;Mail',
                className: 'dg-action-edit',
                visible: Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btnEmail").click();
                }
            },
            {
                icon: "<i class='fa-brands fa-whatsapp' style='color:green'></i>",
                title: '&ensp;WhatsApp',
                className: 'dg-action-edit',
                visible: Permrdo1 == "1",
                displayType: 'menu_item',
                handler: (rowData, gridInstance) => {
                    var ID = rowData.ID;//[0];
                    var sts = rowData.CurrentStatus;//[9];
                    $("#txtID").val(ID);
                    $("#txtStatus").val(sts);
                    $("#btniframeWhatsapp").click();
                }
            },
        ];
        singleIconAction = allGridActions.filter(a => a.displayType === 'single_icon');
        menuActions = allGridActions.filter(a => a.displayType === 'menu_item');
        actions = {
            "header": 'View',
            "type": "action",
            "width": 60,
            "align": "center",
            "visible": Permrdo1 == 1,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": singleIconAction
        };
        OtherActions = {
            "header": "Action",
            "type": "action3dots",
            "width": 60,
            "align": "center",
            "visible": true,
            "specialColumn": true,
            "ShowinColumnOption": false,
            "actions": menuActions
        }
    }

    LoadPermissions();

</script>

