                    $.each(data, function (i, items) {
                        var TaxPern = parseFloat(items.GSTPern);
                        var UOMName = UOMType == 1 ? items.BaseUOMName : items.PurchaseUomName;
                        var UOMID = UOMType == 1 ? parseInt(items.BaseUomID) : parseInt(items.PurchaseUomID);
                        $('#txtHProdID').val(items.ID);
                        $('#txtHProdCode').val(items.Code);
                        $('#lblProdCodeAS').text("Code : " + items.Code);
                        $('#txtHProds').val(items.Name);
                        $('#txtUOMName').val(UOMName);
                        $('#txtUOMID').val(UOMID);
                        $('#txtUOMCR').val(items.PurchaseCR);
                        $('#txtTaxPern').val(items.GSTPern);
                        $('#txtTaxName').val(items.TaxName);
                        $('#txtTaxID').val(items.PurchaseTaxID);
                        $('#txtMRP').val(items.MRP);
                        
                        var Price = UOMType == 1 ? parseFloat(items.PurchasePrice) : (parseFloat(items.PurchasePrice) * parseFloat(items.PurchaseCR))

                        arrPurchaseTaxDetails = ReturnTaxDetails(items.PurchaseTaxID, 1);
                        var dApponMRPCum = arrPurchaseTaxDetails.filter(t => t.AppOn == -1).reduce((sum, tx) => sum + (tx.CumulativeTax || 0), 0);
                        $('#txtMRPonTax').val(dApponMRPCum);
                        var dMRPonTaxAmt = getPurchaseMRPontax(items.MRP);
                        var Incl = dApponMRPCum > 0 ? (Price + dMRPonTaxAmt) : (Price * (1 + (TaxPern / 100)))
                        //$('#txtInclPrice').val(items.Name);
